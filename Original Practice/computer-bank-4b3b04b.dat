/* Tailwind reset matching the uploaded History UI utility base. */
*,*::before,*::after{box-sizing:border-box;border-width:0;border-style:solid;border-color:#e5e7eb}
html{line-height:1.5;-webkit-text-size-adjust:100%;font-family:Georgia,'Noto Sans Devanagari',serif}
body{margin:0}h1,h2,p{margin:0}button{font:inherit;color:inherit;background:transparent;cursor:pointer}button:disabled{cursor:not-allowed}
:focus-visible{outline:2px solid #b8863f;outline-offset:2px}
.max-w-3xl{max-width:48rem}.max-w-4xl{max-width:56rem}.max-w-5xl{max-width:64rem}
.space-y-5 > :not([hidden]) ~ :not([hidden]){margin-top:1.25rem}
.original-figure{margin:0.25rem 0 0.85rem;padding:0.65rem;border:1px solid #e5e7eb;border-radius:0.5rem;background:#f8fbfd}
.original-figure figure{margin:0}.original-figure svg{width:100%;max-width:540px;height:auto;display:block;margin:auto}
.original-figure figcaption{text-align:center;font:12px system-ui,sans-serif;color:#6b7280;margin-top:4px}
/* Keep English answer text readable even when a parent site/app uses white text for dark mode. */
.option-btn .option-en{color:#1a1f2e!important;opacity:1!important;visibility:visible!important}
.option-btn.correct .option-en,.option-btn.incorrect .option-en{color:#fff!important}
.option-btn.answered{cursor:default}.option-btn.correct .text-gray-500,.option-btn.incorrect .text-gray-500{color:white!important}
@media(max-width:767px){.original-figure{padding:4px}.original-figure figcaption{font-size:11px}}

.original-figure img{display:block;max-width:100%;width:auto;height:auto;max-height:460px;margin:0 auto;object-fit:contain}
.original-figure figure{margin:0}
.original-figure figcaption{text-align:center;font:12px 'Segoe UI',system-ui,sans-serif;color:#6b7280;margin:5px auto 0}
@media(max-width:767px){.original-figure img{max-height:330px}.original-figure figcaption{font-size:11px}}

.efp-reference-table table{width:100%;border-collapse:collapse;font-size:12px;line-height:1.5;table-layout:auto}.efp-reference-table table th,.efp-reference-table table td{border:1px solid #d1d9e2;padding:7px 9px;overflow-wrap:break-word}.efp-reference-table table thead th{background:#edf2fb;color:#20304d}.efp-reference-table table tbody tr:nth-child(even){background:#fafcff}.efp-reference-table>div{max-width:100%}.efp-reference-table figcaption{font-size:12px;color:#64748b;text-align:center;margin-top:8px}

.efp-rank-table table th,.efp-rank-table table td{border:1px solid #cbd5e1;padding:6px 7px;text-align:left;white-space:normal}.efp-rank-table table th{background:#e9eef5;color:#16314f;font-weight:700}.efp-rank-table figcaption{text-align:center;font-size:12px;color:#475569;margin-top:8px}

.efp-reference-table table{width:100%;border-collapse:collapse;font-size:12px;line-height:1.5;table-layout:auto}.efp-reference-table table th,.efp-reference-table table td{border:1px solid #cbd5e1;padding:6px 7px;text-align:left;white-space:normal}.efp-reference-table table th{background:#e9eef5;color:#16314f;font-weight:700}.efp-reference-table figcaption{text-align:center;font-size:12px;color:#475569;margin-top:8px}

</style>
<link rel="stylesheet" href="./original-practice.css?v=20260904v7">
<style>
    :root {
        --ink: #1a1f2e;
        --paper: #f7f4ee;
        --gold: #b8863f;
        --deep: #2c3e50;
        --deep2: #34495e;
    }
    body {
        font-family: 'Georgia', 'Noto Sans Devanagari', serif;
        background: var(--paper);
        background-image: radial-gradient(circle at 20% 20%, rgba(184,134,63,0.06) 0%, transparent 40%),
                           radial-gradient(circle at 80% 80%, rgba(44,62,80,0.06) 0%, transparent 40%);
        min-height: 100vh;
    }
    .option-btn { transition: all 0.2s ease; overflow-wrap: break-word; word-break: break-word; }
    .correct { background-color: #10b981 !important; border-color: #059669 !important; color: white !important; }
    .incorrect { background-color: #ef4444 !important; border-color: #dc2626 !important; color: white !important; }
    .section-pill { transition: all 0.15s ease; }
    .section-pill:hover { transform: translateY(-2px); }
    .section-pill.done { background: #e8f6f3 !important; color: #059669 !important; border-color: #a7d8c9 !important; }
    .section-pill.active { background: var(--gold) !important; color: white !important; border-color: var(--gold) !important; transform: scale(1.08); box-shadow: 0 3px 8px rgba(184,134,63,0.4); }
    .card-hover { transition: all 0.25s ease; }
    .card-hover:hover { transform: translateY(-4px); box-shadow: 0 12px 24px rgba(26,31,46,0.15); }
    ::-webkit-scrollbar { height: 6px; width: 6px; }
    ::-webkit-scrollbar-thumb { background: var(--gold); border-radius: 4px; }
    .fade-in { animation: fadeIn 0.3s ease; }
    @keyframes fadeIn { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: translateY(0); } }
    .seal {
        width: 44px; height: 44px; border-radius: 50%;
        background: conic-gradient(from 0deg, var(--gold), #d4a862, var(--gold));
        display: flex; align-items: center; justify-content: center;
        color: var(--deep); font-weight: 900; font-size: 18px;
        box-shadow: 0 2px 8px rgba(184,134,63,0.4);
    }
</style>
