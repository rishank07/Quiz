<style id="efp-computer-merge-fixes">
  #app, #questions-container, .option-btn, .original-figure {min-width:0}
  #app .bg-gradient-to-br.from-amber-700.to-yellow-600 { background-image:linear-gradient(135deg,#b45309,#ca8a04) !important; color:white; }
  .original-figure{max-width:100%;overflow-x:auto;margin:0 0 14px}
  .original-figure img,.original-figure svg{max-width:100%;height:auto}
  .original-figure figure{max-width:100%;margin:0 auto}
  .original-figure table{max-width:100%;margin-left:auto;margin-right:auto}
  .efp-bookmark-btn{cursor:pointer;border:1px solid #d1d5db;border-radius:8px;background:#fff;padding:4px 8px;font-size:13px;line-height:1.4;white-space:nowrap}
  .efp-bookmark-btn[aria-pressed="true"]{color:#a66c13;background:#fff8e6;border-color:#d5ab58}
  .efp-reset-btn{border:1px solid #d1d5db;border-radius:8px;padding:5px 10px;font-size:12px;background:#fff;color:#475569}
  .efp-reset-btn:hover{background:#f9fafb}
  .efp-small-progress{font-size:11px;color:#64748b;margin-top:4px}
  .efp-soft-action{border:1px solid #d1d5db;background:white;border-radius:8px;padding:5px 10px;font-size:12px;color:#34495e}
  .efp-question-copy{overflow-wrap:anywhere;white-space:normal}
  @media(max-width:400px){.efp-scoreline{gap:5px!important}.efp-scoreline span{font-size:10px!important;padding:4px!important}}
  html.efp-local-dark body{background:#111827;color:#e5e7eb}
  html.efp-local-dark #app .bg-white,html.efp-local-dark #app button.bg-white{background:#1f2937;color:#e5e7eb;border-color:#4b5563}
  html.efp-local-dark #app .bg-gray-100{background:#374151;color:#e5e7eb}
  html.efp-local-dark #app .efp-question-copy[style*="#2980b9"]{color:#9bd2f5!important}
  html.efp-local-dark #app .efp-question-copy[style*="#27ae60"]{color:#6ee7b7!important}
</style>
</head>
<body>

<div id="app" class="min-h-screen pb-16"></div>

<script id="master-data" type="application/json">
{"Computer":{"1. Computer Fundamentals — History, Generations & Types":[{"title":{"en":"1. Computer Basics","hi":"1. कंप्यूटर की मूल बातें"},"questions":[{"id":"q1","q":{"en":"What is a computer?","hi":"कंप्यूटर क्या है?"},"a":{"en":"An electronic device that processes data with the help of hardware and software","hi":"एक इलेक्ट्रॉनिक उपकरण जो हार्डवेयर और सॉफ्टवेयर की मदद से डेटा प्रोसेस करता है"},"o":[{"en":"An optical instrument used only for measuring continuous physical temperature","hi":"एक प्रकाशीय उपकरण जिसका उपयोग केवल निरंतर भौतिक तापमान मापने के लिए किया जाता है"},{"en":"A manual counting frame that stores data only on punched paper cards","hi":"एक मैनुअल गिनती फ्रेम जो केवल पंच कार्ड पर डेटा संग्रहीत करता है"},{"en":"An electronic device that processes data with the help of hardware and software","hi":"एक इलेक्ट्रॉनिक उपकरण जो हार्डवेयर और सॉफ्टवेयर की मदद से डेटा प्रोसेस करता है"},{"en":"A purely mechanical device that works without electricity or instructions","hi":"एक विशुद्ध यांत्रिक उपकरण जो बिना बिजली या निर्देशों के काम करता है"}],"exp":{"en":"A computer is an electronic device that accepts raw data as input, processes it with the help of hardware and software instructions, and produces meaningful output.","hi":"कंप्यूटर एक इलेक्ट्रॉनिक उपकरण (electronic device) है जो हार्डवेयर और सॉफ्टवेयर की मदद से डेटा को प्रोसेस करता है और अर्थपूर्ण परिणाम (output) प्रदान करता है।"},"num":1},{"id":"q2","q":{"en":"What is referred to as 'Hardware' in a computer system?","hi":"कंप्यूटर सिस्टम में 'हार्डवेयर' (Hardware) किसे कहते हैं?"},"a":{"en":"Physical parts of a computer, such as CPU, keyboard, and monitor","hi":"कंप्यूटर के भौतिक भाग, जैसे CPU, कीबोर्ड और मॉनिटर"},"o":[{"en":"Intangible instructions stored inside cloud servers","hi":"क्लाउड सर्वर के अंदर संग्रहीत अमूर्त निर्देश"},{"en":"Physical parts of a computer, such as CPU, keyboard, and monitor","hi":"कंप्यूटर के भौतिक भाग, जैसे CPU, कीबोर्ड और मॉनिटर"},{"en":"Programming languages and web browsers","hi":"प्रोग्रामिंग भाषाएँ और वेब ब्राउज़र"},{"en":"Operating system routines that manage system memory","hi":"ऑपरेटिंग सिस्टम रूटीन जो सिस्टम मेमोरी का प्रबंधन करते हैं"}],"exp":{"en":"Hardware refers to the tangible, physical components of a computer system that you can touch and see, such as the CPU, keyboard, monitor, mouse, and motherboard.","hi":"कंप्यूटर के भौतिक भागों (physical parts) जिन्हें हम छू और देख सकते हैं—जैसे CPU, कीबोर्ड, मॉनिटर और माउस—उन्हें हार्डवेयर कहा जाता है।"},"num":2},{"id":"q3","q":{"en":"What is the primary function of 'Software' in a computer?","hi":"कंप्यूटर में 'सॉफ्टवेयर' (Software) क्या कार्य करता है?"},"a":{"en":"It controls hardware and provides instructions to run programs or applications","hi":"यह हार्डवेयर को नियंत्रित करता है और प्रोग्राम या एप्लिकेशन चलाने के लिए निर्देश देता है"},"o":[{"en":"It supplies alternating current to the motherboard","hi":"यह मदरबोर्ड को प्रत्यावर्ती धारा (AC) प्रदान करता है"},{"en":"It acts only as an external plastic casing for the monitor","hi":"यह केवल मॉनिटर के बाहरी प्लास्टिक आवरण के रूप में कार्य करता है"},{"en":"It physically cools down the processor using heat sinks","hi":"यह हीट सिंक का उपयोग करके प्रोसेसर को भौतिक रूप से ठंडा करता है"},{"en":"It controls hardware and provides instructions to run programs or applications","hi":"यह हार्डवेयर को नियंत्रित करता है और प्रोग्राम या एप्लिकेशन चलाने के लिए निर्देश देता है"}],"exp":{"en":"Software is a set of intangible instructions, programs, or data that controls the computer hardware and directs it to run specific applications or tasks.","hi":"सॉफ्टवेयर निर्देशों और प्रोग्रामों का वह समूह है जो हार्डवेयर को नियंत्रित (control) करता है और विभिन्न प्रोग्राम या एप्लिकेशन चलाने के लिए निर्देश देता है।"},"num":3},{"id":"q4","q":{"en":"What is the main difference between an Operating System (OS) and Application Software?","hi":"ऑपरेटिंग सिस्टम (Operating System) और एप्लिकेशन (Applications) में मुख्य अंतर क्या है?"},"a":{"en":"Operating system manages system resources, whereas applications perform specific tasks for the user","hi":"ऑपरेटिंग सिस्टम सिस्टम संसाधनों का प्रबंधन करता है, जबकि एप्लिकेशन उपयोगकर्ता के विशिष्ट कार्य करती हैं"},"o":[{"en":"Operating system is a physical part, while applications are cables","hi":"ऑपरेटिंग सिस्टम एक भौतिक भाग है, जबकि एप्लिकेशन केबल हैं"},{"en":"Operating system manages system resources, whereas applications perform specific tasks for the user","hi":"ऑपरेटिंग सिस्टम सिस्टम संसाधनों का प्रबंधन करता है, जबकि एप्लिकेशन उपयोगकर्ता के विशिष्ट कार्य करती हैं"},{"en":"There is no difference; both terms refer to input devices","hi":"कोई अंतर नहीं है; दोनों शब्द इनपुट उपकरणों को संदर्भित करते हैं"},{"en":"Applications manage CPU scheduling, while Operating System is used only for typing letters","hi":"एप्लिकेशन CPU शेड्यूलिंग प्रबंधित करती हैं, जबकि ऑपरेटिंग सिस्टम केवल पत्र टाइप करने के लिए होता है"}],"exp":{"en":"An Operating System (system software) manages hardware and system resources, whereas Application Software is designed to perform specific tasks directly for the user (like word processing or browsing).","hi":"ऑपरेटिंग सिस्टम (OS) कंप्यूटर के सिस्टम संसाधनों (system resources) का प्रबंधन करता है, जबकि एप्लिकेशन सॉफ्टवेयर उपयोगकर्ता के विशिष्ट कार्यों (specific tasks) को पूरा करते हैं।"},"num":4},{"id":"q5","q":{"en":"Which of the following constitute the main components of a computer system?","hi":"कंप्यूटर सिस्टम के मुख्य भाग (Main Parts) कौन-से हैं?"},"a":{"en":"CPU, memory, input/output devices, and storage devices","hi":"CPU, मेमोरी, इनपुट/आउटपुट डिवाइसेस और स्टोरेज डिवाइसेस"},"o":[{"en":"Abacus beads, Napier rods, and punched cards","hi":"अबेकस मनके, नेपियर रॉड्स और पंच कार्ड"},{"en":"Only UPS, voltage stabilizer, and LAN cable","hi":"केवल यूपीएस, वोल्टेज स्टेबलाइजर और लैन केबल"},{"en":"CPU, memory, input/output devices, and storage devices","hi":"CPU, मेमोरी, इनपुट/आउटपुट डिवाइसेस और स्टोरेज डिवाइसेस"},{"en":"Only keyboard, mouse, and printer paper","hi":"केवल कीबोर्ड, माउस और प्रिंटर पेपर"}],"exp":{"en":"The core functional units of a computer system are the Central Processing Unit (CPU), working memory (RAM), input/output (I/O) devices, and long-term storage devices.","hi":"कंप्यूटर सिस्टम के मुख्य भाग CPU (सेंट्रल प्रोसेसिंग यूनिट), मेमोरी, इनपुट/आउटपुट डिवाइसेस और स्टोरेज डिवाइसेस हैं।"},"num":5},{"id":"q6","q":{"en":"What is the full form and primary role of the CPU?","hi":"CPU का पूर्ण रूप (Full Form) और मुख्य भूमिका क्या है?"},"a":{"en":"Central Processing Unit — It executes instructions","hi":"सेंट्रल प्रोसेसिंग यूनिट — यह निर्देशों को निष्पादित (execute) करता है"},"o":[{"en":"Central Printing Unit — It prints hard copies on paper","hi":"सेंट्रल प्रिंटिंग यूनिट — यह कागज पर हार्ड कॉपी प्रिंट करता है"},{"en":"Central Processing Unit — It executes instructions","hi":"सेंट्रल प्रोसेसिंग यूनिट — यह निर्देशों को निष्पादित (execute) करता है"},{"en":"Common Program Unit — It stores backup files permanently offline","hi":"कॉमन प्रोग्राम यूनिट — यह बैकअप फ़ाइलों को ऑफ़लाइन स्थायी रूप से सहेजता है"},{"en":"Control Peripheral Utility — It only connects external USB drives","hi":"कंट्रोल पेरिफेरल यूटिलिटी — यह केवल बाहरी USB ड्राइव जोड़ता है"}],"exp":{"en":"CPU stands for Central Processing Unit. Known as the brain of the computer, its primary role is to fetch, decode, and execute program instructions.","hi":"CPU का पूर्ण रूप Central Processing Unit है। इसकी मुख्य भूमिका कंप्यूटर में दिए गए निर्देशों को निष्पादित (execute) करना है।"},"num":6},{"id":"q7","q":{"en":"Which of the following correctly pairs an input device and an output device?","hi":"निम्नलिखित में से कौन-सा विकल्प इनपुट और आउटपुट डिवाइस का सही उदाहरण देता है?"},"a":{"en":"Keyboard is an input device and Monitor is an output device","hi":"कीबोर्ड इनपुट डिवाइस है और मॉनिटर आउटपुट डिवाइस है"},"o":[{"en":"Keyboard is an input device and Monitor is an output device","hi":"कीबोर्ड इनपुट डिवाइस है और मॉनिटर आउटपुट डिवाइस है"},{"en":"Printer is an input device and Scanner is an output device","hi":"प्रिंटर इनपुट डिवाइस है और स्कैनर आउटपुट डिवाइस है"},{"en":"Monitor is an input device and Keyboard is an output device","hi":"मॉनिटर इनपुट डिवाइस है और कीबोर्ड आउटपुट डिवाइस है"},{"en":"Speaker is an input device and Microphone is an output device","hi":"स्पीकर इनपुट डिवाइस है और माइक्रोफोन आउटपुट डिवाइस है"}],"exp":{"en":"An input device sends data to the computer (e.g., Keyboard, Mouse), while an output device displays or presents the processed data to the user (e.g., Monitor, Printer).","hi":"कीबोर्ड (Keyboard) एक इनपुट डिवाइस है जिससे डेटा कंप्यूटर में भेजा जाता है, और मॉनिटर (Monitor) एक आउटपुट डिवाइस है जो परिणाम प्रदर्शित करता है।"},"num":7},{"id":"q8","q":{"en":"What is the fundamental difference between working memory (like RAM) and storage (like SSD)?","hi":"मेमोरी (जैसे RAM) और स्टोरेज (जैसे SSD) में क्या अंतर है?"},"a":{"en":"Working memory (RAM) holds data during processing, whereas storage (SSD) retains data for the long term","hi":"वर्किंग मेमोरी (जैसे RAM) प्रोसेसिंग के समय डेटा रखती है, जबकि स्टोरेज (जैसे SSD) डेटा को लंबे समय तक रखता है"},"o":[{"en":"RAM stores data permanently without power, while SSD loses data immediately when power is off","hi":"RAM बिना बिजली के स्थायी रूप से डेटा रखता है, जबकि SSD बिजली बंद होने पर तुरंत डेटा खो देता है"},{"en":"Both RAM and SSD are strictly output display monitors","hi":"RAM और SSD दोनों केवल आउटपुट डिस्प्ले मॉनिटर हैं"},{"en":"Working memory (RAM) holds data during processing, whereas storage (SSD) retains data for the long term","hi":"वर्किंग मेमोरी (जैसे RAM) प्रोसेसिंग के समय डेटा रखती है, जबकि स्टोरेज (जैसे SSD) डेटा को लंबे समय तक रखता है"},{"en":"SSD is inside the keyboard, while RAM is an external printer cartridge","hi":"SSD कीबोर्ड के अंदर होता है, जबकि RAM एक बाहरी प्रिंटर कार्ट्रिज है"}],"exp":{"en":"Working memory (such as RAM) temporarily holds active data and instructions while the CPU is processing them, whereas storage (such as SSD or HDD) retains data permanently for the long term.","hi":"वर्किंग मेमोरी (जैसे RAM) प्रोसेसिंग के समय अस्थायी रूप से डेटा रखती है, जबकि स्टोरेज (जैसे SSD) डेटा को लंबे समय तक स्थायी रूप से सुरक्षित रखता है।"},"num":8}],"source_pages":"Source pp. 01"},{"title":{"en":"2. Early Calculating Devices & Pioneers","hi":"2. प्रारंभिक गणना उपकरण और अग्रदूत"},"questions":[{"id":"q9","q":{"en":"What was the 'Abacus'?","hi":"'अबेकस' (Abacus) क्या था?"},"a":{"en":"An ancient calculating device that performed calculations by sliding beads along rods or wires","hi":"मोतियों (beads) को छड़ों या तारों पर सरकाकर गणना करने वाला प्राचीन उपकरण"},"o":[{"en":"A 20th-century microprocessor designed by Intel","hi":"इंटेल द्वारा डिज़ाइन किया गया 20वीं सदी का माइक्रोप्रोसेसर"},{"en":"An ancient calculating device that performed calculations by sliding beads along rods or wires","hi":"मोतियों (beads) को छड़ों या तारों पर सरकाकर गणना करने वाला प्राचीन उपकरण"},{"en":"A magnetic disk drive used in mainframe computers","hi":"मेनफ्रेम कंप्यूटर में प्रयुक्त एक चुंबकीय डिस्क ड्राइव"},{"en":"An electronic computer built using vacuum tubes","hi":"वैक्यूम ट्यूब का उपयोग करके बनाया गया एक इलेक्ट्रॉनिक कंप्यूटर"}],"exp":{"en":"The Abacus was an ancient manual calculating device that performed arithmetic calculations by sliding beads along rods or wires set in a frame.","hi":"अबेकस (Abacus) एक प्राचीन गणना उपकरण था जिसमें छड़ों (rods) या तारों पर मोतियों (beads) को सरकाकर गणना की जाती थी।"},"num":9},{"id":"q10","q":{"en":"With which approximate period and place is the Abacus conventionally associated in standard exam notes?","hi":"नोट्स के अनुसार अबेकस (Abacus) को पारंपरिक रूप से किस समय और स्थान से जोड़ा जाता है?"},"a":{"en":"Around 3000 BCE and China (conventional dating)","hi":"लगभग 3000 ईसा पूर्व (BCE) और चीन (पारंपरिक तिथि)"},"o":[{"en":"Around 1946 CE and England","hi":"लगभग 1946 ईस्वी और इंग्लैंड"},{"en":"Around 3000 BCE and China (conventional dating)","hi":"लगभग 3000 ईसा पूर्व (BCE) और चीन (पारंपरिक तिथि)"},{"en":"Around 1890 CE and the United States","hi":"लगभग 1890 ईस्वी और संयुक्त राज्य अमेरिका"},{"en":"Around 1642 CE and France","hi":"लगभग 1642 ईस्वी और फ्रांस"}],"exp":{"en":"Standard exam notes conventionally associate the Abacus with around 3000 BCE and China, although the exact historical origin of early counting frames remains uncertain.","hi":"नोट्स पारंपरिक रूप से अबेकस को लगभग 3000 ईसा पूर्व (3000 BCE) और चीन से जोड़ते हैं (हालाँकि गिनती के शुरुआती फ्रेम का सटीक मूल पूर्णतः निश्चित नहीं है)।"},"num":10},{"id":"q11","q":{"en":"Who invented 'Napier’s Bones' and when was the description of these rods published?","hi":"'नेपियर्स बोन्स' (Napier’s Bones) किसने बनाई और इनका विवरण कब प्रकाशित हुआ?"},"a":{"en":"John Napier (1550–1617), published in 1617","hi":"जॉन नेपियर (1550–1617), 1617 में विवरण प्रकाशित किया"},"o":[{"en":"Blaise Pascal in 1642","hi":"ब्लेज़ पास्कल ने 1642 में"},{"en":"Charles Babbage in 1837","hi":"चार्ल्स बैबेज ने 1837 में"},{"en":"Herman Hollerith in 1890","hi":"हरमन होलेरिथ ने 1890 में"},{"en":"John Napier (1550–1617), published in 1617","hi":"जॉन नेपियर (1550–1617), 1617 में विवरण प्रकाशित किया"}],"exp":{"en":"Napier’s Bones was invented by Scottish mathematician John Napier (1550–1617), who published the description of these numbered rods in 1617.","hi":"नेपियर्स बोन्स (Napier’s Bones) का आविष्कार जॉन नेपियर (1550–1617) ने किया था और उन्होंने 1617 में इन छड़ों का विवरण प्रकाशित किया।"},"num":11},{"id":"q12","q":{"en":"What was the main purpose of Napier’s Bones?","hi":"नेपियर्स बोन्स (Napier’s Bones) का मुख्य कार्य क्या था?"},"a":{"en":"To simplify multiplication and division","hi":"गुणा (Multiplication) और भाग (Division) को आसान बनाना"},"o":[{"en":"To simplify multiplication and division","hi":"गुणा (Multiplication) और भाग (Division) को आसान बनाना"},{"en":"To solve differential equations using vacuum tubes","hi":"वैक्यूम ट्यूब का उपयोग करके अवकल समीकरण हल करना"},{"en":"To store census records on punched cards","hi":"पंच कार्ड पर जनगणना रिकॉर्ड संग्रहीत करना"},{"en":"To browse the internet using optical fibres","hi":"ऑप्टिकल फाइबर का उपयोग करके इंटरनेट ब्राउज़ करना"}],"exp":{"en":"The primary function of Napier’s Bones (numbered rods) was to simplify complex multiplication and division operations by reducing them to addition and subtraction.","hi":"नेपियर्स बोन्स का मुख्य कार्य गुणा (multiplication) और भाग (division) की गणनाओं को आसान बनाना था।"},"num":12},{"id":"q13","q":{"en":"Who invented the 'Pascaline' and in which year?","hi":"'पास्कलाइन' (Pascaline) किसने और कब बनाई?"},"a":{"en":"Blaise Pascal in 1642","hi":"ब्लेज़ पास्कल ने 1642 में"},"o":[{"en":"Blaise Pascal in 1642","hi":"ब्लेज़ पास्कल ने 1642 में"},{"en":"Alan Turing in 1936","hi":"एलन ट्यूरिंग ने 1936 में"},{"en":"John Napier in 1617","hi":"जॉन नेपियर ने 1617 में"},{"en":"Gottfried Wilhelm Leibniz in 1694","hi":"गॉटफ्रीड विल्हेम लाइबनिज ने 1694 में"}],"exp":{"en":"The Pascaline (also called Arithmetic Machine) was invented by French mathematician and philosopher Blaise Pascal in 1642.","hi":"पास्कलाइन (Pascaline) का आविष्कार फ्रांसीसी गणितज्ञ ब्लेज़ पास्कल (Blaise Pascal) ने 1642 में किया था।"},"num":13},{"id":"q14","q":{"en":"What was the primary use of the Pascaline?","hi":"पास्कलाइन (Pascaline) का उपयोग मुख्य रूप से किसलिए किया जाता था?"},"a":{"en":"Addition and subtraction (an early mechanical calculator)","hi":"जोड़ (Addition) और घटाव (Subtraction) के लिए (एक प्रारंभिक यांत्रिक कैलकुलेटर)"},"o":[{"en":"Addition and subtraction (an early mechanical calculator)","hi":"जोड़ (Addition) और घटाव (Subtraction) के लिए (एक प्रारंभिक यांत्रिक कैलकुलेटर)"},{"en":"Quantum superposition calculations","hi":"क्वांटम सुपरपोजिशन गणना"},{"en":"3D graphics rendering and animation","hi":"3D ग्राफिक्स रेंडरिंग और एनीमेशन"},{"en":"Automated sorting of U.S. Census punched cards","hi":"अमेरिकी जनगणना के पंच कार्डों की स्वचालित छंटाई"}],"exp":{"en":"The Pascaline was an early gear-based mechanical calculator designed primarily to perform addition and subtraction directly.","hi":"पास्कलाइन एक प्रारंभिक यांत्रिक कैलकुलेटर (early mechanical calculator) था जिसका उपयोग मुख्य रूप से जोड़ (addition) और घटाव (subtraction) के लिए किया जाता था।"},"num":14},{"id":"q15","q":{"en":"Who is known as the 'Father of the Computer' and why?","hi":"'कंप्यूटर का जनक' (Father of Computer) किसे और क्यों कहा जाता है?"},"a":{"en":"Charles Babbage, due to the design of his programmable Analytical Engine","hi":"चार्ल्स बैबेज को, उनके प्रोग्रामेबल एनालिटिकल इंजन (Analytical Engine) के डिज़ाइन की वजह से"},"o":[{"en":"Blaise Pascal, for inventing the microchip","hi":"ब्लेज़ पास्कल को, माइक्रोचिप के आविष्कार के कारण"},{"en":"Alan Turing, for designing the ENIAC","hi":"एलन ट्यूरिंग को, ENIAC के डिज़ाइन के कारण"},{"en":"John Napier, for developing binary language","hi":"जॉन नेपियर को, बाइनरी भाषा विकसित करने के कारण"},{"en":"Charles Babbage, due to the design of his programmable Analytical Engine","hi":"चार्ल्स बैबेज को, उनके प्रोग्रामेबल एनालिटिकल इंजन (Analytical Engine) के डिज़ाइन की वजह से"}],"exp":{"en":"Charles Babbage is revered as the 'Father of the Computer' because his programmable Analytical Engine design introduced core modern computer concepts (ALU/Mill, memory/Store, input/output).","hi":"चार्ल्स बैबेज (Charles Babbage) को उनके प्रोग्रामेबल 'एनालिटिकल इंजन' (Analytical Engine) के डिज़ाइन की वजह से 'कंप्यूटर का जनक' (Father of Computer) कहा जाता है।"},"num":15},{"id":"q16","q":{"en":"What was the core concept behind Charles Babbage’s 'Analytical Engine'?","hi":"चार्ल्स बैबेज के 'एनालिटिकल इंजन' (Analytical Engine) का मुख्य विचार क्या था?"},"a":{"en":"A general-purpose programmable mechanical computing machine","hi":"एक सामान्य-उद्देश्य वाली प्रोग्रामेबल यांत्रिक कंप्यूटिंग मशीन"},"o":[{"en":"A simple wooden frame with sliding beads","hi":"सरकने वाले मोतियों वाला एक साधारण लकड़ी का फ्रेम"},{"en":"A pocket-sized electronic transistor radio","hi":"जेब के आकार का एक इलेक्ट्रॉनिक ट्रांजिस्टर रेडियो"},{"en":"A purely analog mercury thermometer","hi":"एक विशुद्ध रूप से एनालॉग पारा थर्मामीटर"},{"en":"A general-purpose programmable mechanical computing machine","hi":"एक सामान्य-उद्देश्य वाली प्रोग्रामेबल यांत्रिक कंप्यूटिंग मशीन"}],"exp":{"en":"Charles Babbage's Analytical Engine was conceived as a general-purpose, fully programmable mechanical computing machine using punched cards for instructions.","hi":"एनालिटिकल इंजन का मुख्य विचार एक सामान्य-उद्देश्य वाली प्रोग्रामेबल यांत्रिक कंप्यूटिंग मशीन (general-purpose programmable mechanical computing machine) बनाना था।"},"num":16},{"id":"q17","q":{"en":"Which years are associated with the conception/design of the Analytical Engine across standard notes and museum records?","hi":"एनालिटिकल इंजन (Analytical Engine) के वर्ष के रूप में नोट्स और संग्रहालय रिकॉर्ड में कौन-से वर्ष उल्लेखित हैं?"},"a":{"en":"1833 (history slide), 1837 (timeline), and 1834 (Computer History Museum conception)","hi":"1833 (हिस्ट्री स्लाइड), 1837 (टाइमलाइन) और 1834 (कंप्यूटर हिस्ट्री म्यूजियम)"},"o":[{"en":"1964, 1971, and 1976","hi":"1964, 1971 और 1976"},{"en":"1945, 1946, and 1951","hi":"1945, 1946 और 1951"},{"en":"1833 (history slide), 1837 (timeline), and 1834 (Computer History Museum conception)","hi":"1833 (हिस्ट्री स्लाइड), 1837 (टाइमलाइन) और 1834 (कंप्यूटर हिस्ट्री म्यूजियम)"},{"en":"1617, 1642, and 1671","hi":"1617, 1642 और 1671"}],"exp":{"en":"In exam notes, the Analytical Engine is linked to 1833 (history slide) and 1837 (timeline), while the Computer History Museum dates its conception to 1834.","hi":"पीडीएफ हिस्ट्री स्लाइड 1833 और टाइमलाइन 1837 देती है, जबकि कंप्यूटर हिस्ट्री म्यूजियम एनालिटिकल इंजन की अवधारणा (conception) को 1834 से जोड़ता है।"},"num":17},{"id":"q18","q":{"en":"Who is credited with the first published computer algorithm (1843 notes for Bernoulli numbers on the Analytical Engine)?","hi":"पहली प्रकाशित कंप्यूटर एल्गोरिदम (1843 में एनालिटिकल इंजन के लिए बरनौली संख्याओं का एल्गोरिदम) का श्रेय किसे मिलता है?"},"a":{"en":"Ada Lovelace (Augusta Ada)","hi":"एडा लवलेस (अगस्ता एडा)"},"o":[{"en":"Katherine Johnson","hi":"कैथरीन जॉनसन"},{"en":"Marie Curie","hi":"मैरी क्यूरी"},{"en":"Grace Hopper","hi":"ग्रेस हॉपर"},{"en":"Ada Lovelace (Augusta Ada)","hi":"एडा लवलेस (अगस्ता एडा)"}],"exp":{"en":"Ada Lovelace (Augusta Ada) is credited as the first computer programmer for publishing the first computer algorithm in her 1843 notes to compute Bernoulli numbers on the Analytical Engine.","hi":"पहली प्रकाशित कंप्यूटर एल्गोरिदम का श्रेय एडा लवलेस (Ada Lovelace) को मिलता है; उनके 1843 के नोट्स में एनालिटिकल इंजन के लिए बरनौली संख्याओं (Bernoulli numbers) की गणना का एल्गोरिदम था।"},"num":18},{"id":"q19","q":{"en":"Whose punched-card tabulator was used in the 1890 U.S. Census?","hi":"1890 की अमेरिकी जनगणना (U.S. Census) में किसका पंच-कार्ड टैबुलेटर उपयोग किया गया था?"},"a":{"en":"Herman Hollerith","hi":"हरमन होलेरिथ"},"o":[{"en":"John Napier","hi":"जॉन नेपियर"},{"en":"Herman Hollerith","hi":"हरमन होलेरिथ"},{"en":"Seymour Cray","hi":"सीमोर क्रे"},{"en":"Clifford Berry","hi":"क्लिफोर्ड बेरी"}],"exp":{"en":"Herman Hollerith developed the electromechanical punched-card tabulator that was famously used to process the 1890 U.S. Census data in record time.","hi":"1890 की अमेरिकी जनगणना (U.S. Census) में हरमन होलेरिथ (Herman Hollerith) द्वारा विकसित पंच-कार्ड टैबुलेटर का उपयोग किया गया था।"},"num":19},{"id":"q20","q":{"en":"How did punched cards store and represent data for tabulation?","hi":"पंच कार्ड (Punched cards) डेटा को कैसे स्टोर करते थे?"},"a":{"en":"Positions of holes on the card encoded data, which a reader detected for tabulation","hi":"कार्ड पर छेदों (holes) की स्थिति डेटा एनकोड करती थी, जिसे रीडर पहचानकर टैबुलेशन में उपयोग करता था"},"o":[{"en":"Using laser beams on optical discs","hi":"ऑप्टिकल डिस्क पर लेजर किरणों का उपयोग करके"},{"en":"Using silicon flash memory cells","hi":"सिलिकॉन फ्लैश मेमोरी सेल का उपयोग करके"},{"en":"Using liquid mercury inside glass tubes","hi":"कांच की नलियों के अंदर तरल पारे का उपयोग करके"},{"en":"Positions of holes on the card encoded data, which a reader detected for tabulation","hi":"कार्ड पर छेदों (holes) की स्थिति डेटा एनकोड करती थी, जिसे रीडर पहचानकर टैबुलेशन में उपयोग करता था"}],"exp":{"en":"Punched cards stored data through the specific positions of punched holes on stiff paper cards; electromechanical readers detected these hole patterns for tabulation.","hi":"पंच कार्ड पर छेदों (holes) की विशिष्ट स्थिति डेटा को एनकोड करती थी। कार्ड रीडर उन पैटर्न को पहचानकर टैबुलेशन (सारणीयन) में उपयोग करता था।"},"num":20},{"id":"q21","q":{"en":"What was the contribution of James Powers to early data processing?","hi":"जेम्स पावर्स (James Powers) का प्रारंभिक डेटा प्रोसेसिंग में क्या योगदान था?"},"a":{"en":"He built an improved electric tabulator for the U.S. Census Bureau featuring automatic card feed and sorting","hi":"उन्होंने अमेरिकी जनगणना ब्यूरो के लिए स्वचालित कार्ड फ़ीड और सॉर्टिंग वाला उन्नत इलेक्ट्रिक टैबुलेटर बनाया"},"o":[{"en":"He designed the first Apple microcomputer in 1976","hi":"उन्होंने 1976 में पहला एप्पल माइक्रो कंप्यूटर डिज़ाइन किया"},{"en":"He invented the vacuum tube in 1904","hi":"उन्होंने 1904 में वैक्यूम ट्यूब का आविष्कार किया"},{"en":"He built an improved electric tabulator for the U.S. Census Bureau featuring automatic card feed and sorting","hi":"उन्होंने अमेरिकी जनगणना ब्यूरो के लिए स्वचालित कार्ड फ़ीड और सॉर्टिंग वाला उन्नत इलेक्ट्रिक टैबुलेटर बनाया"},{"en":"He wrote the COBOL compiler","hi":"उन्होंने COBOL कंपाइलर लिखा"}],"exp":{"en":"James Powers developed an improved electric punched-card tabulator for the U.S. Census Bureau featuring automatic card feeding and sorting capabilities.","hi":"जेम्स पावर्स (James Powers) ने अमेरिकी जनगणना ब्यूरो के लिए एक उन्नत इलेक्ट्रिक टैबुलेटर बनाया, जिसमें स्वचालित कार्ड फ़ीड (automatic card feed) और सॉर्टिंग (छंटाई) की सुविधा थी।"},"num":21},{"id":"q22","q":{"en":"What is the full form of IBM?","hi":"IBM का पूर्ण रूप (Full Form) क्या है?"},"a":{"en":"International Business Machines","hi":"इंटरनेशनल बिजनेस मशीन्स"},"o":[{"en":"Indian Board of Microprocessors","hi":"इंडियन बोर्ड ऑफ माइक्रोप्रोसेसर्स"},{"en":"Internal Browsing Microcomputers","hi":"इंटरनल ब्राउज़िंग माइक्रो कम्प्यूटर्स"},{"en":"Integrated Binary Machines","hi":"इंटीग्रेटेड बाइनरी मशीन्स"},{"en":"International Business Machines","hi":"इंटरनेशनल बिजनेस मशीन्स"}],"exp":{"en":"IBM stands for International Business Machines Corporation (formed from Herman Hollerith's Tabulating Machine Company / CTR in 1924).","hi":"IBM का पूर्ण रूप International Business Machines (इंटरनेशनल बिजनेस मशीन्स) है।"},"num":22},{"id":"q23","q":{"en":"Which operations were performed by various models of punched-card machines as mentioned in the notes?","hi":"नोट्स के अनुसार पंच-कार्ड मशीनों के विभिन्न मॉडल कौन-से कार्य करते थे?"},"a":{"en":"Tabulation, sorting, and arithmetic","hi":"टैबुलेशन (सारणीयन), सॉर्टिंग (छंटाई) और अंकगणित (Arithmetic)"},"o":[{"en":"Video streaming and 3D gaming","hi":"वीडियो स्ट्रीमिंग और 3D गेमिंग"},{"en":"Tabulation, sorting, and arithmetic","hi":"टैबुलेशन (सारणीयन), सॉर्टिंग (छंटाई) और अंकगणित (Arithmetic)"},{"en":"Quantum cryptography and optical scanning","hi":"क्वांटम क्रिप्टोग्राफी और ऑप्टिकल स्कैनिंग"},{"en":"Voice recognition and satellite navigation","hi":"वॉयस रिकग्निशन और उपग्रह नेविगेशन"}],"exp":{"en":"According to the notes, different models of punched-card machines performed tabulation, sorting, and arithmetic operations.","hi":"नोट्स के अनुसार पंच-कार्ड मशीनों के अलग-अलग मॉडल टैबुलेशन (tabulation), सॉर्टिंग (sorting) और अंकगणितीय (arithmetic) कार्य करते थे।"},"num":23},{"id":"q24","q":{"en":"What is a 'Turing Machine' and who proposed it?","hi":"'ट्यूरिंग मशीन' (Turing Machine) क्या है और इसे किसने प्रस्तावित किया?"},"a":{"en":"A 1936 theoretical model of computation proposed by Alan Turing using a tape and rules","hi":"एलन ट्यूरिंग का 1936 का कंप्यूटेशन का सैद्धांतिक मॉडल, जिसमें एक टेप और नियमों से गणना दर्शाई जाती है"},"o":[{"en":"A 1936 theoretical model of computation proposed by Alan Turing using a tape and rules","hi":"एलन ट्यूरिंग का 1936 का कंप्यूटेशन का सैद्धांतिक मॉडल, जिसमें एक टेप और नियमों से गणना दर्शाई जाती है"},{"en":"A 1951 commercial mainframe built by Eckert and Mauchly","hi":"एकर्ट और मौचली द्वारा निर्मित 1951 का व्यावसायिक मेनफ्रेम"},{"en":"A mechanical gear calculator built in 1642","hi":"1642 में निर्मित एक यांत्रिक गियर कैलकुलेटर"},{"en":"India’s first indigenous computer built at TIFR","hi":"TIFR में निर्मित भारत का पहला स्वदेशी कंप्यूटर"}],"exp":{"en":"Proposed by Alan Turing in 1936, the Turing Machine is a foundational theoretical model of computation that uses an infinite tape and a set of rules to represent algorithmic computation.","hi":"एलन ट्यूरिंग (Alan Turing) ने 1936 में 'ट्यूरिंग मशीन' नामक कंप्यूटेशन का सैद्धांतिक मॉडल प्रस्तावित किया, जिसमें एक टेप और नियमों के माध्यम से गणना को दर्शाया जाता है।"},"num":24}],"source_pages":"Source pp. 02–03, 07–08"},{"title":{"en":"3. Electronic Computers & Key Milestones","hi":"3. इलेक्ट्रॉनिक कंप्यूटर और प्रमुख उपलब्धियाँ"},"questions":[{"id":"q25","q":{"en":"What is the full form of 'ABC' and who built it?","hi":"'ABC' का पूर्ण रूप क्या है और इसे किसने बनाया?"},"a":{"en":"Atanasoff–Berry Computer — built by John Vincent Atanasoff and Clifford Berry","hi":"एटानासॉफ-बेरी कंप्यूटर — जॉन विंसेंट एटानासॉफ और क्लिफोर्ड बेरी द्वारा निर्मित"},"o":[{"en":"American Business Computer — built by Herman Hollerith","hi":"अमेरिकन बिजनेस कंप्यूटर — हरमन होलेरिथ द्वारा निर्मित"},{"en":"Atanasoff–Berry Computer — built by John Vincent Atanasoff and Clifford Berry","hi":"एटानासॉफ-बेरी कंप्यूटर — जॉन विंसेंट एटानासॉफ और क्लिफोर्ड बेरी द्वारा निर्मित"},{"en":"Automatic Boolean Computer — built by Seymour Cray","hi":"ऑटोमैटिक बूलियन कंप्यूटर — सीमोर क्रे द्वारा निर्मित"},{"en":"Advanced Binary Calculator — built by Charles Babbage","hi":"एडवांस्ड बाइनरी कैलकुलेटर — चार्ल्स बैबेज द्वारा निर्मित"}],"exp":{"en":"ABC stands for Atanasoff–Berry Computer, built by physicist John Vincent Atanasoff and graduate student Clifford Berry at Iowa State College.","hi":"ABC का पूर्ण रूप Atanasoff–Berry Computer है, जिसे जॉन विंसेंट एटानासॉफ और क्लिफोर्ड बेरी ने बनाया था।"},"num":25},{"id":"q26","q":{"en":"What was the historical distinction of the Atanasoff–Berry Computer (ABC)?","hi":"एटानासॉफ-बेरी कंप्यूटर (ABC) की ऐतिहासिक विशेषता क्या थी?"},"a":{"en":"It was a pioneering electronic digital machine built to solve simultaneous linear equations","hi":"यह एक अग्रणी इलेक्ट्रॉनिक डिजिटल मशीन थी, जो युगपत रैखिक समीकरणों (simultaneous linear equations) को हल करने के लिए बनाई गई थी"},"o":[{"en":"It was the first laptop with a graphical user interface","hi":"यह ग्राफिकल यूजर इंटरफेस वाला पहला लैप टॉप था"},{"en":"It was a pioneering electronic digital machine built to solve simultaneous linear equations","hi":"यह एक अग्रणी इलेक्ट्रॉनिक डिजिटल मशीन थी, जो युगपत रैखिक समीकरणों (simultaneous linear equations) को हल करने के लिए बनाई गई थी"},{"en":"It was the first computer to use microprocessors","hi":"यह माइक्रोप्रोसेसर का उपयोग करने वाला पहला कंप्यूटर था"},{"en":"It was built exclusively for weather forecasting in India","hi":"इसे विशेष रूप से भारत में मौसम पूर्वानुमान के लिए बनाया गया था"}],"exp":{"en":"The ABC holds the historical distinction of being a pioneering special-purpose electronic digital machine designed specifically to solve simultaneous linear equations.","hi":"ABC एक अग्रणी इलेक्ट्रॉनिक डिजिटल मशीन थी, जिसे विशेष रूप से युगपत रैखिक समीकरणों (simultaneous linear equations) को हल करने के लिए बनाया गया था।"},"num":26},{"id":"q27","q":{"en":"What is the full form of ENIAC?","hi":"ENIAC का पूर्ण रूप (Full Form) क्या है?"},"a":{"en":"Electronic Numerical Integrator and Computer","hi":"इलेक्ट्रॉनिक न्यूमेरिकल इंटीग्रेटर एंड कंप्यूटर"},"o":[{"en":"Electrical Network for Integrated Arithmetic Calculations","hi":"इलेक्ट्रिकल नेटवर्क फॉर इंटीग्रेटेड अरिथमेटिक कैलकुलेशन्स"},{"en":"Early National Industrial Automatic Calculator","hi":"अर्ली नेशनल इंडस्ट्रियल ऑटोमैटिक कैलकुलेटर"},{"en":"Electronic Numerical Integrator and Computer","hi":"इलेक्ट्रॉनिक न्यूमेरिकल इंटीग्रेटर एंड कंप्यूटर"},{"en":"Encoded Number Indicator and Compiler","hi":"एनकोडेड नंबर इंडिकेटर एंड कंपाइलर"}],"exp":{"en":"ENIAC stands for Electronic Numerical Integrator and Computer.","hi":"ENIAC का पूर्ण रूप Electronic Numerical Integrator and Computer है।"},"num":27},{"id":"q28","q":{"en":"Who developed ENIAC and at which institution?","hi":"ENIAC को किसने और किस संस्थान में विकसित किया?"},"a":{"en":"J. Presper Eckert, John W. Mauchly and their team at the Moore School of Electrical Engineering, University of Pennsylvania","hi":"जे. प्रेस्पर एकर्ट, जॉन डब्ल्यू. मौचली और उनकी टीम ने यूनिवर्सिटी ऑफ पेंसिल्वेनिया के मूर स्कूल ऑफ इलेक्ट्रिकल इंजीनियरिंग में"},"o":[{"en":"John Atanasoff and Clifford Berry at Iowa State College","hi":"जॉन एटानासॉफ और क्लिफोर्ड बेरी ने आयोवा स्टेट कॉलेज में"},{"en":"Seymour Cray at Control Data Corporation","hi":"सीमोर क्रे ने कंट्रोल डेटा कॉर्पोरेशन में"},{"en":"Alan Turing and team at Bletchley Park","hi":"एलन ट्यूरिंग और टीम ने ब्लेचले पार्क में"},{"en":"J. Presper Eckert, John W. Mauchly and their team at the Moore School of Electrical Engineering, University of Pennsylvania","hi":"जे. प्रेस्पर एकर्ट, जॉन डब्ल्यू. मौचली और उनकी टीम ने यूनिवर्सिटी ऑफ पेंसिल्वेनिया के मूर स्कूल ऑफ इलेक्ट्रिकल इंजीनियरिंग में"}],"exp":{"en":"ENIAC was developed by J. Presper Eckert, John W. Mauchly, and their engineering team at the Moore School of Electrical Engineering, University of Pennsylvania.","hi":"ENIAC को जे. प्रेस्पर एकर्ट (J. Presper Eckert), जॉन डब्ल्यू. मौचली (John W. Mauchly) और उनकी टीम ने यूनिवर्सिटी ऑफ पेंसिल्वेनिया के मूर स्कूल ऑफ इलेक्ट्रिकल इंजीनियरिंग में विकसित किया था।"},"num":28},{"id":"q29","q":{"en":"When was ENIAC developed and when was it formally introduced to the public?","hi":"ENIAC का विकास कब हुआ और इसका औपचारिक सार्वजनिक परिचय कब हुआ?"},"a":{"en":"Developed during World War II (1945 development milestone) and formally introduced in 1946","hi":"द्वितीय विश्व युद्ध के दौरान विकसित (1945 विकास मील का पत्थर) और 1946 में औपचारिक परिचय"},"o":[{"en":"Developed during World War II (1945 development milestone) and formally introduced in 1946","hi":"द्वितीय विश्व युद्ध के दौरान विकसित (1945 विकास मील का पत्थर) और 1946 में औपचारिक परिचय"},{"en":"Developed in 1951 and introduced in 1956","hi":"1951 में विकसित और 1956 में प्रस्तुत"},{"en":"Developed during World War I (1918) and introduced in 1920","hi":"प्रथम विश्व युद्ध के दौरान विकसित (1918) और 1920 में प्रस्तुत"},{"en":"Developed in 1964 and introduced in 1971","hi":"1964 में विकसित और 1971 में प्रस्तुत"}],"exp":{"en":"ENIAC was developed during World War II (reaching its completion/development milestone in 1945) and was formally introduced to the public in February 1946.","hi":"ENIAC का विकास द्वितीय विश्व युद्ध के दौरान हुआ; नोट्स 1945 को विकास मील का पत्थर (development milestone) और 1946 को औपचारिक सार्वजनिक परिचय (formal introduction) बताते हैं।"},"num":29},{"id":"q30","q":{"en":"ENIAC was a pioneering computer belonging to which category?","hi":"ENIAC किस श्रेणी का अग्रणी (pioneering) कंप्यूटर था?"},"a":{"en":"General-purpose electronic digital computer","hi":"सामान्य-उद्देश्य वाला इलेक्ट्रॉनिक डिजिटल कंप्यूटर (General-purpose electronic digital computer)"},"o":[{"en":"Quantum superposition computer","hi":"क्वांटम सुपरपोजिशन कंप्यूटर"},{"en":"Mechanical punched-card sorter","hi":"यांत्रिक पंच-कार्ड सॉर्टर"},{"en":"Personal portable notebook computer","hi":"व्यक्तिगत पोर्टेबल नोटबुक कंप्यूटर"},{"en":"General-purpose electronic digital computer","hi":"सामान्य-उद्देश्य वाला इलेक्ट्रॉनिक डिजिटल कंप्यूटर (General-purpose electronic digital computer)"}],"exp":{"en":"ENIAC was the world's pioneering large-scale, general-purpose electronic digital computer.","hi":"ENIAC सामान्य-उद्देश्य वाले इलेक्ट्रॉनिक डिजिटल कंप्यूटर (general-purpose electronic digital computer) श्रेणी का अग्रणी कंप्यूटर था।"},"num":30},{"id":"q31","q":{"en":"Approximately how many vacuum tubes were used in ENIAC?","hi":"ENIAC में लगभग कितनी वैक्यूम ट्यूब (Vacuum Tubes) थीं?"},"a":{"en":"About 18,000 (exact count commonly given as 17,468)","hi":"लगभग 18,000 (सटीक संख्या आमतौर पर 17,468 दी जाती है)"},"o":[{"en":"About 5,00,000","hi":"लगभग 5,00,000"},{"en":"About 1,000 (exact 950)","hi":"लगभग 1,000 (सटीक 950)"},{"en":"About 18,000 (exact count commonly given as 17,468)","hi":"लगभग 18,000 (सटीक संख्या आमतौर पर 17,468 दी जाती है)"},{"en":"About 500 (exact 480)","hi":"लगभग 500 (सटीक 480)"}],"exp":{"en":"ENIAC used approximately 18,000 vacuum tubes (the exact historical count is commonly cited as 17,468 vacuum tubes).","hi":"ENIAC में लगभग 18,000 वैक्यूम ट्यूब (सटीक संख्या आमतौर पर 17,468 दी जाती है) का उपयोग किया गया था।"},"num":31},{"id":"q32","q":{"en":"How do the notes describe the physical size and relative speed of ENIAC?","hi":"ENIAC के आकार और गति के बारे में नोट्स में क्या उल्लेख दिया गया है?"},"a":{"en":"Room-sized machine (roughly 30 × 30 feet) and about 1,000× faster than earlier machines","hi":"कमरे के आकार की मशीन (लगभग 30 × 30 फीट) और पुरानी मशीनों से लगभग 1,000 गुना तेज़"},"o":[{"en":"Room-sized machine (roughly 30 × 30 feet) and about 1,000× faster than earlier machines","hi":"कमरे के आकार की मशीन (लगभग 30 × 30 फीट) और पुरानी मशीनों से लगभग 1,000 गुना तेज़"},{"en":"Palm-sized device weighing 200 grams","hi":"200 ग्राम वजन का हथेली के आकार का उपकरण"},{"en":"Desktop-sized machine (2 × 2 feet) and 10× slower than Abacus","hi":"डेस्कटॉप आकार की मशीन (2 × 2 फीट) और अबेकस से 10 गुना धीमी"},{"en":"Wristwatch-sized embedded controller","hi":"कलाई घड़ी के आकार का एम्बेडेड कंट्रोलर"}],"exp":{"en":"The notes describe ENIAC as a massive room-sized machine (roughly 30 × 30 feet) operating about 1,000 times faster than earlier electromechanical machines.","hi":"नोट्स में ENIAC को कमरे के आकार की मशीन (लगभग 30 × 30 फीट) और पुरानी मशीनों की तुलना में लगभग 1,000 गुना तेज़ बताया गया है।"},"num":32},{"id":"q33","q":{"en":"With which decade are magnetic-core memory and transistor circuits primarily associated?","hi":"मैग्नेटिक-कोर मेमोरी (Magnetic-core memory) और ट्रांजिस्टर सर्किट किस दशक से जुड़े हैं?"},"a":{"en":"1950s (core memory stored data and transistors began replacing vacuum tubes)","hi":"1950 का दशक (कोर मेमोरी डेटा स्टोर करती थी और ट्रांजिस्टर ने वैक्यूम ट्यूब की जगह लेनी शुरू की)"},"o":[{"en":"1890s","hi":"1890 का दशक"},{"en":"1950s (core memory stored data and transistors began replacing vacuum tubes)","hi":"1950 का दशक (कोर मेमोरी डेटा स्टोर करती थी और ट्रांजिस्टर ने वैक्यूम ट्यूब की जगह लेनी शुरू की)"},{"en":"1920s","hi":"1920 का दशक"},{"en":"2000s","hi":"2000 का दशक"}],"exp":{"en":"Magnetic-core memory and transistor circuits are associated with the 1950s, when core memory stored data and transistors began replacing bulky vacuum tubes.","hi":"मैग्नेटिक-कोर मेमोरी और ट्रांजिस्टर सर्किट 1950 के दशक (1950s) से जुड़े हैं, जब कोर मेमोरी डेटा स्टोर करती थी और ट्रांजिस्टर ने वैक्यूम ट्यूब की जगह लेनी शुरू की।"},"num":33},{"id":"q34","q":{"en":"What is the timeline of semiconductor chips (ICs and microprocessors) coming into use?","hi":"सेमीकंडक्टर चिप्स (ICs और माइक्रोप्रोसेसर) कब से उपयोग में आए?"},"a":{"en":"Integrated circuits were used in the 1960s, microprocessors arrived in the 1970s, and chip integration expanded further in the 1980s","hi":"इंटीग्रेटेड सर्किट 1960 के दशक में, माइक्रोप्रोसेसर 1970 के दशक में आए और 1980 के दशक में चिप एकीकरण और बढ़ा"},"o":[{"en":"Both ICs and microprocessors were used in 1890","hi":"IC और माइक्रोप्रोसेसर दोनों 1890 में उपयोग किए गए थे"},{"en":"Semiconductor chips were first introduced only after 2010","hi":"सेमीकंडक्टर चिप्स पहली बार केवल 2010 के बाद शुरू किए गए"},{"en":"Microprocessors arrived in the 1940s and ICs in the 1990s","hi":"माइक्रोप्रोसेसर 1940 के दशक में और IC 1990 के दशक में आए"},{"en":"Integrated circuits were used in the 1960s, microprocessors arrived in the 1970s, and chip integration expanded further in the 1980s","hi":"इंटीग्रेटेड सर्किट 1960 के दशक में, माइक्रोप्रोसेसर 1970 के दशक में आए और 1980 के दशक में चिप एकीकरण और बढ़ा"}],"exp":{"en":"Semiconductor Integrated Circuits (ICs) came into use in the 1960s, single-chip microprocessors arrived in the 1970s, and VLSI chip integration expanded rapidly in the 1980s.","hi":"इंटीग्रेटेड सर्किट (ICs) 1960 के दशक में उपयोग में आए, माइक्रोप्रोसेसर 1970 के दशक में आए, और 1980 के दशक में चिप एकीकरण व उपयोग और अधिक बढ़ा।"},"num":34},{"id":"q35","q":{"en":"Who developed UNIVAC I and when was the first unit delivered to the U.S. Census Bureau?","hi":"UNIVAC I किसने विकसित किया और पहला UNIVAC I अमेरिकी जनगणना ब्यूरो को कब डिलीवर हुआ?"},"a":{"en":"Developed by Eckert and Mauchly's team; delivered in 1951","hi":"एकर्ट और मौचली की टीम द्वारा विकसित; 1951 में डिलीवर हुआ"},"o":[{"en":"Developed by Charles Babbage; delivered in 1837","hi":"चार्ल्स बैबेज द्वारा विकसित; 1837 में डिलीवर हुआ"},{"en":"Developed by Intel; delivered in 1971","hi":"इंटेल द्वारा विकसित; 1971 में डिलीवर हुआ"},{"en":"Developed by Eckert and Mauchly's team; delivered in 1951","hi":"एकर्ट और मौचली की टीम द्वारा विकसित; 1951 में डिलीवर हुआ"},{"en":"Developed by Seymour Cray; delivered in 1976","hi":"सीमोर क्रे द्वारा विकसित; 1976 में डिलीवर हुआ"}],"exp":{"en":"UNIVAC I was developed by J. Presper Eckert and John Mauchly's team, and the first unit was delivered to the U.S. Census Bureau in 1951.","hi":"UNIVAC I को एकर्ट और मौचली की टीम ने विकसित किया था और पहला UNIVAC I वर्ष 1951 में अमेरिकी जनगणना ब्यूरो (U.S. Census Bureau) को डिलीवर हुआ।"},"num":35},{"id":"q36","q":{"en":"What is the full form and historical importance of UNIVAC I?","hi":"UNIVAC I का पूर्ण रूप और ऐतिहासिक महत्व क्या है?"},"a":{"en":"Universal Automatic Computer I — considered America's first commercial electronic digital computer","hi":"यूनिवर्सल ऑटोमैटिक कंप्यूटर I — अमेरिका का पहला व्यावसायिक (commercial) इलेक्ट्रॉनिक डिजिटल कंप्यूटर माना जाता है"},"o":[{"en":"Universal Analog Calculator I — first mechanical slide rule","hi":"यूनिवर्सल एनालॉग कैलकुलेटर I — पहला यांत्रिक स्लाइड रूल"},{"en":"Universal Automatic Computer I — considered America's first commercial electronic digital computer","hi":"यूनिवर्सल ऑटोमैटिक कंप्यूटर I — अमेरिका का पहला व्यावसायिक (commercial) इलेक्ट्रॉनिक डिजिटल कंप्यूटर माना जाता है"},{"en":"Unified Array Controller I — first microprocessor chip","hi":"यूनिफाइड ऐरे कंट्रोलर I — पहला माइक्रोप्रोसेसर चिप"},{"en":"United Vacuum Computer I — India's first indigenous supercomputer","hi":"यूनाइटेड वैक्यूम कंप्यूटर I — भारत का पहला स्वदेशी सुपर कंप्यूटर"}],"exp":{"en":"UNIVAC I stands for Universal Automatic Computer I and is recognized as America's first commercial electronic digital computer.","hi":"UNIVAC I का पूर्ण रूप Universal Automatic Computer I है और इसे अमेरिका का पहला व्यावसायिक (commercial) इलेक्ट्रॉनिक डिजिटल कंप्यूटर माना जाता है।"},"num":36},{"id":"q37","q":{"en":"What was the IBM System/360 and when was it launched?","hi":"IBM System/360 क्या था और इसे कब लॉन्च किया गया था?"},"a":{"en":"A compatible mainframe family launched by IBM in 1964 using hybrid Solid Logic Technology","hi":"IBM का कंपैटिबल मेनफ्रेम परिवार, जो 1964 में लॉन्च हुआ और जिसमें हाइब्रिड सॉलिड लॉजिक टेक्नोलॉजी (SLT) का उपयोग हुआ"},"o":[{"en":"An embedded smartwatch OS launched in 1995","hi":"1995 में लॉन्च किया गया एक एम्बेडेड स्मार्टवॉच ओएस"},{"en":"A portable MP3 player launched in 1980","hi":"1980 में लॉन्च किया गया एक पोर्टेबल MP3 प्लेयर"},{"en":"A compatible mainframe family launched by IBM in 1964 using hybrid Solid Logic Technology","hi":"IBM का कंपैटिबल मेनफ्रेम परिवार, जो 1964 में लॉन्च हुआ और जिसमें हाइब्रिड सॉलिड लॉजिक टेक्नोलॉजी (SLT) का उपयोग हुआ"},{"en":"A first-generation vacuum tube calculator launched in 1942","hi":"1942 में लॉन्च किया गया प्रथम पीढ़ी का वैक्यूम ट्यूब कैलकुलेटर"}],"exp":{"en":"Launched in 1964, the IBM System/360 was a groundbreaking family of software-compatible mainframes whose original models used IBM's hybrid Solid Logic Technology (SLT).","hi":"IBM System/360, 1964 में लॉन्च हुआ IBM का कंपैटिबल मेनफ्रेम परिवार था, जिसके शुरुआती मॉडलों में हाइब्रिड सॉलिड लॉजिक टेक्नोलॉजी (Solid Logic Technology - SLT) का उपयोग हुआ था।"},"num":37},{"id":"q38","q":{"en":"Which milestone was achieved by Intel in 1971?","hi":"1971 में इंटेल (Intel) ने कौन-सा मील का पत्थर हासिल किया?"},"a":{"en":"Release of Intel 4004, an early commercially available programmable single-chip microprocessor","hi":"Intel 4004 का रिलीज़ होना, जो एक प्रारंभिक व्यावसायिक रूप से उपलब्ध प्रोग्रामेबल सिंगल-चिप माइक्रोप्रोसेसर था"},"o":[{"en":"Invention of the punched card tabulator","hi":"पंच कार्ड टैबुलेटर का आविष्कार"},{"en":"Release of Intel 4004, an early commercially available programmable single-chip microprocessor","hi":"Intel 4004 का रिलीज़ होना, जो एक प्रारंभिक व्यावसायिक रूप से उपलब्ध प्रोग्रामेबल सिंगल-चिप माइक्रोप्रोसेसर था"},{"en":"Commissioning of TIFRAC in Mumbai","hi":"मुंबई में TIFRAC की कमीशनिंग"},{"en":"Development of the Analytical Engine","hi":"एनालिटिकल इंजन का विकास"}],"exp":{"en":"In 1971, Intel released the Intel 4004, an early commercially available programmable single-chip microprocessor (4-bit).","hi":"1971 में इंटेल ने Intel 4004 रिलीज़ किया, जो व्यावसायिक रूप से उपलब्ध पहला प्रोग्रामेबल सिंगल-चिप माइक्रोप्रोसेसर था।"},"num":38},{"id":"q39","q":{"en":"When is 'World Computer Literacy Day' observed every year?","hi":"'विश्व कंप्यूटर साक्षरता दिवस' (World Computer Literacy Day) कब मनाया जाता है?"},"a":{"en":"2 December","hi":"2 दिसंबर"},"o":[{"en":"15 August","hi":"15 अगस्त"},{"en":"2 December","hi":"2 दिसंबर"},{"en":"28 February","hi":"28 फरवरी"},{"en":"5 June","hi":"5 जून"}],"exp":{"en":"World Computer Literacy Day is observed annually on 2 December to promote digital literacy and awareness worldwide.","hi":"विश्व कंप्यूटर साक्षरता दिवस (World Computer Literacy Day) प्रतिवर्ष 2 दिसंबर को मनाया जाता है।"},"num":39},{"id":"q40","q":{"en":"Which was the first electronic digital computer installed in India?","hi":"भारत में स्थापित (installed) पहला इलेक्ट्रॉनिक डिजिटल कंप्यूटर कौन-सा था?"},"a":{"en":"HEC-2M, which became operational in 1956 at the Indian Statistical Institute (ISI), Kolkata","hi":"HEC-2M, जो 1956 में भारतीय सांख्यिकी संस्थान (ISI), कोलकाता में कार्यरत हुआ"},"o":[{"en":"PARAM 8000 at C-DAC Pune in 1991","hi":"1991 में सी-डैक पुणे में परम 8000"},{"en":"HEC-2M, which became operational in 1956 at the Indian Statistical Institute (ISI), Kolkata","hi":"HEC-2M, जो 1956 में भारतीय सांख्यिकी संस्थान (ISI), कोलकाता में कार्यरत हुआ"},{"en":"ENIAC at IISc Bengaluru in 1946","hi":"1946 में IISc बेंगलुरु में ENIAC"},{"en":"IBM 1401 at IIT Kanpur in 1975","hi":"1975 में आईआईटी कानपुर में IBM 1401"}],"exp":{"en":"The first electronic digital computer installed in India was the HEC-2M (Hollerith Electronic Computer - Model 2M), which became operational in 1956 at the Indian Statistical Institute (ISI), Kolkata.","hi":"भारत में स्थापित पहला इलेक्ट्रॉनिक डिजिटल कंप्यूटर HEC-2M था, जो 1956 में भारतीय सांख्यिकी संस्थान (ISI), कोलकाता में कार्यरत हुआ।"},"num":40},{"id":"q41","q":{"en":"What was 'TIFRAC' and when was its full-scale machine commissioned?","hi":"'TIFRAC' क्या था और इसकी पूर्ण-स्तरीय मशीन कब कमीशन हुई?"},"a":{"en":"TIFR's indigenous digital computer, commissioned in February 1960","hi":"TIFR का स्वदेशी डिजिटल कंप्यूटर, जो फरवरी 1960 में कमीशन हुआ"},"o":[{"en":"An imported British tabulator installed in 1890","hi":"1890 में स्थापित एक आयातित ब्रिटिश टैबुलेटर"},{"en":"A Russian analog computer used for census","hi":"जनगणना के लिए प्रयुक्त एक रूसी एनालॉग कंप्यूटर"},{"en":"TIFR's indigenous digital computer, commissioned in February 1960","hi":"TIFR का स्वदेशी डिजिटल कंप्यूटर, जो फरवरी 1960 में कमीशन हुआ"},{"en":"A fourth-generation microprocessor made by Intel in 1971","hi":"1971 में इंटेल द्वारा निर्मित चौथी पीढ़ी का माइक्रोप्रोसेसर"}],"exp":{"en":"TIFRAC (Tata Institute of Fundamental Research Automatic Calculator) was India's first indigenous digital computer, formally commissioned in February 1960 at TIFR Mumbai.","hi":"TIFRAC टाटा मूलभूत अनुसंधान संस्थान (TIFR) द्वारा विकसित भारत का पहला स्वदेशी डिजिटल कंप्यूटर था, जिसकी पूर्ण-स्तरीय मशीन फरवरी 1960 में कमीशन हुई।"},"num":41},{"id":"q42","q":{"en":"With which organization do the notes associate the computer named 'Siddharth'?","hi":"नोट्स में 'सिद्धार्थ' (Siddharth) कंप्यूटर को किस संस्था से जोड़ा गया है?"},"a":{"en":"Electronics Corporation of India Limited (ECIL)","hi":"इलेक्ट्रॉनिक्स कॉर्पोरेशन ऑफ इंडिया लिमिटेड (ECIL)"},"o":[{"en":"International Business Machines (IBM)","hi":"आईबीएम (IBM)"},{"en":"Reserve Bank of India (RBI)","hi":"भारतीय रिज़र्व बैंक (RBI)"},{"en":"Electronics Corporation of India Limited (ECIL)","hi":"इलेक्ट्रॉनिक्स कॉर्पोरेशन ऑफ इंडिया लिमिटेड (ECIL)"},{"en":"National Aeronautics and Space Administration (NASA)","hi":"नासा (NASA)"}],"exp":{"en":"The study notes associate the computer named 'Siddharth' with the Electronics Corporation of India Limited (ECIL), while TIFRAC is remembered as India's first indigenous digital computer.","hi":"नोट्स में 'सिद्धार्थ' (Siddharth) को इलेक्ट्रॉनिक्स कॉर्पोरेशन ऑफ इंडिया लिमिटेड (ECIL) से जोड़ा गया है, जबकि भारत के पहले स्वदेशी डिजिटल कंप्यूटर के रूप में TIFRAC को याद रखा जाता है।"},"num":42},{"id":"q43","q":{"en":"When was the 'CDC 6600' introduced and who was its lead designer?","hi":"'CDC 6600' कब आया और इसके मुख्य डिज़ाइनर कौन थे?"},"a":{"en":"1964, lead designer Seymour Cray (often called the world's first successful supercomputer)","hi":"1964 में, मुख्य डिज़ाइनर सीमोर क्रे (इसे अक्सर दुनिया का पहला सफल सुपर कंप्यूटर कहा जाता है)"},"o":[{"en":"1946, lead designer Herman Hollerith","hi":"1946 में, मुख्य डिज़ाइनर हरमन होलेरिथ"},{"en":"1985, lead designer Tim Berners-Lee","hi":"1985 में, मुख्य डिज़ाइनर टिम बर्नर्स-ली"},{"en":"1951, lead designer Blaise Pascal","hi":"1951 में, मुख्य डिज़ाइनर ब्लेज़ पास्कल"},{"en":"1964, lead designer Seymour Cray (often called the world's first successful supercomputer)","hi":"1964 में, मुख्य डिज़ाइनर सीमोर क्रे (इसे अक्सर दुनिया का पहला सफल सुपर कंप्यूटर कहा जाता है)"}],"exp":{"en":"Introduced in 1964 and designed by lead architect Seymour Cray, the CDC 6600 is widely regarded as the world's first successful supercomputer.","hi":"CDC 6600 वर्ष 1964 में आया और इसके मुख्य डिज़ाइनर सीमोर क्रे (Seymour Cray) थे; इसे अक्सर दुनिया का पहला सफल सुपर कंप्यूटर कहा जाता है।"},"num":43},{"id":"q44","q":{"en":"When was the 'Cray-1' supercomputer introduced and who designed it?","hi":"'Cray-1' सुपर कंप्यूटर कब आया और इसे किसने डिज़ाइन किया?"},"a":{"en":"In 1976, designed by Seymour Cray","hi":"1976 में, सीमोर क्रे (Seymour Cray) द्वारा डिज़ाइन किया गया"},"o":[{"en":"In 1956, designed by John Napier","hi":"1956 में, जॉन नेपियर द्वारा डिज़ाइन किया गया"},{"en":"In 1940, designed by Alan Turing","hi":"1940 में, एलन ट्यूरिंग द्वारा डिज़ाइन किया गया"},{"en":"In 1976, designed by Seymour Cray","hi":"1976 में, सीमोर क्रे (Seymour Cray) द्वारा डिज़ाइन किया गया"},{"en":"In 1999, designed by Charles Babbage","hi":"1999 में, चार्ल्स बैबेज द्वारा डिज़ाइन किया गया"}],"exp":{"en":"The iconic Cray-1 vector supercomputer was introduced in 1976 and designed by Seymour Cray at Cray Research.","hi":"प्रसिद्ध सुपर कंप्यूटर Cray-1 वर्ष 1976 में आया और इसे सीमोर क्रे (Seymour Cray) ने डिज़ाइन किया था।"},"num":44},{"id":"q45","q":{"en":"How do modern supercomputers execute complex jobs at ultra-high speeds?","hi":"आधुनिक सुपर कंप्यूटर जटिल कार्यों को इतनी तेज़ी से कैसे करते हैं?"},"a":{"en":"By using thousands of processors or cores performing computations in parallel","hi":"बहुत सारे प्रोसेसर या कोर (cores) द्वारा समानांतर (parallel) रूप में गणना करके"},"o":[{"en":"By using thousands of processors or cores performing computations in parallel","hi":"बहुत सारे प्रोसेसर या कोर (cores) द्वारा समानांतर (parallel) रूप में गणना करके"},{"en":"By feeding paper punched cards one by one into a mechanical gear","hi":"यांत्रिक गियर में एक-एक करके पेपर पंच कार्ड डालकर"},{"en":"By removing all memory and storage components","hi":"सभी मेमोरी और स्टोरेज घटकों को हटाकर"},{"en":"By manually sliding wooden beads on copper wires","hi":"तांबे के तारों पर लकड़ी के मोतियों को हाथ से सरकाकर"}],"exp":{"en":"Modern supercomputers achieve massive speeds through parallel processing, where thousands of processors or cores execute computations simultaneously.","hi":"आधुनिक सुपर कंप्यूटर समानांतर प्रोसेसिंग (parallel processing) का उपयोग करते हैं, जिसमें बहुत सारे प्रोसेसर या कोर एक साथ गणनाएँ करते हैं।"},"num":45}],"source_pages":"Source pp. 04–05, 07–08, 13"},{"title":{"en":"4. Five Generations of Computers","hi":"4. कंप्यूटर की पाँच पीढ़ियाँ"},"questions":[{"id":"q46","q":{"en":"What were the core hardware technology and programming language of First Generation computers (1940–1956 in notes)?","hi":"प्रथम पीढ़ी (1st Generation) के कंप्यूटरों की मुख्य तकनीक और भाषा क्या थी (नोट्स की अवधि: 1940–1956)?"},"a":{"en":"Vacuum tubes and binary machine language","hi":"वैक्यूम ट्यूब और बाइनरी मशीन भाषा"},"o":[{"en":"Microprocessors and Python","hi":"माइक्रोप्रोसेसर और पायथन"},{"en":"Vacuum tubes and binary machine language","hi":"वैक्यूम ट्यूब और बाइनरी मशीन भाषा"},{"en":"Integrated Circuits and Java","hi":"इंटीग्रेटेड सर्किट (IC) और जावा"},{"en":"Transistors and COBOL","hi":"ट्रांजिस्टर और COBOL"}],"exp":{"en":"First Generation computers (1940–1956 in notes) relied on Vacuum Tubes for circuitry and used binary machine language (0s and 1s) for programming.","hi":"प्रथम पीढ़ी (1940–1956) के कंप्यूटरों की मुख्य हार्डवेयर तकनीक वैक्यूम ट्यूब (Vacuum tubes) और प्रोग्रामिंग भाषा बाइनरी मशीन भाषा थी।"},"num":46},{"id":"q47","q":{"en":"Which of the following are classic examples of First Generation computers?","hi":"निम्नलिखित में से कौन-से प्रथम पीढ़ी (1st Generation) के कंप्यूटरों के उदाहरण हैं?"},"a":{"en":"ENIAC, EDVAC, and UNIVAC I","hi":"ENIAC, EDVAC और UNIVAC I"},"o":[{"en":"ENIAC, EDVAC, and UNIVAC I","hi":"ENIAC, EDVAC और UNIVAC I"},{"en":"IBM 360/370 and NCR 395","hi":"IBM 360/370 और NCR 395"},{"en":"Apple II and PARAM 10000","hi":"Apple II और PARAM 10000"},{"en":"IBM 1401, CDC 1604, and ICL 1901","hi":"IBM 1401, CDC 1604 और ICL 1901"}],"exp":{"en":"Classic examples of First Generation vacuum-tube computers include ENIAC, EDVAC, and UNIVAC I.","hi":"प्रथम पीढ़ी के कंप्यूटरों के प्रमुख उदाहरण ENIAC, EDVAC और UNIVAC I हैं।"},"num":47},{"id":"q48","q":{"en":"What was the main hardware technology of Second Generation computers (1957–1963 in notes)?","hi":"द्वितीय पीढ़ी (2nd Generation) के कंप्यूटरों की मुख्य हार्डवेयर तकनीक क्या थी (नोट्स की अवधि: 1957–1963)?"},"a":{"en":"Transistors","hi":"ट्रांजिस्टर (Transistors)"},"o":[{"en":"Quantum Qubits","hi":"क्वांटम क्यूबिट्स"},{"en":"Transistors","hi":"ट्रांजिस्टर (Transistors)"},{"en":"ULSI Microprocessors","hi":"ULSI माइक्रोप्रोसेसर"},{"en":"Vacuum tubes","hi":"वैक्यूम ट्यूब"}],"exp":{"en":"Second Generation computers (1957–1963 in notes) replaced vacuum tubes with discrete Transistors, making machines smaller, faster, and more reliable.","hi":"द्वितीय पीढ़ी (1957–1963) के कंप्यूटरों की मुख्य तकनीक ट्रांजिस्टर (Transistors) थी।"},"num":48},{"id":"q49","q":{"en":"Which languages were used in Second Generation computers?","hi":"द्वितीय पीढ़ी (2nd Generation) के कंप्यूटरों में कौन-सी भाषाएँ उपयोग हुईं?"},"a":{"en":"Assembly/symbolic language and early high-level languages like COBOL and FORTRAN","hi":"असेंबली या प्रतीकात्मक (symbolic) भाषा, और COBOL तथा FORTRAN जैसी उच्च-स्तरीय भाषाएँ"},"o":[{"en":"Only natural human speech","hi":"केवल प्राकृतिक मानवीय बोली"},{"en":"Only binary 0s and 1s without any symbolic code","hi":"बिना किसी प्रतीकात्मक कोड के केवल बाइनरी 0 और 1"},{"en":"Assembly/symbolic language and early high-level languages like COBOL and FORTRAN","hi":"असेंबली या प्रतीकात्मक (symbolic) भाषा, और COBOL तथा FORTRAN जैसी उच्च-स्तरीय भाषाएँ"},{"en":"HTML5, CSS3, and TypeScript","hi":"HTML5, CSS3 और टाइपस्क्रिप्ट"}],"exp":{"en":"Second Generation computers moved from raw binary to Assembly/symbolic languages and early high-level languages such as COBOL and FORTRAN.","hi":"द्वितीय पीढ़ी में असेंबली/प्रतीकात्मक (symbolic) भाषा और COBOL तथा FORTRAN जैसी उच्च-स्तरीय भाषाओं का उपयोग हुआ।"},"num":49},{"id":"q50","q":{"en":"Which of the following sets lists examples of Second Generation computers from the notes?","hi":"नोट्स में दिए गए द्वितीय पीढ़ी (2nd Generation) के कंप्यूटरों के उदाहरण कौन-से हैं?"},"a":{"en":"IBM 700-series, IBM 1401, IBM 1620, CDC 1604, CDC 3600, Atlas, and ICL 1901","hi":"IBM 700-सीरीज़, IBM 1401, IBM 1620, CDC 1604, CDC 3600, Atlas और ICL 1901"},"o":[{"en":"IBM 700-series, IBM 1401, IBM 1620, CDC 1604, CDC 3600, Atlas, and ICL 1901","hi":"IBM 700-सीरीज़, IBM 1401, IBM 1620, CDC 1604, CDC 3600, Atlas और ICL 1901"},{"en":"Intel 4004, Apple Macintosh, and Cray-1","hi":"Intel 4004, Apple Macintosh और Cray-1"},{"en":"Abacus, Napier's Bones, and Pascaline","hi":"अबेकस, नेपियर्स बोन्स और पास्कलाइन"},{"en":"ENIAC, EDVAC, and ABC","hi":"ENIAC, EDVAC और ABC"}],"exp":{"en":"Examples of Second Generation computers listed in the notes are the IBM 700-series, IBM 1401, IBM 1620, CDC 1604, CDC 3600, Atlas, and ICL 1901.","hi":"द्वितीय पीढ़ी के उदाहरणों में IBM 700-सीरीज़, IBM 1401, IBM 1620, CDC 1604, CDC 3600, Atlas और ICL 1901 शामिल हैं।"},"num":50},{"id":"q51","q":{"en":"What is the standard exam keyword for Third Generation computers (1965–1971 in notes)?","hi":"तृतीय पीढ़ी (3rd Generation) के कंप्यूटरों का मानक परीक्षा कीवर्ड क्या है (नोट्स की अवधि: 1965–1971)?"},"a":{"en":"Integrated Circuit (IC)","hi":"इंटीग्रेटेड सर्किट (IC)"},"o":[{"en":"Punched Card","hi":"पंच कार्ड"},{"en":"Mechanical Relay","hi":"मैकेनिकल रिले"},{"en":"Vacuum Tube","hi":"वैक्यूम ट्यूब"},{"en":"Integrated Circuit (IC)","hi":"इंटीग्रेटेड सर्किट (IC)"}],"exp":{"en":"The defining hardware keyword for Third Generation computers (1965–1971 in notes) is the Integrated Circuit (IC), where multiple transistors and components were fabricated on a silicon chip.","hi":"तृतीय पीढ़ी (1965–1971) के कंप्यूटरों का मानक परीक्षा कीवर्ड इंटीग्रेटेड सर्किट (Integrated Circuit - IC) है।"},"num":51},{"id":"q52","q":{"en":"Which computer models are listed as examples of the Third Generation in the notes?","hi":"नोट्स में तृतीय पीढ़ी (3rd Generation) के उदाहरण के रूप में कौन-से कंप्यूटर दिए गए हैं?"},"a":{"en":"IBM 360/370, NCR 395, CDC 1700, and ICL 2903 (Note: IBM System/360 launched in 1964)","hi":"IBM 360/370, NCR 395, CDC 1700 और ICL 2903 (IBM System/360 का लॉन्च वर्ष 1964 है)"},"o":[{"en":"IBM 360/370, NCR 395, CDC 1700, and ICL 2903 (Note: IBM System/360 launched in 1964)","hi":"IBM 360/370, NCR 395, CDC 1700 और ICL 2903 (IBM System/360 का लॉन्च वर्ष 1964 है)"},{"en":"DEC PDP-1 and HEC-2M","hi":"DEC PDP-1 और HEC-2M"},{"en":"Pascaline and Analytical Engine","hi":"पास्कलाइन और एनालिटिकल इंजन"},{"en":"ENIAC and UNIVAC I","hi":"ENIAC और UNIVAC I"}],"exp":{"en":"Third Generation examples in the notes include IBM 360/370, NCR 395, CDC 1700, and ICL 2903 (with IBM System/360's individual launch year being 1964).","hi":"नोट्स में तृतीय पीढ़ी के उदाहरण IBM 360/370, NCR 395, CDC 1700 और ICL 2903 दिए गए हैं (IBM System/360 का लॉन्च वर्ष अलग से 1964 है)।"},"num":52},{"id":"q53","q":{"en":"With which technology is the Fourth Generation of computers (from 1971 onwards) associated?","hi":"चतुर्थ पीढ़ी (4th Generation) के कंप्यूटर (1971 से आगे) किस तकनीक से जुड़े हैं?"},"a":{"en":"Microprocessors and Large/Very-Large-Scale Integration (LSI/VLSI)","hi":"माइक्रोप्रोसेसर और लार्ज/वेरी-लार्ज-स्केल इंटीग्रेशन (LSI/VLSI)"},"o":[{"en":"Discrete germanium transistors only","hi":"केवल अलग जर्मेनियम ट्रांजिस्टर"},{"en":"Sliding wooden beads","hi":"सरकने वाले लकड़ी के मोती"},{"en":"Vacuum tubes and magnetic drums","hi":"वैक्यूम ट्यूब और चुंबकीय ड्रम"},{"en":"Microprocessors and Large/Very-Large-Scale Integration (LSI/VLSI)","hi":"माइक्रोप्रोसेसर और लार्ज/वेरी-लार्ज-स्केल इंटीग्रेशन (LSI/VLSI)"}],"exp":{"en":"Fourth Generation computers (from 1971 onwards) are defined by Microprocessors built using Large-Scale Integration (LSI) and Very-Large-Scale Integration (VLSI).","hi":"चतुर्थ पीढ़ी (1971 से) के कंप्यूटर माइक्रोप्रोसेसर और LSI/VLSI (लार्ज/वेरी-लार्ज-स्केल इंटीग्रेशन) तकनीक से जुड़े हैं।"},"num":53},{"id":"q54","q":{"en":"Which systems and programming languages are given in the notes as examples of the Fourth Generation / broad microprocessor era?","hi":"चतुर्थ पीढ़ी (4th Generation) / व्यापक माइक्रोप्रोसेसर युग के उदाहरण और भाषाओं के रूप में नोट्स में क्या दिया गया है?"},"a":{"en":"Apple and DCM systems; languages like C, C++, and Java","hi":"Apple और DCM सिस्टम्स; भाषाएँ जैसे C, C++ और Java"},"o":[{"en":"Hollerith tabulator; punched hole patterns","hi":"होलेरिथ टैबुलेटर; पंच होल पैटर्न"},{"en":"Apple and DCM systems; languages like C, C++, and Java","hi":"Apple और DCM सिस्टम्स; भाषाएँ जैसे C, C++ और Java"},{"en":"ENIAC and EDVAC; only binary machine code","hi":"ENIAC और EDVAC; केवल बाइनरी मशीन कोड"},{"en":"Analytical Engine; Bernoulli cards","hi":"एनालिटिकल इंजन; बरनौली कार्ड"}],"exp":{"en":"The notes cite Apple and DCM systems along with programming languages like C, C++, and Java as examples of the broad microprocessor era (Fourth Generation).","hi":"नोट्स में चतुर्थ पीढ़ी (व्यापक माइक्रोप्रोसेसर युग) के उदाहरणों के रूप में Apple और DCM सिस्टम्स तथा C, C++ और Java भाषाओं का उल्लेख है।"},"num":54},{"id":"q55","q":{"en":"What is the primary exam keyword for the Fifth Generation of computers (along with optical fibre and CRAY computers in notes)?","hi":"पंचम पीढ़ी (5th Generation) के कंप्यूटरों का मुख्य परीक्षा कीवर्ड क्या है (जिसमें नोट्स ऑप्टिकल फाइबर और CRAY कंप्यूटर भी सूचीबद्ध करते हैं)?"},"a":{"en":"Artificial Intelligence (AI)","hi":"आर्टिफिशियल इंटेलिजेंस (AI - कृत्रिम बुद्धिमत्ता)"},"o":[{"en":"Artificial Intelligence (AI)","hi":"आर्टिफिशियल इंटेलिजेंस (AI - कृत्रिम बुद्धिमत्ता)"},{"en":"Mechanical Abacus","hi":"यांत्रिक अबेकस"},{"en":"Punched Paper Tape","hi":"पंच पेपर टेप"},{"en":"Thermionic Valve","hi":"थर्मिओनिक वाल्व"}],"exp":{"en":"The primary exam keyword for Fifth Generation computers is Artificial Intelligence (AI) (and ULSI/parallel processing); the notes also list optical fibre and CRAY computers.","hi":"पंचम पीढ़ी के कंप्यूटरों का मुख्य परीक्षा कीवर्ड आर्टिफिशियल इंटेलिजेंस (AI) है (नोट्स में ऑप्टिकल फाइबर और CRAY कंप्यूटर भी सूचीबद्ध हैं)।"},"num":55},{"id":"q56","q":{"en":"What is the full form of COBOL?","hi":"COBOL का पूर्ण रूप (Full Form) क्या है?"},"a":{"en":"Common Business-Oriented Language","hi":"कॉमन बिजनेस-ओरिएंटेड लैंग्वेज"},"o":[{"en":"Central Business Optical Link","hi":"सेंट्रल बिजनेस ऑप्टिकल लिंक"},{"en":"Compiled Binary Object Logic","hi":"कंपाइल्ड बाइनरी ऑब्जेक्ट लॉजिक"},{"en":"Common Business-Oriented Language","hi":"कॉमन बिजनेस-ओरिएंटेड लैंग्वेज"},{"en":"Computer Basic Operating Language","hi":"कंप्यूटर बेसिक ऑपरेटिंग लैंग्वेज"}],"exp":{"en":"COBOL stands for Common Business-Oriented Language, a high-level programming language designed for business and administrative data processing.","hi":"COBOL का पूर्ण रूप Common Business-Oriented Language है।"},"num":56},{"id":"q57","q":{"en":"What is the full form of FORTRAN according to IBM history and standard notes?","hi":"IBM के इतिहास और नोट्स के अनुसार FORTRAN का पूर्ण रूप क्या है?"},"a":{"en":"Formula Translation (also written as 'Formula Translator' in some notes)","hi":"फॉर्मूला ट्रांसलेशन (नोट्स में 'Formula Translator' भी लिखा मिलता है)"},"o":[{"en":"Format Transfer Utility","hi":"फॉर्मेट ट्रांसफर यूटिलिटी"},{"en":"Forward Transistor Architecture","hi":"फॉरवर्ड ट्रांजिस्टर आर्किटेक्चर"},{"en":"Formula Translation (also written as 'Formula Translator' in some notes)","hi":"फॉर्मूला ट्रांसलेशन (नोट्स में 'Formula Translator' भी लिखा मिलता है)"},{"en":"Foreign Transaction Network","hi":"फॉरेन ट्रांजेक्शन नेटवर्क"}],"exp":{"en":"FORTRAN stands for Formula Translation according to IBM's official history (though some exam notes also write 'Formula Translator').","hi":"IBM के इतिहास के अनुसार FORTRAN का पूर्ण रूप Formula Translation है (नोट्स में इसे 'Formula Translator' भी लिखा गया है)।"},"num":57},{"id":"q58","q":{"en":"Since exact generation date ranges vary across textbooks, what is the standard technological sequence to remember for exams?","hi":"चूँकि विभिन्न पाठ्यपुस्तकों में पीढ़ियों की तिथियाँ भिन्न हो सकती हैं, परीक्षा के लिए याद रखने योग्य मानक तकनीकी अनुक्रम क्या है?"},"a":{"en":"Vacuum tube → Transistor → IC → Microprocessor → AI focus","hi":"वैक्यूम ट्यूब → ट्रांजिस्टर → IC → माइक्रोप्रोसेसर → AI फोकस"},"o":[{"en":"IC → Vacuum tube → Transistor → AI focus → Microprocessor","hi":"IC → वैक्यूम ट्यूब → ट्रांजिस्टर → AI फोकस → माइक्रोप्रोसेसर"},{"en":"Microprocessor → IC → Transistor → Vacuum tube → AI focus","hi":"माइक्रोप्रोसेसर → IC → ट्रांजिस्टर → वैक्यूम ट्यूब → AI फोकस"},{"en":"Vacuum tube → Transistor → IC → Microprocessor → AI focus","hi":"वैक्यूम ट्यूब → ट्रांजिस्टर → IC → माइक्रोप्रोसेसर → AI फोकस"},{"en":"Transistor → Vacuum tube → Microprocessor → IC → AI focus","hi":"ट्रांजिस्टर → वैक्यूम ट्यूब → माइक्रोप्रोसेसर → IC → AI फोकस"}],"exp":{"en":"Because exact generation year ranges vary across textbooks, exams primarily test the core hardware sequence: 1st Vacuum tube → 2nd Transistor → 3rd IC → 4th Microprocessor → 5th AI focus.","hi":"विभिन्न पुस्तकों में पीढ़ियों के वर्ष भिन्न हो सकते हैं, इसलिए मानक तकनीकी अनुक्रम याद रखें: वैक्यूम ट्यूब (1st) → ट्रांजिस्टर (2nd) → IC (3rd) → माइक्रोप्रोसेसर (4th) → AI फोकस (5th)।"},"num":58}],"source_pages":"Source pp. 06–07"},{"title":{"en":"5. Analog, Digital & Hybrid Computers","hi":"5. एनालॉग, डिजिटल और हाइब्रिड कंप्यूटर"},"questions":[{"id":"q59","q":{"en":"How many types of computers are classified on the basis of data handling?","hi":"डेटा हैंडलिंग (Data Handling) के आधार पर कंप्यूटर के कितने प्रकार हैं?"},"a":{"en":"Three — Analog, Digital, and Hybrid","hi":"तीन — एनालॉग (Analog), डिजिटल (Digital) और हाइब्रिड (Hybrid)"},"o":[{"en":"Two — Hardware and Software","hi":"दो — हार्डवेयर और सॉफ्टवेयर"},{"en":"Four — Input, Process, Output, and Storage","hi":"चार — इनपुट, प्रोसेस, आउटपुट और स्टोरेज"},{"en":"Five — First to Fifth Generation","hi":"पाँच — पहली से पाँचवीं पीढ़ी"},{"en":"Three — Analog, Digital, and Hybrid","hi":"तीन — एनालॉग (Analog), डिजिटल (Digital) और हाइब्रिड (Hybrid)"}],"exp":{"en":"On the basis of data handling principles, computers are classified into three types: Analog, Digital, and Hybrid.","hi":"डेटा हैंडलिंग के आधार पर कंप्यूटर तीन प्रकार के होते हैं: एनालॉग (Analog), डिजिटल (Digital) और हाइब्रिड (Hybrid)।"},"num":59},{"id":"q60","q":{"en":"On what type of data does an 'Analog Computer' operate?","hi":"'एनालॉग कंप्यूटर' (Analog Computer) किस प्रकार के डेटा पर काम करता है?"},"a":{"en":"Continuous data, such as continuously changing values of voltage or other physical quantities","hi":"सतत डेटा (Continuous data), जैसे वोल्टेज या अन्य भौतिक राशियों के लगातार बदलते मान"},"o":[{"en":"Only punched card holes","hi":"केवल पंच कार्ड के छेद"},{"en":"Only alphabetical text files","hi":"केवल वर्णमाला टेक्स्ट फ़ाइलें"},{"en":"Continuous data, such as continuously changing values of voltage or other physical quantities","hi":"सतत डेटा (Continuous data), जैसे वोल्टेज या अन्य भौतिक राशियों के लगातार बदलते मान"},{"en":"Only discrete binary digits 0 and 1","hi":"केवल असतत बाइनरी अंक 0 और 1"}],"exp":{"en":"An Analog Computer operates on continuous data, measuring continuously changing physical quantities such as voltage, pressure, speed, or temperature.","hi":"एनालॉग कंप्यूटर सतत डेटा (continuous data), जैसे वोल्टेज, तापमान या दबाव जैसी भौतिक राशियों के लगातार बदलते मानों पर काम करता है।"},"num":60},{"id":"q61","q":{"en":"What concept is illustrated by a mercury thermometer and an analog speedometer?","hi":"पारा थर्मामीटर (Mercury Thermometer) और एनालॉग स्पीडोमीटर किस अवधारणा को दर्शाते हैं?"},"a":{"en":"Continuous measurement (examples of analog instruments)","hi":"सतत मापन (Continuous measurement — ये एनालॉग उपकरणों के उदाहरण हैं)"},"o":[{"en":"Quantum qubit entanglement","hi":"क्वांटम क्यूबिट उलझाव"},{"en":"Discrete binary bit encryption","hi":"असतत बाइनरी बिट एन्क्रिप्शन"},{"en":"Cloud database virtualization","hi":"क्लाउड डेटाबेस वर्चुअलाइजेशन"},{"en":"Continuous measurement (examples of analog instruments)","hi":"सतत मापन (Continuous measurement — ये एनालॉग उपकरणों के उदाहरण हैं)"}],"exp":{"en":"A mercury thermometer and an analog speedometer illustrate continuous physical measurement, serving as classic examples of analog instruments.","hi":"पारा थर्मामीटर और एनालॉग स्पीडोमीटर सतत मापन (continuous measurement) के सिद्धांत को दर्शाते हैं और एनालॉग उपकरणों के उदाहरण हैं।"},"num":61},{"id":"q62","q":{"en":"In what form does a 'Digital Computer' process data?","hi":"'डिजिटल कंप्यूटर' (Digital Computer) डेटा को किस रूप में प्रोसेस करता है?"},"a":{"en":"Discrete values, typically represented as binary bits 0 and 1","hi":"असतत मान (Discrete values), जो आमतौर पर बाइनरी बिट्स 0 और 1 में दर्शाए जाते हैं"},"o":[{"en":"Continuous fluid pressure waves","hi":"सतत द्रव दबाव तरंगें"},{"en":"Discrete values, typically represented as binary bits 0 and 1","hi":"असतत मान (Discrete values), जो आमतौर पर बाइनरी बिट्स 0 और 1 में दर्शाए जाते हैं"},{"en":"Varying mercury column height","hi":"पारे के स्तंभ की बदलती ऊँचाई"},{"en":"Mechanical gear rotation angles only","hi":"केवल यांत्रिक गियर रोटेशन कोण"}],"exp":{"en":"A Digital Computer processes data in discrete values, representing all information using binary digits (bits) 0 and 1.","hi":"डिजिटल कंप्यूटर असतत मानों (discrete values) में डेटा प्रोसेस करता है, जिन्हें आमतौर पर बाइनरी बिट्स 0 और 1 में दर्शाया जाता है।"},"num":62},{"id":"q63","q":{"en":"Which of the following are common examples and uses of Digital Computers?","hi":"डिजिटल कंप्यूटरों के सामान्य उदाहरण और उपयोग क्या हैं?"},"a":{"en":"Laptop, desktop, and smartphone — used for calculation, editing, browsing, and gaming","hi":"लैपटॉप, डेस्कटॉप और स्मार्टफोन — गणना, एडिटिंग, ब्राउज़िंग और गेमिंग के लिए प्रयुक्त"},"o":[{"en":"Laptop, desktop, and smartphone — used for calculation, editing, browsing, and gaming","hi":"लैपटॉप, डेस्कटॉप और स्मार्टफोन — गणना, एडिटिंग, ब्राउज़िंग और गेमिंग के लिए प्रयुक्त"},{"en":"Mercury clinical thermometer — used only for body temperature","hi":"पारा क्लिनिकल थर्मामीटर — केवल शरीर के तापमान के लिए"},{"en":"Simple pendulum clock — mechanical oscillation","hi":"साधारण पेंडुलम घड़ी — यांत्रिक दोलन"},{"en":"Abacus and Napier's Bones — manual bead sliding","hi":"अबेकस और नेपियर्स बोन्स — मैनुअल मनके सरकाना"}],"exp":{"en":"Laptops, desktops, and smartphones are everyday digital computers used for calculation, document editing, web browsing, and gaming.","hi":"लैपटॉप, डेस्कटॉप और स्मार्टफोन डिजिटल कंप्यूटर के उदाहरण हैं, जिनका उपयोग गणना, एडिटिंग, ब्राउज़िंग और गेमिंग में किया जाता है।"},"num":63},{"id":"q64","q":{"en":"What does a 'Hybrid Computer' combine?","hi":"'हाइब्रिड कंप्यूटर' (Hybrid Computer) किन दो विशेषताओं को मिलाता है?"},"a":{"en":"Analog measurement and digital processing (handling both continuous and discrete data)","hi":"एनालॉग मापन और डिजिटल प्रोसेसिंग (यह सतत और असतत दोनों डेटा को संभाल सकता है)"},"o":[{"en":"Only mechanical beads and paper cards","hi":"केवल यांत्रिक मनके और कागज के कार्ड"},{"en":"Analog measurement and digital processing (handling both continuous and discrete data)","hi":"एनालॉग मापन और डिजिटल प्रोसेसिंग (यह सतत और असतत दोनों डेटा को संभाल सकता है)"},{"en":"Only vacuum tubes and wooden rods","hi":"केवल वैक्यूम ट्यूब और लकड़ी की छड़ें"},{"en":"Keyboard input and paper printing without a CPU","hi":"बिना CPU के कीबोर्ड इनपुट और पेपर प्रिंटिंग"}],"exp":{"en":"A Hybrid Computer combines the continuous measurement capability of analog systems with the discrete processing and accuracy of digital computers.","hi":"हाइब्रिड कंप्यूटर एनालॉग मापन और डिजिटल प्रोसेसिंग दोनों को मिलाता है, इसलिए यह सतत (continuous) और असतत (discrete) दोनों प्रकार के डेटा को संभाल सकता है।"},"num":64},{"id":"q65","q":{"en":"Why is a modern petrol pump dispenser often cited as an example of a hybrid system?","hi":"पेट्रोल पंप मशीन को हाइब्रिड सिस्टम का उदाहरण क्यों दिया जाता है?"},"a":{"en":"Because it senses continuous fuel flow/quantity (analog) and digitally calculates and displays the quantity and price","hi":"क्योंकि इसमें ईंधन का प्रवाह/मात्रा सेंस होती है (एनालॉग) और इलेक्ट्रॉनिक्स कीमत की डिजिटल गणना करके डिस्प्ले करती है"},"o":[{"en":"Because it uses both a keyboard and a mouse for gaming","hi":"क्योंकि यह गेमिंग के लिए कीबोर्ड और माउस दोनों का उपयोग करता है"},{"en":"Because it senses continuous fuel flow/quantity (analog) and digitally calculates and displays the quantity and price","hi":"क्योंकि इसमें ईंधन का प्रवाह/मात्रा सेंस होती है (एनालॉग) और इलेक्ट्रॉनिक्स कीमत की डिजिटल गणना करके डिस्प्ले करती है"},{"en":"Because it runs on both petrol and diesel fuels","hi":"क्योंकि यह पेट्रोल और डीजल दोनों ईंधनों पर चलता है"},{"en":"Because it was invented by Charles Babbage in 1837","hi":"क्योंकि इसका आविष्कार 1837 में चार्ल्स बैबेज ने किया था"}],"exp":{"en":"A petrol pump dispenser is a classic hybrid example because it senses continuous fuel flow/volume (analog) and converts it into a digital calculation of volume and price.","hi":"पेट्रोल पंप में ईंधन के प्रवाह/मात्रा को एनालॉग रूप में मापा जाता है और इलेक्ट्रॉनिक्स द्वारा उसकी कीमत की डिजिटल गणना करके स्क्रीन पर दिखाया जाता है।"},"num":65},{"id":"q66","q":{"en":"Where else are Hybrid Computer systems commonly used?","hi":"हाइब्रिड कंप्यूटर सिस्टम अन्य किन क्षेत्रों में काम आते हैं?"},"a":{"en":"Medical systems (like heart-rate/ECG monitoring), weather forecasting, and flight simulations requiring real-time measurement and digital processing","hi":"चिकित्सा प्रणाली (जैसे हार्ट-रेट मॉनिटरिंग), मौसम पूर्वानुमान और फ्लाइट सिमुलेशन, जहाँ रियल-टाइम मापन और डिजिटल प्रोसेसिंग साथ चाहिए"},"o":[{"en":"Medical systems (like heart-rate/ECG monitoring), weather forecasting, and flight simulations requiring real-time measurement and digital processing","hi":"चिकित्सा प्रणाली (जैसे हार्ट-रेट मॉनिटरिंग), मौसम पूर्वानुमान और फ्लाइट सिमुलेशन, जहाँ रियल-टाइम मापन और डिजिटल प्रोसेसिंग साथ चाहिए"},{"en":"Only for storing static photographs on a memory card","hi":"केवल मेमोरी कार्ड पर स्थिर तस्वीरें सहेजने के लिए"},{"en":"Only for manual addition using wooden beads","hi":"केवल लकड़ी के मोतियों से मैनुअल जोड़ करने के लिए"},{"en":"Only for typing simple notepad text documents","hi":"केवल साधारण नोटपैड टेक्स्ट दस्तावेज़ टाइप करने के लिए"}],"exp":{"en":"Hybrid systems are widely used in hospital ICU/ECG heart-rate monitors, weather forecasting, and flight simulators where real-time physical sensing and digital computation work together.","hi":"हाइब्रिड सिस्टम हार्ट-रेट मॉनिटरिंग (चिकित्सा प्रणाली), मौसम पूर्वानुमान और फ्लाइट सिमुलेशन में काम आते हैं जहाँ रियल-टाइम मापन और डिजिटल प्रोसेसिंग दोनों की आवश्यकता होती है।"},"num":66}],"source_pages":"Source pp. 09–11"},{"title":{"en":"6. Microcomputer, Workstation, Mini, Mainframe & Supercomputer","hi":"6. माइक्रोकंप्यूटर, वर्कस्टेशन, मिनी, मेनफ्रेम और सुपरकंप्यूटर"},"questions":[{"id":"q67","q":{"en":"Which types of computers are listed in the notes on the basis of computing power, size, and speed?","hi":"कंप्यूटिंग पावर, आकार और गति (Speed) के आधार पर नोट्स में कौन-से प्रकार सूचीबद्ध किए गए हैं?"},"a":{"en":"Microcomputer/PC, Workstation, Minicomputer, Mainframe, and Supercomputer","hi":"माइक्रो कंप्यूटर/PC, वर्कस्टेशन, मिनी कंप्यूटर, मेनफ्रेम और सुपर कंप्यूटर"},"o":[{"en":"Microcomputer/PC, Workstation, Minicomputer, Mainframe, and Supercomputer","hi":"माइक्रो कंप्यूटर/PC, वर्कस्टेशन, मिनी कंप्यूटर, मेनफ्रेम और सुपर कंप्यूटर"},{"en":"Abacus, Pascaline, Tabulator, and Slide Rule","hi":"अबेकस, पास्कलाइन, टैबुलेटर और स्लाइड रूल"},{"en":"RAM, ROM, Cache, and Register","hi":"रैम, रोम, कैश और रजिस्टर"},{"en":"Keyboard, Mouse, Monitor, and Printer","hi":"कीबोर्ड, माउस, मॉनिटर और प्रिंटर"}],"exp":{"en":"On the basis of computing power, size, and speed, the notes classify computers into Microcomputer (PC), Workstation, Minicomputer, Mainframe, and Supercomputer.","hi":"कंप्यूटिंग पावर और गति के आधार पर नोट्स में माइक्रो कंप्यूटर/PC, वर्कस्टेशन, मिनी कंप्यूटर, मेनफ्रेम और सुपर कंप्यूटर सूचीबद्ध किए गए हैं।"},"num":67},{"id":"q68","q":{"en":"On which technology is a 'Microcomputer' based?","hi":"'माइक्रो कंप्यूटर' (Microcomputer) किस तकनीक पर आधारित होता है?"},"a":{"en":"Microprocessor technology, where CPU functions can fit on a single chip","hi":"माइक्रोप्रोसेसर तकनीक, जिसमें CPU के कार्य एक सिंगल चिप पर फिट हो सकते हैं"},"o":[{"en":"Microprocessor technology, where CPU functions can fit on a single chip","hi":"माइक्रोप्रोसेसर तकनीक, जिसमें CPU के कार्य एक सिंगल चिप पर फिट हो सकते हैं"},{"en":"Mechanical punched card readers only","hi":"केवल यांत्रिक पंच कार्ड रीडर"},{"en":"Quantum qubit cryostats only","hi":"केवल क्वांटम क्यूबिट क्रायोस्टैट"},{"en":"Thermionic vacuum tubes occupying an entire room","hi":"पूरे कमरे में फैले थर्मिओनिक वैक्यूम ट्यूब"}],"exp":{"en":"A Microcomputer is based on microprocessor technology, where the CPU's arithmetic, logic, and control functions are integrated onto a single semiconductor chip.","hi":"माइक्रो कंप्यूटर माइक्रोप्रोसेसर तकनीक पर आधारित होता है, जिसमें CPU के सभी मुख्य कार्य एक सिंगल चिप पर फिट हो सकते हैं।"},"num":68},{"id":"q69","q":{"en":"Which of the following are common examples of a Microcomputer?","hi":"माइक्रो कंप्यूटर (Microcomputer) के सामान्य उदाहरण क्या हैं?"},"a":{"en":"Desktop, laptop/notebook, tablet, and smartphone","hi":"डेस्कटॉप, लैपटॉप/नोटबुक, टैबलेट और स्मार्टफोन"},"o":[{"en":"DEC PDP-11 and VAX 11/780","hi":"DEC PDP-11 और VAX 11/780"},{"en":"Desktop, laptop/notebook, tablet, and smartphone","hi":"डेस्कटॉप, लैपटॉप/नोटबुक, टैबलेट और स्मार्टफोन"},{"en":"PARAM Siddhi, Summit, and Cray-1","hi":"परम सिद्धि, समिट और क्रे-1"},{"en":"IBM zSeries and Hitachi mainframes","hi":"IBM zSeries और हिताची मेनफ्रेम"}],"exp":{"en":"Common examples of Microcomputers include desktop PCs, laptops/notebooks, tablets, and smartphones.","hi":"माइक्रो कंप्यूटर के सामान्य उदाहरण डेस्कटॉप, लैपटॉप/नोटबुक, टैबलेट और स्मार्टफोन हैं।"},"num":69},{"id":"q70","q":{"en":"What is the primary use of a Microcomputer and its position in the general-purpose size chart?","hi":"माइक्रो कंप्यूटर का प्राथमिक उपयोग क्या है और आकार चार्ट में इसका स्थान क्या है?"},"a":{"en":"Personal and office tasks for a single user; it is the smallest general-purpose category in the size chart","hi":"आमतौर पर एकल उपयोगकर्ता (single user) के व्यक्तिगत और ऑफिस कार्य; यह आकार चार्ट में सबसे छोटी सामान्य-उद्देश्य श्रेणी है"},"o":[{"en":"Nuclear weapon simulation at national laboratories","hi":"राष्ट्रीय प्रयोगशालाओं में परमाणु हथियार सिमुलेशन"},{"en":"Controlling fuel injection inside an automobile engine","hi":"ऑटोमोबाइल इंजन के अंदर ईंधन इंजेक्शन को नियंत्रित करना"},{"en":"Supporting 10,000 concurrent bank terminals; largest category in the size chart","hi":"10,000 समवर्ती बैंक टर्मिनलों का समर्थन करना; आकार चार्ट में सबसे बड़ी श्रेणी"},{"en":"Personal and office tasks for a single user; it is the smallest general-purpose category in the size chart","hi":"आमतौर पर एकल उपयोगकर्ता (single user) के व्यक्तिगत और ऑफिस कार्य; यह आकार चार्ट में सबसे छोटी सामान्य-उद्देश्य श्रेणी है"}],"exp":{"en":"Microcomputers are primarily designed for single-user personal and office tasks, representing the smallest general-purpose category in the computer size chart.","hi":"माइक्रो कंप्यूटर का प्राथमिक उपयोग एकल उपयोगकर्ता (single user) के व्यक्तिगत और ऑफिस कार्यों के लिए होता है; आकार चार्ट में यह सबसे छोटी सामान्य-उद्देश्य श्रेणी है।"},"num":70},{"id":"q71","q":{"en":"What is a 'Workstation' in computer classification?","hi":"कंप्यूटर वर्गीकरण में 'वर्कस्टेशन' (Workstation) क्या होता है?"},"a":{"en":"A high-performance single-user computer designed for technical, engineering, or scientific work","hi":"एक उच्च-प्रदर्शन (high-performance) सिंगल-यूजर कंप्यूटर, जो तकनीकी, इंजीनियरिंग या वैज्ञानिक कार्यों के लिए बना होता है"},"o":[{"en":"A simple pocket calculator used only for addition","hi":"केवल जोड़ के लिए प्रयुक्त एक साधारण पॉकेट कैलकुलेटर"},{"en":"An ancient Chinese counting frame","hi":"एक प्राचीन चीनी गिनती फ्रेम"},{"en":"A high-performance single-user computer designed for technical, engineering, or scientific work","hi":"एक उच्च-प्रदर्शन (high-performance) सिंगल-यूजर कंप्यूटर, जो तकनीकी, इंजीनियरिंग या वैज्ञानिक कार्यों के लिए बना होता है"},{"en":"A Wooden desk on which a typewriter is kept","hi":"लकड़ी की एक मेज जिस पर टाइपराइटर रखा जाता है"}],"exp":{"en":"A Workstation is a high-performance, single-user computer engineered specifically for demanding technical, engineering, or scientific applications.","hi":"वर्कस्टेशन (Workstation) एक उच्च-प्रदर्शन (high-performance) सिंगल-यूजर कंप्यूटर है, जो तकनीकी, इंजीनियरिंग या वैज्ञानिक कार्यों के लिए बना होता है।"},"num":71},{"id":"q72","q":{"en":"Which hardware features typically characterize a Workstation?","hi":"वर्कस्टेशन (Workstation) में आमतौर पर कौन-सी हार्डवेयर विशेषताएँ होती हैं?"},"a":{"en":"Fast processor, large RAM, and high-speed graphics adapter (includes high-end desktops and laptops)","hi":"तेज़ प्रोसेसर, बड़ी RAM और हाई-स्पीड ग्राफिक्स एडेप्टर (हाई-एंड डेस्कटॉप और लैपटॉप इस श्रेणी में हो सकते हैं)"},"o":[{"en":"Fast processor, large RAM, and high-speed graphics adapter (includes high-end desktops and laptops)","hi":"तेज़ प्रोसेसर, बड़ी RAM और हाई-स्पीड ग्राफिक्स एडेप्टर (हाई-एंड डेस्कटॉप और लैपटॉप इस श्रेणी में हो सकते हैं)"},{"en":"Slow processor, no RAM, and monochrome text-only display","hi":"धीमा प्रोसेसर, कोई RAM नहीं और केवल मोनोक्रोम टेक्स्ट डिस्प्ले"},{"en":"Vacuum tubes and punched-card feed mechanism","hi":"वैक्यूम ट्यूब और पंच-कार्ड फ़ीड तंत्र"},{"en":"Mercury tubes and sliding brass gears","hi":"पारा ट्यूब और सरकने वाले पीतल के गियर"}],"exp":{"en":"Workstations feature fast multi-core processors, large RAM capacity, and dedicated high-speed graphics adapters (GPUs).","hi":"वर्कस्टेशन में तेज़ प्रोसेसर, बड़ी RAM और हाई-स्पीड ग्राफिक्स एडेप्टर होते हैं (हाई-एंड डेस्कटॉप और लैपटॉप इस श्रेणी में आते हैं)।"},"num":72},{"id":"q73","q":{"en":"In which professional tasks is a Workstation commonly used?","hi":"वर्कस्टेशन (Workstation) किन पेशेवर कार्यों में उपयोग होता है?"},"a":{"en":"CAD/CAM, software development, desktop publishing, 3D modelling, animation, and data analysis","hi":"CAD/CAM, सॉफ्टवेयर डेवलपमेंट, डेस्कटॉप पब्लिशिंग, 3D मॉडलिंग, एनीमेशन और डेटा विश्लेषण"},"o":[{"en":"Only for checking body temperature in hospitals","hi":"केवल अस्पतालों में शरीर का तापमान जाँचने के लिए"},{"en":"CAD/CAM, software development, desktop publishing, 3D modelling, animation, and data analysis","hi":"CAD/CAM, सॉफ्टवेयर डेवलपमेंट, डेस्कटॉप पब्लिशिंग, 3D मॉडलिंग, एनीमेशन और डेटा विश्लेषण"},{"en":"Only for dispensing petrol at fuel stations","hi":"केवल फ्यूल स्टेशनों पर पेट्रोल निकालने के लिए"},{"en":"Only for basic SMS texting on 2G networks","hi":"केवल 2G नेटवर्क पर बेसिक SMS भेजने के लिए"}],"exp":{"en":"Workstations are used for resource-heavy tasks such as CAD/CAM, software development, desktop publishing, 3D modelling, animation, and scientific data analysis.","hi":"वर्कस्टेशन का उपयोग CAD/CAM, सॉफ्टवेयर डेवलपमेंट, डेस्कटॉप पब्लिशिंग, 3D मॉडलिंग, एनीमेशन और डेटा विश्लेषण जैसे कार्यों में होता है।"},"num":73},{"id":"q74","q":{"en":"What are the full forms of CAD and CAM?","hi":"CAD और CAM का पूर्ण रूप (Full Form) क्या है?"},"a":{"en":"Computer-Aided Design and Computer-Aided Manufacturing","hi":"कंप्यूटर-एडेड डिज़ाइन और कंप्यूटर-एडेड मैन्युफैक्चरिंग"},"o":[{"en":"Central Analog Device and Central Analog Memory","hi":"सेंट्रल एनालॉग डिवाइस और सेंट्रल एनालॉग मेमोरी"},{"en":"Computer-Aided Design and Computer-Aided Manufacturing","hi":"कंप्यूटर-एडेड डिज़ाइन और कंप्यूटर-एडेड मैन्युफैक्चरिंग"},{"en":"Control Arithmetic Digit and Control Arithmetic Machine","hi":"कंट्रोल अरिथमेटिक डिजिट और कंट्रोल अरिथमेटिक मशीन"},{"en":"Common Application Data and Common Application Module","hi":"कॉमन एप्लिकेशन डेटा और कॉमन एप्लिकेशन मॉड्यूल"}],"exp":{"en":"CAD stands for Computer-Aided Design and CAM stands for Computer-Aided Manufacturing.","hi":"CAD का पूर्ण रूप Computer-Aided Design और CAM का पूर्ण रूप Computer-Aided Manufacturing है।"},"num":74},{"id":"q75","q":{"en":"What is the key difference between a Workstation and a regular Personal Computer (PC)?","hi":"वर्कस्टेशन (Workstation) और सामान्य पीसी (Regular PC) में मुख्य अंतर क्या है?"},"a":{"en":"A workstation is typically more powerful and more expensive, built for demanding professional tasks","hi":"वर्कस्टेशन मांग वाले पेशेवर कार्यों (demanding professional tasks) के लिए आमतौर पर अधिक शक्तिशाली और महंगा होता है"},"o":[{"en":"A workstation is typically more powerful and more expensive, built for demanding professional tasks","hi":"वर्कस्टेशन मांग वाले पेशेवर कार्यों (demanding professional tasks) के लिए आमतौर पर अधिक शक्तिशाली और महंगा होता है"},{"en":"A regular PC uses qubits while a workstation uses beads","hi":"एक सामान्य पीसी क्यूबिट का उपयोग करता है जबकि वर्कस्टेशन मोतियों का उपयोग करता है"},{"en":"A regular PC is 1,000 times larger than a workstation","hi":"एक सामान्य पीसी वर्कस्टेशन से 1,000 गुना बड़ा होता है"},{"en":"A workstation cannot run any software programs","hi":"वर्कस्टेशन कोई भी सॉफ्टवेयर प्रोग्राम नहीं चला सकता"}],"exp":{"en":"Compared to a regular consumer PC, a Workstation is built with higher-grade components, making it more powerful, reliable, and expensive for professional workloads.","hi":"वर्कस्टेशन मांग वाले पेशेवर कार्यों (demanding professional tasks) के लिए सामान्य PC की तुलना में अधिक शक्तिशाली और महंगा होता है।"},"num":75},{"id":"q76","q":{"en":"How do the notes describe the size, relative power, and use of a 'Minicomputer'?","hi":"'मिनी कंप्यूटर' (Minicomputer) के आकार, सापेक्ष शक्ति और उपयोग के बारे में नोट्स में क्या बताया गया है?"},"a":{"en":"Larger than a microcomputer, used for medium-scale institutional tasks (notes give a rough textbook estimate of 5–50× power of a microcomputer)","hi":"माइक्रो कंप्यूटर से बड़ा, मध्यम-स्तरीय संस्थागत उपयोग के लिए (नोट्स में 5–50 गुना शक्ति की अनुमानित तुलना दी गई है)"},"o":[{"en":"More powerful than a supercomputer, used for space simulations","hi":"सुपर कंप्यूटर से अधिक शक्तिशाली, अंतरिक्ष सिमुलेशन के लिए प्रयुक्त"},{"en":"A mechanical device used in 1642 for addition","hi":"जोड़ के लिए 1642 में प्रयुक्त एक यांत्रिक उपकरण"},{"en":"Larger than a microcomputer, used for medium-scale institutional tasks (notes give a rough textbook estimate of 5–50× power of a microcomputer)","hi":"माइक्रो कंप्यूटर से बड़ा, मध्यम-स्तरीय संस्थागत उपयोग के लिए (नोट्स में 5–50 गुना शक्ति की अनुमानित तुलना दी गई है)"},{"en":"Smaller than a smartwatch, used for fitness tracking","hi":"स्मार्टवॉच से छोटा, फिटनेस ट्रैकिंग के लिए प्रयुक्त"}],"exp":{"en":"A Minicomputer (mid-range computer) is larger and more powerful than a microcomputer (roughly 5–50× in textbook estimates) and was used for medium-scale institutional or departmental tasks.","hi":"मिनी कंप्यूटर माइक्रो कंप्यूटर से बड़ा होता था और मध्यम-स्तरीय संस्थागत उपयोग के लिए काम आता था (नोट्स में माइक्रो कंप्यूटर से 5–50 गुना शक्ति की अनुमानित तुलना दी गई है)।"},"num":76},{"id":"q77","q":{"en":"According to the study notes, approximately how many concurrent users could a Minicomputer support?","hi":"नोट्स के अनुसार, एक मिनी कंप्यूटर लगभग कितने उपयोगकर्ताओं (Users) को सपोर्ट करता था?"},"a":{"en":"Around 4 to 200 users (actual capacity depended on the model)","hi":"लगभग 4 से 200 उपयोगकर्ता (वास्तविक क्षमता मॉडल पर निर्भर करती थी)"},"o":[{"en":"10 million to 50 million users simultaneously","hi":"एक साथ 1 करोड़ से 5 करोड़ उपयोगकर्ता"},{"en":"Around 4 to 200 users (actual capacity depended on the model)","hi":"लगभग 4 से 200 उपयोगकर्ता (वास्तविक क्षमता मॉडल पर निर्भर करती थी)"},{"en":"Strictly only 1 user at a time","hi":"एक समय में केवल 1 उपयोगकर्ता"},{"en":"Zero users, as it had no input devices","hi":"शून्य उपयोगकर्ता, क्योंकि इसमें कोई इनपुट डिवाइस नहीं था"}],"exp":{"en":"According to the study notes, a Minicomputer typically supported around 4 to 200 concurrent users depending on the specific model.","hi":"नोट्स के अनुसार मिनी कंप्यूटर लगभग 4 से 200 उपयोगकर्ताओं (users) को सपोर्ट करता था (वास्तविक क्षमता मॉडल पर निर्भर करती थी)।"},"num":77},{"id":"q78","q":{"en":"Which of the following are classic examples of Minicomputers?","hi":"निम्नलिखित में से कौन-से मिनी कंप्यूटर (Minicomputer) के प्रसिद्ध उदाहरण हैं?"},"a":{"en":"DEC PDP-11 and VAX","hi":"DEC PDP-11 और VAX"},"o":[{"en":"Abacus and Napier's Bones","hi":"अबेकस और नेपियर्स बोन्स"},{"en":"DEC PDP-11 and VAX","hi":"DEC PDP-11 और VAX"},{"en":"iPhone and iPad","hi":"आईफोन और आईपैड"},{"en":"PARAM 8000 and Summit","hi":"परम 8000 और समिट"}],"exp":{"en":"Classic historical examples of Minicomputers are the DEC PDP-11 and VAX series (from Digital Equipment Corporation).","hi":"मिनी कंप्यूटर के प्रमुख उदाहरण DEC PDP-11 और VAX हैं।"},"num":78},{"id":"q79","q":{"en":"What is the primary use of a 'Mainframe Computer'?","hi":"'मेनफ्रेम कंप्यूटर' (Mainframe Computer) का प्राथमिक उपयोग क्या है?"},"a":{"en":"Bulk data processing, large transaction workloads, and supporting many concurrent users","hi":"बल्क डेटा प्रोसेसिंग, बड़े ट्रांजेक्शन वर्कलोड और कई समवर्ती उपयोगकर्ताओं (concurrent users) को सपोर्ट करना"},"o":[{"en":"Personal portable MP3 music playback while jogging","hi":"जॉगिंग के दौरान व्यक्तिगत पोर्टेबल MP3 संगीत चलाना"},{"en":"Single-user offline word processing at home","hi":"घर पर सिंगल-यूजर ऑफ़लाइन वर्ड प्रोसेसिंग"},{"en":"Measuring room temperature using a mercury column","hi":"पारे के स्तंभ का उपयोग करके कमरे का तापमान मापना"},{"en":"Bulk data processing, large transaction workloads, and supporting many concurrent users","hi":"बल्क डेटा प्रोसेसिंग, बड़े ट्रांजेक्शन वर्कलोड और कई समवर्ती उपयोगकर्ताओं (concurrent users) को सपोर्ट करना"}],"exp":{"en":"Mainframe computers are designed for high-reliability bulk data processing, massive transaction workloads, and supporting hundreds or thousands of concurrent users.","hi":"मेनफ्रेम कंप्यूटर का प्राथमिक उपयोग बल्क डेटा प्रोसेसिंग, बड़े ट्रांजेक्शन वर्कलोड और एक साथ कई समवर्ती उपयोगकर्ताओं (concurrent users) को सपोर्ट करना है।"},"num":79},{"id":"q80","q":{"en":"How do multiple users work simultaneously on a Mainframe computer?","hi":"मेनफ्रेम कंप्यूटर पर एक साथ कई उपयोगकर्ता (Multiple users) कैसे काम करते हैं?"},"a":{"en":"Through multiple terminals, time-sharing, and multitasking (supporting hundreds to thousands of users)","hi":"मल्टीपल टर्मिनल्स, टाइम-शेयरिंग और मल्टीटास्किंग के माध्यम से (सैकड़ों से हजारों उपयोगकर्ताओं तक)"},"o":[{"en":"By physically sharing a single mouse one after another every hour","hi":"हर घंटे एक के बाद एक भौतिक रूप से एक ही माउस साझा करके"},{"en":"By punching holes in brass gears","hi":"पीतल के गियर में छेद करके"},{"en":"Through multiple terminals, time-sharing, and multitasking (supporting hundreds to thousands of users)","hi":"मल्टीपल टर्मिनल्स, टाइम-शेयरिंग और मल्टीटास्किंग के माध्यम से (सैकड़ों से हजारों उपयोगकर्ताओं तक)"},{"en":"By replacing the CPU after every calculation","hi":"प्रत्येक गणना के बाद CPU को बदलकर"}],"exp":{"en":"Multiple users access a Mainframe simultaneously through dumb/client terminals using time-sharing and multitasking operating systems.","hi":"मेनफ्रेम पर कई उपयोगकर्ता मल्टीपल टर्मिनल्स, टाइम-शेयरिंग और मल्टीटास्किंग की मदद से एक साथ काम करते हैं (सैकड़ों से हजारों उपयोगकर्ताओं तक)।"},"num":80},{"id":"q81","q":{"en":"Where are Mainframe computers commonly used and what are their standard examples?","hi":"मेनफ्रेम कंप्यूटर कहाँ उपयोग होते हैं और उनके प्रमुख उदाहरण कौन-से हैं?"},"a":{"en":"Used in banks, government agencies, and telecom; examples include IBM zSeries and Hitachi mainframe families","hi":"बैंकों, सरकारी एजेंसियों और टेलीकॉम में प्रयुक्त; उदाहरण: IBM zSeries और Hitachi मेनफ्रेम परिवार"},"o":[{"en":"Used in banks, government agencies, and telecom; examples include IBM zSeries and Hitachi mainframe families","hi":"बैंकों, सरकारी एजेंसियों और टेलीकॉम में प्रयुक्त; उदाहरण: IBM zSeries और Hitachi मेनफ्रेम परिवार"},{"en":"Used in ancient trade; example: Abacus","hi":"प्राचीन व्यापार में प्रयुक्त; उदाहरण: अबेकस"},{"en":"Used inside digital wristwatches; example: Casio Quartz","hi":"डिजिटल कलाई घड़ियों के अंदर प्रयुक्त; उदाहरण: कैसियो क्वार्ट्ज"},{"en":"Used in fuel dispensers; example: Mercury Thermometer","hi":"ईंधन डिस्पेंसर में प्रयुक्त; उदाहरण: पारा थर्मामीटर"}],"exp":{"en":"Mainframes are heavily used in banking, government agencies, insurance, and telecom; prime examples are IBM zSeries and Hitachi mainframe families.","hi":"मेनफ्रेम बैंकों, सरकारी एजेंसियों और टेलीकॉम में उपयोग होते हैं। IBM zSeries और Hitachi मेनफ्रेम परिवार इसके प्रमुख उदाहरण हैं।"},"num":81},{"id":"q82","q":{"en":"What is the main strength of a 'Supercomputer'?","hi":"'सुपर कंप्यूटर' (Supercomputer) की मुख्य ताकत (Main Strength) क्या है?"},"a":{"en":"Ultra-fast computation for complex scientific workloads and large-scale jobs","hi":"अत्यंत तेज़ गणना (Computation); यह जटिल वैज्ञानिक वर्कलोड और बड़े कार्यों को प्रोसेस करता है"},"o":[{"en":"Ultra-fast computation for complex scientific workloads and large-scale jobs","hi":"अत्यंत तेज़ गणना (Computation); यह जटिल वैज्ञानिक वर्कलोड और बड़े कार्यों को प्रोसेस करता है"},{"en":"Printing retail shopping receipts at a grocery counter","hi":"किराने के काउंटर पर खुदरा खरीदारी रसीदें प्रिंट करना"},{"en":"Low cost and pocket portability for everyday phone calls","hi":"रोजमर्रा के फोन कॉल के लिए कम लागत और पॉकेट पोर्टेबिलिटी"},{"en":"Manual bead calculation without electricity","hi":"बिना बिजली के मैनुअल मनका गणना"}],"exp":{"en":"The main strength of a Supercomputer is extreme computational speed (measured in FLOPS), built to tackle massive scientific and engineering jobs.","hi":"सुपर कंप्यूटर की मुख्य ताकत अत्यंत तेज़ गणना (computation) है। यह जटिल वैज्ञानिक वर्कलोड और बड़े कार्यों को बहुत तेज़ी से प्रोसेस करता है।"},"num":82},{"id":"q83","q":{"en":"In which fields are Supercomputers primarily used?","hi":"सुपर कंप्यूटर मुख्य रूप से किन क्षेत्रों में उपयोग किए जाते हैं?"},"a":{"en":"Weather forecasting, nuclear research, space exploration, and complex scientific simulations","hi":"मौसम पूर्वानुमान, परमाणु अनुसंधान, अंतरिक्ष अन्वेषण और जटिल वैज्ञानिक सिमुलेशन में"},"o":[{"en":"Controlling a domestic microwave timer","hi":"घरेलू माइक्रोवेव टाइमर को नियंत्रित करने में"},{"en":"Basic home budgeting and typing school essays","hi":"बेसिक घरेलू बजट और स्कूल निबंध टाइप करने में"},{"en":"Weather forecasting, nuclear research, space exploration, and complex scientific simulations","hi":"मौसम पूर्वानुमान, परमाणु अनुसंधान, अंतरिक्ष अन्वेषण और जटिल वैज्ञानिक सिमुलेशन में"},{"en":"Playing MP3 songs on a portable music player","hi":"पोर्टेबल म्यूजिक प्लेयर पर MP3 गाने चलाने में"}],"exp":{"en":"Supercomputers are used in weather forecasting, climate research, nuclear energy simulations, space exploration, and aerodynamics.","hi":"सुपर कंप्यूटर का उपयोग मौसम पूर्वानुमान, परमाणु अनुसंधान (nuclear research), अंतरिक्ष अन्वेषण और जटिल वैज्ञानिक सिमुलेशन में होता है।"},"num":83},{"id":"q84","q":{"en":"Which of the following are well-known examples of Supercomputers mentioned in the notes?","hi":"नोट्स में उल्लेखित सुपर कंप्यूटर के प्रसिद्ध उदाहरण कौन-से हैं?"},"a":{"en":"PARAM series (India) and Summit (USA)","hi":"परम (PARAM) सीरीज़ (भारत) और समिट (Summit - USA)"},"o":[{"en":"DEC PDP-11 and VAX","hi":"DEC PDP-11 और VAX"},{"en":"Pascaline and Napier's Bones","hi":"पास्कलाइन और नेपियर्स बोन्स"},{"en":"IBM 1401 and Intel 4004","hi":"IBM 1401 और Intel 4004"},{"en":"PARAM series (India) and Summit (USA)","hi":"परम (PARAM) सीरीज़ (भारत) और समिट (Summit - USA)"}],"exp":{"en":"Famous examples of Supercomputers cited in the notes are India's PARAM series (developed by C-DAC) and USA's Summit.","hi":"नोट्स में दिए गए सुपर कंप्यूटर के प्रसिद्ध उदाहरण भारत की PARAM सीरीज़ और अमेरिका का Summit हैं।"},"num":84},{"id":"q85","q":{"en":"From an exam perspective, what is the key difference between a Mainframe and a Supercomputer?","hi":"परीक्षा की दृष्टि से मेनफ्रेम (Mainframe) और सुपर कंप्यूटर (Supercomputer) में मुख्य अंतर क्या है?"},"a":{"en":"Mainframe focuses on bulk transactions and concurrent users, whereas Supercomputer focuses on raw speed for heavy scientific calculations","hi":"मेनफ्रेम बल्क ट्रांजेक्शन और समवर्ती उपयोगकर्ताओं पर केंद्रित होता है, जबकि सुपर कंप्यूटर भारी वैज्ञानिक गणनाओं की गति (speed) पर केंद्रित होता है"},"o":[{"en":"Mainframe supports only 1 user, whereas Supercomputer cannot perform calculations","hi":"मेनफ्रेम केवल 1 उपयोगकर्ता का समर्थन करता है, जबकि सुपर कंप्यूटर गणना नहीं कर सकता"},{"en":"Mainframe works on continuous analog data, whereas Supercomputer works on beads","hi":"मेनफ्रेम सतत एनालॉग डेटा पर काम करता है, जबकि सुपर कंप्यूटर मोतियों पर काम करता है"},{"en":"Mainframe is a pocket device, whereas Supercomputer is a wristwatch","hi":"मेनफ्रेम एक पॉकेट डिवाइस है, जबकि सुपर कंप्यूटर एक कलाई घड़ी है"},{"en":"Mainframe focuses on bulk transactions and concurrent users, whereas Supercomputer focuses on raw speed for heavy scientific calculations","hi":"मेनफ्रेम बल्क ट्रांजेक्शन और समवर्ती उपयोगकर्ताओं पर केंद्रित होता है, जबकि सुपर कंप्यूटर भारी वैज्ञानिक गणनाओं की गति (speed) पर केंद्रित होता है"}],"exp":{"en":"Exam distinction: A Mainframe optimizes high-volume I/O transactions for thousands of concurrent users (e.g., banking), whereas a Supercomputer optimizes raw calculation speed for complex scientific simulations.","hi":"परीक्षा के लिए मुख्य अंतर: मेनफ्रेम बल्क ट्रांजेक्शन और एक साथ कई उपयोगकर्ताओं पर केंद्रित होता है, जबकि सुपर कंप्यूटर भारी वैज्ञानिक गणनाओं की गति (speed) पर केंद्रित होता है।"},"num":85}],"source_pages":"Source pp. 09, 11–14, 16–17"},{"title":{"en":"7. Quantum, Server, Embedded & Information Appliances","hi":"7. क्वांटम, सर्वर, एम्बेडेड कंप्यूटर और सूचना उपकरण"},"questions":[{"id":"q86","q":{"en":"In which basic unit does a 'Quantum Computer' represent information?","hi":"'क्वांटम कंप्यूटर' (Quantum Computer) सूचना को किस मूल इकाई (Unit) में दर्शाता है?"},"a":{"en":"Qubit (Quantum bit)","hi":"क्यूबिट (Qubit - क्वांटम बिट)"},"o":[{"en":"Abacus Bead","hi":"अबेकस मनका"},{"en":"Qubit (Quantum bit)","hi":"क्यूबिट (Qubit - क्वांटम बिट)"},{"en":"Punched Hole","hi":"पंच होल"},{"en":"Vacuum Valve","hi":"वैक्यूम वाल्व"}],"exp":{"en":"A Quantum Computer represents and processes information using quantum bits, called Qubits.","hi":"क्वांटम कंप्यूटर सूचना को 'क्यूबिट' (Qubit - Quantum bit) नामक इकाई में दर्शाता है।"},"num":86},{"id":"q87","q":{"en":"What is the fundamental difference between a classical bit and a qubit?","hi":"क्लासिकल बिट (Classical bit) और क्यूबिट (Qubit) में बुनियादी अंतर क्या है?"},"a":{"en":"A classical bit has a state of either 0 or 1, whereas a qubit can be prepared in a quantum superposition of 0 and 1","hi":"क्लासिकल बिट का मान 0 या 1 होता है, जबकि क्यूबिट को 0 और 1 के क्वांटम सुपरपोजिशन (superposition) में तैयार किया जा सकता है"},"o":[{"en":"A classical bit has a state of either 0 or 1, whereas a qubit can be prepared in a quantum superposition of 0 and 1","hi":"क्लासिकल बिट का मान 0 या 1 होता है, जबकि क्यूबिट को 0 और 1 के क्वांटम सुपरपोजिशन (superposition) में तैयार किया जा सकता है"},{"en":"A classical bit uses superposition, whereas a qubit can only store the number 9","hi":"क्लासिकल बिट सुपरपोजिशन का उपयोग करता है, जबकि क्यूबिट केवल संख्या 9 स्टोर कर सकता है"},{"en":"A classical bit is a physical monitor, whereas a qubit is a keyboard","hi":"क्लासिकल बिट एक भौतिक मॉनिटर है, जबकि क्यूबिट एक कीबोर्ड है"},{"en":"There is no difference between a classical bit and a qubit","hi":"क्लासिकल बिट और क्यूबिट में कोई अंतर नहीं है"}],"exp":{"en":"A classical bit can hold only a definite value of 0 or 1 at any instant, whereas a Qubit can exist in a coherent quantum superposition of both 0 and 1 states.","hi":"क्लासिकल बिट का मान केवल 0 या 1 होता है, जबकि क्यूबिट (Qubit) को 0 और 1 के क्वांटम सुपरपोजिशन (quantum superposition) में तैयार किया जा सकता है।"},"num":87},{"id":"q88","q":{"en":"What is the primary role of a 'Server' in a computer network?","hi":"कंप्यूटर नेटवर्क में 'सर्वर' (Server) क्या कार्य करता है?"},"a":{"en":"It provides data, resources, or services to multiple client machines over a network","hi":"यह नेटवर्क पर कई क्लाइंट मशीनों (client machines) को डेटा, संसाधन या सेवाएँ प्रदान करता है"},"o":[{"en":"It works only as an offline mechanical calculator from 1642","hi":"यह केवल 1642 के ऑफ़लाइन यांत्रिक कैलकुलेटर के रूप में काम करता है"},{"en":"It is a non-electronic wooden frame for sliding beads","hi":"यह मोतियों को सरकाने के लिए एक गैर-इलेक्ट्रॉनिक लकड़ी का फ्रेम है"},{"en":"It provides data, resources, or services to multiple client machines over a network","hi":"यह नेटवर्क पर कई क्लाइंट मशीनों (client machines) को डेटा, संसाधन या सेवाएँ प्रदान करता है"},{"en":"It only measures body temperature using mercury","hi":"यह केवल पारे का उपयोग करके शरीर का तापमान मापता है"}],"exp":{"en":"A Server is a computer system on a network that provides data, shared resources, file storage, or services to multiple client machines.","hi":"सर्वर (Server) नेटवर्क पर जुड़ी कई क्लाइंट मशीनों (client machines) को डेटा, संसाधन (resources) या सेवाएँ प्रदान करता है।"},"num":88},{"id":"q89","q":{"en":"Which of the following are common types of Servers mentioned in the notes?","hi":"नोट्स में उल्लेखित सर्वर (Servers) के सामान्य प्रकार कौन-से हैं?"},"a":{"en":"Application server, database server, file server, and cloud server","hi":"एप्लिकेशन सर्वर, डेटाबेस सर्वर, फ़ाइल सर्वर और क्लाउड सर्वर"},"o":[{"en":"Keyboard server and mouse pad server","hi":"कीबोर्ड सर्वर और माउस पैड सर्वर"},{"en":"Pascaline server and Napier server","hi":"पास्कलाइन सर्वर और नेपियर सर्वर"},{"en":"Mercury server, bead server, and gear server","hi":"पारा सर्वर, मनका सर्वर और गियर सर्वर"},{"en":"Application server, database server, file server, and cloud server","hi":"एप्लिकेशन सर्वर, डेटाबेस सर्वर, फ़ाइल सर्वर और क्लाउड सर्वर"}],"exp":{"en":"Common server types listed in the notes include Application servers, Database servers, File servers, and Cloud servers.","hi":"सर्वर के सामान्य प्रकारों में एप्लिकेशन सर्वर, डेटाबेस सर्वर, फ़ाइल सर्वर और क्लाउड सर्वर शामिल हैं।"},"num":89},{"id":"q90","q":{"en":"How are the size and capacity of a Server determined?","hi":"सर्वर का आकार (Size) और क्षमता (Capacity) कैसे तय होते हैं?"},"a":{"en":"According to client count and workload (busy servers have higher capacity than regular PCs)","hi":"क्लाइंट की संख्या और वर्कलोड के हिसाब से (व्यस्त सर्वरों में सामान्य PC के मुकाबले अधिक क्षमता हो सकती है)"},"o":[{"en":"By the number of beads on its wooden rod","hi":"इसकी लकड़ी की छड़ पर मोतियों की संख्या से"},{"en":"All servers have the exact same capacity as a digital wristwatch","hi":"सभी सर्वरों की क्षमता डिजिटल कलाई घड़ी के बराबर होती है"},{"en":"By the color of the monitor casing","hi":"मॉनिटर के आवरण के रंग से"},{"en":"According to client count and workload (busy servers have higher capacity than regular PCs)","hi":"क्लाइंट की संख्या और वर्कलोड के हिसाब से (व्यस्त सर्वरों में सामान्य PC के मुकाबले अधिक क्षमता हो सकती है)"}],"exp":{"en":"A server's hardware size and capacity depend on the number of concurrent clients and workload intensity; enterprise servers have much greater capacity than regular PCs.","hi":"सर्वर का आकार और क्षमता क्लाइंट की संख्या (client count) और वर्कलोड के हिसाब से तय होते हैं; व्यस्त सर्वरों की क्षमता सामान्य PC से काफी अधिक होती है।"},"num":90},{"id":"q91","q":{"en":"What is an 'Embedded Computer'?","hi":"'एम्बेडेड कंप्यूटर' (Embedded Computer) क्या होता है?"},"a":{"en":"A computer integrated inside a larger device, designed for a specific control or monitoring task","hi":"किसी बड़े उपकरण (larger device) के अंदर एकीकृत, विशिष्ट नियंत्रण या निगरानी कार्य के लिए बना कंप्यूटर"},"o":[{"en":"A computer integrated inside a larger device, designed for a specific control or monitoring task","hi":"किसी बड़े उपकरण (larger device) के अंदर एकीकृत, विशिष्ट नियंत्रण या निगरानी कार्य के लिए बना कंप्यूटर"},{"en":"A general-purpose desktop computer used for 3D game development","hi":"3D गेम डेवलपमेंट के लिए प्रयुक्त एक सामान्य-उद्देश्य डेस्कटॉप कंप्यूटर"},{"en":"A manual punched-card tabulator from 1890","hi":"1890 का एक मैनुअल पंच-कार्ड टैबुलेटर"},{"en":"A room-sized mainframe supporting 5,000 bank branches","hi":"5,000 बैंक शाखाओं को सपोर्ट करने वाला कमरे के आकार का मेनफ्रेम"}],"exp":{"en":"An Embedded Computer is a dedicated microcontroller/processor system integrated inside a larger mechanical or electrical device to perform a specific control or monitoring task.","hi":"एम्बेडेड कंप्यूटर किसी बड़े उपकरण के अंदर एकीकृत (integrated) वह कंप्यूटर है जो किसी विशिष्ट नियंत्रण (control) या निगरानी (monitoring) कार्य के लिए बना होता है।"},"num":91},{"id":"q92","q":{"en":"Which of the following are examples of Embedded Systems?","hi":"निम्नलिखित में से कौन-से एम्बेडेड सिस्टम (Embedded Systems) के उदाहरण हैं?"},"a":{"en":"GPS devices, digital watches, fitness trackers, and smart appliances (with task-optimized hardware and software)","hi":"GPS डिवाइसेस, डिजिटल घड़ियाँ, फिटनेस ट्रैकर और स्मार्ट उपकरण (जिनमें कार्य के लिए हार्डवेयर और सॉफ्टवेयर अनुकूलित किए जाते हैं)"},"o":[{"en":"PARAM Siddhi and Cray-1","hi":"परम सिद्धि और क्रे-1"},{"en":"IBM System/360 and CDC 6600","hi":"IBM System/360 और CDC 6600"},{"en":"ENIAC, EDVAC, and UNIVAC I","hi":"ENIAC, EDVAC और UNIVAC I"},{"en":"GPS devices, digital watches, fitness trackers, and smart appliances (with task-optimized hardware and software)","hi":"GPS डिवाइसेस, डिजिटल घड़ियाँ, फिटनेस ट्रैकर और स्मार्ट उपकरण (जिनमें कार्य के लिए हार्डवेयर और सॉफ्टवेयर अनुकूलित किए जाते हैं)"}],"exp":{"en":"Examples of devices with embedded systems include GPS receivers, digital watches, fitness trackers, washing machines, and smart home appliances.","hi":"एम्बेडेड सिस्टम के उदाहरण GPS डिवाइसेस, डिजिटल घड़ियाँ, फिटनेस ट्रैकर और स्मार्ट घरेलू उपकरण हैं, जिनमें कार्य के अनुसार हार्डवेयर व सॉफ्टवेयर अनुकूलित होते हैं।"},"num":92},{"id":"q93","q":{"en":"What is the full form of 'IoT', where embedded controllers are commonly used in connected smart appliances?","hi":"'IoT' का पूर्ण रूप क्या है, जहाँ कनेक्टेड स्मार्ट उपकरणों में एम्बेडेड कंट्रोलर आम हैं?"},"a":{"en":"Internet of Things","hi":"इंटरनेट ऑफ थिंग्स (Internet of Things)"},"o":[{"en":"Internet of Things","hi":"इंटरनेट ऑफ थिंग्स (Internet of Things)"},{"en":"Integrated Optical Terminal","hi":"इंटीग्रेटेड ऑप्टिकल टर्मिनल"},{"en":"Input Output Transistor","hi":"इनपुट आउटपुट ट्रांजिस्टर"},{"en":"Internal Operating Tabulator","hi":"इंटरनल ऑपरेटिंग टैबुलेटर"}],"exp":{"en":"IoT stands for Internet of Things, referring to interconnected smart devices and appliances equipped with embedded sensors and controllers.","hi":"IoT का पूर्ण रूप Internet of Things है; कनेक्टेड स्मार्ट उपकरणों में एम्बेडेड कंट्रोलर आम तौर पर उपयोग किए जाते हैं।"},"num":93},{"id":"q94","q":{"en":"What is an 'Information Appliance' according to the notes?","hi":"नोट्स के अनुसार 'इन्फॉर्मेशन अप्लायंस' (Information Appliance) क्या है?"},"a":{"en":"A device focused on a specific portable task, such as a digital camera, MP3 player, or mobile phone","hi":"विशिष्ट पोर्टेबल कार्य पर केंद्रित उपकरण, जैसे डिजिटल कैमरा, MP3 प्लेयर या मोबाइल फोन"},"o":[{"en":"A nuclear research supercomputer cluster","hi":"परमाणु अनुसंधान सुपर कंप्यूटर क्लस्टर"},{"en":"A mechanical gear adder from the 17th century","hi":"17वीं सदी का एक यांत्रिक गियर योजक"},{"en":"A device focused on a specific portable task, such as a digital camera, MP3 player, or mobile phone","hi":"विशिष्ट पोर्टेबल कार्य पर केंद्रित उपकरण, जैसे डिजिटल कैमरा, MP3 प्लेयर या मोबाइल फोन"},{"en":"A 30 × 30 feet vacuum-tube machine weighing 30 tons","hi":"30 टन वजन वाली 30 × 30 फीट की वैक्यूम-ट्यूब मशीन"}],"exp":{"en":"An Information Appliance is a consumer device designed around a specific portable information task, such as a digital camera, MP3 player, or mobile phone.","hi":"इन्फॉर्मेशन अप्लायंस किसी विशिष्ट पोर्टेबल कार्य पर केंद्रित उपकरण है, जैसे डिजिटल कैमरा, MP3 प्लेयर या मोबाइल फोन।"},"num":94},{"id":"q95","q":{"en":"What is the distinction between an Information Appliance and an Embedded Computer?","hi":"इन्फॉर्मेशन अप्लायंस (Information Appliance) और एम्बेडेड कंप्यूटर (Embedded Computer) में क्या अंतर है?"},"a":{"en":"An information appliance is a complete end-user device for a task, whereas an embedded computer is a system integrated inside a device to handle a specific task","hi":"इन्फॉर्मेशन अप्लायंस उपयोगकर्ता के काम का पूरा उपकरण है, जबकि एम्बेडेड कंप्यूटर किसी उपकरण के अंदर विशिष्ट कार्य संभालने वाला सिस्टम है"},"o":[{"en":"An embedded computer is a complete laptop, whereas an information appliance is a silicon transistor","hi":"एम्बेडेड कंप्यूटर एक पूरा लैपटॉप है, जबकि इन्फॉर्मेशन अप्लायंस एक सिलिकॉन ट्रांजिस्टर है"},{"en":"Information appliances use vacuum tubes, whereas embedded computers use punched cards","hi":"इन्फॉर्मेशन अप्लायंस वैक्यूम ट्यूब का उपयोग करते हैं, जबकि एम्बेडेड कंप्यूटर पंच कार्ड का उपयोग करते हैं"},{"en":"Both terms refer exclusively to 1st generation mainframes","hi":"दोनों शब्द केवल प्रथम पीढ़ी के मेनफ्रेम को संदर्भित करते हैं"},{"en":"An information appliance is a complete end-user device for a task, whereas an embedded computer is a system integrated inside a device to handle a specific task","hi":"इन्फॉर्मेशन अप्लायंस उपयोगकर्ता के काम का पूरा उपकरण है, जबकि एम्बेडेड कंप्यूटर किसी उपकरण के अंदर विशिष्ट कार्य संभालने वाला सिस्टम है"}],"exp":{"en":"An Information Appliance is a complete, standalone device used directly by the user, whereas an Embedded Computer is the internal control subsystem inside a larger machine.","hi":"इन्फॉर्मेशन अप्लायंस उपयोगकर्ता के काम का पूरा बाहरी उपकरण है, जबकि एम्बेडेड कंप्यूटर किसी उपकरण के अंदर रहकर विशिष्ट कार्य संभालने वाला आंतरिक सिस्टम है।"},"num":95},{"id":"q96","q":{"en":"Can a single device (such as a Smartphone) belong to more than one classification category?","hi":"क्या एक ही उपकरण (जैसे स्मार्टफोन) दो या अधिक श्रेणियों (Categories) में आ सकता है?"},"a":{"en":"Yes — a smartphone is a 'Digital computer' by data handling, a 'Microcomputer' by size/use, and is also listed as a portable 'Information appliance'","hi":"हाँ — स्मार्टफोन डेटा हैंडलिंग के हिसाब से 'डिजिटल', आकार/उपयोग के हिसाब से 'माइक्रो कंप्यूटर' है, और पोर्टेबल 'इन्फॉर्मेशन अप्लायंस' में भी आता है"},"o":[{"en":"No — every electronic device can belong to only one fixed category forever","hi":"नहीं — प्रत्येक इलेक्ट्रॉनिक उपकरण हमेशा के लिए केवल एक ही श्रेणी में आ सकता है"},{"en":"Yes — a smartphone is a 'Digital computer' by data handling, a 'Microcomputer' by size/use, and is also listed as a portable 'Information appliance'","hi":"हाँ — स्मार्टफोन डेटा हैंडलिंग के हिसाब से 'डिजिटल', आकार/उपयोग के हिसाब से 'माइक्रो कंप्यूटर' है, और पोर्टेबल 'इन्फॉर्मेशन अप्लायंस' में भी आता है"},{"en":"Yes — a smartphone is both a First-Generation Vacuum Tube machine and an Abacus","hi":"हाँ — स्मार्टफोन प्रथम पीढ़ी की वैक्यूम ट्यूब मशीन और अबेकस दोनों है"},{"en":"No — a smartphone is strictly an Analog Mainframe and cannot fit any other category","hi":"नहीं — स्मार्टफोन केवल एक एनालॉग मेनफ्रेम है और किसी अन्य श्रेणी में नहीं आ सकता"}],"exp":{"en":"Yes, classifications overlap based on criteria: a Smartphone is a Digital computer (by data handling), a Microcomputer (by size/processor), and a portable Information Appliance (by usage).","hi":"हाँ, एक उपकरण एक से अधिक श्रेणियों में आ सकता है: जैसे स्मार्टफोन डेटा हैंडलिंग के हिसाब से 'डिजिटल', आकार/उपयोग के हिसाब से 'माइक्रो कंप्यूटर' और पोर्टेबल 'इन्फॉर्मेशन अप्लायंस' भी है।"},"num":96}],"source_pages":"Source pp. 14–17"},{"title":{"en":"8. Exam Trap Reverse-Questions","hi":"8. परीक्षा के महत्वपूर्ण उल्टे प्रश्न"},"questions":[{"id":"q97","q":{"en":"Which early calculating device used numbered rods for multiplication and division?","hi":"गुणा (Multiplication) और भाग (Division) के लिए संख्यांकित छड़ें (Numbered rods) किस उपकरण में थीं?"},"a":{"en":"Napier’s Bones","hi":"नेपियर्स बोन्स (Napier’s Bones)"},"o":[{"en":"Hollerith Tabulator","hi":"होलेरिथ टैबुलेटर"},{"en":"Pascaline","hi":"पास्कलाइन"},{"en":"ENIAC","hi":"एनियाक (ENIAC)"},{"en":"Napier’s Bones","hi":"नेपियर्स बोन्स (Napier’s Bones)"}],"exp":{"en":"Napier’s Bones (invented by John Napier, published 1617) used numbered rods to perform multiplication and division.","hi":"गुणा और भाग को आसान बनाने के लिए संख्यांकित छड़ें (numbered rods) 'नेपियर्स बोन्स' (Napier’s Bones) में प्रयुक्त हुई थीं।"},"num":97},{"id":"q98","q":{"en":"Which mechanical calculator of 1642 was designed for addition and subtraction?","hi":"जोड़ (Addition) और घटाव (Subtraction) वाला 1642 का यांत्रिक कैलकुलेटर कौन-सा था?"},"a":{"en":"Pascaline","hi":"पास्कलाइन (Pascaline)"},"o":[{"en":"Analytical Engine","hi":"एनालिटिकल इंजन"},{"en":"TIFRAC","hi":"टिफ्रेक (TIFRAC)"},{"en":"Napier’s Bones","hi":"नेपियर्स बोन्स"},{"en":"Pascaline","hi":"पास्कलाइन (Pascaline)"}],"exp":{"en":"The Pascaline (built by Blaise Pascal in 1642) was a gear-driven mechanical calculator for addition and subtraction.","hi":"जोड़ और घटाव करने वाला 1642 का प्रारंभिक यांत्रिक कैलकुलेटर 'पास्कलाइन' (Pascaline) था।"},"num":98},{"id":"q99","q":{"en":"Who published the algorithm for Bernoulli numbers and for which machine was it written?","hi":"बरनौली संख्याओं (Bernoulli numbers) का एल्गोरिदम किसने प्रकाशित किया और किस मशीन के लिए?"},"a":{"en":"Ada Lovelace, for the Analytical Engine","hi":"एडा लवलेस ने, एनालिटिकल इंजन (Analytical Engine) के लिए"},"o":[{"en":"Ada Lovelace, for the Analytical Engine","hi":"एडा लवलेस ने, एनालिटिकल इंजन (Analytical Engine) के लिए"},{"en":"Herman Hollerith, for the 1890 Census Tabulator","hi":"हरमन होलेरिथ ने, 1890 जनगणना टैबुलेटर के लिए"},{"en":"John Napier, for the Abacus","hi":"जॉन नेपियर ने, अबेकस के लिए"},{"en":"Seymour Cray, for the Cray-1","hi":"सीमोर क्रे ने, Cray-1 के लिए"}],"exp":{"en":"Ada Lovelace published the algorithm for computing Bernoulli numbers in 1843, specifically written for Charles Babbage's Analytical Engine.","hi":"बरनौली संख्याओं का एल्गोरिदम एडा लवलेस (Ada Lovelace) ने 1843 में चार्ल्स बैबेज के 'एनालिटिकल इंजन' के लिए प्रकाशित किया था।"},"num":99},{"id":"q100","q":{"en":"With whom are the 1890 U.S. Census tabulator and the 1936 theoretical model of computation respectively associated?","hi":"1890 की जनगणना (Census) और 1936 का सैद्धांतिक मॉडल, दोनों क्रमशः किससे जुड़े हैं?"},"a":{"en":"1890 Census → Herman Hollerith; 1936 Turing Machine → Alan Turing","hi":"1890 जनगणना → हरमन होलेरिथ; 1936 ट्यूरिंग मशीन → एलन ट्यूरिंग"},"o":[{"en":"1890 Census → Alan Turing; 1936 Model → Herman Hollerith","hi":"1890 जनगणना → एलन ट्यूरिंग; 1936 मॉडल → हरमन होलेरिथ"},{"en":"1890 Census → John Napier; 1936 Model → Seymour Cray","hi":"1890 जनगणना → जॉन नेपियर; 1936 मॉडल → सीमोर क्रे"},{"en":"1890 Census → Herman Hollerith; 1936 Turing Machine → Alan Turing","hi":"1890 जनगणना → हरमन होलेरिथ; 1936 ट्यूरिंग मशीन → एलन ट्यूरिंग"},{"en":"1890 Census → Charles Babbage; 1936 Model → Blaise Pascal","hi":"1890 जनगणना → चार्ल्स बैबेज; 1936 मॉडल → ब्लेज़ पास्कल"}],"exp":{"en":"The 1890 U.S. Census punched-card tabulator was designed by Herman Hollerith, while the 1936 theoretical model of computation (Turing Machine) was proposed by Alan Turing.","hi":"1890 की अमेरिकी जनगणना का टैबुलेटर हरमन होलेरिथ से और 1936 का सैद्धांतिक कंप्यूटेशन मॉडल (ट्यूरिंग मशीन) एलन ट्यूरिंग से जुड़ा है।"},"num":100},{"id":"q101","q":{"en":"Which option correctly matches ABC, ENIAC, and UNIVAC I with their respective exam keywords?","hi":"ABC, ENIAC और UNIVAC I के सही परीक्षा कीवर्ड्स (Keywords) का मिलान कौन-सा विकल्प करता है?"},"a":{"en":"ABC → Early electronic digital machine; ENIAC → General-purpose electronic computing; UNIVAC I → U.S. commercial electronic computing","hi":"ABC → प्रारंभिक इलेक्ट्रॉनिक डिजिटल मशीन; ENIAC → सामान्य-उद्देश्य इलेक्ट्रॉनिक कंप्यूटिंग; UNIVAC I → अमेरिकी व्यावसायिक इलेक्ट्रॉनिक कंप्यूटिंग"},"o":[{"en":"ABC → Commercial mainframe; ENIAC → Mechanical bead frame; UNIVAC I → Single-chip microprocessor","hi":"ABC → व्यावसायिक मेनफ्रेम; ENIAC → यांत्रिक मनका फ्रेम; UNIVAC I → सिंगल-चिप माइक्रोप्रोसेसर"},{"en":"ABC → Punched card sorter; ENIAC → Slide rule; UNIVAC I → Analog thermometer","hi":"ABC → पंच कार्ड सॉर्टर; ENIAC → स्लाइड रूल; UNIVAC I → एनालॉग थर्मामीटर"},{"en":"ABC → Early electronic digital machine; ENIAC → General-purpose electronic computing; UNIVAC I → U.S. commercial electronic computing","hi":"ABC → प्रारंभिक इलेक्ट्रॉनिक डिजिटल मशीन; ENIAC → सामान्य-उद्देश्य इलेक्ट्रॉनिक कंप्यूटिंग; UNIVAC I → अमेरिकी व्यावसायिक इलेक्ट्रॉनिक कंप्यूटिंग"},{"en":"ABC → Supercomputer; ENIAC → Minicomputer; UNIVAC I → Smartwatch","hi":"ABC → सुपर कंप्यूटर; ENIAC → मिनी कंप्यूटर; UNIVAC I → स्मार्टवॉच"}],"exp":{"en":"Exam keywords: ABC → Early electronic digital machine (linear equations); ENIAC → First general-purpose electronic digital computer; UNIVAC I → First U.S. commercial electronic computer.","hi":"सही कीवर्ड्स: ABC → प्रारंभिक इलेक्ट्रॉनिक डिजिटल मशीन; ENIAC → सामान्य-उद्देश्य इलेक्ट्रॉनिक कंप्यूटिंग; UNIVAC I → अमेरिकी व्यावसायिक इलेक्ट्रॉनिक कंप्यूटिंग।"},"num":101},{"id":"q102","q":{"en":"Between 1945 and 1946, which year marks the formal public introduction/dedication of ENIAC?","hi":"1945 और 1946 में से ENIAC का औपचारिक परिचय (Formal introduction) कब हुआ?"},"a":{"en":"1946","hi":"1946"},"o":[{"en":"1945","hi":"1945"},{"en":"1951","hi":"1951"},{"en":"1936","hi":"1936"},{"en":"1946","hi":"1946"}],"exp":{"en":"While ENIAC reached its development milestone in 1945, its formal public introduction/dedication took place in February 1946.","hi":"ENIAC के विकास का मील का पत्थर 1945 था, लेकिन इसका औपचारिक सार्वजनिक परिचय (formal introduction) 1946 में हुआ।"},"num":102},{"id":"q103","q":{"en":"Between HEC-2M and TIFRAC, which one was imported/installed first in India and which one was indigenously developed in India?","hi":"HEC-2M और TIFRAC में से कौन-सा भारत में स्थापित (installed) आयातित कंप्यूटर था और कौन-सा भारत में स्वदेशी रूप से विकसित (developed) हुआ?"},"a":{"en":"HEC-2M was an imported machine installed at ISI Kolkata (1956); TIFRAC was indigenously developed in India by TIFR (commissioned 1960)","hi":"HEC-2M आयातित मशीन थी जो ISI कोलकाता में स्थापित हुई; TIFRAC को TIFR ने भारत में स्वदेशी रूप से विकसित किया"},"o":[{"en":"Both were imported from the United States in 1971","hi":"दोनों को 1971 में अमेरिका से आयात किया गया था"},{"en":"Both were mechanical calculators built in 1837","hi":"दोनों 1837 में निर्मित यांत्रिक कैलकुलेटर थे"},{"en":"HEC-2M was an imported machine installed at ISI Kolkata (1956); TIFRAC was indigenously developed in India by TIFR (commissioned 1960)","hi":"HEC-2M आयातित मशीन थी जो ISI कोलकाता में स्थापित हुई; TIFRAC को TIFR ने भारत में स्वदेशी रूप से विकसित किया"},{"en":"TIFRAC was imported from Britain; HEC-2M was built by ECIL","hi":"TIFRAC ब्रिटेन से आयात किया गया था; HEC-2M को ECIL ने बनाया था"}],"exp":{"en":"HEC-2M was an imported British computer installed at ISI Kolkata in 1956 (first installed in India), whereas TIFRAC was indigenously developed in India at TIFR Mumbai (commissioned Feb 1960).","hi":"HEC-2M एक आयातित मशीन थी जो 1956 में ISI कोलकाता में स्थापित हुई; जबकि TIFRAC भारत में TIFR मुंबई द्वारा स्वदेशी रूप से विकसित किया गया था (फरवरी 1960 में कमीशन)।"},"num":103},{"id":"q104","q":{"en":"Which supercomputer designed by Seymour Cray was introduced in 1976 (following his earlier CDC 6600 in 1964)?","hi":"'1976 में सीमोर क्रे (Seymour Cray) का सुपर कंप्यूटर' कौन-सा है (जिससे पहले 1964 में उनसे जुड़ा CDC 6600 आ चुका था)?"},"a":{"en":"Cray-1","hi":"क्रे-1 (Cray-1)"},"o":[{"en":"PARAM 8000","hi":"परम 8000"},{"en":"IBM 1401","hi":"आईबीएम 1401"},{"en":"Cray-1","hi":"क्रे-1 (Cray-1)"},{"en":"UNIVAC I","hi":"यूनिवैक I"}],"exp":{"en":"The 1976 supercomputer designed by Seymour Cray was the Cray-1, whereas his earlier 1964 supercomputer design at Control Data Corporation was the CDC 6600.","hi":"1976 में आया सीमोर क्रे का सुपर कंप्यूटर Cray-1 था, जबकि इससे पहले 1964 में उनसे जुड़ा सुपर कंप्यूटर CDC 6600 आ चुका था।"},"num":104},{"id":"q105","q":{"en":"What are the launch year, generation placement in notes, and circuit technology name for the IBM System/360?","hi":"IBM System/360 के लिए लॉन्च वर्ष, नोट्स में पीढ़ी (Generation) और सर्किट तकनीक का नाम क्या है?"},"a":{"en":"Launched in 1964; placed in Third Generation in notes; original line used Solid Logic Technology (SLT)","hi":"लॉन्च 1964; नोट्स इसे तीसरी पीढ़ी में रखते हैं; मूल लाइन की सर्किट तकनीक सॉलिड लॉजिक टेक्नोलॉजी (SLT) थी"},"o":[{"en":"Launched in 1946; placed in First Generation; used Vacuum Tubes","hi":"लॉन्च 1946; पहली पीढ़ी में; वैक्यूम ट्यूब का उपयोग"},{"en":"Launched in 1964; placed in Third Generation in notes; original line used Solid Logic Technology (SLT)","hi":"लॉन्च 1964; नोट्स इसे तीसरी पीढ़ी में रखते हैं; मूल लाइन की सर्किट तकनीक सॉलिड लॉजिक टेक्नोलॉजी (SLT) थी"},{"en":"Launched in 1990; placed in Fifth Generation; used Optical Qubits","hi":"लॉन्च 1990; पाँचवीं पीढ़ी में; ऑप्टिकल क्यूबिट्स का उपयोग"},{"en":"Launched in 1971; placed in Fourth Generation; used Intel 4004","hi":"लॉन्च 1971; चौथी पीढ़ी में; Intel 4004 का उपयोग"}],"exp":{"en":"IBM System/360 was launched in 1964, is placed in the Third Generation in standard notes, and its original models used IBM's hybrid Solid Logic Technology (SLT).","hi":"IBM System/360 वर्ष 1964 में लॉन्च हुआ, नोट्स में इसे तीसरी पीढ़ी (3rd Generation) में रखा गया है, और इसके मूल मॉडलों में सॉलिड लॉजिक टेक्नोलॉजी (SLT) का उपयोग हुआ था।"},"num":105},{"id":"q106","q":{"en":"Match the following devices with their data-handling category: (1) Mercury Thermometer, (2) Smartphone, (3) Petrol-Pump Dispenser System.","hi":"थर्मामीटर, स्मार्टफोन और पेट्रोल-पंप सिस्टम को डेटा हैंडलिंग श्रेणी से सुमेलित (Match) कीजिए:"},"a":{"en":"(1) Analog measurement, (2) Digital computing, (3) Hybrid system","hi":"(1) एनालॉग मापन, (2) डिजिटल कंप्यूटिंग, (3) हाइब्रिड सिस्टम"},"o":[{"en":"(1) Analog measurement, (2) Digital computing, (3) Hybrid system","hi":"(1) एनालॉग मापन, (2) डिजिटल कंप्यूटिंग, (3) हाइब्रिड सिस्टम"},{"en":"(1) Hybrid system, (2) Analog measurement, (3) Digital computing","hi":"(1) हाइब्रिड सिस्टम, (2) एनालॉग मापन, (3) डिजिटल कंप्यूटिंग"},{"en":"(1) Digital computing, (2) Analog measurement, (3) Mechanical abacus","hi":"(1) डिजिटल कंप्यूटिंग, (2) एनालॉग मापन, (3) यांत्रिक अबेकस"},{"en":"(1) Quantum system, (2) Punched card, (3) Vacuum tube","hi":"(1) क्वांटम सिस्टम, (2) पंच कार्ड, (3) वैक्यूम ट्यूब"}],"exp":{"en":"Mercury Thermometer → Analog measurement (continuous); Smartphone → Digital computing (discrete 0/1); Petrol-Pump System → Hybrid system (analog flow sensing + digital price calculation).","hi":"पारा थर्मामीटर → एनालॉग मापन; स्मार्टफोन → डिजिटल कंप्यूटिंग; पेट्रोल-पंप सिस्टम → हाइब्रिड सिस्टम।"},"num":106},{"id":"q107","q":{"en":"Match the following systems with their respective computer types: (1) DEC PDP-11, (2) IBM zSeries, (3) Summit.","hi":"PDP-11, IBM zSeries और Summit को उनके कंप्यूटर प्रकार से सुमेलित (Match) कीजिए:"},"a":{"en":"(1) Minicomputer, (2) Mainframe, (3) Supercomputer","hi":"(1) मिनी कंप्यूटर, (2) मेनफ्रेम, (3) सुपर कंप्यूटर"},"o":[{"en":"(1) Information appliance, (2) Workstation, (3) Analog meter","hi":"(1) इन्फॉर्मेशन अप्लायंस, (2) वर्कस्टेशन, (3) एनालॉग मीटर"},{"en":"(1) Supercomputer, (2) Microcomputer, (3) Minicomputer","hi":"(1) सुपर कंप्यूटर, (2) माइक्रो कंप्यूटर, (3) मिनी कंप्यूटर"},{"en":"(1) Mainframe, (2) Supercomputer, (3) Embedded system","hi":"(1) मेनफ्रेम, (2) सुपर कंप्यूटर, (3) एम्बेडेड सिस्टम"},{"en":"(1) Minicomputer, (2) Mainframe, (3) Supercomputer","hi":"(1) मिनी कंप्यूटर, (2) मेनफ्रेम, (3) सुपर कंप्यूटर"}],"exp":{"en":"DEC PDP-11 is a classic Minicomputer; IBM zSeries is an enterprise Mainframe; Summit is a Supercomputer.","hi":"DEC PDP-11 → मिनी कंप्यूटर; IBM zSeries → मेनफ्रेम कंप्यूटर; Summit → सुपर कंप्यूटर।"},"num":107},{"id":"q108","q":{"en":"Which computer systems are best suited respectively for: (1) 3D modelling, (2) Bulk bank transactions, and (3) Nuclear simulations?","hi":"3D मॉडलिंग, बल्क बैंक ट्रांजेक्शन और परमाणु सिमुलेशन (Nuclear simulations) के लिए क्रमशः कौन-से सिस्टम उपयुक्त हैं?"},"a":{"en":"(1) Workstation, (2) Mainframe, and (3) Supercomputer","hi":"(1) वर्कस्टेशन, (2) मेनफ्रेम और (3) सुपर कंप्यूटर"},"o":[{"en":"(1) Abacus, (2) Smartwatch, and (3) MP3 player","hi":"(1) अबेकस, (2) स्मार्टवॉच और (3) MP3 प्लेयर"},{"en":"(1) Mainframe, (2) Supercomputer, and (3) Microcomputer","hi":"(1) मेनफ्रेम, (2) सुपर कंप्यूटर और (3) माइक्रो कंप्यूटर"},{"en":"(1) Workstation, (2) Mainframe, and (3) Supercomputer","hi":"(1) वर्कस्टेशन, (2) मेनफ्रेम और (3) सुपर कंप्यूटर"},{"en":"(1) Supercomputer, (2) Embedded watch, and (3) Pascaline","hi":"(1) सुपर कंप्यूटर, (2) एम्बेडेड घड़ी और (3) पास्कलाइन"}],"exp":{"en":"3D modelling/CAD requires a high-graphics Workstation; bulk banking transactions require a Mainframe; nuclear research simulations require a Supercomputer.","hi":"3D मॉडलिंग के लिए वर्कस्टेशन (Workstation), बल्क बैंक ट्रांजेक्शन के लिए मेनफ्रेम (Mainframe) और परमाणु सिमुलेशन के लिए सुपर कंप्यूटर (Supercomputer) उपयुक्त हैं।"},"num":108},{"id":"q109","q":{"en":"Match the following with their functional categories: (1) Cloud database host, (2) Smart appliance controller, (3) MP3 player.","hi":"क्लाउड डेटाबेस, स्मार्ट अप्लायंस कंट्रोलर और MP3 प्लेयर को उनकी श्रेणी से सुमेलित कीजिए:"},"a":{"en":"(1) Server, (2) Embedded computer, and (3) Information appliance","hi":"(1) सर्वर, (2) एम्बेडेड कंप्यूटर और (3) इन्फॉर्मेशन अप्लायंस"},"o":[{"en":"(1) Embedded computer, (2) Supercomputer, and (3) Abacus","hi":"(1) एम्बेडेड कंप्यूटर, (2) सुपर कंप्यूटर और (3) अबेकस"},{"en":"(1) Information appliance, (2) Server, and (3) Mainframe","hi":"(1) इन्फॉर्मेशन अप्लायंस, (2) सर्वर और (3) मेनफ्रेम"},{"en":"(1) Analog meter, (2) Punched card, and (3) Workstation","hi":"(1) एनालॉग मीटर, (2) पंच कार्ड और (3) वर्कस्टेशन"},{"en":"(1) Server, (2) Embedded computer, and (3) Information appliance","hi":"(1) सर्वर, (2) एम्बेडेड कंप्यूटर और (3) इन्फॉर्मेशन अप्लायंस"}],"exp":{"en":"A cloud database host is a Server; a smart appliance controller is an Embedded Computer; a portable MP3 player is an Information Appliance.","hi":"क्लाउड डेटाबेस होस्ट → सर्वर; स्मार्ट अप्लायंस कंट्रोलर → एम्बेडेड कंप्यूटर; MP3 प्लेयर → इन्फॉर्मेशन अप्लायंस।"},"num":109},{"id":"q110","q":{"en":"In which type of computer is a 'Qubit' used instead of a classical bit?","hi":"क्लासिकल बिट की जगह 'क्यूबिट' (Qubit) किस प्रकार के कंप्यूटर में होता है?"},"a":{"en":"Quantum computer","hi":"क्वांटम कंप्यूटर (Quantum computer)"},"o":[{"en":"Quantum computer","hi":"क्वांटम कंप्यूटर (Quantum computer)"},{"en":"Mechanical Pascaline","hi":"यांत्रिक पास्कलाइन"},{"en":"First-generation Vacuum Tube computer","hi":"प्रथम पीढ़ी का वैक्यूम ट्यूब कंप्यूटर"},{"en":"Analog Mercury Thermometer","hi":"एनालॉग पारा थर्मामीटर"}],"exp":{"en":"A Quantum Computer uses Qubits (quantum bits capable of superposition) instead of classical binary bits.","hi":"क्लासिकल बिट की जगह क्यूबिट (Qubit) का उपयोग क्वांटम कंप्यूटर (Quantum Computer) में होता है।"},"num":110}],"source_pages":""},{"title":{"en":"9. Rapid-Fire Final Revision","hi":"9. त्वरित अंतिम पुनरावृत्ति"},"questions":[{"id":"q111","q":{"en":"What is the single-word term for the physical parts of a computer?","hi":"कंप्यूटर के भौतिक भागों (Physical parts) को एक शब्द में क्या कहते हैं?"},"a":{"en":"Hardware","hi":"हार्डवेयर (Hardware)"},"o":[{"en":"Malware","hi":"मैलवेयर"},{"en":"Firmware","hi":"फर्मवेयर"},{"en":"Hardware","hi":"हार्डवेयर (Hardware)"},{"en":"Software","hi":"सॉफ्टवेयर"}],"exp":{"en":"The tangible physical components of a computer system are called Hardware.","hi":"कंप्यूटर के भौतिक भागों (physical parts) को हार्डवेयर (Hardware) कहते हैं।"},"num":111},{"id":"q112","q":{"en":"What is the term for instructions and applications that tell hardware what to do?","hi":"निर्देश और एप्लिकेशन (Instructions and applications) को क्या कहा जाता है?"},"a":{"en":"Software","hi":"सॉफ्टवेयर (Software)"},"o":[{"en":"Software","hi":"सॉफ्टवेयर (Software)"},{"en":"Chassis","hi":"चेसिस"},{"en":"Hardware","hi":"हार्डवेयर"},{"en":"Peripherals","hi":"पेरिफेरल्स"}],"exp":{"en":"Programs, applications, and operating instructions that run on hardware are called Software.","hi":"कंप्यूटर को चलाने वाले निर्देशों और एप्लिकेशन को सॉफ्टवेयर (Software) कहते हैं।"},"num":112},{"id":"q113","q":{"en":"Who is called the Father of the Computer?","hi":"कंप्यूटर का जनक (Father of Computer) कौन है?"},"a":{"en":"Charles Babbage","hi":"चार्ल्स बैबेज (Charles Babbage)"},"o":[{"en":"James Powers","hi":"जेम्स पावर्स"},{"en":"Charles Babbage","hi":"चार्ल्स बैबेज (Charles Babbage)"},{"en":"John Napier","hi":"जॉन नेपियर"},{"en":"Blaise Pascal","hi":"ब्लेज़ पास्कल"}],"exp":{"en":"Charles Babbage is universally recognized as the Father of the Computer for designing the Difference Engine and Analytical Engine.","hi":"कंप्यूटर का जनक चार्ल्स बैबेज (Charles Babbage) को कहा जाता है।"},"num":113},{"id":"q114","q":{"en":"Who is credited with the first published computer algorithm and in which year?","hi":"पहली प्रकाशित कंप्यूटर एल्गोरिदम किससे और किस वर्ष से जुड़ी है?"},"a":{"en":"Ada Lovelace, 1843","hi":"एडा लवलेस, 1843"},"o":[{"en":"Ada Lovelace, 1843","hi":"एडा लवलेस, 1843"},{"en":"Seymour Cray, 1976","hi":"सीमोर क्रे, 1976"},{"en":"Alan Turing, 1936","hi":"एलन ट्यूरिंग, 1936"},{"en":"Herman Hollerith, 1890","hi":"हरमन होलेरिथ, 1890"}],"exp":{"en":"Ada Lovelace published the first computer algorithm in 1843 (for the Analytical Engine).","hi":"पहली प्रकाशित कंप्यूटर एल्गोरिदम का श्रेय एडा लवलेस (1843) को दिया जाता है।"},"num":114},{"id":"q115","q":{"en":"Who designed the 1890 U.S. Census tabulator?","hi":"1890 यू.एस. सेंसस (जनगणना) टैबुलेटर किसने बनाया था?"},"a":{"en":"Herman Hollerith","hi":"हरमन होलेरिथ (Herman Hollerith)"},"o":[{"en":"John Mauchly","hi":"जॉन मौचली"},{"en":"Charles Babbage","hi":"चार्ल्स बैबेज"},{"en":"Clifford Berry","hi":"क्लिफोर्ड बेरी"},{"en":"Herman Hollerith","hi":"हरमन होलेरिथ (Herman Hollerith)"}],"exp":{"en":"Herman Hollerith designed the electromechanical punched-card tabulator used in the 1890 U.S. Census.","hi":"1890 की अमेरिकी जनगणना का पंच-कार्ड टैबुलेटर हरमन होलेरिथ (Herman Hollerith) ने बनाया था।"},"num":115},{"id":"q116","q":{"en":"Who were the principal developers of ENIAC?","hi":"ENIAC के मुख्य डेवलपर्स (Developers) कौन थे?"},"a":{"en":"J. Presper Eckert and John W. Mauchly","hi":"जे. प्रेस्पर एकर्ट और जॉन डब्ल्यू. मौचली"},"o":[{"en":"Blaise Pascal and John Napier","hi":"ब्लेज़ पास्कल और जॉन नेपियर"},{"en":"J. Presper Eckert and John W. Mauchly","hi":"जे. प्रेस्पर एकर्ट और जॉन डब्ल्यू. मौचली"},{"en":"Alan Turing and Herman Hollerith","hi":"एलन ट्यूरिंग और हरमन होलेरिथ"},{"en":"John Atanasoff and Clifford Berry","hi":"जॉन एटानासॉफ और क्लिफोर्ड बेरी"}],"exp":{"en":"ENIAC was developed by J. Presper Eckert and John W. Mauchly at the University of Pennsylvania.","hi":"ENIAC के मुख्य डेवलपर्स जे. प्रेस्पर एकर्ट (J. Presper Eckert) और जॉन डब्ल्यू. मौचली (John W. Mauchly) थे।"},"num":116},{"id":"q117","q":{"en":"Which year marks the delivery of the first UNIVAC I?","hi":"UNIVAC I का प्रमुख वर्ष कौन-सा है?"},"a":{"en":"1951","hi":"1951"},"o":[{"en":"1976","hi":"1976"},{"en":"1642","hi":"1642"},{"en":"1890","hi":"1890"},{"en":"1951","hi":"1951"}],"exp":{"en":"The first UNIVAC I commercial computer was delivered to the U.S. Census Bureau in 1951.","hi":"प्रथम व्यावसायिक कंप्यूटर UNIVAC I वर्ष 1951 में डिलीवर हुआ था।"},"num":117},{"id":"q118","q":{"en":"Which was the first electronic digital computer installed in India, where, and in which year?","hi":"भारत में स्थापित पहला इलेक्ट्रॉनिक डिजिटल कंप्यूटर कौन-सा, कहाँ और किस वर्ष था?"},"a":{"en":"HEC-2M, ISI Kolkata, 1956","hi":"HEC-2M, भारतीय सांख्यिकी संस्थान (ISI) कोलकाता, 1956"},"o":[{"en":"Siddharth, IIT Delhi, 1980","hi":"सिद्धार्थ, आईआईटी दिल्ली, 1980"},{"en":"HEC-2M, ISI Kolkata, 1956","hi":"HEC-2M, भारतीय सांख्यिकी संस्थान (ISI) कोलकाता, 1956"},{"en":"TIFRAC, TIFR Mumbai, 1946","hi":"TIFRAC, टीआईएफआर मुंबई, 1946"},{"en":"PARAM 8000, C-DAC Pune, 1991","hi":"परम 8000, सी-डैक पुणे, 1991"}],"exp":{"en":"HEC-2M was the first electronic digital computer installed in India at the Indian Statistical Institute (ISI), Kolkata in 1956.","hi":"भारत में स्थापित पहला इलेक्ट्रॉनिक डिजिटल कंप्यूटर HEC-2M था, जो 1956 में ISI कोलकाता में लगा था।"},"num":118},{"id":"q119","q":{"en":"When was TIFRAC (India's first indigenous digital computer) formally commissioned?","hi":"TIFRAC औपचारिक रूप से कब कमीशन (Commission) हुआ?"},"a":{"en":"February 1960","hi":"फरवरी 1960"},"o":[{"en":"December 1971","hi":"दिसंबर 1971"},{"en":"August 1947","hi":"अगस्त 1947"},{"en":"January 1950","hi":"जनवरी 1950"},{"en":"February 1960","hi":"फरवरी 1960"}],"exp":{"en":"TIFRAC, India's first indigenously built digital computer at TIFR Mumbai, was formally commissioned in February 1960.","hi":"भारत का पहला स्वदेशी डिजिटल कंप्यूटर TIFRAC फरवरी 1960 में कमीशन हुआ था।"},"num":119},{"id":"q120","q":{"en":"On which date is World Computer Literacy Day celebrated?","hi":"विश्व कंप्यूटर साक्षरता दिवस (World Computer Literacy Day) किस तिथि को मनाया जाता है?"},"a":{"en":"2 December","hi":"2 दिसंबर"},"o":[{"en":"2 December","hi":"2 दिसंबर"},{"en":"24 October","hi":"24 अक्टूबर"},{"en":"5 September","hi":"5 सितंबर"},{"en":"11 May","hi":"11 मई"}],"exp":{"en":"World Computer Literacy Day is celebrated every year on 2 December.","hi":"विश्व कंप्यूटर साक्षरता दिवस प्रतिवर्ष 2 दिसंबर को मनाया जाता है।"},"num":120},{"id":"q121","q":{"en":"With which years and designer are CDC 6600 and Cray-1 associated?","hi":"CDC 6600 और Cray-1 किन वर्षों और किस डिज़ाइनर से जुड़े हैं?"},"a":{"en":"1964 and 1976 respectively, both associated with Seymour Cray","hi":"क्रमशः 1964 और 1976, दोनों सीमोर क्रे (Seymour Cray) से जुड़े हैं"},"o":[{"en":"1946 and 1951 respectively, both associated with Herman Hollerith","hi":"क्रमशः 1946 और 1951, दोनों हरमन होलेरिथ से जुड़े हैं"},{"en":"1833 and 1843 respectively, both associated with Charles Babbage","hi":"क्रमशः 1833 और 1843, दोनों चार्ल्स बैबेज से जुड़े हैं"},{"en":"1617 and 1642 respectively, both associated with Blaise Pascal","hi":"क्रमशः 1617 और 1642, दोनों ब्लेज़ पास्कल से जुड़े हैं"},{"en":"1964 and 1976 respectively, both associated with Seymour Cray","hi":"क्रमशः 1964 और 1976, दोनों सीमोर क्रे (Seymour Cray) से जुड़े हैं"}],"exp":{"en":"CDC 6600 was introduced in 1964 and Cray-1 in 1976; both pioneering supercomputers were designed by Seymour Cray.","hi":"CDC 6600 (1964) और Cray-1 (1976) दोनों सुपर कंप्यूटर प्रसिद्ध डिज़ाइनर सीमोर क्रे (Seymour Cray) से जुड़े हैं।"},"num":121},{"id":"q122","q":{"en":"What is Intel 4004 and in which year was it released?","hi":"Intel 4004 क्या है और यह किस वर्ष आया?"},"a":{"en":"Microprocessor, 1971","hi":"माइक्रोप्रोसेसर, 1971"},"o":[{"en":"Vacuum tube computer, 1946","hi":"वैक्यूम ट्यूब कंप्यूटर, 1946"},{"en":"Microprocessor, 1971","hi":"माइक्रोप्रोसेसर, 1971"},{"en":"Mechanical tabulator, 1890","hi":"यांत्रिक टैबुलेटर, 1890"},{"en":"Mainframe family, 1964","hi":"मेनफ्रेम परिवार, 1964"}],"exp":{"en":"Intel 4004, released in 1971, was an early commercially available single-chip programmable microprocessor.","hi":"Intel 4004 वर्ष 1971 में रिलीज़ हुआ एक प्रारंभिक सिंगल-चिप माइक्रोप्रोसेसर है।"},"num":122},{"id":"q123","q":{"en":"Vacuum tube, Transistor, and IC correspond respectively to which computer generations?","hi":"वैक्यूम ट्यूब, ट्रांजिस्टर और IC क्रमशः किन कंप्यूटर पीढ़ियों से संबंधित हैं?"},"a":{"en":"First, Second, and Third generation","hi":"प्रथम, द्वितीय और तृतीय पीढ़ी"},"o":[{"en":"Third, Fourth, and Fifth generation","hi":"तृतीय, चतुर्थ और पंचम पीढ़ी"},{"en":"Fourth, Fifth, and First generation","hi":"चतुर्थ, पंचम और प्रथम पीढ़ी"},{"en":"First, Second, and Third generation","hi":"प्रथम, द्वितीय और तृतीय पीढ़ी"},{"en":"Second, Third, and Fourth generation","hi":"द्वितीय, तृतीय और चतुर्थ पीढ़ी"}],"exp":{"en":"1st Generation used Vacuum Tubes, 2nd Generation used Transistors, and 3rd Generation used Integrated Circuits (ICs).","hi":"वैक्यूम ट्यूब प्रथम पीढ़ी से, ट्रांजिस्टर द्वितीय पीढ़ी से और इंटीग्रेटेड सर्किट (IC) तृतीय पीढ़ी से संबंधित हैं।"},"num":123},{"id":"q124","q":{"en":"Microprocessor and Artificial Intelligence (AI) are the standard exam keywords for which generations?","hi":"माइक्रोप्रोसेसर और आर्टिफिशियल इंटेलिजेंस (AI) क्रमशः किन पीढ़ियों के परीक्षा कीवर्ड हैं?"},"a":{"en":"Fourth and Fifth generation","hi":"चतुर्थ और पंचम पीढ़ी (Fourth and Fifth generation)"},"o":[{"en":"Fourth and Fifth generation","hi":"चतुर्थ और पंचम पीढ़ी (Fourth and Fifth generation)"},{"en":"First and Second generation","hi":"प्रथम और द्वितीय पीढ़ी"},{"en":"First and Third generation","hi":"प्रथम और तृतीय पीढ़ी"},{"en":"Second and Third generation","hi":"द्वितीय और तृतीय पीढ़ी"}],"exp":{"en":"Microprocessor (LSI/VLSI) is the keyword for the 4th Generation, and Artificial Intelligence (AI) is the keyword for the 5th Generation.","hi":"माइक्रोप्रोसेसर चतुर्थ पीढ़ी (4th Gen) का और आर्टिफिशियल इंटेलिजेंस (AI) पंचम पीढ़ी (5th Gen) का परीक्षा कीवर्ड है।"},"num":124},{"id":"q125","q":{"en":"Which computer types correspond to continuous data, discrete data, and the combination of both?","hi":"सतत डेटा (Continuous), असतत डेटा (Discrete) और दोनों को मिलाने वाले सिस्टम को क्रमशः क्या कहते हैं?"},"a":{"en":"Analog, Digital, and Hybrid","hi":"एनालॉग, डिजिटल और हाइब्रिड (Hybrid)"},"o":[{"en":"Hardware, Software, and Firmware","hi":"हार्डवेयर, सॉफ्टवेयर और फर्मवेयर"},{"en":"Mini, Mainframe, and Micro","hi":"मिनी, मेनफ्रेम और माइक्रो"},{"en":"Analog, Digital, and Hybrid","hi":"एनालॉग, डिजिटल और हाइब्रिड (Hybrid)"},{"en":"Digital, Analog, and Mechanical","hi":"डिजिटल, एनालॉग और मैकेनिकल"}],"exp":{"en":"Analog computers handle continuous data, Digital computers handle discrete (binary) data, and Hybrid computers combine both capabilities.","hi":"सतत डेटा के लिए एनालॉग, असतत डेटा के लिए डिजिटल और दोनों के संयोजन वाले सिस्टम को हाइब्रिड कंप्यूटर कहते हैं।"},"num":125},{"id":"q126","q":{"en":"What is the approximate number of users supported by a Minicomputer according to the notes?","hi":"नोट्स के हिसाब से मिनी कंप्यूटर (Minicomputer) के उपयोगकर्ताओं की संख्या कितनी है?"},"a":{"en":"4–200 users","hi":"4–200 उपयोगकर्ता"},"o":[{"en":"4–200 users","hi":"4–200 उपयोगकर्ता"},{"en":"Only 1 user","hi":"केवल 1 उपयोगकर्ता"},{"en":"Zero users","hi":"शून्य उपयोगकर्ता"},{"en":"1,00,000–5,00,000 users","hi":"1,00,000–5,00,000 उपयोगकर्ता"}],"exp":{"en":"According to the chapter notes, a Minicomputer typically supported around 4 to 200 concurrent users.","hi":"नोट्स के अनुसार एक मिनी कंप्यूटर लगभग 4 से 200 उपयोगकर्ताओं (users) को सपोर्ट करता था।"},"num":126},{"id":"q127","q":{"en":"Which computer category is defined as a 'single-user high-performance engineering machine'?","hi":"'सिंगल-यूजर हाई-परफॉर्मेंस इंजीनियरिंग मशीन' किसे कहा जाता है?"},"a":{"en":"Workstation","hi":"वर्कस्टेशन (Workstation)"},"o":[{"en":"Workstation","hi":"वर्कस्टेशन (Workstation)"},{"en":"Abacus","hi":"अबेकस"},{"en":"Mainframe","hi":"मेनफ्रेम"},{"en":"Information appliance","hi":"इन्फॉर्मेशन अप्लायंस"}],"exp":{"en":"A Workstation is a high-performance single-user computer built for engineering, CAD/CAM, 3D graphics, and scientific work.","hi":"सिंगल-यूजर हाई-परफॉर्मेंस इंजीनियरिंग मशीन को वर्कस्टेशन (Workstation) कहा जाता है।"},"num":127},{"id":"q128","q":{"en":"Which computer category is primarily used for bulk banking data and transaction processing?","hi":"बल्क बैंकिंग डेटा (Bulk banking data) और ट्रांजेक्शन के लिए कौन-सा कंप्यूटर उपयोग होता है?"},"a":{"en":"Mainframe","hi":"मेनफ्रेम (Mainframe)"},"o":[{"en":"Pascaline","hi":"पास्कलाइन"},{"en":"MP3 player","hi":"MP3 प्लेयर"},{"en":"Mainframe","hi":"मेनफ्रेम (Mainframe)"},{"en":"Embedded watch","hi":"एम्बेडेड घड़ी"}],"exp":{"en":"Mainframe computers are used by banks, insurance companies, and governments for bulk data and transaction processing.","hi":"बल्क बैंकिंग डेटा और विशाल ट्रांजेक्शन प्रोसेसिंग के लिए मेनफ्रेम (Mainframe) कंप्यूटर का उपयोग होता है।"},"num":128},{"id":"q129","q":{"en":"Which computer category is designed for complex scientific simulations and weather forecasting?","hi":"जटिल वैज्ञानिक सिमुलेशन (Complex scientific simulation) के लिए कौन-सा कंप्यूटर उपयोग होता है?"},"a":{"en":"Supercomputer","hi":"सुपर कंप्यूटर (Supercomputer)"},"o":[{"en":"Napier's Bones","hi":"नेपियर्स बोन्स"},{"en":"Supercomputer","hi":"सुपर कंप्यूटर (Supercomputer)"},{"en":"Microcomputer","hi":"माइक्रो कंप्यूटर"},{"en":"Information appliance","hi":"इन्फॉर्मेशन अप्लायंस"}],"exp":{"en":"Supercomputers are used for complex scientific simulations, nuclear research, and weather forecasting.","hi":"जटिल वैज्ञानिक सिमुलेशन और मौसम पूर्वानुमान के लिए सुपर कंप्यूटर (Supercomputer) का उपयोग किया जाता है।"},"num":129},{"id":"q130","q":{"en":"Which computer system shares resources and services with client machines over a network?","hi":"नेटवर्क पर क्लाइंट्स (Clients) को रिसोर्स कौन साझा करता है?"},"a":{"en":"Server","hi":"सर्वर (Server)"},"o":[{"en":"Server","hi":"सर्वर (Server)"},{"en":"Mercury thermometer","hi":"पारा थर्मामीटर"},{"en":"Punched card","hi":"पंच कार्ड"},{"en":"Abacus","hi":"अबेकस"}],"exp":{"en":"A Server provides shared resources, files, databases, and services to client computers across a network.","hi":"नेटवर्क पर क्लाइंट कंप्यूटरों को संसाधन और सेवाएँ साझा करने वाला सिस्टम सर्वर (Server) कहलाता है।"},"num":130},{"id":"q131","q":{"en":"What do we call a computer built inside a larger device for a specific function?","hi":"विशिष्ट कार्य (Specific function) के लिए किसी उपकरण के अंदर लगा कंप्यूटर क्या कहलाता है?"},"a":{"en":"Embedded computer","hi":"एम्बेडेड कंप्यूटर (Embedded computer)"},"o":[{"en":"Supercomputer","hi":"सुपर कंप्यूटर"},{"en":"Mainframe computer","hi":"मेनफ्रेम कंप्यूटर"},{"en":"Workstation","hi":"वर्कस्टेशन"},{"en":"Embedded computer","hi":"एम्बेडेड कंप्यूटर (Embedded computer)"}],"exp":{"en":"An Embedded Computer is built inside a larger device or appliance to perform a dedicated control or monitoring function.","hi":"किसी उपकरण के अंदर विशिष्ट कार्य के लिए लगा कंप्यूटर एम्बेडेड कंप्यूटर (Embedded computer) कहलाता है।"},"num":131},{"id":"q132","q":{"en":"What is the basic unit of quantum information?","hi":"क्वांटम सूचना की मूल इकाई (Quantum information unit) क्या है?"},"a":{"en":"Qubit","hi":"क्यूबिट (Qubit)"},"o":[{"en":"Punched card","hi":"पंच कार्ड"},{"en":"Bead","hi":"मनका"},{"en":"Qubit","hi":"क्यूबिट (Qubit)"},{"en":"Vacuum tube","hi":"वैक्यूम ट्यूब"}],"exp":{"en":"The basic unit of information in quantum computing is the Qubit (quantum bit).","hi":"क्वांटम कंप्यूटिंग में सूचना की मूल इकाई क्यूबिट (Qubit) है।"},"num":132}],"source_pages":""}],"2. Computer Organization — CPU, I/O, Memory, Buses & Ports":[{"title":{"en":"1. Computer Organization & CPU","hi":"1. कंप्यूटर संगठन और सीपीयू"},"questions":[{"id":"q1","q":{"en":"What are the three basic functional units of computer organization?","hi":"कंप्यूटर संगठन (Computer Organization) की तीन मूल इकाइयाँ (Basic Units) कौन-सी हैं?"},"a":{"en":"CPU, Memory Unit, and Input/Output Unit","hi":"CPU, मेमोरी यूनिट और इनपुट/आउटपुट यूनिट"},"o":[{"en":"Monitor, Printer, and Plotter","hi":"मॉनिटर, प्रिंटर और प्लॉटर"},{"en":"CPU, Memory Unit, and Input/Output Unit","hi":"CPU, मेमोरी यूनिट और इनपुट/आउटपुट यूनिट"},{"en":"Keyboard, Mouse, and Scanner","hi":"कीबोर्ड, माउस और स्कैनर"},{"en":"Hard Disk, Pen Drive, and Optical Disc","hi":"हार्ड डिस्क, पेन ड्राइव और ऑप्टिकल डिस्क"}],"exp":{"en":"The three basic functional units of computer organization are the Central Processing Unit (CPU), the Memory Unit, and the Input/Output (I/O) Unit.","hi":"कंप्यूटर संगठन की तीन मूल इकाइयाँ CPU (सेंट्रल प्रोसेसिंग यूनिट), मेमोरी यूनिट (Memory Unit) और इनपुट/आउटपुट यूनिट (Input/Output Unit) हैं।"},"num":1},{"id":"q2","q":{"en":"What are the two main parts of a computer system?","hi":"कंप्यूटर के दो मुख्य भाग (Main Parts) कौन-से हैं?"},"a":{"en":"Hardware and Software","hi":"हार्डवेयर और सॉफ्टवेयर"},"o":[{"en":"Hardware and Software","hi":"हार्डवेयर और सॉफ्टवेयर"},{"en":"Compiler and Interpreter","hi":"कंपाइलर और इंटरप्रेटर"},{"en":"RAM and ROM only","hi":"केवल RAM और ROM"},{"en":"Left button and Right button","hi":"लेफ्ट बटन और राइट बटन"}],"exp":{"en":"A computer system is fundamentally divided into two main parts: Hardware (physical components) and Software (programs and instructions).","hi":"कंप्यूटर के दो मुख्य भाग हार्डवेयर (Hardware — भौतिक घटक) और सॉफ्टवेयर (Software — प्रोग्राम व निर्देश) हैं।"},"num":2},{"id":"q3","q":{"en":"What is the full form of CPU?","hi":"CPU का पूर्ण रूप (Full Form) क्या है?"},"a":{"en":"Central Processing Unit","hi":"सेंट्रल प्रोसेसिंग यूनिट"},"o":[{"en":"Central Programming Utility","hi":"सेंट्रल प्रोग्रामिंग यूटिलिटी"},{"en":"Control Processing Unit","hi":"कंट्रोल प्रोसेसिंग यूनिट"},{"en":"Central Processing Unit","hi":"सेंट्रल प्रोसेसिंग यूनिट"},{"en":"Computer Peripheral Unit","hi":"कंप्यूटर पेरिफेरल यूनिट"}],"exp":{"en":"CPU stands for Central Processing Unit, which is the primary component that processes instructions in a computer.","hi":"CPU का पूर्ण रूप Central Processing Unit (सेंट्रल प्रोसेसिंग यूनिट) है।"},"num":3},{"id":"q4","q":{"en":"Which component is called the 'Brain of the Computer' and why?","hi":"कंप्यूटर का मस्तिष्क ('Brain of the Computer') किसे और क्यों कहते हैं?"},"a":{"en":"CPU, because it processes instructions and coordinates operations","hi":"CPU को, क्योंकि यह निर्देशों को प्रोसेस करता है और ऑपरेशन्स को समन्वित (coordinate) करता है"},"o":[{"en":"SMPS, because it supplies electric power to all parts","hi":"SMPS को, क्योंकि यह सभी भागों को बिजली की आपूर्ति करता है"},{"en":"Monitor, because it displays visual output on the screen","hi":"मॉनिटर को, क्योंकि यह स्क्रीन पर विजुअल आउटपुट दिखाता है"},{"en":"CPU, because it processes instructions and coordinates operations","hi":"CPU को, क्योंकि यह निर्देशों को प्रोसेस करता है और ऑपरेशन्स को समन्वित (coordinate) करता है"},{"en":"Keyboard, because it is used to type commands","hi":"कीबोर्ड को, क्योंकि इसका उपयोग कमांड टाइप करने के लिए किया जाता है"}],"exp":{"en":"The CPU is called the brain of the computer because it processes instructions, performs calculations, and coordinates all system operations.","hi":"CPU को कंप्यूटर का मस्तिष्क (brain) कहा जाता है, क्योंकि यह निर्देशों (instructions) को प्रोसेस करता है और सभी कार्यों का समन्वय (coordinate) करता है।"},"num":4},{"id":"q5","q":{"en":"From where does the CPU fetch instructions and data, and where does the result go after execution?","hi":"CPU निर्देश (Instruction) और डेटा कहाँ से फेच (Fetch) करता है, और निष्पादन के बाद परिणाम कहाँ रखा जा सकता है?"},"a":{"en":"Fetches from Memory; after execution, the result can be kept in a register or written back to memory","hi":"मेमोरी से फेच करता है; निष्पादन के बाद परिणाम रजिस्टर में रख सकता है या मेमोरी में लिख (write) सकता है"},"o":[{"en":"Fetches from printer paper and writes result only to the mouse","hi":"प्रिंटर पेपर से फेच करता है और परिणाम केवल माउस में लिखता है"},{"en":"Fetches from Memory; after execution, the result can be kept in a register or written back to memory","hi":"मेमोरी से फेच करता है; निष्पादन के बाद परिणाम रजिस्टर में रख सकता है या मेमोरी में लिख (write) सकता है"},{"en":"Fetches from speaker and writes result to the microphone","hi":"स्पीकर से फेच करता है और परिणाम माइक्रोफोन में लिखता है"},{"en":"Fetches from UPS battery and stores result in the cooling fan","hi":"यूपीएस बैटरी से फेच करता है और परिणाम कूलिंग फैन में रखता है"}],"exp":{"en":"The CPU fetches instructions and data from memory. After executing an instruction, it can hold the result in an internal register or write it back to memory.","hi":"CPU निर्देश और डेटा मेमोरी (Memory) से फेच करता है। निर्देश निष्पादित (execute) करने के बाद वह परिणाम को रजिस्टर में रख सकता है या वापस मेमोरी में राइट (write) कर सकता है।"},"num":5},{"id":"q6","q":{"en":"What are the three main internal components of the CPU?","hi":"CPU के तीन मुख्य आंतरिक घटक (Main Components) कौन-से हैं?"},"a":{"en":"Arithmetic and Logic Unit (ALU), Control Unit (CU), and Registers","hi":"अरिथमेटिक एंड लॉजिक यूनिट (ALU), कंट्रोल यूनिट (CU) और रजिस्टर (Registers)"},"o":[{"en":"Monitor, Keyboard, and Mouse","hi":"मॉनिटर, कीबोर्ड और माउस"},{"en":"Hard Disk, Optical Drive, and USB Port","hi":"हार्ड डिस्क, ऑप्टिकल ड्राइव और यूएसबी पोर्ट"},{"en":"Arithmetic and Logic Unit (ALU), Control Unit (CU), and Registers","hi":"अरिथमेटिक एंड लॉजिक यूनिट (ALU), कंट्रोल यूनिट (CU) और रजिस्टर (Registers)"},{"en":"Scanner, Plotter, and Barcode Reader","hi":"स्कैनर, प्लॉटर और बारकोड रीडर"}],"exp":{"en":"The three core internal components of the CPU are the Arithmetic and Logic Unit (ALU), the Control Unit (CU), and high-speed Registers.","hi":"CPU के तीन मुख्य घटक अरिथमेटिक एंड लॉजिक यूनिट (ALU), कंट्रोल यूनिट (CU) और रजिस्टर (Registers) हैं।"},"num":6},{"id":"q7","q":{"en":"If a desktop PC diagram labels the external tower as 'CPU', what is the CPU technically?","hi":"यदि डेस्कटॉप पीसी आरेख में बाहरी टॉवर (Tower) को 'CPU' लेबल किया गया हो, तो तकनीकी रूप से CPU क्या है?"},"a":{"en":"The CPU is the processor chip mounted inside the tower, whereas the tower itself is the cabinet or system unit","hi":"CPU टॉवर के अंदर लगा प्रोसेसर है, जबकि पूरा टॉवर कैबिनेट या सिस्टम यूनिट (System Unit) है"},"o":[{"en":"The CPU is the processor chip mounted inside the tower, whereas the tower itself is the cabinet or system unit","hi":"CPU टॉवर के अंदर लगा प्रोसेसर है, जबकि पूरा टॉवर कैबिनेट या सिस्टम यूनिट (System Unit) है"},{"en":"The external metal box alone is the microprocessor chip","hi":"केवल बाहरी धातु का डिब्बा ही माइक्रोप्रोसेसर चिप है"},{"en":"The tower is an output monitor and contains no electronic circuit","hi":"टॉवर एक आउटपुट मॉनिटर है और इसमें कोई इलेक्ट्रॉनिक सर्किट नहीं होता"},{"en":"The tower is a network router used only for Wi-Fi signals","hi":"टॉवर एक नेटवर्क राउटर है जिसका उपयोग केवल वाई-फाई सिग्नल के लिए होता है"}],"exp":{"en":"Colloquially the desktop tower is often called 'CPU', but technically the tower is the cabinet or system unit, while the actual CPU is the processor chip installed on the motherboard inside it.","hi":"तकनीकी रूप से CPU टॉवर के अंदर मदरबोर्ड पर लगा प्रोसेसर (processor) है, जबकि पूरा टॉवर कैबिनेट (cabinet) या सिस्टम यूनिट (system unit) कहलाता है।"},"num":7},{"id":"q8","q":{"en":"What are the respective roles of the monitor, speaker, keyboard, mouse, and router in a desktop setup?","hi":"डेस्कटॉप सेटअप में मॉनिटर, स्पीकर, कीबोर्ड, माउस और राउटर की क्रमशः क्या भूमिकाएँ हैं?"},"a":{"en":"Monitor provides visual output, speaker provides audio output, keyboard and mouse provide input, and router provides network connection","hi":"मॉनिटर विजुअल आउटपुट, स्पीकर ऑडियो आउटपुट, कीबोर्ड और माउस इनपुट, तथा राउटर नेटवर्क कनेक्शन देता है"},"o":[{"en":"Monitor and speaker provide input; keyboard and mouse provide audio output","hi":"मॉनिटर और स्पीकर इनपुट देते हैं; कीबोर्ड और माउस ऑडियो आउटपुट देते हैं"},{"en":"Monitor provides visual output, speaker provides audio output, keyboard and mouse provide input, and router provides network connection","hi":"मॉनिटर विजुअल आउटपुट, स्पीकर ऑडियो आउटपुट, कीबोर्ड और माउस इनपुट, तथा राउटर नेटवर्क कनेक्शन देता है"},{"en":"All five devices act exclusively as secondary magnetic storage","hi":"सभी पाँच उपकरण केवल सेकेंडरी मैग्नेटिक स्टोरेज के रूप में कार्य करते हैं"},{"en":"Router prints paper documents while keyboard displays video graphics","hi":"राउटर कागजी दस्तावेज़ प्रिंट करता है जबकि कीबोर्ड वीडियो ग्राफिक्स दिखाता है"}],"exp":{"en":"In a desktop setup, the monitor gives visual output, the speaker gives audio output, the keyboard and mouse provide user input, and the router provides network/internet connectivity.","hi":"डेस्कटॉप सेटअप में मॉनिटर विजुअल आउटपुट, स्पीकर ऑडियो आउटपुट, कीबोर्ड और माउस इनपुट, और राउटर नेटवर्क कनेक्शन प्रदान करता है।"},"num":8},{"id":"q9","q":{"en":"Which of the following are the common controls found on a standard computer mouse?","hi":"एक मानक कंप्यूटर माउस के सामान्य कंट्रोल्स (Common Controls) कौन-से हैं?"},"a":{"en":"Left button, right button, and scroll wheel","hi":"लेफ्ट बटन, राइट बटन और स्क्रॉल व्हील (Scroll wheel)"},"o":[{"en":"Left button, right button, and scroll wheel","hi":"लेफ्ट बटन, राइट बटन और स्क्रॉल व्हील (Scroll wheel)"},{"en":"Function keys F1 to F12 and Spacebar","hi":"फंक्शन कीज़ F1 से F12 और स्पेसबार"},{"en":"Paper feed roller and ink toner cartridge","hi":"पेपर फ़ीड रोलर और इंक टोनर कार्ट्रिज"},{"en":"Cathode ray tube and magnetic read/write head","hi":"कैथोड रे ट्यूब और मैग्नेटिक रीड/राइट हेड"}],"exp":{"en":"A standard computer mouse features three common controls: a left button (for primary click/selection), a right button (for context menu), and a scroll wheel.","hi":"माउस के सामान्य कंट्रोल्स लेफ्ट बटन (left button), राइट बटन (right button) और स्क्रॉल व्हील (scroll wheel) हैं।"},"num":9},{"id":"q10","q":{"en":"What is the full form and primary function of the ALU?","hi":"ALU का पूर्ण रूप (Full Form) और मुख्य कार्य क्या है?"},"a":{"en":"Arithmetic and Logic Unit — It performs arithmetic operations (like addition) and logic operations (like AND/comparison)","hi":"अरिथमेटिक एंड लॉजिक यूनिट — यह जोड़ जैसी अंकगणितीय और AND/तुलना जैसी तार्किक (logic) क्रियाएँ करती है"},"o":[{"en":"Application Link Utility — It connects the computer to a Wi-Fi router","hi":"एप्लिकेशन लिंक यूटिलिटी — यह कंप्यूटर को वाई-फाई राउटर से जोड़ती है"},{"en":"Array Loading Unit — It only loads paper into an inkjet printer","hi":"ऐरे लोडिंग यूनिट — यह केवल इंकजेट प्रिंटर में कागज लोड करती है"},{"en":"Audio Line Unit — It converts sound waves into speaker output","hi":"ऑडियो लाइन यूनिट — यह ध्वनि तरंगों को स्पीकर आउटपुट में बदलती है"},{"en":"Arithmetic and Logic Unit — It performs arithmetic operations (like addition) and logic operations (like AND/comparison)","hi":"अरिथमेटिक एंड लॉजिक यूनिट — यह जोड़ जैसी अंकगणितीय और AND/तुलना जैसी तार्किक (logic) क्रियाएँ करती है"}],"exp":{"en":"ALU stands for Arithmetic and Logic Unit. It executes arithmetic operations (addition, subtraction, etc.) and logical/comparison operations (AND, OR, NOT, equal to, greater than, etc.).","hi":"ALU का पूर्ण रूप Arithmetic and Logic Unit है। यह जोड़ (addition) जैसी अंकगणितीय (arithmetic) और AND/तुलना (comparison) जैसी तार्किक (logic) क्रियाएँ करती है।"},"num":10},{"id":"q11","q":{"en":"What inputs does the ALU receive and what outputs does it produce?","hi":"ALU को इनपुट में क्या मिलता है और उससे आउटपुट क्या निकलते हैं?"},"a":{"en":"Inputs are operands from registers and control signals selecting the operation; outputs update the result register and status flags","hi":"इनपुट में रजिस्टरों से ऑपरेंड और ऑपरेशन चुनने वाले कंट्रोल सिग्नल मिलते हैं; आउटपुट में रिजल्ट रजिस्टर और स्टेटस फ्लैग्स अपडेट होते हैं"},"o":[{"en":"Inputs are operands from registers and control signals selecting the operation; outputs update the result register and status flags","hi":"इनपुट में रजिस्टरों से ऑपरेंड और ऑपरेशन चुनने वाले कंट्रोल सिग्नल मिलते हैं; आउटपुट में रिजल्ट रजिस्टर और स्टेटस फ्लैग्स अपडेट होते हैं"},{"en":"Inputs are AC mains voltage; output is printed hard copy on A4 paper","hi":"इनपुट एसी मेन वोल्टेज है; आउटपुट A4 पेपर पर प्रिंटेड हार्ड कॉपी है"},{"en":"Inputs are audio waves from speakers; output is barcode laser light","hi":"इनपुट स्पीकर से ऑडियो तरंगें हैं; आउटपुट बारकोड लेजर लाइट है"},{"en":"Inputs come directly from the mouse pad; output goes directly to the UPS","hi":"इनपुट सीधे माउस पैड से आता है; आउटपुट सीधे यूपीएस में जाता है"}],"exp":{"en":"The ALU receives data operands from CPU registers along with control signals from the Control Unit that select the operation. Its output is stored in a result register and updates status flags.","hi":"ALU को ऑपरेंड्स (operands) रजिस्टरों से मिलते हैं और कंट्रोल सिग्नल ऑपरेशन का चयन करते हैं। इसके आउटपुट से रिजल्ट रजिस्टर और स्टेटस फ्लैग्स (status flags) अपडेट होते हैं।"},"num":11},{"id":"q12","q":{"en":"What do ALU status flags indicate?","hi":"ALU फ्लैग्स (Status Flags) क्या दर्शाते हैं?"},"a":{"en":"The status of an operation, such as whether the result is zero or if a carry occurred in addition","hi":"ऑपरेशन की स्थिति (Status), जैसे परिणाम शून्य (zero) है या जोड़ में कैरी (carry) आया है"},"o":[{"en":"The physical weight and screen size of the monitor","hi":"मॉनिटर का भौतिक वजन और स्क्रीन आकार"},{"en":"The status of an operation, such as whether the result is zero or if a carry occurred in addition","hi":"ऑपरेशन की स्थिति (Status), जैसे परिणाम शून्य (zero) है या जोड़ में कैरी (carry) आया है"},{"en":"The number of keys present on an external keyboard","hi":"बाहरी कीबोर्ड पर मौजूद कुंजियों की संख्या"},{"en":"The internet download speed of the external router","hi":"बाहरी राउटर की इंटरनेट डाउनलोड गति"}],"exp":{"en":"ALU status flags (condition codes) indicate the outcome/status of an arithmetic or logic operation, such as Zero (Z), Carry (C), Sign (S), or Overflow (V).","hi":"ALU फ्लैग्स किसी ऑपरेशन का स्टेटस (status) दर्शाते हैं, जैसे परिणाम शून्य (zero) है या जोड़ (addition) में कैरी (carry) आया है।"},"num":12},{"id":"q13","q":{"en":"What is the full form and main function of the CU in a processor?","hi":"प्रोसेसर में CU का पूर्ण रूप (Full Form) और मुख्य कार्य क्या है?"},"a":{"en":"Control Unit — It interprets instructions and coordinates data flow between memory, ALU, and I/O devices","hi":"कंट्रोल यूनिट — यह निर्देशों की व्याख्या (interpret) करती है और मेमोरी, ALU तथा I/O के बीच डेटा प्रवाह समन्वित करती है"},"o":[{"en":"Calculation Unit — It only multiplies floating-point numbers","hi":"कैलकुलेशन यूनिट — यह केवल फ्लोटिंग-पॉइंट संख्याओं का गुणा करती है"},{"en":"Cache Utility — It stores permanent backup files on optical discs","hi":"कैश यूटिलिटी — यह ऑप्टिकल डिस्क पर स्थायी बैकअप फ़ाइलें संग्रहीत करती है"},{"en":"Control Unit — It interprets instructions and coordinates data flow between memory, ALU, and I/O devices","hi":"कंट्रोल यूनिट — यह निर्देशों की व्याख्या (interpret) करती है और मेमोरी, ALU तथा I/O के बीच डेटा प्रवाह समन्वित करती है"},{"en":"Character Unit — It scans magnetic ink characters on bank cheques","hi":"कैरेक्टर यूनिट — यह बैंक चेक पर मैग्नेटिक इंक अक्षरों को स्कैन करती है"}],"exp":{"en":"CU stands for Control Unit. It decodes/interprets instructions and generates control signals to coordinate data flow among memory, the ALU, registers, and I/O devices.","hi":"CU का पूर्ण रूप Control Unit है। यह निर्देशों को इंटरप्रेट (व्याख्या) करती है और मेमोरी, ALU तथा I/O के बीच डेटा प्रवाह को समन्वित (coordinate) करती है।"},"num":13},{"id":"q14","q":{"en":"What is the correct sequence of the basic steps in an Instruction Cycle?","hi":"इंस्ट्रक्शन साइकिल (Instruction Cycle) के बुनियादी चरणों का सही क्रम क्या है?"},"a":{"en":"Fetch → Decode → Execute (coordinated by the Control Unit)","hi":"फेच (Fetch) → डिकोड (Decode) → एक्जीक्यूट (Execute) (कंट्रोल यूनिट द्वारा समन्वित)"},"o":[{"en":"Print → Scan → Shut down","hi":"प्रिंट → स्कैन → शट डाउन"},{"en":"Execute → Fetch → Delete","hi":"एक्जीक्यूट → फेच → डिलीट"},{"en":"Fetch → Decode → Execute (coordinated by the Control Unit)","hi":"फेच (Fetch) → डिकोड (Decode) → एक्जीक्यूट (Execute) (कंट्रोल यूनिट द्वारा समन्वित)"},{"en":"Format → Boot → Reboot","hi":"फॉर्मेट → बूट → रीबूट"}],"exp":{"en":"The basic instruction cycle consists of three sequential steps: Fetch (retrieve instruction from memory) → Decode (interpret instruction) → Execute (perform the operation), coordinated by the Control Unit.","hi":"इंस्ट्रक्शन साइकिल के मूल चरण Fetch → Decode → Execute हैं, और कंट्रोल यूनिट (CU) इन चरणों को समन्वित करती है।"},"num":14},{"id":"q15","q":{"en":"What are 'Registers' in a CPU?","hi":"CPU में 'रजिस्टर' (Registers) क्या होते हैं?"},"a":{"en":"Very small, ultra-fast storage locations inside the CPU that temporarily hold active data, addresses, and instructions","hi":"CPU के अंदर के बहुत छोटे, तेज़ स्टोरेज लोकेशन्स जो सक्रिय डेटा, एड्रेस और निर्देशों को अस्थायी रूप से रखते हैं"},"o":[{"en":"Large external magnetic tapes used for archival backup","hi":"अभिलेखीय बैकअप के लिए उपयोग किए जाने वाले बड़े बाहरी चुंबकीय टेप"},{"en":"Very small, ultra-fast storage locations inside the CPU that temporarily hold active data, addresses, and instructions","hi":"CPU के अंदर के बहुत छोटे, तेज़ स्टोरेज लोकेशन्स जो सक्रिय डेटा, एड्रेस और निर्देशों को अस्थायी रूप से रखते हैं"},{"en":"Output devices used for printing large engineering blueprints","hi":"बड़े इंजीनियरिंग ब्लूप्रिंट प्रिंट करने के लिए प्रयुक्त आउटपुट डिवाइस"},{"en":"Plastic ports on the back panel used to plug in audio jacks","hi":"पीछे के पैनल पर लगे प्लास्टिक पोर्ट जिनका उपयोग ऑडियो जैक लगाने के लिए होता है"}],"exp":{"en":"Registers are very small, extremely fast storage locations built directly inside the CPU to temporarily hold active data, memory addresses, and instructions during processing.","hi":"रजिस्टर CPU के अंदर स्थित बहुत छोटे और अत्यंत तेज़ स्टोरेज लोकेशन्स होते हैं, जो सक्रिय डेटा, एड्रेस और निर्देशों को अस्थायी रूप से (temporarily) होल्ड करते हैं।"},"num":15}]},{"title":{"en":"2. CPU Registers & Types of Processors","hi":"2. सीपीयू रजिस्टर और प्रोसेसर के प्रकार"},"questions":[{"id":"q16","q":{"en":"What does the Program Counter (PC) register hold?","hi":"प्रोग्राम काउंटर (Program Counter - PC) रजिस्टर में क्या होता है?"},"a":{"en":"The address of the next instruction to be executed","hi":"निष्पादित होने वाले अगले निर्देश (Next instruction) का एड्रेस"},"o":[{"en":"The total number of programs installed on the hard disk","hi":"हार्ड डिस्क पर इंस्टॉल किए गए कुल प्रोग्रामों की संख्या"},{"en":"The address of the next instruction to be executed","hi":"निष्पादित होने वाले अगले निर्देश (Next instruction) का एड्रेस"},{"en":"The permanent serial number of the computer monitor","hi":"कंप्यूटर मॉनिटर का स्थायी सीरियल नंबर"},{"en":"The electric voltage level of the power supply unit","hi":"पावर सप्लाई यूनिट का इलेक्ट्रिक वोल्टेज स्तर"}],"exp":{"en":"The Program Counter (PC) is a special-purpose CPU register that holds the memory address of the next instruction to be fetched and executed.","hi":"प्रोग्राम काउंटर (PC) में निष्पादित किए जाने वाले अगले निर्देश का पता (address of the next instruction) होता है।"},"num":16},{"id":"q17","q":{"en":"What does the Memory Address Register (MAR) hold?","hi":"मेमोरी एड्रेस रजिस्टर (Memory Address Register - MAR) क्या होल्ड करता है?"},"a":{"en":"The address of the memory location from which data is to be read or to which data is to be written","hi":"उस मेमोरी लोकेशन का एड्रेस जहाँ से डेटा रीड (read) करना है या जहाँ राइट (write) करना है"},"o":[{"en":"The IP address of an external Wi-Fi router","hi":"बाहरी वाई-फाई राउटर का आईपी एड्रेस"},{"en":"The address of the memory location from which data is to be read or to which data is to be written","hi":"उस मेमोरी लोकेशन का एड्रेस जहाँ से डेटा रीड (read) करना है या जहाँ राइट (write) करना है"},{"en":"Only the final audio output sent to the headphones","hi":"केवल हेडफ़ोन को भेजा जाने वाला अंतिम ऑडियो आउटपुट"},{"en":"The physical postal address of the computer manufacturer","hi":"कंप्यूटर निर्माता का भौतिक डाक पता"}],"exp":{"en":"The Memory Address Register (MAR) holds the address of the active memory location from which data/instruction is to be read or to which data is to be written.","hi":"मेमोरी एड्रेस रजिस्टर (MAR) उस मेमोरी लोकेशन का पता (address) होल्ड करता है जहाँ से रीड करना है या जहाँ राइट करना है।"},"num":17},{"id":"q18","q":{"en":"What does the Memory Buffer Register (MBR) hold, and what is its other common name?","hi":"मेमोरी बफर रजिस्टर (MBR) क्या होल्ड करता है और इसे अन्य किस नाम से जाना जाता है?"},"a":{"en":"It holds the data read from or being written to memory; it is also called the Memory Data Register (MDR)","hi":"यह मेमोरी से आया या मेमोरी को भेजा जा रहा डेटा होल्ड करता है; इसे मेमोरी डेटा रजिस्टर (MDR) भी कहते हैं"},"o":[{"en":"It holds the data read from or being written to memory; it is also called the Memory Data Register (MDR)","hi":"यह मेमोरी से आया या मेमोरी को भेजा जा रहा डेटा होल्ड करता है; इसे मेमोरी डेटा रजिस्टर (MDR) भी कहते हैं"},{"en":"It holds the mouse scroll speed; also called Mouse Button Register","hi":"यह माउस की स्क्रॉल गति रखता है; इसे माउस बटन रजिस्टर भी कहते हैं"},{"en":"It holds only the BIOS password; also called Master Boot Record","hi":"यह केवल BIOS पासवर्ड रखता है; इसे मास्टर बूट रिकॉर्ड भी कहते हैं"},{"en":"It holds printer ink levels; also called Mechanical Buffer Roller","hi":"यह प्रिंटर की स्याही का स्तर रखता है; इसे मैकेनिकल बफर रोलर भी कहते हैं"}],"exp":{"en":"The Memory Buffer Register (MBR), also known as the Memory Data Register (MDR), temporarily holds the actual data or word being transferred to or from main memory.","hi":"मेमोरी बफर रजिस्टर (MBR) मेमोरी से आया या मेमोरी को भेजा जा रहा डेटा होल्ड करता है। इसे मेमोरी डेटा रजिस्टर (Memory Data Register - MDR) भी कहते हैं।"},"num":18},{"id":"q19","q":{"en":"What is stored in the Instruction Register (IR)?","hi":"इंस्ट्रक्शन रजिस्टर (Instruction Register - IR) में क्या रहता है?"},"a":{"en":"The current instruction that the CPU is decoding or executing","hi":"वर्तमान निर्देश (Current instruction), जिसे CPU डिकोड या एक्जीक्यूट कर रहा है"},"o":[{"en":"The current instruction that the CPU is decoding or executing","hi":"वर्तमान निर्देश (Current instruction), जिसे CPU डिकोड या एक्जीक्यूट कर रहा है"},{"en":"A list of all deleted files in the Recycle Bin","hi":"रीसायकल बिन में मौजूद सभी हटाई गई फ़ाइलों की सूची"},{"en":"Only the address of the last sector on a hard disk","hi":"हार्ड डिस्क के अंतिम सेक्टर का केवल पता"},{"en":"Infrared signals received from a television remote","hi":"टेलीविजन रिमोट से प्राप्त इन्फ्रारेड सिग्नल"}],"exp":{"en":"The Instruction Register (IR) holds the current instruction that has just been fetched from memory and is currently being decoded or executed by the CPU.","hi":"इंस्ट्रक्शन रजिस्टर (IR) में वर्तमान निर्देश (current instruction) रहता है, जिसे CPU डिकोड या एक्जीक्यूट कर रहा होता है।"},"num":19},{"id":"q20","q":{"en":"How do you easily distinguish between MAR and MBR (MDR) in exams?","hi":"परीक्षा में MAR और MBR (MDR) के बीच आसानी से कैसे अंतर करें?"},"a":{"en":"MAR tells 'where to go' (memory address), whereas MBR holds 'what is being transferred' (data)","hi":"MAR बताता है 'कहाँ जाना है' (एड्रेस), जबकि MBR होल्ड करता है 'क्या ट्रांसफर हो रहा है' (डेटा)"},"o":[{"en":"MAR is an output monitor, while MBR is an input keyboard","hi":"MAR एक आउटपुट मॉनिटर है, जबकि MBR एक इनपुट कीबोर्ड है"},{"en":"MAR tells 'where to go' (memory address), whereas MBR holds 'what is being transferred' (data)","hi":"MAR बताता है 'कहाँ जाना है' (एड्रेस), जबकि MBR होल्ड करता है 'क्या ट्रांसफर हो रहा है' (डेटा)"},{"en":"MAR stores permanent files on DVD, while MBR cools the CPU","hi":"MAR डीवीडी पर स्थायी फ़ाइलें रखता है, जबकि MBR सीपीयू को ठंडा करता है"},{"en":"Both hold only the next instruction's opcode without any address or data","hi":"दोनों बिना किसी एड्रेस या डेटा के केवल अगले निर्देश का ऑपकोड रखते हैं"}],"exp":{"en":"To distinguish them easily: MAR (Memory Address Register) specifies 'where to go' (the target memory location address), while MBR/MDR specifies 'what is being transferred' (the actual data).","hi":"MAR और MBR में अंतर करने का सरल नियम: MAR बताता है कि मेमोरी में 'कहाँ जाना है' (एड्रेस), जबकि MBR होल्ड करता है कि 'क्या ट्रांसफर हो रहा है' (डेटा)।"},"num":20},{"id":"q21","q":{"en":"How many processing cores are present in a single-core processor?","hi":"सिंगल-कोर प्रोसेसर (Single-core processor) में कितने प्रोसेसिंग कोर होते हैं?"},"a":{"en":"One (1)","hi":"एक (1)"},"o":[{"en":"Four (4)","hi":"चार (4)"},{"en":"Two (2)","hi":"दो (2)"},{"en":"One (1)","hi":"एक (1)"},{"en":"Eight (8)","hi":"आठ (8)"}],"exp":{"en":"A single-core processor has exactly one (1) central processing core on the processor chip to execute instructions.","hi":"सिंगल-कोर प्रोसेसर में केवल एक (1) प्रोसेसिंग कोर होता है।"},"num":21},{"id":"q22","q":{"en":"What is meant by 'Dual-core' and 'Quad-core' processors?","hi":"'डुअल-कोर' (Dual-core) और 'क्वाड-कोर' (Quad-core) प्रोसेसर का क्या अर्थ है?"},"a":{"en":"2 and 4 processing cores integrated on a single processor chip respectively","hi":"एक प्रोसेसर चिप में क्रमशः 2 और 4 प्रोसेसिंग कोर होना"},"o":[{"en":"2 and 4 external monitors connected to a PC respectively","hi":"एक पीसी से जुड़े क्रमशः 2 और 4 बाहरी मॉनिटर"},{"en":"2 and 4 processing cores integrated on a single processor chip respectively","hi":"एक प्रोसेसर चिप में क्रमशः 2 और 4 प्रोसेसिंग कोर होना"},{"en":"2 and 4 power supply units inside a cabinet","hi":"एक कैबिनेट के अंदर 2 और 4 पावर सप्लाई यूनिट"},{"en":"2 and 4 keyboards attached to a server","hi":"एक सर्वर से जुड़े 2 और 4 कीबोर्ड"}],"exp":{"en":"Dual-core and quad-core mean that a single physical processor chip contains 2 independent processing cores and 4 independent processing cores, respectively.","hi":"डुअल-कोर और क्वाड-कोर का अर्थ एक ही प्रोसेसर चिप में क्रमशः 2 और 4 प्रोसेसिंग कोर (cores) होना है।"},"num":22},{"id":"q23","q":{"en":"What is the difference between a multi-core processor and a multiprocessor system?","hi":"मल्टी-कोर प्रोसेसर (Multi-core) और मल्टीप्रोसेसर सिस्टम (Multiprocessor system) में क्या फर्क है?"},"a":{"en":"Multi-core has multiple cores on a single chip, whereas a multiprocessor system has multiple separate CPUs working together","hi":"मल्टी-कोर में एक ही चिप पर कई कोर होते हैं, जबकि मल्टीप्रोसेसर सिस्टम में कई अलग-अलग CPU मिलकर काम करते हैं"},"o":[{"en":"Multi-core has multiple cores on a single chip, whereas a multiprocessor system has multiple separate CPUs working together","hi":"मल्टी-कोर में एक ही चिप पर कई कोर होते हैं, जबकि मल्टीप्रोसेसर सिस्टम में कई अलग-अलग CPU मिलकर काम करते हैं"},{"en":"Multi-core uses vacuum tubes, while multiprocessor uses only abacus beads","hi":"मल्टी-कोर वैक्यूम ट्यूब का उपयोग करता है, जबकि मल्टीप्रोसेसर केवल अबेकस मोतियों का उपयोग करता है"},{"en":"There is no difference; both mean a single-core processor with two mice","hi":"कोई अंतर नहीं है; दोनों का अर्थ दो माउस वाला सिंगल-कोर प्रोसेसर है"},{"en":"Multi-core is an input device, while multiprocessor is a printer","hi":"मल्टी-कोर एक इनपुट डिवाइस है, जबकि मल्टीप्रोसेसर एक प्रिंटर है"}],"exp":{"en":"In a multi-core processor, multiple processing cores are integrated onto a single CPU chip. In a multiprocessor system, two or more separate CPUs (chips) work together in the same computer system.","hi":"मल्टी-कोर में एक ही प्रोसेसर चिप पर कई कोर होते हैं, जबकि मल्टीप्रोसेसर सिस्टम में कई CPUs मिलकर एक साथ काम करते हैं।"},"num":23}]},{"title":{"en":"3. Input/Output & Special Input Readers","hi":"3. इनपुट/आउटपुट और विशेष इनपुट रीडर्स"},"questions":[{"id":"q24","q":{"en":"What is the primary function of an Input Device, and which of the following are its examples?","hi":"इनपुट डिवाइस (Input Device) का मुख्य काम क्या है और इसके उदाहरण कौन-से हैं?"},"a":{"en":"To send data from the user or environment to the computer; examples: Keyboard, mouse, joystick, barcode reader, scanner","hi":"यूज़र या वातावरण से डेटा कंप्यूटर तक पहुँचाना; उदाहरण: कीबोर्ड, माउस, जॉयस्टिक, बारकोड रीडर और स्कैनर"},"o":[{"en":"To print hard copies; examples: Plotter, Inkjet printer, Speaker","hi":"हार्ड कॉपी प्रिंट करना; उदाहरण: प्लॉटर, इंकजेट प्रिंटर, स्पीकर"},{"en":"To send data from the user or environment to the computer; examples: Keyboard, mouse, joystick, barcode reader, scanner","hi":"यूज़र या वातावरण से डेटा कंप्यूटर तक पहुँचाना; उदाहरण: कीबोर्ड, माउस, जॉयस्टिक, बारकोड रीडर और स्कैनर"},{"en":"To supply backup battery power; examples: UPS, Inverter, Stabilizer","hi":"बैकअप बैटरी पावर देना; उदाहरण: यूपीएस, इन्वर्टर, स्टेबलाइजर"},{"en":"To execute arithmetic instructions inside the CPU; examples: ALU, CU, MAR","hi":"CPU के अंदर अंकगणितीय निर्देश चलाना; उदाहरण: ALU, CU, MAR"}],"exp":{"en":"An input device captures data and instructions from the user or external environment and sends them to the computer. Examples include keyboard, mouse, joystick, barcode reader, and scanner.","hi":"इनपुट डिवाइस का काम यूज़र या वातावरण से डेटा को कंप्यूटर तक पहुँचाना है। कीबोर्ड, माउस, जॉयस्टिक, बारकोड रीडर और स्कैनर इसके प्रमुख उदाहरण हैं।"},"num":24},{"id":"q25","q":{"en":"What does an Output Device do, and which of the following are its examples?","hi":"आउटपुट डिवाइस (Output Device) क्या करता है और इसके उदाहरण कौन-से हैं?"},"a":{"en":"Displays or presents the processed result to the user (visually or audibly); examples: Monitor, printer, speakers, headphones","hi":"प्रोसेस किए गए परिणाम को यूज़र को दिखाता या सुनाता है; उदाहरण: मॉनिटर, प्रिंटर, स्पीकर और हेडफ़ोन"},"o":[{"en":"Displays or presents the processed result to the user (visually or audibly); examples: Monitor, printer, speakers, headphones","hi":"प्रोसेस किए गए परिणाम को यूज़र को दिखाता या सुनाता है; उदाहरण: मॉनिटर, प्रिंटर, स्पीकर और हेडफ़ोन"},{"en":"Scans filled bubbles on exam sheets; examples: OMR, MICR, BCR","hi":"परीक्षा शीट पर भरे गए गोले स्कैन करता है; उदाहरण: OMR, MICR, BCR"},{"en":"Temporarily holds the next instruction address inside the CPU; example: Program Counter","hi":"CPU के अंदर अगले निर्देश का पता रखता है; उदाहरण: प्रोग्राम काउंटर"},{"en":"Captures hand-drawn strokes from a stylus; example: Pen tablet","hi":"स्टाइलस से हाथ से बने स्ट्रोक कैप्चर करता है; उदाहरण: पेन टैबलेट"}],"exp":{"en":"An output device receives processed data from the computer and presents it to the user in a human-readable or audible form. Common examples are monitor, printer, speakers, and headphones.","hi":"आउटपुट डिवाइस प्रोसेस किए गए परिणाम (processed result) को यूज़र को दिखाता या सुनाता है। मॉनिटर, प्रिंटर, स्पीकर और हेडफ़ोन इसके उदाहरण हैं।"},"num":25},{"id":"q26","q":{"en":"What are 'Peripheral Devices' in a computer system?","hi":"कंप्यूटर सिस्टम में 'पेरिफेरल डिवाइसेस' (Peripheral Devices) कौन-से होते हैं?"},"a":{"en":"I/O and other external/attached devices working with the computer, such as keyboard, mouse, and printer","hi":"कंप्यूटर के साथ काम करने वाले I/O और अन्य जुड़े हुए (attached) डिवाइसेस, जैसे कीबोर्ड, माउस और प्रिंटर"},"o":[{"en":"Internal CPU registers like MAR, MBR, and IR","hi":"आंतरिक सीपीयू रजिस्टर जैसे MAR, MBR और IR"},{"en":"I/O and other external/attached devices working with the computer, such as keyboard, mouse, and printer","hi":"कंप्यूटर के साथ काम करने वाले I/O और अन्य जुड़े हुए (attached) डिवाइसेस, जैसे कीबोर्ड, माउस और प्रिंटर"},{"en":"Only programming languages like C, C++, and Java","hi":"केवल C, C++ और Java जैसी प्रोग्रामिंग भाषाएँ"},{"en":"Logic gates inside the Arithmetic Logic Unit","hi":"अरिथमेटिक लॉजिक यूनिट के अंदर के लॉजिक गेट्स"}],"exp":{"en":"Peripheral devices are input/output (I/O) and auxiliary devices connected to the computer system to add functionality, such as a keyboard, mouse, monitor, and printer.","hi":"कंप्यूटर के साथ जुड़कर काम करने वाले इनपुट/आउटपुट (I/O) और अन्य अटैच्ड उपकरणों को पेरिफेरल डिवाइसेस कहते हैं; कीबोर्ड, माउस और प्रिंटर इसके सामान्य उदाहरण हैं।"},"num":26},{"id":"q27","q":{"en":"How do I/O devices act as an interface between the user and the machine?","hi":"I/O डिवाइसेस यूज़र और मशीन के बीच इंटरफेस (Interface) कैसे बनते हैं?"},"a":{"en":"By converting user input into machine-readable signals and converting computer output into usable forms like screen display, audio, or print","hi":"यूज़र के इनपुट को मशीन-रीडेबल सिग्नल में और कंप्यूटर के आउटपुट को स्क्रीन, ऑडियो या प्रिंट जैसे उपयोगी रूप में बदलकर"},"o":[{"en":"By converting user input into machine-readable signals and converting computer output into usable forms like screen display, audio, or print","hi":"यूज़र के इनपुट को मशीन-रीडेबल सिग्नल में और कंप्यूटर के आउटपुट को स्क्रीन, ऑडियो या प्रिंट जैसे उपयोगी रूप में बदलकर"},{"en":"By replacing the CPU and RAM with mechanical gears","hi":"CPU और RAM को यांत्रिक गियर से बदलकर"},{"en":"By translating high-level C++ code directly into silicon wafers","hi":"उच्च-स्तरीय C++ कोड को सीधे सिलिकॉन वेफर्स में अनुवादित करके"},{"en":"By cooling down the motherboard using liquid nitrogen","hi":"लिक्विड नाइट्रोजन का उपयोग करके मदरबोर्ड को ठंडा करके"}],"exp":{"en":"I/O devices bridge the gap between humans and computers by converting human input into machine-readable binary signals and translating processed machine data into screen visuals, audio, or printed pages.","hi":"I/O डिवाइसेस यूज़र के इनपुट को मशीन-रीडेबल सिग्नल में और कंप्यूटर के आउटपुट को स्क्रीन, ऑडियो या प्रिंट जैसे मानव-उपयोगी रूप (usable form) में बदलकर इंटरफेस का काम करते हैं।"},"num":27},{"id":"q28","q":{"en":"What does the CPU do in 'Programmed I/O'?","hi":"'प्रोग्राम्ड I/O' (Programmed I/O) में CPU क्या करता है?"},"a":{"en":"The CPU continuously checks (polls) the readiness of the device, which consumes CPU time in busy-waiting","hi":"CPU डिवाइस की तत्परता (readiness) को लगातार चेक करता रहता है, जिससे बिजी-वेट/पोलिंग (polling) में CPU का समय लगता है"},"o":[{"en":"The CPU continuously checks (polls) the readiness of the device, which consumes CPU time in busy-waiting","hi":"CPU डिवाइस की तत्परता (readiness) को लगातार चेक करता रहता है, जिससे बिजी-वेट/पोलिंग (polling) में CPU का समय लगता है"},{"en":"The CPU shuts down permanently while the printer transfers data to the monitor","hi":"जब प्रिंटर मॉनिटर को डेटा ट्रांसफर करता है तो CPU स्थायी रूप से बंद हो जाता है"},{"en":"The DMA controller transfers all data without the CPU checking any status","hi":"DMA कंट्रोलर बिना CPU द्वारा कोई स्टेटस चेक किए सारा डेटा ट्रांसफर करता है"},{"en":"The device sends a hardware interrupt signal so the CPU never checks status","hi":"डिवाइस हार्डवेयर इंटरप्ट सिग्नल भेजता है जिससे CPU कभी स्टेटस चेक नहीं करता"}],"exp":{"en":"In Programmed I/O, the CPU stays in a loop continuously polling (checking) the I/O device's status register to see if it is ready, wasting valuable CPU cycles in busy-waiting.","hi":"प्रोग्राम्ड I/O में CPU डिवाइस की रेडीनेस (readiness) को बार-बार चेक करता रहता है। इस बिजी-वेट या पोलिंग (busy-wait/polling) में CPU का काफी समय खर्च होता है।"},"num":28},{"id":"q29","q":{"en":"When does an I/O device send a signal to the CPU in 'Interrupt-driven I/O'?","hi":"'इंटरप्ट-ड्रिवन I/O' (Interrupt-driven I/O) में डिवाइस CPU को कब सिग्नल देता है?"},"a":{"en":"When the device is ready or when an event/data transfer is completed, it sends an interrupt signal to the CPU","hi":"जब डिवाइस तैयार (ready) हो या कोई इवेंट/ट्रांसफर पूरा हो जाए, तब वह CPU को इंटरप्ट सिग्नल देता है"},"o":[{"en":"Every microsecond even when the device is turned off","hi":"हर माइक्रोसेकंड में, भले ही डिवाइस बंद हो"},{"en":"When the device is ready or when an event/data transfer is completed, it sends an interrupt signal to the CPU","hi":"जब डिवाइस तैयार (ready) हो या कोई इवेंट/ट्रांसफर पूरा हो जाए, तब वह CPU को इंटरप्ट सिग्नल देता है"},{"en":"Only when the computer is unplugged from the wall socket","hi":"केवल तभी जब कंप्यूटर को दीवार के सॉकेट से निकाला जाता है"},{"en":"Never; the CPU must poll the device continuously","hi":"कभी नहीं; CPU को लगातार डिवाइस को पोल करना पड़ता है"}],"exp":{"en":"In Interrupt-driven I/O, the CPU does not busy-wait; instead, the I/O device sends an interrupt signal to the CPU only when it becomes ready for service or completes an operation/transfer.","hi":"इंटरप्ट-ड्रिवन I/O में जब डिवाइस रेडी (ready) होता है या कोई इवेंट/डेटा ट्रांसफर पूरा हो जाता है, तब वह CPU को इंटरप्ट सिग्नल (interrupt signal) भेजता है।"},"num":29},{"id":"q30","q":{"en":"What is the full form and function of DMA?","hi":"DMA का पूर्ण रूप (Full Form) और मुख्य कार्य क्या है?"},"a":{"en":"Direct Memory Access — The DMA controller transfers data directly between the I/O device and memory, while the CPU handles setup and completion","hi":"डायरेक्ट मेमोरी एक्सेस — DMA कंट्रोलर डिवाइस और मेमोरी के बीच सीधे डेटा ट्रांसफर करता है, जबकि CPU सेटअप और समापन संभालता है"},"o":[{"en":"Direct Memory Access — The DMA controller transfers data directly between the I/O device and memory, while the CPU handles setup and completion","hi":"डायरेक्ट मेमोरी एक्सेस — DMA कंट्रोलर डिवाइस और मेमोरी के बीच सीधे डेटा ट्रांसफर करता है, जबकि CPU सेटअप और समापन संभालता है"},{"en":"Digital Mouse Adapter — It connects an optical mouse to a CRT monitor","hi":"डिजिटल माउस एडेप्टर — यह ऑप्टिकल माउस को CRT मॉनिटर से जोड़ता है"},{"en":"Dual Monitor Array — It duplicates the desktop screen across two projectors","hi":"डुअल मॉनिटर ऐरे — यह दो प्रोजेक्टरों पर डेस्कटॉप स्क्रीन की नकल करता है"},{"en":"Dynamic Magnetic Arithmetic — It performs division inside the ALU","hi":"डायनेमिक मैग्नेटिक अरिथमेटिक — यह ALU के अंदर भाग की क्रिया करता है"}],"exp":{"en":"DMA stands for Direct Memory Access. A dedicated DMA controller transfers blocks of data directly between an I/O device and main memory without continuous CPU intervention (the CPU only initiates setup and handles completion).","hi":"DMA का पूर्ण रूप Direct Memory Access है। इसमें DMA कंट्रोलर डिवाइस और मेमोरी के बीच सीधे डेटा ट्रांसफर करता है, जबकि CPU केवल शुरुआती सेटअप और ट्रांसफर पूरा होने (completion) की प्रक्रिया संभालता है।"},"num":30},{"id":"q31","q":{"en":"What is the full form and primary use of OMR?","hi":"OMR का पूर्ण रूप (Full Form) और उपयोग क्या है?"},"a":{"en":"Optical Mark Recognition — It detects filled marks at predefined positions on a form, such as exam answer-sheet bubbles","hi":"ऑप्टिकल मार्क रिकग्निशन — यह फॉर्म की पूर्व-निर्धारित स्थितियों पर भरे गए निशानों (जैसे परीक्षा ओएमआर शीट के बबल्स) की पहचान करता है"},"o":[{"en":"Optical Mark Recognition — It detects filled marks at predefined positions on a form, such as exam answer-sheet bubbles","hi":"ऑप्टिकल मार्क रिकग्निशन — यह फॉर्म की पूर्व-निर्धारित स्थितियों पर भरे गए निशानों (जैसे परीक्षा ओएमआर शीट के बबल्स) की पहचान करता है"},{"en":"Optical Magnetic Reader — It reads magnetic ink characters on bank cheques","hi":"ऑप्टिकल मैग्नेटिक रीडर — यह बैंक चेक पर चुंबकीय स्याही के अक्षरों को पढ़ता है"},{"en":"Output Monitor Resolution — It measures the pixel density of an LED screen","hi":"आउटपुट मॉनिटर रेजोल्यूशन — यह एलईडी स्क्रीन के पिक्सेल घनत्व को मापता है"},{"en":"Online Memory Register — It stores cloud passwords inside the ALU","hi":"ऑनलाइन मेमोरी रजिस्टर — यह ALU के अंदर क्लाउड पासवर्ड संग्रहीत करता है"}],"exp":{"en":"OMR stands for Optical Mark Recognition (or Reader). It is used to detect shaded/filled pencil or pen marks at predefined positions on forms, most notably multiple-choice exam answer sheets.","hi":"OMR का पूर्ण रूप Optical Mark Recognition है। यह किसी फॉर्म की पूर्व-निर्धारित जगहों (predefined positions) पर भरे गए निशानों—जैसे परीक्षा की उत्तर-पुस्तिका के गोलों (bubbles)—को डिटेक्ट करता है।"},"num":31},{"id":"q32","q":{"en":"What is the full form and primary application of MICR?","hi":"MICR का पूर्ण रूप (Full Form) और मुख्य उपयोग क्या है?"},"a":{"en":"Magnetic Ink Character Recognition — Used in banks to read characters printed with magnetic ink on cheques","hi":"मैग्नेटिक इंक कैरेक्टर रिकग्निशन — बैंक चेक पर चुंबकीय स्याही (magnetic ink) से छपे अक्षरों को पढ़ने में उपयोग होता है"},"o":[{"en":"Multiple Input Character Reader — Used for scanning QR codes on grocery items","hi":"मल्टीपल इनपुट कैरेक्टर रीडर — किराने की वस्तुओं पर QR कोड स्कैन करने के लिए"},{"en":"Magnetic Ink Character Recognition — Used in banks to read characters printed with magnetic ink on cheques","hi":"मैग्नेटिक इंक कैरेक्टर रिकग्निशन — बैंक चेक पर चुंबकीय स्याही (magnetic ink) से छपे अक्षरों को पढ़ने में उपयोग होता है"},{"en":"Mechanical Inkjet Colour Roller — Used for printing colour photographs","hi":"मैकेनिकल इंकजेट कलर रोलर — रंगीन तस्वीरें प्रिंट करने के लिए"},{"en":"Micro Integrated Core Register — Used for storing ALU status flags","hi":"माइक्रो इंटीग्रेटेड कोर रजिस्टर — ALU स्टेटस फ्लैग्स स्टोर करने के लिए"}],"exp":{"en":"MICR stands for Magnetic Ink Character Recognition. It is widely used in the banking industry to read the cheque number and bank codes printed with special magnetic ink (iron oxide) at the bottom of bank cheques.","hi":"MICR का पूर्ण रूप Magnetic Ink Character Recognition है। इसका उपयोग बैंकों में चेक (cheques) पर चुंबकीय स्याही (magnetic ink) से छपे अक्षरों और कोड को पढ़ने में किया जाता है।"},"num":32},{"id":"q33","q":{"en":"What is the full form and function of BCR?","hi":"BCR का पूर्ण रूप (Full Form) और कार्य क्या है?"},"a":{"en":"Bar Code Reader — It scans barcodes and decodes the encoded product/item information","hi":"बार कोड रीडर — यह बारकोड को स्कैन करके उसमें एनकोड की गई जानकारी को डिकोड करता है"},"o":[{"en":"Binary Cache Register — It holds binary bits inside the Control Unit","hi":"बाइनरी कैश रजिस्टर — यह कंट्रोल यूनिट के अंदर बाइनरी बिट्स रखता है"},{"en":"Basic Card Reader — It punches holes into 1890 census paper cards","hi":"बेसिक कार्ड रीडर — यह 1890 की जनगणना के पेपर कार्डों में छेद करता है"},{"en":"Bar Code Reader — It scans barcodes and decodes the encoded product/item information","hi":"बार कोड रीडर — यह बारकोड को स्कैन करके उसमें एनकोड की गई जानकारी को डिकोड करता है"},{"en":"Bluetooth Connection Router — It provides wireless internet to laptops","hi":"ब्लूटूथ कनेक्शन राउटर — यह लैपटॉप को वायरलेस इंटरनेट प्रदान करता है"}],"exp":{"en":"BCR stands for Bar Code Reader (or Scanner). It optically scans printed parallel bars (barcodes) and decodes the encoded product or inventory information into digital data.","hi":"BCR का पूर्ण रूप Bar Code Reader है। यह बारकोड को स्कैन करके उसमें एनकोड की गई जानकारी (encoded information) को डिकोड करता है।"},"num":33},{"id":"q34","q":{"en":"What is the full form of 'QR' in QR Code, and what type of pattern does it use to encode data?","hi":"QR कोड में 'QR' का पूर्ण रूप क्या है और यह किस पैटर्न में डेटा एनकोड करता है?"},"a":{"en":"Quick Response — It encodes data in a two-dimensional (2D) matrix pattern","hi":"क्विक रिस्पॉन्स (Quick Response) — यह एक 2D मैट्रिक्स पैटर्न में डेटा एनकोड करता है"},"o":[{"en":"Quick Response — It encodes data in a two-dimensional (2D) matrix pattern","hi":"क्विक रिस्पॉन्स (Quick Response) — यह एक 2D मैट्रिक्स पैटर्न में डेटा एनकोड करता है"},{"en":"Quad Register — It encodes data on a magnetic cassette tape","hi":"क्वाड रजिस्टर — यह चुंबकीय कैसेट टेप पर डेटा एनकोड करता है"},{"en":"Quantum Reader — It uses only 1D vertical iron-oxide lines","hi":"क्वांटम रीडर — यह केवल 1D लंबवत आयरन-ऑक्साइड लाइनों का उपयोग करता है"},{"en":"Query Router — It stores data inside mechanical trackballs","hi":"क्वेरी राउटर — यह यांत्रिक ट्रैकबॉल के अंदर डेटा संग्रहीत करता है"}],"exp":{"en":"QR stands for Quick Response. A QR code encodes information horizontally and vertically in a two-dimensional (2D) matrix pattern of black and white squares.","hi":"QR का पूर्ण रूप Quick Response है। QR कोड एक द्वि-आयामी (2D) मैट्रिक्स पैटर्न में डेटा को एनकोड करता है।"},"num":34},{"id":"q35","q":{"en":"What is the key exam distinction between OMR and OCR?","hi":"परीक्षा की दृष्टि से OMR और OCR में मुख्य अंतर क्या है?"},"a":{"en":"OMR detects the presence of filled marks at predefined positions, whereas OCR converts printed or handwritten characters into machine-readable text","hi":"OMR पूर्व-निर्धारित स्थानों पर भरे गए निशानों को पहचानता है, जबकि OCR छपे या हस्तलिखित अक्षरों को मशीन-रीडेबल टेक्स्ट में बदलता है"},"o":[{"en":"OMR detects the presence of filled marks at predefined positions, whereas OCR converts printed or handwritten characters into machine-readable text","hi":"OMR पूर्व-निर्धारित स्थानों पर भरे गए निशानों को पहचानता है, जबकि OCR छपे या हस्तलिखित अक्षरों को मशीन-रीडेबल टेक्स्ट में बदलता है"},{"en":"OMR is an audio output device, whereas OCR is a video display monitor","hi":"OMR एक ऑडियो आउटपुट डिवाइस है, जबकि OCR एक वीडियो डिस्प्ले मॉनिटर है"},{"en":"OMR reads magnetic ink on cheques, whereas OCR only reads 1D retail barcodes","hi":"OMR चेक पर मैग्नेटिक इंक पढ़ता है, जबकि OCR केवल 1D रिटेल बारकोड पढ़ता है"},{"en":"There is no difference; both only count the number of keys on a keyboard","hi":"कोई अंतर नहीं है; दोनों केवल कीबोर्ड पर कुंजियों की संख्या गिनते हैं"}],"exp":{"en":"OMR (Optical Mark Recognition) detects filled marks/bubbles at fixed positions on a sheet, whereas OCR (Optical Character Recognition) recognizes shapes of printed or handwritten characters and converts them into editable, machine-readable text.","hi":"OMR फॉर्म पर भरे गए निशानों (filled marks/bubbles) की स्थिति पहचानता है, जबकि OCR (Optical Character Recognition) छपे हुए या हाथ से लिखे अक्षरों (characters) को मशीन-रीडेबल टेक्स्ट में बदलता है।"},"num":35}]},{"title":{"en":"4. Keyboard, Pointing & Scanning Devices","hi":"4. कीबोर्ड, पॉइंटिंग और स्कैनिंग उपकरण"},"questions":[{"id":"q36","q":{"en":"Which keys constitute the alphabetic and number keys on a standard keyboard?","hi":"कीबोर्ड में अल्फाबेटिक (Alphabetic) और नंबर कीज़ (Number keys) कौन-सी होती हैं?"},"a":{"en":"Alphabet keys are A–Z and number keys are 0–9","hi":"अल्फाबेट कीज़ A–Z और नंबर कीज़ 0–9 होती हैं"},"o":[{"en":"Alphabet keys are F1–F12 and number keys are Ctrl, Alt, Shift","hi":"अल्फाबेट कीज़ F1–F12 हैं और नंबर कीज़ Ctrl, Alt, Shift हैं"},{"en":"Alphabet keys are A–Z and number keys are 0–9","hi":"अल्फाबेट कीज़ A–Z और नंबर कीज़ 0–9 होती हैं"},{"en":"Alphabet keys are Caps Lock and Num Lock; number keys are arrow keys","hi":"अल्फाबेट कीज़ Caps Lock और Num Lock हैं; नंबर कीज़ एरो कीज़ हैं"},{"en":"Alphabet keys are 0–9 and number keys are Esc, Tab, Enter","hi":"अल्फाबेट कीज़ 0–9 हैं और नंबर कीज़ Esc, Tab, Enter हैं"}],"exp":{"en":"On a keyboard, the alphabetic keys are the letter keys from A to Z, and the numeric (number) keys are the digits from 0 to 9.","hi":"कीबोर्ड में अल्फाबेट कीज़ (Alphabet keys) A से Z तक और नंबर कीज़ (Number keys) 0 से 9 तक होती हैं।"},"num":36},{"id":"q37","q":{"en":"Which of the following correctly lists examples of Function keys, Modifier keys, and Toggle keys?","hi":"फंक्शन (Function), मॉडिफायर (Modifier) और टॉगल (Toggle) कीज़ के सही उदाहरण कौन-से हैं?"},"a":{"en":"Function: F1–F12; Modifier: Ctrl, Alt, Shift; Toggle: Caps Lock, Num Lock, Scroll Lock","hi":"फंक्शन: F1–F12; मॉडिफायर: Ctrl, Alt, Shift; टॉगल: Caps Lock, Num Lock, Scroll Lock"},"o":[{"en":"Function: A–Z; Modifier: 0–9; Toggle: F1–F12","hi":"फंक्शन: A–Z; मॉडिफायर: 0–9; टॉगल: F1–F12"},{"en":"Function: Ctrl/Alt/Shift; Modifier: Caps Lock/Num Lock; Toggle: Spacebar","hi":"फंक्शन: Ctrl/Alt/Shift; मॉडिफायर: Caps Lock/Num Lock; टॉगल: स्पेसबार"},{"en":"Function: F1–F12; Modifier: Ctrl, Alt, Shift; Toggle: Caps Lock, Num Lock, Scroll Lock","hi":"फंक्शन: F1–F12; मॉडिफायर: Ctrl, Alt, Shift; टॉगल: Caps Lock, Num Lock, Scroll Lock"},{"en":"Function: Left/Right click; Modifier: Scroll wheel; Toggle: Trackball","hi":"फंक्शन: लेफ्ट/राइट क्लिक; मॉडिफायर: स्क्रॉल व्हील; टॉगल: ट्रैकबॉल"}],"exp":{"en":"F1–F12 are Function keys (perform special shortcuts), Ctrl/Alt/Shift are Modifier/Combination keys (modify the action of another key), and Caps Lock/Num Lock/Scroll Lock are Toggle keys (switch a feature ON or OFF).","hi":"F1–F12 फंक्शन कीज़ हैं, Ctrl/Alt/Shift मॉडिफायर कीज़ हैं, और Caps Lock, Num Lock तथा Scroll Lock टॉगल कीज़ (जो ऑन/ऑफ स्थिति बदलती हैं) के उदाहरण हैं।"},"num":37},{"id":"q38","q":{"en":"How many keys are typically present on a standard full-size US PC keyboard and its traditional numeric keypad?","hi":"एक मानक फुल-साइज़ पीसी कीबोर्ड और उसके पारंपरिक न्यूमेरिक कीपैड में सामान्यतः कितनी कुंजियाँ (Keys) होती हैं?"},"a":{"en":"104 keys on a common US full-size layout, and 17 keys on a traditional numeric keypad (count may vary by layout/device)","hi":"सामान्य US फुल-साइज़ लेआउट में 104 कीज़, और पारंपरिक न्यूमेरिक कीपैड में 17 कीज़ (लेआउट व डिवाइस के अनुसार संख्या बदल सकती है)"},"o":[{"en":"104 keys on a common US full-size layout, and 17 keys on a traditional numeric keypad (count may vary by layout/device)","hi":"सामान्य US फुल-साइज़ लेआउट में 104 कीज़, और पारंपरिक न्यूमेरिक कीपैड में 17 कीज़ (लेआउट व डिवाइस के अनुसार संख्या बदल सकती है)"},{"en":"Exactly 26 keys in total on a full-size keyboard and 2 keys on the numeric keypad","hi":"फुल-साइज़ कीबोर्ड में कुल 26 कीज़ और न्यूमेरिक कीपैड में 2 कीज़"},{"en":"500 keys on a standard keyboard and 100 keys on the numeric keypad","hi":"मानक कीबोर्ड में 500 कीज़ और न्यूमेरिक कीपैड में 100 कीज़"},{"en":"12 keys in total on a desktop keyboard and 0 keys on the numeric keypad","hi":"डेस्कटॉप कीबोर्ड में कुल 12 कीज़ और न्यूमेरिक कीपैड में 0 कीज़"}],"exp":{"en":"A standard US full-size desktop PC keyboard commonly has 104 keys, and its dedicated numeric keypad typically has 17 keys (though exact key counts can vary depending on regional layout or laptop/compact design).","hi":"सामान्य US फुल-साइज़ कीबोर्ड लेआउट में 104 कीज़ होती हैं, और पारंपरिक न्यूमेरिक कीपैड में 17 कीज़ होती हैं (हालाँकि लेआउट और डिवाइस के हिसाब से संख्या बदल सकती है)।"},"num":38},{"id":"q39","q":{"en":"What is the primary difference between an Optical Mouse and a traditional Mechanical Mouse?","hi":"ऑप्टिकल माउस (Optical Mouse) और पारंपरिक मैकेनिकल माउस (Mechanical Mouse) में मुख्य अंतर क्या है?"},"a":{"en":"An optical mouse detects movement using a light sensor (LED/laser), whereas a traditional mechanical mouse uses a physical rolling ball on its underside","hi":"ऑप्टिकल माउस लाइट सेंसर से गति (motion) डिटेक्ट करता है, जबकि पारंपरिक मैकेनिकल माउस नीचे लगी रोलिंग बॉल का उपयोग करता है"},"o":[{"en":"An optical mouse detects movement using a light sensor (LED/laser), whereas a traditional mechanical mouse uses a physical rolling ball on its underside","hi":"ऑप्टिकल माउस लाइट सेंसर से गति (motion) डिटेक्ट करता है, जबकि पारंपरिक मैकेनिकल माउस नीचे लगी रोलिंग बॉल का उपयोग करता है"},{"en":"An optical mouse uses a rubber ball, whereas a mechanical mouse uses an optical laser beam","hi":"ऑप्टिकल माउस रबर बॉल का उपयोग करता है, जबकि मैकेनिकल माउस ऑप्टिकल लेजर बीम का उपयोग करता है"},{"en":"An optical mouse is an audio output device, while a mechanical mouse is a printer","hi":"ऑप्टिकल माउस एक ऑडियो आउटपुट डिवाइस है, जबकि मैकेनिकल माउस एक प्रिंटर है"},{"en":"Both use magnetic ink characters to move the screen cursor","hi":"दोनों स्क्रीन कर्सर को घुमाने के लिए मैग्नेटिक इंक अक्षरों का उपयोग करते हैं"}],"exp":{"en":"An optical mouse uses an optical light source (LED or laser) and a light sensor (photodiode/CMOS sensor) to track surface movement, whereas a traditional mechanical mouse relies on a rubber/metal rolling ball that turns internal rollers.","hi":"ऑप्टिकल माउस लाइट सेंसर (light sensor) की मदद से मोशन डिटेक्ट करता है, जबकि पारंपरिक मैकेनिकल माउस में नीचे घूमने वाली रोलिंग बॉल (rolling ball) का उपयोग होता है।"},"num":39},{"id":"q40","q":{"en":"How do you distinguish a Trackball from a regular Mouse?","hi":"ट्रैकबॉल (Trackball) को सामान्य माउस से कैसे पहचानेंगे (दोनों में क्या अंतर है)?"},"a":{"en":"In a trackball, the base remains stationary on the desk and the user rotates a visible exposed ball with fingers/thumb to move the pointer","hi":"ट्रैकबॉल में बेस एक जगह स्थिर (stationary) रहता है और यूज़र ऊपर दिखने वाली बॉल को उँगलियों/अंगूठे से घुमाकर पॉइंटर मूव करता है"},"o":[{"en":"In a trackball, the base remains stationary on the desk and the user rotates a visible exposed ball with fingers/thumb to move the pointer","hi":"ट्रैकबॉल में बेस एक जगह स्थिर (stationary) रहता है और यूज़र ऊपर दिखने वाली बॉल को उँगलियों/अंगूठे से घुमाकर पॉइंटर मूव करता है"},{"en":"A trackball must be dragged across the entire desk surface while its ball is hidden inside a sealed printer","hi":"ट्रैकबॉल को पूरी मेज पर घसीटना पड़ता है जबकि इसकी बॉल सीलबंद प्रिंटर के अंदर छिपी होती है"},{"en":"A trackball has 104 alphabet keys and no ball at all","hi":"ट्रैकबॉल में 104 अल्फाबेट कीज़ होती हैं और कोई बॉल नहीं होती"},{"en":"A trackball is used only to scan bank cheques using magnetic ink","hi":"ट्रैकबॉल का उपयोग केवल चुंबकीय स्याही से बैंक चेक स्कैन करने के लिए होता है"}],"exp":{"en":"Unlike a regular mouse where the whole device is moved across a flat surface, a trackball stays stationary in one place while the user rolls a prominent exposed ball on top or the side to control the screen pointer.","hi":"ट्रैकबॉल में उसका बेस (आधार) एक जगह स्थिर (stationary) रहता है और यूज़र ऊपर दिखाई देने वाली बॉल (visible ball) को हाथ से घुमाकर स्क्रीन पॉइंटर को मूव करता है।"},"num":40},{"id":"q41","q":{"en":"With which type of display is a traditional Light Pen associated, and how does it work?","hi":"पारंपरिक 'लाइट पेन' (Light Pen) किस प्रकार के डिस्प्ले से जुड़ा है और यह कैसे काम करता है?"},"a":{"en":"Compatible CRT (Cathode Ray Tube) display — It detects light pulses emitted by the screen's scanning electron beam","hi":"संगत CRT (कैथोड रे ट्यूब) डिस्प्ले — यह स्क्रीन के लाइट पल्स (light pulses) को डिटेक्ट करता है"},"o":[{"en":"E-ink paper display — It sprays liquid ink droplets onto the screen","hi":"ई-इंक पेपर डिस्प्ले — यह स्क्रीन पर तरल स्याही की बूँदें स्प्रे करता है"},{"en":"Compatible CRT (Cathode Ray Tube) display — It detects light pulses emitted by the screen's scanning electron beam","hi":"संगत CRT (कैथोड रे ट्यूब) डिस्प्ले — यह स्क्रीन के लाइट पल्स (light pulses) को डिटेक्ट करता है"},{"en":"Non-backlit wooden abacus board — It counts beads magnetically","hi":"गैर-बैकलाइट लकड़ी का अबेकस बोर्ड — यह चुंबकीय रूप से मोतियों को गिनता है"},{"en":"Impact dot-matrix ribbon — It strikes paper with metal pins","hi":"इम्पैक्ट डॉट-मैट्रिक्स रिबन — यह धातु की पिनों से कागज पर प्रहार करता है"}],"exp":{"en":"A traditional light pen is a light-sensitive pointing input device associated with a compatible CRT (Cathode Ray Tube) monitor, where its photodetector senses the timing of light pulses from the scanning electron beam.","hi":"पारंपरिक लाइट पेन (Light Pen) संगत CRT (Cathode Ray Tube) डिस्प्ले से जुड़ा है, जहाँ यह स्क्रीन के लाइट पल्स (light pulses) को डिटेक्ट करके पोजिशन पहचानता है।"},"num":41},{"id":"q42","q":{"en":"What was the primary use of a Light Pen according to the notes?","hi":"नोट्स के अनुसार लाइट पेन (Light Pen) का मुख्य उपयोग क्या था?"},"a":{"en":"Selecting objects or drawing directly on the screen (notes also mention signature input as an example)","hi":"स्क्रीन पर सीधे ऑब्जेक्ट सेलेक्ट करना या ड्रॉइंग बनाना (नोट्स में सिग्नेचर इनपुट का उदाहरण भी दिया गया है)"},"o":[{"en":"Selecting objects or drawing directly on the screen (notes also mention signature input as an example)","hi":"स्क्रीन पर सीधे ऑब्जेक्ट सेलेक्ट करना या ड्रॉइंग बनाना (नोट्स में सिग्नेचर इनपुट का उदाहरण भी दिया गया है)"},{"en":"Printing wide-format vinyl hoardings and banners","hi":"बड़े आकार के विनाइल होर्डिंग और बैनर प्रिंट करना"},{"en":"Cooling the CPU heatsink during heavy calculations","hi":"भारी गणनाओं के दौरान CPU हीटसिंक को ठंडा करना"},{"en":"Reading magnetic iron-oxide ink on bank cheques","hi":"बैंक चेक पर मैग्नेटिक आयरन-ऑक्साइड स्याही को पढ़ना"}],"exp":{"en":"A light pen was used to point, select items, or draw directly on a CRT screen; the study notes also mention signature input as an application example.","hi":"लाइट पेन का उपयोग स्क्रीन पर सीधे सेलेक्शन (selection) करने या ड्रॉइंग बनाने के लिए होता था। नोट्स में इसके उपयोग के रूप में सिग्नेचर इनपुट (signature input) का उदाहरण भी दिया गया है।"},"num":42},{"id":"q43","q":{"en":"What is a 'Stylus' in computer input devices?","hi":"कंप्यूटर इनपुट उपकरणों में 'स्टाइलस' (Stylus) क्या है?"},"a":{"en":"A pen-shaped input tool used to write, draw, or navigate on a compatible touchscreen or graphics tablet","hi":"एक पेन के आकार का इनपुट टूल जिससे संगत टचस्क्रीन या ग्राफिक्स टैबलेट पर लिख या ड्रॉ कर सकते हैं"},"o":[{"en":"A high-speed impact line printer used in banks","hi":"बैंकों में प्रयुक्त एक हाई-स्पीड इम्पैक्ट लाइन प्रिंटर"},{"en":"A pen-shaped input tool used to write, draw, or navigate on a compatible touchscreen or graphics tablet","hi":"एक पेन के आकार का इनपुट टूल जिससे संगत टचस्क्रीन या ग्राफिक्स टैबलेट पर लिख या ड्रॉ कर सकते हैं"},{"en":"A volatile semiconductor memory chip inside the CPU","hi":"CPU के अंदर लगी एक वोलेटाइल सेमीकंडक्टर मेमोरी चिप"},{"en":"A heavy rotating magnetic platter inside a hard disk","hi":"हार्ड डिस्क के अंदर घूमने वाली एक भारी चुंबकीय प्लेट"}],"exp":{"en":"A stylus is a pen-shaped pointing and drawing input instrument used for writing, sketching, or selecting on a compatible touchscreen, pen display, or graphics tablet.","hi":"स्टाइलस (Stylus) एक पेन के आकार का इनपुट टूल (pen-shaped input tool) है, जिसकी मदद से किसी संगत स्क्रीन या ग्राफिक्स टैबलेट पर लिखा या ड्रॉ किया जा सकता है।"},"num":43},{"id":"q44","q":{"en":"What is the primary function of an image/document Scanner?","hi":"स्कैनर (Scanner) का मुख्य कार्य क्या है?"},"a":{"en":"It converts a physical paper document or photograph into a digital image or file","hi":"यह कागजी दस्तावेज़ (paper document) या छवि को डिजिटल इमेज/फ़ाइल में बदलता है"},"o":[{"en":"It converts a physical paper document or photograph into a digital image or file","hi":"यह कागजी दस्तावेज़ (paper document) या छवि को डिजिटल इमेज/फ़ाइल में बदलता है"},{"en":"It converts digital text files into audio sound waves through speakers","hi":"यह स्पीकर के माध्यम से डिजिटल टेक्स्ट फ़ाइलों को ऑडियो ध्वनि तरंगों में बदलता है"},{"en":"It executes arithmetic and logical comparisons inside the processor","hi":"यह प्रोसेसर के अंदर अंकगणितीय और तार्किक तुलनाएँ करता है"},{"en":"It sprays toner powder onto A4 paper using heat rollers","hi":"यह हीट रोलर्स का उपयोग करके A4 कागज पर टोनर पाउडर स्प्रे करता है"}],"exp":{"en":"A scanner is an optical input device that optically scans physical paper documents, photos, or pages and converts them into a digital image or file format for the computer.","hi":"स्कैनर एक इनपुट डिवाइस है जो किसी कागजी दस्तावेज़ (paper document) या तस्वीर को स्कैन करके डिजिटल इमेज या फ़ाइल में परिवर्तित (convert) करता है।"},"num":44},{"id":"q45","q":{"en":"How do Flatbed, Sheet-fed, and Handheld scanners differ from one another?","hi":"फ्लैटबेड (Flatbed), शीट-फेड (Sheet-fed) और हैंडहेल्ड (Handheld) स्कैनर एक-दूसरे से कैसे अलग हैं?"},"a":{"en":"In a flatbed scanner the document is placed on a glass plate, a sheet-fed scanner pulls pages through rollers, and a handheld scanner is manually moved over the page","hi":"फ्लैटबेड में दस्तावेज़ कांच (glass) पर रखते हैं, शीट-फेड पन्नों को अंदर खींचता है, और हैंडहेल्ड स्कैनर को हाथ से पेज पर घुमाते हैं"},"o":[{"en":"In a flatbed scanner the document is placed on a glass plate, a sheet-fed scanner pulls pages through rollers, and a handheld scanner is manually moved over the page","hi":"फ्लैटबेड में दस्तावेज़ कांच (glass) पर रखते हैं, शीट-फेड पन्नों को अंदर खींचता है, और हैंडहेल्ड स्कैनर को हाथ से पेज पर घुमाते हैं"},{"en":"Flatbed is an audio microphone, sheet-fed is a monitor, and handheld is a CPU register","hi":"फ्लैटबेड एक ऑडियो माइक्रोफोन है, शीट-फेड एक मॉनिटर है, और हैंडहेल्ड एक सीपीयू रजिस्टर है"},{"en":"All three are impact printers that use carbon ribbons to strike paper","hi":"तीनों इम्पैक्ट प्रिंटर हैं जो कागज पर प्रहार करने के लिए कार्बन रिबन का उपयोग करते हैं"},{"en":"Flatbed pulls pages, sheet-fed is moved by hand, and handheld uses a stationary 50 kg glass table","hi":"फ्लैटबेड पन्ने खींचता है, शीट-फेड हाथ से घुमाया जाता है, और हैंडहेल्ड में 50 किलो की स्थिर कांच की मेज होती है"}],"exp":{"en":"In a Flatbed scanner, the document lies flat on a glass platen while the sensor moves beneath it; in a Sheet-fed scanner, motorized rollers pull loose pages past a stationary sensor; in a Handheld scanner, the user manually drags the device across the document.","hi":"फ्लैटबेड स्कैनर में दस्तावेज़ को समतल कांच (glass) पर रखा जाता है, शीट-फेड स्कैनर पन्नों को रोलर्स से अंदर खींचता (pull करता) है, और हैंडहेल्ड स्कैनर को हाथ से पकड़कर पेज के ऊपर मूव किया जाता है।"},"num":45},{"id":"q46","q":{"en":"What is the most common use of a 'Joystick'?","hi":"'जॉयस्टिक' (Joystick) का सामान्य उपयोग क्या है?"},"a":{"en":"Controlling direction or movement in video games and flight/driving simulators","hi":"वीडियो गेम्स और सिमुलेटर (simulators) में दिशा या मूवमेंट को नियंत्रित करना"},"o":[{"en":"Controlling direction or movement in video games and flight/driving simulators","hi":"वीडियो गेम्स और सिमुलेटर (simulators) में दिशा या मूवमेंट को नियंत्रित करना"},{"en":"Typing long legal contracts and spreadsheets in office suites","hi":"ऑफिस सुइट्स में लंबे कानूनी अनुबंध और स्प्रेडशीट टाइप करना"},{"en":"Printing high-speed utility bills on thermal paper","hi":"थर्मल पेपर पर हाई-स्पीड यूटिलिटी बिल प्रिंट करना"},{"en":"Storing permanent operating system boot firmware","hi":"स्थायी ऑपरेटिंग सिस्टम बूट फर्मवेयर स्टोर करना"}],"exp":{"en":"A joystick is a pivoting lever input device commonly used to control direction, angle, or movement in video games, flight simulators, and industrial machinery.","hi":"जॉयस्टिक का सामान्य उपयोग वीडियो गेम्स (video games) और सिमुलेटर (simulators) में दिशा (direction) या मूवमेंट को नियंत्रित करने के लिए किया जाता है।"},"num":46},{"id":"q47","q":{"en":"How does a laptop 'Touchpad' (trackpad) use finger motion?","hi":"लैपटॉप का 'टचपैड' (Touchpad) उँगली की गति (Finger motion) का उपयोग कैसे करता है?"},"a":{"en":"Its touch-sensitive surface detects finger movement and gestures to move the screen pointer accordingly","hi":"इसकी टच-सेंसिटिव सतह उँगली की हलचल (movement) को डिटेक्ट करके स्क्रीन पॉइंटर को मूव करती है"},"o":[{"en":"Its touch-sensitive surface detects finger movement and gestures to move the screen pointer accordingly","hi":"इसकी टच-सेंसिटिव सतह उँगली की हलचल (movement) को डिटेक्ट करके स्क्रीन पॉइंटर को मूव करती है"},{"en":"It uses a heavy mechanical rubber ball that rolls across the desk","hi":"यह एक भारी यांत्रिक रबर बॉल का उपयोग करता है जो मेज पर लुढ़कती है"},{"en":"It scans barcodes using an ultraviolet laser beam","hi":"यह पराबैंगनी लेजर बीम का उपयोग करके बारकोड को स्कैन करता है"},{"en":"It converts sound waves into printed paper documents","hi":"यह ध्वनि तरंगों को मुद्रित कागजी दस्तावेज़ों में बदलता है"}],"exp":{"en":"A touchpad (or trackpad) has a flat, touch-sensitive capacitive surface that senses the position and sliding motion of the user's fingers and translates it into corresponding movement of the pointer on the screen.","hi":"टचपैड की स्पर्श-संवेदनशील सतह (touch-sensitive surface) उँगली की मूवमेंट को डिटेक्ट करके स्क्रीन पर पॉइंटर (कर्ज़र) को मूव करती है।"},"num":47},{"id":"q48","q":{"en":"What does a 'Microphone' convert during audio input?","hi":"ऑडियो इनपुट के दौरान 'माइक्रोफोन' (Microphone) किसको किसमें परिवर्तित करता है?"},"a":{"en":"Sound waves into electrical audio signals, which the computer processes as audio input","hi":"ध्वनि तरंगों (Sound waves) को इलेक्ट्रिकल ऑडियो सिग्नल में, जिसे कंप्यूटर ऑडियो इनपुट के तौर पर उपयोग करता है"},"o":[{"en":"Electrical signals into printed ink droplets on paper","hi":"विद्युत संकेतों को कागज पर मुद्रित स्याही की बूँदों में"},{"en":"Sound waves into electrical audio signals, which the computer processes as audio input","hi":"ध्वनि तरंगों (Sound waves) को इलेक्ट्रिकल ऑडियो सिग्नल में, जिसे कंप्यूटर ऑडियो इनपुट के तौर पर उपयोग करता है"},{"en":"Visual light pulses into mechanical hammer strikes","hi":"दृश्य प्रकाश स्पंदनों को यांत्रिक हथौड़े के प्रहारों में"},{"en":"Binary machine code into ultraviolet light for erasing EPROM","hi":"EPROM को मिटाने के लिए बाइनरी मशीन कोड को पराबैंगनी प्रकाश में"}],"exp":{"en":"A microphone is an audio input transducer that converts acoustic sound waves into electrical audio signals, which the computer's sound card digitizes and uses as audio input.","hi":"माइक्रोफोन ध्वनि तरंगों (sound waves) को इलेक्ट्रिकल ऑडियो सिग्नल (electrical audio signal) में बदलता है, जिसे कंप्यूटर ऑडियो इनपुट के तौर पर उपयोग करता है।"},"num":48},{"id":"q49","q":{"en":"What is the primary use of a 'Pen Tablet' (graphics digitizer)?","hi":"'पेन टैबलेट' (Pen Tablet / ग्राफिक्स टैबलेट) का मुख्य उपयोग क्या है?"},"a":{"en":"Creating hand-drawn digital images, graphics, illustrations, and animation using a stylus","hi":"स्टाइलस की मदद से हाथ से बनी डिजिटल इमेज (hand-drawn images), ग्राफिक्स और एनीमेशन तैयार करना"},"o":[{"en":"Creating hand-drawn digital images, graphics, illustrations, and animation using a stylus","hi":"स्टाइलस की मदद से हाथ से बनी डिजिटल इमेज (hand-drawn images), ग्राफिक्स और एनीमेशन तैयार करना"},{"en":"Cooling down dual-core and quad-core processors","hi":"डुअल-कोर और क्वाड-कोर प्रोसेसर को ठंडा करना"},{"en":"Reading magnetic ink characters on bank demand drafts","hi":"बैंक डिमांड ड्राफ्ट पर मैग्नेटिक इंक अक्षरों को पढ़ना"},{"en":"Supplying uninterrupted power during voltage fluctuations","hi":"वोल्टेज के उतार-चढ़ाव के दौरान निर्बाध बिजली की आपूर्ति करना"}],"exp":{"en":"A pen tablet (graphics tablet/digitizer) allows artists and designers to use a pressure-sensitive stylus to create hand-drawn digital illustrations, graphics, photo edits, and animations.","hi":"पेन टैबलेट का उपयोग स्टाइलस (stylus) की सहायता से हाथ से बनी डिजिटल छवियाँ (hand-drawn images), ग्राफिक्स और एनीमेशन बनाने में किया जाता है।"},"num":49}]},{"title":{"en":"5. Monitor, Printers & Plotter","hi":"5. मॉनिटर, प्रिंटर और प्लॉटर"},"questions":[{"id":"q50","q":{"en":"Which of the following is the standard visual output device of a computer?","hi":"कंप्यूटर का मानक विजुअल आउटपुट डिवाइस (Standard Visual Output Device) कौन-सा है?"},"a":{"en":"Monitor (VDU)","hi":"मॉनिटर (Monitor)"},"o":[{"en":"Microphone","hi":"माइक्रोफोन"},{"en":"Monitor (VDU)","hi":"मॉनिटर (Monitor)"},{"en":"Joystick","hi":"जॉयस्टिक"},{"en":"Trackball","hi":"ट्रैकबॉल"}],"exp":{"en":"The Monitor (Visual Display Unit - VDU) is the standard visual output device used to display text, graphics, and video generated by the computer.","hi":"कंप्यूटर का मानक विजुअल आउटपुट डिवाइस मॉनिटर (Monitor) है, जो परिणाम को स्क्रीन पर प्रदर्शित करता है।"},"num":50},{"id":"q51","q":{"en":"What are the correct full forms of the display technologies CRT, TFT, LCD, and LED?","hi":"डिस्प्ले तकनीकों CRT, TFT, LCD और LED के सही पूर्ण रूप (Full Forms) क्या हैं?"},"a":{"en":"Cathode Ray Tube, Thin-Film Transistor, Liquid Crystal Display, and Light-Emitting Diode","hi":"कैथोड रे ट्यूब, थिन-फिल्म ट्रांजिस्टर, लिक्विड क्रिस्टल डिस्प्ले और लाइट-एमिटिंग डायोड"},"o":[{"en":"Cathode Ray Tube, Thin-Film Transistor, Liquid Crystal Display, and Light-Emitting Diode","hi":"कैथोड रे ट्यूब, थिन-फिल्म ट्रांजिस्टर, लिक्विड क्रिस्टल डिस्प्ले और लाइट-एमिटिंग डायोड"},{"en":"Central Register Tube, Thick-Frame Terminal, Linear Colour Display, and Laser Emitting Device","hi":"सेंट्रल रजिस्टर ट्यूब, थिक-फ्रेम टर्मिनल, लीनियर कलर डिस्प्ले और लेजर एमिटिंग डिवाइस"},{"en":"Control Ratio Terminal, Transistor Film Tube, Liquid Cathode Diode, and Light Electronic Display","hi":"कंट्रोल रेशियो टर्मिनल, ट्रांजिस्टर फिल्म ट्यूब, लिक्विड कैथोड डायोड और लाइट इलेक्ट्रॉनिक डिस्प्ले"},{"en":"Colour Ray Transistor, Thin-Fibre Tube, Luminous Crystal Diode, and Low Energy Display","hi":"कलर रे ट्रांजिस्टर, थिन-फाइबर ट्यूब, ल्यूमिनस क्रिस्टल डायोड और लो एनर्जी डिस्प्ले"}],"exp":{"en":"In display technology: CRT = Cathode Ray Tube, TFT = Thin-Film Transistor, LCD = Liquid Crystal Display, and LED = Light-Emitting Diode.","hi":"CRT = Cathode Ray Tube, TFT = Thin-Film Transistor, LCD = Liquid Crystal Display, और LED = Light-Emitting Diode हैं।"},"num":51},{"id":"q52","q":{"en":"How are the display terms TFT, LCD, and LED related in common computer monitors?","hi":"सामान्य कंप्यूटर मॉनिटरों में TFT, LCD और LED शब्द आपस में कैसे संबंधित हैं?"},"a":{"en":"TFT is an active-matrix technology used to control LCD pixels, and a common 'LED monitor' is typically an LCD panel with LED backlighting","hi":"TFT, LCD पिक्सल्स को कंट्रोल करने की तकनीक है, और आम 'LED मॉनिटर' अक्सर LED-बैकलाइट वाला LCD ही होता है"},"o":[{"en":"TFT is an active-matrix technology used to control LCD pixels, and a common 'LED monitor' is typically an LCD panel with LED backlighting","hi":"TFT, LCD पिक्सल्स को कंट्रोल करने की तकनीक है, और आम 'LED मॉनिटर' अक्सर LED-बैकलाइट वाला LCD ही होता है"},{"en":"TFT, LCD, and LED are three types of impact ribbon printers","hi":"TFT, LCD और LED तीन प्रकार के इम्पैक्ट रिबन प्रिंटर हैं"},{"en":"An LCD monitor uses a vacuum cathode ray gun, while TFT uses magnetic ink","hi":"LCD मॉनिटर वैक्यूम कैथोड रे गन का उपयोग करता है, जबकि TFT मैग्नेटिक इंक का उपयोग करता है"},{"en":"LED monitors contain no pixels and work only with light pens","hi":"LED मॉनिटर में कोई पिक्सेल नहीं होता और यह केवल लाइट पेन के साथ काम करता है"}],"exp":{"en":"TFT (Thin-Film Transistor) is the active-matrix switching technology used to control individual pixels in an LCD panel, and what is commonly sold as an 'LED monitor' is actually an LCD panel illuminated by an LED backlight.","hi":"TFT, LCD पिक्सल्स को नियंत्रित करने की एक ट्रांजिस्टर तकनीक है, और बाज़ार में मिलने वाला सामान्य 'LED मॉनिटर' वास्तव में LED बैकलाइट (LED-backlit) वाला एक LCD डिस्प्ले ही होता है।"},"num":52},{"id":"q53","q":{"en":"What are the two main types of monitors on the basis of colour capability?","hi":"रंग क्षमता (Colour capability) के आधार पर मॉनिटर के दो मुख्य प्रकार कौन-से हैं?"},"a":{"en":"Monochrome and Colour monitors","hi":"मोनोक्रोम (Monochrome) और कलर (Colour) मॉनिटर"},"o":[{"en":"Impact and Non-impact monitors","hi":"इम्पैक्ट और नॉन-इम्पैक्ट मॉनिटर"},{"en":"Monochrome and Colour monitors","hi":"मोनोक्रोम (Monochrome) और कलर (Colour) मॉनिटर"},{"en":"Volatile and Non-volatile monitors","hi":"वोलेटाइल और नॉन-वोलेटाइल मॉनिटर"},{"en":"Flatbed and Handheld monitors","hi":"फ्लैटबेड और हैंडहेल्ड मॉनिटर"}],"exp":{"en":"Based on colour display capability, monitors are classified into Monochrome monitors (displaying a single foreground colour against a background) and Colour monitors (RGB).","hi":"रंग क्षमता (colour capability) के आधार पर मॉनिटर दो प्रकार के होते हैं: मोनोक्रोम मॉनिटर (Monochrome — एक ही रंग में प्रदर्शन) और कलर मॉनिटर (Colour monitor)।"},"num":53},{"id":"q54","q":{"en":"How does an 'Impact Printer' produce print on paper?","hi":"'इम्पैक्ट प्रिंटर' (Impact Printer) कागज पर कैसे प्रिंट करता है?"},"a":{"en":"A mechanical pin or print hammer physically strikes an inked ribbon against the paper","hi":"एक मैकेनिकल पिन या हैमर (हथौड़ा) स्याही लगे रिबन (ink ribbon) को कागज के विरुद्ध स्ट्राइक (प्रहार) करता है"},"o":[{"en":"A mechanical pin or print hammer physically strikes an inked ribbon against the paper","hi":"एक मैकेनिकल पिन या हैमर (हथौड़ा) स्याही लगे रिबन (ink ribbon) को कागज के विरुद्ध स्ट्राइक (प्रहार) करता है"},{"en":"It sprays microscopic droplets of liquid ink without touching the paper","hi":"यह कागज को छुए बिना तरल स्याही की सूक्ष्म बूँदें स्प्रे करता है"},{"en":"It uses a laser beam and electrostatic drum to fuse dry toner powder","hi":"यह सूखे टोनर पाउडर को पिघलाने के लिए लेजर बीम और इलेक्ट्रोस्टैटिक ड्रम का उपयोग करता है"},{"en":"It selectively heats special thermochromic receipt paper","hi":"यह विशेष थर्मोक्रोमिक रसीद पेपर को चुनिंदा रूप से गर्म करता है"}],"exp":{"en":"An impact printer operates like a typewriter: mechanical pins, character spokes, or hammers physically strike an inked ribbon against the paper to leave an impression.","hi":"इम्पैक्ट प्रिंटर में एक मैकेनिकल पिन या हैमर (hammer) स्याही लगे रिबन (ink ribbon) को कागज के खिलाफ स्ट्राइक (प्रहार) करके अक्षर छापता है।"},"num":54},{"id":"q55","q":{"en":"Which of the following are standard examples of Impact Printers?","hi":"निम्नलिखित में से कौन-से इम्पैक्ट प्रिंटर (Impact Printers) के उदाहरण हैं?"},"a":{"en":"Daisy wheel, Dot matrix, and traditional impact Line printers (drum/chain/band)","hi":"डेज़ी व्हील (Daisy wheel), डॉट मैट्रिक्स (Dot matrix) और पारंपरिक इम्पैक्ट लाइन प्रिंटर"},"o":[{"en":"Inkjet, Laser, and Thermal printers","hi":"इंकजेट, लेजर और थर्मल प्रिंटर"},{"en":"Daisy wheel, Dot matrix, and traditional impact Line printers (drum/chain/band)","hi":"डेज़ी व्हील (Daisy wheel), डॉट मैट्रिक्स (Dot matrix) और पारंपरिक इम्पैक्ट लाइन प्रिंटर"},{"en":"LCD, LED, and OLED displays","hi":"LCD, LED और OLED डिस्प्ले"},{"en":"OMR, OCR, and MICR readers","hi":"OMR, OCR और MICR रीडर"}],"exp":{"en":"Standard examples of impact printers include Daisy wheel printers, Dot matrix printers, and traditional impact Line printers (such as drum, chain, and band printers).","hi":"इम्पैक्ट प्रिंटर के प्रमुख उदाहरण डेज़ी व्हील (Daisy wheel), डॉट मैट्रिक्स (Dot matrix) और पारंपरिक इम्पैक्ट लाइन प्रिंटर (Line printers) हैं।"},"num":55},{"id":"q56","q":{"en":"How does a 'Character Printer' print, and what are its common examples?","hi":"'कैरेक्टर प्रिंटर' (Character Printer) कैसे प्रिंट करता है और इसके सामान्य उदाहरण कौन-से हैं?"},"a":{"en":"It prints one character at a time; Dot matrix and Daisy wheel are common examples","hi":"यह एक समय में एक अक्षर (character) के हिसाब से प्रिंट करता है; डॉट मैट्रिक्स और डेज़ी व्हील इसके सामान्य उदाहरण हैं"},"o":[{"en":"It prints one character at a time; Dot matrix and Daisy wheel are common examples","hi":"यह एक समय में एक अक्षर (character) के हिसाब से प्रिंट करता है; डॉट मैट्रिक्स और डेज़ी व्हील इसके सामान्य उदाहरण हैं"},{"en":"It prints an entire page in a single flash using toner; Laser printer is the only example","hi":"यह टोनर का उपयोग करके एक ही बार में पूरा पेज प्रिंट करता है; लेजर प्रिंटर एकमात्र उदाहरण है"},{"en":"It prints 3D plastic car parts; CNC milling machine is an example","hi":"यह 3D प्लास्टिक कार पार्ट्स प्रिंट करता है; CNC मिलिंग मशीन एक उदाहरण है"},{"en":"It only scans handwritten signatures; Light pen is an example","hi":"यह केवल हस्तलिखित हस्ताक्षर स्कैन करता है; लाइट पेन एक उदाहरण है"}],"exp":{"en":"A character printer prints text serially one character at a time across the line. Dot matrix and Daisy wheel printers are classic examples of character printers.","hi":"कैरेक्टर प्रिंटर एक समय में एक अक्षर (one character at a time) के हिसाब से प्रिंट करता है। डॉट मैट्रिक्स और डेज़ी व्हील प्रिंटर इसके सामान्य उदाहरण हैं।"},"num":56},{"id":"q57","q":{"en":"How does a 'Line Printer' operate?","hi":"'लाइन प्रिंटर' (Line Printer) कैसे प्रिंट करता है?"},"a":{"en":"It prints an entire line of text in a single printing cycle","hi":"यह एक प्रिंटिंग साइकिल में टेक्स्ट की एक पूरी लाइन (entire text line) प्रिंट करता है"},"o":[{"en":"It prints only one dot per minute","hi":"यह प्रति मिनट केवल एक डॉट प्रिंट करता है"},{"en":"It prints an entire line of text in a single printing cycle","hi":"यह एक प्रिंटिंग साइकिल में टेक्स्ट की एक पूरी लाइन (entire text line) प्रिंट करता है"},{"en":"It draws only circular arcs using a stylus on a tablet","hi":"यह टैबलेट पर स्टाइलस का उपयोग करके केवल गोलाकार चाप बनाता है"},{"en":"It reads barcode lines using an infrared sensor","hi":"यह इन्फ्रारेड सेंसर का उपयोग करके बारकोड लाइनों को पढ़ता है"}],"exp":{"en":"A line printer is a high-speed printer capable of printing an entire line of text at once in a single printing cycle.","hi":"लाइन प्रिंटर एक प्रिंटिंग साइकिल में टेक्स्ट की एक पूरी लाइन (entire line of text) को एक साथ प्रिंट करता है।"},"num":57},{"id":"q58","q":{"en":"How does a 'Non-Impact Printer' work, and which of the following are its examples?","hi":"'नॉन-इम्पैक्ट प्रिंटर' (Non-Impact Printer) कैसे काम करता है और इसके उदाहरण कौन-से हैं?"},"a":{"en":"It prints without striking an impact hammer and ribbon against the paper; examples include Inkjet, Laser, and Thermal printers","hi":"यह इम्पैक्ट हैमर और रिबन को कागज पर स्ट्राइक किए बिना प्रिंट करता है; इंकजेट, लेजर और थर्मल इसके उदाहरण हैं"},"o":[{"en":"It prints without striking an impact hammer and ribbon against the paper; examples include Inkjet, Laser, and Thermal printers","hi":"यह इम्पैक्ट हैमर और रिबन को कागज पर स्ट्राइक किए बिना प्रिंट करता है; इंकजेट, लेजर और थर्मल इसके उदाहरण हैं"},{"en":"It uses metal pins to punch holes through stiff paper cards; example: Hollerith punch","hi":"यह कठोर पेपर कार्डों में छेद करने के लिए धातु की पिनों का उपयोग करता है; उदाहरण: होलेरिथ पंच"},{"en":"It strikes a petal-shaped wheel against a carbon ribbon; example: Daisy wheel","hi":"यह कार्बन रिबन के खिलाफ पंखुड़ी के आकार के पहिये से प्रहार करता है; उदाहरण: डेज़ी व्हील"},{"en":"It only displays soft copies on a glass CRT screen; example: Monitor","hi":"यह केवल कांच की CRT स्क्रीन पर सॉफ्ट कॉपी दिखाता है; उदाहरण: मॉनिटर"}],"exp":{"en":"Non-impact printers form characters and images without any physical hammer-and-ribbon strike on the paper, making them quieter and faster. Examples include Inkjet, Laser, and Thermal printers.","hi":"नॉन-इम्पैक्ट प्रिंटर किसी हैमर या रिबन को कागज पर स्ट्राइक (प्रहार) किए बिना शांत तरीके से प्रिंट करता है। इंकजेट (Inkjet), लेजर (Laser) और थर्मल (Thermal) प्रिंटर इसके उदाहरण हैं।"},"num":58},{"id":"q59","q":{"en":"How does a Dot Matrix Printer form characters on paper?","hi":"डॉट मैट्रिक्स प्रिंटर (Dot Matrix Printer) कागज पर अक्षर (Characters) कैसे बनाता है?"},"a":{"en":"Printhead pins strike an ink ribbon against the paper to form characters out of a pattern (matrix) of dots","hi":"प्रिंटहेड की पिनें रिबन को स्ट्राइक करके कागज पर डॉट्स (बिंदुओं) का पैटर्न बनाती हैं"},"o":[{"en":"Printhead pins strike an ink ribbon against the paper to form characters out of a pattern (matrix) of dots","hi":"प्रिंटहेड की पिनें रिबन को स्ट्राइक करके कागज पर डॉट्स (बिंदुओं) का पैटर्न बनाती हैं"},{"en":"A laser beam melts dry toner onto a rotating drum","hi":"एक लेजर बीम घूमने वाले ड्रम पर सूखे टोनर को पिघलाती है"},{"en":"Nozzles spray heated liquid ink droplets without contact","hi":"नोजल बिना संपर्क के गर्म तरल स्याही की बूँदें स्प्रे करते हैं"},{"en":"Ultraviolet light exposes photographic film","hi":"पराबैंगनी प्रकाश फोटोग्राफिक फिल्म को एक्सपोज़ करता है"}],"exp":{"en":"A dot matrix printer has a printhead containing a vertical column of tiny metal pins that strike an inked ribbon against the paper, forming characters and graphics as a matrix of dots.","hi":"डॉट मैट्रिक्स प्रिंटर में पिनें (pins) स्याही लगे रिबन को कागज पर स्ट्राइक करके बिंदुओं (dots) का पैटर्न बनाती हैं जिससे अक्षर उभरते हैं।"},"num":59},{"id":"q60","q":{"en":"What does an Inkjet Printer spray onto the paper to form text and images?","hi":"इंकजेट प्रिंटर (Inkjet Printer) टेक्स्ट और इमेज बनाने के लिए कागज पर क्या स्प्रे करता है?"},"a":{"en":"Tiny droplets of liquid ink through microscopic nozzles","hi":"सूक्ष्म नोजल के माध्यम से तरल स्याही की अत्यंत छोटी बूँदें (Tiny droplets of liquid ink)"},"o":[{"en":"Dry magnetic iron-oxide sand","hi":"सूखी चुंबकीय आयरन-ऑक्साइड रेत"},{"en":"Tiny droplets of liquid ink through microscopic nozzles","hi":"सूक्ष्म नोजल के माध्यम से तरल स्याही की अत्यंत छोटी बूँदें (Tiny droplets of liquid ink)"},{"en":"Molten lead and brass gears","hi":"पिघला हुआ सीसा और पीतल के गियर"},{"en":"Electrons from a cathode ray gun","hi":"कैथोड रे गन से इलेक्ट्रॉन"}],"exp":{"en":"An inkjet printer is a non-impact printer that creates images and characters by propelling/spraying microscopic droplets of liquid ink directly onto the paper.","hi":"इंकजेट प्रिंटर कागज पर तरल स्याही की अत्यंत छोटी बूँदें (tiny droplets of liquid ink) स्प्रे करके प्रिंट करता है।"},"num":60},{"id":"q61","q":{"en":"What does a Laser Printer use instead of liquid ink, and how is the print fixed onto the paper?","hi":"लेजर प्रिंटर (Laser Printer) तरल स्याही की जगह क्या उपयोग करता है और प्रिंट को कागज पर कैसे फिक्स किया जाता है?"},"a":{"en":"It uses dry Toner powder; the image is formed via laser/electrostatic imaging and fused onto the paper using heat and pressure","hi":"यह सूखे टोनर पाउडर (Toner powder) का उपयोग करता है; लेजर इमेजिंग और ऊष्मा (heat) से प्रिंट बनाया व कागज पर फिक्स किया जाता है"},"o":[{"en":"It uses dry Toner powder; the image is formed via laser/electrostatic imaging and fused onto the paper using heat and pressure","hi":"यह सूखे टोनर पाउडर (Toner powder) का उपयोग करता है; लेजर इमेजिंग और ऊष्मा (heat) से प्रिंट बनाया व कागज पर फिक्स किया जाता है"},{"en":"It uses a carbon cloth ribbon struck by 24 steel pins","hi":"यह 24 स्टील पिनों द्वारा प्रहार किए जाने वाले कार्बन कपड़े के रिबन का उपयोग करता है"},{"en":"It uses liquid mercury cooled to sub-zero temperatures","hi":"यह शून्य से नीचे के तापमान पर ठंडा किए गए तरल पारे का उपयोग करता है"},{"en":"It uses wax crayons held by a mechanical robotic arm","hi":"यह यांत्रिक रोबोटिक भुजा द्वारा पकड़े गए मोम के क्रेयॉन का उपयोग करता है"}],"exp":{"en":"A laser printer uses dry toner powder instead of liquid ink. A laser beam creates an electrostatic image on a photoreceptor drum that attracts toner, which is then transferred and permanently fused onto the paper using heat (fuser rollers).","hi":"लेजर प्रिंटर तरल स्याही के स्थान पर सूखे 'टोनर पाउडर' (toner powder) का उपयोग करता है। लेजर इमेजिंग और हीट (ऊष्मा) की मदद से प्रिंट बनाया और कागज पर स्थायी रूप से फिक्स किया जाता है।"},"num":61},{"id":"q62","q":{"en":"What is the basic operating principle of a 'Thermal Printer'?","hi":"'थर्मल प्रिंटर' (Thermal Printer) का मूल कार्य सिद्धांत क्या है?"},"a":{"en":"It forms images using heat, such as selectively heating thermochromic receipt paper (direct thermal)","hi":"इसमें ऊष्मा (Heat) की मदद से इमेज बनती है, जैसे डायरेक्ट थर्मल रसीद पेपर (receipt paper) पर"},"o":[{"en":"It forms images using heat, such as selectively heating thermochromic receipt paper (direct thermal)","hi":"इसमें ऊष्मा (Heat) की मदद से इमेज बनती है, जैसे डायरेक्ट थर्मल रसीद पेपर (receipt paper) पर"},{"en":"It strikes a metal daisy wheel against a fabric ribbon","hi":"यह कपड़े के रिबन के खिलाफ धातु के डेज़ी व्हील से प्रहार करता है"},{"en":"It uses ultrasonic sound waves to vibrate liquid ink","hi":"यह तरल स्याही को कंपन करने के लिए अल्ट्रासोनिक ध्वनि तरंगों का उपयोग करता है"},{"en":"It requires freezing the paper before spraying toner","hi":"टोनर स्प्रे करने से पहले इसमें कागज को जमाना पड़ता है"}],"exp":{"en":"A thermal printer uses controlled heat from a thermal printhead to produce an image on chemically treated, heat-sensitive (thermochromic) paper—widely used in ATM slips and POS billing receipts.","hi":"थर्मल प्रिंटर का मूल सिद्धांत ऊष्मा (heat) से इमेज बनाना है, जैसे एटीएम या पीओएस मशीन के डायरेक्ट थर्मल रसीद पेपर (receipt paper) पर प्रिंट करना।"},"num":62},{"id":"q63","q":{"en":"According to the chapter's illustrative comparison table, what are the typical speed ranges for Dot Matrix, Inkjet, and Laser printers?","hi":"अध्याय की तुलना तालिका के अनुसार, डॉट मैट्रिक्स, इंकजेट और लेजर प्रिंटर की विशिष्ट गति (Typical Speed) की रेंज क्या दी गई है?"},"a":{"en":"Dot matrix: 200–540 characters/sec; Inkjet: 4–8 pages/min; Laser: 4–20 pages/min (illustrative textbook ranges; actual speed varies by model)","hi":"डॉट मैट्रिक्स: 200–540 अक्षर/सेकंड; इंकजेट: 4–8 पेज/मिनट; लेजर: 4–20 पेज/मिनट (वास्तविक गति मॉडल पर निर्भर करती है)"},"o":[{"en":"Dot matrix: 200–540 characters/sec; Inkjet: 4–8 pages/min; Laser: 4–20 pages/min (illustrative textbook ranges; actual speed varies by model)","hi":"डॉट मैट्रिक्स: 200–540 अक्षर/सेकंड; इंकजेट: 4–8 पेज/मिनट; लेजर: 4–20 पेज/मिनट (वास्तविक गति मॉडल पर निर्भर करती है)"},{"en":"Dot matrix: 100 pages/min; Inkjet: 1 character/min; Laser: 2 characters/hour","hi":"डॉट मैट्रिक्स: 100 पेज/मिनट; इंकजेट: 1 अक्षर/मिनट; लेजर: 2 अक्षर/घंटा"},{"en":"All three printers operate at exactly 1,000 pages per second","hi":"तीनों प्रिंटर ठीक 1,000 पेज प्रति सेकंड की गति से काम करते हैं"},{"en":"Dot matrix is measured in GHz, Inkjet in MB/s, and Laser in RPM","hi":"डॉट मैट्रिक्स को GHz में, इंकजेट को MB/s में और लेजर को RPM में मापा जाता है"}],"exp":{"en":"In the source comparison table, the illustrative speed ranges are: Dot matrix = 200–540 characters per second (CPS), Inkjet = 4–8 pages per minute (PPM), and Laser = 4–20 pages per minute (PPM) (actual speeds depend on the specific model).","hi":"स्रोत तालिका के अनुसार उदाहरणात्मक गति रेंज: डॉट मैट्रिक्स 200–540 कैरेक्टर/सेकंड (CPS), इंकजेट 4–8 पेज/मिनट (PPM), और लेजर प्रिंटर 4–20 पेज/मिनट (PPM) है (वास्तविक गति मॉडल पर निर्भर करती है)।"},"num":63},{"id":"q64","q":{"en":"In the chapter's printer comparison table, how is the relative cost of Dot Matrix, Inkjet, and Laser printers compared?","hi":"अध्याय की प्रिंटर तुलना तालिका में डॉट मैट्रिक्स, इंकजेट और लेजर प्रिंटर की सापेक्ष लागत (Relative Cost) की तुलना कैसे की गई है?"},"a":{"en":"Dot matrix is comparatively inexpensive, Inkjet is moderate, and Laser is expensive (actual purchase/running costs vary by model)","hi":"डॉट मैट्रिक्स तुलनात्मक रूप से सस्ता (inexpensive), इंकजेट मध्यम (moderate) और लेजर महंगा (expensive) होता है"},"o":[{"en":"Dot matrix is comparatively inexpensive, Inkjet is moderate, and Laser is expensive (actual purchase/running costs vary by model)","hi":"डॉट मैट्रिक्स तुलनात्मक रूप से सस्ता (inexpensive), इंकजेट मध्यम (moderate) और लेजर महंगा (expensive) होता है"},{"en":"Dot matrix is the most expensive, while Laser is completely free","hi":"डॉट मैट्रिक्स सबसे महंगा है, जबकि लेजर पूरी तरह से मुफ्त है"},{"en":"Inkjet costs more than a mainframe computer, while Laser costs less than a mouse","hi":"इंकजेट की कीमत मेनफ्रेम कंप्यूटर से अधिक होती है, जबकि लेजर की कीमत माउस से कम होती है"},{"en":"All three have identical purchase and toner costs","hi":"तीनों की खरीद और टोनर लागत बिल्कुल समान है"}],"exp":{"en":"In the textbook comparison table, Dot matrix printers are listed as comparatively inexpensive (low running cost per page), Inkjet printers as moderate, and Laser printers as comparatively expensive in initial hardware cost.","hi":"स्रोत तुलना के अनुसार, डॉट मैट्रिक्स तुलनात्मक रूप से सस्ता (inexpensive), इंकजेट मध्यम (moderate) और लेजर प्रिंटर महंगा (expensive) श्रेणी में रखा गया है (वास्तविक खरीद और रनिंग लागत मॉडल पर निर्भर करती है)।"},"num":64},{"id":"q65","q":{"en":"What is the primary use of a 'Plotter'?","hi":"'प्लॉटर' (Plotter) का मुख्य उपयोग क्या है?"},"a":{"en":"Producing large-format, high-precision graphics and vector outputs such as engineering drawings, architectural house plans, banners, hoardings, and CAD/CAM car-part drawings","hi":"बड़े और सटीक आउटपुट जैसे इंजीनियरिंग ड्रॉइंग, हाउस प्लान, बैनर, होर्डिंग और CAD/CAM कार-पार्ट ड्रॉइंग प्रिंट करना"},"o":[{"en":"Producing large-format, high-precision graphics and vector outputs such as engineering drawings, architectural house plans, banners, hoardings, and CAD/CAM car-part drawings","hi":"बड़े और सटीक आउटपुट जैसे इंजीनियरिंग ड्रॉइंग, हाउस प्लान, बैनर, होर्डिंग और CAD/CAM कार-पार्ट ड्रॉइंग प्रिंट करना"},{"en":"Scanning small grocery barcodes at a supermarket checkout","hi":"सुपरमार्केट चेकआउट पर छोटे किराने के बारकोड स्कैन करना"},{"en":"Recording voice memos and podcasts into MP3 format","hi":"वॉयस मेमो और पॉडकास्ट को MP3 फॉर्मेट में रिकॉर्ड करना"},{"en":"Storing temporary arithmetic operands inside the CPU","hi":"CPU के अंदर अस्थायी अंकगणितीय ऑपरेंड स्टोर करना"}],"exp":{"en":"A plotter is a specialized large-format output device used to print accurate vector graphics, architectural blueprints, house plans, engineering drawings (CAD/CAM car parts), maps, banners, and hoardings.","hi":"प्लॉटर का उपयोग बड़े और सटीक ग्राफिक्स आउटपुट—जैसे इंजीनियरिंग ड्रॉइंग, घर के नक्शे (house plans), बैनर, होर्डिंग्स और CAD/CAM की मदद से कार-पार्ट ड्रॉइंग्स—तैयार करने में किया जाता है।"},"num":65},{"id":"q66","q":{"en":"What are the full forms of CAD and CAM (frequently used with plotters and workstations)?","hi":"CAD और CAM के पूर्ण रूप (Full Forms) क्या हैं?"},"a":{"en":"Computer-Aided Design and Computer-Aided Manufacturing","hi":"कंप्यूटर-एडेड डिज़ाइन (Computer-Aided Design) और कंप्यूटर-एडेड मैन्युफैक्चरिंग (Computer-Aided Manufacturing)"},"o":[{"en":"Cache Address Data and Cache Address Memory","hi":"कैश एड्रेस डेटा और कैश एड्रेस मेमोरी"},{"en":"Computer-Aided Design and Computer-Aided Manufacturing","hi":"कंप्यूटर-एडेड डिज़ाइन (Computer-Aided Design) और कंप्यूटर-एडेड मैन्युफैक्चरिंग (Computer-Aided Manufacturing)"},{"en":"Control Arithmetic Device and Control Arithmetic Module","hi":"कंट्रोल अरिथमेटिक डिवाइस और कंट्रोल अरिथमेटिक मॉड्यूल"},{"en":"Cathode Anode Display and Cathode Anode Monitor","hi":"कैथोड एनोड डिस्प्ले और कैथोड एनोड मॉनिटर"}],"exp":{"en":"CAD stands for Computer-Aided Design, and CAM stands for Computer-Aided Manufacturing.","hi":"CAD का पूर्ण रूप Computer-Aided Design और CAM का पूर्ण रूप Computer-Aided Manufacturing है।"},"num":66}]},{"title":{"en":"6. Memory, Cache, RAM & ROM","hi":"6. मेमोरी, कैश, रैम और रोम"},"questions":[{"id":"q67","q":{"en":"What does computer memory store, and into which three main categories does the chapter group it?","hi":"कंप्यूटर मेमोरी क्या स्टोर करती है, और अध्याय में इसे किन तीन मुख्य श्रेणियों में बाँटा गया है?"},"a":{"en":"It stores data and instructions; grouped into Cache memory, Primary/Main memory, and Secondary memory","hi":"यह डेटा और निर्देश (instructions) स्टोर करती है; इसे कैश मेमोरी, प्राइमरी/मेन मेमोरी और सेकेंडरी मेमोरी में बाँटा गया है"},"o":[{"en":"It stores data and instructions; grouped into Cache memory, Primary/Main memory, and Secondary memory","hi":"यह डेटा और निर्देश (instructions) स्टोर करती है; इसे कैश मेमोरी, प्राइमरी/मेन मेमोरी और सेकेंडरी मेमोरी में बाँटा गया है"},{"en":"It stores only AC electric current; grouped into UPS, SMPS, and Transformer","hi":"यह केवल एसी विद्युत धारा स्टोर करती है; इसे यूपीएस, एसएमपीएस और ट्रांसफॉर्मर में बाँटा गया है"},{"en":"It stores printer toner powder; grouped into Impact, Non-impact, and Thermal","hi":"यह प्रिंटर टोनर पाउडर स्टोर करती है; इसे इम्पैक्ट, नॉन-इम्पैक्ट और थर्मल में बाँटा गया है"},{"en":"It stores only mouse clicks; grouped into Left, Right, and Scroll","hi":"यह केवल माउस क्लिक स्टोर करती है; इसे लेफ्ट, राइट और स्क्रॉल में बाँटा गया है"}],"exp":{"en":"Computer memory stores data and instructions required for processing. The chapter classifies memory into three main groups: Cache memory, Primary (Main) memory, and Secondary (Auxiliary) memory.","hi":"कंप्यूटर मेमोरी डेटा (data) और निर्देशों (instructions) को स्टोर करती है। अध्याय में इसे कैश (Cache), प्राइमरी/मेन मेमोरी (Primary/Main memory) और सेकेंडरी मेमोरी (Secondary memory) में वर्गीकृत किया गया है।"},"num":67},{"id":"q68","q":{"en":"What is 'Cache Memory'?","hi":"'कैश मेमोरी' (Cache Memory) क्या है?"},"a":{"en":"A high-speed semiconductor memory that provides the CPU with fast access to repeatedly or recently accessed data and instructions","hi":"एक हाई-स्पीड सेमीकंडक्टर मेमोरी जो बार-बार या हाल ही में एक्सेस किए गए डेटा/निर्देशों तक CPU को तेज़ एक्सेस देती है"},"o":[{"en":"A slow magnetic tape drive used for yearly offline backups","hi":"वार्षिक ऑफ़लाइन बैकअप के लिए उपयोग किया जाने वाला एक धीमा चुंबकीय टेप ड्राइव"},{"en":"A high-speed semiconductor memory that provides the CPU with fast access to repeatedly or recently accessed data and instructions","hi":"एक हाई-स्पीड सेमीकंडक्टर मेमोरी जो बार-बार या हाल ही में एक्सेस किए गए डेटा/निर्देशों तक CPU को तेज़ एक्सेस देती है"},{"en":"An optical disc that can only be erased using ultraviolet light","hi":"एक ऑप्टिकल डिस्क जिसे केवल पराबैंगनी प्रकाश का उपयोग करके मिटाया जा सकता है"},{"en":"A paper punched card used in first-generation computers","hi":"प्रथम पीढ़ी के कंप्यूटरों में प्रयुक्त एक पेपर पंच कार्ड"}],"exp":{"en":"Cache memory is a very high-speed semiconductor memory placed close to (or inside) the CPU that stores copies of frequently or recently used data and instructions for rapid access.","hi":"कैश मेमोरी एक अत्यंत तेज़ (high-speed) सेमीकंडक्टर मेमोरी है, जो बार-बार (repeatedly) या हाल ही में (recently) उपयोग किए गए डेटा और निर्देशों तक CPU को तुरंत एक्सेस प्रदान करती है।"},"num":68},{"id":"q69","q":{"en":"What role does Cache Memory play between the CPU and main RAM?","hi":"CPU और मुख्य RAM के बीच कैश मेमोरी (Cache Memory) क्या भूमिका निभाती है?"},"a":{"en":"It acts as a high-speed buffer that keeps frequently needed copies nearby, thereby reducing slower accesses to main RAM","hi":"यह बार-बार ज़रूरत पड़ने वाले डेटा की कॉपी पास रखकर अपेक्षाकृत धीमी RAM तक जाने की आवश्यकता को कम करती है"},"o":[{"en":"It acts as a high-speed buffer that keeps frequently needed copies nearby, thereby reducing slower accesses to main RAM","hi":"यह बार-बार ज़रूरत पड़ने वाले डेटा की कॉपी पास रखकर अपेक्षाकृत धीमी RAM तक जाने की आवश्यकता को कम करती है"},{"en":"It slows down the CPU so that the printer can catch up","hi":"यह CPU को धीमा कर देती है ताकि प्रिंटर उसके साथ तालमेल बिठा सके"},{"en":"It converts digital RAM data into analog CRT video signals","hi":"यह डिजिटल RAM डेटा को एनालॉग CRT वीडियो सिग्नल में बदलती है"},{"en":"It permanently replaces the hard disk and optical drive","hi":"यह हार्ड डिस्क और ऑप्टिकल ड्राइव को स्थायी रूप से बदल देती है"}],"exp":{"en":"Sitting in the memory access path between the ultra-fast CPU and relatively slower main RAM, cache memory keeps frequently needed instructions/data nearby, minimizing CPU wait time and reducing slower main memory accesses.","hi":"कैश मेमोरी CPU और RAM के बीच एक तेज़ बफर की भूमिका निभाती है; यह बार-बार काम आने वाले डेटा की कॉपी CPU के पास रखकर धीमी RAM को बार-बार एक्सेस करने का समय बचाती है।"},"num":69},{"id":"q70","q":{"en":"How do Cache Memory and main RAM compare in terms of access speed, size, and cost per unit capacity?","hi":"एक्सेस स्पीड, आकार (Size) और प्रति यूनिट लागत (Cost) के मामले में कैश मेमोरी और RAM में क्या अंतर है?"},"a":{"en":"Cache is faster, generally smaller in capacity, and more expensive per unit capacity than main RAM","hi":"कैश मेमोरी RAM की तुलना में अधिक तेज़ (faster), आकार में सामान्यतः छोटी और प्रति यूनिट क्षमता अधिक महंगी होती है"},"o":[{"en":"Cache is faster, generally smaller in capacity, and more expensive per unit capacity than main RAM","hi":"कैश मेमोरी RAM की तुलना में अधिक तेज़ (faster), आकार में सामान्यतः छोटी और प्रति यूनिट क्षमता अधिक महंगी होती है"},{"en":"Cache is slower, 100 times larger, and much cheaper per byte than RAM","hi":"कैश मेमोरी RAM की तुलना में धीमी, 100 गुना बड़ी और प्रति बाइट बहुत सस्ती होती है"},{"en":"Both have the exact same speed, capacity, and cost as a magnetic hard disk","hi":"दोनों की गति, क्षमता और लागत चुंबकीय हार्ड डिस्क के बिल्कुल समान होती है"},{"en":"RAM is faster than CPU registers, while Cache is slower than a CD-ROM","hi":"RAM सीपीयू रजिस्टरों से तेज़ होती है, जबकि कैश CD-ROM से धीमी होती है"}],"exp":{"en":"Compared to main RAM (DRAM), Cache memory (SRAM) has much faster access speed, is significantly smaller in storage capacity, and is more expensive per byte/unit capacity.","hi":"मुख्य RAM की तुलना में कैश मेमोरी अधिक तेज़ (faster) होती है, क्षमता (size) में आम तौर पर छोटी होती है और प्रति यूनिट क्षमता अधिक महंगी (more expensive) होती है।"},"num":70},{"id":"q71","q":{"en":"Is the data stored in typical CPU Cache Memory permanent?","hi":"क्या सामान्य CPU कैश मेमोरी में रखा डेटा स्थायी (Permanent) होता है?"},"a":{"en":"No — cache holds temporary copies of active data, and typical CPU cache (SRAM) is volatile","hi":"नहीं — कैश केवल अस्थायी कॉपी (temporary copies) होल्ड करती है और सामान्य CPU कैश वोलेटाइल (volatile) होती है"},"o":[{"en":"Yes — it retains data for 100 years without electricity like an optical Blu-ray disc","hi":"हाँ — यह ऑप्टिकल ब्लू-रे डिस्क की तरह बिना बिजली के 100 वर्षों तक डेटा सुरक्षित रखती है"},{"en":"No — cache holds temporary copies of active data, and typical CPU cache (SRAM) is volatile","hi":"नहीं — कैश केवल अस्थायी कॉपी (temporary copies) होल्ड करती है और सामान्य CPU कैश वोलेटाइल (volatile) होती है"},{"en":"Yes — it is factory-programmed once and can never be erased","hi":"हाँ — इसे फैक्ट्री में एक बार प्रोग्राम किया जाता है और कभी मिटाया नहीं जा सकता"},{"en":"Yes — it stores data using permanent holes punched in paper tape","hi":"हाँ — यह पेपर टेप में किए गए स्थायी छेदों का उपयोग करके डेटा स्टोर करती है"}],"exp":{"en":"No, cache data is not permanent. Cache memory only holds temporary working copies of data/instructions for the CPU, and standard CPU cache (built with SRAM) is volatile—losing its contents when power is turned off.","hi":"नहीं, कैश मेमोरी का डेटा स्थायी नहीं होता। कैश केवल सक्रिय डेटा की अस्थायी कॉपी (temporary copies) होल्ड करती है और सामान्य CPU कैश वोलेटाइल (volatile — बिजली बंद होने पर मिट जाने वाली) होती है।"},"num":71},{"id":"q72","q":{"en":"How does Primary Memory handle working data, and how does its capacity compare to secondary storage?","hi":"प्राइमरी मेमोरी (Primary Memory) वर्किंग डेटा को कैसे संभालती है, और इसकी क्षमता सेकेंडरी स्टोरेज की तुलना में कैसी होती है?"},"a":{"en":"It provides the CPU with fast access to currently needed data and instructions; RAM size is usually smaller than secondary storage","hi":"यह वर्तमान में आवश्यक डेटा और निर्देशों तक CPU को तेज़ एक्सेस देती है; RAM का आकार सामान्यतः सेकेंडरी स्टोरेज से कम होता है"},"o":[{"en":"It provides the CPU with fast access to currently needed data and instructions; RAM size is usually smaller than secondary storage","hi":"यह वर्तमान में आवश्यक डेटा और निर्देशों तक CPU को तेज़ एक्सेस देती है; RAM का आकार सामान्यतः सेकेंडरी स्टोरेज से कम होता है"},{"en":"It stores only offline archival backups and is 1,000 times larger than a hard disk","hi":"यह केवल ऑफ़लाइन बैकअप स्टोर करती है और हार्ड डिस्क से 1,000 गुना बड़ी होती है"},{"en":"It cannot be accessed by the CPU directly and requires a scanner to read","hi":"इसे CPU द्वारा सीधे एक्सेस नहीं किया जा सकता और पढ़ने के लिए स्कैनर की आवश्यकता होती है"},{"en":"It prints working data onto thermal paper rolls","hi":"यह वर्किंग डेटा को थर्मल पेपर रोल पर प्रिंट करती है"}],"exp":{"en":"Primary (main) memory holds the currently executing programs and working data, giving the CPU fast direct access. The capacity of main RAM is typically much smaller than secondary storage (HDD/SSD).","hi":"प्राइमरी मेमोरी वर्तमान में उपयोग हो रहे डेटा और निर्देशों तक CPU को तेज़ एक्सेस देती है। RAM का आकार (क्षमता) आमतौर पर सेकेंडरी स्टोरेज की तुलना में कम होता है।"},"num":72},{"id":"q73","q":{"en":"What are the two main textbook types of Primary Memory, and which one is volatile versus non-volatile?","hi":"पाठ्यपुस्तकों के अनुसार प्राइमरी मेमोरी के दो मुख्य प्रकार कौन-से हैं, और उनमें से कौन-सा वोलेटाइल तथा कौन-सा नॉन-वोलेटाइल है?"},"a":{"en":"RAM and ROM — RAM is volatile, whereas ROM is non-volatile","hi":"RAM और ROM — वोलेटाइल (volatile) गुण RAM का है, जबकि ROM नॉन-वोलेटाइल (non-volatile) है"},"o":[{"en":"RAM and ROM — RAM is volatile, whereas ROM is non-volatile","hi":"RAM और ROM — वोलेटाइल (volatile) गुण RAM का है, जबकि ROM नॉन-वोलेटाइल (non-volatile) है"},{"en":"HDD and SSD — both are volatile primary memories","hi":"HDD और SSD — दोनों वोलेटाइल प्राइमरी मेमोरी हैं"},{"en":"CD and DVD — CD is volatile, whereas DVD is non-volatile","hi":"CD और DVD — CD वोलेटाइल है, जबकि DVD नॉन-वोलेटाइल है"},{"en":"ALU and CU — ALU is non-volatile, whereas CU is volatile","hi":"ALU और CU — ALU नॉन-वोलेटाइल है, जबकि CU वोलेटाइल है"}],"exp":{"en":"Standard textbooks classify Primary Memory into two main types: RAM (Random Access Memory), which is volatile (loses data when power is lost), and ROM (Read-Only Memory), which is non-volatile (retains data without power).","hi":"प्राइमरी मेमोरी के दो मुख्य प्रकार RAM और ROM हैं। इनमें RAM वोलेटाइल (volatile — अस्थायी) होती है, जबकि ROM नॉन-वोलेटाइल (non-volatile — स्थायी) होती है।"},"num":73},{"id":"q74","q":{"en":"What is the full form and main characteristic of normal system RAM?","hi":"RAM का पूर्ण रूप (Full Form) और सामान्य सिस्टम RAM का मुख्य गुण क्या है?"},"a":{"en":"Random Access Memory — Normal system RAM is read/write and volatile, meaning its contents are lost when power is turned off","hi":"रैंडम एक्सेस मेमोरी — सामान्य सिस्टम RAM रीड/राइट और वोलेटाइल होती है; पावर ऑफ होने पर इसका डेटा चला जाता है"},"o":[{"en":"Read Always Memory — It is non-volatile and cannot be written to by the CPU","hi":"रीड ऑलवेज मेमोरी — यह नॉन-वोलेटाइल है और इसमें CPU द्वारा लिखा नहीं जा सकता"},{"en":"Random Access Memory — Normal system RAM is read/write and volatile, meaning its contents are lost when power is turned off","hi":"रैंडम एक्सेस मेमोरी — सामान्य सिस्टम RAM रीड/राइट और वोलेटाइल होती है; पावर ऑफ होने पर इसका डेटा चला जाता है"},{"en":"Rotary Analog Module — It stores data on spinning magnetic tape reels","hi":"रोटरी एनालॉग मॉड्यूल — यह घूमने वाली चुंबकीय टेप रील पर डेटा स्टोर करता है"},{"en":"Remote Array Memory — It works only inside optical barcode scanners","hi":"रिमोट ऐरे मेमोरी — यह केवल ऑप्टिकल बारकोड स्कैनर के अंदर काम करती है"}],"exp":{"en":"RAM stands for Random Access Memory. Normal system RAM is a read/write and volatile semiconductor memory, meaning its stored contents are erased as soon as the power supply is switched off.","hi":"RAM का पूर्ण रूप Random Access Memory है। सामान्य सिस्टम RAM रीड/राइट (read/write) और वोलेटाइल (volatile) होती है, अर्थात् पावर ऑफ होने पर इसके अंदर का डेटा मिट जाता है।"},"num":74},{"id":"q75","q":{"en":"Why is RAM also called 'Read/Write Memory'?","hi":"RAM को 'रीड/राइट मेमोरी' (Read/Write Memory) क्यों कहा जाता है?"},"a":{"en":"Because the CPU or system can both read data from it and write/update contents in it rapidly","hi":"क्योंकि CPU या सिस्टम इससे डेटा रीड (पढ़) भी सकता है और इसमें डेटा राइट/अपडेट (लिख) भी सकता है"},"o":[{"en":"Because the CPU or system can both read data from it and write/update contents in it rapidly","hi":"क्योंकि CPU या सिस्टम इससे डेटा रीड (पढ़) भी सकता है और इसमें डेटा राइट/अपडेट (लिख) भी सकता है"},{"en":"Because the user must write on the RAM chip using a physical stylus pen","hi":"क्योंकि यूज़र को भौतिक स्टाइलस पेन से RAM चिप पर लिखना पड़ता है"},{"en":"Because it reads paper cheques and writes ink onto banners","hi":"क्योंकि यह कागजी चेक पढ़ती है और बैनरों पर स्याही लिखती है"},{"en":"Because it can only be written once at the factory and never modified","hi":"क्योंकि इसे फैक्ट्री में केवल एक बार लिखा जा सकता है और कभी बदला नहीं जा सकता"}],"exp":{"en":"RAM is called read/write memory because the CPU can both read (retrieve) existing data/instructions from any RAM address and write (store/update) new data into it during execution.","hi":"RAM को रीड/राइट मेमोरी इसलिए कहते हैं क्योंकि CPU या सिस्टम इसमें से डेटा रीड (read) भी कर सकता है और इसके कंटेंट को राइट या अपडेट (write/update) भी कर सकता है।"},"num":75},{"id":"q76","q":{"en":"What does the term 'Random Access' mean in Random Access Memory?","hi":"मेमोरी के संदर्भ में 'रैंडम एक्सेस' (Random Access) का क्या अर्थ है?"},"a":{"en":"Any addressed memory location can be accessed directly in approximately the same time without sequentially reading preceding locations","hi":"किसी भी एड्रेस वाली मेमोरी लोकेशन को बिना पिछली लोकेशन्स को क्रमशः (sequentially) पढ़े सीधे (directly) एक्सेस किया जा सकता है"},"o":[{"en":"The memory returns random, unpredictable numbers every time the CPU reads it","hi":"जब भी CPU इसे पढ़ता है तो मेमोरी यादृच्छिक, अप्रत्याशित संख्याएँ लौटाती है"},{"en":"Any addressed memory location can be accessed directly in approximately the same time without sequentially reading preceding locations","hi":"किसी भी एड्रेस वाली मेमोरी लोकेशन को बिना पिछली लोकेशन्स को क्रमशः (sequentially) पढ़े सीधे (directly) एक्सेस किया जा सकता है"},{"en":"Data must be read strictly from the beginning to the end like a cassette tape","hi":"डेटा को कैसेट टेप की तरह शुरू से अंत तक क्रम से ही पढ़ा जाना चाहिए"},{"en":"Only external USB devices can access the memory randomly during power-off","hi":"पावर-ऑफ के दौरान केवल बाहरी USB डिवाइस ही मेमोरी को रैंडम रूप से एक्सेस कर सकते हैं"}],"exp":{"en":"Random access (direct access) means that any specific memory address can be reached and accessed directly without having to scan through all preceding memory locations in sequence (unlike sequential magnetic tape).","hi":"'रैंडम एक्सेस' का अर्थ है कि किसी भी एड्रेस वाली मेमोरी लोकेशन को सीधे (directly) एक्सेस किया जा सकता है; उसके पहले की सभी लोकेशन्स को क्रमवार (sequentially) पढ़ने की ज़रूरत नहीं होती।"},"num":76},{"id":"q77","q":{"en":"What are the two common semiconductor types of RAM?","hi":"RAM के दो सामान्य प्रकार (Common Types) कौन-से हैं?"},"a":{"en":"Static RAM (SRAM) and Dynamic RAM (DRAM)","hi":"स्टैटिक रैम (SRAM) और डायनेमिक रैम (DRAM)"},"o":[{"en":"PROM and EPROM","hi":"PROM और EPROM"},{"en":"Static RAM (SRAM) and Dynamic RAM (DRAM)","hi":"स्टैटिक रैम (SRAM) और डायनेमिक रैम (DRAM)"},{"en":"CD-ROM and DVD-ROM","hi":"CD-ROM और DVD-ROM"},{"en":"MAR and MBR","hi":"MAR और MBR"}],"exp":{"en":"The two main types of semiconductor RAM are Static RAM (SRAM, made with flip-flops/latches) and Dynamic RAM (DRAM, made with tiny capacitors and transistors).","hi":"RAM के दो सामान्य प्रकार स्टैटिक रैम (Static RAM - SRAM) और डायनेमिक रैम (Dynamic RAM - DRAM) हैं।"},"num":77},{"id":"q78","q":{"en":"What is the key difference between SRAM and DRAM regarding refresh requirement and typical usage?","hi":"रिफ्रेश की आवश्यकता और सामान्य उपयोग के संदर्भ में SRAM और DRAM के बीच मुख्य अंतर क्या है?"},"a":{"en":"SRAM does not require periodic refreshing while powered and is commonly used in CPU Cache; DRAM requires periodic refreshing and is used in main system RAM","hi":"पावर रहने तक SRAM को पीरियोडिक रिफ्रेश नहीं चाहिए और यह कैश (Cache) में आम है; DRAM को रिफ्रेश चाहिए और यह मुख्य RAM में आम है"},"o":[{"en":"SRAM does not require periodic refreshing while powered and is commonly used in CPU Cache; DRAM requires periodic refreshing and is used in main system RAM","hi":"पावर रहने तक SRAM को पीरियोडिक रिफ्रेश नहीं चाहिए और यह कैश (Cache) में आम है; DRAM को रिफ्रेश चाहिए और यह मुख्य RAM में आम है"},{"en":"SRAM requires refreshing every millisecond and is used in hard disks; DRAM never needs refreshing and is used in CPU registers","hi":"SRAM को हर मिलीसेकंड में रिफ्रेश करना पड़ता है और यह हार्ड डिस्क में उपयोग होता है; DRAM को कभी रिफ्रेश की आवश्यकता नहीं होती"},{"en":"SRAM is non-volatile optical storage, whereas DRAM is magnetic tape storage","hi":"SRAM नॉन-वोलेटाइल ऑप्टिकल स्टोरेज है, जबकि DRAM मैग्नेटिक टेप स्टोरेज है"},{"en":"DRAM is faster and more expensive per bit than SRAM","hi":"DRAM प्रति बिट SRAM की तुलना में अधिक तेज़ और महंगा होता है"}],"exp":{"en":"SRAM (Static RAM) holds data in transistor flip-flops and does not need periodic refreshing as long as power is supplied; being ultra-fast and costly, it is used for CPU Cache. DRAM (Dynamic RAM) stores charge in capacitors that leak, requiring periodic refresh cycles; being denser and cheaper, it is used as main system RAM.","hi":"SRAM को पावर सप्लाई रहने तक बार-बार रिफ्रेश (periodic refresh) करने की आवश्यकता नहीं होती और यह कैश मेमोरी (Cache) में आम है। इसके विपरीत, DRAM को लगातार रिफ्रेश की आवश्यकता होती है और इसका उपयोग मुख्य सिस्टम RAM में किया जाता है।"},"num":78},{"id":"q79","q":{"en":"What is the full form and fundamental nature of ROM?","hi":"ROM का पूर्ण रूप (Full Form) और इसकी मूल प्रकृति क्या है?"},"a":{"en":"Read-Only Memory — It is non-volatile memory that retains data without power and is mainly read during normal system operation","hi":"रीड-ओनली मेमोरी — यह नॉन-वोलेटाइल (स्थायी) होती है और सामान्य ऑपरेशन में मुख्यतः रीड (read) की जाती है"},"o":[{"en":"Random Optical Memory — Volatile memory erased when the monitor is turned off","hi":"रैंडम ऑप्टिकल मेमोरी — मॉनिटर बंद होने पर मिटने वाली वोलेटाइल मेमोरी"},{"en":"Read-Only Memory — It is non-volatile memory that retains data without power and is mainly read during normal system operation","hi":"रीड-ओनली मेमोरी — यह नॉन-वोलेटाइल (स्थायी) होती है और सामान्य ऑपरेशन में मुख्यतः रीड (read) की जाती है"},{"en":"Register Output Module — A temporary buffer inside an inkjet printer","hi":"रजिस्टर आउटपुट मॉड्यूल — इंकजेट प्रिंटर के अंदर एक अस्थायी बफर"},{"en":"Rapid Operating Microprocessor — The arithmetic core of a supercomputer","hi":"रैपिड ऑपरेटिंग माइक्रोप्रोसेसर — सुपर कंप्यूटर का अंकगणितीय कोर"}],"exp":{"en":"ROM stands for Read-Only Memory. It is a non-volatile primary memory whose contents are retained even when power is turned off, and during normal operation it is primarily read rather than written to.","hi":"ROM का पूर्ण रूप Read-Only Memory है। यह नॉन-वोलेटाइल (non-volatile — बिजली बंद होने पर भी डेटा सुरक्षित रखने वाली) मेमोरी होती है और सामान्य संचालन में मुख्य रूप से रीड (read) की जाती है।"},"num":79},{"id":"q80","q":{"en":"How is ROM related to the booting process of a computer?","hi":"कंप्यूटर की बूटिंग (Booting) प्रक्रिया से ROM का क्या संबंध है?"},"a":{"en":"Boot firmware (such as BIOS/UEFI startup instructions) resides in non-volatile ROM/flash memory so the computer can initialize hardware when powered on","hi":"बूट फर्मवेयर (Boot firmware) नॉन-वोलेटाइल ROM/फ्लैश मेमोरी में रहता है (आधुनिक कंप्यूटरों में रीराइटेबल फ्लैश भी फर्मवेयर स्टोर करती है)"},"o":[{"en":"Boot firmware (such as BIOS/UEFI startup instructions) resides in non-volatile ROM/flash memory so the computer can initialize hardware when powered on","hi":"बूट फर्मवेयर (Boot firmware) नॉन-वोलेटाइल ROM/फ्लैश मेमोरी में रहता है (आधुनिक कंप्यूटरों में रीराइटेबल फ्लैश भी फर्मवेयर स्टोर करती है)"},{"en":"ROM deletes the operating system every time the computer boots","hi":"जब भी कंप्यूटर बूट होता है तो ROM ऑपरेटिंग सिस्टम को डिलीट कर देता है"},{"en":"Booting requires erasing ROM with ultraviolet light before every startup","hi":"हर स्टार्टअप से पहले बूटिंग के लिए पराबैंगनी प्रकाश से ROM को मिटाना पड़ता है"},{"en":"ROM has no role in booting because all startup firmware is stored in volatile SRAM cache","hi":"बूटिंग में ROM की कोई भूमिका नहीं है क्योंकि सारा स्टार्टअप फर्मवेयर वोलेटाइल SRAM कैश में रहता है"}],"exp":{"en":"When a computer is powered on, main RAM is empty, so the CPU executes essential startup/boot firmware (BIOS/UEFI) stored permanently in non-volatile ROM (in modern systems, rewritable flash/EEPROM memory is used to store this firmware).","hi":"कंप्यूटर को चालू (boot) करने के लिए आवश्यक बूट फर्मवेयर (boot firmware / BIOS) नॉन-वोलेटाइल ROM में रहता है। आधुनिक कंप्यूटरों में रीराइटेबल फ्लैश मेमोरी (rewritable flash/EEPROM) भी यह फर्मवेयर स्टोर करती है।"},"num":80},{"id":"q81","q":{"en":"What is the full form and key feature of PROM?","hi":"PROM का पूर्ण रूप (Full Form) और मुख्य विशेषता क्या है?"},"a":{"en":"Programmable Read-Only Memory — Traditional PROM is a one-time programmable (OTP) memory that can be programmed only once after manufacturing","hi":"प्रोग्रामेबल रीड-ओनली मेमोरी — पारंपरिक PROM को निर्माण के बाद केवल एक बार प्रोग्राम किया जा सकता है"},"o":[{"en":"Primary Random Optical Memory — It can be rewritten millions of times using laser beams","hi":"प्राइमरी रैंडम ऑप्टिकल मेमोरी — इसे लेजर किरणों से लाखों बार लिखा जा सकता है"},{"en":"Programmable Read-Only Memory — Traditional PROM is a one-time programmable (OTP) memory that can be programmed only once after manufacturing","hi":"प्रोग्रामेबल रीड-ओनली मेमोरी — पारंपरिक PROM को निर्माण के बाद केवल एक बार प्रोग्राम किया जा सकता है"},{"en":"Processor Register Output Module — It is a volatile register inside the ALU","hi":"प्रोसेसर रजिस्टर आउटपुट मॉड्यूल — यह ALU के अंदर एक वोलेटाइल रजिस्टर है"},{"en":"Parallel Ribbon Operating Mechanism — Used in dot matrix printers","hi":"पैरेलल रिबन ऑपरेटिंग मैकेनिज्म — डॉट मैट्रिक्स प्रिंटर में प्रयुक्त"}],"exp":{"en":"PROM stands for Programmable Read-Only Memory. Unlike mask ROM, a blank PROM chip can be programmed by the user/engineer after manufacturing, but a traditional PROM can be programmed only once (One-Time Programmable).","hi":"PROM का पूर्ण रूप Programmable Read-Only Memory है। पारंपरिक PROM की मुख्य विशेषता यह है कि इसे केवल एक बार (one-time) प्रोग्राम किया जा सकता है।"},"num":81},{"id":"q82","q":{"en":"What is the full form of EPROM, and how is a classic EPROM erased?","hi":"EPROM का पूर्ण रूप क्या है और क्लासिक EPROM को कैसे मिटाया (Erase) जाता है?"},"a":{"en":"Erasable Programmable Read-Only Memory — Classic EPROM is erased by exposing its quartz window to strong Ultraviolet (UV) light","hi":"इरेज़ेबल प्रोग्रामेबल रीड-ओनली मेमोरी — क्लासिक EPROM को पराबैंगनी प्रकाश (Ultraviolet light) से मिटाया जाता है"},"o":[{"en":"Electronic Parallel Read-Only Memory — Erased by dipping in water","hi":"इलेक्ट्रॉनिक पैरेलल रीड-ओनली मेमोरी — पानी में डुबोकर मिटाई जाती है"},{"en":"Erasable Programmable Read-Only Memory — Classic EPROM is erased by exposing its quartz window to strong Ultraviolet (UV) light","hi":"इरेज़ेबल प्रोग्रामेबल रीड-ओनली मेमोरी — क्लासिक EPROM को पराबैंगनी प्रकाश (Ultraviolet light) से मिटाया जाता है"},{"en":"External Peripheral Random Memory — Erased by pressing the Caps Lock key","hi":"एक्सटर्नल पेरिफेरल रैंडम मेमोरी — Caps Lock कुंजी दबाकर मिटाई जाती है"},{"en":"Extended Permanent Ribbon Memory — Erased using a magnetic degaussing coil","hi":"एक्सटेंडेड परमानेंट रिबन मेमोरी — चुंबकीय डीगॉसिंग कॉइल से मिटाई जाती है"}],"exp":{"en":"EPROM stands for Erasable Programmable Read-Only Memory. A classic UV-EPROM chip can be erased by exposing its transparent quartz window to strong Ultraviolet (UV) light and then reprogrammed.","hi":"EPROM का पूर्ण रूप Erasable Programmable Read-Only Memory है। क्लासिक EPROM को पराबैंगनी प्रकाश (Ultraviolet / UV light) की सहायता से मिटाया (erase) जाता है।"},"num":82},{"id":"q83","q":{"en":"What is the full form of EEPROM, and how is it erased and reprogrammed?","hi":"EEPROM का पूर्ण रूप क्या है और इसे कैसे मिटाया व रीप्रोग्राम किया जाता है?"},"a":{"en":"Electrically Erasable Programmable Read-Only Memory — It can be erased and reprogrammed electrically without removing it from the circuit","hi":"इलेक्ट्रिकली इरेज़ेबल प्रोग्रामेबल रीड-ओनली मेमोरी — इसे विद्युत संकेतों (electrically) से मिटाया और रीप्रोग्राम किया जा सकता है"},"o":[{"en":"Electrically Erasable Programmable Read-Only Memory — It can be erased and reprogrammed electrically without removing it from the circuit","hi":"इलेक्ट्रिकली इरेज़ेबल प्रोग्रामेबल रीड-ओनली मेमोरी — इसे विद्युत संकेतों (electrically) से मिटाया और रीप्रोग्राम किया जा सकता है"},{"en":"Enhanced External Paper Read-Only Memory — Erased using mechanical erasers","hi":"एन्हांस्ड एक्सटर्नल पेपर रीड-ओनली मेमोरी — यांत्रिक रबर से मिटाई जाती है"},{"en":"Emergency Execution Primary Read-Only Memory — Erased only by x-ray beams","hi":"इमरजेंसी एक्जीक्यूशन प्राइमरी रीड-ओनली मेमोरी — केवल एक्स-रे किरणों से मिटाई जाती है"},{"en":"Electro-Optical Emitter Read-Only Memory — Cannot be erased once written","hi":"इलेक्ट्रो-ऑप्टिकल एमीटर रीड-ओनली मेमोरी — एक बार लिखने के बाद मिटाई नहीं जा सकती"}],"exp":{"en":"EEPROM stands for Electrically Erasable Programmable Read-Only Memory. It can be erased and reprogrammed electrically in-circuit using electrical voltage pulses, without needing UV light.","hi":"EEPROM का पूर्ण रूप Electrically Erasable Programmable Read-Only Memory है। इसे विद्युत संकेतों (electrically) द्वारा आसानी से मिटाया (erase) और रीप्रोग्राम किया जा सकता है।"},"num":83},{"id":"q84","q":{"en":"Why is Secondary Memory also called 'Auxiliary Storage', and how does it compare to RAM?","hi":"सेकेंडरी मेमोरी (Secondary Memory) को 'ऑक्जिलरी स्टोरेज' (Auxiliary Storage) क्यों कहते हैं, और यह RAM से कैसे भिन्न है?"},"a":{"en":"It stores long-term data and backups; it is non-volatile and generally slower than RAM, but has much higher storage capacity","hi":"यह लंबे समय तक डेटा और बैकअप स्टोर करती है; यह नॉन-वोलेटाइल होती है और RAM से आम तौर पर धीमी, पर अधिक क्षमता (higher-capacity) वाली होती है"},"o":[{"en":"It stores long-term data and backups; it is non-volatile and generally slower than RAM, but has much higher storage capacity","hi":"यह लंबे समय तक डेटा और बैकअप स्टोर करती है; यह नॉन-वोलेटाइल होती है और RAM से आम तौर पर धीमी, पर अधिक क्षमता (higher-capacity) वाली होती है"},{"en":"It is placed inside the ALU and is 100 times faster but smaller than CPU registers","hi":"यह ALU के अंदर रखी जाती है और CPU रजिस्टरों से 100 गुना तेज़ लेकिन छोटी होती है"},{"en":"It is a volatile memory that loses all backup files when the computer is shut down","hi":"यह एक वोलेटाइल मेमोरी है जो कंप्यूटर बंद होने पर सभी बैकअप फ़ाइलें खो देती है"},{"en":"It is used only to control LCD pixels in a monitor","hi":"इसका उपयोग केवल मॉनिटर में LCD पिक्सल्स को नियंत्रित करने के लिए किया जाता है"}],"exp":{"en":"Secondary memory is called auxiliary (or backing) storage because it supports main memory by storing data, programs, and backups permanently for the long term. It is non-volatile and generally slower than RAM, but offers much larger capacity at a lower cost per byte.","hi":"सेकेंडरी मेमोरी को ऑक्जिलरी (सहायक) स्टोरेज इसलिए कहते हैं क्योंकि यह लंबे समय तक डेटा और बैकअप को सुरक्षित रखती है। यह नॉन-वोलेटाइल (स्थायी) होती है और RAM से आम तौर पर धीमी, परंतु काफी अधिक क्षमता (higher-capacity) वाली होती है।"},"num":84}]},{"title":{"en":"7. Secondary Storage, Flash & Virtual Memory","hi":"7. सेकेंडरी स्टोरेज, फ्लैश और वर्चुअल मेमोरी"},"questions":[{"id":"q85","q":{"en":"Which of the following are the three main tecnología/media categories of Secondary Storage?","hi":"सेकेंडरी स्टोरेज (Secondary Storage) की तीन मुख्य तकनीकें कौन-सी हैं?"},"a":{"en":"Magnetic (HDD, tape), Optical (CD, DVD, Blu-ray), and Solid-State/Flash (SSD, memory card, USB drive)","hi":"मैग्नेटिक (HDD, टेप), ऑप्टिकल (CD, DVD, ब्लू-रे) और सॉलिड-स्टेट/फ्लैश (SSD, मेमोरी कार्ड, USB ड्राइव)"},"o":[{"en":"Magnetic (HDD, tape), Optical (CD, DVD, Blu-ray), and Solid-State/Flash (SSD, memory card, USB drive)","hi":"मैग्नेटिक (HDD, टेप), ऑप्टिकल (CD, DVD, ब्लू-रे) और सॉलिड-स्टेट/फ्लैश (SSD, मेमोरी कार्ड, USB ड्राइव)"},{"en":"SRAM, DRAM, and CPU Registers","hi":"SRAM, DRAM और CPU रजिस्टर"},{"en":"ALU, Control Unit, and System Bus","hi":"ALU, कंट्रोल यूनिट और सिस्टम बस"},{"en":"Dot Matrix, Inkjet, and Laser","hi":"डॉट मैट्रिक्स, इंकजेट और लेजर"}],"exp":{"en":"Secondary storage technologies are broadly categorized into three types: Magnetic storage (Hard Disk Drive, Magnetic Tape, Floppy Disk), Optical storage (CD, DVD, Blu-ray Disc), and Solid-State/Flash storage (SSD, USB flash drive, SD memory card).","hi":"सेकेंडरी स्टोरेज की तीन मुख्य तकनीकें हैं: मैग्नेटिक (Magnetic — जैसे HDD, मैग्नेटिक टेप), ऑप्टिकल (Optical — जैसे CD, DVD, Blu-ray) और सॉलिड-स्टेट/फ्लैश (Solid-state/Flash — जैसे SSD, मेमोरी कार्ड, USB पेन ड्राइव)।"},"num":85},{"id":"q86","q":{"en":"How is a 'Magnetic Tape' constructed and how does it record data?","hi":"'मैग्नेटिक टेप' (Magnetic Tape) किस सामग्री से बनती है और डेटा कैसे रिकॉर्ड करती है?"},"a":{"en":"It consists of a thin plastic ribbon/tape coated with a magnetizable material on which data is recorded magnetically","hi":"इसमें प्लास्टिक टेप पर चुंबकीय कोटिंग (magnetic coating) होती है और डेटा चुंबकीय रूप से (magnetically) रिकॉर्ड होता है"},"o":[{"en":"It consists of a thin plastic ribbon/tape coated with a magnetizable material on which data is recorded magnetically","hi":"इसमें प्लास्टिक टेप पर चुंबकीय कोटिंग (magnetic coating) होती है और डेटा चुंबकीय रूप से (magnetically) रिकॉर्ड होता है"},{"en":"It is a rigid glass plate etched by ultraviolet light","hi":"यह पराबैंगनी प्रकाश द्वारा उकेरी गई एक कठोर कांच की प्लेट है"},{"en":"It is a copper wire that stores data using liquid ink droplets","hi":"यह एक तांबे का तार है जो तरल स्याही की बूँदों का उपयोग करके डेटा स्टोर करता है"},{"en":"It is a silicon wafer containing millones of flip-flop latches","hi":"यह एक सिलिकॉन वेफर है जिसमें लाखों फ्लिप-फ्लॉप लैच होते हैं"}],"exp":{"en":"Magnetic tape is made of a thin, flexible plastic ribbon coated with a ferromagnetic (magnetic) material, where data is recorded and read magnetically along tracks.","hi":"मैग्नेटिक टेप में प्लास्टिक की पट्टी (plastic tape) पर चुंबकीय परत (magnetic coating) चढ़ी होती है और उस पर डेटा चुंबकीय रूप से (magnetically) रिकॉर्ड किया जाता है।"},"num":86},{"id":"q87","q":{"en":"What is the full form of SASD, and which storage medium is its classic example?","hi":"SASD का पूर्ण रूप (Full Form) और इसका मानक उदाहरण क्या है?"},"a":{"en":"Sequential Access Storage Device — Magnetic tape is the standard example, where records must be traversed in sequence to reach the desired data","hi":"सीक्वेंशियल एक्सेस स्टोरेज डिवाइस — मैग्नेटिक टेप इसका उदाहरण है, जिसमें वांछित डेटा तक पहुँचने के लिए रिकॉर्ड्स को क्रम (sequence) में पार करना पड़ता है"},"o":[{"en":"Sequential Access Storage Device — Magnetic tape is the standard example, where records must be traversed in sequence to reach the desired data","hi":"सीक्वेंशियल एक्सेस स्टोरेज डिवाइस — मैग्नेटिक टेप इसका उदाहरण है, जिसमें वांछित डेटा तक पहुँचने के लिए रिकॉर्ड्स को क्रम (sequence) में पार करना पड़ता है"},{"en":"Static Arithmetic Storage Device — CPU Cache is the standard example","hi":"स्टैटिक अरिथमेटिक स्टोरेज डिवाइस — CPU कैश इसका मानक उदाहरण है"},{"en":"Solid Array Semiconductor Drive — NVMe SSD is the standard example","hi":"सॉलिड ऐरे सेमीकंडक्टर ड्राइव — NVMe SSD इसका मानक उदाहरण है"},{"en":"Single Address System Disk — RAM is the standard example","hi":"सिंगल एड्रेस सिस्टम डिस्क — RAM इसका मानक उदाहरण है"}],"exp":{"en":"SASD stands for Sequential Access Storage Device. Magnetic tape is the classic example of SASD because to reach a specific data record, the tape drive must wind past all preceding records in sequential order.","hi":"SASD का पूर्ण रूप Sequential Access Storage Device है। मैग्नेटिक टेप (Magnetic tape) इसका मानक उदाहरण है, क्योंकि इसमें किसी डेटा तक पहुँचने के लिए उससे पहले के सभी रिकॉर्ड्स को क्रम (sequence) में पार करना पड़ता है।"},"num":87},{"id":"q88","q":{"en":"What is used to read and write data on Optical Storage media like CD and DVD?","hi":"CD और DVD जैसे ऑप्टिकल स्टोरेज मीडिया को रीड (Read) करने के लिए किसका उपयोग होता है?"},"a":{"en":"A focused Laser beam (both CD and DVD are optical storage media)","hi":"लेजर बीम (Laser beam — दोनों ऑप्टिकल स्टोरेज मीडिया हैं)"},"o":[{"en":"A mechanical metal pin striking a carbon ribbon","hi":"कार्बन रिबन पर प्रहार करने वाली एक यांत्रिक धातु पिन"},{"en":"A focused Laser beam (both CD and DVD are optical storage media)","hi":"लेजर बीम (Laser beam — दोनों ऑप्टिकल स्टोरेज मीडिया हैं)"},{"en":"A magnetic iron-oxide read/write head touching the platter","hi":"प्लैटर को छूने वाला एक चुंबकीय आयरन-ऑक्साइड रीड/राइट हेड"},{"en":"An acoustic microphone transducer","hi":"एक ध्वनिक माइक्रोफोन ट्रांसड्यूसर"}],"exp":{"en":"Optical discs such as CDs, DVDs, and Blu-ray Discs store data as microscopic pits and lands on a reflective layer, which are read (and written) using a focused Laser beam.","hi":"CD और DVD को रीड (व राइट) करने के लिए लेजर बीम (Laser beam) का उपयोग किया जाता है। ये दोनों ऑप्टिकल स्टोरेज मीडिया (optical storage media) हैं।"},"num":88},{"id":"q89","q":{"en":"What are the typical standard storage capacities of a 3½-inch HD Floppy Disk, a standard CD, and a single-layer DVD?","hi":"एक सामान्य 3½-इंच HD फ्लॉपी डिस्क, एक मानक CD और सिंगल-लेयर DVD की विशिष्ट स्टोरेज क्षमताएँ (Capacities) क्या हैं?"},"a":{"en":"3½-inch HD Floppy: 1.44 MB; standard CD: up to 700 MB; single-layer DVD: 4.7 GB","hi":"3½-इंच HD फ्लॉपी: 1.44 MB; सामान्य CD: 700 MB तक; सिंगल-लेयर DVD: 4.7 GB"},"o":[{"en":"3½-inch HD Floppy: 1.44 MB; standard CD: up to 700 MB; single-layer DVD: 4.7 GB","hi":"3½-इंच HD फ्लॉपी: 1.44 MB; सामान्य CD: 700 MB तक; सिंगल-लेयर DVD: 4.7 GB"},{"en":"3½-inch HD Floppy: 700 GB; standard CD: 4.7 TB; single-layer DVD: 1.44 KB","hi":"3½-इंच HD फ्लॉपी: 700 GB; सामान्य CD: 4.7 TB; सिंगल-लेयर DVD: 1.44 KB"},{"en":"3½-inch HD Floppy: 25 GB; standard CD: 50 GB; single-layer DVD: 200 GB","hi":"3½-इंच HD फ्लॉपी: 25 GB; सामान्य CD: 50 GB; सिंगल-लेयर DVD: 200 GB"},{"en":"All three media store exactly 100 MB each","hi":"तीनों मीडिया में से प्रत्येक ठीक 100 MB स्टोर करता है"}],"exp":{"en":"For competitive exams, remember these standard capacities: a common 3.5-inch High-Density (HD) Floppy Disk holds 1.44 MB, a standard Compact Disc (CD) holds up to 700 MB, and a single-sided single-layer DVD holds 4.7 GB.","hi":"परीक्षा के लिए याद रखने योग्य मानक क्षमताएँ: सामान्य 3½-इंच HD फ्लॉपी डिस्क = 1.44 MB, सामान्य CD = 700 MB तक, और सिंगल-लेयर DVD = 4.7 GB।"},"num":89},{"id":"q90","q":{"en":"What are the standard single-layer and dual-layer storage capacities of a Blu-ray Disc (BD / BRD)?","hi":"ब्लू-रे डिस्क (Blu-ray Disc — BD/BRD) की मानक सिंगल-लेयर और डुअल-लेयर क्षमताएँ कितनी होती हैं?"},"a":{"en":"Single-layer: 25 GB; Dual-layer: 50 GB (notes write BRD for Blu-ray; BD is the common industry abbreviation)","hi":"सिंगल-लेयर: 25 GB; डुअल-लेयर: 50 GB (अध्याय में इसे BRD लिखा गया है, और BD सामान्य संक्षिप्त नाम है)"},"o":[{"en":"Single-layer: 1.44 MB; Dual-layer: 2.88 MB","hi":"सिंगल-लेयर: 1.44 MB; डुअल-लेयर: 2.88 MB"},{"en":"Single-layer: 700 MB; Dual-layer: 1.4 GB","hi":"सिंगल-लेयर: 700 MB; डुअल-लेयर: 1.4 GB"},{"en":"Single-layer: 25 GB; Dual-layer: 50 GB (notes write BRD for Blu-ray; BD is the common industry abbreviation)","hi":"सिंगल-लेयर: 25 GB; डुअल-लेयर: 50 GB (अध्याय में इसे BRD लिखा गया है, और BD सामान्य संक्षिप्त नाम है)"},{"en":"Single-layer: 4.7 GB; Dual-layer: 8.5 GB","hi":"सिंगल-लेयर: 4.7 GB; डुअल-लेयर: 8.5 GB"}],"exp":{"en":"A standard Blu-ray Disc (abbreviated as BD, or BRD in the chapter notes) stores 25 GB on a single-layer disc and 50 GB on a dual-layer disc.","hi":"ब्लू-रे डिस्क (Blu-ray Disc) की मानक सिंगल-लेयर क्षमता 25 GB और डुअल-लेयर क्षमता 50 GB होती है (अध्याय में इसके लिए BRD लिखा गया है, जबकि BD भी सामान्य संक्षिप्त नाम है)।"},"num":90},{"id":"q91","q":{"en":"What is the full form and recording principle of HVD, and what capacities are mentioned in the notes?","hi":"HVD का पूर्ण रूप और सिद्धांत क्या है, तथा नोट्स में इसकी क्षमता के बारे में क्या उल्लेख है?"},"a":{"en":"Holographic Versatile Disc — An optical-disc format that stores data using collinear holographic recording (slide mentions TB / 6 TB; an Ecma recordable-cartridge standard example is 200 GB)","hi":"होलोग्राफिक वर्सटाइल डिस्क — होलोग्राफिक रिकॉर्डिंग से डेटा स्टोर करने वाला ऑप्टिकल-डिस्क फॉर्मेट (स्लाइड में TB/6 TB और Ecma मानक में 200 GB का उदाहरण है)"},"o":[{"en":"Holographic Versatile Disc — An optical-disc format that stores data using collinear holographic recording (slide mentions TB / 6 TB; an Ecma recordable-cartridge standard example is 200 GB)","hi":"होलोग्राफिक वर्सटाइल डिस्क — होलोग्राफिक रिकॉर्डिंग से डेटा स्टोर करने वाला ऑप्टिकल-डिस्क फॉर्मेट (स्लाइड में TB/6 TB और Ecma मानक में 200 GB का उदाहरण है)"},{"en":"Hard Volatile Drive — A magnetic drive that loses data when power is off","hi":"हार्ड वोलेटाइल ड्राइव — एक चुंबकीय ड्राइव जो बिजली बंद होने पर डेटा खो देती है"},{"en":"High Voltage Display — A CRT monitor requiring 50,000 volts","hi":"हाई वोल्टेज डिस्प्ले — 50,000 वोल्ट की आवश्यकता वाला एक CRT मॉनिटर"},{"en":"Handheld Visual Digitizer — A pocket barcode scanner with 1.44 MB capacity","hi":"हैंडहेल्ड विजुअल डिजिटाइज़र — 1.44 MB क्षमता वाला एक पॉकेट बारकोड स्कैनर"}],"exp":{"en":"HVD stands for Holographic Versatile Disc, an advanced optical disc technology that uses holographic recording (red and green/blue lasers) to store data in three-dimensional holograms. Exam slides often mention multi-terabyte (up to 6 TB) theoretical capacities, while Ecma standards defined a 200 GB recordable cartridge.","hi":"HVD का पूर्ण रूप Holographic Versatile Disc है। यह होलोग्राफिक रिकॉर्डिंग सिद्धांत से डेटा स्टोर करने वाला ऑप्टिकल-डिस्क फॉर्मेट है (स्लाइड में TB/6 TB का उल्लेख है, जबकि Ecma के रिकॉर्डेबल-कार्ट्रिज मानक का एक उदाहरण 200 GB है)।"},"num":91},{"id":"q92","q":{"en":"What is the key property of 'Flash Memory', and in which devices is it commonly used?","hi":"'फ्लैश मेमोरी' (Flash Memory) का मुख्य गुण क्या है और यह किन उपकरणों में उपयोग होती है?"},"a":{"en":"It is an electrically writable and erasable non-volatile solid-state memory, widely used in USB pen drives, memory cards, and SSDs","hi":"यह इलेक्ट्रिकली राइटेबल नॉन-वोलेटाइल मेमोरी है, जिसका उपयोग पेन ड्राइव, मेमोरी कार्ड और SSD में होता है"},"o":[{"en":"It is an electrically writable and erasable non-volatile solid-state memory, widely used in USB pen drives, memory cards, and SSDs","hi":"यह इलेक्ट्रिकली राइटेबल नॉन-वोलेटाइल मेमोरी है, जिसका उपयोग पेन ड्राइव, मेमोरी कार्ड और SSD में होता है"},{"en":"It is a volatile mechanical memory used only in 1940s vacuum-tube computers","hi":"यह एक वोलेटाइल यांत्रिक मेमोरी है जिसका उपयोग केवल 1940 के दशक के वैक्यूम-ट्यूब कंप्यूटरों में होता था"},{"en":"It requires spinning magnetic platters and moving read/write heads","hi":"इसमें घूमने वाली चुंबकीय प्लेटों और मूविंग रीड/राइट हेड्स की आवश्यकता होती है"},{"en":"It can only be erased by exposing it to sunlight for 24 hours","hi":"इसे केवल 24 घंटे धूप में रखकर ही मिटाया जा सकता है"}],"exp":{"en":"Flash memory (a type of EEPROM) is an electrically erasable and writable non-volatile solid-state memory with no moving parts. It is the core storage technology inside USB flash drives (pen drives), SD/microSD memory cards, and Solid-State Drives (SSDs).","hi":"फ्लैश मेमोरी एक इलेक्ट्रिकली राइटेबल नॉन-वोलेटाइल (स्थायी) सॉलिड-स्टेट मेमोरी है। इसका व्यापक उपयोग पेन ड्राइव (USB flash drives), मेमोरी कार्ड्स और SSD (Solid-State Drives) में होता है।"},"num":92},{"id":"q93","q":{"en":"What is 'Virtual Memory' in an operating system?","hi":"ऑपरेटिंग सिस्टम में 'वर्चुअल मेमोरी' (Virtual Memory) क्या है?"},"a":{"en":"A memory management technique where the OS provides processes with a virtual address space and can temporarily swap inactive memory pages to a pagefile/swap area on the HDD or SSD","hi":"एक तकनीक जिसमें OS प्रोसेस को वर्चुअल एड्रेस स्पेस देता है और ज़रूरत पड़ने पर कुछ मेमोरी पेजों को HDD/SSD के पेजफ़ाइल या स्वैप एरिया में रख सकता है"},"o":[{"en":"A memory management technique where the OS provides processes with a virtual address space and can temporarily swap inactive memory pages to a pagefile/swap area on the HDD or SSD","hi":"एक तकनीक जिसमें OS प्रोसेस को वर्चुअल एड्रेस स्पेस देता है और ज़रूरत पड़ने पर कुछ मेमोरी पेजों को HDD/SSD के पेजफ़ाइल या स्वैप एरिया में रख सकता है"},{"en":"A physical SRAM chip soldered directly inside the Arithmetic Logic Unit","hi":"अरिथमेटिक लॉजिक यूनिट के अंदर सीधे सोल्डर की गई एक भौतिक SRAM चिप"},{"en":"An optical CD-ROM disc used to install printer drivers","hi":"प्रिंटर ड्राइवर इंस्टॉल करने के लिए प्रयुक्त एक ऑप्टिकल CD-ROM डिस्क"},{"en":"A cloud storage account accessed only through a web browser","hi":"केवल वेब ब्राउज़र के माध्यम से एक्सेस किया जाने वाला एक क्लाउड स्टोरेज खाता"}],"exp":{"en":"Virtual memory is a memory management capability of an OS that gives applications the illusion of a large, contiguous address space by using a portion of secondary storage (a pagefile or swap space on HDD/SSD) to hold inactive pages when physical RAM fills up.","hi":"वर्चुअल मेमोरी एक मेमोरी प्रबंधन तकनीक है जिसमें ऑपरेटिंग सिस्टम (OS) किसी प्रोसेस को वर्चुअल एड्रेस स्पेस देता है और ज़रूरत पड़ने पर कुछ मेमोरी पेजों को HDD या SSD के पेजफ़ाइल (pagefile) या स्वैप एरिया (swap area) में रख सकता है।"},"num":93},{"id":"q94","q":{"en":"How does the speed of Virtual Memory compare to physical RAM?","hi":"वर्चुअल मेमोरी और फिजिकल RAM की गति (Speed) में क्या फर्क है?"},"a":{"en":"Fetching storage-backed pages from disk/SSD is slower than direct physical RAM access; virtual memory increases usable address space, not physical RAM speed","hi":"स्टोरेज से पेजों को वापस लाना प्रत्यक्ष RAM एक्सेस से धीमा (slow) होता है; वर्चुअल मेमोरी फिजिकल RAM की गति नहीं बढ़ाती"},"o":[{"en":"Fetching storage-backed pages from disk/SSD is slower than direct physical RAM access; virtual memory increases usable address space, not physical RAM speed","hi":"स्टोरेज से पेजों को वापस लाना प्रत्यक्ष RAM एक्सेस से धीमा (slow) होता है; वर्चुअल मेमोरी फिजिकल RAM की गति नहीं बढ़ाती"},{"en":"Virtual memory is 1,000 times faster than CPU L1 cache and physical RAM","hi":"वर्चुअल मेमोरी CPU के L1 कैश और फिजिकल RAM से 1,000 गुना तेज़ होती है"},{"en":"Virtual memory doubles the clock frequency of the CPU and RAM modules","hi":"वर्चुअल मेमोरी CPU और RAM मॉड्यूल की क्लॉक फ्रीक्वेंसी को दोगुना कर देती है"},{"en":"There is no speed difference between a hard disk pagefile and SRAM cache","hi":"हार्ड डिस्क पेजफ़ाइल और SRAM कैश की गति में कोई अंतर नहीं है"}],"exp":{"en":"Swapping pages in and out of secondary storage (HDD/SSD) is significantly slower than accessing physical RAM directly. Therefore, virtual memory allows larger programs/multitasking to run when RAM is limited, but it does not increase the physical speed of RAM.","hi":"सेकेंडरी स्टोरेज (HDD/SSD) में रखे पेजों को वापस RAM में लाना प्रत्यक्ष RAM एक्सेस की तुलना में धीमा (slow) होता है। वर्चुअल मेमोरी उपलब्ध मेमोरी स्पेस को बढ़ाती है, लेकिन फिजिकल RAM की गति (speed) नहीं बढ़ाती।"},"num":94},{"id":"q95","q":{"en":"Why do both a USB Pen Drive and a Hard Disk Drive (HDD) retain data even when power is turned off?","hi":"पेन ड्राइव (Pen Drive) और हार्ड डिस्क ड्राइव (HDD) दोनों पावर ऑफ होने पर भी डेटा क्यों सुरक्षित रखते हैं?"},"a":{"en":"Because both are non-volatile storage devices — a pen drive uses solid-state flash memory and an HDD uses magnetic recording","hi":"क्योंकि दोनों नॉन-वोलेटाइल (non-volatile) स्टोरेज हैं — पेन ड्राइव फ्लैश मेमोरी उपयोग करती है और HDD मैग्नेटिक रिकॉर्डिंग"},"o":[{"en":"Because both have hidden lithium batteries that refresh DRAM capacitors","hi":"क्योंकि दोनों में छिपी हुई लिथियम बैटरियाँ होती हैं जो DRAM कैपेसिटर को रिफ्रेश करती हैं"},{"en":"Because both are non-volatile storage devices — a pen drive uses solid-state flash memory and an HDD uses magnetic recording","hi":"क्योंकि दोनों नॉन-वोलेटाइल (non-volatile) स्टोरेज हैं — पेन ड्राइव फ्लैश मेमोरी उपयोग करती है और HDD मैग्नेटिक रिकॉर्डिंग"},{"en":"Because both use laser beams to burn permanent holes into paper","hi":"क्योंकि दोनों कागज में स्थायी छेद करने के लिए लेजर किरणों का उपयोग करते हैं"},{"en":"Because both are volatile primary memories located inside the CPU","hi":"क्योंकि दोनों CPU के अंदर स्थित वोलेटाइल प्राइमरी मेमोरी हैं"}],"exp":{"en":"Both USB pen drives and HDDs are non-volatile secondary storage devices that do not require power to maintain recorded state: pen drives store charge in floating-gate flash memory cells, while HDDs store data as magnetic polarities on platters.","hi":"क्योंकि पेन ड्राइव और HDD दोनों नॉन-वोलेटाइल (non-volatile — स्थायी) स्टोरेज हैं। पेन ड्राइव में फ्लैश मेमोरी (flash memory) का उपयोग होता है और HDD में मैग्नेटिक रिकॉर्डिंग (magnetic recording) का।"},"num":95},{"id":"q96","q":{"en":"Why is Magnetic Tape still used for large archival storage and backups?","hi":"स्टोरेज बैकअप और बड़े आर्काइव्स (Archives) के लिए मैग्नेटिक टेप का उपयोग क्यों किया जाता है?"},"a":{"en":"Because it allows large archives or backup sets to be stored economically using sequential access","hi":"क्योंकि सीक्वेंशियल एक्सेस (sequential access) के साथ बड़े आर्काइव्स या बैकअप सेट्स को कम लागत में स्टोर किया जा सकता है"},"o":[{"en":"Because it allows large archives or backup sets to be stored economically using sequential access","hi":"क्योंकि सीक्वेंशियल एक्सेस (sequential access) के साथ बड़े आर्काइव्स या बैकअप सेट्स को कम लागत में स्टोर किया जा सकता है"},{"en":"Because it has the fastest random access speed, beating L1 CPU cache","hi":"क्योंकि इसमें सबसे तेज़ रैंडम एक्सेस स्पीड होती है, जो L1 CPU कैश को भी पीछे छोड़ देती है"},{"en":"Because it is used directly by the ALU to store status flags","hi":"क्योंकि इसका उपयोग सीधे ALU द्वारा स्टेटस फ्लैग्स को स्टोर करने के लिए किया जाता है"},{"en":"Because it requires no tape drive or reader to access files","hi":"क्योंकि फ़ाइलों को एक्सेस करने के लिए इसमें किसी टेप ड्राइव या रीडर की आवश्यकता नहीं होती"}],"exp":{"en":"Although magnetic tape uses slow sequential access, it offers high capacity, low cost per gigabyte, and long shelf life, making it suitable for storing massive offline archives and sequential backup sets.","hi":"मैग्नेटिक टेप में सीक्वेंशियल एक्सेस (sequential access) के साथ बहुत बड़े आर्काइव्स (large archives) या बैकअप सेट्स को किफायती रूप से लंबे समय के लिए स्टोर किया जा सकता है।"},"num":96}]},{"title":{"en":"8. Bits, Bytes & Memory Unit Conversions","hi":"8. बिट, बाइट और मेमोरी यूनिट रूपांतरण"},"questions":[{"id":"q97","q":{"en":"What is a 'Bit' in digital computing?","hi":"डिजिटल कंप्यूटिंग में 'बिट' (Bit) क्या है?"},"a":{"en":"A Binary Digit, which is the smallest unit of data and can have a value of either 0 or 1","hi":"बाइनरी डिजिट (Binary digit), जो डेटा की सबसे छोटी इकाई है और जिसका मान 0 या 1 हो सकता है"},"o":[{"en":"A group of 1,024 bytes","hi":"1,024 बाइट्स का एक समूह"},{"en":"A Binary Digit, which is the smallest unit of data and can have a value of either 0 or 1","hi":"बाइनरी डिजिट (Binary digit), जो डेटा की सबसे छोटी इकाई है और जिसका मान 0 या 1 हो सकता है"},{"en":"An 8-character hexadecimal password","hi":"8-अक्षरों का एक हेक्साडेसिमल पासवर्ड"},{"en":"A physical pin on a VGA monitor cable","hi":"VGA मॉनिटर केबल पर लगा एक भौतिक पिन"}],"exp":{"en":"The word 'Bit' is short for Binary Digit. It is the smallest fundamental unit of digital information in a computer and can hold one of two discrete values: 0 or 1.","hi":"बिट (Bit) का अर्थ 'बाइनरी डिजिट' (Binary digit) है, जिसकी वैल्यू केवल 0 या 1 हो सकती है। यह कंप्यूटर डेटा की सबसे छोटी इकाई है।"},"num":97},{"id":"q98","q":{"en":"How many bits are there in a 'Nibble' and in a 'Byte' respectively?","hi":"एक 'निबल' (Nibble) और एक 'बाइट' (Byte) में क्रमशः कितने बिट्स होते हैं?"},"a":{"en":"4 bits in a nibble and 8 bits in a byte","hi":"निबल में 4 बिट्स और बाइट में 8 बिट्स"},"o":[{"en":"2 bits in a nibble and 4 bits in a byte","hi":"निबल में 2 बिट्स और बाइट में 4 बिट्स"},{"en":"4 bits in a nibble and 8 bits in a byte","hi":"निबल में 4 बिट्स और बाइट में 8 बिट्स"},{"en":"8 bits in a nibble and 16 bits in a byte","hi":"निबल में 8 बिट्स और बाइट में 16 बिट्स"},{"en":"10 bits in a nibble and 100 bits in a byte","hi":"निबल में 10 बिट्स और बाइट में 100 बिट्स"}],"exp":{"en":"A Nibble consists of 4 bits (half a byte), and a Byte consists of 8 bits.","hi":"एक निबल (Nibble) में 4 बिट्स होते हैं और एक बाइट (Byte) में 8 बिट्स होते हैं।"},"num":98},{"id":"q99","q":{"en":"What do two Nibbles combine to form?","hi":"दो निबल (Two Nibbles) मिलकर क्या बनाते हैं?"},"a":{"en":"One Byte (8 bits)","hi":"एक बाइट (1 Byte = 8 bits)"},"o":[{"en":"One Bit (1 bit)","hi":"एक बिट (1 bit)"},{"en":"One Byte (8 bits)","hi":"एक बाइट (1 Byte = 8 bits)"},{"en":"One Kilobyte (1,024 bytes)","hi":"एक किलोबाइट (1,024 बाइट्स)"},{"en":"One Terabyte (1,024 GB)","hi":"एक टेराबाइट (1,024 GB)"}],"exp":{"en":"Since 1 nibble = 4 bits, two nibbles together equal 8 bits, which forms 1 Byte.","hi":"चूँकि 1 निबल में 4 बिट्स होते हैं, इसलिए दो निबल मिलकर एक बाइट (1 Byte = 8 bits) बनाते हैं।"},"num":99},{"id":"q100","q":{"en":"What is a 'Computer Word', and how does it differ from a Byte?","hi":"'कंप्यूटर वर्ड' (Computer Word) क्या होता है और यह बाइट से कैसे भिन्न है?"},"a":{"en":"A word is a group of bits handled as a unit whose natural size (e.g., 16, 32, or 64 bits) depends on the processor architecture, whereas 8 bits specifically form a byte","hi":"वर्ड बिट्स का वह समूह है जिसका आकार कंप्यूटर आर्किटेक्चर पर निर्भर करता है, जबकि 8 बिट्स विशेष रूप से एक बाइट होते हैं"},"o":[{"en":"A word is a group of bits handled as a unit whose natural size (e.g., 16, 32, or 64 bits) depends on the processor architecture, whereas 8 bits specifically form a byte","hi":"वर्ड बिट्स का वह समूह है जिसका आकार कंप्यूटर आर्किटेक्चर पर निर्भर करता है, जबकि 8 बिट्स विशेष रूप से एक बाइट होते हैं"},{"en":"A computer word is always strictly 2 bits on every computer, while a byte is 1,024 bits","hi":"कंप्यूटर वर्ड हर कंप्यूटर पर हमेशा 2 बिट्स का होता है, जबकि बाइट 1,024 बिट्स का होता है"},{"en":"A computer word refers only to MS Word documents stored on a pen drive","hi":"कंप्यूटर वर्ड का अर्थ केवल पेन ड्राइव पर सहेजे गए MS Word दस्तावेज़ों से है"},{"en":"There is no difference; a computer word is always 4 bits","hi":"कोई अंतर नहीं है; एक कंप्यूटर वर्ड हमेशा 4 बिट्स का होता है"}],"exp":{"en":"A Byte is a fixed 8-bit unit, whereas a Computer Word is the natural unit of data processed in parallel by a given CPU architecture (word length can be 16-bit, 32-bit, 64-bit, etc., depending on the architecture).","hi":"कंप्यूटर वर्ड (Word) बिट्स का वह समूह है जिसका प्राकृतिक आकार (जैसे 16-बिट, 32-बिट या 64-बिट) प्रोसेसर के आर्किटेक्चर पर निर्भर करता है, जबकि 8 बिट्स विशेष रूप से एक बाइट (Byte) कहलाते हैं।"},"num":100},{"id":"q101","q":{"en":"What is the technically precise IEC name for 1,024 bytes, and how is it commonly written in exam notes?","hi":"1,024 बाइट्स का तकनीकी रूप से सटीक (IEC) नाम क्या है, और परीक्षा नोट्स में इसे अक्सर क्या लिखा जाता है?"},"a":{"en":"Technically 1 KiB (kibibyte); exam notes commonly write it as 1 KB under traditional binary convention","hi":"तकनीकी रूप से 1 KiB (किबिबाइट); परीक्षा नोट्स अक्सर इसे बाइनरी परंपरा में 1 KB लिखते हैं"},"o":[{"en":"Technically 1 KiB (kibibyte); exam notes commonly write it as 1 KB under traditional binary convention","hi":"तकनीकी रूप से 1 KiB (किबिबाइट); परीक्षा नोट्स अक्सर इसे बाइनरी परंपरा में 1 KB लिखते हैं"},{"en":"Technically 1 MiB (mebibyte); exam notes write it as 1 GB","hi":"तकनीकी रूप से 1 MiB (मेबिबाइट); परीक्षा नोट्स इसे 1 GB लिखते हैं"},{"en":"Technically 1 Nibble; exam notes write it as 1 Bit","hi":"तकनीकी रूप से 1 निबल; परीक्षा नोट्स इसे 1 बिट लिखते हैं"},{"en":"Technically 1 TiB; exam notes write it as 1 PB","hi":"तकनीकी रूप से 1 TiB; परीक्षा नोट्स इसे 1 PB लिखते हैं"}],"exp":{"en":"Under the IEC binary prefix standard, 1,024 (2¹⁰) bytes is precisely called 1 KiB (kibibyte). However, traditional computer science textbooks and competitive exams commonly write 1 KB = 1,024 bytes.","hi":"1,024 बाइट्स का तकनीकी रूप से सटीक (IEC) नाम 1 KiB (kibibyte / किबिबाइट) है। हालाँकि, प्रतियोगी परीक्षाओं और नोट्स में बाइनरी परंपरा के तहत इसे अक्सर 1 KB (किलोबाइट) लिखा जाता है।"},"num":101},{"id":"q102","q":{"en":"In the standard decimal SI system, how many bytes equal 1 kB, compared to binary 1 KiB?","hi":"मानक दशमलव (SI) प्रणाली में 1 kB कितने बाइट्स के बराबर होता है, और बाइनरी 1 KiB में कितने बाइट्स होते हैं?"},"a":{"en":"In SI, 1 kB = 1,000 bytes (10³); in binary IEC, 1 KiB = 1,024 bytes (2¹⁰)","hi":"SI में 1 kB = 1,000 बाइट्स; जबकि बाइनरी में 1 KiB = 1,024 बाइट्स"},"o":[{"en":"In SI, 1 kB = 1,000 bytes (10³); in binary IEC, 1 KiB = 1,024 bytes (2¹⁰)","hi":"SI में 1 kB = 1,000 बाइट्स; जबकि बाइनरी में 1 KiB = 1,024 बाइट्स"},{"en":"In SI, 1 kB = 1,024 bytes; in binary IEC, 1 KiB = 1,000 bytes","hi":"SI में 1 kB = 1,024 बाइट्स; जबकि बाइनरी में 1 KiB = 1,000 बाइट्स"},{"en":"Both equal exactly 512 bytes","hi":"दोनों ठीक 512 बाइट्स के बराबर होते हैं"},{"en":"In SI, 1 kB = 8 bytes; in binary, 1 KiB = 16 bytes","hi":"SI में 1 kB = 8 बाइट्स; बाइनरी में 1 KiB = 16 बाइट्स"}],"exp":{"en":"In the International System of Units (SI), the prefix 'kilo' (k) means 10³ = 1,000, so 1 kB = 1,000 bytes. In binary (IEC) addressing, 1 KiB = 2¹⁰ = 1,024 bytes.","hi":"अंतर्राष्ट्रीय मात्रक प्रणाली (SI) में 1 kB = 1,000 बाइट्स (10³) होता है, जबकि बाइनरी प्रणाली में 1 KiB = 1,024 बाइट्स (2¹⁰) होता है।"},"num":102},{"id":"q103","q":{"en":"In the standard binary-style exam sequence, what are the step-by-step conversions from KB up to PB?","hi":"बाइनरी-शैली के परीक्षा अनुक्रम में KB से लेकर PB (पेटाबाइट) तक के सही चरण क्या हैं?"},"a":{"en":"1 MB = 1024 KB, 1 GB = 1024 MB, 1 TB = 1024 GB, 1 PB = 1024 TB (precise IEC labels: MiB, GiB, TiB, PiB)","hi":"1 MB = 1024 KB, 1 GB = 1024 MB, 1 TB = 1024 GB, 1 PB = 1024 TB (सटीक IEC नाम: MiB, GiB, TiB, PiB)"},"o":[{"en":"1 MB = 1024 KB, 1 GB = 1024 MB, 1 TB = 1024 GB, 1 PB = 1024 TB (precise IEC labels: MiB, GiB, TiB, PiB)","hi":"1 MB = 1024 KB, 1 GB = 1024 MB, 1 TB = 1024 GB, 1 PB = 1024 TB (सटीक IEC नाम: MiB, GiB, TiB, PiB)"},{"en":"1 GB = 1024 KB, 1 MB = 1024 GB, 1 PB = 1024 MB, 1 TB = 1024 PB","hi":"1 GB = 1024 KB, 1 MB = 1024 GB, 1 PB = 1024 MB, 1 TB = 1024 PB"},{"en":"1 MB = 8 KB, 1 GB = 8 MB, 1 TB = 8 GB, 1 PB = 8 TB","hi":"1 MB = 8 KB, 1 GB = 8 MB, 1 TB = 8 GB, 1 PB = 8 TB"},{"en":"1 TB = 1024 KB, 1 GB = 1024 TB, 1 MB = 1024 GB, 1 PB = 1024 MB","hi":"1 TB = 1024 KB, 1 GB = 1024 TB, 1 MB = 1024 GB, 1 PB = 1024 MB"}],"exp":{"en":"Following the binary (×1024) exam hierarchy: 1 Megabyte (MB/MiB) = 1024 KB, 1 Gigabyte (GB/GiB) = 1024 MB, 1 Terabyte (TB/TiB) = 1024 GB, and 1 Petabyte (PB/PiB) = 1024 TB.","hi":"बाइनरी परीक्षा अनुक्रम में: 1 MB (मेगाबाइट) = 1024 KB, 1 GB (गीगाबाइट) = 1024 MB, 1 TB (टेराबाइट) = 1024 GB, और 1 PB (पेटाबाइट) = 1024 TB होता है (सटीक IEC लेबल MiB, GiB, TiB और PiB हैं)।"},"num":103},{"id":"q104","q":{"en":"According to the binary memory hierarchy table, what are 1 EB (Exabyte), 1 ZB (Zettabyte), and 1 YB (Yottabyte) equal to?","hi":"मेमोरी तालिका के अनुसार, बाइनरी शॉर्टहैंड में 1 EB (एक्साबाइट), 1 ZB (ज़ेटाबाइट) और 1 YB (योटाबाइट) किसके बराबर होते हैं?"},"a":{"en":"1 EB = 1024 PB, 1 ZB = 1024 EB, and 1 YB = 1024 ZB (precise IEC names: EiB, ZiB, YiB)","hi":"1 EB = 1024 PB, 1 ZB = 1024 EB और 1 YB = 1024 ZB (सटीक IEC नाम: EiB, ZiB, YiB)"},"o":[{"en":"1 EB = 1024 PB, 1 ZB = 1024 EB, and 1 YB = 1024 ZB (precise IEC names: EiB, ZiB, YiB)","hi":"1 EB = 1024 PB, 1 ZB = 1024 EB और 1 YB = 1024 ZB (सटीक IEC नाम: EiB, ZiB, YiB)"},{"en":"1 ZB = 1024 PB, 1 EB = 1024 ZB, and 1 YB = 1024 TB","hi":"1 ZB = 1024 PB, 1 EB = 1024 ZB और 1 YB = 1024 TB"},{"en":"1 YB = 1024 PB, 1 ZB = 1024 YB, and 1 EB = 1024 ZB","hi":"1 YB = 1024 PB, 1 ZB = 1024 YB और 1 EB = 1024 ZB"},{"en":"1 EB = 100 MB, 1 ZB = 100 GB, and 1 YB = 100 TB","hi":"1 EB = 100 MB, 1 ZB = 100 GB और 1 YB = 100 TB"}],"exp":{"en":"Above Petabyte (PB), the binary memory hierarchy continues as: 1 Exabyte (EB / EiB) = 1024 PB, 1 Zettabyte (ZB / ZiB) = 1024 EB, and 1 Yottabyte (YB / YiB) = 1024 ZB.","hi":"पेटाबाइट (PB) से ऊपर का बाइनरी क्रम इस प्रकार है: 1 EB (Exabyte) = 1024 PB, 1 ZB (Zettabyte) = 1024 EB, और 1 YB (Yottabyte) = 1024 ZB (IEC नाम क्रमशः EiB, ZiB और YiB हैं)।"},"num":104},{"id":"q105","q":{"en":"How many total bits are there in 1 KiB (or 1 binary KB = 1,024 bytes)?","hi":"1 KiB (या बाइनरी 1 KB = 1,024 बाइट्स) में कुल कितने बिट्स (Bits) होते हैं?"},"a":{"en":"8,192 bits (since 1,024 bytes × 8 bits/byte = 8,192 bits)","hi":"8,192 बिट्स (क्योंकि 1,024 × 8 = 8,192 बिट्स)"},"o":[{"en":"1,024 bits","hi":"1,024 बिट्स"},{"en":"4,096 bits","hi":"4,096 बिट्स"},{"en":"8,192 bits (since 1,024 bytes × 8 bits/byte = 8,192 bits)","hi":"8,192 बिट्स (क्योंकि 1,024 × 8 = 8,192 बिट्स)"},{"en":"512 bits","hi":"512 बिट्स"}],"exp":{"en":"Since 1 KiB (binary KB) = 1,024 bytes and each byte has 8 bits, the total number of bits in 1 KiB is 1,024 × 8 = 8,192 bits.","hi":"चूँकि 1 KiB (बाइनरी KB) में 1,024 बाइट्स होते हैं और 1 बाइट में 8 बिट्स होते हैं, इसलिए कुल बिट्स = 1,024 × 8 = 8,192 बिट्स होते हैं।"},"num":105},{"id":"q106","q":{"en":"Are 'Brontobyte' and 'Geopbyte' official SI/IEC units, and how do exam notes list them in extended tables?","hi":"क्या 'ब्रोंटोबाइट' (Brontobyte) और 'जियोपबाइट' (Geopbyte) आधिकारिक SI/IEC इकाइयाँ हैं, और नोट्स में इन्हें कैसे दर्शाया गया है?"},"a":{"en":"They are informal (non-standard) labels; exam notes list 1 Brontobyte = 1024 YB and 1 Geopbyte = 1024 Brontobytes (should not be mixed with official SI/IEC prefixes)","hi":"ये अनौपचारिक (informal) नाम हैं; नोट्स के विस्तार में 1 Brontobyte = 1024 YB और 1 Geopbyte = 1024 Brontobyte दिया गया है"},"o":[{"en":"They are informal (non-standard) labels; exam notes list 1 Brontobyte = 1024 YB and 1 Geopbyte = 1024 Brontobytes (should not be mixed with official SI/IEC prefixes)","hi":"ये अनौपचारिक (informal) नाम हैं; नोट्स के विस्तार में 1 Brontobyte = 1024 YB और 1 Geopbyte = 1024 Brontobyte दिया गया है"},{"en":"They are the smallest official SI units smaller than a Bit and a Nibble","hi":"ये बिट और निबल से भी छोटी आधिकारिक SI इकाइयाँ हैं"},{"en":"1 Brontobyte = 1024 KB and 1 Geopbyte = 1024 MB in official IEC standards","hi":"आधिकारिक IEC मानकों में 1 Brontobyte = 1024 KB और 1 Geopbyte = 1024 MB है"},{"en":"They are types of impact printers used in mainframes","hi":"ये मेनफ्रेम में उपयोग होने वाले इम्पैक्ट प्रिंटर के प्रकार हैं"}],"exp":{"en":"Brontobyte and Geopbyte are informal, non-standard terms (not official SI or IEC prefixes). However, in Indian competitive exam tables, they often appear at the top of the extended ladder as 1 Brontobyte = 1024 YB and 1 Geopbyte = 1024 Brontobytes.","hi":"Brontobyte और Geopbyte अनौपचारिक (informal) लेबल हैं, आधिकारिक SI/IEC इकाइयाँ नहीं। फिर भी परीक्षा नोट्स की विस्तारित तालिका में Brontobyte को 1024 YB और Geopbyte को 1024 Brontobyte के रूप में दर्शाया जाता है।"},"num":106},{"id":"q107","q":{"en":"Which conversion corrections should be kept in mind regarding typos on source slide page 38?","hi":"स्रोत स्लाइड पृष्ठ 38 में दी गई किन रूपांतरण त्रुटियों को सुधार कर याद रखना चाहिए?"},"a":{"en":"1 KiB (binary KB) = 1024 bytes; and in the binary ladder, 1 EiB (EB) = 1024 PiB (PB) and 1 YiB (YB) = 1024 ZiB (ZB)","hi":"1 KiB (KB) = 1024 बाइट्स; तथा बाइनरी क्रम में 1 EiB (EB) = 1024 PiB (PB) और 1 YiB (YB) = 1024 ZiB (ZB)"},"o":[{"en":"1 KiB (binary KB) = 1024 bytes; and in the binary ladder, 1 EiB (EB) = 1024 PiB (PB) and 1 YiB (YB) = 1024 ZiB (ZB)","hi":"1 KiB (KB) = 1024 बाइट्स; तथा बाइनरी क्रम में 1 EiB (EB) = 1024 PiB (PB) और 1 YiB (YB) = 1024 ZiB (ZB)"},{"en":"1 Byte = 100 bits and 1 Nibble = 50 bits","hi":"1 बाइट = 100 बिट्स और 1 निबल = 50 बिट्स"},{"en":"1 MB = 1024 TB and 1 GB = 1024 PB","hi":"1 MB = 1024 TB और 1 GB = 1024 PB"},{"en":"1 Bit = 1024 Bytes","hi":"1 बिट = 1024 बाइट्स"}],"exp":{"en":"When revising from the source slide (p. 38), ensure the correct binary conversions are used: 1 KiB (KB) = 1024 bytes, 1 EiB (EB) = 1024 PiB (PB), and 1 YiB (YB) = 1024 ZiB (ZB).","hi":"स्रोत स्लाइड (पृष्ठ 38) को पढ़ते समय यह सही रूपांतरण याद रखें: 1 KiB (बाइनरी KB) = 1024 बाइट्स, तथा बाइनरी सीढ़ी में 1 EiB (EB) = 1024 PiB (PB) और 1 YiB (YB) = 1024 ZiB (ZB) होता है।"},"num":107}]},{"title":{"en":"9. Microprocessor & Language Generations","hi":"9. माइक्रोप्रोसेसर और प्रोग्रामिंग भाषाओं की पीढ़ियाँ"},"questions":[{"id":"q108","q":{"en":"What is a 'Microprocessor'?","hi":"'माइक्रोप्रोसेसर' (Microprocessor) क्या है?"},"a":{"en":"A processor whose CPU functions are implemented on an integrated semiconductor chip, performing data processing and arithmetic/logic operations","hi":"एक प्रोसेसर जिसके CPU कार्य एक इंटीग्रेटेड चिप पर लागू होते हैं; यह डेटा प्रोसेसिंग और अंकगणितीय/तार्किक कार्य करता है"},"o":[{"en":"A processor whose CPU functions are implemented on an integrated semiconductor chip, performing data processing and arithmetic/logic operations","hi":"एक प्रोसेसर जिसके CPU कार्य एक इंटीग्रेटेड चिप पर लागू होते हैं; यह डेटा प्रोसेसिंग और अंकगणितीय/तार्किक कार्य करता है"},{"en":"A tiny optical lens used inside a flatbed scanner","hi":"फ्लैटबेड स्कैनर के अंदर प्रयुक्त एक छोटा प्रकाशीय लेंस"},{"en":"A small mechanical gear used in the 1642 Pascaline","hi":"1642 के पास्कलाइन में प्रयुक्त एक छोटा यांत्रिक गियर"},{"en":"An external plastic stand used to hold a computer monitor","hi":"कंप्यूटर मॉनिटर को रखने के लिए प्रयुक्त एक बाहरी प्लास्टिक स्टैंड"}],"exp":{"en":"A microprocessor is a compact processor whose central processing unit (CPU) functions—data processing, arithmetic/logic operations, and control—are fabricated on a single integrated circuit (IC) chip.","hi":"माइक्रोप्रोसेसर वह प्रोसेसर है जिसके CPU के कार्य एक इंटीग्रेटेड सेमीकंडक्टर चिप (IC) पर निर्मित होते हैं। यह डेटा प्रोसेसिंग और अरिथमेटिक/लॉजिक (अंकगणितीय व तार्किक) ऑपरेशन्स करता है।"},"num":108},{"id":"q109","q":{"en":"What is a computer 'Program'?","hi":"कंप्यूटर 'प्रोग्राम' (Program) क्या होता है?"},"a":{"en":"An ordered set of instructions written to perform a specific task on a computer","hi":"किसी विशिष्ट कार्य (specific task) को पूरा करने के लिए लिखे गए निर्देशों का एक क्रमबद्ध समूह (ordered set of instructions)"},"o":[{"en":"An ordered set of instructions written to perform a specific task on a computer","hi":"किसी विशिष्ट कार्य (specific task) को पूरा करने के लिए लिखे गए निर्देशों का एक क्रमबद्ध समूह (ordered set of instructions)"},{"en":"A physical copper cable connecting the mouse to the USB port","hi":"माउस को USB पोर्ट से जोड़ने वाली एक भौतिक तांबे की केबल"},{"en":"An unformatted magnetic platter inside a hard drive","hi":"हार्ड ड्राइव के अंदर एक अनफ़ॉर्मेटेड चुंबकीय प्लेट"},{"en":"A cooling fan mounted on top of the CPU","hi":"CPU के ऊपर लगा एक कूलिंग फैन"}],"exp":{"en":"A computer program is an ordered sequence/set of instructions that tells the computer hardware how to perform a specific task.","hi":"किसी विशिष्ट कार्य (specific task) को करने के लिए लिखे गए निर्देशों के क्रमबद्ध समूह (ordered set of instructions) को 'प्रोग्राम' कहते हैं।"},"num":109},{"id":"q110","q":{"en":"How is the term 'Software' defined in relation to programs?","hi":"प्रोग्रामों के संदर्भ में 'सॉफ्टवेयर' (Software) को कैसे परिभाषित किया जाता है?"},"a":{"en":"Software is the broad term encompassing programs along with their associated instructions, documentation, and data","hi":"सॉफ्टवेयर प्रोग्राम्स और उनसे जुड़े निर्देशों/डेटा (associated instructions/data) के लिए प्रयुक्त व्यापक शब्द (broad term) है"},"o":[{"en":"Software is the broad term encompassing programs along with their associated instructions, documentation, and data","hi":"सॉफ्टवेयर प्रोग्राम्स और उनसे जुड़े निर्देशों/डेटा (associated instructions/data) के लिए प्रयुक्त व्यापक शब्द (broad term) है"},{"en":"Software refers exclusively to soft rubber keys on a keypad","hi":"सॉफ्टवेयर का अर्थ केवल कीपैड पर लगी नरम रबर की कुंजियों से है"},{"en":"Software is the metal cabinet housing the motherboard","hi":"सॉफ्टवेयर मदरबोर्ड को रखने वाला धातु का कैबिनेट है"},{"en":"Software is an optical disc drive that reads Blu-ray discs","hi":"सॉफ्टवेयर एक ऑप्टिकल डिस्क ड्राइव है जो ब्लू-रे डिस्क को पढ़ता है"}],"exp":{"en":"While a program is a specific set of instructions, 'Software' is the broader umbrella term covering one or more programs along with their associated instructions, modules, and data.","hi":"सॉफ्टवेयर (Software) एक व्यापक शब्द (broad term) है जिसके अंतर्गत विभिन्न प्रोग्राम और उनसे संबंधित निर्देश व डेटा (associated instructions/data) आते हैं।"},"num":110},{"id":"q111","q":{"en":"What is a First-Generation Programming Language (1GL)?","hi":"प्रथम पीढ़ी की प्रोग्रामिंग भाषा (First-Generation Language - 1GL) क्या है?"},"a":{"en":"Machine language, in which processor instructions are encoded directly in binary 0s and 1s","hi":"मशीन भाषा (Machine language), जिसमें प्रोसेसर के निर्देश सीधे बाइनरी 0 और 1 में एनकोड होते हैं"},"o":[{"en":"Machine language, in which processor instructions are encoded directly in binary 0s and 1s","hi":"मशीन भाषा (Machine language), जिसमें प्रोसेसर के निर्देश सीधे बाइनरी 0 और 1 में एनकोड होते हैं"},{"en":"High-level object-oriented language like Java and Python","hi":"जावा और पायथन जैसी उच्च-स्तरीय ऑब्जेक्ट-ओरिएंटेड भाषा"},{"en":"Database query language like SQL","hi":"SQL जैसी डेटाबेस क्वेरी भाषा"},{"en":"Artificial intelligence logic language like Prolog","hi":"प्रोलॉग जैसी आर्टिफिशियल इंटेलिजेंस लॉजिक भाषा"}],"exp":{"en":"First-Generation Language (1GL) is machine-level language, where instructions and data are written directly in binary digits (0s and 1s) that the processor executes without any translator.","hi":"प्रथम पीढ़ी की भाषा (1GL) 'मशीन भाषा' (Machine language) है, जिसमें प्रोसेसर के निर्देश सीधे बाइनरी अंकों 0 और 1 में लिखे जाते हैं।"},"num":111},{"id":"q112","q":{"en":"What is a Second-Generation Programming Language (2GL)?","hi":"द्वितीय पीढ़ी की प्रोग्रामिंग भाषा (Second-Generation Language - 2GL) क्या है?"},"a":{"en":"Assembly or symbolic low-level language, which uses short symbolic codes (mnemonics) for CPU instructions","hi":"असेंबली या प्रतीकात्मक (symbolic) लो-लेवल भाषा, जो CPU निर्देशों के लिए निमोनिक्स (mnemonics) का उपयोग करती है"},"o":[{"en":"Assembly or symbolic low-level language, which uses short symbolic codes (mnemonics) for CPU instructions","hi":"असेंबली या प्रतीकात्मक (symbolic) लो-लेवल भाषा, जो CPU निर्देशों के लिए निमोनिक्स (mnemonics) का उपयोग करती है"},{"en":"Pure binary 0s and 1s with no letters or symbols","hi":"बिना किसी अक्षर या प्रतीक के शुद्ध बाइनरी 0 और 1"},{"en":"Web markup language like HTML","hi":"HTML जैसी वेब मार्कअप भाषा"},{"en":"Natural spoken English and Hindi","hi":"प्राकृतिक बोलचाल की अंग्रेजी और हिन्दी"}],"exp":{"en":"Second-Generation Language (2GL) is Assembly language—a low-level symbolic language that uses human-readable mnemonics (such as ADD, SUB, MOV, LOAD) to represent machine-level CPU instructions.","hi":"द्वितीय पीढ़ी की भाषा (2GL) असेंबली (Assembly) या प्रतीकात्मक लो-लेवल भाषा है, जो CPU निर्देशों को लिखने के लिए संक्षिप्त प्रतीकात्मक कोड अर्थात् 'निमोनिक्स' (mnemonics — जैसे ADD, MOV) का उपयोग करती है।"},"num":112},{"id":"q113","q":{"en":"Which language translator converts Assembly language (2GL) into Machine code (1GL)?","hi":"असेंबली भाषा (Assembly language) को मशीन कोड (Machine code) में कौन परिवर्तित करता है?"},"a":{"en":"Assembler","hi":"असेंबलर (Assembler)"},"o":[{"en":"Plotter","hi":"प्लॉटर"},{"en":"Assembler","hi":"असेंबलर (Assembler)"},{"en":"Modem","hi":"मॉडेम"},{"en":"Multiplexer","hi":"मल्टीप्लेक्सर"}],"exp":{"en":"An Assembler is a system software translator that converts programs written in Assembly language (symbolic mnemonics) into executable binary machine code.","hi":"असेंबली भाषा को मशीन कोड (बाइनरी) में बदलने वाले ट्रांसलेटर को 'असेंबलर' (Assembler) कहते हैं।"},"num":113},{"id":"q114","q":{"en":"Which of the following are classic examples of Third-Generation Languages (3GL) listed in the notes?","hi":"नोट्स में दिए गए तृतीय पीढ़ी की भाषाओं (Third-Generation Languages - 3GL) के उदाहरण कौन-से हैं?"},"a":{"en":"FORTRAN, COBOL, BASIC, Pascal, and PL/I (these are procedural high-level languages)","hi":"FORTRAN, COBOL, BASIC, Pascal और PL/I (ये उच्च-स्तरीय भाषाएँ हैं)"},"o":[{"en":"FORTRAN, COBOL, BASIC, Pascal, and PL/I (these are procedural high-level languages)","hi":"FORTRAN, COBOL, BASIC, Pascal और PL/I (ये उच्च-स्तरीय भाषाएँ हैं)"},{"en":"Only binary 0010 and 1101","hi":"केवल बाइनरी 0010 और 1101"},{"en":"Prolog, OPS5, and Mercury only","hi":"केवल Prolog, OPS5 और Mercury"},{"en":"SATA, HDMI, and VGA","hi":"SATA, HDMI और VGA"}],"exp":{"en":"Third-Generation Languages (3GLs) are procedural high-level programming languages. The study notes list FORTRAN, COBOL, BASIC, Pascal, and PL/I (as well as C/C++/Java in broader contexts) as 3GL examples.","hi":"तृतीय पीढ़ी की भाषाएँ (3GL) उच्च-स्तरीय (high-level) प्रक्रियात्मक भाषाएँ हैं। नोट्स में इसके उदाहरणों के रूप में FORTRAN, COBOL, BASIC, Pascal और PL/I दिए गए हैं।"},"num":114},{"id":"q115","q":{"en":"What is the key exam distinction between a 3GL and a 4GL?","hi":"परीक्षा की दृष्टि से 3GL और 4GL में मुख्य अंतर क्या है?"},"a":{"en":"3GL languages are procedural (specify step-by-step 'how' to perform a task), whereas 4GL languages like SQL are non-procedural/declarative (specify 'what' result is needed)","hi":"3GL आम तौर पर बताते हैं कि 'कार्य कैसे करना है' (how), जबकि 4GL (जैसे SQL) बताते हैं कि 'कौन-सा परिणाम चाहिए' (what result)"},"o":[{"en":"3GL languages are procedural (specify step-by-step 'how' to perform a task), whereas 4GL languages like SQL are non-procedural/declarative (specify 'what' result is needed)","hi":"3GL आम तौर पर बताते हैं कि 'कार्य कैसे करना है' (how), जबकि 4GL (जैसे SQL) बताते हैं कि 'कौन-सा परिणाम चाहिए' (what result)"},{"en":"3GL uses only binary 0 and 1, whereas 4GL uses assembly mnemonics","hi":"3GL केवल बाइनरी 0 और 1 का उपयोग करता है, जबकि 4GL असेंबली निमोनिक्स का उपयोग करता है"},{"en":"3GL is a hardware monitor, whereas 4GL is a laser printer","hi":"3GL एक हार्डवेयर मॉनिटर है, जबकि 4GL एक लेजर प्रिंटर है"},{"en":"3GL is used only for AI robotics, whereas 4GL is machine code","hi":"3GL केवल AI रोबोटिक्स के लिए उपयोग होता है, जबकि 4GL मशीन कोड है"}],"exp":{"en":"A 3GL (procedural language) requires the programmer to write step-by-step instructions explaining *how* to accomplish a task, whereas a 4GL (such as SQL for databases) is declarative, letting the user specify *what* result is desired without coding the low-level retrieval loop.","hi":"3GL भाषाएँ (प्रक्रियात्मक) आम तौर पर यह बताती हैं कि कोई 'टास्क स्टेप-बाय-स्टेप कैसे करना है', जबकि 4GL (जैसे SQL) में यह बताया जाता है कि 'कौन-सा परिणाम (result) चाहिए'।"},"num":115},{"id":"q116","q":{"en":"What is the full form of SQL, and which language generation does it exemplify in the chapter?","hi":"SQL का पूर्ण रूप क्या है और अध्याय के वर्गीकरण में यह किस भाषा पीढ़ी (Language Generation) का उदाहरण है?"},"a":{"en":"Structured Query Language — It is a classic example of a Fourth-Generation Language (4GL)","hi":"डेटाबेस क्वेरी भाषा (4GL)"},"o":[{"en":"Structured Query Language — It is a classic example of a Fourth-Generation Language (4GL)","hi":"डेटाबेस क्वेरी भाषा (4GL)"},{"en":"Symbolic Quantum Logic — First-Generation Language (1GL)","hi":"सिम्बॉलिक क्वांटम लॉजिक — प्रथम पीढ़ी की भाषा (1GL)"},{"en":"System Quick Loader — Second-Generation Language (2GL)","hi":"सिस्टम क्विक लोडर — द्वितीय पीढ़ी की भाषा (2GL)"},{"en":"Sequential Queue Line — Hardware bus protocol","hi":"सीक्वेंशियल क्यू लाइन — हार्डवेयर बस प्रोटोकॉल"}],"exp":{"en":"SQL stands for Structured Query Language. In the chapter's programming language classification, SQL is the standard example of a 4GL (Fourth-Generation Language / database query language).","hi":"SQL का पूर्ण रूप Structured Query Language है। अध्याय के वर्गीकरण में यह चतुर्थ पीढ़ी की भाषा (4GL / क्वेरी भाषा) का प्रमुख उदाहरण है।"},"num":116},{"id":"q117","q":{"en":"What is the primary focus of Fifth-Generation Languages (5GL), and which examples are listed in the notes?","hi":"पंचम पीढ़ी की भाषाओं (5GL) का मुख्य फोकस क्या है और नोट्स में इसके कौन-से उदाहरण दिए गए हैं?"},"a":{"en":"Programming centered on logic, constraints, expert systems, and Artificial Intelligence (AI); examples in notes are Prolog, OPS5, and Mercury","hi":"लॉजिक, कंस्ट्रेंट्स, एक्सपर्ट सिस्टम्स और AI से जुड़ी प्रोग्रामिंग; नोट्स में Prolog, OPS5 और Mercury सूचीबद्ध हैं"},"o":[{"en":"Programming centered on logic, constraints, expert systems, and Artificial Intelligence (AI); examples in notes are Prolog, OPS5, and Mercury","hi":"लॉजिक, कंस्ट्रेंट्स, एक्सपर्ट सिस्टम्स और AI से जुड़ी प्रोग्रामिंग; नोट्स में Prolog, OPS5 और Mercury सूचीबद्ध हैं"},{"en":"Writing binary opcodes for vacuum-tube calculators; example: ENIAC code","hi":"वैक्यूम-ट्यूब कैलकुलेटर के लिए बाइनरी ऑपकोड लिखना; उदाहरण: ENIAC कोड"},{"en":"Controlling mechanical pins in dot matrix printers; example: ASCII","hi":"डॉट मैट्रिक्स प्रिंटर में यांत्रिक पिनों को नियंत्रित करना; उदाहरण: ASCII"},{"en":"Formatting floppy disks to 1.44 MB; example: FAT12","hi":"फ्लॉपी डिस्क को 1.44 MB में फ़ॉर्मेट करना; उदाहरण: FAT12"}],"exp":{"en":"Fifth-Generation Languages (5GLs) focus on constraint-based, logic-based, and declarative problem-solving used in expert systems and Artificial Intelligence (AI). Standard examples listed in the notes are Prolog, OPS5, and Mercury.","hi":"5GL का मुख्य फोकस लॉजिक, कंस्ट्रेंट्स (constraints), एक्सपर्ट सिस्टम्स और आर्टिफिशियल इंटेलिजेंस (AI) से जुड़ी प्रोग्रामिंग पर है। नोट्स में Prolog, OPS5 और Mercury को इसके उदाहरण के रूप में सूचीबद्ध किया गया है।"},"num":117},{"id":"q118","q":{"en":"Are 'Computer Hardware Generations' and 'Programming Language Generations' the exact same classification?","hi":"क्या 'कंप्यूटर हार्डवेयर की पीढ़ियाँ' और 'प्रोग्रामिंग भाषा की पीढ़ियाँ' एक ही वर्गीकरण हैं?"},"a":{"en":"No — they are two distinct classifications: hardware generations classify physical circuit technologies (vacuum tubes, transistors, ICs, microprocessors), while language generations classify programming abstraction levels (1GL machine code, 2GL assembly, 3GL–5GL high-level categories)","hi":"नहीं — ये दो अलग वर्गीकरण हैं: हार्डवेयर में वैक्यूम ट्यूब जैसी भौतिक तकनीकें आती हैं, जबकि भाषाओं में मशीन कोड, असेंबली और हाई-लेवल श्रेणियाँ आती हैं"},"o":[{"en":"No — they are two distinct classifications: hardware generations classify physical circuit technologies (vacuum tubes, transistors, ICs, microprocessors), while language generations classify programming abstraction levels (1GL machine code, 2GL assembly, 3GL–5GL high-level categories)","hi":"नहीं — ये दो अलग वर्गीकरण हैं: हार्डवेयर में वैक्यूम ट्यूब जैसी भौतिक तकनीकें आती हैं, जबकि भाषाओं में मशीन कोड, असेंबली और हाई-लेवल श्रेणियाँ आती हैं"},{"en":"Yes — 1GL means vacuum tube and 5GL means transistor","hi":"हाँ — 1GL का अर्थ वैक्यूम ट्यूब है और 5GL का अर्थ ट्रांजिस्टर है"},{"en":"Yes — Prolog is a physical microprocessor chip and COBOL is a vacuum tube","hi":"हाँ — प्रोलॉग एक भौतिक माइक्रोप्रोसेसर चिप है और COBOL एक वैक्यूम ट्यूब है"},{"en":"No — hardware has 20 generations while languages have only 1 generation","hi":"नहीं — हार्डवेयर की 20 पीढ़ियाँ हैं जबकि भाषाओं की केवल 1 पीढ़ी है"}],"exp":{"en":"No, they are two separate classification systems that often run in parallel: Hardware Generations (1st to 5th) categorize the evolution of electronic components (vacuum tubes → transistors → ICs → microprocessors → AI/ULSI), whereas Language Generations (1GL to 5GL) categorize the level of programming abstraction from machine binary (1GL) and assembly (2GL) to high-level procedural, query, and logic languages (3GL–5GL).","hi":"नहीं, ये दो अलग-अलग वर्गीकरण हैं। हार्डवेयर पीढ़ियों में वैक्यूम ट्यूब, ट्रांजिस्टर, IC और माइक्रोप्रोसेसर जैसी भौतिक तकनीकें आती हैं, जबकि भाषा पीढ़ियों (1GL–5GL) में मशीन कोड, असेंबली और उच्च-स्तरीय प्रोग्रामिंग श्रेणियाँ आती हैं।"},"num":118}]},{"title":{"en":"10. Buses, Ports & Connector Identification","hi":"10. बस, पोर्ट और कनेक्टर की पहचान"},"questions":[{"id":"q119","q":{"en":"What is a 'Computer Bus' in computer architecture?","hi":"कंप्यूटर आर्किटेक्चर में 'कंप्यूटर बस' (Computer Bus) क्या होती है?"},"a":{"en":"A communication pathway (set of conductive wires/lines) that carries signals or information between computer components","hi":"कंप्यूटर के घटकों (components) के बीच सिग्नल या सूचना ले जाने वाला संचार मार्ग (communication pathway)"},"o":[{"en":"A communication pathway (set of conductive wires/lines) that carries signals or information between computer components","hi":"कंप्यूटर के घटकों (components) के बीच सिग्नल या सूचना ले जाने वाला संचार मार्ग (communication pathway)"},{"en":"An external rubber cover used to protect a laptop keyboard from dust","hi":"लैपटॉप कीबोर्ड को धूल से बचाने के लिए प्रयुक्त एक बाहरी रबर कवर"},{"en":"A software antivirus program that deletes malware","hi":"मैलवेयर को हटाने वाला एक सॉफ्टवेयर एंटीवायरस प्रोग्राम"},{"en":"A magnetic tape cartridge that stores 200 GB of backup data","hi":"200 GB बैकअप डेटा स्टोर करने वाला एक मैग्नेटिक टेप कार्ट्रिज"}],"exp":{"en":"In computer architecture, a bus is a shared communication pathway (composed of electrical tracks on the motherboard or cables) that transfers data, addresses, or control signals among the CPU, memory, and I/O controllers.","hi":"कंप्यूटर के विभिन्न घटकों (जैसे CPU, मेमोरी और I/O) के बीच सिग्नल या डेटा/सूचना ले जाने वाले संचार मार्ग (communication pathway) को 'कंप्यूटर बस' कहते हैं।"},"num":119},{"id":"q120","q":{"en":"What is the specific function of the 'Data Bus'?","hi":"'डेटा बस' (Data Bus) का मुख्य कार्य क्या है?"},"a":{"en":"It transfers the actual data being moved between the CPU, memory, and I/O devices","hi":"यह CPU, मेमोरी और I/O उपकरणों के बीच वास्तविक डेटा (Actual data) ट्रांसफर करती है"},"o":[{"en":"It transfers the actual data being moved between the CPU, memory, and I/O devices","hi":"यह CPU, मेमोरी और I/O उपकरणों के बीच वास्तविक डेटा (Actual data) ट्रांसफर करती है"},{"en":"It carries only unidirectional memory addresses and never carries data","hi":"यह केवल एकदिशीय मेमोरी एड्रेस ले जाती है और कभी डेटा नहीं ले जाती"},{"en":"It supplies 220V AC power from the wall socket to the monitor","hi":"यह दीवार के सॉकेट से मॉनिटर को 220V AC बिजली की आपूर्ति करती है"},{"en":"It cools down the processor using copper heat pipes","hi":"यह तांबे के हीट पाइप का उपयोग करके प्रोसेसर को ठंडा करती है"}],"exp":{"en":"The Data Bus is a bidirectional pathway that carries the actual data words (instructions or operands) being read from or written to memory and I/O modules.","hi":"डेटा बस (Data Bus) कंप्यूटर के घटकों के बीच वास्तविक डेटा (actual data) को ट्रांसफर करने का कार्य करती है।"},"num":120},{"id":"q121","q":{"en":"What does the 'Address Bus' transfer in a computer system?","hi":"कंप्यूटर सिस्टम में 'एड्रेस बस' (Address Bus) क्या ट्रांसफर करती है?"},"a":{"en":"The address of the target memory location or I/O location to be read from or written to","hi":"टारगेट मेमोरी या I/O लोकेशन का पता (Address) जहाँ से रीड या राइट करना है"},"o":[{"en":"The address of the target memory location or I/O location to be read from or written to","hi":"टारगेट मेमोरी या I/O लोकेशन का पता (Address) जहाँ से रीड या राइट करना है"},{"en":"Only the audio output signal sent to external speakers","hi":"केवल बाहरी स्पीकर को भेजा जाने वाला ऑडियो आउटपुट सिग्नल"},{"en":"The physical street address of the internet service provider","hi":"इंटरनेट सेवा प्रदाता का भौतिक सड़क पता"},{"en":"Electric power from the UPS battery to the monitor","hi":"यूपीएस बैटरी से मॉनिटर तक विद्युत शक्ति"}],"exp":{"en":"The Address Bus carries the binary address of the target memory location or I/O port that the CPU wants to access for a read or write operation.","hi":"एड्रेस बस (Address Bus) उस टारगेट मेमोरी या I/O लोकेशन का पता (address) ट्रांसफर करती है जिसे CPU एक्सेस करना चाहता है।"},"num":121},{"id":"q122","q":{"en":"What is the primary role of the 'Control Bus'?","hi":"'कंट्रोल बस' (Control Bus) क्या ट्रांसफर करती है?"},"a":{"en":"It transfers control and timing signals such as Read, Write, and Interrupt requests between system components","hi":"यह सिस्टम घटकों के बीच रीड (Read), राइट (Write) और इंटरप्ट (Interrupt) जैसे कंट्रोल सिग्नल ट्रांसफर करती है"},"o":[{"en":"It transfers control and timing signals such as Read, Write, and Interrupt requests between system components","hi":"यह सिस्टम घटकों के बीच रीड (Read), राइट (Write) और इंटरप्ट (Interrupt) जैसे कंट्रोल सिग्नल ट्रांसफर करती है"},{"en":"It transfers only high-definition 4K video frames to the projector","hi":"यह केवल प्रोजेक्टर को हाई-डेफिनिशन 4K वीडियो फ्रेम ट्रांसफर करती है"},{"en":"It physically moves paper sheets through a laser printer","hi":"यह लेजर प्रिंटर के माध्यम से कागज की शीट को भौतिक रूप से घुमाती है"},{"en":"It stores user documents permanently when power is off","hi":"यह बिजली बंद होने पर उपयोगकर्ता के दस्तावेज़ों को स्थायी रूप से संग्रहीत करती है"}],"exp":{"en":"The Control Bus carries command, timing, and status signals (such as Memory Read, Memory Write, I/O Read/Write, Clock, and Interrupt signals) to coordinate activities across the computer system.","hi":"कंट्रोल बस (Control Bus) सिस्टम के विभिन्न घटकों के बीच Read, Write और Interrupt जैसे नियंत्रण संकेत (control signals) ट्रांसफर करती है।"},"num":122},{"id":"q123","q":{"en":"What is a 'Hardware Port' on a computer?","hi":"कंप्यूटर में 'हार्डवेयर पोर्ट' (Hardware Port) क्या होता है?"},"a":{"en":"A physical connection point (socket/interface) through which the computer connects to an external or internal device or cable","hi":"एक भौतिक कनेक्शन पॉइंट (physical connection point) जिससे कंप्यूटर किसी डिवाइस या केबल से जुड़ता है"},"o":[{"en":"A physical connection point (socket/interface) through which the computer connects to an external or internal device or cable","hi":"एक भौतिक कनेक्शन पॉइंट (physical connection point) जिससे कंप्यूटर किसी डिवाइस या केबल से जुड़ता है"},{"en":"A high-level programming language used in artificial intelligence","hi":"आर्टिफिशियल इंटेलिजेंस में प्रयुक्त एक उच्च-स्तरीय प्रोग्रामिंग भाषा"},{"en":"A temporary arithmetic register inside the ALU","hi":"ALU के अंदर स्थित एक अस्थायी अंकगणितीय रजिस्टर"},{"en":"An optical laser beam that reads compact discs","hi":"कॉम्पैक्ट डिस्क को पढ़ने वाली एक ऑप्टिकल लेजर बीम"}],"exp":{"en":"A hardware port is a physical docking point, socket, or interface on a computer or motherboard into which a plug or cable is connected to link a peripheral or internal device.","hi":"हार्डवेयर पोर्ट एक भौतिक कनेक्शन पॉइंट (physical connection point) या सॉकेट होता है, जिसकी मदद से कंप्यूटर किसी बाहरी या आंतरिक डिवाइस अथवा केबल से कनेक्ट होता है।"},"num":123},{"id":"q124","q":{"en":"What does an 'Internal Port' connect, and what is a common example of it?","hi":"'इंटरनल पोर्ट' (Internal Port) किसे जोड़ता है और इसका सामान्य उदाहरण क्या है?"},"a":{"en":"It connects the motherboard to internal devices inside the system unit; for example, a SATA connector for an HDD or optical drive","hi":"यह मदरबोर्ड को आंतरिक डिवाइसेस से जोड़ता है; जैसे HDD या ऑप्टिकल ड्राइव के लिए SATA कनेक्टर"},"o":[{"en":"It connects the motherboard to internal devices inside the system unit; for example, a SATA connector for an HDD or optical drive","hi":"यह मदरबोर्ड को आंतरिक डिवाइसेस से जोड़ता है; जैसे HDD या ऑप्टिकल ड्राइव के लिए SATA कनेक्टर"},{"en":"It connects a wireless Bluetooth headset to a smartphone","hi":"यह वायरलेस ब्लूटूथ हेडसेट को स्मार्टफोन से जोड़ता है"},{"en":"It connects the wall power socket to a voltage stabilizer","hi":"यह दीवार के पावर सॉकेट को वोल्टेज स्टेबलाइजर से जोड़ता है"},{"en":"It connects a flatbed scanner to a glass table","hi":"यह फ्लैटबेड स्कैनर को कांच की मेज से जोड़ता है"}],"exp":{"en":"An internal port (or header/connector) is located on the motherboard inside the cabinet to connect internal components—for example, a SATA port connecting an internal Hard Disk Drive (HDD), SSD, or optical drive.","hi":"इंटरनल पोर्ट मदरबोर्ड को कैबिनेट के अंदर लगे आंतरिक उपकरणों (internal devices) से जोड़ता है। उदाहरण के लिए, HDD या ऑप्टिकल ड्राइव को जोड़ने वाला SATA कनेक्टर।"},"num":124},{"id":"q125","q":{"en":"What does an 'External Port' connect, and what is a common example of it?","hi":"'एक्सटर्नल पोर्ट' (External Port) किसे जोड़ता है और इसका सामान्य उदाहरण क्या है?"},"a":{"en":"It connects the computer to external peripherals outside the cabinet; for example, a USB port connecting a keyboard, mouse, or printer","hi":"यह कंप्यूटर को बाहरी पेरिफेरल्स से जोड़ता है; जैसे USB पोर्ट से कीबोर्ड, माउस या प्रिंटर जोड़ना"},"o":[{"en":"It connects the computer to external peripherals outside the cabinet; for example, a USB port connecting a keyboard, mouse, or printer","hi":"यह कंप्यूटर को बाहरी पेरिफेरल्स से जोड़ता है; जैसे USB पोर्ट से कीबोर्ड, माउस या प्रिंटर जोड़ना"},{"en":"It connects the ALU directly to the Program Counter inside the CPU die","hi":"यह CPU चिप के अंदर ALU को सीधे प्रोग्राम काउंटर से जोड़ता है"},{"en":"It connects DRAM capacitors to the refresh circuit on a RAM stick","hi":"यह RAM स्टिक पर DRAM कैपेसिटर को रिफ्रेश सर्किट से जोड़ता है"},{"en":"It connects magnetic platters to the spindle motor inside a sealed HDD","hi":"यह सीलबंद HDD के अंदर चुंबकीय प्लेटों को स्पिंडल मोटर से जोड़ता है"}],"exp":{"en":"An external port is accessible on the outside of the computer case/laptop to connect external peripheral devices—for example, a USB port used to plug in a keyboard, mouse, printer, or flash drive.","hi":"एक्सटर्नल पोर्ट कंप्यूटर को बाहरी पेरिफेरल उपकरणों (external peripherals) से जोड़ता है। उदाहरण के लिए, USB पोर्ट की मदद से कीबोर्ड, माउस या प्रिंटर को जोड़ना।"},"num":125},{"id":"q126","q":{"en":"Which of the following are common video/display connectors shown in the chapter's port chart?","hi":"अध्याय के पोर्ट चार्ट में दिखाए गए सामान्य वीडियो/डिस्प्ले कनेक्टर्स (Video Connectors) कौन-से हैं?"},"a":{"en":"VGA, Mini DVI, DVI-I, DVI-D, HDMI, DisplayPort, and Mini DisplayPort (chart also shows older Mini DisplayPort-shaped Thunderbolt)","hi":"VGA, Mini DVI, DVI-I, DVI-D, HDMI, DisplayPort और Mini DisplayPort (चार्ट में Thunderbolt का पुराना Mini DisplayPort-आकार का कनेक्टर भी है)"},"o":[{"en":"VGA, Mini DVI, DVI-I, DVI-D, HDMI, DisplayPort, and Mini DisplayPort (chart also shows older Mini DisplayPort-shaped Thunderbolt)","hi":"VGA, Mini DVI, DVI-I, DVI-D, HDMI, DisplayPort और Mini DisplayPort (चार्ट में Thunderbolt का पुराना Mini DisplayPort-आकार का कनेक्टर भी है)"},{"en":"RJ-11, RJ-45, and 3.5 mm TRS audio jack only","hi":"केवल RJ-11, RJ-45 और 3.5 मिमी ऑडियो जैक"},{"en":"PS/2 keyboard port and Centronics parallel printer port","hi":"PS/2 कीबोर्ड पोर्ट और सेंट्रोनिक्स पैरेलल प्रिंटर पोर्ट"},{"en":"SATA power connector and Molex fan header","hi":"SATA पावर कनेक्टर और मोलेक्स फैन हेडर"}],"exp":{"en":"The port identification chart lists VGA, Mini DVI, DVI-I, DVI-D, HDMI, DisplayPort, and Mini DisplayPort as standard video/display connectors (along with early Thunderbolt using the Mini DisplayPort form factor).","hi":"पोर्ट चार्ट में प्रमुख वीडियो कनेक्टर्स के रूप में VGA, Mini DVI, DVI-I, DVI-D, HDMI, DisplayPort और Mini DisplayPort शामिल हैं (चार्ट में Thunderbolt का पुराना Mini DisplayPort-आकार का कनेक्टर भी दर्शाया गया है)।"},"num":126},{"id":"q127","q":{"en":"What is the key clue to distinguish between a VGA connector and an HDMI connector?","hi":"VGA और HDMI कनेक्टर को किस मुख्य विशेषता (Clue) से पहचानेंगे?"},"a":{"en":"VGA is a traditional 15-pin (3-row) analog display connector, whereas HDMI is a flat digital connector that carries both digital video and audio","hi":"VGA पारंपरिक 15-पिन एनालॉग डिस्प्ले कनेक्टर है, जबकि HDMI डिजिटल ऑडियो और वीडियो दोनों ले जाता है"},"o":[{"en":"VGA is a traditional 15-pin (3-row) analog display connector, whereas HDMI is a flat digital connector that carries both digital video and audio","hi":"VGA पारंपरिक 15-पिन एनालॉग डिस्प्ले कनेक्टर है, जबकि HDMI डिजिटल ऑडियो और वीडियो दोनों ले जाता है"},{"en":"VGA carries digital audio only, whereas HDMI is a 25-pin analog printer port","hi":"VGA केवल डिजिटल ऑडियो ले जाता है, जबकि HDMI 25-पिन एनालॉग प्रिंटर पोर्ट है"},{"en":"VGA is a round 6-pin mouse port, whereas HDMI is an 8-pin Ethernet network jack","hi":"VGA एक गोल 6-पिन माउस पोर्ट है, जबकि HDMI एक 8-पिन ईथरनेट नेटवर्क जैक है"},{"en":"Both are 9-pin serial ports used only for dial-up modems","hi":"दोनों 9-पिन सीरियल पोर्ट हैं जिनका उपयोग केवल डायल-अप मॉडेम के लिए होता है"}],"exp":{"en":"VGA (Video Graphics Array) is a trapezoid-shaped, 15-pin (3 rows of 5 pins) connector that carries analog video signals only. HDMI (High-Definition Multimedia Interface) is a compact digital interface that transmits both uncompressed digital video and multi-channel digital audio over a single cable.","hi":"VGA एक पारंपरिक 15-पिन (3 कतारों में) एनालॉग डिस्प्ले कनेक्टर है जो केवल वीडियो सिग्नल ले जाता है, जबकि HDMI एक आधुनिक डिजिटल कनेक्टर है जो एक ही केबल से डिजिटल वीडियो और ऑडियो दोनों ट्रांसफर करता है।"},"num":127},{"id":"q128","q":{"en":"What is the practical difference between 'I' and 'D' in DVI-I and DVI-D video connectors?","hi":"DVI-I और DVI-D वीडियो कनेक्टरों में 'I' और 'D' का व्यावहारिक फर्क क्या है?"},"a":{"en":"DVI-I (Integrated) supports both digital and analog video signals, whereas DVI-D (Digital) supports digital video signals only","hi":"DVI-I (Integrated) डिजिटल और एनालॉग दोनों सिग्नल सपोर्ट करता है, जबकि DVI-D केवल डिजिटल सिग्नल (digital-only) सपोर्ट करता है"},"o":[{"en":"DVI-I (Integrated) supports both digital and analog video signals, whereas DVI-D (Digital) supports digital video signals only","hi":"DVI-I (Integrated) डिजिटल और एनालॉग दोनों सिग्नल सपोर्ट करता है, जबकि DVI-D केवल डिजिटल सिग्नल (digital-only) सपोर्ट करता है"},{"en":"DVI-I is used for internet networking, whereas DVI-D is used for dot matrix printers","hi":"DVI-I का उपयोग इंटरनेट नेटवर्किंग के लिए होता है, जबकि DVI-D का उपयोग डॉट मैट्रिक्स प्रिंटर के लिए होता है"},{"en":"DVI-I carries only audio signals, whereas DVI-D carries only electric power","hi":"DVI-I केवल ऑडियो सिग्नल ले जाता है, जबकि DVI-D केवल विद्युत शक्ति ले जाता है"},{"en":"DVI-I is wireless, whereas DVI-D requires a 50-pin ribbon cable","hi":"DVI-I वायरलेस है, जबकि DVI-D को 50-पिन रिबन केबल की आवश्यकता होती है"}],"exp":{"en":"In Digital Visual Interface (DVI) variants, DVI-I (Integrated) has extra pins around the flat blade to carry both digital and analog video signals, whereas DVI-D (Digital) carries digital video signals only.","hi":"DVI-I (Integrated) डिजिटल और एनालॉग दोनों प्रकार के वीडियो सिग्नलों को सपोर्ट करता है, जबकि DVI-D (Digital) केवल डिजिटल सिग्नल (digital-only) के लिए होता है।"},"num":128},{"id":"q129","q":{"en":"What are the respective uses of a standard 3.5 mm Audio Jack and an Optical Audio Port (TOSLINK/S/PDIF)?","hi":"ऑडियो जैक (Audio Jack) और ऑप्टिकल ऑडियो पोर्ट (Optical Audio Port) का क्रमशः क्या उपयोग है?"},"a":{"en":"An audio jack is used for analog audio devices (headphones/speakers/mic), while an optical audio port transmits digital audio signals using light","hi":"ऑडियो जैक एनालॉग ऑडियो उपकरणों के लिए और ऑप्टिकल ऑप्टिकल पोर्ट डिजिटल ऑडियो सिग्नल के लिए उपयोग होता है"},"o":[{"en":"An audio jack is used for analog audio devices (headphones/speakers/mic), while an optical audio port transmits digital audio signals using light","hi":"ऑडियो जैक एनालॉग ऑडियो उपकरणों के लिए और ऑप्टिकल ऑप्टिकल पोर्ट डिजिटल ऑडियो सिग्नल के लिए उपयोग होता है"},{"en":"Both are used exclusively to connect external SATA hard drives","hi":"दोनों का उपयोग केवल बाहरी SATA हार्ड ड्राइव को जोड़ने के लिए किया जाता है"},{"en":"Audio jack transmits 4K video, while optical audio port reads barcodes","hi":"ऑडियो जैक 4K वीडियो ट्रांसफर करता है, जबकि ऑप्टिकल ऑडियो पोर्ट बारकोड पढ़ता है"},{"en":"Audio jack is a 25-pin parallel port, while optical audio port is a 15-pin VGA port","hi":"ऑडियो जैक 25-पिन पैरेलल पोर्ट है, जबकि ऑप्टिकल ऑडियो पोर्ट 15-पिन VGA पोर्ट है"}],"exp":{"en":"A standard 3.5 mm TRS/TRRS audio jack connects analog audio peripherals such as headphones, speakers, or microphones, whereas an optical audio port (TOSLINK) transmits multi-channel digital audio signals via optical fibre light pulses.","hi":"सामान्य ऑडियो जैक (3.5 मिमी) एनालॉग ऑडियो डिवाइसेस (जैसे हेडफ़ोन, स्पीकर, माइक) को जोड़ने के काम आता है, जबकि ऑप्टिकल ऑडियो पोर्ट प्रकाश पल्स के माध्यम से डिजिटल ऑडियो सिग्नल भेजने के लिए उपयोग होता है।"},"num":129},{"id":"q130","q":{"en":"For which devices was the legacy PS/2 port used, and what is its physical shape?","hi":"पुराना PS/2 पोर्ट किस डिवाइस के लिए उपयोग होता था और इसकी बनावट कैसी होती है?"},"a":{"en":"Used for legacy keyboards and mice; it is a round 6-pin mini-DIN connector (typically purple for keyboard and green for mouse)","hi":"पुराने कीबोर्ड या माउस के लिए; यह एक गोल (round) 6-पिन मिनी-DIN कनेक्टर होता है"},"o":[{"en":"Used for legacy keyboards and mice; it is a round 6-pin mini-DIN connector (typically purple for keyboard and green for mouse)","hi":"पुराने कीबोर्ड या माउस के लिए; यह एक गोल (round) 6-पिन मिनी-DIN कनेक्टर होता है"},{"en":"Used for high-speed laser printers; it is a wide 36-pin rectangular connector","hi":"हाई-स्पीड लेजर प्रिंटर के लिए; यह एक चौड़ा 36-पिन आयताकार कनेक्टर है"},{"en":"Used for gigabit wired LAN internet; it is a square 8-pin modular jack","hi":"गीगाबिट वायर्ड LAN इंटरनेट के लिए; यह एक चौकोर 8-पिन मॉड्यूलर जैक है"},{"en":"Used for HDMI televisions; it is a flat 19-pin digital plug","hi":"HDMI टेलीविजन के लिए; यह एक चपटा 19-पिन डिजिटल प्लग है"}],"exp":{"en":"The PS/2 port (introduced with IBM Personal System/2) is a round 6-pin mini-DIN connector used to connect legacy keyboards (purple port) and mice (green port) to a PC.","hi":"PS/2 पोर्ट का उपयोग पुराने (legacy) कीबोर्ड या माउस को जोड़ने के लिए किया जाता था। यह एक गोल (round) 6-पिन मिनी-DIN कनेक्टर होता है।"},"num":130},{"id":"q131","q":{"en":"What is the difference between SATA and eSATA ports?","hi":"SATA और eSATA पोर्ट में मुख्य अंतर क्या है?"},"a":{"en":"SATA is commonly used inside the cabinet to connect internal storage drives, whereas eSATA is its external connection variant for external drives","hi":"SATA आमतौर पर आंतरिक स्टोरेज (internal storage) जोड़ता है, जबकि eSATA उसका बाहरी कनेक्शन वेरिएंट (external variant) है"},"o":[{"en":"SATA is commonly used inside the cabinet to connect internal storage drives, whereas eSATA is its external connection variant for external drives","hi":"SATA आमतौर पर आंतरिक स्टोरेज (internal storage) जोड़ता है, जबकि eSATA उसका बाहरी कनेक्शन वेरिएंट (external variant) है"},{"en":"SATA is an analog audio port, whereas eSATA is a video projector port","hi":"SATA एक एनालॉग ऑडियो पोर्ट है, जबकि eSATA एक वीडियो प्रोजेक्टर पोर्ट है"},{"en":"SATA is wireless Wi-Fi, whereas eSATA is a telephone modem jack","hi":"SATA वायरलेस वाई-फाई है, जबकि eSATA टेलीफोन मॉडेम जैक है"},{"en":"SATA transfers 8 bits in parallel, whereas eSATA is used only for keyboards","hi":"SATA समानांतर में 8 बिट्स ट्रांसफर करता है, जबकि eSATA केवल कीबोर्ड के लिए उपयोग होता है"}],"exp":{"en":"SATA (Serial Advanced Technology Attachment) is the standard internal interface for connecting HDDs, SSDs, and optical drives to the motherboard, whereas eSATA (External SATA) is a shielded external port variant designed to connect external SATA storage drives at native speeds.","hi":"SATA सामान्यतः कैबिनेट के अंदर आंतरिक स्टोरेज ड्राइव (internal storage — जैसे HDD/SSD) को जोड़ता है, जबकि eSATA बाहरी स्टोरेज ड्राइव को जोड़ने के लिए उसका एक्सटर्नल कनेक्शन वेरिएंट है।"},"num":131},{"id":"q132","q":{"en":"What is the physical difference between a wired Ethernet jack and a traditional telephone Modem jack?","hi":"वायर्ड ईथरनेट (Ethernet) जैक और पारंपरिक टेलीफोन मॉडेम (Modem) जैक में भौतिक अंतर क्या है?"},"a":{"en":"Wired Ethernet uses a wider RJ-45-type 8-contact (8P8C) jack, whereas a traditional telephone modem uses a narrower RJ-11-type (4 or 6 contact) jack","hi":"सामान्य वायर्ड ईथरनेट चौड़ा RJ-45-प्रकार का 8-कॉन्टैक्ट जैक उपयोग करता है, जबकि पारंपरिक टेलीफोन मॉडेम का RJ-11 जैक संकरा (narrower) होता है"},"o":[{"en":"Wired Ethernet uses a wider RJ-45-type 8-contact (8P8C) jack, whereas a traditional telephone modem uses a narrower RJ-11-type (4 or 6 contact) jack","hi":"सामान्य वायर्ड ईथरनेट चौड़ा RJ-45-प्रकार का 8-कॉन्टैक्ट जैक उपयोग करता है, जबकि पारंपरिक टेलीफोन मॉडेम का RJ-11 जैक संकरा (narrower) होता है"},{"en":"Ethernet uses a narrower 2-pin plug, whereas a telephone modem uses a wide 25-pin D-sub connector","hi":"ईथरनेट एक संकरे 2-पिन प्लग का उपयोग करता है, जबकि टेलीफोन मॉडेम चौड़े 25-पिन कनेक्टर का उपयोग करता है"},{"en":"Ethernet jack is round like PS/2, whereas modem jack is L-shaped like SATA","hi":"ईथरनेट जैक PS/2 की तरह गोल होता है, जबकि मॉडेम जैक SATA की तरह L-आकार का होता है"},{"en":"Both use the exact same 15-pin 3-row VGA plug","hi":"दोनों बिल्कुल एक ही 15-पिन 3-कतार वाले VGA प्लग का उपयोग करते हैं"}],"exp":{"en":"Although both look like modular plastic telephone plugs, an Ethernet network port uses a wider 8-position, 8-contact (8P8C / RJ-45 style) connector, while a traditional landline/dial-up modem port uses a noticeably narrower RJ-11 (6P2C/6P4C) connector.","hi":"सामान्य वायर्ड ईथरनेट (LAN) में चौड़ा RJ-45 प्रकार का 8-कॉन्टैक्ट जैक उपयोग होता है, जबकि पारंपरिक टेलीफोन मॉडेम का RJ-11 प्रकार का जैक आकार में उससे संकरा (narrower) होता है।"},"num":132},{"id":"q133","q":{"en":"What is the data transmission method of a legacy 'Serial Port'?","hi":"पुराने 'सीरियल पोर्ट' (Legacy Serial Port) की डेटा ट्रांसमिशन विधि क्या है?"},"a":{"en":"It transmits bits sequentially one after another in a single serial stream","hi":"यह एक सीरियल स्ट्रीम में बिट्स को एक के बाद एक (one after another) क्रमशः भेजता है"},"o":[{"en":"It transmits bits sequentially one after another in a single serial stream","hi":"यह एक सीरियल स्ट्रीम में बिट्स को एक के बाद एक (one after another) क्रमशः भेजता है"},{"en":"It transmits 64 bits simultaneously across 64 separate parallel wires","hi":"यह 64 अलग-अलग समानांतर तारों पर एक साथ 64 बिट्स भेजता है"},{"en":"It transmits data using holographic laser beams through glass","hi":"यह कांच के माध्यम से होलोग्राफिक लेजर किरणों का उपयोग करके डेटा भेजता है"},{"en":"It only receives analog FM radio waves without wires","hi":"यह बिना तारों के केवल एनालॉग एफएम रेडियो तरंगें प्राप्त करता है"}],"exp":{"en":"A serial port (COM port / RS-232) communicates by sending data one bit at a time, sequentially (one after another), over a single communication line/stream.","hi":"सीरियल पोर्ट (Serial Port) एक सीरियल स्ट्रीम में डेटा बिट्स को एक के बाद एक (one after another) क्रम से भेजता है।"},"num":133},{"id":"q134","q":{"en":"What were the common uses, pin counts, and typical textbook speed example of a legacy PC Serial Port?","hi":"पुराने सीरियल पोर्ट (Legacy Serial Port) के उपयोग, पिनों की संख्या और नोट्स में दी गई गति (Speed) क्या हैं?"},"a":{"en":"Used for external dial-up modems and older mice; came in 9-pin (DE-9) or 25-pin (DB-25) versions; textbook speed example is roughly 115 kbps (115.2 kbps)","hi":"बाहरी मॉडेम और पुराने माउस के लिए; 9-पिन या 25-पिन वर्शन; नोट्स में गति का सामान्य उदाहरण लगभग 115 kbps (115.2 kbps) है"},"o":[{"en":"Used for external dial-up modems and older mice; came in 9-pin (DE-9) or 25-pin (DB-25) versions; textbook speed example is roughly 115 kbps (115.2 kbps)","hi":"बाहरी मॉडेम और पुराने माउस के लिए; 9-पिन या 25-पिन वर्शन; नोट्स में गति का सामान्य उदाहरण लगभग 115 kbps (115.2 kbps) है"},{"en":"Used for 8K monitors; 100-pin version; speed is 40 Gbps","hi":"8K मॉनिटर के लिए; 100-पिन वर्शन; गति 40 Gbps है"},{"en":"Used for internal NVMe SSDs; 6-pin round version; speed is 10 Gbps","hi":"आंतरिक NVMe SSD के लिए; 6-पिन गोल वर्शन; गति 10 Gbps है"},{"en":"Used only forspeakers; 1-pin jack; speed is 1,000 Mbps","hi":"केवल स्पीकर के लिए; 1-पिन जैक; गति 1,000 Mbps है"}],"exp":{"en":"Legacy RS-232 serial (COM) ports were commonly used to connect external dial-up modems and early serial mice. They came in 9-pin (male DE-9) or 25-pin (DB-25) D-sub connectors, with a standard maximum UART speed of about 115.2 kbps (roughly 115 kbps).","hi":"पुराने सीरियल पोर्ट का उपयोग बाहरी मॉडेम (external modem) और पुराने माउस को जोड़ने के लिए होता था। यह 9-पिन या 25-पिन वर्शन में आता था और नोट्स के अनुसार इसकी गति लगभग 115 kbps (115.2 kbps) होती थी।"},"num":134},{"id":"q135","q":{"en":"What is the transmission method, pin count, and classic use of a legacy PC 'Parallel Port'?","hi":"पुराने 'पैरेलल पोर्ट' (Legacy Parallel Port) की ट्रांसमिशन विधि, पिन संख्या और मुख्य उपयोग क्या है?"},"a":{"en":"It sends multiple bits (e.g., 8 bits/1 byte) simultaneously over parallel lines; the 25-pin (DB-25 female) PC connector was commonly used for older printers and some scanners","hi":"यह कई बिट्स को समानांतर लाइनों पर एक साथ भेजता है; 25-पिन पीसी कनेक्टर पुराने प्रिंटरों और कुछ स्कैनरों के लिए आम था"},"o":[{"en":"It sends multiple bits (e.g., 8 bits/1 byte) simultaneously over parallel lines; the 25-pin (DB-25 female) PC connector was commonly used for older printers and some scanners","hi":"यह कई बिट्स को समानांतर लाइनों पर एक साथ भेजता है; 25-पिन पीसी कनेक्टर पुराने प्रिंटरों और कुछ स्कैनरों के लिए आम था"},{"en":"It sends 1 bit per hour over a single wire; 4-pin connector used for USB flash drives","hi":"यह एक तार पर प्रति घंटे 1 बिट भेजता है; USB फ्लैश ड्राइव के लिए प्रयुक्त 4-पिन कनेक्टर"},{"en":"It uses optical fibre to connect headphones; 3.5 mm round jack","hi":"यह हेडफ़ोन जोड़ने के लिए ऑप्टिकल फाइबर का उपयोग करता है; 3.5 मिमी गोल जैक"},{"en":"It connects dual-core CPUs to L1 cache; 15-pin VGA connector","hi":"यह डुअल-कोर CPU को L1 कैश से जोड़ता है; 15-पिन VGA कनेक्टर"}],"exp":{"en":"A parallel port (LPT port / IEEE 1284) transmits multiple bits (8 bits = 1 byte) simultaneously across parallel wires. On PCs, it used a 25-pin female D-sub connector and was primarily used to connect older printers (hence called the printer port) and some scanners.","hi":"पैरेलल पोर्ट एक साथ कई बिट्स (multiple bits) को समानांतर लाइनों पर भेजता है। पीसी का 25-पिन पैरेलल कनेक्टर पुराने प्रिंटरों (older printers) और कुछ स्कैनरों को जोड़ने के लिए बहुत आम था।"},"num":135},{"id":"q136","q":{"en":"What is the full form of USB, and what is it used for?","hi":"USB का पूर्ण रूप (Full Form) और मुख्य उपयोग क्या है?"},"a":{"en":"Universal Serial Bus — Used to connect a wide range of peripherals such as external drives, printers, scanners, mice, and keyboards","hi":"यूनिवर्सल सीरियल बस — बाहरी ड्राइव, प्रिंटर, स्कैनर, माउस और कीबोर्ड जैसे पेरिफेरल्स को जोड़ने के लिए"},"o":[{"en":"Universal Serial Bus — Used to connect a wide range of peripherals such as external drives, printers, scanners, mice, and keyboards","hi":"यूनिवर्सल सीरियल बस — बाहरी ड्राइव, प्रिंटर, स्कैनर, माउस और कीबोर्ड जैसे पेरिफेरल्स को जोड़ने के लिए"},{"en":"Unified System Battery — Used to supply backup AC power to a desktop tower","hi":"यूनिफाइड सिस्टम बैटरी — डेस्कटॉप टॉवर को बैकअप एसी पावर देने के लिए"},{"en":"Ultra Static Buffer — Used inside the ALU to hold carry flags","hi":"अल्ट्रा स्टैटिक बफर — कैरी फ्लैग्स रखने के लिए ALU के अंदर प्रयुक्त"},{"en":"Universal Storage Blu-ray — Used to read 50 GB optical discs","hi":"यूनिवर्सल स्टोरेज ब्लू-रे — 50 GB ऑप्टिकल डिस्क पढ़ने के लिए"}],"exp":{"en":"USB stands for Universal Serial Bus. It is the ubiquitous plug-and-play external interface used to connect peripherals such as pen drives, external hard disks, keyboards, mice, printers, scanners, and mobile devices.","hi":"USB का पूर्ण रूप Universal Serial Bus है। इसका उपयोग एक्सटर्नल ड्राइव्स, प्रिंटर, स्कैनर, माउस और कीबोर्ड जैसे विभिन्न पेरिफेरल उपकरणों को कंप्यूटर से जोड़ने के लिए किया जाता है।"},"num":136},{"id":"q137","q":{"en":"What is the data transfer rate of the classic 'USB Full-Speed' (USB 1.1) signaling mode mentioned in the notes?","hi":"नोट्स में उल्लेखित 'USB Full-Speed' मोड की डेटा ट्रांसफर दर (Data Rate) क्या है?"},"a":{"en":"12 Mbps (a specific USB 1.1 signaling mode; newer USB versions/modes have much higher speeds like 480 Mbps, 5 Gbps, etc.)","hi":"12 Mbps (यह एक विशिष्ट सिग्नलिंग मोड है; अन्य USB मोड्स की गति अलग/अधिक होती है)"},"o":[{"en":"12 Mbps (a specific USB 1.1 signaling mode; newer USB versions/modes have much higher speeds like 480 Mbps, 5 Gbps, etc.)","hi":"12 Mbps (यह एक विशिष्ट सिग्नलिंग मोड है; अन्य USB मोड्स की गति अलग/अधिक होती है)"},{"en":"1.44 MB per hour","hi":"1.44 MB प्रति घंटा"},{"en":"100 Terabytes per second","hi":"100 टेराबाइट प्रति सेकंड"},{"en":"8 bits per minute","hi":"8 बिट प्रति मिनट"}],"exp":{"en":"In the USB specification, 'Full-Speed' (introduced in USB 1.0/1.1) refers to the 12 Mbps signaling rate (while Low-Speed is 1.5 Mbps, USB 2.0 High-Speed is 480 Mbps, and USB 3.x SuperSpeed is 5 Gbps/10 Gbps/20 Gbps).","hi":"USB Full-Speed सिग्नलिंग मोड की डेटा दर 12 Mbps होती है (यह एक विशिष्ट मोड है; USB के अन्य आधुनिक मोड्स जैसे High-Speed या SuperSpeed की गति इससे कहीं अधिक होती है)।"},"num":137},{"id":"q138","q":{"en":"What do USB designations like Type-A, Type-B, Type-C, Mini, and Micro describe, and which one is reversible?","hi":"USB में Type-A, Type-B, Type-C, Mini और Micro क्या बताते हैं, और इनमें से कौन-सा कनेक्टर रिवर्सेबल (Reversible) है?"},"a":{"en":"They describe physical connector shapes/form factors; USB Type-C is a reversible connector, and connector shape alone does not determine maximum speed","hi":"ये कनेक्टर के भौतिक आकार (shapes) बताते हैं; Type-C एक रिवर्सेबल (दोनों तरफ से लगने वाला) कनेक्टर है"},"o":[{"en":"They describe physical connector shapes/form factors; USB Type-C is a reversible connector, and connector shape alone does not determine maximum speed","hi":"ये कनेक्टर के भौतिक आकार (shapes) बताते हैं; Type-C एक रिवर्सेबल (दोनों तरफ से लगने वाला) कनेक्टर है"},{"en":"They describe the five generations of programming languages from 1GL to 5GL","hi":"ये 1GL से 5GL तक प्रोग्रामिंग भाषाओं की पाँच पीढ़ियों का वर्णन करते हैं"},{"en":"They describe the number of cores inside a microprocessor","hi":"ये माइक्रोप्रोसेसर के अंदर कोर की संख्या बताते हैं"},{"en":"Type-A is reversible, whereas Type-C is a 25-pin parallel printer plug","hi":"Type-A रिवर्सेबल है, जबकि Type-C एक 25-पिन पैरेलल प्रिंटर प्लग है"}],"exp":{"en":"Labels like USB Type-A, Type-B, Type-C, Mini-USB, and Micro-USB specify the physical geometry (shape) of the plug and receptacle. USB Type-C features a rotationally symmetrical (reversible) plug, and the physical shape alone does not dictate the underlying USB protocol speed.","hi":"USB Type-A, Type-B, Type-C, Micro और Mini कनेक्टर के भौतिक आकार (shapes) को बताते हैं। इनमें से USB Type-C एक रिवर्सेबल (उल्टा-सीधा दोनों तरफ से लगने वाला) कनेक्टर है, और केवल आकार से अधिकतम स्पीड तय नहीं होती।"},"num":138},{"id":"q139","q":{"en":"What is the IEEE standard name for 'FireWire', what are the data rates of FireWire 400 and 800, and where was it used?","hi":"'फायरवायर' (FireWire) का दूसरा मानक नाम, FireWire 400 व 800 की गति और इसका मुख्य उपयोग क्या था?"},"a":{"en":"IEEE 1394; FireWire 400 and 800 operate at roughly 400 Mbps and 800 Mbps classes respectively; commonly used for legacy digital camcorders and professional video/audio equipment","hi":"IEEE 1394; गति क्रमशः लगभग 400 Mbps और 800 Mbps; पुराने कैमकॉर्डर और वीडियो उपकरणों में प्रयुक्त"},"o":[{"en":"IEEE 1394; FireWire 400 and 800 operate at roughly 400 Mbps and 800 Mbps classes respectively; commonly used for legacy digital camcorders and professional video/audio equipment","hi":"IEEE 1394; गति क्रमशः लगभग 400 Mbps और 800 Mbps; पुराने कैमकॉर्डर और वीडियो उपकरणों में प्रयुक्त"},{"en":"IEEE 802.11; operates at 10 kbps; used only for mechanical keyboards","hi":"IEEE 802.11; 10 kbps पर काम करता है; केवल मैकेनिकल कीबोर्ड के लिए प्रयुक्त"},{"en":"RS-232C; operates at 1.44 MB; used for floppy disk drives","hi":"RS-232C; 1.44 MB पर काम करता है; फ्लॉपी डिस्क ड्राइव के लिए प्रयुक्त"},{"en":"HDMI 2.1; operates at 100 Gbps; used for dot matrix ribbons","hi":"HDMI 2.1; 100 Gbps पर काम करता है; डॉट मैट्रिक्स रिबन के लिए प्रयुक्त"}],"exp":{"en":"FireWire is standardized as IEEE 1394 (developed by Apple and others). FireWire 400 (IEEE 1394a) and FireWire 800 (IEEE 1394b) provide data transfer rates in the ~400 Mbps and ~800 Mbps classes respectively, and were widely used to connect digital camcorders, external hard drives, and audio/video editing gear.","hi":"FireWire का मानक तकनीकी नाम IEEE 1394 है। FireWire 400 और 800 क्रमशः लगभग 400 Mbps और 800 Mbps गति वर्ग के हैं, और इनका उपयोग पुराने डिजिटल कैमकॉर्डर (camcorders) तथा वीडियो उपकरणों को जोड़ने में होता था।"},"num":139},{"id":"q140","q":{"en":"What is the primary use of an 'Ethernet Port', and what are its common speed examples in the chapter notes?","hi":"'ईथरनेट पोर्ट' (Ethernet Port) का मुख्य उपयोग क्या है और नोट्स में इसकी गति के सामान्य उदाहरण क्या दिए गए हैं?"},"a":{"en":"Used for wired LAN (Local Area Network) or broadband internet connection; 10 Mbps, 100 Mbps, and 1000 Mbps (1 Gbps) are common examples (faster standards also exist)","hi":"वायर्ड LAN या इंटरनेट कनेक्शन के लिए; 10, 100 और 1000 Mbps इसके सामान्य गति उदाहरण हैं"},"o":[{"en":"Used for wired LAN (Local Area Network) or broadband internet connection; 10 Mbps, 100 Mbps, and 1000 Mbps (1 Gbps) are common examples (faster standards also exist)","hi":"वायर्ड LAN या इंटरनेट कनेक्शन के लिए; 10, 100 और 1000 Mbps इसके सामान्य गति उदाहरण हैं"},{"en":"Used to connect analog CRT monitors; 60 Hz and 75 Hz are its speeds","hi":"एनालॉग CRT मॉनिटर जोड़ने के लिए; 60 Hz और 75 Hz इसकी गति हैं"},{"en":"Used to erase EPROM chips; 200–540 characters/sec is its speed","hi":"EPROM चिप्स को मिटाने के लिए; 200–540 अक्षर/सेकंड इसकी गति है"},{"en":"Used only for wireless Bluetooth mice; 115 kbps is its maximum speed","hi":"केवल वायरलेस ब्लू-टूथ माउस के लिए; 115 kbps इसकी अधिकतम गति है"}],"exp":{"en":"An Ethernet port (RJ-45 / 8P8C) is used to connect a computer to a wired Local Area Network (LAN), router, switch, or broadband internet. Classic Ethernet speed tiers are 10 Mbps (Ethernet), 100 Mbps (Fast Ethernet), and 1,000 Mbps / 1 Gbps (Gigabit Ethernet), with modern standards reaching 2.5G, 10G, and higher.","hi":"ईथरनेट पोर्ट का उपयोग वायर्ड LAN (लोकल एरिया नेटवर्क) या इंटरनेट कनेक्शन के लिए होता है। नोट्स में 10 Mbps, 100 Mbps और 1000 Mbps (1 Gbps) इसके सामान्य उदाहरण दिए गए हैं (इससे तेज़ मानक भी उपलब्ध हैं)।"},"num":140}]},{"title":{"en":"11. Architecture, Operating Systems & File Explorer","hi":"11. आर्किटेक्चर, ऑपरेटिंग सिस्टम और फाइल एक्सप्लोरर"},"questions":[{"id":"q141","q":{"en":"What is the basic memory arrangement in 'Von Neumann Architecture'?","hi":"'वॉन न्यूमैन आर्किटेक्चर' (Von Neumann Architecture) में मेमोरी की मूल व्यवस्था क्या होती है?"},"a":{"en":"Program instructions and data share the same memory space and a common bus/access path; the CPU sequentially fetches instructions unless a branch alters the flow","hi":"निर्देश (instructions) और डेटा एक ही साझा मेमोरी (shared memory) और एक्सेस पथ का उपयोग करते हैं"},"o":[{"en":"Program instructions and data share the same memory space and a common bus/access path; the CPU sequentially fetches instructions unless a branch alters the flow","hi":"निर्देश (instructions) और डेटा एक ही साझा मेमोरी (shared memory) और एक्सेस पथ का उपयोग करते हैं"},{"en":"Instructions are stored on punched cards while data is stored only inside the monitor","hi":"निर्देश पंच कार्ड पर रखे जाते हैं जबकि डेटा केवल मॉनिटर के अंदर रखा जाता है"},{"en":"There is no memory at all; the CPU uses only an inkjet printer to hold operands","hi":"इसमें कोई मेमोरी नहीं होती; CPU ऑपरेंड रखने के लिए केवल इंकजेट प्रिंटर का उपयोग करता है"},{"en":"Instructions and data must use two completely separate physical computers","hi":"निर्देशों और डेटा को दो पूरी तरह से अलग भौतिक कंप्यूटरों का उपयोग करना पड़ता है"}],"exp":{"en":"In Von Neumann architecture (stored-program concept), both program instructions and data are stored together in a single shared main memory and transferred over a shared bus pathway.","hi":"वॉन न्यूमैन आर्किटेक्चर में प्रोग्राम के निर्देश (instructions) और डेटा एक ही साझा मेमोरी (shared memory) और साझा एक्सेस पथ (bus) का उपयोग करते हैं।"},"num":141},{"id":"q142","q":{"en":"What is the defining feature of 'Harvard Architecture'?","hi":"'हार्वर्ड आर्किटेक्चर' (Harvard Architecture) की मुख्य विशेषता क्या है?"},"a":{"en":"It provides physically separate memories and separate buses for instructions and data, allowing the CPU to access both simultaneously in parallel","hi":"इसमें निर्देशों (instructions) और डेटा के लिए मेमोरी और बसें अलग-अलग (separate) होती हैं, जिससे CPU दोनों को समानांतर (parallel) रूप से एक्सेस कर सकता है"},"o":[{"en":"It provides physically separate memories and separate buses for instructions and data, allowing the CPU to access both simultaneously in parallel","hi":"इसमें निर्देशों (instructions) और डेटा के लिए मेमोरी और बसें अलग-अलग (separate) होती हैं, जिससे CPU दोनों को समानांतर (parallel) रूप से एक्सेस कर सकता है"},{"en":"It combines the keyboard, mouse, and printer into a single vacuum tube","hi":"यह कीबोर्ड, माउस और प्रिंटर को एक ही वैक्यूम ट्यूब में मिलाता है"},{"en":"It uses a single shared memory without any address bus","hi":"यह बिना किसी एड्रेस बस के एकल साझा मेमोरी का उपयोग करता है"},{"en":"It can only execute SQL database queries and cannot perform addition","hi":"यह केवल SQL डेटाबेस क्वेरी चला सकता है और जोड़ नहीं कर सकता"}],"exp":{"en":"Harvard architecture uses physically separate storage and dedicated signal pathways (buses) for instructions and data, enabling the processor to fetch an instruction and read/write data at the same time.","hi":"हार्वर्ड आर्किटेक्चर की मुख्य विशेषता यह है कि इसमें निर्देशों (instructions) और डेटा के लिए मेमोरी तथा बसें अलग-अलग (separate) होती हैं, जिससे CPU दोनों को एक साथ समानांतर (parallel) रूप से एक्सेस कर सकता है।"},"num":142},{"id":"q143","q":{"en":"What is meant by the 'Von Neumann Bottleneck'?","hi":"'वॉन न्यूमैन बॉटलनेक' (Von Neumann Bottleneck) का क्या अर्थ है?"},"a":{"en":"Because instructions and data share a single bus/memory path, instruction fetching and data access can compete for the same pathway, limiting throughput","hi":"साझा मेमोरी पथ (shared path) होने के कारण इंस्ट्रक्शन फेच और डेटा एक्सेस एक ही रास्ते के लिए प्रतिस्पर्धा करते हैं, जिससे गति सीमित होती है"},"o":[{"en":"Because instructions and data share a single bus/memory path, instruction fetching and data access can compete for the same pathway, limiting throughput","hi":"साझा मेमोरी पथ (shared path) होने के कारण इंस्ट्रक्शन फेच और डेटा एक्सेस एक ही रास्ते के लिए प्रतिस्पर्धा करते हैं, जिससे गति सीमित होती है"},{"en":"The physical neck of a glass CRT tube becoming too narrow for electrons","hi":"कांच की CRT ट्यूब की भौतिक गर्दन इलेक्ट्रॉनों के लिए बहुत संकरी हो जाना"},{"en":"An inkjet printer nozzle getting clogged with dried liquid ink","hi":"सूखी तरल स्याही से इंकजेट प्रिंटर का नोजल बंद हो जाना"},{"en":"A keyboard cable getting tangled with a mouse cable on the desk","hi":"मेज पर कीबोर्ड केबल का माउस केबल के साथ उलझ जाना"}],"exp":{"en":"The Von Neumann bottleneck refers to the throughput limitation caused by having a single shared bus between the CPU and main memory, where instruction fetches and data transfers cannot occur simultaneously and must wait for each other.","hi":"साझा मेमोरी पथ (shared memory path) होने के कारण वॉन न्यूमैन आर्किटेक्चर में इंस्ट्रक्शन फेच (निर्देश लाना) और डेटा एक्सेस एक ही बस के लिए आपस में प्रतिस्पर्धा (compete) करते हैं; इसी सीमा को 'वॉन न्यूमैन बॉटलनेक' कहा जाता है।"},"num":143},{"id":"q144","q":{"en":"How is 'Hardware' defined in the architecture/OS review section?","hi":"कंप्यूटर सिस्टम में 'हार्डवेयर' (Hardware) किसे कहते हैं?"},"a":{"en":"The tangible, physical components of a computer system","hi":"कंप्यूटर सिस्टम के भौतिक घटक (Physical components)"},"o":[{"en":"The tangible, physical components of a computer system","hi":"कंप्यूटर सिस्टम के भौतिक घटक (Physical components)"},{"en":"Raw unprocessed numbers and text strings","hi":"कच्चे अपरिष्कृत नंबर और टेक्स्ट स्ट्रिंग्स"},{"en":"Database tables created inside Microsoft Access","hi":"माइक्रोसॉफ्ट एक्सेस के अंदर बनाई गई डेटाबेस तालिकाएँ"},{"en":"Keyboard shortcuts like Ctrl + C and Ctrl + V","hi":"Ctrl + C और Ctrl + V जैसे कीबोर्ड शॉर्टकट"}],"exp":{"en":"Hardware refers to all the physical, tangible electronic and mechanical components that make up a computer system.","hi":"कंप्यूटर सिस्टम के सभी भौतिक घटकों (physical components) को हार्डवेयर कहते हैं।"},"num":144},{"id":"q145","q":{"en":"What is 'Data' in computer terminology?","hi":"कंप्यूटर शब्दावली में 'डेटा' (Data) किसे कहते हैं?"},"a":{"en":"Raw facts and figures that can be processed by a computer to produce meaningful information","hi":"कच्चे तथ्य और आँकड़े (Raw facts and figures) जिन्हें प्रोसेस करके अर्थपूर्ण सूचना (information) बनाई जा सकती है"},"o":[{"en":"Raw facts and figures that can be processed by a computer to produce meaningful information","hi":"कच्चे तथ्य और आँकड़े (Raw facts and figures) जिन्हें प्रोसेस करके अर्थपूर्ण सूचना (information) बनाई जा सकती है"},{"en":"The metal cooling heatsink attached to the microprocessor","hi":"माइक्रोप्रोसेसर से जुड़ा धातु का कूलिंग हीटसिंक"},{"en":"The 15-pin analog VGA cable connecting a monitor","hi":"मॉनिटर को जोड़ने वाली 15-पिन एनालॉग VGA केबल"},{"en":"Only the physical power button on the front of the system unit","hi":"सिस्टम यूनिट के सामने लगा केवल भौतिक पावर बटन"}],"exp":{"en":"Data consists of raw, unorganized facts, figures, symbols, or observations that are input into a computer to be processed into meaningful information.","hi":"कच्चे तथ्यों और आँकड़ों (raw facts and figures) को 'डेटा' कहते हैं, जिन्हें कंप्यूटर द्वारा प्रोसेस करके अर्थपूर्ण सूचना (information) बनाई जाती है।"},"num":145},{"id":"q146","q":{"en":"What is the primary role of an 'Operating System' (OS)?","hi":"'ऑपरेटिंग सिस्टम' (Operating System - OS) क्या कार्य करता है?"},"a":{"en":"It manages computer hardware and system resources, and provides an interface for users and application programs to interact with the system","hi":"यह हार्डवेयर और सिस्टम संसाधनों का प्रबंधन करता है तथा यूज़र्स और प्रोग्रामों को सिस्टम उपयोग करने का इंटरफेस देता है"},"o":[{"en":"It manages computer hardware and system resources, and provides an interface for users and application programs to interact with the system","hi":"यह हार्डवेयर और सिस्टम संसाधनों का प्रबंधन करता है तथा यूज़र्स और प्रोग्रामों को सिस्टम उपयोग करने का इंटरफेस देता है"},{"en":"It acts only as a surge protector to prevent electrical short circuits","hi":"यह विद्युत शॉर्ट सर्किट को रोकने के लिए केवल सर्ज प्रोटेक्टर के रूप में कार्य करता है"},{"en":"It physically prints vector banners on vinyl sheets","hi":"यह विनाइल शीट पर वेक्टर बैनर को भौतिक रूप से प्रिंट करता है"},{"en":"It is used exclusively for creating slide presentations","hi":"इसका उपयोग विशेष रूप से स्लाइड प्रेजेंटेशन बनाने के लिए किया जाता है"}],"exp":{"en":"An Operating System (system software) manages all hardware components and system resources (CPU, memory, files, I/O devices) and provides a platform/interface for users and applications to use the computer.","hi":"ऑपरेटिंग सिस्टम हार्डवेयर और सिस्टम संसाधनों (system resources) को मैनेज करता है तथा यूज़र्स और प्रोग्रामों को कंप्यूटर सिस्टम का उपयोग करने के लिए एक इंटरफेस प्रदान करता है।"},"num":146},{"id":"q147","q":{"en":"Which of the following sets lists valid examples of Operating Systems from the notes?","hi":"नोट्स के अनुसार निम्नलिखित में से कौन-से ऑपरेटिंग सिस्टम (Operating Systems) के उदाहरण हैं?"},"a":{"en":"DOS, UNIX, Windows, Linux, and macOS","hi":"DOS, UNIX, Windows, Linux और macOS"},"o":[{"en":"DOS, UNIX, Windows, Linux, and macOS","hi":"DOS, UNIX, Windows, Linux और macOS"},{"en":"VGA, HDMI, SATA, USB, and FireWire","hi":"VGA, HDMI, SATA, USB और FireWire"},{"en":"SRAM, DRAM, PROM, EPROM, and EEPROM","hi":"SRAM, DRAM, PROM, EPROM और EEPROM"},{"en":"OMR, OCR, MICR, BCR, and QR","hi":"OMR, OCR, MICR, BCR और QR"}],"exp":{"en":"Standard examples of Operating Systems listed in the chapter notes are MS-DOS, UNIX, Microsoft Windows, Linux, and Apple macOS.","hi":"ऑपरेटिंग सिस्टम के प्रमुख उदाहरण DOS, UNIX, Windows, Linux और macOS हैं।"},"num":147},{"id":"q148","q":{"en":"What is a 'Database'?","hi":"'डेटाबेस' (Database) क्या है?"},"a":{"en":"An organized collection of related data that can be easily accessed, managed, and updated","hi":"संबंधित डेटा का एक सुव्यवस्थित संग्रह (Organized collection of related data)"},"o":[{"en":"An organized collection of related data that can be easily accessed, managed, and updated","hi":"संबंधित डेटा का एक सुव्यवस्थित संग्रह (Organized collection of related data)"},{"en":"The plastic base of a stationary trackball या joystick","hi":"स्थिर ट्रैकबॉल या जॉयस्टिक का प्लास्टिक आधार"},{"en":"A 25-pin parallel cable used for dot matrix printers","hi":"डॉट मैट्रिक्स प्रिंटर के लिए प्रयुक्त 25-पिन पैरेलल केबल"},{"en":"An ultraviolet lamp used to erase EPROM chips","hi":"EPROM चिप्स को मिटाने के लिए प्रयुक्त एक पराबैंगनी लैंप"}],"exp":{"en":"A database is a systematic, organized collection of related data structured so that it can be efficiently stored, queried, retrieved, and managed.","hi":"संबंधित डेटा के सुव्यवस्थित संग्रह (organized collection of related data) को 'डेटाबेस' कहा जाता है।"},"num":148},{"id":"q149","q":{"en":"What is 'Microsoft Access' primarily used for?","hi":"'माइक्रोसॉफ्ट एक्सेस' (Microsoft Access) का मुख्य उपयोग क्या है?"},"a":{"en":"Creating, querying, and managing relational databases (a Database Management System)","hi":"डेटाबेस को क्रिएट (बनाने), क्वेरी करने और मैनेज करने के लिए (DBMS)"},"o":[{"en":"Creating, querying, and managing relational databases (a Database Management System)","hi":"डेटाबेस को क्रिएट (बनाने), क्वेरी करने और मैनेज करने के लिए (DBMS)"},{"en":"Editing 3D Hollywood movie special effects","hi":"3D हॉलीवुड मूवी स्पेशल इफेक्ट्स को एडिट करने के लिए"},{"en":"Scanning paper documents on a flatbed glass platen","hi":"फ्लैटबेड कांच की प्लेट पर कागजी दस्तावेज़ों को स्कैन करने के लिए"},{"en":"Controlling the fan speed of the power supply unit","hi":"पावर सप्लाई यूनिट की फैन स्पीड को नियंत्रित करने के लिए"}],"exp":{"en":"Microsoft Access is a relational Database Management System (DBMS) application included in the Microsoft Office suite, used to create, query, and manage databases.","hi":"Microsoft Access का उपयोग डेटाबेस बनाने (create), क्वेरी करने (query) और प्रबंधित (manage) करने के लिए किया जाता है।"},"num":149},{"id":"q150","q":{"en":"What is the modern name of 'Windows Explorer' in recent versions of Windows (Windows 8/10/11)?","hi":"विंडोज़ के आधुनिक संस्करणों में 'विंडोज़ एक्सप्लोरर' (Windows Explorer) का नया नाम क्या है?"},"a":{"en":"File Explorer","hi":"फ़ाइल एक्सप्लोरर (File Explorer)"},"o":[{"en":"File Explorer","hi":"फ़ाइल एक्सप्लोरर (File Explorer)"},{"en":"Internet Explorer","hi":"इंटरनेट एक्सप्लोरर"},{"en":"Control Panel","hi":"कंट्रोल पैनल"},{"en":"Task Manager","hi":"टास्क मैनेजर"}],"exp":{"en":"Starting with Windows 8 and continuing in Windows 10 and 11, the built-in file manager formerly known as 'Windows Explorer' was renamed 'File Explorer'.","hi":"विंडोज़ एक्सप्लोरर (Windows Explorer) का नया नाम 'फ़ाइल एक्सप्लोरर' (File Explorer) है।"},"num":150},{"id":"q151","q":{"en":"What does the Left Pane (Navigation Pane) of File Explorer display?","hi":"फ़ाइल एक्सप्लोरर (File Explorer) का बायाँ पेन (Left Pane) क्या दिखाता है?"},"a":{"en":"A navigation tree where drives and folders are displayed in a hierarchical order for quick browsing","hi":"नेविगेशन ट्री (Navigation tree), जिसमें ड्राइव्स और फ़ोल्डर्स पदानुक्रमित क्रम (hierarchical order) में दिखते हैं"},"o":[{"en":"A navigation tree where drives and folders are displayed in a hierarchical order for quick browsing","hi":"नेविगेशन ट्री (Navigation tree), जिसमें ड्राइव्स और फ़ोल्डर्स पदानुक्रमित क्रम (hierarchical order) में दिखते हैं"},{"en":"Only the CPU temperature and RAM clock speed","hi":"केवल CPU का तापमान और RAM की क्लॉक स्पीड"},{"en":"The binary machine code of the operating system kernel","hi":"ऑपरेटिंग सिस्टम कर्नेल का बाइनरी मशीन कोड"},{"en":"A list of all keyboard shortcuts in MS Word","hi":"MS Word के सभी कीबोर्ड शॉर्टकट्स की सूची"}],"exp":{"en":"The left pane of File Explorer is the Navigation Pane, which displays a hierarchical tree structure of quick-access locations, This PC, drives, and folders.","hi":"फ़ाइल एक्सप्लोरर का बायाँ पेन (left pane) 'नेविगेशन ट्री' (navigation tree) दिखाता है, जिसमें कंप्यूटर की ड्राइव्स और फ़ोल्डर्स पदानुक्रमित क्रम (hierarchical order) में दिखाई देते हैं।"},"num":151},{"id":"q152","q":{"en":"What does the Main/Right Pane of File Explorer display?","hi":"फ़ाइल एक्सप्लोरर (File Explorer) का मुख्य/दायाँ पेन (Main/Right Pane) क्या दिखाता है?"},"a":{"en":"The files and subfolders contained inside the currently selected drive or folder","hi":"चुने गए (selected) ड्राइव या फ़ोल्डर के अंदर मौजूद फ़ाइलें और सबफ़ोल्डर्स"},"o":[{"en":"The files and subfolders contained inside the currently selected drive or folder","hi":"चुने गए (selected) ड्राइव या फ़ोल्डर के अंदर मौजूद फ़ाइलें और सबफ़ोल्डर्स"},{"en":"Only the BIOS setup utility screen","hi":"केवल BIOS सेटअप यूटिलिटी स्क्रीन"},{"en":"The physical pin layout of a VGA connector","hi":"VGA कनेक्टर का भौतिक पिन लेआउट"},{"en":"Only deleted files that have been overwritten on magnetic tape","hi":"केवल वे डिलीट की गई फ़ाइलें जिन्हें मैग्नेटिक टेप पर ओवरराइट कर दिया गया है"}],"exp":{"en":"The main (right) content pane of File Explorer displays the individual files and subfolders residing inside whichever drive or folder is currently selected in the left navigation pane.","hi":"फ़ाइल एक्सप्लोरर का मुख्य या दायाँ पेन (main/right pane) वर्तमान में चुने गए ड्राइव या फ़ोल्डर के अंदर की फ़ाइलें (files) और सबफ़ोल्डर्स (subfolders) दिखाता है।"},"num":152}]},{"title":{"en":"12. Keyboard Shortcuts","hi":"12. कीबोर्ड शॉर्टकट"},"questions":[{"id":"q153","q":{"en":"What is the function of the keyboard shortcut 'Ctrl + A'?","hi":"कीबोर्ड शॉर्टकट 'Ctrl + A' का क्या काम है?"},"a":{"en":"Select all content in the current document, window, or folder","hi":"वर्तमान दस्तावेज़, विंडो या फ़ोल्डर में सब कुछ सेलेक्ट करना (Select all)"},"o":[{"en":"Select all content in the current document, window, or folder","hi":"वर्तमान दस्तावेज़, विंडो या फ़ोल्डर में सब कुछ सेलेक्ट करना (Select all)"},{"en":"Align text to the right margin","hi":"टेक्स्ट को दाएँ मार्जिन पर संरेखित करना"},{"en":"Save the document with a new filename","hi":"दस्तावेज़ को नए फ़ाइल नाम के साथ सहेजना"},{"en":"Close the active application window immediately","hi":"सक्रिय एप्लिकेशन विंडो को तुरंत बंद करना"}],"exp":{"en":"Pressing Ctrl + A selects all text, files, or items in the active document, text box, or File Explorer window.","hi":"'Ctrl + A' शॉर्टकट का उपयोग सक्रिय दस्तावेज़ या विंडो में मौजूद सभी कंटेंट को एक साथ सेलेक्ट करने (Select all) के लिए किया जाता है।"},"num":153},{"id":"q154","q":{"en":"What is the function of the keyboard shortcut 'Ctrl + B' in Microsoft Word?","hi":"MS Word में कीबोर्ड शॉर्टकट 'Ctrl + B' का क्या काम है?"},"a":{"en":"Toggle Bold formatting on or off for the selected text","hi":"चुने गए टेक्स्ट को बोल्ड (Bold) ऑन/ऑफ करना"},"o":[{"en":"Insert a blank page break","hi":"एक खाली पेज ब्रेक डालना"},{"en":"Toggle Bold formatting on or off for the selected text","hi":"चुने गए टेक्स्ट को बोल्ड (Bold) ऑन/ऑफ करना"},{"en":"Add a bookmark to a web browser","hi":"वेब ब्राउज़र में बुकमार्क जोड़ना"},{"en":"Change the page background colour to blue","hi":"पेज का बैकग्राउंड रंग नीला करना"}],"exp":{"en":"In word processors like Microsoft Word, pressing Ctrl + B toggles Bold formatting (heavier/darker font weight) on or off for the selected text.","hi":"MS Word में 'Ctrl + B' शॉर्टकट का काम चुने गए टेक्स्ट पर बोल्ड (Bold — गहरा अक्षर) फ़ॉर्मेटिंग को ऑन या ऑफ करना है।"},"num":154},{"id":"q155","q":{"en":"What is the function of the keyboard shortcut 'Ctrl + C'?","hi":"कीबोर्ड शॉर्टकट 'Ctrl + C' का क्या काम है?"},"a":{"en":"Copy the selected text, file, or object to the clipboard","hi":"चुने गए टेक्स्ट, फ़ाइल या ऑब्जेक्ट को क्लिपबोर्ड पर कॉपी (Copy) करना"},"o":[{"en":"Copy the selected text, file, or object to the clipboard","hi":"चुने गए टेक्स्ट, फ़ाइल या ऑब्जेक्ट को क्लिपबोर्ड पर कॉपी (Copy) करना"},{"en":"Cut and delete the selected text permanently","hi":"चुने गए टेक्स्ट को स्थायी रूप से कट और डिलीट करना"},{"en":"Center-align the current paragraph","hi":"वर्तमान पैराग्राफ को सेंटर-अलाइन करना"},{"en":"Create a new blank folder on the desktop","hi":"डेस्कटॉप पर एक नया खाली फ़ोल्डर बनाना"}],"exp":{"en":"Pressing Ctrl + C copies the currently highlighted/selected text, file, or object to the system clipboard while leaving the original intact.","hi":"'Ctrl + C' शॉर्टकट का उपयोग चुने गए टेक्स्ट या आइटम को कॉपी (Copy) करने के लिए किया जाता है।"},"num":155},{"id":"q156","q":{"en":"What is the function of the keyboard shortcut 'Ctrl + E' in Microsoft Word?","hi":"MS Word में कीबोर्ड शॉर्टकट 'Ctrl + E' का क्या काम है?"},"a":{"en":"Center-align the selected paragraph or text horizontally on the page","hi":"पैराग्राफ को पेज के बीच में संरेखित (Center align) करना"},"o":[{"en":"Exit the Microsoft Word application","hi":"माइक्रोसॉफ्ट वर्ड एप्लिकेशन से बाहर निकलना"},{"en":"Center-align the selected paragraph or text horizontally on the page","hi":"पैराग्राफ को पेज के बीच में संरेखित (Center align) करना"},{"en":"Erase the entire hard disk partition","hi":"संपूर्ण हार्ड डिस्क पार्टीशन को मिटाना"},{"en":"Export the document as an Excel spreadsheet","hi":"दस्तावेज़ को एक्सेल स्प्रेडशीट के रूप में एक्सपोर्ट करना"}],"exp":{"en":"In Microsoft Word, pressing Ctrl + E centers the current paragraph or selected text horizontally between the left and right margins.","hi":"MS Word में 'Ctrl + E' शॉर्टकट का काम पैराग्राफ को सेंटर अलाइन (Center align — पेज के बीचों-बीच संरेखित) करना है।"},"num":156},{"id":"q157","q":{"en":"What is the function of the keyboard shortcut 'Ctrl + I' in Microsoft Word?","hi":"MS Word में कीबोर्ड शॉर्टकट 'Ctrl + I' का क्या काम है?"},"a":{"en":"Toggle Italic formatting (slanted text) on or off","hi":"टेक्स्ट पर इटैलिक (Italic — तिरछे अक्षर) फ़ॉर्मेटिंग ऑन/ऑफ करना"},"o":[{"en":"Toggle Italic formatting (slanted text) on or off","hi":"टेक्स्ट पर इटैलिक (Italic — तिरछे अक्षर) फ़ॉर्मेटिंग ऑन/ऑफ करना"},{"en":"Insert an image from a scanner","hi":"स्कैनर से एक इमेज डालना"},{"en":"Increase the font size by 10 points","hi":"फ़ॉन्ट का आकार 10 पॉइंट बढ़ाना"},{"en":"Invert the colours of the computer monitor","hi":"कंप्यूटर मॉनिटर के रंगों को उलटना"}],"exp":{"en":"In Microsoft Word, pressing Ctrl + I toggles Italic formatting (slanted typeface) on or off for the selected text.","hi":"MS Word में 'Ctrl + I' शॉर्टकट का काम चुने गए टेक्स्ट पर इटैलिक (Italic — तिरछे अक्षर) फ़ॉर्मेटिंग को ऑन या ऑफ करना है।"},"num":157},{"id":"q158","q":{"en":"What is the function of the keyboard shortcut 'Ctrl + J' in Microsoft Word?","hi":"MS Word में कीबोर्ड शॉर्टकट 'Ctrl + J' का क्या काम है?"},"a":{"en":"Justify the paragraph (align text evenly along both the left and right margins)","hi":"पैराग्राफ को जस्टिफाई (Justify — बाएँ और दाएँ दोनों मार्जिन से बराबर) करना"},"o":[{"en":"Justify the paragraph (align text evenly along both the left and right margins)","hi":"पैराग्राफ को जस्टिफाई (Justify — बाएँ और दाएँ दोनों मार्जिन से बराबर) करना"},{"en":"Jump to the last page of the document","hi":"दस्तावेज़ के अंतिम पृष्ठ पर कूदना"},{"en":"Join two separate Word files into a zip archive","hi":"दो अलग-अलग वर्ड फ़ाइलों को ज़िप आर्काइव में जोड़ना"},{"en":"Open the Downloads folder in Word","hi":"वर्ड में डाउनलोड फ़ोल्डर खोलना"}],"exp":{"en":"In Microsoft Word, pressing Ctrl + J applies Justify alignment to a paragraph, spacing words so that both the left and right edges of the paragraph line up flush with the margins.","hi":"MS Word में 'Ctrl + J' शॉर्टकट का उपयोग पैराग्राफ को जस्टिफाई (Justify — बाएँ और दाएँ दोनों किनारों से बराबर संरेखित) करने के लिए किया जाता है।"},"num":158},{"id":"q159","q":{"en":"What is the function of the keyboard shortcut 'Ctrl + L' in Microsoft Word?","hi":"MS Word में कीबोर्ड शॉर्टकट 'Ctrl + L' का क्या काम है?"},"a":{"en":"Left-align the paragraph (align text flush with the left margin)","hi":"पैराग्राफ को बाएँ मार्जिन से संरेखित (Left align) करना"},"o":[{"en":"Left-align the paragraph (align text flush with the left margin)","hi":"पैराग्राफ को बाएँ मार्जिन से संरेखित (Left align) करना"},{"en":"Lock the computer screen and log out","hi":"कंप्यूटर स्क्रीन को लॉक करना और लॉग आउट करना"},{"en":"Launch a new laser print job immediately","hi":"तुरंत एक नया लेजर प्रिंट जॉब शुरू करना"},{"en":"Convert all selected letters to lowercase automatically","hi":"सभी चुने गए अक्षरों को स्वचालित रूप से लोअरकेस में बदलना"}],"exp":{"en":"In Microsoft Word, pressing Ctrl + L aligns the selected paragraph flush with the left margin (Left Alignment).","hi":"MS Word में 'Ctrl + L' शॉर्टकट का काम पैराग्राफ को बाईं ओर संरेखित (Left align) करना है।"},"num":159},{"id":"q160","q":{"en":"What is the function of the keyboard shortcut 'Ctrl + N' in Microsoft Word?","hi":"MS Word में कीबोर्ड शॉर्टकट 'Ctrl + N' का क्या काम है?"},"a":{"en":"Create and open a new blank document","hi":"एक नया खाली दस्तावेज़ (New blank document) बनाना और खोलना"},"o":[{"en":"Create and open a new blank document","hi":"एक नया खाली दस्तावेज़ (New blank document) बनाना और खोलना"},{"en":"Navigate to the next spelling error in the document","hi":"दस्तावेज़ में अगली वर्तनी त्रुटि पर जाना"},{"en":"Number all paragraphs with Roman numerals","hi":"सभी पैराग्राफों को रोमन अंकों से क्रमांकित करना"},{"en":"Turn off Num Lock on the keyboard","hi":"कीबोर्ड पर Num Lock को बंद करना"}],"exp":{"en":"In Microsoft Word (and most Windows applications), pressing Ctrl + N creates and opens a new blank document or window.","hi":"MS Word में 'Ctrl + N' शॉर्टकट का काम एक नया खाली डॉक्यूमेंट (New blank document) खोलना है।"},"num":160},{"id":"q161","q":{"en":"What is the function of the keyboard shortcut 'Ctrl + O'?","hi":"कीबोर्ड शॉर्टकट 'Ctrl + O' का क्या काम है?"},"a":{"en":"Open an existing document, file, or publication","hi":"किसी मौजूदा दस्तावेज़, फ़ाइल या प्रकाशन को खोलना (Open)"},"o":[{"en":"Open an existing document, file, or publication","hi":"किसी मौजूदा दस्तावेज़, फ़ाइल या प्रकाशन को खोलना (Open)"},{"en":"Optimize computer RAM performance","hi":"कंप्यूटर की RAM कार्यक्षमता को अनुकूलित करना"},{"en":"Only print the active webpage","hi":"केवल सक्रिय वेबपेज को प्रिंट करना"},{"en":"Overwrite the system kernel","hi":"सिस्टम कर्नेल को ओवरराइट करना"}],"exp":{"en":"Pressing Ctrl + O opens the Open dialog box in most applications to select and open an existing file or document.","hi":"'Ctrl + O' शॉर्टकट का उपयोग किसी मौजूदा फ़ाइल या दस्तावेज़ को खोलने (Open) के लिए किया जाता है।"},"num":161},{"id":"q162","q":{"en":"What is the function of the function key 'F12' in desktop applications like MS Word?","hi":"डेस्कटॉप एप्लिकेशन (जैसे MS Word) में फ़ंक्शन की 'F12' का क्या कार्य है?"},"a":{"en":"Open the Save As dialog box to save a document with a new name or format","hi":"दस्तावेज़ को नए नाम या फॉर्मेट में सहेजने के लिए 'Save As' संवाद बॉक्स खोलना"},"o":[{"en":"Open the Save As dialog box to save a document with a new name or format","hi":"दस्तावेज़ को नए नाम या फॉर्मेट में सहेजने के लिए 'Save As' संवाद बॉक्स खोलना"},{"en":"Close all open browser tabs","hi":"सभी खुले ब्राउज़र टैब बंद करना"},{"en":"Restart the operating system immediately","hi":"ऑपरेटिंग सिस्टम को तुरंत पुनरारंभ करना"},{"en":"Open the system sound mixer","hi":"सिस्टम साउंड मिक्सर खोलना"}],"exp":{"en":"In desktop word processors and office applications, pressing F12 opens the 'Save As' dialog box, allowing the user to save the active file under a new name or location.","hi":"MS Word जैसे डेस्कटॉप एप्लिकेशन्स में F12 दबाने से 'Save As' डायलॉग बॉक्स खुलता है, जिससे फ़ाइल को नए नाम या स्थान पर सहेजा जा सकता है।"},"num":162},{"id":"q163","q":{"en":"What is the function of the keyboard shortcut 'Ctrl + R' in Microsoft Word?","hi":"MS Word में कीबोर्ड शॉर्टकट 'Ctrl + R' का क्या काम है?"},"a":{"en":"Right-align the paragraph (align text flush with the right margin)","hi":"पैराग्राफ को दाएँ मार्जिन से संरेखित (Right align) करना"},"o":[{"en":"Right-align the paragraph (align text flush with the right margin)","hi":"पैराग्राफ को दाएँ मार्जिन से संरेखित (Right align) करना"},{"en":"Restart the computer system","hi":"कंप्यूटर सिस्टम को रीस्टार्ट करना"},{"en":"Replace text using the find and replace utility","hi":"फाइंड और रिप्लेस यूटिलिटी का उपयोग करके टेक्स्ट बदलना"},{"en":"Rotate the monitor display orientation","hi":"मॉनिटर डिस्प्ले ओरिएंटेशन को घुमाना"}],"exp":{"en":"In Microsoft Word, pressing Ctrl + R right-aligns the selected paragraph, aligning text flush with the right margin.","hi":"MS Word में 'Ctrl + R' शॉर्टकट का काम पैराग्राफ को दाईं ओर संरेखित (Right align) करना है।"},"num":163},{"id":"q164","q":{"en":"What is the function of the keyboard shortcut 'Alt + Tab'?","hi":"कीबोर्ड शॉर्टकट 'Alt + Tab' का क्या काम है?"},"a":{"en":"Switch between currently open applications and windows","hi":"वर्तमान में खुले एप्लिकेशन्स और विंडोज के बीच स्विच (Switch) करना"},"o":[{"en":"Switch between currently open applications and windows","hi":"वर्तमान में खुले एप्लिकेशन्स और विंडोज के बीच स्विच (Switch) करना"},{"en":"Insert a tab stop in a Word table","hi":"वर्ड टेबल में टैब स्टॉप डालना"},{"en":"Turn on the computer's built-in microphone","hi":"कंप्यूटर का बिल्ट-इन माइक्रोफोन चालू करना"},{"en":"Permanently delete the selected file without moving it to Recycle Bin","hi":"बिना रीसायकल बिन में भेजे फ़ाइल को स्थायी रूप से हटाना"}],"exp":{"en":"In the Windows operating system, pressing Alt + Tab brings up the task switcher window and allows the user to quickly cycle through open applications and windows.","hi":"'Alt + Tab' शॉर्टकट का उपयोग विंडोज़ में खुले हुए एप्लिकेशन्स और विंडोज के बीच आपस में स्विच (switch) करने के लिए किया जाता है।"},"num":164},{"id":"q165","q":{"en":"What is the function of the keyboard shortcut 'Ctrl + Y'?","hi":"कीबोर्ड शॉर्टकट 'Ctrl + Y' का क्या काम है?"},"a":{"en":"Redo an action or repeat the last supported operation","hi":"किसी क्रिया को दोबारा करना (Redo) या पिछले समर्थित ऑपरेशन को दोहराना"},"o":[{"en":"Redo an action or repeat the last supported operation","hi":"किसी क्रिया को दोबारा करना (Redo) या पिछले समर्थित ऑपरेशन को दोहराना"},{"en":"Yield network bandwidth to other connected client PCs","hi":"अन्य कनेक्टेड क्लाइंट पीसी को नेटवर्क बैंडविड्थ देना"},{"en":"Yellow highlight selected text in a browser","hi":"ब्राउज़र में चुने गए टेक्स्ट को पीला हाइलाइट करना"},{"en":"Zoom in on a document page","hi":"दस्तावेज़ पृष्ठ को ज़ूम इन करना"}],"exp":{"en":"In most editors, pressing Ctrl + Y performs a 'Redo' action, repeating or re-applying the previous command that was undone.","hi":"'Ctrl + Y' शॉर्टकट का उपयोग 'Redo' करने या पिछली क्रिया को दोबारा दोहराने (repeat) के लिए किया जाता है।"},"num":165},{"id":"q166","q":{"en":"What is the function of the keyboard shortcut 'Ctrl + Z'?","hi":"कीबोर्ड शॉर्टकट 'Ctrl + Z' का क्या काम है?"},"a":{"en":"Undo the last action or command","hi":"अंतिम क्रिया या कमांड को पूर्ववत करना (Undo)"},"o":[{"en":"Undo the last action or command","hi":"अंतिम क्रिया या कमांड को पूर्ववत करना (Undo)"},{"en":"Zoom out to 100% document view","hi":"दस्तावेज़ दृश्य को 100% ज़ूम आउट करना"},{"en":"Zip all selected files into a compressed archive","hi":"सभी चयनित फ़ाइलों को संपीड़ित आर्काइव में ज़िप करना"},{"en":"Close the active browser tab","hi":"सक्रिय ब्राउज़र टैब बंद करना"}],"exp":{"en":"Pressing Ctrl + Z triggers the 'Undo' command, reversing the most recent editing action or command in supported applications.","hi":"'Ctrl + Z' शॉर्टकट का उपयोग अंतिम क्रिया को पूर्ववत करने (Undo — पीछे ले जाने) के लिए किया जाता है।"},"num":166},{"id":"q167","q":{"en":"What is the function of the keyboard shortcut 'Ctrl + W'?","hi":"कीबोर्ड शॉर्टकट 'Ctrl + W' का क्या काम है?"},"a":{"en":"Close the current active document, window, or browser tab (application-dependent)","hi":"वर्तमान सक्रिय दस्तावेज़, विंडो या ब्राउज़र टैब को बंद करना"},"o":[{"en":"Close the current active document, window, or browser tab (application-dependent)","hi":"वर्तमान सक्रिय दस्तावेज़, विंडो या ब्राउज़र टैब को बंद करना"},{"en":"Open Microsoft Word in web layout view","hi":"माइक्रोसॉफ्ट वर्ड को वेब लेआउट दृश्य में खोलना"},{"en":"Connect to a Wi-Fi wireless network","hi":"वाई-फाई वायरलेस नेटवर्क से कनेक्ट करना"},{"en":"Write the file contents to a floppy disk","hi":"फ़ाइल सामग्री को फ्लॉपी डिस्क पर लिखना"}],"exp":{"en":"In many applications (like browsers and office tools), pressing Ctrl + W closes the current active tab or document window.","hi":"'Ctrl + W' शॉर्टकट का उपयोग एप्लिकेशन के आधार पर वर्तमान सक्रिय दस्तावेज़, विंडो या ब्राउज़र टैब को बंद (close) करने के लिए किया जाता है।"},"num":167},{"id":"q168","q":{"en":"What is the function of the keyboard shortcut 'Ctrl + X'?","hi":"कीबोर्ड शॉर्टकट 'Ctrl + X' का क्या काम है?"},"a":{"en":"Cut the selected text, file, or object and place it on the system clipboard","hi":"चुने गए टेक्स्ट, फ़ाइल या ऑब्जेक्ट को कट (Cut) करके क्लिपबोर्ड पर रखना"},"o":[{"en":"Cut the selected text, file, or object and place it on the system clipboard","hi":"चुने गए टेक्स्ट, फ़ाइल या ऑब्जेक्ट को कट (Cut) करके क्लिपबोर्ड पर रखना"},{"en":"Close the entire operating system","hi":"संपूर्ण ऑपरेटिंग सिस्टम बंद करना"},{"en":"Cross out selected text with a strikethrough line","hi":"चुने गए टेक्स्ट पर स्ट्राइकथ्रू लाइन खींचना"},{"en":"Execute an external XML script","hi":"बाहरी XML स्क्रिप्ट निष्पादित करना"}],"exp":{"en":"Pressing Ctrl + X cuts the highlighted selection (removing it from its original location) and stores it temporarily on the system clipboard for pasting elsewhere.","hi":"'Ctrl + X' शॉर्टकट का उपयोग चुने गए टेक्स्ट या आइटम को कट (Cut) करके क्लिपबोर्ड पर ले जाने के लिए किया जाता है।"},"num":168},{"id":"q169","q":{"en":"What is the function of the keyboard shortcut 'Ctrl + V'?","hi":"कीबोर्ड शॉर्टकट 'Ctrl + V' का क्या काम है?"},"a":{"en":"Paste the contents of the system clipboard into the current cursor location","hi":"सिस्टम क्लिपबोर्ड की सामग्री को वर्तमान कर्सर स्थान पर पेस्ट (Paste) करना"},"o":[{"en":"Paste the contents of the system clipboard into the current cursor location","hi":"सिस्टम क्लिपबोर्ड की सामग्री को वर्तमान कर्सर स्थान पर पेस्ट (Paste) करना"},{"en":"Verify digital signatures on a Word document","hi":"वर्ड दस्तावेज़ पर डिजिटल हस्ताक्षर सत्यापित करना"},{"en":"View system properties and RAM capacity","hi":"सिस्टम गुण और RAM क्षमता देखना"},{"en":"Print a vertical banner using a plotter","hi":"प्लॉटर का उपयोग करके लंबवत बैनर प्रिंट करना"}],"exp":{"en":"Pressing Ctrl + V pastes whatever content is currently stored on the system clipboard into the active document or text field at the cursor position.","hi":"'Ctrl + V' शॉर्टकट का उपयोग क्लिपबोर्ड पर रखे गए कंटेंट को वर्तमान कर्सर स्थान पर पेस्ट (Paste) करने के लिए किया जाता है।"},"num":169},{"id":"q170","q":{"en":"What is the function of the keyboard shortcut 'Ctrl + S'?","hi":"कीबोर्ड शॉर्टकट 'Ctrl + S' का क्या काम है?"},"a":{"en":"Save the current active file or document","hi":"वर्तमान सक्रिय फ़ाइल या दस्तावेज़ को सहेजना (Save)"},"o":[{"en":"Save the current active file or document","hi":"वर्तमान सक्रिय फ़ाइल या दस्तावेज़ को सहेजना (Save)"},{"en":"Search for text within a webpage","hi":"वेबपेज के भीतर टेक्स्ट खोजना"},{"en":"Start a slide show presentation in PowerPoint","hi":"पावरपॉइंट में स्लाइड शो प्रस्तुत करना"},{"en":"Shut down the computer tower","hi":"कंप्यूटर टॉवर को शट डाउन करना"}],"exp":{"en":"Pressing Ctrl + S saves the current open file or document, writing changes back to storage.","hi":"'Ctrl + S' शॉर्टकट का उपयोग वर्तमान सक्रिय फ़ाइल या दस्तावेज़ को सहेजने (Save) के लिए किया जाता है।"},"num":170},{"id":"q171","q":{"en":"What is the function of the function key 'F7' in Microsoft Word?","hi":"MS Word में फ़ंक्शन की 'F7' का क्या कार्य है?"},"a":{"en":"Run a Spelling and Grammar check on the document","hi":"दस्तावेज़ पर स्पेलिंग और ग्रामर चेक (Spelling & Grammar check) चलाना"},"o":[{"en":"Run a Spelling and Grammar check on the document","hi":"दस्तावेज़ पर स्पेलिंग और ग्रामर चेक (Spelling & Grammar check) चलाना"},{"en":"Open the File Explorer navigation pane","hi":"फ़ाइल एक्सप्लोरर नेविगेशन पेन खोलना"},{"en":"Create a new folder on the desktop","hi":"डेस्कटॉप पर एक नया फ़ोल्डर बनाना"},{"en":"Turn on full-screen reading mode","hi":"फुल-स्क्रीन रीडिंग मोड चालू करना"}],"exp":{"en":"In Microsoft Word and many other productivity tools, pressing F7 opens the Spelling and Grammar check tool to inspect the document for errors.","hi":"MS Word में F7 दबाने से दस्तावेज़ की वर्तनी और व्याकरण की जाँच (Spelling and Grammar check) करने वाला टूल खुलता है।"},"num":171},{"id":"q172","q":{"en":"What is the function of the function key 'F2' in File Explorer and other desktop apps?","hi":"फ़ाइल एक्सप्लोरर और अन्य डेस्कटॉप ऐप्स में फ़ंक्शन की 'F2' का क्या कार्य है?"},"a":{"en":"Rename the selected file, folder, or item","hi":"चुने गए फ़ाइल, फ़ोल्डर या आइटम का नाम बदलना (Rename)"},"o":[{"en":"Rename the selected file, folder, or item","hi":"चुने गए फ़ाइल, फ़ोल्डर या आइटम का नाम बदलना (Rename)"},{"en":"Refresh the web browser page","hi":"वेब ब्राउज़र पेज को रिफ्रेश करना"},{"en":"Open the system help and support menu","hi":"सिस्टम हेल्प और सपोर्ट मेनू खोलना"},{"en":"Mute computer audio output","hi":"कंप्यूटर ऑडियो आउटपुट म्यूट करना"}],"exp":{"en":"In Windows File Explorer, pressing F2 instantly selects the name of the currently highlighted file or folder so the user can rename it.","hi":"विंडोज़ फ़ाइल एक्सप्लोरर में F2 दबाने से चुने गए फ़ाइल या फ़ोल्डर का नाम बदलने (Rename) का विकल्प एक्टिव हो जाता है।"},"num":172},{"id":"q173","q":{"en":"What is the function of the keyboard shortcut 'Ctrl + Home'?","hi":"कीबोर्ड शॉर्टकट 'Ctrl + Home' का क्या काम है?"},"a":{"en":"Move the cursor to the very beginning of the document or file","hi":"कर्सर को दस्तावेज़ या फ़ाइल की शुरुआत (Beginning) में ले जाना"},"o":[{"en":"Move the cursor to the very beginning of the document or file","hi":"कर्सर को दस्तावेज़ या फ़ाइल की शुरुआत (Beginning) में ले जाना"},{"en":"Open the Windows home settings panel","hi":"विंडोज़ होम सेटिंग्स पैनल खोलना"},{"en":"Save and close all background apps","hi":"सभी बैकअप ऐप्स को सहेजना और बंद करना"},{"en":"Select the entire hard disk drive","hi":"संपूर्ण हार्ड डिस्क ड्राइव को सेलेक्ट करना"}],"exp":{"en":"Pressing Ctrl + Home moves the text cursor directly to the top/beginning of the entire document or text window.","hi":"'Ctrl + Home' शॉर्टकट का उपयोग कर्सर को सीधे दस्तावेज़ या फ़ाइल की शुरुआत (beginning) में पहुँचाने के लिए किया जाता है।"},"num":173},{"id":"q174","q":{"en":"What is the function of the keyboard shortcut 'Ctrl + End'?","hi":"कीबोर्ड शॉर्टकट 'Ctrl + End' का क्या काम है?"},"a":{"en":"Move the cursor to the very end of the document or file","hi":"कर्सर को दस्तावेज़ या फ़ाइल के अंत (End) में ले जाना"},"o":[{"en":"Move the cursor to the very end of the document or file","hi":"कर्सर को दस्तावेज़ या फ़ाइल के अंत (End) में ले जाना"},{"en":"Shut down the operating system immediately","hi":"ऑपरेटिंग सिस्टम को तुरंत शट डाउन करना"},{"en":"End the current slideshow presentation","hi":"वर्तमान स्लाइड शो प्रस्तुति समाप्त करना"},{"en":"Delete all temporary files from the Recycle Bin","hi":"रीसायकल बिन से सभी अस्थायी फ़ाइलें हटाना"}],"exp":{"en":"Pressing Ctrl + End moves the text cursor directly to the bottom/end of the entire document or text window.","hi":"'Ctrl + End' शॉर्टकट का उपयोग कर्सर को सीधे दस्तावेज़ या फ़ाइल के अंत (end) में पहुँचाने के लिए किया जाता है।"},"num":174},{"id":"q175","q":{"en":"What is the function of the keyboard shortcut 'Alt + Shift + Tab'?","hi":"कीबोर्ड शॉर्टकट 'Alt + Shift + Tab' का क्या काम है?"},"a":{"en":"Cycle through open windows in reverse direction in the task switcher","hi":"टास्क स्विचर में खुली हुई विंडोज के बीच विपरीत दिशा (reverse direction) में चक्र चलाना"},"o":[{"en":"Cycle through open windows in reverse direction in the task switcher","hi":"टास्क स्विचर में खुली हुई विंडोज के बीच विपरीत दिशा (reverse direction) में चक्र चलाना"},{"en":"Switch keyboard language between English and Hindi in reverse","hi":"अंग्रेजी और हिन्दी के बीच कीबोर्ड भाषा को विपरीत क्रम में बदलना"},{"en":"Reboot the motherboard BIOS firmware","hi":"मदरबोर्ड BIOS फर्मवेयर को रीबूट करना"},{"en":"Reverse the print order of pages in a laser printer","hi":"लेजर प्रिंटर में पृष्ठों के प्रिंट क्रम को उलटना"}],"exp":{"en":"While Alt + Tab cycles forward through open windows in the Windows task switcher, pressing Alt + Shift + Tab cycles backward in reverse direction.","hi":"विंडोज़ टास्क स्विचर में 'Alt + Tab' आगे की ओर विंडो बदलता है, जबकि 'Alt + Shift + Tab' खुली हुई विंडोज के बीच विपरीत दिशा (reverse direction) में साइकल करता है।"},"num":175},{"id":"q176","q":{"en":"What is the function of the keyboard shortcut 'Alt + F4'?","hi":"कीबोर्ड शॉर्टकट 'Alt + F4' का क्या काम है?"},"a":{"en":"Close the active window or application; if the desktop is active, it opens the Shut Down Windows dialog","hi":"सक्रिय विंडो या एप्लिकेशन को बंद करना; यदि डेस्कटॉप सक्रिय है, तो यह शट डाउन डायलॉग खोलता है"},"o":[{"en":"Close the active window or application; if the desktop is active, it opens the Shut Down Windows dialog","hi":"सक्रिय विंडो या एप्लिकेशन को बंद करना; यदि डेस्कटॉप सक्रिय है, तो यह शट डाउन डायलॉग खोलता है"},{"en":"Open a new 4K video rendering project","hi":"एक नया 4K वीडियो रेंडरिंग प्रोजेक्ट खोलना"},{"en":"Mute the system microphone and speaker","hi":"सिस्टम माइक्रोफोन और स्पीकर म्यूट करना"},{"en":"Open the file properties dialog box","hi":"फ़ाइल गुण (properties) संवाद बॉक्स खोलना"}],"exp":{"en":"In Windows, pressing Alt + F4 closes the currently active program window. If no windows are active and the desktop is selected, pressing Alt + F4 brings up the Shut Down / Turn Off Computer dialog.","hi":"विंडोज़ में 'Alt + F4' शॉर्टकट सक्रिय विंडो या एप्लिकेशन को बंद (close) करता है। यदि डेस्कटॉप सक्रिय हो, तो यह शट डाउन डायलॉग खोलता है।"},"num":176},{"id":"q177","q":{"en":"What is the function of the keyboard shortcut 'Ctrl + U' in Microsoft Word?","hi":"MS Word में कीबोर्ड शॉर्टकट 'Ctrl + U' का क्या काम है?"},"a":{"en":"Toggle Underline formatting on or off for the selected text","hi":"चुने गए टेक्स्ट पर अंडरलाइन (Underline) फ़ॉर्मेटिंग ऑन/ऑफ करना"},"o":[{"en":"Toggle Underline formatting on or off for the selected text","hi":"चुने गए टेक्स्ट पर अंडरलाइन (Underline) फ़ॉर्मेटिंग ऑन/ऑफ करना"},{"en":"Upload the document to a cloud server","hi":"दस्तावेज़ को क्लाउड सर्वर पर अपलोड करना"},{"en":"Undo the last three formatting actions","hi":"अंतिम तीन फ़ॉर्मेटिंग क्रियाओं को पूर्ववत करना"},{"en":"Convert lowercase letters to uppercase","hi":"छोटे अक्षरों को बड़े अक्षरों में बदलना"}],"exp":{"en":"In Microsoft Word, pressing Ctrl + U toggles Underline formatting (adding a horizontal line beneath text) on or off for the selected text.","hi":"MS Word में 'Ctrl + U' शॉर्टकट का काम चुने गए टेक्स्ट के नीचे अंडरलाइन (Underline) फ़ॉर्मेटिंग को ऑन या ऑफ करना है।"},"num":177},{"id":"q178","q":{"en":"What is the function of the keyboard shortcut 'Ctrl + P'?","hi":"कीबोर्ड शॉर्टकट 'Ctrl + P' का क्या काम है?"},"a":{"en":"Open the Print dialog box or print preview view","hi":"प्रिंट संवाद बॉक्स या प्रिंट पूर्वावलोकन (Print view) खोलना"},"o":[{"en":"Open the Print dialog box or print preview view","hi":"प्रिंट संवाद बॉक्स या प्रिंट पूर्वावलोकन (Print view) खोलना"},{"en":"Create a new PDF file without formatting","hi":"बिना फ़ॉर्मेटिंग के एक नई PDF फ़ाइल बनाना"},{"en":"Paste an image from the clipboard","hi":"क्लिपबोर्ड से एक इमेज पेस्ट करना"},{"en":"Check paragraph spelling errors","hi":"पैराग्राफ वर्तनी की त्रुटियों की जाँच करना"}],"exp":{"en":"Pressing Ctrl + P opens the Print dialog box in most applications to print the active document or file.","hi":"'Ctrl + P' शॉर्टकट का उपयोग वर्तमान दस्तावेज़ को प्रिंट करने के लिए प्रिंट डायलॉग बॉक्स या प्रिंट प्रीव्यू (Print view) खोलने हेतु किया जाता है।"},"num":178},{"id":"q179","q":{"en":"What is the function of the keyboard shortcut 'Ctrl + K' in Microsoft Word?","hi":"MS Word में कीबोर्ड शॉर्टकट 'Ctrl + K' का क्या काम है?"},"a":{"en":"Insert a hyperlink into the document","hi":"दस्तावेज़ में एक हाइपरलिंक (Hyperlink) डालना"},"o":[{"en":"Insert a hyperlink into the document","hi":"दस्तावेज़ में एक हाइपरलिंक (Hyperlink) डालना"},{"en":"Lock the screen using a security key","hi":"सुरक्षा कुंजी का उपयोग करके स्क्रीन लॉक करना"},{"en":"Kill all active background processes","hi":"सभी सक्रिय बैकअप प्रक्रियाओं को समाप्त करना"},{"en":"Change text alignment to justified","hi":"टेक्स्ट संरेखण को जस्टिफाइड में बदलना"}],"exp":{"en":"In Microsoft Word, pressing Ctrl + K opens the Insert Hyperlink dialog box, allowing the user to link text to a URL, file, or email address.","hi":"MS Word में 'Ctrl + K' शॉर्टकट का उपयोग दस्तावेज़ में हाइपरलिंक (Hyperlink) डालने के लिए किया जाता है।"},"num":179}]},{"title":{"en":"13. Glossary","hi":"13. शब्दावली"},"questions":[{"id":"q180","q":{"en":"What is the full form of ENIAC?","hi":"ENIAC का पूर्ण रूप (Full Form) क्या है?"},"a":{"en":"Electronic Numerical Integrator and Computer","hi":"इलेक्ट्रॉनिक न्यूमेरिकल इंटीग्रेटर एंड कंप्यूटर"},"o":[{"en":"Electronic Numerical Integrator and Computer","hi":"इलेक्ट्रॉनिक न्यूमेरिकल इंटीग्रेटर एंड कंप्यूटर"},{"en":"Electrical Network for Integrated Arithmetic Calculations","hi":"इलेक्ट्रिकल नेटवर्क फॉर इंटीग्रेटेड अरिथमेटिक कैलकुलेशन्स"},{"en":"Enhanced National Industrial Automatic Calculator","hi":"एन्हांस्ड नेशनल इंडस्ट्रियल ऑटोमैटिक कैलकुलेटर"},{"en":"Encoded Number Indicator and Compiler","hi":"एनकोडेड नंबर इंडिकेटर एंड कंपाइलर"}],"exp":{"en":"ENIAC stands for Electronic Numerical Integrator and Computer, the pioneering 1945/1946 general-purpose electronic digital computer.","hi":"ENIAC का पूर्ण रूप Electronic Numerical Integrator and Computer है।"},"num":180},{"id":"q181","q":{"en":"What is the full form of EDVAC?","hi":"EDVAC का पूर्ण रूप (Full Form) क्या है?"},"a":{"en":"Electronic Discrete Variable Automatic Computer","hi":"इलेक्ट्रॉनिक डिस्क्रीट वेरिएबल ऑटोमैटिक कंप्यूटर"},"o":[{"en":"Electronic Discrete Variable Automatic Computer","hi":"इलेक्ट्रॉनिक डिस्क्रीट वेरिएबल ऑटोमैटिक कंप्यूटर"},{"en":"External Digital Video Arithmetic Calculator","hi":"एक्सटर्नल डिजिटल वीडियो अरिथमेटिक कैलकुलेटर"},{"en":"Electric Data Verification and Control","hi":"इलेक्ट्रिक डेटा वेरिफिकेशन एंड कंट्रोल"},{"en":"Extended Disk Array Volatile Controller","hi":"एक्सटेंडेड डिस्क ऐरे वोलेटाइल कंट्रोलर"}],"exp":{"en":"EDVAC stands for Electronic Discrete Variable Automatic Computer, one of the earliest stored-program electronic computers.","hi":"EDVAC का पूर्ण रूप Electronic Discrete Variable Automatic Computer है।"},"num":181},{"id":"q182","q":{"en":"What is the full form of EDSAC (noting that PDFs write 'Computer' while Cambridge archive uses 'Calculator')?","hi":"EDSAC का पूर्ण रूप क्या है (ध्यान दें कि नोट्स में 'Computer' लिखा है जबकि कैम्ब्रिज आर्काइव 'Calculator' उपयोग करता है)?"},"a":{"en":"Electronic Delay Storage Automatic Calculator (PDF notes write 'Computer', Cambridge archive uses 'Calculator')","hi":"इलेक्ट्रॉनिक डिले स्टोरेज ऑटोमैटिक कैलकुलेटर (नोट्स में 'Computer' लिखा है, जबकि कैम्ब्रिज आर्काइव 'Calculator' उपयोग करता है)"},"o":[{"en":"Electronic Delay Storage Automatic Calculator (PDF notes write 'Computer', Cambridge archive uses 'Calculator')","hi":"इलेक्ट्रॉनिक डिले स्टोरेज ऑटोमैटिक कैलकुलेटर (नोट्स में 'Computer' लिखा है, जबकि कैम्ब्रिज आर्काइव 'Calculator' उपयोग करता है)"},{"en":"Ethernet Digital Storage And Cache","hi":"ईथरनेट डिजिटल स्टोरेज एंड कैश"},{"en":"Emergency Data System And Compiler","hi":"इमरजेंसी डेटा सिस्टम एंड कंपाइलर"},{"en":"Enhanced Dual-Core System Architecture","hi":"एन्हांस्ड डुअल-कोर सिस्टम आर्किटेक्चर"}],"exp":{"en":"EDSAC stands for Electronic Delay Storage Automatic Calculator (though the chapter PDF notes write 'Computer', the official Cambridge computing history archive uses 'Calculator').","hi":"EDSAC का पूर्ण रूप Electronic Delay Storage Automatic Calculator है (हालाँकि अध्याय नोट्स में इसे 'Computer' लिखा गया है, जबकि कैम्ब्रिज इतिहास आर्काइव इसे 'Calculator' लिखता है)।"},"num":182},{"id":"q183","q":{"en":"What is the full form of UNIVAC?","hi":"UNIVAC का पूर्ण रूप (Full Form) क्या है?"},"a":{"en":"Universal Automatic Computer","hi":"यूनिवर्सल ऑटोमैटिक कंप्यूटर"},"o":[{"en":"Universal Automatic Computer","hi":"यूनिवर्सल ऑटोमैटिक कंप्यूटर"},{"en":"United Network for Integrated Arithmetic Calculation","hi":"यूनाइटेड नेटवर्क फॉर इंटीग्रेटेड अरिथमेटिक कैलकुलेशन"},{"en":"Ultra-Fast Numerical Analogue Calculator","hi":"अल्ट्रा-फास्ट न्यूमेरिकल एनालॉग कैलकुलेटर"},{"en":"Unified Video Array Controller","hi":"यूनिफाइड वीडियो ऐरे कंट्रोलर"}],"exp":{"en":"UNIVAC stands for Universal Automatic Computer, America's first commercial electronic digital computer series.","hi":"UNIVAC का पूर्ण रूप Universal Automatic Computer है।"},"num":183}]},{"title":{"en":"14. Exam Trap Reverse-Questions","hi":"14. परीक्षा के महत्वपूर्ण उल्टे प्रश्न"},"questions":[{"id":"q184","q":{"en":"Which register holds the memory address of the next instruction to be fetched, and which register holds the current instruction?","hi":"अगले निष्पादित होने वाले निर्देश का पता (address) कौन-सा रजिस्टर रखता है, और वर्तमान निर्देश (current instruction) कौन-सा रजिस्टर रखता है?"},"a":{"en":"Program Counter (PC) holds the next instruction address, while Instruction Register (IR) holds the current instruction","hi":"प्रोग्राम काउंटर (PC) अगले निर्देश का एड्रेस रखता है, जबकि इंस्ट्रक्शन रजिस्टर (IR) वर्तमान निर्देश रखता है"},"o":[{"en":"Program Counter (PC) holds the next instruction address, while Instruction Register (IR) holds the current instruction","hi":"प्रोग्राम काउंटर (PC) अगले निर्देश का एड्रेस रखता है, जबकि इंस्ट्रक्शन रजिस्टर (IR) वर्तमान निर्देश रखता है"},{"en":"MAR holds the next instruction and MBR holds the instruction register","hi":"MAR अगला निर्देश रखता है और MBR इंस्ट्रक्शन रजिस्टर रखता है"},{"en":"Accumulator holds the next instruction and ALU holds the current instruction","hi":"एक्युमलेटर अगला निर्देश रखता है और ALU वर्तमान निर्देश रखता है"},{"en":"ROM holds the next instruction and RAM holds the current instruction","hi":"ROM अगला निर्देश रखता है और RAM वर्तमान निर्देश रखता है"}],"exp":{"en":"Trap Question: Program Counter (PC) stores the address of the next instruction, whereas the Instruction Register (IR) stores the actual instruction currently being decoded/executed.","hi":"एग्जाम ट्रैप प्रश्न: Program Counter (PC) अगले निर्देश का एड्रेस रखता है, जबकि Instruction Register (IR) वर्तमान निर्देश (current instruction) को होल्ड करता है।"},"num":184},{"id":"q185","q":{"en":"Between MAR and MBR (MDR), which register holds the memory location address and which holds the actual transferable data/word?","hi":"MAR और MBR (MDR) में से कौन-सा रजिस्टर मेमोरी लोकेशन का एड्रेस (पता) रखता है और कौन-सा वास्तविक डेटा/वर्ड रखता है?"},"a":{"en":"MAR holds the memory address (where to go), whereas MBR/MDR holds the actual transferable data/word (what is being transferred)","hi":"MAR मेमोरी एड्रेस रखता है (कहाँ जाना है), जबकि MBR/MDR वास्तविक डेटा/वर्ड होल्ड करता है (क्या ट्रांसफर हो रहा है)"},"o":[{"en":"MAR holds the memory address (where to go), whereas MBR/MDR holds the actual transferable data/word (what is being transferred)","hi":"MAR मेमोरी एड्रेस रखता है (कहाँ जाना है), जबकि MBR/MDR वास्तविक डेटा/वर्ड होल्ड करता है (क्या ट्रांसफर हो रहा है)"},{"en":"MBR holds the address and MAR holds the data","hi":"MBR एड्रेस रखता है और MAR डेटा रखता है"},{"en":"Both hold only floating-point arithmetic flags","hi":"दोनों केवल फ्लोटिंग-पॉइंट अरिथमेटिक फ्लैग रखते हैं"},{"en":"Both hold only video graphics pixels","hi":"दोनों केवल वीडियो ग्राफिक्स पिक्सेल रखते हैं"}],"exp":{"en":"Trap Question: MAR (Memory Address Register) specifies the target memory location address ('where to go'), while MBR/MDR (Memory Buffer/Data Register) holds the actual data or word being read or written ('what is being transferred').","hi":"एग्जाम ट्रैप प्रश्न: MAR मेमोरी लोकेशन का एड्रेस (कहाँ जाना है) रखता है, और MBR/MDR वास्तविक ट्रांसफर होने वाले डेटा (क्या ट्रांसफर हो रहा है) को होल्ड करता है।"},"num":185},{"id":"q186","q":{"en":"Which hardware mechanism allows I/O data to transfer directly between an I/O device and memory without the CPU handling every single byte?","hi":"कौन-सी हार्डवेयर तकनीक CPU द्वारा हर बाइट को संभाले बिना I/O डिवाइस और मेमोरी के बीच सीधे डेटा ट्रांसफर की अनुमति देती है?"},"a":{"en":"Direct Memory Access (DMA)","hi":"डायरेक्ट मेमोरी एक्सेस (DMA)"},"o":[{"en":"Direct Memory Access (DMA)","hi":"डायरेक्ट मेमोरी एक्सेस (DMA)"},{"en":"Programmed I/O polling loop","hi":"प्रोग्राम्ड I/O पोलिंग लूप"},{"en":"Arithmetic and Logic Unit ALU","hi":"अरिथमेटिक एंड लॉजिक यूनिट (ALU)"},{"en":"Instruction Cycle Fetch","hi":"इंस्ट्रक्शन साइकिल फेच"}],"exp":{"en":"Trap Question: Direct Memory Access (DMA) enables high-speed data transfer directly between an I/O device and main memory via a DMA controller, freeing the CPU from handling every single byte.","hi":"एग्जाम ट्रैप प्रश्न: Direct Memory Access (DMA) के माध्यम से DMA कंट्रोलर CPU को शामिल किए बिना डिवाइस और मेमोरी के बीच सीधे ब्लॉक डेटा ट्रांसफर करता है।"},"num":186},{"id":"q187","q":{"en":"Which specialized input readers are used respectively for bubble test sheets, bank cheques, and retail barcodes?","hi":"बबल टेस्ट शीट, बैंक चेक और खुदरा बारकोड के लिए क्रमशः कौन-से विशेष इनपुट रीडर उपयोग होते हैं?"},"a":{"en":"Bubble sheet → OMR, bank cheque → MICR, retail barcode → BCR (Bar Code Reader)","hi":"बबल शीट → OMR, बैंक चेक → MICR, खुदरा बारकोड → BCR (बार कोड रीडर)"},"o":[{"en":"Bubble sheet → OMR, bank cheque → MICR, retail barcode → BCR (Bar Code Reader)","hi":"बबल शीट → OMR, बैंक चेक → MICR, खुदरा बारकोड → BCR (बार कोड रीडर)"},{"en":"Bubble sheet → MICR, bank cheque → OMR, retail barcode → OCR","hi":"बबल शीट → MICR, बैंक चेक → OMR, खुदरा बारकोड → OCR"},{"en":"Bubble sheet → Laser printer, bank cheque → Plotter, retail barcode → Scanner","hi":"बबल शीट → लेजर प्रिंटर, बैंक चेक → प्लॉटर, खुदरा बारकोड → स्कैनर"},{"en":"Bubble sheet → Keyboard, bank cheque → Mouse, retail barcode → Joystick","hi":"बबल शीट → कीबोर्ड, बैंक चेक → माउस, खुदरा बारकोड → जॉयस्टिक"}],"exp":{"en":"Trap Question: OMR reads shaded bubbles on exam test sheets; MICR reads magnetic ink characters on bank cheques; BCR reads printed parallel retail barcodes.","hi":"एग्जाम ट्रैप प्रश्न: बबल शीट के लिए OMR, बैंक चेक के लिए MICR, और रिटेल बारकोड के लिए BCR (Bar Code Reader) का उपयोग होता है।"},"num":187},{"id":"q188","q":{"en":"Which pointing device features a stationary base while the user rotates an exposed ball to move the pointer?","hi":"कौन-सा पॉइंटिंग डिवाइस स्थिर बेस पर रहता है जबकि यूज़र पॉइंटर घुमाने के लिए खुली बॉल को घुमाता है?"},"a":{"en":"Trackball","hi":"ट्रैकबॉल (Trackball)"},"o":[{"en":"Trackball","hi":"ट्रैकबॉल (Trackball)"},{"en":"Mechanical rolling mouse","hi":"मैकेनिकल रोलिंग माउस"},{"en":"Flatbed document scanner","hi":"फ्लैटबेड दस्तावेज़ स्कैनर"},{"en":"Dot matrix printhead","hi":"डॉट मैट्रिक्स प्रिंटहेड"}],"exp":{"en":"Trap Question: Unlike a mouse which is dragged across a desk, a Trackball has a stationary base where the user rolls an exposed ball with their fingers/thumb.","hi":"एग्जाम ट्रैप प्रश्न: ट्रैकबॉल में बेस स्थिर रहता है और यूज़र ऊपर दिखने वाली बॉल (exposed ball) को घुमाकर स्क्रीन पॉइंटर को मूव करता है।"},"num":188},{"id":"q189","q":{"en":"Which impact printer forms characters using tiny mechanical pins striking an inked ribbon?","hi":"कौन-सा इम्पैक्ट प्रिंटर स्याही लगे रिबन पर छोटी यांत्रिक पिनों से प्रहार करके अक्षर बनाता है?"},"a":{"en":"Dot Matrix Printer (a classic impact character printer)","hi":"डॉट मैट्रिक्स प्रिंटर (एक क्लासिक इम्पैक्ट कैरेक्टर प्रिंटर)"},"o":[{"en":"Dot Matrix Printer (a classic impact character printer)","hi":"डॉट मैट्रिक्स प्रिंटर (एक क्लासिक इम्पैक्ट कैरेक्टर प्रिंटर)"},{"en":"Thermal receipt printer","hi":"थर्मल रसीद प्रिंटर"},{"en":"Electrostatic laser printer","hi":"इलेक्ट्रोस्टैटिक लेजर प्रिंटर"},{"en":"Liquid ink nozzle inkjet printer","hi":"तरल स्याही नोजल इंकजेट प्रिंटर"}],"exp":{"en":"Trap Question: Dot Matrix is a mechanical impact printer that uses printhead pins striking a ribbon, unlike non-impact inkjet and laser printers.","hi":"एग्जाम ट्रैप प्रश्न: डॉट मैट्रिक्स प्रिंटर एक इम्पैक्ट प्रिंटर है जो पिनों और रिबन के प्रहार से डॉट पैटर्न बनाता है।"},"num":189},{"id":"q190","q":{"en":"Which three printer types use heat, liquid droplets, and toner powder respectively?","hi":"क्रमशः ऊष्मा (heat), तरल बूँदें (liquid droplets) और टोनर पाउडर (toner powder) का उपयोग करने वाले तीन प्रिंटर कौन-से हैं?"},"a":{"en":"Thermal uses heat, Inkjet uses liquid ink droplets, and Laser uses dry toner powder","hi":"थर्मल (ऊष्मा), इंकजेट (तरल बूँदें) और लेजर (टोनर पाउडर)"},"o":[{"en":"Thermal uses heat, Inkjet uses liquid ink droplets, and Laser uses dry toner powder","hi":"थर्मल (ऊष्मा), इंकजेट (तरल बूँदें) और लेजर (टोनर पाउडर)"},{"en":"Laser uses heat, Thermal uses toner, and Inkjet uses mechanical pins","hi":"लेजर ऊष्मा, थर्मल टोनर, इंकजेट पिन"},{"en":"Dot matrix uses heat, Laser uses liquid ink, and Thermal uses pins","hi":"डॉट मैट्रिक्स ऊष्मा, लेजर तरल स्याही, थर्मल पिन"},{"en":"All three printers use exact identical liquid ink","hi":"तीनों प्रिंटर बिल्कुल एक जैसी तरल स्याही उपयोग करते हैं"}],"exp":{"en":"Trap Question: Thermal printers use heat on heat-sensitive paper; Inkjet printers spray microscopic liquid ink droplets; Laser printers use dry toner powder fused by heat.","hi":"एग्जाम ट्रैप प्रश्न: थर्मल प्रिंटर ऊष्मा (heat) का उपयोग करता है, इंकजेट तरल स्याही की बूँदें (liquid droplets) स्प्रे करता है, और लेजर प्रिंटर सूखे टोनर पाउडर (toner powder) का उपयोग करता है।"},"num":190},{"id":"q191","q":{"en":"Which ROM type is erased using ultraviolet (UV) light, and which one is erased electrically?","hi":"कौन-सा ROM प्रकार पराबैंगनी (UV) प्रकाश से मिटाया जाता है और कौन-सा विद्युत संकेतों (electrically) से?"},"a":{"en":"EPROM is erased using UV light, whereas EEPROM is erased electrically","hi":"EPROM UV लाइट से मिटता है, जबकि EEPROM इलेक्ट्रिकली मिटता है"},"o":[{"en":"EPROM is erased using UV light, whereas EEPROM is erased electrically","hi":"EPROM UV लाइट से मिटता है, जबकि EEPROM इलेक्ट्रिकली मिटता है"},{"en":"EEPROM is erased using UV light, whereas EPROM is erased electrically","hi":"EEPROM UV लाइट से और EPROM इलेक्ट्रिकली मिटता है"},{"en":"Both are erased only by immersion in water","hi":"दोनों केवल पानी में डुबोकर मिटाए जाते हैं"},{"en":"Neither can ever be erased","hi":"दोनों में से कोई कभी नहीं मिटाया जा सकता"}],"exp":{"en":"Trap Question: EPROM (Erasable PROM) requires a quartz window and ultraviolet (UV) light to clear its memory, whereas EEPROM (Electrically Erasable PROM) can be erased and reprogrammed using electrical voltage pulses.","hi":"एग्जाम ट्रैप प्रश्न: EPROM पराबैंगनी प्रकाश (UV light) से मिटाया जाता है, जबकि EEPROM विद्युत संकेतों (electrically) द्वारा मिटाया जाता है।"},"num":191},{"id":"q192","q":{"en":"How many bits are in a Nibble and in a Byte respectively?","hi":"एक निबल (Nibble) और एक बाइट (Byte) में क्रमशः कितने बिट्स होते हैं?"},"a":{"en":"A Nibble has 4 bits and a Byte has 8 bits","hi":"एक निबल में 4 बिट्स और एक बाइट में 8 बिट्स होते हैं"},"o":[{"en":"A Nibble has 4 bits and a Byte has 8 bits","hi":"एक निबल में 4 बिट्स और एक बाइट में 8 बिट्स होते हैं"},{"en":"A Nibble has 8 bits and a Byte has 16 bits","hi":"एक निबल में 8 बिट्स और एक बाइट में 16 बिट्स"},{"en":"A Nibble has 2 bits and a Byte has 4 bits","hi":"एक निबल में 2 बिट्स और एक बाइट में 4 बिट्स"},{"en":"A Nibble has 16 bits and a Byte has 64 bits","hi":"एक निबल में 16 बिट्स और एक बाइट में 64 बिट्स"}],"exp":{"en":"Trap Question: A Nibble is exactly 4 bits (half a byte), and a Byte is 8 bits (two nibbles).","hi":"एग्जाम ट्रैप प्रश्न: एक निबल में 4 बिट्स और एक बाइट में 8 बिट्स होते हैं।"},"num":192},{"id":"q193","q":{"en":"When you see '12 Mbps' in USB specifications, which USB signaling speed mode does it refer to?","hi":"USB विनिर्देशों में '12 Mbps' देखने पर यह किस USB सिग्नलिंग स्पीड मोड को दर्शाता है?"},"a":{"en":"USB Full-Speed mode (introduced in USB 1.1)","hi":"USB Full-Speed मोड (जो USB 1.1 में आया था)"},"o":[{"en":"USB Full-Speed mode (introduced in USB 1.1)","hi":"USB Full-Speed मोड (जो USB 1.1 में आया था)"},{"en":"USB High-Speed mode","hi":"USB हाई-स्पीड मोड"},{"en":"USB SuperSpeed 20G mode","hi":"USB सुपरस्पीड 20G मोड"},{"en":"Dial-up modem serial UART speed","hi":"डायल-अप मॉडेम सीरियल UART स्पीड"}],"exp":{"en":"Trap Question: In USB terminology, 'Full-Speed' specifically denotes the 12 Mbps signaling rate (whereas Low-Speed is 1.5 Mbps, High-Speed is 480 Mbps, and SuperSpeed is 5 Gbps+).","hi":"एग्जाम ट्रैप प्रश्न: USB शब्दावली में 'Full-Speed' विशेष रूप से 12 Mbps की सिग्नलिंग दर को दर्शाता है।"},"num":193},{"id":"q194","q":{"en":"Does a 25-pin connector always indicate a Parallel Port?","hi":"क्या 25-पिन कनेक्टर हमेशा पैरेलल पोर्ट (Parallel Port) को ही दर्शाता है?"},"a":{"en":"No — legacy serial ports (like DB-25) also used 25-pin connectors, so pin count alone is not enough; transmission method and device use must be checked","hi":"नहीं — पुराने सीरियल पोर्ट (जैसे DB-25) भी 25-पिन कनेक्टर उपयोग करते थे; ट्रांसमिशन विधि और उपयोग से पहचान करनी चाहिए"},"o":[{"en":"No — legacy serial ports (like DB-25) also used 25-pin connectors, so pin count alone is not enough; transmission method and device use must be checked","hi":"नहीं — पुराने सीरियल पोर्ट (जैसे DB-25) भी 25-पिन कनेक्टर उपयोग करते थे; ट्रांसमिशन विधि और उपयोग से पहचान करनी चाहिए"},{"en":"Yes — 25 pins are exclusively patented for parallel printers only","hi":"हाँ — 25 पिन केवल पैरेलल प्रिंटर के लिए आरक्षित हैं"},{"en":"Yes — a 25-pin connector is always a USB Type-C port","hi":"हाँ — 25-पिन कनेक्टर हमेशा USB टाइप-C पोर्ट होता है"},{"en":"No — 25-pin connectors are used only for optical mouse tracking","hi":"नहीं — 25-पिन कनेक्टर का उपयोग केवल ऑप्टिकल माउस ट्रैकिंग के लिए होता है"}],"exp":{"en":"Trap Question: Pin count alone can be deceiving. While a 25-pin female DB-25 connector was standard for legacy parallel printer ports, legacy serial COM ports also utilized 25-pin male DB-25 connectors. Transmission method and wiring define the port.","hi":"एग्जाम ट्रैप प्रश्न: केवल पिन संख्या से भ्रमित न हों। पैरेलल पोर्ट के अलावा पुराने सीरियल पोर्ट (DB-25) भी 25-पिन के होते थे; पोर्ट की पहचान उसके ट्रांसमिशन मेथड और उपयोग से होती है।"},"num":194},{"id":"q195","q":{"en":"Which computer architecture features physically separate memory spaces and buses for instructions and data?","hi":"किस कंप्यूटर आर्किटेक्चर में निर्देश (instructions) और डेटा के लिए भौतिक रूप से अलग मेमोरी स्पेस और बसें होती हैं?"},"a":{"en":"Harvard Architecture","hi":"हार्वर्ड आर्किटेक्चर (Harvard Architecture)"},"o":[{"en":"Harvard Architecture","hi":"हार्वर्ड आर्किटेक्चर (Harvard Architecture)"},{"en":"Von Neumann Architecture","hi":"वॉन न्यूमैन आर्किटेक्चर"},{"en":"CISC Mainframe Architecture","hi":"CISC मेनफ्रेम आर्किटेक्चर"},{"en":"Punched-card Tabulator Architecture","hi":"पंच-कार्ड टैबुलेटर आर्किटेक्चर"}],"exp":{"en":"Trap Question: Unlike Von Neumann architecture which shares a single memory and bus, Harvard architecture features physically separate memory and separate buses for instructions and data.","hi":"एग्जाम ट्रैप प्रश्न: वॉन न्यूमैन आर्किटेक्चर में मेमोरी और बस साझा होती है, जबकि हार्वर्ड आर्किटेक्चर (Harvard Architecture) में निर्देश और डेटा के लिए अलग मेमोरी और बसें होती हैं।"},"num":195},{"id":"q196","q":{"en":"Which function keys are used respectively for renaming a file in Explorer and running spell-check in Word?","hi":"फ़ाइल एक्सप्लोरर में फ़ाइल रिनेम (Rename) करने और Word में स्पेल-चेक चलाने के लिए क्रमशः कौन-सी फ़ंक्शन कीज़ उपयोग होती हैं?"},"a":{"en":"F2 is used for renaming an item in File Explorer, and F7 is used for spell-checking in Microsoft Word","hi":"फ़ाइल एक्सप्लोरर में रिनेम के लिए F2 और MS Word में स्पेल-चेक के लिए F7 प्रयुक्त होती है"},"o":[{"en":"F2 is used for renaming an item in File Explorer, and F7 is used for spell-checking in Microsoft Word","hi":"फ़ाइल एक्सप्लोरर में रिनेम के लिए F2 और MS Word में स्पेल-चेक के लिए F7 प्रयुक्त होती है"},{"en":"F1 is used for renaming and F12 for spell-checking","hi":"रिनेम के लिए F1 और स्पेल-चेक के लिए F12"},{"en":"F5 is used for renaming and F2 for spell-checking","hi":"रिनेम के लिए F5 और स्पेल-चेक के लिए F2"},{"en":"F10 is used for renaming and F4 for spell-checking","hi":"रिनेम के लिए F10 और स्पेल-चेक के लिए F4"}],"exp":{"en":"Trap Question: F2 triggers file/folder renaming in Windows Explorer, whereas F7 opens the Spelling and Grammar checker in Microsoft Word.","hi":"एग्जाम ट्रैप प्रश्न: फ़ाइल एक्सप्लोरर में किसी फ़ाइल को रिनेम करने के लिए F2 और MS Word में स्पेल-चेक चलाने के लिए F7 फ़ंक्शन की का उपयोग किया जाता है।"},"num":196}]},{"title":{"en":"15. Rapid-Fire Final Revision","hi":"15. त्वरित अंतिम पुनरावृत्ति"},"questions":[{"id":"q197","q":{"en":"What is known as the 'Brain of the Computer'?","hi":"कंप्यूटर का मस्तिष्क (Brain of the Computer) किसे कहा जाता है?"},"a":{"en":"Central Processing Unit (CPU)","hi":"सेंट्रल प्रोसेसिंग यूनिट (CPU)"},"o":[{"en":"Central Processing Unit (CPU)","hi":"सेंट्रल प्रोसेसिंग यूनिट (CPU)"},{"en":"Hard Disk Drive (HDD)","hi":"हार्ड डिस्क ड्राइव"},{"en":"Optical Scanner","hi":"ऑप्टिकल स्कैनर"},{"en":"Power Supply Unit (SMPS)","hi":"पावर सप्लाई यूनिट"}],"exp":{"en":"Rapid-Fire: The CPU is universally known as the brain of the computer.","hi":"रैपिड-फायर: CPU को कंप्यूटर का मस्तिष्क कहा जाता है।"},"num":197},{"id":"q198","q":{"en":"Which CPU component performs arithmetic and logic operations?","hi":"कौन-सा CPU घटक अंकगणितीय और तार्किक (arithmetic and logic) कार्य करता है?"},"a":{"en":"Arithmetic and Logic Unit (ALU)","hi":"अरिथमेटिक एंड लॉजिक यूनिट (ALU)"},"o":[{"en":"Arithmetic and Logic Unit (ALU)","hi":"अरिथमेटिक एंड लॉजिक यूनिट (ALU)"},{"en":"Program Counter","hi":"प्रोग्राम काउंटर"},{"en":"Memory Address Register","hi":"मेमोरी एड्रेस रजिस्टर"},{"en":"Control Bus","hi":"कंट्रोल बस"}],"exp":{"en":"Rapid-Fire: The ALU executes all arithmetic and logic operations inside the processor.","hi":"रैपिड-फायर: ALU प्रोसेसर के भीतर सभी अंकगणितीय और तार्किक कार्य करता है।"},"num":198},{"id":"q199","q":{"en":"Which CPU component interprets instructions and coordinates data flow?","hi":"कौन-सा CPU घटक निर्देशों की व्याख्या करता है और डेटा प्रवाह समन्वित करता है?"},"a":{"en":"Control Unit (CU)","hi":"कंट्रोल यूनिट (CU)"},"o":[{"en":"Control Unit (CU)","hi":"कंट्रोल यूनिट (CU)"},{"en":"Dot Matrix Printhead","hi":"डॉट मैट्रिक्स प्रिंटहेड"},{"en":"Magnetic Tape Spindle","hi":"मैग्नेटिक टेप स्पिंडल"},{"en":"Optical Barcode Scanner","hi":"ऑप्टिकल बारकोड स्कैनर"}],"exp":{"en":"Rapid-Fire: The Control Unit decodes instructions and directs data flow across the system.","hi":"रैपिड-फायर: कंट्रोल यूनिट (CU) निर्देशों की व्याख्या करती है और सिस्टम में डेटा प्रवाह को समन्वित करती है।"},"num":199},{"id":"q200","q":{"en":"What are the extremely fast local storage locations inside the CPU called?","hi":"CPU के अंदर स्थित अत्यंत तेज़ लोकल स्टोरेज लोकेशन्स क्या कहलाती हैं?"},"a":{"en":"Registers","hi":"रजिस्टर (Registers)"},"o":[{"en":"Registers","hi":"रजिस्टर (Registers)"},{"en":"Floppy Disks","hi":"फ्लॉपी डिस्क"},{"en":"Optical Blu-ray Discs","hi":"ऑप्टिकल ब्लू-रे डिस्क"},{"en":"Magnetic Tapes","hi":"मैग्नेटिक टेप"}],"exp":{"en":"Rapid-Fire: Registers are ultra-fast storage locations built directly into the CPU.","hi":"रैपिड-फायर: CPU के भीतर स्थित अत्यंत तेज़ स्टोरेज लोकेशन्स को रजिस्टर (Registers) कहते हैं।"},"num":200},{"id":"q201","q":{"en":"What hardware signal does an I/O device send to the CPU when a task is completed?","hi":"जब कोई कार्य पूरा हो जाता है, तो I/O डिवाइस CPU को कौन-सा हार्डवेयर सिग्नल भेजता है?"},"a":{"en":"Interrupt signal","hi":"इंटरप्ट सिग्नल (Interrupt)"},"o":[{"en":"Interrupt signal","hi":"इंटरप्ट सिग्नल (Interrupt)"},{"en":"Voltage surge signal","hi":"वोल्टेज सर्ज सिग्नल"},{"en":"Laser scan pulse","hi":"लेजर स्कैन पल्स"},{"en":"Parallel LPT print tone","hi":"पैरेलल LPT प्रिंट टोन"}],"exp":{"en":"Rapid-Fire: An I/O device uses a hardware interrupt signal to notify the CPU that an event or transfer is complete.","hi":"रैपिड-फायर: कार्य पूरा होने पर I/O डिवाइस CPU को सूचित करने के लिए इंटरप्ट (Interrupt) सिग्नल भेजता है।"},"num":201},{"id":"q202","q":{"en":"Which reader technology optically detects filled paper bubble marks?","hi":"कौन-सी रीडर तकनीक भरे गए पेपर बबल निशानों को ऑप्टिकल रूप से पहचानती है?"},"a":{"en":"Optical Mark Recognition (OMR)","hi":"ऑप्टिकल मार्क रिकग्निशन (OMR)"},"o":[{"en":"Optical Mark Recognition (OMR)","hi":"ऑप्टिकल मार्क रिकग्निशन (OMR)"},{"en":"Magnetic Ink Character Recognition (MICR)","hi":"मैग्नेटिक इंक कैरेक्टर रिकग्निशन"},{"en":"Bar Code Reader (BCR)","hi":"बार कोड रीडर"},{"en":"Sequential Access Storage Device (SASD)","hi":"सीक्वेंशियल एक्सेस स्टोरेज डिवाइस"}],"exp":{"en":"Rapid-Fire: OMR optically detects shaded bubbles on exam sheets.","hi":"रैपिड-फायर: OMR परीक्षा शीट पर भरे गए बबल्स (गोले) की ऑप्टिकल पहचान करता है।"},"num":202},{"id":"q203","q":{"en":"Which technology reads magnetic ink characters printed on bank cheques?","hi":"बैंक चेक पर छपे चुंबकीय स्याही के अक्षरों को कौन-सी तकनीक पढ़ती है?"},"a":{"en":"Magnetic Ink Character Recognition (MICR)","hi":"मैग्नेटिक इंक कैरेक्टर रिकग्निशन (MICR)"},"o":[{"en":"Magnetic Ink Character Recognition (MICR)","hi":"मैग्नेटिक इंक कैरेक्टर रिकग्निशन (MICR)"},{"en":"Optical Mark Reader (OMR)","hi":"ऑप्टिकल मार्क रीडर"},{"en":"Quick Response Code (QR)","hi":"क्विक रिस्पॉन्स कोड"},{"en":"Virtual Memory Pagefile","hi":"वर्चुअल मेमोरी पेजफ़ाइल"}],"exp":{"en":"Rapid-Fire: MICR reads magnetic ink characters at the bottom of bank cheques.","hi":"रैपिड-फायर: बैंक चेक पर छपे चुंबकीय स्याही (magnetic ink) के अक्षरों को MICR पढ़ता है।"},"num":203},{"id":"q204","q":{"en":"Which pointing input device is associated with CRT displays?","hi":"CRT डिस्प्ले से जुड़ा पॉइंटिंग इनपुट डिवाइस कौन-सा है?"},"a":{"en":"Light Pen","hi":"लाइट पेन (Light Pen)"},"o":[{"en":"Light Pen","hi":"लाइट पेन (Light Pen)"},{"en":"Touchpad trackpad","hi":"टचपैड ट्रैकपैड"},{"en":"Laser barcode scanner","hi":"लेजर बारकोड स्कैनर"},{"en":"Dot matrix printhead","hi":"डॉट मैट्रिक्स प्रिंटहेड"}],"exp":{"en":"Rapid-Fire: A traditional light pen interacts directly with the raster scan of a CRT display.","hi":"रैपिड-फायर: CRT डिस्प्ले से जुड़ा पारंपरिक पॉइंटिंग इनपुट डिवाइस लाइट पेन (Light Pen) है।"},"num":204},{"id":"q205","q":{"en":"Which output device is used to produce large high-precision engineering drawings?","hi":"बड़ी और उच्च-सटीक इंजीनियरिंग ड्रॉइंग बनाने के लिए किस आउटपुट डिवाइस का उपयोग होता है?"},"a":{"en":"Plotter","hi":"प्लॉटर (Plotter)"},"o":[{"en":"Plotter","hi":"प्लॉटर (Plotter)"},{"en":"Dot Matrix Printer","hi":"डॉट मैट्रिक्स प्रिंटर"},{"en":"Thermal Receipt Printer","hi":"थर्मल रसीद प्रिंटर"},{"en":"Flatbed Document Scanner","hi":"फ्लैटबेड दस्तावेज़ स्कैनर"}],"exp":{"en":"Rapid-Fire: A plotter produces large-format vector drawings, architectural blueprints, and CAD graphics.","hi":"रैपिड-फायर: बड़ी इंजीनियरिंग ड्रॉइंग और नक्शे छापने के लिए प्लॉटर (Plotter) का उपयोग होता है।"},"num":205},{"id":"q206","q":{"en":"What is the high-speed semiconductor memory that keeps frequently accessed copies near the CPU called?","hi":"CPU के पास बार-बार काम आने वाले डेटा की कॉपी रखने वाली हाई-स्पीड सेमीकंडक्टर मेमोरी क्या कहलाती है?"},"a":{"en":"Cache Memory","hi":"कैश मेमोरी (Cache Memory)"},"o":[{"en":"Cache Memory","hi":"कैश मेमोरी (Cache Memory)"},{"en":"Magnetic Tape Archive","hi":"मैग्नेटिक टेप आर्काइव"},{"en":"CD-ROM Optical Disc","hi":"CD-ROM ऑप्टिकल डिस्क"},{"en":"Floppy Diskette","hi":"फ्लॉपी डिस्कटे"}],"exp":{"en":"Rapid-Fire: Cache memory provides ultra-fast access to frequently used instructions close to the CPU.","hi":"रैपिड-फायर: CPU के पास बार-बार उपयोग होने वाले डेटा की कॉपी रखने वाली मेमोरी कैश (Cache) कहलाती है।"},"num":206},{"id":"q207","q":{"en":"Which type of RAM requires periodic refreshing cycles to maintain its stored data?","hi":"किस प्रकार की RAM को अपना डेटा बनाए रखने के लिए बार-बार रिफ्रेश चक्र (refresh cycles) की आवश्यकता होती है?"},"a":{"en":"Dynamic RAM (DRAM)","hi":"डायनेमिक रैम (DRAM)"},"o":[{"en":"Dynamic RAM (DRAM)","hi":"डायनेमिक रैम (DRAM)"},{"en":"Static RAM (SRAM)","hi":"स्टैटिक रैम (SRAM)"},{"en":"Mask Read-Only Memory (ROM)","hi":"मास्क रीड-ओनली मेमोरी"},{"en":"Electrically Erasable PROM (EEPROM)","hi":"इलेक्ट्रिकली इरेज़ेबल PROM"}],"exp":{"en":"Rapid-Fire: DRAM stores charge in leaky capacitors and requires periodic refreshing.","hi":"रैपिड-फायर: डायनेमिक रैम (DRAM) को अपना डेटा बनाए रखने के लिए लगातार रिफ्रेश चक्र (refresh cycles) की आवश्यकता होती है।"},"num":207},{"id":"q208","q":{"en":"Where does the startup boot firmware reside when power is turned off?","hi":"बिजली बंद होने पर स्टार्टअप बूट फर्मवेयर (boot firmware) कहाँ सुरक्षित रहता है?"},"a":{"en":"Non-volatile ROM or Flash memory","hi":"नॉन-वोलेटाइल ROM या फ्लैश मेमोरी (Non-volatile ROM/Flash)"},"o":[{"en":"Non-volatile ROM or Flash memory","hi":"नॉन-वोलेटाइल ROM या फ्लैश मेमोरी (Non-volatile ROM/Flash)"},{"en":"Volatile SRAM Cache","hi":"वोलेटाइल SRAM कैश"},{"en":"Dynamic RAM main system sticks","hi":"डायनेमिक रैम मुख्य सिस्टम स्टिक्स"},{"en":"Magnetic tape sequential reels","hi":"मैग्नेटिक टेप सीक्वेंशियल रील"}],"exp":{"en":"Rapid-Fire: Boot firmware (BIOS/UEFI) resides in non-volatile ROM/flash memory.","hi":"रैपिड-फायर: पावर ऑफ होने पर भी स्टार्टअप बूट फर्मवेयर नॉन-वोलेटाइल ROM या फ्लैश मेमोरी में सुरक्षित रहता है।"},"num":208},{"id":"q209","q":{"en":"What is the classic example of a Sequential Access Storage Device (SASD)?","hi":"सीक्वेंशियल एक्सेस स्टोरेज डिवाइस (SASD) का क्लासिक उदाहरण क्या है?"},"a":{"en":"Magnetic Tape","hi":"मैग्नेटिक टेप (Magnetic Tape)"},"o":[{"en":"Magnetic Tape","hi":"मैग्नेटिक टेप (Magnetic Tape)"},{"en":"Solid-State Drive (SSD)","hi":"सॉलिड-स्टेट ड्राइव"},{"en":"Random Access Memory (RAM)","hi":"रैंडम एक्सेस मेमोरी"},{"en":"CPU Cache Register","hi":"CPU कैश रजिस्टर"}],"exp":{"en":"Rapid-Fire: Magnetic tape is the standard textbook example of sequential access storage.","hi":"रैपिड-फायर: सीक्वेंशियल एक्सेस स्टोरेज डिवाइस (SASD) का क्लासिक उदाहरण मैग्नेटिक टेप (Magnetic Tape) है।"},"num":209},{"id":"q210","q":{"en":"What are the standard single-layer and dual-layer capacities of a Blu-ray Disc?","hi":"एक ब्लू-रे डिस्क की मानक सिंगल-लेयर और डुअल-लेयर क्षमता कितनी होती है?"},"a":{"en":"25 GB and 50 GB respectively","hi":"क्रमशः 25 GB और 50 GB"},"o":[{"en":"25 GB and 50 GB respectively","hi":"क्रमशः 25 GB और 50 GB"},{"en":"700 MB and 4.7 GB respectively","hi":"क्रमशः 700 MB और 4.7 GB"},{"en":"1.44 MB and 2.88 MB respectively","hi":"क्रमशः 1.44 MB और 2.88 MB"},{"en":"4.7 TB and 10 TB respectively","hi":"क्रमशः 4.7 TB और 10 TB"}],"exp":{"en":"Rapid-Fire: A Blu-ray disc holds 25 GB on a single layer and 50 GB on dual layers.","hi":"रैपिड-फायर: ब्लू-रे डिस्क की सिंगल-लेयर क्षमता 25 GB और डुअल-लेयर क्षमता 50 GB होती है।"},"num":210},{"id":"q211","q":{"en":"What is the technically precise binary label for 1,024 bytes?","hi":"1,024 बाइट्स के लिए तकनीकी रूप से सटीक बाइनरी लेबल क्या है?"},"a":{"en":"1 KiB (kibibyte)","hi":"1 KiB (किबिबाइट)"},"o":[{"en":"1 KiB (kibibyte)","hi":"1 KiB (किबिबाइट)"},{"en":"1 MB (megabyte)","hi":"1 MB (मेगाबाइट)"},{"en":"1 Nibble","hi":"1 निबल"},{"en":"1 Bit","hi":"1 बिट"}],"exp":{"en":"Rapid-Fire: 1,024 bytes is precisely termed 1 KiB (kibibyte) under IEC binary standards.","hi":"रैपिड-फायर: 1,024 बाइट्स का सटीक IEC बाइनरी लेबल 1 KiB (किबिबाइट) है।"},"num":211},{"id":"q212","q":{"en":"Which programming language generation uses pure binary 0s and 1s?","hi":"कौन-सी प्रोग्रामिंग भाषा पीढ़ी शुद्ध बाइनरी 0 और 1 का उपयोग करती है?"},"a":{"en":"First-Generation Language (1GL / Machine language)","hi":"प्रथम पीढ़ी (1GL — मशीन भाषा)"},"o":[{"en":"First-Generation Language (1GL / Machine language)","hi":"प्रथम पीढ़ी (1GL — मशीन भाषा)"},{"en":"Second-Generation Language (2GL / Assembly)","hi":"द्वितीय पीढ़ी (2GL — असेंबली)"},{"en":"Third-Generation Language (3GL / FORTRAN)","hi":"तृतीय पीढ़ी (3GL)"},{"en":"Fifth-Generation Language (5GL / Prolog)","hi":"पंचम पीढ़ी (5GL)"}],"exp":{"en":"Rapid-Fire: 1GL is pure machine language written directly in binary 0s and 1s.","hi":"रैपिड-फायर: प्रथम पीढ़ी की भाषा (1GL — मशीन भाषा) सीधे बाइनरी 0 और 1 का उपयोग करती है।"},"num":212},{"id":"q213","q":{"en":"What type of codes do Second-Generation (2GL) Assembly languages use?","hi":"द्वितीय पीढ़ी (2GL) की असेंबली भाषाएँ किस प्रकार के कोड उपयोग करती हैं?"},"a":{"en":"Symbolic mnemonics (such as ADD, MOV)","hi":"प्रतीकात्मक निमोनिक्स (जैसे ADD, MOV)"},"o":[{"en":"Symbolic mnemonics (such as ADD, MOV)","hi":"प्रतीकात्मक निमोनिक्स (जैसे ADD, MOV)"},{"en":"Pure raw binary bits only","hi":"केवल शुद्ध बाइनरी बिट्स"},{"en":"Natural English paragraphs","hi":"प्राकृतिक अंग्रेजी पैराग्राफ"},{"en":"SQL database query statements","hi":"SQL डेटाबेस क्वेरी कथन"}],"exp":{"en":"Rapid-Fire: 2GL Assembly languages use human-readable symbolic mnemonics.","hi":"रैपिड-फायर: 2GL असेंबली भाषाएँ संक्षिप्त प्रतीकात्मक निमोनिक्स (mnemonics — जैसे ADD, MOV) का उपयोग करती हैं।"},"num":213},{"id":"q214","q":{"en":"Structured Query Language (SQL) is a textbook example of which language generation?","hi":"स्ट्रक्चर्ड क्वेरी लैंग्वेज (SQL) किस भाषा पीढ़ी का पाठ्यपुस्तक उदाहरण है?"},"a":{"en":"Fourth-Generation Language (4GL)","hi":"चतुर्थ पीढ़ी की भाषा (4GL)"},"o":[{"en":"Fourth-Generation Language (4GL)","hi":"चतुर्थ पीढ़ी की भाषा (4GL)"},{"en":"First-Generation Language (1GL)","hi":"प्रथम पीढ़ी की भाषा"},{"en":"Second-Generation Language (2GL)","hi":"द्वितीय पीढ़ी की भाषा"},{"en":"Third-Generation Language (3GL)","hi":"तृतीय पीढ़ी की भाषा"}],"exp":{"en":"Rapid-Fire: SQL is the classic textbook example of a 4GL query language.","hi":"रैपिड-फायर: SQL चतुर्थ पीढ़ी की भाषा (4GL — क्वेरी भाषा) का प्रमुख उदाहरण है।"},"num":214},{"id":"q215","q":{"en":"Which three buses form the primary communication pathways in computer architecture?","hi":"कंप्यूटर आर्किटेक्चर में कौन-सी तीन बसें मुख्य संचार मार्ग बनाती हैं?"},"a":{"en":"Data Bus, Address Bus, and Control Bus","hi":"डेटा बस, एड्रेस बस और कंट्रोल बस"},"o":[{"en":"Data Bus, Address Bus, and Control Bus","hi":"डेटा बस, एड्रेस बस और कंट्रोल बस"},{"en":"Serial Bus, Parallel Bus, and USB Bus","hi":"सीरियल बस, पैरेलल बस और USB बस"},{"en":"Input Bus, Output Bus, and Storage Bus","hi":"इनपुट बस, आउटपुट बस और स्टोरेज बस"},{"en":"SRAM Bus, DRAM Bus, and ROM Bus","hi":"SRAM बस, DRAM बस और ROM बस"}],"exp":{"en":"Rapid-Fire: The system bus comprises the Data Bus, Address Bus, and Control Bus.","hi":"रैपिड-फायर: सिस्टम बस के तीन मुख्य घटक डेटा बस, एड्रेस बस और कंट्रोल बस हैं।"},"num":215},{"id":"q216","q":{"en":"Which legacy port was commonly used for digital camcorders (IEEE 1394)?","hi":"डिजिटल कैमकॉर्डर जोड़ने के लिए कौन-सा पुराना पोर्ट (IEEE 1394) उपयोग होता था?"},"a":{"en":"FireWire","hi":"फायरवायर (FireWire)"},"o":[{"en":"FireWire","hi":"फायरवायर (FireWire)"},{"en":"PS/2 round port","hi":"PS/2 गोल पोर्ट"},{"en":"VGA 15-pin port","hi":"VGA 15-पिन पोर्ट"},{"en":"RJ-11 telephone jack","hi":"RJ-11 टेलीफोन जैक"}],"exp":{"en":"Rapid-Fire: FireWire (IEEE 1394) was widely used for digital video camcorders and audio gear.","hi":"रैपिड-फायर: डिजिटल कैमकॉर्डर आदि के लिए FireWire (IEEE 1394) पोर्ट का उपयोग होता था।"},"num":216},{"id":"q217","q":{"en":"Which computer architecture shares a single memory space for both instructions and data?","hi":"कौन-सा कंप्यूटर आर्किटेक्चर निर्देश और डेटा दोनों के लिए एक ही साझा मेमोरी स्पेस का उपयोग करता है?"},"a":{"en":"Von Neumann Architecture","hi":"वॉन न्यूमैन आर्किटेक्चर (Von Neumann Architecture)"},"o":[{"en":"Von Neumann Architecture","hi":"वॉन न्यूमैन आर्किटेक्चर (Von Neumann Architecture)"},{"en":"Harvard Architecture","hi":"हार्वर्ड आर्किटेक्चर"},{"en":"RISC Pipeline Architecture","hi":"RISC पाइपलाइन आर्किटेक्चर"},{"en":"Quantum Superposition Architecture","hi":"क्वांटम सुपरपोजिशन आर्किटेक्चर"}],"exp":{"en":"Rapid-Fire: Von Neumann architecture shares a single memory and bus for both instructions and data.","hi":"रैपिड-फायर: निर्देश और डेटा के लिए एकल साझा मेमोरी का उपयोग वॉन न्यूमैन आर्किटेक्चर (Von Neumann Architecture) करता है।"},"num":217},{"id":"q218","q":{"en":"What is the modern name of Windows Explorer in recent Windows versions?","hi":"आधुनिक विंडोज़ संस्करणों में Windows Explorer का नया नाम क्या है?"},"a":{"en":"File Explorer","hi":"फ़ाइल एक्सप्लोरर (File Explorer)"},"o":[{"en":"File Explorer","hi":"फ़ाइल एक्सप्लोरर (File Explorer)"},{"en":"Control Panel Manager","hi":"कंट्रोल पैनल मैनेजर"},{"en":"Internet Explorer Browser","hi":"इंटरनेट एक्सप्लोरर ब्राउज़र"},{"en":"Taskbar Navigator","hi":"टास्कबार नेविगेटर"}],"exp":{"en":"Rapid-Fire: Windows Explorer was renamed File Explorer starting with Windows 8.","hi":"रैपिड-फायर: आधुनिक विंडोज़ संस्करणों में Windows Explorer का नया नाम 'File Explorer' है।"},"num":218},{"id":"q219","q":{"en":"Which function key opens the 'Save As' dialog box in desktop Word processors?","hi":"डेस्कटॉप वर्ड प्रोसेसर में कौन-सी फ़ंक्शन की 'Save As' डायलॉग बॉक्स खोलती है?"},"a":{"en":"F12","hi":"F12"},"o":[{"en":"F12","hi":"F12"},{"en":"F1","hi":"F1"},{"en":"F5","hi":"F5"},{"en":"F7","hi":"F7"}],"exp":{"en":"Rapid-Fire: F12 opens the Save As dialog box in Microsoft Word.","hi":"रैपिड-फायर: MS Word जैसे डेस्कटॉप एप्लिकेशन्स में F12 दबाने से 'Save As' डायलॉग बॉक्स खुलता है।"},"num":219}]}],"3. Software & Operating Systems — Programming Languages, Translators & Operating Systems":[{"title":{"en":"1. Software, Soft Copy & Hard Copy","hi":"1. सॉफ्टवेयर, सॉफ्ट कॉपी और हार्ड कॉपी"},"questions":[{"id":"q1","q":{"en":"What is 'Software' in a computer system?","hi":"कंप्यूटर सिस्टम में 'सॉफ्टवेयर' (Software) क्या है?"},"a":{"en":"Programs, instructions, and associated data that direct computer hardware to perform tasks","hi":"प्रोग्राम, निर्देश और संबंधित डेटा जो कंप्यूटर हार्डवेयर से कार्य करवाते हैं"},"o":[{"en":"Physical metal and plastic parts like the cabinet, monitor, and keyboard","hi":"कैबिनेट, मॉनिटर और कीबोर्ड जैसे भौतिक धातु और प्लास्टिक के भाग"},{"en":"Programs, instructions, and associated data that direct computer hardware to perform tasks","hi":"प्रोग्राम, निर्देश और संबंधित डेटा जो कंप्यूटर हार्डवेयर से कार्य करवाते हैं"},{"en":"Unregulated alternating current supplied by the power grid","hi":"पावर ग्रिड द्वारा आपूर्ति की जाने वाली अनियमित प्रत्यावर्ती धारा"},{"en":"Paper rolls used inside thermal receipt printers","hi":"थर्मल रसीद प्रिंटर के अंदर उपयोग किए जाने वाले पेपर रोल"}],"exp":{"en":"Software consists of intangible programs, step-by-step instructions, and associated data that tell the computer hardware what tasks to perform and how to execute them.","hi":"सॉफ्टवेयर वे प्रोग्राम, निर्देश (instructions) और संबंधित डेटा हैं जो कंप्यूटर हार्डवेयर को संचालित करते हैं और उससे विभिन्न कार्य करवाते हैं।"},"num":1},{"id":"q2","q":{"en":"Into which three main categories does the chapter classify computer software?","hi":"अध्याय में कंप्यूटर सॉफ्टवेयर को किन तीन मुख्य श्रेणियों में बाँटा गया है?"},"a":{"en":"System software, Programming software, and Application software","hi":"सिस्टम सॉफ्टवेयर, प्रोग्रामिंग सॉफ्टवेयर और एप्लिकेशन सॉफ्टवेयर"},"o":[{"en":"Input software, Output software, and Cabinet software","hi":"इनपुट सॉफ्टवेयर, आउटपुट सॉफ्टवेयर और कैबिनेट सॉफ्टवेयर"},{"en":"Magnetic software, Optical software, and Thermal software","hi":"मैग्नेटिक सॉफ्टवेयर, ऑप्टिकल सॉफ्टवेयर और थर्मल सॉफ्टवेयर"},{"en":"System software, Programming software, and Application software","hi":"सिस्टम सॉफ्टवेयर, प्रोग्रामिंग सॉफ्टवेयर और एप्लिकेशन सॉफ्टवेयर"},{"en":"ALU software, Register software, and Bus software","hi":"ALU सॉफ्टवेयर, रजिस्टर सॉफ्टवेयर और बस सॉफ्टवेयर"}],"exp":{"en":"The chapter classifies computer software into three broad categories: System software, Programming software, and Application software.","hi":"अध्याय के अनुसार सॉफ्टवेयर को तीन मुख्य श्रेणियों में बाँटा गया है: सिस्टम सॉफ्टवेयर (System software), प्रोग्रामिंग सॉफ्टवेयर (Programming software) और एप्लिकेशन सॉफ्टवेयर (Application software)।"},"num":2},{"id":"q3","q":{"en":"Ubuntu and Windows 7/10/11 are examples of which software category?","hi":"उबंटू (Ubuntu) और विंडोज़ (Windows 7/10/11) किस सॉफ्टवेयर श्रेणी के उदाहरण हैं?"},"a":{"en":"Operating Systems, which fall under the category of System Software","hi":"ऑपरेटिंग सिस्टम, जो सिस्टम सॉफ्टवेयर की श्रेणी में आते हैं"},"o":[{"en":"Operating Systems, which fall under the category of System Software","hi":"ऑपरेटिंग सिस्टम, जो सिस्टम सॉफ्टवेयर की श्रेणी में आते हैं"},{"en":"Spreadsheet calculation formulas","hi":"स्प्रेडशीट गणना फॉर्मूले"},{"en":"3D animation and motion-graphics plugins","hi":"3D एनीमेशन और मोशन-ग्राफिक्स प्लगइन्स"},{"en":"Hardware power supply units","hi":"हार्डवेयर पावर सप्लाई यूनिट"}],"exp":{"en":"Ubuntu and Microsoft Windows (7, 10, 11) are Operating Systems, which are the core examples of System Software.","hi":"Ubuntu और Windows 7/10/11 ऑपरेटिंग सिस्टम (Operating Systems) हैं, जो सिस्टम सॉफ्टवेयर (System software) की श्रेणी में आते हैं।"},"num":3},{"id":"q4","q":{"en":"What is a 'Soft Copy', and which of the following are its examples?","hi":"'सॉफ्ट कॉपी' (Soft Copy) क्या होती है और इसके उदाहरण कौन-से हैं?"},"a":{"en":"The digital/electronic version of a document or image; examples include a PDF file, a photo on a phone, or a document saved on a pen drive","hi":"किसी दस्तावेज़ या इमेज का डिजिटल रूप; जैसे PDF फ़ाइल, फ़ोन पर फोटो या पेन ड्राइव में सेव किया गया डॉक्यूमेंट"},"o":[{"en":"A document printed on cotton fabric using a dot matrix printer","hi":"डॉट मैट्रिक्स प्रिंटर का उपयोग करके सूती कपड़े पर छपा दस्तावेज़"},{"en":"The digital/electronic version of a document or image; examples include a PDF file, a photo on a phone, or a document saved on a pen drive","hi":"किसी दस्तावेज़ या इमेज का डिजिटल रूप; जैसे PDF फ़ाइल, फ़ोन पर फोटो या पेन ड्राइव में सेव किया गया डॉक्यूमेंट"},{"en":"A laminated paper certificate delivered by courier","hi":"कूरियर द्वारा वितरित एक लेमिनेटेड कागजी प्रमाणपत्र"},{"en":"A physical architectural blueprint plotted on vinyl sheet","hi":"विनाइल शीट पर प्लॉट किया गया एक भौतिक वास्तुशिल्प ब्लूप्रिंट"}],"exp":{"en":"A soft copy is the intangible, digital/electronic version of a document or image stored on a storage medium or displayed on a screen—such as a PDF file, a photo on a smartphone, or a file saved on a USB pen drive.","hi":"किसी दस्तावेज़ या छवि के डिजिटल (इलेक्ट्रॉनिक) संस्करण को 'सॉफ्ट कॉपी' कहते हैं। PDF फ़ाइल, फ़ोन स्क्रीन पर दिखती फोटो और पेन ड्राइव में सेव डॉक्यूमेंट इसके प्रमुख उदाहरण हैं।"},"num":4},{"id":"q5","q":{"en":"What is a 'Hard Copy'?","hi":"'हार्ड कॉपी' (Hard Copy) क्या होती है?"},"a":{"en":"The physical printed copy of a document or image on paper or another tangible medium","hi":"कागज या किसी भौतिक माध्यम पर दस्तावेज़ या छवि की प्रिंटेड कॉपी (भौतिक प्रति)"},"o":[{"en":"A file saved on a Solid-State Drive (SSD)","hi":"सॉलिड-स्टेट ड्राइव (SSD) पर सहेजी गई फ़ाइल"},{"en":"An encrypted email attachment stored in the cloud","hi":"क्लाउड में संग्रहीत एक एन्क्रिप्टेड ईमेल अटैचमेंट"},{"en":"The physical printed copy of a document or image on paper or another tangible medium","hi":"कागज या किसी भौतिक माध्यम पर दस्तावेज़ या छवि की प्रिंटेड कॉपी (भौतिक प्रति)"},{"en":"A temporary variable held inside a CPU register","hi":"CPU रजिस्टर के अंदर रखा गया एक अस्थायी वेरिएबल"}],"exp":{"en":"A hard copy is a permanent, tangible, physical printed reproduction of a digital document or image (typically printed on paper using a printer or plotter).","hi":"किसी दस्तावेज़ या इमेज की कागज पर छपी भौतिक प्रिंटेड प्रति (physical printed copy) को 'हार्ड कॉपी' कहा जाता है।"},"num":5},{"id":"q6","q":{"en":"What is the main function of 'System Software'?","hi":"'सिस्टम सॉफ्टवेयर' (System Software) का मुख्य कार्य क्या है?"},"a":{"en":"It operates and coordinates computer hardware and provides a platform for running application software","hi":"यह हार्डवेयर को संचालित व समन्वित (coordinate) करता है और एप्लिकेशन चलाने के लिए प्लेटफॉर्म देता है"},"o":[{"en":"It operates and coordinates computer hardware and provides a platform for running application software","hi":"यह हार्डवेयर को संचालित व समन्वित (coordinate) करता है और एप्लिकेशन चलाने के लिए प्लेटफॉर्म देता है"},{"en":"It is used exclusively for retouching wedding photographs","hi":"इसका उपयोग विशेष रूप से शादी की तस्वीरों को रीटच करने के लिए किया जाता है"},{"en":"It only calculates income tax returns in a spreadsheet","hi":"यह केवल स्प्रेडशीट में आयकर रिटर्न की गणना करता है"},{"en":"It physically cools down the motherboard using liquid nitrogen","hi":"यह लिक्विड नाइट्रोजन का उपयोग करके मदरबोर्ड को भौतिक रूप से ठंडा करता है"}],"exp":{"en":"System software manages, operates, and coordinates the underlying computer hardware resources and provides the essential platform/environment required for application programs to run.","hi":"सिस्टम सॉफ्टवेयर का मुख्य काम कंप्यूटर हार्डवेयर को संचालित और समन्वित (operate and coordinate) करना तथा एप्लिकेशन सॉफ्टवेयर को रन करने के लिए प्लेटफॉर्म प्रदान करना है।"},"num":6},{"id":"q7","q":{"en":"Which of the following are standard examples of System Software?","hi":"निम्नलिखित में से कौन-से सिस्टम सॉफ्टवेयर (System Software) के उदाहरण हैं?"},"a":{"en":"Operating systems, device drivers, and system utilities (the chapter also places boot firmware BIOS in this group)","hi":"ऑपरेटिंग सिस्टम, डिवाइस ड्राइवर और सिस्टम यूटिलिटीज़ (अध्याय बूट फर्मवेयर BIOS को भी इसी समूह में रखता है)"},"o":[{"en":"MS Word, MS PowerPoint, and Adobe Photoshop","hi":"MS Word, MS PowerPoint और Adobe Photoshop"},{"en":"Operating systems, device drivers, and system utilities (the chapter also places boot firmware BIOS in this group)","hi":"ऑपरेटिंग सिस्टम, डिवाइस ड्राइवर और सिस्टम यूटिलिटीज़ (अध्याय बूट फर्मवेयर BIOS को भी इसी समूह में रखता है)"},{"en":"VLC Media Player, Skype, and CorelDRAW","hi":"VLC Media Player, Skype और CorelDRAW"},{"en":"HTML, CSS, and JPEG files","hi":"HTML, CSS और JPEG फ़ाइलें"}],"exp":{"en":"Standard examples of system software include Operating Systems (OS), Device Drivers, and System Utilities; the chapter notes also group boot firmware (BIOS) under system software.","hi":"सिस्टम सॉफ्टवेयर के प्रमुख उदाहरण ऑपरेटिंग सिस्टम, डिवाइस ड्राइवर और सिस्टम यूटिलिटीज़ हैं (अध्याय में बूट फर्मवेयर BIOS को भी इसी समूह में रखा गया है)।"},"num":7},{"id":"q8","q":{"en":"What does a 'Device Driver' do?","hi":"'डिवाइस ड्राइवर' (Device Driver) क्या कार्य करता है?"},"a":{"en":"It enables the Operating System to communicate with and control a specific hardware device, such as a printer or graphics card","hi":"यह ऑपरेटिंग सिस्टम (OS) को प्रिंटर, ग्राफिक्स कार्ड या किसी अन्य विशिष्ट हार्डवेयर के साथ संवाद (communicate) करने देता है"},"o":[{"en":"It physically transports computer cabinets from the factory to retail stores","hi":"यह कंप्यूटर कैबिनेट को फैक्ट्री से रिटेल स्टोर तक भौतिक रूप से पहुँचाता है"},{"en":"It enables the Operating System to communicate with and control a specific hardware device, such as a printer or graphics card","hi":"यह ऑपरेटिंग सिस्टम (OS) को प्रिंटर, ग्राफिक्स कार्ड या किसी अन्य विशिष्ट हार्डवेयर के साथ संवाद (communicate) करने देता है"},{"en":"It translates high-level Python scripts into SQL tables","hi":"यह उच्च-स्तरीय पायथन स्क्रिप्ट को SQL तालिकाओं में अनुवादित करता है"},{"en":"It cleans dust off the optical scanner glass","hi":"यह ऑप्टिकल स्कैनर के कांच से धूल साफ करता है"}],"exp":{"en":"A device driver is a specialized system software component that acts as a translator/bridge, allowing the Operating System to communicate with and control a specific hardware peripheral (e.g., printer, graphics card, sound card, network adapter).","hi":"डिवाइस ड्राइवर एक विशेष सिस्टम सॉफ्टवेयर है जो ऑपरेटिंग सिस्टम (OS) को प्रिंटर, ग्राफिक्स कार्ड या अन्य विशिष्ट हार्डवेयर उपकरणों के साथ संवाद (communicate) और नियंत्रण करने में सक्षम बनाता है।"},"num":8},{"id":"q9","q":{"en":"What is 'Utility Software'?","hi":"'यूटिलिटी सॉफ्टवेयर' (Utility Software) क्या होता है?"},"a":{"en":"A tool designed to maintain, configure, optimize, protect, or troubleshoot a computer system","hi":"कंप्यूटर सिस्टम को मेंटेन (रखरखाव), कॉन्फ़िगर, सुरक्षित (protect) या ट्रबलशूट करने वाला टूल"},"o":[{"en":"A tool designed to maintain, configure, optimize, protect, or troubleshoot a computer system","hi":"कंप्यूटर सिस्टम को मेंटेन (रखरखाव), कॉन्फ़िगर, सुरक्षित (protect) या ट्रबलशूट करने वाला टूल"},{"en":"A hardware bus that carries memory addresses","hi":"मेमोरी एड्रेस ले जाने वाली एक हार्डवेयर बस"},{"en":"A web browser used only for watching online videos","hi":"केवल ऑनलाइन वीडियो देखने के लिए प्रयुक्त एक वेब ब्राउज़र"},{"en":"A mechanical gear assembly inside an impact printer","hi":"इम्पैक्ट प्रिंटर के अंदर एक यांत्रिक गियर असेंबली"}],"exp":{"en":"Utility software refers to system management tools designed to analyze, configure, maintain, optimize, protect, or troubleshoot a computer system.","hi":"यूटिलिटी सॉफ्टवेयर वह सिस्टम टूल है जिसका उपयोग कंप्यूटर सिस्टम को मेंटेन (रखरखाव), कॉन्फ़िगर, प्रोटेक्ट (सुरक्षित) या ट्रबलशूट करने के लिए किया जाता है।"},"num":9},{"id":"q10","q":{"en":"Antivirus, Disk Cleaner, and Formatting Tools belong to which software category, and what are their respective functions?","hi":"एंटीवायरस, डिस्क क्लीनर और फ़ॉर्मेटिंग टूल किस श्रेणी में आते हैं और उनके क्रमशः कार्य क्या हैं?"},"a":{"en":"Utility software — used respectively for protection against malware, cleaning up unwanted/temporary files, and formatting storage drives","hi":"यूटिलिटी सॉफ्टवेयर — इनके काम क्रमशः मैलवेयर से सुरक्षा, अनावश्यक फ़ाइलों की सफाई और स्टोरेज को फ़ॉर्मेट करना हैं"},"o":[{"en":"Application suites — used for typing letters, making slides, and editing videos","hi":"एप्लिकेशन सुइट्स — पत्र टाइप करने, स्लाइड बनाने और वीडियो एडिट करने के लिए"},{"en":"Utility software — used respectively for protection against malware, cleaning up unwanted/temporary files, and formatting storage drives","hi":"यूटिलिटी सॉफ्टवेयर — इनके काम क्रमशः मैलवेयर से सुरक्षा, अनावश्यक फ़ाइलों की सफाई और स्टोरेज को फ़ॉर्मेट करना हैं"},{"en":"Bootloaders — used only to load the BIOS into CPU registers","hi":"बूटलोडर — केवल BIOS को CPU रजिस्टरों में लोड करने के लिए"},{"en":"Database engines — used only to execute SQL joins","hi":"डेटाबेस इंजन — केवल SQL जॉइन निष्पादित करने के लिए"}],"exp":{"en":"Antivirus, disk cleaner, and disk formatting tools are all examples of Utility Software: antivirus protects against malware/viruses, disk cleaner removes unwanted/junk files to free space, and formatting tools prepare/format storage media.","hi":"ये तीनों 'यूटिलिटी सॉफ्टवेयर' (Utility software) की श्रेणी में आते हैं। इनके कार्य क्रमशः मैलवेयर/वायरस से सुरक्षा देना, अनावश्यक फ़ाइलों को क्लीन करना और स्टोरेज ड्राइव को फ़ॉर्मेट करना हैं।"},"num":10},{"id":"q11","q":{"en":"What is 'Programming Software' used for, and which of the following are its examples?","hi":"'प्रोग्रामिंग सॉफ्टवेयर' (Programming Software) का उपयोग किसलिए होता है और इसके उदाहरण कौन-से हैं?"},"a":{"en":"Used by programmers to write, translate, test, and debug code; examples include code editors, assemblers, compilers, and debuggers","hi":"कोड लिखने, ट्रांसलेट करने और टेस्ट/डीबग करने के लिए; उदाहरण: एडिटर, असेंबलर, कंपाइलर और डीबगर"},"o":[{"en":"Used by programmers to write, translate, test, and debug code; examples include code editors, assemblers, compilers, and debuggers","hi":"कोड लिखने, ट्रांसलेट करने और टेस्ट/डीबग करने के लिए; उदाहरण: एडिटर, असेंबलर, कंपाइलर और डीबगर"},{"en":"Used to play MP3 audio songs; examples: VLC and Windows Media Player","hi":"MP3 ऑडियो गाने चलाने के लिए; उदाहरण: VLC और विंडोज़ मीडिया प्लेयर"},{"en":"Used to browse websites; examples: Chrome, Edge, and Safari","hi":"वेबसाइट ब्राउज़ करने के लिए; उदाहरण: क्रोम, एज और सफारी"},{"en":"Used to print bank cheques; example: MICR reader","hi":"बैंक चेक प्रिंट करने के लिए; उदाहरण: MICR रीडर"}],"exp":{"en":"Programming software provides tools for software developers to write, translate, test, and debug computer programs. Common examples are source-code editors, assemblers, compilers, interpreters, and debuggers.","hi":"प्रोग्रामिंग सॉफ्टवेयर का उपयोग कंप्यूटर कोड लिखने, ट्रांसलेट करने और टेस्ट/डीबग करने के लिए किया जाता है। टेक्स्ट/कोड एडिटर, असेंबलर, कंपाइलर और डीबगर इसके मुख्य उदाहरण हैं।"},"num":11}]},{"title":{"en":"2. Programming Languages & Translators","hi":"2. प्रोग्रामिंग भाषाएँ और ट्रांसलेटर"},"questions":[{"id":"q12","q":{"en":"What is the 'Syntax' of a programming language?","hi":"किसी प्रोग्रामिंग भाषा की 'सिंटैक्स' (Syntax) क्या होती है?"},"a":{"en":"The set of grammar, spelling, and structural rules that define how valid code must be written in that language","hi":"वैध (valid) कोड लिखने के व्याकरण और संरचना संबंधी नियम (Grammar rules)"},"o":[{"en":"The physical clock speed of the microprocessor in gigahertz","hi":"गीगाहर्ट्ज़ में माइक्रोप्रोसेसर की भौतिक क्लॉक स्पीड"},{"en":"The set of grammar, spelling, and structural rules that define how valid code must be written in that language","hi":"वैध (valid) कोड लिखने के व्याकरण और संरचना संबंधी नियम (Grammar rules)"},{"en":"The retail price of a commercial software licence","hi":"व्यावसायिक सॉफ्टवेयर लाइसेंस का खुदरा मूल्य"},{"en":"A hardware cable used to connect a printer to the motherboard","hi":"प्रिंटर को मदरबोर्ड से जोड़ने के लिए प्रयुक्त एक हार्डवेयर केबल"}],"exp":{"en":"In programming, syntax refers to the formal set of grammar and structural rules that govern how symbols, keywords, and punctuation must be combined to write valid code.","hi":"प्रोग्रामिंग भाषा में वैध कोड (valid code) लिखने के व्याकरण और संरचना संबंधी नियमों (grammar rules) को 'सिंटैक्स' (Syntax) कहा जाता है।"},"num":12},{"id":"q13","q":{"en":"What are the two broad categories of programming languages?","hi":"प्रोग्रामिंग भाषाओं की दो मुख्य (Broad) श्रेणियाँ कौन-सी हैं?"},"a":{"en":"Low-level languages and High-level languages","hi":"लो-लेवल (Low-level) और हाई-लेवल (High-level) भाषाएँ"},"o":[{"en":"Low-level languages and High-level languages","hi":"लो-लेवल (Low-level) और हाई-लेवल (High-level) भाषाएँ"},{"en":"Hard-copy languages and Soft-copy languages","hi":"हार्ड-कॉपी और सॉफ्ट-कॉपी भाषाएँ"},{"en":"Impact languages and Non-impact languages","hi":"इम्पैक्ट और नॉन-इम्पैक्ट भाषाएँ"},{"en":"Volatile languages and Non-volatile languages","hi":"वोलेटाइल और नॉन-वोलेटाइल भाषाएँ"}],"exp":{"en":"Programming languages are broadly divided into two categories based on their level of abstraction from hardware: Low-Level Languages (LLL) and High-Level Languages (HLL).","hi":"प्रोग्रामिंग भाषाओं की दो व्यापक श्रेणियाँ लो-लेवल भाषाएँ (Low-level languages) और हाई-लेवल भाषाएँ (High-level languages) हैं।"},"num":13},{"id":"q14","q":{"en":"Why are Low-Level Languages considered 'machine-dependent'?","hi":"लो-लेवल भाषाएँ (Low-level languages) 'मशीन-निर्भर' (Machine-dependent) क्यों होती हैं?"},"a":{"en":"Because the code is closely tied to a specific CPU architecture or instruction set and cannot run directly on a different processor family","hi":"क्योंकि इनका कोड किसी विशिष्ट CPU आर्किटेक्चर या इंस्ट्रक्शन सेट से सीधे जुड़ा होता है"},"o":[{"en":"Because the code is closely tied to a specific CPU architecture or instruction set and cannot run directly on a different processor family","hi":"क्योंकि इनका कोड किसी विशिष्ट CPU आर्किटेक्चर या इंस्ट्रक्शन सेट से सीधे जुड़ा होता है"},{"en":"Because they can only be written when the computer is connected to a laser printer","hi":"क्योंकि इन्हें केवल तभी लिखा जा सकता है जब कंप्यूटर लेजर प्रिंटर से जुड़ा हो"},{"en":"Because they require a high-speed internet connection to compile","hi":"क्योंकि इन्हें कंपाइल करने के लिए हाई-स्पीड इंटरनेट कनेक्शन की आवश्यकता होती है"},{"en":"Because they only work on touchscreen smartphones","hi":"क्योंकि वे केवल टचस्क्रीन स्मार्टफोन पर काम करती हैं"}],"exp":{"en":"Low-level languages (machine and assembly language) are machine-dependent because their instructions and register names are written specifically for a particular processor's instruction set architecture (ISA).","hi":"लो-लेवल भाषाएँ मशीन-निर्भर (machine-dependent) इसलिए होती हैं क्योंकि उनका कोड किसी विशिष्ट CPU आर्किटेक्चर या इंस्ट्रक्शन सेट (instruction set) से सीधे तौर पर जुड़ा होता है।"},"num":14},{"id":"q15","q":{"en":"What are the respective generation numbers of Machine Language and Assembly Language?","hi":"मशीन भाषा (Machine Language) और असेंबली भाषा (Assembly Language) की पीढ़ी संख्या (Generation Number) क्रमशः क्या है?"},"a":{"en":"Machine language is 1GL (First-Generation) and Assembly language is 2GL (Second-Generation)","hi":"मशीन भाषा 1GL (प्रथम पीढ़ी) और असेंबली भाषा 2GL (द्वितीय पीढ़ी) है"},"o":[{"en":"Machine language is 3GL and Assembly language is 4GL","hi":"मशीन भाषा 3GL है और असेंबली भाषा 4GL है"},{"en":"Machine language is 1GL (First-Generation) and Assembly language is 2GL (Second-Generation)","hi":"मशीन भाषा 1GL (प्रथम पीढ़ी) और असेंबली भाषा 2GL (द्वितीय पीढ़ी) है"},{"en":"Machine language is 5GL and Assembly language is 1GL","hi":"मशीन भाषा 5GL है और असेंबली भाषा 1GL है"},{"en":"Both are 4GL query languages","hi":"दोनों 4GL क्वेरी भाषाएँ हैं"}],"exp":{"en":"In the programming language generation hierarchy, Machine Language is the First-Generation Language (1GL) and Assembly Language is the Second-Generation Language (2GL).","hi":"मशीन भाषा प्रथम पीढ़ी की भाषा (1GL) है और असेंबली भाषा द्वितीय पीढ़ी की भाषा (2GL) है।"},"num":15},{"id":"q16","q":{"en":"What is the basic difference between Machine Language and Assembly Language?","hi":"मशीन भाषा (Machine language) और असेंबली भाषा (Assembly language) में बुनियादी फर्क क्या है?"},"a":{"en":"Machine language is the binary (0s and 1s) encoding of CPU instructions, whereas Assembly language uses short symbolic mnemonics for instructions","hi":"मशीन भाषा CPU निर्देशों की बाइनरी एनकोडिंग (0 और 1) है, जबकि असेंबली भाषा निर्देशों के लिए प्रतीकात्मक निमोनिक्स (symbolic mnemonics) का उपयोग करती है"},"o":[{"en":"Machine language is the binary (0s and 1s) encoding of CPU instructions, whereas Assembly language uses short symbolic mnemonics for instructions","hi":"मशीन भाषा CPU निर्देशों की बाइनरी एनकोडिंग (0 और 1) है, जबकि असेंबली भाषा निर्देशों के लिए प्रतीकात्मक निमोनिक्स (symbolic mnemonics) का उपयोग करती है"},{"en":"Machine language uses English sentences, whereas Assembly language uses SQL tables","hi":"मशीन भाषा अंग्रेजी वाक्यों का उपयोग करती है, जबकि असेंबली भाषा SQL तालिकाओं का उपयोग करती है"},{"en":"Machine language requires an interpreter, whereas Assembly language is executed directly without any translation","hi":"मशीन भाषा को इंटरप्रेटर की आवश्यकता होती है, जबकि असेंबली भाषा बिना किसी अनुवाद के सीधे निष्पादित होती है"},{"en":"There is no difference; both use only hexadecimal colour codes","hi":"कोई अंतर नहीं है; दोनों केवल हेक्साडेसिमल रंग कोड का उपयोग करते हैं"}],"exp":{"en":"Machine language represents instructions in raw binary digits (0s and 1s) directly understood by the CPU, whereas Assembly language replaces raw binary opcodes with human-readable symbolic mnemonics (such as ADD, SUB, MOV).","hi":"मशीन भाषा CPU निर्देशों की बाइनरी एनकोडिंग (0 और 1) होती है, जबकि असेंबली भाषा निर्देशों के लिए संक्षिप्त प्रतीकात्मक नामों अर्थात् 'निमोनिक्स' (symbolic mnemonics — जैसे ADD, MOV) का उपयोग करती है।"},"num":16},{"id":"q17","q":{"en":"What is the key feature of a High-Level Language (HLL)?","hi":"हाई-लेवल भाषा (High-Level Language - HLL) की मुख्य विशेषता क्या है?"},"a":{"en":"It uses human-readable abstractions that make writing, reading, and maintaining code relatively easy, and the same source code can often be reused across compatible platforms (portable)","hi":"इसमें मानव-पठनीय शब्दों के साथ कोड लिखना आसान होता है और एक ही कोड को अक्सर विभिन्न संगत प्लेटफॉर्म्स पर उपयोग (portable) किया जा सकता है"},"o":[{"en":"It uses human-readable abstractions that make writing, reading, and maintaining code relatively easy, and the same source code can often be reused across compatible platforms (portable)","hi":"इसमें मानव-पठनीय शब्दों के साथ कोड लिखना आसान होता है और एक ही कोड को अक्सर विभिन्न संगत प्लेटफॉर्म्स पर उपयोग (portable) किया जा सकता है"},{"en":"It must be written strictly in binary 0s and 1s for a single CPU model","hi":"इसे एकल CPU मॉडल के लिए सख्ती से बाइनरी 0 और 1 में लिखा जाना चाहिए"},{"en":"It cannot perform any arithmetic or logical operations","hi":"यह कोई भी अंकगणितीय या तार्किक कार्य नहीं कर सकती"},{"en":"It works only inside non-volatile ROM chips without an operating system","hi":"यह बिना ऑपरेटिंग सिस्टम के केवल नॉन-वोलेटाइल ROM चिप्स के अंदर काम करती है"}],"exp":{"en":"High-level languages provide human-readable English-like syntax and mathematical abstractions, making programming easier and allowing source code to be portable across different hardware platforms with appropriate compilers/runtimes.","hi":"हाई-लेवल भाषा की मुख्य विशेषता यह है कि इसमें मानव-पठनीय (human-readable) संरचनाओं के साथ कोड लिखना अपेक्षाकृत आसान होता है, और समान कोड को अक्सर विभिन्न प्लेटफॉर्म्स पर दोबारा उपयोग (reuse/portable) किया जा सकता है।"},"num":17},{"id":"q18","q":{"en":"Which of the following sets lists valid examples of High-Level Programming Languages from the chapter?","hi":"अध्याय के अनुसार निम्नलिखित में से कौन-से हाई-लेवल प्रोग्रामिंग भाषाओं (High-level languages) के उदाहरण हैं?"},"a":{"en":"C, C++, Java, Python, and Fortran","hi":"C, C++, Java, Python और Fortran"},"o":[{"en":"Ubuntu, Fedora, Windows, and macOS","hi":"Ubuntu, Fedora, Windows और macOS"},{"en":"C, C++, Java, Python, and Fortran","hi":"C, C++, Java, Python और Fortran"},{"en":"BIOS, CMOS, POST, and MBR","hi":"BIOS, CMOS, POST और MBR"},{"en":"JPEG, PNG, GIF, and TIFF","hi":"JPEG, PNG, GIF और TIFF"}],"exp":{"en":"Standard examples of high-level programming languages listed in the chapter include C, C++, Java, Python, and Fortran.","hi":"हाई-लेवल प्रोग्रामिंग भाषाओं के प्रमुख उदाहरण C, C++, Java, Python और Fortran हैं।"},"num":18},{"id":"q19","q":{"en":"Why is a language translator or runtime environment required for High-Level Language code?","hi":"हाई-लेवल भाषा (High-level code) के लिए ट्रांसलेटर या रनटाइम की आवश्यकता क्यों होती है?"},"a":{"en":"Because the CPU can only execute low-level machine instructions, so a translator or runtime must convert the source code into executable machine operations","hi":"क्योंकि CPU केवल मशीन निर्देशों को ही एक्जीक्यूट करता है; ट्रांसलेटर या रनटाइम सोर्स कोड को एक्जीक्यूटेबल ऑपरेशन्स में बदलता है"},"o":[{"en":"Because the CPU can only execute low-level machine instructions, so a translator or runtime must convert the source code into executable machine operations","hi":"क्योंकि CPU केवल मशीन निर्देशों को ही एक्जीक्यूट करता है; ट्रांसलेटर या रनटाइम सोर्स कोड को एक्जीक्यूटेबल ऑपरेशन्स में बदलता है"},{"en":"Because high-level code is written on paper and must be scanned by an OMR reader","hi":"क्योंकि हाई-लेवल कोड कागज पर लिखा जाता है और इसे OMR रीडर द्वारा स्कैन किया जाना चाहिए"},{"en":"Because translators cool down the RAM modules during execution","hi":"क्योंकि ट्रांसलेटर निष्पादन के दौरान RAM मॉड्यूल को ठंडा करते हैं"},{"en":"Because the monitor cannot display English letters without a compiler","hi":"क्योंकि कंपाइलर के बिना मॉनिटर अंग्रेजी अक्षर नहीं दिखा सकता"}],"exp":{"en":"A computer's CPU natively understands and executes only binary machine instructions. Therefore, high-level source code must be translated by a compiler or executed via an interpreter/runtime into machine-level operations.","hi":"क्योंकि CPU सीधे केवल मशीन निर्देशों (machine instructions) को ही निष्पादित (execute) कर सकता है, इसलिए सोर्स कोड को एक्जीक्यूटेबल मशीन ऑपरेशन्स में बदलने के लिए ट्रांसलेटर या रनटाइम की आवश्यकता होती है।"},"num":19},{"id":"q20","q":{"en":"What is 'Source Code'?","hi":"'सोर्स कोड' (Source Code) क्या होता है?"},"a":{"en":"The original program written by a programmer in a human-readable language such as Assembly or a High-Level Language","hi":"प्रोग्रामर द्वारा लिखा गया मूल प्रोग्राम (जैसे असेंबली या हाई-लेवल भाषा में लिखा कोड)"},"o":[{"en":"The original program written by a programmer in a human-readable language such as Assembly or a High-Level Language","hi":"प्रोग्रामर द्वारा लिखा गया मूल प्रोग्राम (जैसे असेंबली या हाई-लेवल भाषा में लिखा कोड)"},{"en":"The barcode sticker pasted on the back of a computer cabinet","hi":"कंप्यूटर कैबिनेट के पीछे चिपकाया गया बारकोड स्टिकर"},{"en":"The electrical voltage signal coming from the SMPS power supply","hi":"SMPS पावर सप्लाई से आने वाला विद्युत वोल्टेज सिग्नल"},{"en":"A deleted file sitting inside the Windows Recycle Bin","hi":"विंडोज़ रीसायकल बिन के अंदर पड़ी एक डिलीट की गई फ़ाइल"}],"exp":{"en":"Source code is the original, human-readable program text written by a programmer in a programming language (such as C, Python, Java, or Assembly) before it is translated into machine code.","hi":"प्रोग्रामर द्वारा किसी प्रोग्रामिंग भाषा (जैसे हाई-लेवल या असेंबली भाषा) में लिखे गए मूल प्रोग्राम (original program) को 'सोर्स कोड' कहा जाता है।"},"num":20},{"id":"q21","q":{"en":"Which of the following are the three main types of Language Translators?","hi":"तीन मुख्य लैंग्वेज ट्रांसलेटर (Language Translators) कौन-से हैं?"},"a":{"en":"Assembler, Compiler, and Interpreter","hi":"असेंबलर (Assembler), कंपाइलर (Compiler) और इंटरप्रेटर (Interpreter)"},"o":[{"en":"Assembler, Compiler, and Interpreter","hi":"असेंबलर (Assembler), कंपाइलर (Compiler) और इंटरप्रेटर (Interpreter)"},{"en":"Loader, Linker, and Spooler","hi":"लोडर, लिंकर और स्पूलर"},{"en":"Browser, Search Engine, and Firewall","hi":"ब्राउज़र, सर्च इंजन और फ़ायरवॉल"},{"en":"Scanner, Plotter, and Projector","hi":"स्कैनर, प्लॉटर और प्रोजेक्टर"}],"exp":{"en":"The three primary language translators in system/programming software are the Assembler, the Compiler, and the Interpreter.","hi":"तीन मुख्य लैंग्वेज ट्रांसलेटर हैं: असेंबलर (Assembler), कंपाइलर (Compiler) और इंटरप्रेटर (Interpreter)।"},"num":21},{"id":"q22","q":{"en":"What does an 'Assembler' translate?","hi":"'असेंबलर' (Assembler) किसका अनुवाद (Translate) करता है?"},"a":{"en":"It translates Assembly language source code into machine code or object code","hi":"यह असेंबली भाषा (Assembly language) को मशीन कोड या ऑब्जेक्ट कोड में बदलता है"},"o":[{"en":"It translates Assembly language source code into machine code or object code","hi":"यह असेंबली भाषा (Assembly language) को मशीन कोड या ऑब्जेक्ट कोड में बदलता है"},{"en":"It translates binary machine code into Python scripts","hi":"यह बाइनरी मशीन कोड को पायथन स्क्रिप्ट में बदलता है"},{"en":"It translates spoken voice commands into printed Braille pages","hi":"यह बोले गए वॉयस कमांड को मुद्रित ब्रेल पृष्ठों में बदलता है"},{"en":"It translates HTML web pages into relational database tables","hi":"यह HTML वेब पेजों को रिलेशनल डेटाबेस तालिकाओं में बदलता है"}],"exp":{"en":"An assembler is a translator that converts programs written in low-level Assembly language (symbolic mnemonics) into machine code or relocatable object code.","hi":"असेंबलर का कार्य असेंबली भाषा (Assembly language) में लिखे कोड को मशीन कोड (machine code) या ऑब्जेक्ट कोड (object code) में ट्रांसलेट करना है।"},"num":22},{"id":"q23","q":{"en":"What is the primary function of a 'Compiler'?","hi":"'कंपाइलर' (Compiler) का मुख्य कार्य क्या है?"},"a":{"en":"To translate high-level source code ahead of execution into a target form such as native machine code, object code, or bytecode","hi":"सोर्स कोड को किसी टारगेट फॉर्म—जैसे मशीन कोड, ऑब्जेक्ट कोड या बाइटकोड—में ट्रांसलेट करना"},"o":[{"en":"To translate high-level source code ahead of execution into a target form such as native machine code, object code, or bytecode","hi":"सोर्स कोड को किसी टारगेट फॉर्म—जैसे मशीन कोड, ऑब्जेक्ट कोड या बाइटकोड—में ट्रांसलेट करना"},{"en":"To physically assemble silicon transistors onto a motherboard","hi":"मदरबोर्ड पर सिलिकॉन ट्रांजिस्टर को भौतिक रूप से जोड़ना"},{"en":"To scan paper documents and save them as BMP images","hi":"कागजी दस्तावेज़ों को स्कैन करना और उन्हें BMP इमेज के रूप में सहेजना"},{"en":"To manage battery charging in a laptop UPS","hi":"लैपटॉप यूपीएस में बैटरी चार्जिंग का प्रबंधन करना"}],"exp":{"en":"A compiler translates an entire high-level language source program into a target low-level form—such as native machine code, object code, or intermediate bytecode—before the program is executed.","hi":"कंपाइलर का मुख्य कार्य हाई-लेवल सोर्स कोड को किसी टारगेट रूप—जैसे मशीन कोड (machine code), ऑब्जेक्ट कोड (object code) या बाइटकोड (bytecode)—में ट्रांसलेट करना है।"},"num":23},{"id":"q24","q":{"en":"What is the primary function of an 'Interpreter'?","hi":"'इंटरप्रेटर' (Interpreter) का मुख्य कार्य क्या है?"},"a":{"en":"To evaluate and execute a program directly at runtime (in exam shorthand, called statement-by-statement or line-by-line execution)","hi":"प्रोग्राम को रनटाइम पर मूल्यांकन और निष्पादित (execute) करना (परीक्षा की भाषा में इसे स्टेटमेंट-बाय-स्टेटमेंट निष्पादन कहते हैं)"},"o":[{"en":"To evaluate and execute a program directly at runtime (in exam shorthand, called statement-by-statement or line-by-line execution)","hi":"प्रोग्राम को रनटाइम पर मूल्यांकन और निष्पादित (execute) करना (परीक्षा की भाषा में इसे स्टेटमेंट-बाय-स्टेटमेंट निष्पादन कहते हैं)"},{"en":"To convert assembly mnemonics into punched card holes","hi":"असेंबली निमोनिक्स को पंच कार्ड के छेदों में बदलना"},{"en":"To defragment sectors on a magnetic hard disk drive","hi":"मैग्नेटिक हार्ड डिस्क ड्राइव पर सेक्टर्स को डीफ्रैगमेंट करना"},{"en":"To compress video files into GIF animations","hi":"वीडियो फ़ाइलों को GIF एनीमेशन में संपीड़ित करना"}],"exp":{"en":"An interpreter reads, evaluates, and executes source code (or bytecode) directly at runtime without producing a standalone native machine-code executable beforehand—commonly described in exams as statement-by-statement (or line-by-line) execution.","hi":"इंटरप्रेटर प्रोग्राम को रनटाइम (runtime) पर सीधे पढ़कर मूल्यांकन और निष्पादित (evaluate and execute) करता है। परीक्षा शब्दावली में इसे 'स्टेटमेंट-बाय-स्टेटमेंट' (या लाइन-बाय-लाइन) निष्पादन कहा जाता है।"},"num":24},{"id":"q25","q":{"en":"Can both a Compiler and an Interpreter be used together in the same programming language implementation?","hi":"क्या एक ही प्रोग्रामिंग भाषा के इम्प्लीमेंटेशन (Implementation) में कंपाइलर और इंटरप्रेटर दोनों का उपयोग हो सकता है?"},"a":{"en":"Yes — source code can first be compiled into intermediate bytecode, and the runtime environment can then interpret or JIT-compile that bytecode (e.g., Java, Python)","hi":"हाँ — सोर्स कोड पहले बाइटकोड में कंपाइल हो सकता है, और फिर रनटाइम उस बाइटकोड को इंटरप्रेट या JIT-कंपाइल कर सकता है"},"o":[{"en":"No — a language must strictly use either a hardware assembler or nothing at all","hi":"नहीं — किसी भाषा को या तो केवल हार्डवेयर असेंबलर का उपयोग करना चाहिए या किसी का भी नहीं"},{"en":"Yes — source code can first be compiled into intermediate bytecode, and the runtime environment can then interpret or JIT-compile that bytecode (e.g., Java, Python)","hi":"हाँ — सोर्स कोड पहले बाइटकोड में कंपाइल हो सकता है, और फिर रनटाइम उस बाइटकोड को इंटरप्रेट या JIT-कंपाइल कर सकता है"},{"en":"No — using both together causes an immediate hardware deadlock in the BIOS","hi":"नहीं — दोनों का एक साथ उपयोग करने से BIOS में तुरंत हार्डवेयर डेडलॉक हो जाता है"},{"en":"Yes — but only on first-generation vacuum-tube computers","hi":"हाँ — लेकिन केवल प्रथम पीढ़ी के वैक्यूम-ट्यूब कंप्यूटरों पर"}],"exp":{"en":"Yes, modern language implementations (such as Java and standard CPython) often combine both approaches: the source code is first compiled into platform-independent intermediate bytecode, and the virtual machine/runtime then interprets or Just-In-Time (JIT) compiles that bytecode.","hi":"हाँ, बिल्कुल। आधुनिक भाषाओं (जैसे Java या Python) में सोर्स कोड पहले इंटरमीडिएट 'बाइटकोड' (bytecode) में कंपाइल हो सकता है, और फिर रनटाइम (वर्चुअल मशीन) उस बाइटकोड को इंटरप्रेट या JIT-कंपाइल करके चलाता है।"},"num":25}]},{"title":{"en":"3. Application Software & Common Examples","hi":"3. एप्लिकेशन सॉफ्टवेयर और सामान्य उदाहरण"},"questions":[{"id":"q26","q":{"en":"What is the primary purpose of 'Application Software'?","hi":"'एप्लिकेशन सॉफ्टवेयर' (Application Software) का मुख्य कार्य क्या है?"},"a":{"en":"To perform specific end-user tasks such as writing letters, listening to music, watching videos, or managing records","hi":"यूज़र के विशिष्ट कार्य (specific tasks) पूरा करना, जैसे पत्र लिखना, संगीत सुनना, वीडियो देखना या रिकॉर्ड मैनेज करना"},"o":[{"en":"To perform specific end-user tasks such as writing letters, listening to music, watching videos, or managing records","hi":"यूज़र के विशिष्ट कार्य (specific tasks) पूरा करना, जैसे पत्र लिखना, संगीत सुनना, वीडियो देखना या रिकॉर्ड मैनेज करना"},{"en":"To allocate CPU time slices and manage kernel page tables","hi":"CPU टाइम स्लाइस आवंटित करना और कर्नेल पेज टेबल प्रबंधित करना"},{"en":"To initialize motherboard hardware during the power-on self-test (POST)","hi":"पावर-ऑन सेल्फ-टेस्ट (POST) के दौरान मदरबोर्ड हार्डवेयर को इनिशियलाइज़ करना"},{"en":"To convert AC mains voltage into DC voltage for the processor","hi":"प्रोसेसर के लिए एसी मेन वोल्टेज को डीसी वोल्टेज में बदलना"}],"exp":{"en":"Application software (apps) is designed to help the human user perform specific, productive, or entertainment tasks—such as word processing, spreadsheet analysis, media playback, web browsing, or database record management.","hi":"एप्लिकेशन सॉफ्टवेयर उपयोगकर्ता के विशिष्ट कार्यों (specific tasks)—जैसे पत्र लिखना, संगीत सुनना, वीडियो देखना, फोटो एडिट करना या रिकॉर्ड्स मैनेज करना—को पूरा करने के लिए बनाया जाता है।"},"num":26},{"id":"q27","q":{"en":"What are the two main types of Application Software classified in the chapter?","hi":"अध्याय में एप्लिकेशन सॉफ्टवेयर के कौन-से दो मुख्य प्रकार बताए गए हैं?"},"a":{"en":"General-purpose software and Customised (tailor-made) software","hi":"जनरल-पर्पस (सामान्य-उद्देश्य) सॉफ्टवेयर और कस्टमाइज्ड (अनुकूलित) सॉफ्टवेयर"},"o":[{"en":"Compiler software and Assembler software","hi":"कंपाइलर सॉफ्टवेयर और असेंबलर सॉफ्टवेयर"},{"en":"General-purpose software and Customised (tailor-made) software","hi":"जनरल-पर्पस (सामान्य-उद्देश्य) सॉफ्टवेयर और कस्टमाइज्ड (अनुकूलित) सॉफ्टवेयर"},{"en":"Firmware and Device Drivers","hi":"फर्मवेयर और डिवाइस ड्राइवर"},{"en":"CLI software and BIOS software","hi":"CLI सॉफ्टवेयर और BIOS सॉफ्टवेयर"}],"exp":{"en":"Application software is divided into two main types: General-Purpose application software (off-the-shelf apps for broad audiences) and Customised/Bespoke application software (tailored for a specific organization or workflow).","hi":"एप्लिकेशन सॉफ्टवेयर के दो मुख्य प्रकार हैं: जनरल-पर्पस सॉफ्टवेयर (General-purpose software) और कस्टमाइज्ड सॉफ्टवेयर (Customised software)।"},"num":27},{"id":"q28","q":{"en":"What is 'General-Purpose Software', and which of the following are its examples?","hi":"'जनरल-पर्पस सॉफ्टवेयर' (General-Purpose Software) क्या होता है और इसके उदाहरण कौन-से हैं?"},"a":{"en":"Software built for common tasks that can be used by a wide variety of users; examples include Adobe Photoshop, Mozilla Firefox, and LibreOffice Calc","hi":"सामान्य कार्यों के लिए बना सॉफ्टवेयर जिसे बहुत सारे यूज़र्स उपयोग कर सकते हैं; जैसे Photoshop, Firefox और Calc"},"o":[{"en":"Software built for common tasks that can be used by a wide variety of users; examples include Adobe Photoshop, Mozilla Firefox, and LibreOffice Calc","hi":"सामान्य कार्यों के लिए बना सॉफ्टवेयर जिसे बहुत सारे यूज़र्स उपयोग कर सकते हैं; जैसे Photoshop, Firefox और Calc"},{"en":"Software written exclusively for a single school's internal attendance portal","hi":"केवल एक स्कूल के आंतरिक उपस्थिति पोर्टल के लिए लिखा गया सॉफ्टवेयर"},{"en":"Embedded microcode inside a car's airbag sensor","hi":"कार के एयरबैग सेंसर के अंदर का एम्बेडेड माइक्रोकोड"},{"en":"Hardware logic gates etched into a silicon wafer","hi":"सिलिकॉन वेफर में उकेरे गए हार्डवेयर लॉजिक गेट्स"}],"exp":{"en":"General-purpose application software is standard, off-the-shelf software created to handle common tasks for millions of users across different fields. Examples in the notes include Adobe Photoshop, Mozilla Firefox, and Calc.","hi":"सामान्य कार्यों (common tasks) के लिए बना वह सॉफ्टवेयर जिसे आम तौर पर बहुत सारे उपयोगकर्ता इस्तेमाल कर सकते हैं, जनरल-पर्पस सॉफ्टवेयर कहलाता है। Photoshop, Firefox और Calc इसके उदाहरण हैं।"},"num":28},{"id":"q29","q":{"en":"What is 'Customised Software', and what are its examples?","hi":"'कस्टमाइज्ड सॉफ्टवेयर' (Customised Software) क्या होता है और इसके उदाहरण क्या हैं?"},"a":{"en":"Software developed or adapted according to the specific requirements of a particular organization or workflow, such as a school management system or a dedicated learning website","hi":"किसी संस्था या वर्कफ़्लो की विशेष आवश्यकता के हिसाब से बना या ढाला गया सॉफ्टवेयर, जैसे स्कूल मैनेजमेंट सिस्टम या समर्पित लर्निंग वेबसाइट"},"o":[{"en":"A standard web browser pre-installed on every smartphone","hi":"हर स्मार्टफोन में पहले से इंस्टॉल आने वाला एक मानक वेब ब्राउज़र"},{"en":"Software developed or adapted according to the specific requirements of a particular organization or workflow, such as a school management system or a dedicated learning website","hi":"किसी संस्था या वर्कफ़्लो की विशेष आवश्यकता के हिसाब से बना या ढाला गया सॉफ्टवेयर, जैसे स्कूल मैनेजमेंट सिस्टम या समर्पित लर्निंग वेबसाइट"},{"en":"The basic input/output firmware stored on a motherboard ROM chip","hi":"मदरबोर्ड ROM चिप पर संग्रहीत बेसिक इनपुट/आउटपुट फर्मवेयर"},{"en":"A universal file compression utility like WinZip","hi":"WinZip जैसी एक सार्वभौमिक फ़ाइल संपीड़न यूटिलिटी"}],"exp":{"en":"Customised (or bespoke/tailor-made) software is specially designed or configured to meet the unique operational requirements of a specific organization, business, or workflow—such as a custom school management system, hospital billing portal, or dedicated learning website.","hi":"किसी संस्था (organization) या कार्यप्रणाली (workflow) की विशिष्ट आवश्यकताओं के अनुसार विशेष रूप से बनाए या ढाले गए सॉफ्टवेयर को 'कस्टमाइज्ड सॉफ्टवेयर' कहते हैं, जैसे स्कूल मैनेजमेंट सिस्टम या कोई समर्पित लर्निंग वेबसाइट।"},"num":29},{"id":"q30","q":{"en":"What is a 'Word Processor' used for, and which of the following are its examples?","hi":"'वर्ड प्रोसेसर' (Word Processor) का उपयोग क्या है और इसके उदाहरण कौन-से हैं?"},"a":{"en":"Writing, editing, and formatting text documents; examples include MS Word, WordPad, WordStar, WordPerfect, and Google Docs","hi":"टेक्स्ट दस्तावेज़ लिखने, एडिट और फ़ॉर्मेट करने के लिए; उदाहरण: MS Word, WordPad, WordStar, WordPerfect और Google Docs"},"o":[{"en":"Writing, editing, and formatting text documents; examples include MS Word, WordPad, WordStar, WordPerfect, and Google Docs","hi":"टेक्स्ट दस्तावेज़ लिखने, एडिट और फ़ॉर्मेट करने के लिए; उदाहरण: MS Word, WordPad, WordStar, WordPerfect और Google Docs"},{"en":"Editing 3D character skeletons and animations; examples: Maya and Blender","hi":"3D कैरेक्टर एनीमेशन एडिट करने के लिए; उदाहरण: Maya और Blender"},{"en":"Scanning viruses and trojans from boot sectors; example: Quick Heal","hi":"बूट सेक्टर से वायरस स्कैन करने के लिए; उदाहरण: Quick Heal"},{"en":"Managing network packet routing across WAN links; example: Cisco IOS","hi":"WAN लिंक पर नेटवर्क पैकेट रूटिंग प्रबंधित करने के लिए"}],"exp":{"en":"A word processor is application software used for composing, editing, formatting, and printing text documents. Classic and modern examples listed in the chapter are Microsoft Word, WordPad, WordStar, WordPerfect, and Google Docs.","hi":"वर्ड प्रोसेसर का उपयोग टेक्स्ट डॉक्यूमेंट्स लिखने, एडिट करने और फ़ॉर्मेट करने के लिए होता है। MS Word, WordPad, WordStar, WordPerfect और Google Docs इसके प्रमुख उदाहरण हैं।"},"num":30},{"id":"q31","q":{"en":"What is the primary use of 'Database Software', and which of the following are its examples?","hi":"'डेटाबेस सॉफ्टवेयर' (Database Software) का उपयोग और इसके उदाहरण क्या हैं?"},"a":{"en":"Storing, querying, and managing structured records; examples include MS Access, FileMaker, dBASE, MySQL, and FoxPro","hi":"संरचित रिकॉर्ड्स (structured records) को स्टोर, क्वेरी और मैनेज करना; उदाहरण: MS Access, FileMaker, dBASE, MySQL और FoxPro"},"o":[{"en":"Storing, querying, and managing structured records; examples include MS Access, FileMaker, dBASE, MySQL, and FoxPro","hi":"संरचित रिकॉर्ड्स (structured records) को स्टोर, क्वेरी और मैनेज करना; उदाहरण: MS Access, FileMaker, dBASE, MySQL और FoxPro"},{"en":"Playing high-definition MKV video files; examples: VLC and Windows Media Player","hi":"हाई-डेफिनिशन वीडियो फ़ाइलें चलाना; उदाहरण: VLC और Windows Media Player"},{"en":"Designing vector logos and brochures; example: CorelDRAW","hi":"वेक्टर लोगो और ब्रोशर डिज़ाइन करना; उदाहरण: CorelDRAW"},{"en":"Translating assembly language into object code; example: MASM","hi":"असेंबली भाषा को ऑब्जेक्ट कोड में बदलना"}],"exp":{"en":"Database software (DBMS) is used to store, organize, query, update, and manage structured data records. Examples highlighted in the chapter are MS Access, FileMaker, dBASE, MySQL, and FoxPro.","hi":"डेटाबेस सॉफ्टवेयर का उपयोग संरचित रिकॉर्ड्स (structured records) को स्टोर करने, क्वेरी करने और प्रबंधित (manage) करने के लिए होता है। MS Access, FileMaker, dBASE, MySQL और FoxPro इसके उदाहरण हैं।"},"num":31},{"id":"q32","q":{"en":"In which context does the chapter list 'Clipper', and what was it historically?","hi":"अध्याय में 'क्लिपर' (Clipper) को किस संदर्भ में सूचीबद्ध किया गया है और ऐतिहासिक रूप से यह क्या था?"},"a":{"en":"Listed in the Database applications section; Clipper was a programming language and compiler used to build xBase/dBASE database applications","hi":"डेटाबेस एप्लिकेशन के सेक्शन में; Clipper xBase डेटाबेस एप्लिकेशन बनाने की एक प्रोग्रामिंग भाषा और कंपाइलर था"},"o":[{"en":"Listed in the Database applications section; Clipper was a programming language and compiler used to build xBase/dBASE database applications","hi":"डेटाबेस एप्लिकेशन के सेक्शन में; Clipper xBase डेटाबेस एप्लिकेशन बनाने की एक प्रोग्रामिंग भाषा और कंपाइलर था"},{"en":"Listed under Web Browsers; it was Apple's default browser before Safari","hi":"वेब ब्राउज़र के अंतर्गत; यह सफारी से पहले एप्पल का डिफ़ॉल्ट ब्राउज़र था"},{"en":"Listed under Audio Players; it was a hardware MP3 player","hi":"ऑडियो प्लेयर के अंतर्गत; यह एक हार्डवेयर MP3 प्लेयर था"},{"en":"Listed under Mobile Operating Systems; it was used on Nokia phones","hi":"मोबाइल ऑपरेटिंग सिस्टम के अंतर्गत; यह नोकिया फोन पर प्रयुक्त होता था"}],"exp":{"en":"The chapter lists Clipper under the database software section. Historically, Clipper was a popular xBase programming language and compiler used to build compiled business database applications (originally for dBASE III databases under MS-DOS).","hi":"अध्याय में Clipper को डेटाबेस एप्लिकेशन के सेक्शन में सूचीबद्ध किया गया है। ऐतिहासिक रूप से Clipper, xBase/dBASE डेटाबेस एप्लिकेशन बनाने के लिए प्रयुक्त एक प्रसिद्ध प्रोग्रामिंग भाषा और कंपाइलर था।"},"num":32},{"id":"q33","q":{"en":"What is a 'Web Browser' used for, and which of the following are its examples?","hi":"'वेब ब्राउज़र' (Web Browser) का उपयोग और इसके उदाहरण क्या हैं?"},"a":{"en":"Accessing, retrieving, and displaying web pages on the World Wide Web; examples include Chrome, Firefox, Opera, Edge, Safari, Brave, Tor Browser, and legacy Internet Explorer","hi":"वेब पेजों को एक्सेस और डिस्प्ले करना; उदाहरण: Chrome, Firefox, Opera, Edge, Safari, Brave, Tor Browser और Internet Explorer"},"o":[{"en":"Accessing, retrieving, and displaying web pages on the World Wide Web; examples include Chrome, Firefox, Opera, Edge, Safari, Brave, Tor Browser, and legacy Internet Explorer","hi":"वेब पेजों को एक्सेस और डिस्प्ले करना; उदाहरण: Chrome, Firefox, Opera, Edge, Safari, Brave, Tor Browser और Internet Explorer"},{"en":"Creating accounting ledgers and GST invoices; example: Tally","hi":"अकाउंटिंग लेजर और बिल बनाना; उदाहरण: Tally"},{"en":"Formatting hard disk partitions into NTFS; example: Disk Management","hi":"हार्ड डिस्क पार्टीशन को फ़ॉर्मेट करना"},{"en":"Compiling C++ source files into DLL libraries; example: GCC","hi":"C++ सोर्स फ़ाइलों को कंपाइल करना"}],"exp":{"en":"A web browser is an application program used to access, retrieve, and render web pages and web applications. Examples in the chapter are Google Chrome, Mozilla Firefox, Opera, Microsoft Edge, Apple Safari, Brave, Tor Browser, and legacy Internet Explorer.","hi":"वेब ब्राउज़र का उपयोग इंटरनेट पर वेब पेजों को एक्सेस और प्रदर्शित (display) करने के लिए किया जाता है। Chrome, Firefox, Opera, Edge, Safari, Brave, Tor Browser और पुराना Internet Explorer इसके उदाहरण हैं।"},"num":33},{"id":"q34","q":{"en":"Which tools are given in the chapter as examples of photo editing/image management and vector graphics design?","hi":"फोटो एडिटिंग/इमेज मैनेजमेंट और वेक्टर ग्राफिक्स डिज़ाइन के लिए अध्याय में कौन-से उदाहरण दिए गए हैं?"},"a":{"en":"Adobe Photoshop and legacy Picasa for photo editing/image management; CorelDRAW for vector graphics design","hi":"फोटो एडिटिंग/इमेज मैनेजमेंट के लिए Adobe Photoshop और पुराना Picasa; तथा वेक्टर ग्राफिक्स डिज़ाइन के लिए CorelDRAW"},"o":[{"en":"Adobe Photoshop and legacy Picasa for photo editing/image management; CorelDRAW for vector graphics design","hi":"फोटो एडिटिंग/इमेज मैनेजमेंट के लिए Adobe Photoshop और पुराना Picasa; तथा वेक्टर ग्राफिक्स डिज़ाइन के लिए CorelDRAW"},{"en":"MS Access and FoxPro for photo editing; MySQL for vector design","hi":"फोटो एडिटिंग के लिए MS Access और FoxPro; वेक्टर डिज़ाइन के लिए MySQL"},{"en":"WordStar and WordPerfect for image management","hi":"इमेज मैनेजमेंट के लिए WordStar और WordPerfect"},{"en":"Bash and Command Prompt for vector graphics","hi":"वेक्टर ग्राफिक्स के लिए Bash और Command Prompt"}],"exp":{"en":"For raster photo editing and image management, the chapter cites Adobe Photoshop and Google's legacy Picasa; for vector graphics illustration and page design, it cites CorelDRAW.","hi":"फोटो एडिटिंग या इमेज मैनेजमेंट के लिए अध्याय में Adobe Photoshop और पुराने Picasa का उदाहरण दिया गया है, जबकि वेक्टर ग्राफिक्स डिज़ाइन (vector graphics design) के लिए CorelDRAW का उपयोग होता है।"},"num":34},{"id":"q35","q":{"en":"Which of the following are standard examples of Audio and Video Playback (multimedia player) software?","hi":"ऑडियो और वीडियो प्लेबैक (Multimedia Playback) सॉफ्टवेयर के उदाहरण कौन-से हैं?"},"a":{"en":"VLC Media Player and Windows Media Player","hi":"VLC Media Player और Windows Media Player"},"o":[{"en":"VLC Media Player and Windows Media Player","hi":"VLC Media Player और Windows Media Player"},{"en":"Lotus 1-2-3 and LibreOffice Calc","hi":"Lotus 1-2-3 और LibreOffice Calc"},{"en":"dBASE and FileMaker","hi":"dBASE और FileMaker"},{"en":"Oracle Solaris and Xenix","hi":"Oracle Solaris और Xenix"}],"exp":{"en":"VLC Media Player and Windows Media Player are standard multimedia application programs used for audio and video playback.","hi":"ऑडियो और वीडियो प्लेबैक (मल्टीमीडिया चलाने) के प्रमुख उदाहरण VLC Media Player और Windows Media Player हैं।"},"num":35},{"id":"q36","q":{"en":"Which software packages are listed in the chapter as examples of 3D Modelling and Animation?","hi":"3D मॉडलिंग और एनीमेशन (3D Modelling and Animation) के उदाहरण के रूप में अध्याय में कौन-से सॉफ्टवेयर दिए गए हैं?"},"a":{"en":"Autodesk Maya and Blender","hi":"ऑटोडेस्क माया (Autodesk Maya) और ब्लेंडर (Blender)"},"o":[{"en":"Autodesk Maya and Blender","hi":"ऑटोडेस्क माया (Autodesk Maya) और ब्लेंडर (Blender)"},{"en":"MS Outlook and Thunderbird","hi":"MS Outlook और Thunderbird"},{"en":"WordPad and Notepad","hi":"WordPad और Notepad"},{"en":"Norton and McAfee","hi":"Norton और McAfee"}],"exp":{"en":"Autodesk Maya (proprietary industry-standard 3D tool) and Blender (free and open-source 3D creation suite) are the chapter's examples for 3D modelling, rendering, and computer animation.","hi":"3D मॉडलिंग और एनीमेशन तैयार करने वाले सॉफ्टवेयर के प्रमुख उदाहरण Autodesk Maya और Blender हैं।"},"num":36},{"id":"q37","q":{"en":"What are the respective uses of 'Avid Media Composer' and 'Adobe After Effects'?","hi":"'Avid Media Composer' और 'Adobe After Effects' के क्रमशः उपयोग क्या हैं?"},"a":{"en":"Avid Media Composer is used for professional video/film editing, and Adobe After Effects is used for visual effects compositing and motion graphics","hi":"Avid Media Composer वीडियो एडिटिंग के लिए और Adobe After Effects कम्पोज़िटिंग व मोशन ग्राफिक्स के लिए प्रयुक्त होता है"},"o":[{"en":"Avid Media Composer is used for professional video/film editing, and Adobe After Effects is used for visual effects compositing and motion graphics","hi":"Avid Media Composer वीडियो एडिटिंग के लिए और Adobe After Effects कम्पोज़िटिंग व मोशन ग्राफिक्स के लिए प्रयुक्त होता है"},{"en":"Both are antivirus utilities used to format USB pen drives","hi":"दोनों USB पेन ड्राइव को फ़ॉर्मेट करने के लिए प्रयुक्त एंटीवायरस यूटिलिटीज़ हैं"},{"en":"Avid Media Composer is a web browser, and After Effects is a spreadsheet","hi":"Avid Media Composer एक वेब ब्राउज़र है, और After Effects एक स्प्रेडशीट है"},{"en":"Both are low-level assemblers for 8-bit microprocessors","hi":"दोनों 8-बिट माइक्रोप्रोसेसरों के लिए लो-लेवल असेंबलर हैं"}],"exp":{"en":"Avid Media Composer is a professional non-linear video and film editing application, whereas Adobe After Effects is used for digital visual effects (VFX), compositing, and motion graphics.","hi":"Avid Media Composer का उपयोग प्रोफेशनल वीडियो एडिटिंग (video editing) के लिए और Adobe After Effects का उपयोग विजुअल इफेक्ट्स कम्पोज़िटिंग तथा मोशन ग्राफिक्स (motion graphics) के लिए किया जाता है।"},"num":37},{"id":"q38","q":{"en":"Match Microsoft Outlook, Microsoft PowerPoint, and Microsoft Excel with their correct application categories:","hi":"MS Outlook, MS PowerPoint और MS Excel को उनकी सही एप्लिकेशन श्रेणी से सुमेलित (Match) कीजिए:"},"a":{"en":"Outlook → Email client / PIM; PowerPoint → Presentation software; Excel → Spreadsheet software","hi":"Outlook → ईमेल क्लाइंट; PowerPoint → प्रेजेंटेशन; Excel → स्प्रेडशीट"},"o":[{"en":"Outlook → Email client / PIM; PowerPoint → Presentation software; Excel → Spreadsheet software","hi":"Outlook → ईमेल क्लाइंट; PowerPoint → प्रेजेंटेशन; Excel → स्प्रेडशीट"},{"en":"Outlook → Spreadsheet; PowerPoint → Database; Excel → Email client","hi":"Outlook → स्प्रेडशीट; PowerPoint → डेटाबेस; Excel → ईमेल क्लाइंट"},{"en":"Outlook → Web browser; PowerPoint → Antivirus; Excel → Word processor","hi":"Outlook → वेब ब्राउज़र; PowerPoint → एंटीवायरस; Excel → वर्ड प्रोसेसर"},{"en":"Outlook → 3D animation; PowerPoint → Compiler; Excel → Device driver","hi":"Outlook → 3D एनीमेशन; PowerPoint → कंपाइलर; Excel → डिवाइस ड्राइवर"}],"exp":{"en":"In the Microsoft Office suite: MS Outlook is an email client and personal information manager, MS PowerPoint is presentation software, and MS Excel is spreadsheet software.","hi":"सही मिलान: MS Outlook → ईमेल क्लाइंट (email client); MS PowerPoint → प्रेजेंटेशन सॉफ्टवेयर (presentation); MS Excel → स्प्रेडशीट सॉफ्टवेयर (spreadsheet)।"},"num":38},{"id":"q39","q":{"en":"Lotus 1-2-3 and LibreOffice Calc belong to which category of application software?","hi":"'Lotus 1-2-3' और 'Calc' किस एप्लिकेशन सॉफ्टवेयर श्रेणी में आते हैं?"},"a":{"en":"Spreadsheet software","hi":"स्प्रेडशीट सॉफ्टवेयर (Spreadsheet software)"},"o":[{"en":"Spreadsheet software","hi":"स्प्रेडशीट सॉफ्टवेयर (Spreadsheet software)"},{"en":"Voice-based operating systems","hi":"वॉयस-आधारित ऑपरेटिंग सिस्टम"},{"en":"Relational database servers","hi":"रिलेशनल डेटाबेस सर्वर"},{"en":"Desktop publishing (DTP) page layout tools","hi":"डेस्कटॉप पब्लिशिंग टूल"}],"exp":{"en":"Both historical Lotus 1-2-3 and open-source LibreOffice/OpenOffice Calc are classic examples of Spreadsheet software.","hi":"Lotus 1-2-3 और LibreOffice Calc दोनों 'स्प्रेडशीट सॉफ्टवेयर' (Spreadsheet software) की श्रेणी में आते हैं।"},"num":39},{"id":"q40","q":{"en":"What is the basic functional difference between a Spreadsheet, Presentation software, and Database software?","hi":"स्प्रेडशीट (Spreadsheet), प्रेजेंटेशन (Presentation) और डेटाबेस (Database) सॉफ्टवेयर में बुनियादी अंतर क्या है?"},"a":{"en":"A spreadsheet works on tabular cells and formulas for calculations, presentation software creates visual slide shows, and a database manages structured records and queries","hi":"स्प्रेडशीट सेल्स और फॉर्मूलों पर काम करता है, प्रेजेंटेशन स्लाइड्स बनाती है, और डेटाबेस संरचित रिकॉर्ड्स व क्वेरीज़ मैनेज करता है"},"o":[{"en":"A spreadsheet works on tabular cells and formulas for calculations, presentation software creates visual slide shows, and a database manages structured records and queries","hi":"स्प्रेडशीट सेल्स और फॉर्मूलों पर काम करता है, प्रेजेंटेशन स्लाइड्स बनाती है, और डेटाबेस संरचित रिकॉर्ड्स व क्वेरीज़ मैनेज करता है"},{"en":"A spreadsheet creates slides, presentation software executes SQL queries, and a database edits 3D animations","hi":"स्प्रेडशीट स्लाइड बनाती है, प्रेजेंटेशन SQL क्वेरी चलाती है, और डेटाबेस 3D एनीमेशन एडिट करता है"},{"en":"All three are system device drivers used only for printing hard copies","hi":"तीनों सिस्टम डिवाइस ड्राइवर हैं जिनका उपयोग केवल हार्ड कॉपी प्रिंट करने के लिए होता है"},{"en":"A spreadsheet is hardware, presentation software is firmware, and a database is a CPU register","hi":"स्प्रेडशीट हार्डवेयर है, प्रेजेंटेशन फर्मवेयर है, और डेटाबेस एक CPU रजिस्टर है"}],"exp":{"en":"Exam distinction: Spreadsheet software (Excel, Calc) organizes data in rows/columns of cells and performs calculations using formulas; Presentation software (PowerPoint, Impress) creates visual slide decks for audiences; Database software (Access, MySQL) stores and queries large volumes of structured, interrelated records.","hi":"बुनियादी अंतर: स्प्रेडशीट सॉफ्टवेयर सेल्स (cells) और फॉर्मूलों की मदद से गणनाओं पर काम करता है; प्रेजेंटेशन सॉफ्टवेयर प्रदर्शन के लिए स्लाइड्स (slides) बनाता है; और डेटाबेस सॉफ्टवेयर संरचित रिकॉर्ड्स (structured records) तथा क्वेरीज़ को मैनेज करता है।"},"num":40}]},{"title":{"en":"4. Firmware, Freeware, FOSS & Proprietary Software","hi":"4. फर्मवेयर, फ्रीवेयर, FOSS और प्रोप्राइटरी सॉफ्टवेयर"},"questions":[{"id":"q41","q":{"en":"What is 'Firmware' in a computer or electronic device?","hi":"'फर्मवेयर' (Firmware) क्या होता है?"},"a":{"en":"Embedded software that controls the basic low-level functions of a hardware device and resides in ROM or non-volatile flash memory","hi":"डिवाइस के बुनियादी कार्यों (basic functions) को नियंत्रित करने वाला एम्बेडेड सॉफ्टवेयर, जो ROM या नॉन-वोलेटाइल फ्लैश मेमोरी में रहता है"},"o":[{"en":"A temporary text file created in Notepad that is deleted on shutdown","hi":"नोटपैड में बनाई गई एक अस्थायी टेक्स्ट फ़ाइल जो शटडाउन पर मिट जाती है"},{"en":"Embedded software that controls the basic low-level functions of a hardware device and resides in ROM or non-volatile flash memory","hi":"डिवाइस के बुनियादी कार्यों (basic functions) को नियंत्रित करने वाला एम्बेडेड सॉफ्टवेयर, जो ROM या नॉन-वोलेटाइल फ्लैश मेमोरी में रहता है"},{"en":"An external metal stand used to keep a laptop firm on a desk","hi":"लैपटॉप को मेज पर स्थिर रखने के लिए प्रयुक्त एक बाहरी धातु स्टैंड"},{"en":"A high-level database query written in SQL","hi":"SQL में लिखी गई एक उच्च-स्तरीय डेटाबेस क्वेरी"}],"exp":{"en":"Firmware is low-level embedded software programmed into non-volatile memory (such as ROM, EPROM, EEPROM, or flash memory) that controls the basic initialization and operation of a hardware device.","hi":"फर्मवेयर वह एम्बेडेड सॉफ्टवेयर है जो किसी हार्डवेयर डिवाइस के बुनियादी कार्यों (basic functions) को नियंत्रित करता है और ROM या नॉन-वोलेटाइल फ्लैश मेमोरी में स्थायी रूप से रहता है।"},"num":41},{"id":"q42","q":{"en":"What type of software is BIOS, and what is its full form?","hi":"BIOS किस प्रकार का सॉफ्टवेयर है और इसका पूर्ण रूप (Full Form) क्या है?"},"a":{"en":"Boot firmware — Basic Input/Output System","hi":"बूट फर्मवेयर (Boot firmware) — बेसिक इनपुट/आउटपुट सिस्टम (Basic Input/Output System)"},"o":[{"en":"Boot firmware — Basic Input/Output System","hi":"बूट फर्मवेयर (Boot firmware) — बेसिक इनपुट/आउटपुट सिस्टम (Basic Input/Output System)"},{"en":"Spreadsheet application — Binary Integer Operating Sheet","hi":"स्प्रेडशीट एप्लिकेशन — बाइनरी इंटीजर ऑपरेटिंग शीट"},{"en":"Web browser — Broadband Internet Online Service","hi":"वेब ब्राउज़र — ब्रॉडबैंड इंटरनेट ऑनलाइन सर्विस"},{"en":"Vector graphics editor — Bitmap Image Output System","hi":"वेक्टर ग्राफिक्स एडिटर — बिटमैप इमेज आउटपुट सिस्टम"}],"exp":{"en":"BIOS is system boot firmware stored on the motherboard's non-volatile ROM/flash chip, and its full form is Basic Input/Output System.","hi":"BIOS एक बूट फर्मवेयर (boot firmware) है और इसका पूर्ण रूप Basic Input/Output System है।"},"num":42},{"id":"q43","q":{"en":"Can modern Firmware be updated?","hi":"क्या आधुनिक फर्मवेयर (Firmware) को अपडेट किया जा सकता है?"},"a":{"en":"Yes — flash-based firmware (stored in EEPROM/flash memory) can be reprogrammed through a supported firmware update process","hi":"हाँ — फ्लैश-आधारित फर्मवेयर को समर्थित अपडेट प्रक्रिया (update process) से रीप्रोग्राम किया जा सकता है"},"o":[{"en":"No — firmware is carved into stone and can never be changed under any circumstances","hi":"नहीं — फर्मवेयर पत्थर पर उकेरा जाता है और इसे किसी भी परिस्थिति में बदला नहीं जा सकता"},{"en":"Yes — flash-based firmware (stored in EEPROM/flash memory) can be reprogrammed through a supported firmware update process","hi":"हाँ — फ्लैश-आधारित फर्मवेयर को समर्थित अपडेट प्रक्रिया (update process) से रीप्रोग्राम किया जा सकता है"},{"en":"Yes — but only by washing the motherboard with distilled water","hi":"हाँ — लेकिन केवल आसुत जल से मदरबोर्ड को धोकर"},{"en":"No — updating firmware is only possible on mechanical calculators from 1642","hi":"नहीं — फर्मवेयर अपडेट केवल 1642 के यांत्रिक कैलकुलेटरों पर ही संभव है"}],"exp":{"en":"While early mask-ROM firmware could not be altered without replacing the chip, modern firmware is stored in electrically erasable flash memory (EEPROM/flash) and can be updated ('flashed') using a manufacturer-supported update process.","hi":"हाँ, आधुनिक फ्लैश-आधारित फर्मवेयर (जो EEPROM या फ्लैश मेमोरी में रहता है) को समर्थित अपडेट प्रक्रिया के माध्यम से रीप्रोग्राम/अपडेट किया जा सकता है।"},"num":43},{"id":"q44","q":{"en":"What is 'Freeware'?","hi":"'फ्रीवेयर' (Freeware) क्या होता है?"},"a":{"en":"Software available for use free of charge (zero purchase price), while source code access and modification rights depend on the licence (usually closed-source)","hi":"निःशुल्क (free of charge) उपयोग के लिए उपलब्ध सॉफ्टवेयर, जबकि सोर्स कोड और संशोधन के अधिकार लाइसेंस पर निर्भर करते हैं"},"o":[{"en":"Software available for use free of charge (zero purchase price), while source code access and modification rights depend on the licence (usually closed-source)","hi":"निःशुल्क (free of charge) उपयोग के लिए उपलब्ध सॉफ्टवेयर, जबकि सोर्स कोड और संशोधन के अधिकार लाइसेंस पर निर्भर करते हैं"},{"en":"Hardware peripherals given away for free at supermarkets","hi":"सुपरमार्केट में मुफ्त में दिए जाने वाले हार्डवेयर पेरिफेरल्स"},{"en":"Software that requires a monthly subscription fee of $100 but comes with open source code","hi":"वह सॉफ्टवेयर जिसके लिए $100 के मासिक शुल्क की आवश्यकता होती है"},{"en":"Volatile RAM memory that has free unallocated pages","hi":"वोलेटाइल RAM मेमोरी जिसमें मुफ्त अनआवंटित पेज होते हैं"}],"exp":{"en":"Freeware is software distributed at zero monetary cost (free of charge) to the end user. However, unlike open-source software, freeware is typically proprietary/closed-source, and modification or redistribution rights are restricted by the licence.","hi":"फ्रीवेयर वह सॉफ्टवेयर है जो उपयोग के लिए निःशुल्क (free of charge / शून्य कीमत पर) उपलब्ध होता है। इसके सोर्स कोड और संशोधन के अधिकार लाइसेंस पर निर्भर करते हैं (आमतौर पर इसका सोर्स कोड बंद रहता है)।"},"num":44},{"id":"q45","q":{"en":"Which examples of Freeware are given in the chapter?","hi":"अध्याय में फ्रीवेयर (Freeware) के कौन-से उदाहरण दिए गए हैं?"},"a":{"en":"Adobe Reader (Acrobat Reader) and Skype (noted as a historical textbook example)","hi":"Adobe Reader और Skype (यहाँ Skype नोट्स का ऐतिहासिक उदाहरण है)"},"o":[{"en":"Adobe Reader (Acrobat Reader) and Skype (noted as a historical textbook example)","hi":"Adobe Reader और Skype (यहाँ Skype नोट्स का ऐतिहासिक उदाहरण है)"},{"en":"Microsoft Windows 11 Pro and Tally Prime paid editions","hi":"Microsoft Windows 11 Pro और Tally के सशुल्क संस्करण"},{"en":"BIOS and CMOS setup utilities","hi":"BIOS और CMOS सेटअप यूटिलिटीज़"},{"en":"Intel Core i7 and AMD Ryzen microprocessors","hi":"Intel Core i7 और AMD Ryzen माइक्रोप्रोसेसर"}],"exp":{"en":"The chapter lists Adobe Reader (for viewing PDFs) and Skype (a classic textbook example) as examples of Freeware.","hi":"अध्याय में फ्रीवेयर के उदाहरणों के रूप में Adobe Reader और Skype (नोट्स के ऐतिहासिक उदाहरण के रूप में) दिए गए हैं।"},"num":45},{"id":"q46","q":{"en":"What is the full form of FOSS?","hi":"FOSS का पूर्ण रूप (Full Form) क्या है?"},"a":{"en":"Free and Open Source Software","hi":"फ्री एंड ओपन सोर्स सॉफ्टवेयर (Free and Open Source Software)"},"o":[{"en":"Fast Operating System Storage","hi":"फास्ट ऑपरेटिंग सिस्टम स्टोरेज"},{"en":"Free and Open Source Software","hi":"फ्री एंड ओपन सोर्स सॉफ्टवेयर (Free and Open Source Software)"},{"en":"File Organization and System Security","hi":"फ़ाइल ऑर्गेनाइजेशन एंड सिस्टम सिक्योरिटी"},{"en":"Formula Oriented Symbolic Software","hi":"फॉर्मूला ओरिएंटेड सिम्बॉलिक सॉफ्टवेयर"}],"exp":{"en":"FOSS stands for Free and Open Source Software.","hi":"FOSS का पूर्ण रूप Free and Open Source Software है।"},"num":46},{"id":"q47","q":{"en":"What freedoms does a FOSS licence grant to the user?","hi":"FOSS लाइसेंस उपयोगकर्ता (User) को क्या स्वतंत्रताएँ (Freedoms) देता है?"},"a":{"en":"The freedoms to run, study, modify, and redistribute the software under the licence conditions, with accessible source code","hi":"लाइसेंस की शर्तों के अंतर्गत सॉफ्टवेयर को चलाने (run), अध्ययन करने (study), संशोधित करने (modify) और पुनर्वितरित करने (redistribute) की स्वतंत्रता, जहाँ सोर्स कोड उपलब्ध होता है"},"o":[{"en":"The freedoms to run, study, modify, and redistribute the software under the licence conditions, with accessible source code","hi":"लाइसेंस की शर्तों के अंतर्गत सॉफ्टवेयर को चलाने (run), अध्ययन करने (study), संशोधित करने (modify) और पुनर्वितरित करने (redistribute) की स्वतंत्रता, जहाँ सोर्स कोड उपलब्ध होता है"},{"en":"Only the freedom to view a 30-day trial before the computer locks up","hi":"कंप्यूटर लॉक होने से पहले केवल 30-दिन का ट्रायल देखने की स्वतंत्रता"},{"en":"The freedom to claim trademark ownership over the original creator's hardware factory","hi":"मूल निर्माता की हार्डवेयर फैक्ट्री पर स्वामित्व का दावा करने की स्वतंत्रता"},{"en":"No freedom to run the program; the user can only print the logo","hi":"प्रोग्राम चलाने की कोई स्वतंत्रता नहीं; यूज़र केवल लोगो प्रिंट कर सकता है"}],"exp":{"en":"A FOSS (Free and Open Source Software) licence provides accessible source code and grants users the freedom to run the program for any purpose, study how it works, modify/improve it, and redistribute copies (within the terms of the licence).","hi":"FOSS लाइसेंस उपयोगकर्ता को लाइसेंस की शर्तों के भीतर सॉफ्टवेयर को चलाने (run), समझने/अध्ययन करने (study), उसमें बदलाव करने (modify) और उसे पुनर्वितरित करने (redistribute) की स्वतंत्रता देता है, तथा इसका सोर्स कोड सभी के लिए सुलभ (accessible) होता है।"},"num":47},{"id":"q48","q":{"en":"Which of the following sets lists standard examples of FOSS from the chapter?","hi":"अध्याय में दिए गए FOSS (Free and Open Source Software) के प्रमुख उदाहरण कौन-से हैं?"},"a":{"en":"Ubuntu, Mozilla Firefox, LibreOffice, and Python","hi":"Ubuntu, Mozilla Firefox, LibreOffice और Python"},"o":[{"en":"Ubuntu, Mozilla Firefox, LibreOffice, and Python","hi":"Ubuntu, Mozilla Firefox, LibreOffice और Python"},{"en":"Microsoft Windows, Tally, and Quick Heal","hi":"Microsoft Windows, Tally और Quick Heal"},{"en":"Apple macOS, iOS, and Final Cut Pro","hi":"Apple macOS, iOS और Final Cut Pro"},{"en":"Adobe Photoshop, After Effects, and MS Excel","hi":"Adobe Photoshop, After Effects और MS Excel"}],"exp":{"en":"Standard examples of FOSS highlighted in the chapter are the Ubuntu Linux distribution, the Mozilla Firefox web browser, the LibreOffice productivity suite, and the Python programming language.","hi":"FOSS के प्रमुख उदाहरण Ubuntu, Mozilla Firefox, LibreOffice और Python हैं।"},"num":48},{"id":"q49","q":{"en":"What is the key exam distinction between 'Freeware' and 'FOSS'?","hi":"परीक्षा की दृष्टि से 'फ्रीवेयर' (Freeware) और 'FOSS' में मुख्य अंतर क्या है?"},"a":{"en":"The cue for Freeware is zero purchase price (gratis), whereas the cue for FOSS is accessible source code along with licence freedoms to study, modify, and redistribute","hi":"फ्रीवेयर की पहचान शून्य खरीद मूल्य (zero purchase price) है, जबकि FOSS की पहचान सोर्स कोड तक पहुँच और संशोधन व पुनर्वितरण की स्वतंत्रता है"},"o":[{"en":"The cue for Freeware is zero purchase price (gratis), whereas the cue for FOSS is accessible source code along with licence freedoms to study, modify, and redistribute","hi":"फ्रीवेयर की पहचान शून्य खरीद मूल्य (zero purchase price) है, जबकि FOSS की पहचान सोर्स कोड तक पहुँच और संशोधन व पुनर्वितरण की स्वतंत्रता है"},{"en":"Freeware always includes modifiable source code, whereas FOSS is closed-source and costs $500","hi":"फ्रीवेयर में हमेशा संशोधित करने योग्य सोर्स कोड होता है, जबकि FOSS क्लोज्ड-सोर्स होता है"},{"en":"Freeware is hardware, whereas FOSS is firmware","hi":"फ्रीवेयर हार्डवेयर है, जबकि FOSS फर्मवेयर है"},{"en":"There is no difference; both terms mean paid proprietary antivirus software","hi":"कोई अंतर नहीं है; दोनों शब्दों का अर्थ सशुल्क प्रोप्राइटरी एंटीवायरस सॉफ्टवेयर है"}],"exp":{"en":"Exam Trap Distinction: Freeware focuses on zero price (free of cost, but usually closed-source with no modification rights), whereas FOSS focuses on liberty/openness—providing source code access and the legal freedom to inspect, modify, and share the software.","hi":"परीक्षा के लिए मुख्य अंतर: फ्रीवेयर (Freeware) का मुख्य संकेत शून्य खरीद मूल्य (मुफ्त उपयोग) है, जबकि FOSS का मुख्य संकेत सोर्स कोड की उपलब्धता और लाइसेंस द्वारा दी गई संशोधन व वितरण की स्वतंत्रताएँ हैं।"},"num":49},{"id":"q50","q":{"en":"What is the meaning of 'Proprietary Software'?","hi":"'प्रोप्राइटरी सॉफ्टवेयर' (Proprietary Software) का क्या अर्थ है?"},"a":{"en":"Software whose copyright owner controls and restricts its use, source-code access, modification, and redistribution through a licence","hi":"वह सॉफ्टवेयर जिसका कॉपीराइट मालिक लाइसेंस के माध्यम से उसके उपयोग, संशोधन और पुनर्वितरण को नियंत्रित (प्रतिबंधित) करता है"},"o":[{"en":"Software placed in the public domain with no copyright owner","hi":"बिना किसी कॉपीराइट मालिक के सार्वजनिक डोमेन में रखा गया सॉफ्टवेयर"},{"en":"Software whose copyright owner controls and restricts its use, source-code access, modification, and redistribution through a licence","hi":"वह सॉफ्टवेयर जिसका कॉपीराइट मालिक लाइसेंस के माध्यम से उसके उपयोग, संशोधन और पुनर्वितरण को नियंत्रित (प्रतिबंधित) करता है"},{"en":"Open-source software distributed under the GNU General Public License","hi":"GNU जनरल पब्लिक लाइसेंस के तहत वितरित ओपन-सोर्स सॉफ्टवेयर"},{"en":"A physical cable owned by an internet service provider","hi":"इंटरनेट सेवा प्रदाता के स्वामित्व वाली एक भौतिक केबल"}],"exp":{"en":"Proprietary (closed-source) software is legally owned by an individual or company (copyright holder) that restricts source-code inspection, modification, sharing, and usage terms through an End-User Licence Agreement (EULA).","hi":"प्रोप्राइटरी सॉफ्टवेयर का अर्थ है कि उसका कॉपीराइट मालिक (कंपनी या व्यक्ति) लाइसेंस के माध्यम से उसके उपयोग, सोर्स कोड में बदलाव (modification) और पुनर्वितरण (redistribution) को नियंत्रित व प्रतिबंधित करता है।"},"num":50},{"id":"q51","q":{"en":"Which of the following are cited in the chapter as examples of Proprietary Software?","hi":"अध्याय में प्रोप्राइटरी सॉफ्टवेयर (Proprietary Software) के कौन-से उदाहरण दिए गए हैं?"},"a":{"en":"Proprietary products such as Microsoft Windows, Tally, and Quick Heal","hi":"Microsoft Windows, Tally और Quick Heal के प्रोप्राइटरी उत्पाद"},"o":[{"en":"Proprietary products such as Microsoft Windows, Tally, and Quick Heal","hi":"Microsoft Windows, Tally और Quick Heal के प्रोप्राइटरी उत्पाद"},{"en":"Ubuntu, Fedora, and Debian Linux","hi":"Ubuntu, Fedora और Debian Linux"},{"en":"LibreOffice Writer and Calc","hi":"LibreOffice Writer और Calc"},{"en":"Python and Mozilla Firefox","hi":"Python और Mozilla Firefox"}],"exp":{"en":"The chapter lists commercial closed-source products such as Microsoft Windows, Tally (accounting software), and Quick Heal (antivirus) as examples of proprietary software.","hi":"अध्याय में प्रोप्राइटरी सॉफ्टवेयर के उदाहरणों के रूप में Microsoft Windows, Tally और Quick Heal के उत्पादों का उल्लेख किया गया है।"},"num":51},{"id":"q52","q":{"en":"Can a free-of-charge software program still be 'Proprietary'?","hi":"क्या कोई निःशुल्क (Free-of-charge) सॉफ्टवेयर भी 'प्रोप्राइटरी' हो सकता है?"},"a":{"en":"Yes — the monetary price can be zero (freeware), while source-code access, modification, and redistribution remain restricted by the copyright owner","hi":"हाँ — कीमत शून्य हो सकती है (जैसे फ्रीवेयर), जबकि सोर्स कोड तक पहुँच और संशोधन के अधिकार प्रतिबंधित (restricted) रहते हैं"},"o":[{"en":"No — if the price is zero, the source code automatically becomes open-source by law","hi":"नहीं — यदि कीमत शून्य है, तो सोर्स कोड कानूनन स्वतः ही ओपन-सोर्स हो जाता है"},{"en":"Yes — the monetary price can be zero (freeware), while source-code access, modification, and redistribution remain restricted by the copyright owner","hi":"हाँ — कीमत शून्य हो सकती है (जैसे फ्रीवेयर), जबकि सोर्स कोड तक पहुँच और संशोधन के अधिकार प्रतिबंधित (restricted) रहते हैं"},{"en":"No — proprietary software must always cost at least $1,000 per licence","hi":"नहीं — प्रोप्राइटरी सॉफ्टवेयर की कीमत हमेशा कम से कम $1,000 प्रति लाइसेंस होनी चाहिए"},{"en":"Yes — but only if it is an open-source Linux kernel","hi":"हाँ — लेकिन केवल तभी जब यह एक ओपन-सोर्स लिनक्स कर्नेल हो"}],"exp":{"en":"Yes. 'Freeware' (such as Adobe Acrobat Reader) is distributed at zero price, yet it is still proprietary software because its source code is closed and users are not permitted to modify or redistribute it.","hi":"हाँ, बिल्कुल। किसी सॉफ्टवेयर की कीमत शून्य (मुफ्त/फ्रीवेयर) हो सकती है, लेकिन यदि उसका सोर्स कोड बंद है और संशोधन प्रतिबंधित (restricted) है, तो वह प्रोप्राइटरी सॉफ्टवेयर ही कहलाता है।"},"num":52}]},{"title":{"en":"5. Operating System Basics, Functions & Interfaces","hi":"5. ऑपरेटिंग सिस्टम की मूल बातें, कार्य और इंटरफेस"},"questions":[{"id":"q53","q":{"en":"What is the primary role of an Operating System (OS)?","hi":"ऑपरेटिंग सिस्टम (Operating System - OS) की मुख्य भूमिका क्या है?"},"a":{"en":"It provides an interface for users and applications to use hardware resources, and manages all system resources","hi":"यह यूज़र और एप्लिकेशन्स को हार्डवेयर संसाधन उपयोग करने का इंटरफेस देता है और सिस्टम संसाधनों (resources) को मैनेज करता है"},"o":[{"en":"It provides an interface for users and applications to use hardware resources, and manages all system resources","hi":"यह यूज़र और एप्लिकेशन्स को हार्डवेयर संसाधन उपयोग करने का इंटरफेस देता है और सिस्टम संसाधनों (resources) को मैनेज करता है"},{"en":"It functions solely as an offline spell-checker for English essays","hi":"यह केवल अंग्रेजी निबंधों के लिए ऑफ़लाइन स्पेल-चेकर के रूप में कार्य करता है"},{"en":"It supplies backup battery power when main electricity fails","hi":"मुख्य बिजली विफल होने पर यह बैकअप बैटरी पावर की आपूर्ति करता है"},{"en":"It physically prints barcodes onto retail packaging","hi":"यह खुदरा पैकेजिंग पर भौतिक रूप से बारकोड प्रिंट करता है"}],"exp":{"en":"An Operating System (OS) acts as an intermediary/interface between the user (and application programs) and the computer hardware, while managing and coordinating all hardware and software resources.","hi":"ऑपरेटिंग सिस्टम की प्राथमिक भूमिका उपयोगकर्ता (user) और एप्लिकेशन्स को हार्डवेयर संसाधनों का उपयोग करने के लिए एक इंटरफेस प्रदान करना तथा संपूर्ण सिस्टम संसाधनों का प्रबंधन करना है।"},"num":53},{"id":"q54","q":{"en":"Why is the Operating System called a 'Resource Manager'?","hi":"ऑपरेटिंग सिस्टम (OS) को 'रिसोर्स मैनेजर' (Resource Manager) क्यों कहते हैं?"},"a":{"en":"Because it coordinates and allocates CPU time, RAM (memory), secondary storage, I/O devices, and running applications","hi":"क्योंकि यह CPU समय, RAM, स्टोरेज, I/O डिवाइसेस और चल रहे एप्लिकेशन्स का समन्वय व प्रबंधन करता है"},"o":[{"en":"Because it coordinates and allocates CPU time, RAM (memory), secondary storage, I/O devices, and running applications","hi":"क्योंकि यह CPU समय, RAM, स्टोरेज, I/O डिवाइसेस और चल रहे एप्लिकेशन्स का समन्वय व प्रबंधन करता है"},{"en":"Because it hires human resources and manages office payrolls automatically","hi":"क्योंकि यह मानव संसाधनों की भर्ती करता है और कार्यालय वेतन का प्रबंधन करता है"},{"en":"Because it mines silicon and copper ore for hardware manufacturing","hi":"क्योंकि यह हार्डवेयर निर्माण के लिए सिलिकॉन और तांबे के अयस्क का खनन करता है"},{"en":"Because it only manages the ink levels inside a ballpoint pen","hi":"क्योंकि यह केवल बॉलपॉइंट पेन के अंदर स्याही के स्तर का प्रबंधन करता है"}],"exp":{"en":"The OS is called a resource manager because multiple programs और users compete for limited hardware resources; the OS fairly और efficiently allocates CPU cycles, main memory (RAM), disk storage, and I/O peripherals among them.","hi":"OS को रिसोर्स मैनेजर इसलिए कहा जाता है क्योंकि यह CPU टाइम, RAM (मेमोरी), स्टोरेज, इनपुट/आउटपुट डिवाइसेस और रन हो रहे एप्लिकेशन्स के बीच संसाधनों का समन्वय और आवंटन करता है।"},"num":54},{"id":"q55","q":{"en":"When and how does the Operating System load during the 'Booting' process?","hi":"'बूटिंग' (Booting) प्रक्रिया में ऑपरेटिंग सिस्टम कब और कैसे लोड होता है?"},"a":{"en":"At startup, the system firmware (BIOS/UEFI) and bootloader help load the OS kernel into memory, after which the OS provides the environment for regular applications","hi":"स्टार्टअप पर फर्मवेयर और बूटलोडर OS को लोड करने में मदद करते हैं, जिसके बाद OS सामान्य एप्लिकेशन्स के लिए वातावरण देता है"},"o":[{"en":"At startup, the system firmware (BIOS/UEFI) and bootloader help load the OS kernel into memory, after which the OS provides the environment for regular applications","hi":"स्टार्टअप पर फर्मवेयर और बूटलोडर OS को लोड करने में मदद करते हैं, जिसके बाद OS सामान्य एप्लिकेशन्स के लिए वातावरण देता है"},{"en":"The user must first open MS Word, which then compiles and loads the OS kernel","hi":"यूज़र को पहले MS Word खोलना पड़ता है, जो फिर OS कर्नेल को लोड करता है"},{"en":"The OS is loaded only when the computer is being shut down","hi":"OS केवल तभी लोड होता है जब कंप्यूटर बंद किया जा रहा हो"},{"en":"The printer driver loads the BIOS after all games are closed","hi":"सभी गेम बंद होने के बाद प्रिंटर ड्राइवर BIOS को लोड करता है"}],"exp":{"en":"Booting sequence: When a computer is powered on, startup firmware (BIOS/UEFI) initializes hardware and invokes the bootloader, which loads the OS kernel into main memory (RAM). Once running, the OS provides the runtime environment for applications.","hi":"बूटिंग के दौरान स्टार्टअप पर सबसे पहले फर्मवेयर (Firmware / BIOS) और बूटलोडर (Bootloader) ऑपरेटिंग सिस्टम कर्नेल को मेमोरी में लोड करने में मदद करते हैं। इसके बाद OS सामान्य एप्लिकेशन्स को चलाने के लिए वातावरण प्रदान करता है।"},"num":55},{"id":"q56","q":{"en":"Which of the following constitute the major functions of an Operating System?","hi":"ऑपरेटिंग सिस्टम (OS) के प्रमुख कार्य (Major Functions) कौन-से हैं?"},"a":{"en":"Process, memory, storage, file, and device management, along with security, error detection, inter-process messaging, and command interpretation","hi":"प्रोसेस, मेमोरी, स्टोरेज, फ़ाइल और डिवाइस मैनेजमेंट; साथ ही सुरक्षा, एरर डिटेक्शन, मैसेजिंग और कमांड इंटरप्रिटेशन"},"o":[{"en":"Process, memory, storage, file, and device management, along with security, error detection, inter-process messaging, and command interpretation","hi":"प्रोसेस, मेमोरी, स्टोरेज, फ़ाइल और डिवाइस मैनेजमेंट; साथ ही सुरक्षा, एरर डिटेक्शन, मैसेजिंग और कमांड इंटरप्रिटेशन"},{"en":"Only manufacturing silicon chips and soldering motherboards","hi":"केवल सिलिकॉन चिप्स का निर्माण और मदरबोर्ड की सोल्डरिंग"},{"en":"Only designing 3D animated movies and editing vector logos","hi":"केवल 3D एनिमेटेड फिल्में डिज़ाइन करना और वेक्टर लोगो एडिट करना"},{"en":"Only supplying 220V AC power to the monitor screen","hi":"मॉनिटर स्क्रीन को केवल 220V AC बिजली की आपूर्ति करना"}],"exp":{"en":"The core functions of an OS include Process management, Memory management, Storage management, File-system management, Device (I/O) management, Security & access control, Error detection/handling, Messaging, and Command interpretation.","hi":"ऑपरेटिंग सिस्टम के प्रमुख कार्यों में प्रोसेस मैनेजमेंट, मेमोरी मैनेजमेंट, स्टोरेज मैनेजमेंट, फ़ाइल और डिवाइस मैनेजमेंट के साथ-साथ सिक्योरिटी, एरर डिटेक्शन, मैसेजिंग और कमांड इंटरप्रिटेशन शामिल हैं।"},"num":56},{"id":"q57","q":{"en":"What does the Operating System do in 'Process Management' and 'Memory Management'?","hi":"'प्रोसेस मैनेजमेंट' और 'मेमोरी मैनेजमेंट' में ऑपरेटिंग सिस्टम क्या करता है?"},"a":{"en":"It schedules processes for CPU execution, and allocates, protects, and releases main memory (RAM) for those processes","hi":"यह प्रोसेसेज को शेड्यूल (schedule) करता है और उन्हें मेमोरी आवंटित (allocate), सुरक्षित (protect) व रिलीज़ (release) करता है"},"o":[{"en":"It schedules processes for CPU execution, and allocates, protects, and releases main memory (RAM) for those processes","hi":"यह प्रोसेसेज को शेड्यूल (schedule) करता है और उन्हें मेमोरी आवंटित (allocate), सुरक्षित (protect) व रिलीज़ (release) करता है"},{"en":"It physically cleans dust from the CPU fan and solders new RAM sticks","hi":"यह CPU फैन से धूल साफ करता है और नई RAM स्टिक सोल्डर करता है"},{"en":"It deletes all files on the hard disk whenever a program finishes","hi":"जब भी कोई प्रोग्राम समाप्त होता है तो यह हार्ड डिस्क की सभी फ़ाइलों को हटा देता है"},{"en":"It converts RAM modules into optical CD-ROM discs","hi":"यह RAM मॉड्यूल को ऑप्टिकल CD-ROM डिस्क में बदल देता है"}],"exp":{"en":"In process management, the OS creates, schedules, synchronizes, and terminates processes on the CPU. In memory management, it tracks RAM usage, allocates memory space to active processes, protects one process's memory from another, and reclaims/releases memory when a process ends.","hi":"प्रोसेस और मेमोरी प्रबंधन के अंतर्गत OS विभिन्न प्रोसेसेज को CPU पर शेड्यूल (schedule) करता है तथा उन्हें आवश्यक मेमोरी आवंटित (allocate), सुरक्षित (protect) और कार्य समाप्त होने पर मुक्त (release) करता है।"},"num":57},{"id":"q58","q":{"en":"What does the Operating System do in 'Storage, File, and Device Management'?","hi":"'स्टोरेज, फ़ाइल और डिवाइस मैनेजमेंट' में ऑपरेटिंग सिस्टम क्या करता है?"},"a":{"en":"It organizes drives, directories, and files, and controls peripheral hardware devices through device drivers","hi":"यह ड्राइव्स और फ़ाइलों को व्यवस्थित (organize) करता है तथा ड्राइवर्स के माध्यम से पेरिफेरल्स को नियंत्रित करता है"},"o":[{"en":"It organizes drives, directories, and files, and controls peripheral hardware devices through device drivers","hi":"यह ड्राइव्स और फ़ाइलों को व्यवस्थित (organize) करता है तथा ड्राइवर्स के माध्यम से पेरिफेरल्स को नियंत्रित करता है"},{"en":"It manufactures external USB cables and ink cartridges","hi":"यह बाहरी USB केबल और इंक कार्ट्रिज बनाता है"},{"en":"It translates C++ source code into assembly mnemonics","hi":"यह C++ सोर्स कोड को असेंबली निमोनिक्स में अनुवादित करता है"},{"en":"It replaces the hard drive with a CRT monitor","hi":"यह हार्ड ड्राइव को CRT मॉनिटर से बदल देता है"}],"exp":{"en":"The OS manages secondary storage space, organizes data into structured files and directories/folders with access permissions, and coordinates all I/O peripheral devices via their respective device drivers.","hi":"स्टोरेज, फ़ाइल और डिवाइस मैनेजमेंट में OS स्टोरेज ड्राइव्स और फ़ाइलों को व्यवस्थित (organize) करता है तथा डिवाइस ड्राइवर्स के माध्यम से सभी पेरिफेरल उपकरणों को नियंत्रित करता है।"},"num":58},{"id":"q59","q":{"en":"How does an Operating System support 'Security' and 'Error Detection'?","hi":"ऑपरेटिंग सिस्टम 'सुरक्षा' (Security) और 'एरर डिटेक्शन' (Error Detection) को कैसे सपोर्ट करता है?"},"a":{"en":"It enforces user authentication and access permissions, and continuously monitors the system to detect, log, or handle hardware/software errors","hi":"यह ऑथेंटिकेशन और परमिशन्स लागू करता है तथा सिस्टम में एरर्स को डिटेक्ट, लॉग या हैंडल करता है"},"o":[{"en":"It enforces user authentication and access permissions, and continuously monitors the system to detect, log, or handle hardware/software errors","hi":"यह ऑथेंटिकेशन और परमिशन्स लागू करता है तथा सिस्टम में एरर्स को डिटेक्ट, लॉग या हैंडल करता है"},{"en":"It locks the computer room door with a physical brass padlock","hi":"यह कंप्यूटर रूम के दरवाजे को भौतिक पीतल के ताले से बंद कर देता है"},{"en":"It ignores all memory faults so the screen never shows any message","hi":"यह सभी मेमोरी दोषों को अनदेखा करता है ताकि स्क्रीन पर कभी कोई संदेश न दिखे"},{"en":"It uninstalls the keyboard whenever a user makes a typing mistake","hi":"जब भी कोई यूज़र टाइपिंग में गलती करता है तो यह कीबोर्ड को अनइंस्टॉल कर देता है"}],"exp":{"en":"For security, the OS enforces user authentication (logins/passwords) and file/resource access permissions. For error detection, it monitors hardware (memory, I/O devices) and software execution to detect, log, and recover from faults gracefully.","hi":"सुरक्षा के लिए OS यूज़र ऑथेंटिकेशन (प्रमाणीकरण) और एक्सेस परमिशन्स लागू करता है, तथा हार्डवेयर या सॉफ्टवेयर में आने वाली त्रुटियों (errors) को डिटेक्ट, लॉग और हैंडल करता है।"},"num":59},{"id":"q60","q":{"en":"What are the four main types of User Interfaces (UI) provided by Operating Systems as discussed in the chapter?","hi":"अध्याय में बताए गए ऑपरेटिंग सिस्टम के चार मुख्य यूज़र इंटरफेस (User Interface) प्रकार कौन-से हैं?"},"a":{"en":"Command-based, Graphical (GUI), Touch-based, and Voice-based interfaces","hi":"कमांड-आधारित (Command-based), ग्राफिकल (GUI), टच-आधारित (Touch-based) और वॉयस-आधारित (Voice-based)"},"o":[{"en":"Command-based, Graphical (GUI), Touch-based, and Voice-based interfaces","hi":"कमांड-आधारित (Command-based), ग्राफिकल (GUI), टच-आधारित (Touch-based) और वॉयस-आधारित (Voice-based)"},{"en":"RAM-based, ROM-based, Cache-based, and Register-based interfaces","hi":"रैम-आधारित, रोम-आधारित, कैश-आधारित और रजिस्टर-आधारित"},{"en":"Impact, Non-impact, Thermal, and Laser interfaces","hi":"इम्पैक्ट, नॉन-इम्पैक्ट, थर्मल और लेजर इंटरफेस"},{"en":"LAN, MAN, WAN, and PAN interfaces","hi":"LAN, MAN, WAN और PAN इंटरफेस"}],"exp":{"en":"The chapter classifies Operating System user interfaces into four types: Command-based (CLI), Graphical User Interface (GUI), Touch-based interface, and Voice-based interface.","hi":"अध्याय के अनुसार ऑपरेटिंग सिस्टम के चार यूज़र इंटरफेस प्रकार हैं: कमांड-आधारित (Command-based), ग्राफिकल (Graphical/GUI), टच-आधारित (Touch-based) और वॉयस-आधारित (Voice-based)।"},"num":60},{"id":"q61","q":{"en":"How does a user give instructions in a 'Command-Based Interface' (CLI), and what are its textbook examples?","hi":"'कमांड-आधारित इंटरफेस' (Command-based interface / CLI) में यूज़र निर्देश कैसे देता है और इसके उदाहरण क्या हैं?"},"a":{"en":"The user types text commands using the keyboard (e.g., to list or delete files or create a folder like 'mkdir Notes'); MS-DOS and Unix shells are classic textbook examples","hi":"यूज़र कीबोर्ड से टेक्स्ट कमांड टाइप करता है (जैसे फ़ाइल लिस्ट या डिलीट करने के लिए); MS-DOS और Unix शेल्स इसके उदाहरण हैं"},"o":[{"en":"The user types text commands using the keyboard (e.g., to list or delete files or create a folder like 'mkdir Notes'); MS-DOS and Unix shells are classic textbook examples","hi":"यूज़र कीबोर्ड से टेक्स्ट कमांड टाइप करता है (जैसे फ़ाइल लिस्ट या डिलीट करने के लिए); MS-DOS और Unix शेल्स इसके उदाहरण हैं"},{"en":"The user taps 3D floating holograms with a stylus; Windows Media Player is an example","hi":"यूज़र स्टाइलस से 3D होलोग्राम टैप करता है; विंडोज़ मीडिया प्लेयर एक उदाहरण है"},{"en":"The user speaks into a microphone only; Siri is the only example","hi":"यूज़र केवल माइक्रोफोन में बोलता है; Siri एकमात्र उदाहरण है"},{"en":"The user drags icons with a mouse without ever using a keyboard","hi":"यूज़र कभी भी कीबोर्ड का उपयोग किए बिना माउस से आइकन खींचता है"}],"exp":{"en":"In a Command-Line / Command-Based Interface (CLI), the user interacts with the OS by typing specific text commands from the keyboard (e.g., `mkdir Notes`, `dir`, `ls`, `del`). MS-DOS and Unix/Linux shells (like Bash) are classic textbook examples.","hi":"कमांड-आधारित इंटरफेस (CLI) में यूज़र कीबोर्ड से टेक्स्ट कमांड टाइप करके निर्देश देता है (जैसे फ़ाइल देखने, डिलीट करने या `mkdir Notes` से फ़ोल्डर बनाने के लिए)। MS-DOS और Unix शेल्स इसके प्रमुख उदाहरण हैं।"},"num":61},{"id":"q62","q":{"en":"What is the full form of GUI, and what are its basic visual features?","hi":"GUI का पूर्ण रूप (Full Form) क्या है और इसकी बुनियादी विशेषताएँ क्या हैं?"},"a":{"en":"Graphical User Interface — It uses visual controls/elements such as windows, icons, menus, buttons, and a pointer (WIMP)","hi":"ग्राफिकल यूज़र इंटरफेस — इसमें विंडोज, आइकन्स, मेनू और पॉइंटर जैसे विजुअल कंट्रोल्स का उपयोग होता है"},"o":[{"en":"General Utility Interpreter — It uses only binary numbers on punched tape","hi":"जनरल यूटिलिटी इंटरप्रेटर — यह पंच टेप पर केवल बाइनरी नंबरों का उपयोग करता है"},{"en":"Graphical User Interface — It uses visual controls/elements such as windows, icons, menus, buttons, and a pointer (WIMP)","hi":"ग्राफिकल यूज़र इंटरफेस — इसमें विंडोज, आइकन्स, मेनू और पॉइंटर जैसे विजुअल कंट्रोल्स का उपयोग होता है"},{"en":"Global Unix Integration — It requires memorizing 500 text commands","hi":"ग्लोबल यूनिक्स इंटीग्रेशन — इसमें 500 टेक्स्ट कमांड याद रखने की आवश्यकता होती है"},{"en":"Graphics Unit Interconnect — A hardware cable for CRT monitors","hi":"ग्राफिक्स यूनिट इंटरकनेक्ट — CRT मॉनिटर के लिए एक हार्डवेयर केबल"}],"exp":{"en":"GUI stands for Graphical User Interface. It allows users to interact with the system visually using graphical elements such as Windows, Icons, Menus, and a Pointer (WIMP), typically controlled with a mouse and keyboard.","hi":"GUI का पूर्ण रूप Graphical User Interface है। इसमें उपयोगकर्ता की सुविधा के लिए विंडोज (windows), आइकन्स (icons), मेनू (menus) और पॉइंटर (pointer) जैसे विजुअल कंट्रोल्स का उपयोग होता है।"},"num":62},{"id":"q63","q":{"en":"Which of the following operating systems provide a GUI, and what are the common input devices used with them?","hi":"निम्नलिखित में से किन ऑपरेटिंग सिस्टम्स में GUI मिलता है और उनके साथ कौन-से सामान्य इनपुट साधन प्रयुक्त होते हैं?"},"a":{"en":"Windows, Ubuntu, Fedora, and macOS; mouse and keyboard are the common input methods","hi":"Windows, Ubuntu, Fedora और macOS; माउस और कीबोर्ड सामान्य इनपुट माध्यम हैं"},"o":[{"en":"Windows, Ubuntu, Fedora, and macOS; mouse and keyboard are the common input methods","hi":"Windows, Ubuntu, Fedora और macOS; माउस और कीबोर्ड सामान्य इनपुट माध्यम हैं"},{"en":"Only 1981 MS-DOS 1.0; punched card reader is the input method","hi":"केवल 1981 का MS-DOS 1.0; पंच कार्ड रीडर इनपुट माध्यम है"},{"en":"Only ENIAC and UNIVAC I; vacuum switches are the input method","hi":"केवल ENIAC और UNIVAC I; वैक्यूम स्विच इनपुट माध्यम हैं"},{"en":"Only BIOS ROM chips; barcode scanner is the input method","hi":"केवल BIOS ROM चिप्स; बारकोड स्कैनर इनपुट माध्यम है"}],"exp":{"en":"Modern desktop operating systems such as Microsoft Windows, Ubuntu, Fedora, and Apple macOS provide rich Graphical User Interfaces (GUIs), commonly operated using a mouse/trackpad and keyboard.","hi":"Windows, Ubuntu, Fedora और macOS जैसे आधुनिक ऑपरेटिंग सिस्टम्स GUI प्रदान करते हैं, और इनमें माउस तथा कीबोर्ड सबसे सामान्य इनपुट साधन हैं।"},"num":63},{"id":"q64","q":{"en":"How is a 'Touch-Based Interface' operated, and what are its common examples?","hi":"'टच-आधारित इंटरफेस' (Touch-based interface) कैसे संचालित होता है और इसके उदाहरण क्या हैं?"},"a":{"en":"Operated directly on a touchscreen using taps, swipes, pinch-to-zoom, and multi-touch gestures; Android, iOS, and touch-enabled Windows devices are examples","hi":"स्क्रीन पर टैप, स्वाइप और जेस्चर (gestures) से; Android, iOS और टच-सक्षम Windows डिवाइसेस इसके उदाहरण हैं"},"o":[{"en":"Operated directly on a touchscreen using taps, swipes, pinch-to-zoom, and multi-touch gestures; Android, iOS, and touch-enabled Windows devices are examples","hi":"स्क्रीन पर टैप, स्वाइप और जेस्चर (gestures) से; Android, iOS और टच-सक्षम Windows डिवाइसेस इसके उदाहरण हैं"},{"en":"Operated by striking an inked ribbon with metal pins; Dot Matrix is an example","hi":"धातु की पिनों से स्याही वाले रिबन पर प्रहार करके; डॉट मैट्रिक्स एक उदाहरण है"},{"en":"Operated only by typing batch scripts on a non-touch CRT monitor","hi":"गैर-टच CRT मॉनिटर पर केवल बैच स्क्रिप्ट टाइप करके"},{"en":"Operated using magnetic ink on bank cheques; MICR is an example","hi":"बैंक चेक पर चुंबकीय स्याही का उपयोग करके; MICR एक उदाहरण है"}],"exp":{"en":"A touch-based interface allows users to interact directly with objects on a touch-sensitive screen using finger taps, swipes, and multi-touch gestures. Common examples are Android, Apple iOS/iPadOS, and touch-enabled Windows tablets/laptops.","hi":"टच-आधारित इंटरफेस स्क्रीन पर उँगलियों या स्टाइलस से टैप (tap), स्वाइप (swipe) और जेस्चर (gestures) के माध्यम से संचालित होता है। Android, iOS और टच-सक्षम Windows उपकरण इसके प्रमुख उदाहरण हैं।"},"num":64},{"id":"q65","q":{"en":"How does a 'Voice-Based Interface' operate, and which examples are listed in the chapter?","hi":"'वॉयस-आधारित इंटरफेस' (Voice-based interface) कैसे काम करता है और अध्याय में इसके कौन-से उदाहरण दिए गए हैं?"},"a":{"en":"The user gives spoken voice commands; the chapter lists Apple's Siri, 'OK Google' (Google Assistant), and Windows 10's historical Cortana example","hi":"यूज़र बोलकर कमांड (spoken commands) देता है; अध्याय में Siri, 'OK Google' और Windows 10 के ऐतिहासिक Cortana उदाहरण को सूचीबद्ध किया गया है"},"o":[{"en":"The user gives spoken voice commands; the chapter lists Apple's Siri, 'OK Google' (Google Assistant), and Windows 10's historical Cortana example","hi":"यूज़र बोलकर कमांड (spoken commands) देता है; अध्याय में Siri, 'OK Google' और Windows 10 के ऐतिहासिक Cortana उदाहरण को सूचीबद्ध किया गया है"},{"en":"The user types binary 0s and 1s; examples are COBOL and FORTRAN","hi":"यूज़र बाइनरी 0 और 1 टाइप करता है; उदाहरण COBOL और FORTRAN हैं"},{"en":"The user rotates a mechanical trackball; examples are PS/2 and VGA","hi":"यूज़र यांत्रिक ट्रैकबॉल घुमाता है; उदाहरण PS/2 और VGA हैं"},{"en":"The user scans QR codes; examples are OMR and BCR","hi":"यूज़र QR कोड स्कैन करता है; उदाहरण OMR और BCR हैं"}],"exp":{"en":"In a voice-based user interface (VUI), the system accepts and executes spoken natural-language voice commands via speech recognition. The chapter cites Apple Siri, 'OK Google' (Google Assistant), and Microsoft Cortana (historical Windows 10 assistant) as examples.","hi":"वॉयस-आधारित इंटरफेस में यूज़र बोलकर कमांड (spoken commands) देता है। अध्याय में इसके उदाहरणों के रूप में Siri, 'OK Google' और Windows 10 के ऐतिहासिक Cortana को सूचीबद्ध किया गया है।"},"num":65},{"id":"q66","q":{"en":"Can a single Operating System offer both a Graphical User Interface (GUI) and a Command-Line Interface (CLI)?","hi":"क्या एक ही ऑपरेटिंग सिस्टम (OS) में GUI और कमांड लाइन (CLI) दोनों इंटरफेस मिल सकते हैं?"},"a":{"en":"Yes — modern operating systems like Windows and Linux distributions provide both a desktop GUI and command-line shells (such as Command Prompt/PowerShell or Bash terminal)","hi":"हाँ — Windows और Linux दोनों प्रकार के सिस्टम्स एक साथ GUI और कमांड लाइन इंटरफेस दे सकते हैं"},"o":[{"en":"Yes — modern operating systems like Windows and Linux distributions provide both a desktop GUI and command-line shells (such as Command Prompt/PowerShell or Bash terminal)","hi":"हाँ — Windows और Linux दोनों प्रकार के सिस्टम्स एक साथ GUI और कमांड लाइन इंटरफेस दे सकते हैं"},{"en":"No — an operating system kernel crashes if both a terminal and a window exist","hi":"नहीं — यदि टर्मिनल और विंडो दोनों मौजूद हों तो ऑपरेटिंग सिस्टम कर्नेल क्रैश हो जाता है"},{"en":"No — GUI is only for smartphones and CLI is only for 1950s mainframes","hi":"नहीं — GUI केवल स्मार्टफोन के लिए है और CLI केवल 1950 के दशक के मेनफ्रेम के लिए है"},{"en":"Yes — but only when the monitor is turned off","hi":"हाँ — लेकिन केवल तभी जब मॉनिटर बंद हो"}],"exp":{"en":"Yes. Most modern operating systems (including Microsoft Windows, Linux distributions like Ubuntu/Fedora, and macOS) provide a full Graphical User Interface alongside built-in command-line shells/terminals (and even touch/voice interfaces).","hi":"हाँ, बिल्कुल। आधुनिक Windows, Linux और macOS सिस्टम्स एक ही समय में ग्राफिकल यूज़र इंटरफेस (GUI) और कमांड लाइन टर्मिनल/शेल (CLI) दोनों की सुविधा प्रदान करते हैं।"},"num":66}]},{"title":{"en":"6. Operating Systems & Release Milestones","hi":"6. ऑपरेटिंग सिस्टम और रिलीज की प्रमुख उपलब्धियाँ"},"questions":[{"id":"q67","q":{"en":"Which of the following are the common Operating System examples highlighted in the chapter?","hi":"अध्याय में दिए गए सामान्य ऑपरेटिंग सिस्टम (OS) के उदाहरण कौन-से हैं?"},"a":{"en":"Windows, Linux, Unix, macOS, Android, and iOS","hi":"Windows, Linux, Unix, macOS, Android और iOS"},"o":[{"en":"Windows, Linux, Unix, macOS, Android, and iOS","hi":"Windows, Linux, Unix, macOS, Android और iOS"},{"en":"Photoshop, CorelDRAW, Blender, and Maya","hi":"Photoshop, CorelDRAW, Blender और Maya"},{"en":"HTML, CSS, SQL, and Python","hi":"HTML, CSS, SQL और Python"},{"en":"RAM, ROM, PROM, and EEPROM","hi":"RAM, ROM, PROM और EEPROM"}],"exp":{"en":"The major desktop, server, and mobile operating systems highlighted in the chapter are Microsoft Windows, Linux, Unix, Apple macOS, Google Android, and Apple iOS.","hi":"अध्याय के प्रमुख ऑपरेटिंग सिस्टम उदाहरण Windows, Linux, Unix, macOS, Android और iOS हैं।"},"num":67},{"id":"q68","q":{"en":"What are the respective release years of Apple's original Macintosh System Software and Mac OS X?","hi":"Apple के मूल मैकिंटोश सिस्टम सॉफ्टवेयर (Original Macintosh System) और 'Mac OS X' के रिलीज़ वर्ष क्रमशः क्या हैं?"},"a":{"en":"Apple's original Macintosh System Software arrived in 1984 (later called Classic Mac OS), whereas Mac OS X was released in 2001","hi":"Apple का मूल Macintosh सिस्टम सॉफ्टवेयर 1984 में आया (Classic Mac OS पुरानी लाइन का नाम है), जबकि Mac OS X वर्ष 2001 में रिलीज़ हुआ"},"o":[{"en":"Apple's original Macintosh System Software arrived in 1984 (later called Classic Mac OS), whereas Mac OS X was released in 2001","hi":"Apple का मूल Macintosh सिस्टम सॉफ्टवेयर 1984 में आया (Classic Mac OS पुरानी लाइन का नाम है), जबकि Mac OS X वर्ष 2001 में रिलीज़ हुआ"},{"en":"Original Macintosh arrived in 2008, and Mac OS X arrived in 1969","hi":"मूल मैकिंटोश 2008 में आया, और Mac OS X 1969 में आया"},{"en":"Both were released together in 1995 by Microsoft","hi":"दोनों को 1995 में माइक्रोसॉफ्ट द्वारा एक साथ रिलीज़ किया गया था"},{"en":"Original Macintosh arrived in 1951, and Mac OS X arrived in 1971","hi":"मूल मैकिंटोश 1951 में आया, और Mac OS X 1971 में आया"}],"exp":{"en":"Historical milestone distinction: Apple introduced the original Macintosh System Software in January 1984 (retroactively referred to as Classic Mac OS), while the Unix-based Mac OS X (now called macOS) was publicly released in March 2001.","hi":"Apple का मूल Macintosh सिस्टम सॉफ्टवेयर वर्ष 1984 में आया था (पुरानी श्रृंखला को Classic Mac OS कहा जाता है), जबकि आधुनिक 'Mac OS X' (अब macOS) वर्ष 2001 में रिलीज़ हुआ।"},"num":68},{"id":"q69","q":{"en":"Which web browser developed by Apple is bundled as the default browser on macOS and iOS?","hi":"macOS और iOS का डिफ़ॉल्ट Apple वेब ब्राउज़र कौन-सा है?"},"a":{"en":"Safari","hi":"सफारी (Safari)"},"o":[{"en":"Internet Explorer","hi":"इंटरनेट एक्सप्लोरर"},{"en":"Safari","hi":"सफारी (Safari)"},{"en":"Mozilla Firefox","hi":"मोज़िला फ़ायरफ़ॉक्स"},{"en":"Tor Browser","hi":"टोर ब्राउज़र"}],"exp":{"en":"Safari is Apple's native web browser included with macOS, iOS, and iPadOS.","hi":"macOS (तथा iOS) पर Apple का डिफ़ॉल्ट वेब ब्राउज़र 'सफारी' (Safari) है।"},"num":69},{"id":"q70","q":{"en":"With which organizations is the 'Android' operating system associated, and in which year did the first commercial Android phone launch?","hi":"'Android' ऑपरेटिंग सिस्टम किस संस्था से जुड़ा है और पहला व्यावसायिक Android फ़ोन किस वर्ष आया?"},"a":{"en":"Associated with Google and the Open Handset Alliance (OHA); the first commercial Android phone launched in 2008","hi":"Google और Open Handset Alliance से जुड़ा है; पहला कमर्शियल Android फ़ोन 2008 में आया"},"o":[{"en":"Associated with Google and the Open Handset Alliance (OHA); the first commercial Android phone launched in 2008","hi":"Google और Open Handset Alliance से जुड़ा है; पहला कमर्शियल Android फ़ोन 2008 में आया"},{"en":"Associated with Apple and IBM; launched in 1984","hi":"Apple और IBM से जुड़ा है; 1984 में लॉन्च हुआ"},{"en":"Associated with Bell Labs; launched in 1969","hi":"बेल लैब्स से जुड़ा है; 1969 में लॉन्च हुआ"},{"en":"Associated with C-DAC Pune; launched in 1991","hi":"सी-डैक पुणे से जुड़ा है; 1991 में लॉन्च हुआ"}],"exp":{"en":"Android is developed by Google in conjunction with the Open Handset Alliance (OHA). The first commercial Android smartphone (HTC Dream / T-Mobile G1) was released in 2008.","hi":"Android ऑपरेटिंग सिस्टम Google और Open Handset Alliance (OHA) से जुड़ा है, और पहला व्यावसायिक (commercial) Android फ़ोन वर्ष 2008 में बाज़ार में आया।"},"num":70},{"id":"q71","q":{"en":"In what sense is Android considered 'open source'?","hi":"Android किस अर्थ में 'ओपन सोर्स' (Open Source) है?"},"a":{"en":"The core platform is maintained as the open-source Android Open Source Project (AOSP), whereas Google Play Services and many pre-installed Google apps are separate proprietary components","hi":"Android Open Source Project (AOSP) ओपन-सोर्स प्लेटफॉर्म देता है, जबकि Google Play और कई Google ऐप्स अलग प्रोप्राइटरी घटक हैं"},"o":[{"en":"The core platform is maintained as the open-source Android Open Source Project (AOSP), whereas Google Play Services and many pre-installed Google apps are separate proprietary components","hi":"Android Open Source Project (AOSP) ओपन-सोर्स प्लेटफॉर्म देता है, जबकि Google Play और कई Google ऐप्स अलग प्रोप्राइटरी घटक हैं"},{"en":"Every paid game on the Google Play Store is public-domain open source","hi":"गूगल प्ले स्टोर पर मौजूद हर पेड गेम पब्लिक-डोमेन ओपन सोर्स है"},{"en":"Android runs without any kernel or hardware drivers","hi":"एंड्रॉइड बिना किसी कर्नेल या हार्डवेयर ड्राइवर के चलता है"},{"en":"Android is written entirely in 1GL binary punched cards","hi":"एंड्रॉइड पूरी तरह से 1GL बाइनरी पंच कार्ड में लिखा गया है"}],"exp":{"en":"Android's core operating system stack (built on the Linux kernel) is released under open-source licences through the Android Open Source Project (AOSP). However, commercial smartphones also bundle Google Mobile Services (GMS)—such as the Google Play Store, Gmail, and Maps—which are proprietary software licensed by Google.","hi":"Android का मूल आधार 'Android Open Source Project' (AOSP) है जो एक ओपन-सोर्स प्लेटफॉर्म प्रदान करता है; हालाँकि फ़ोन में मिलने वाला Google Play Store और कई अन्य Google ऐप्स अलग से प्रोप्राइटरी (proprietary) घटक होते हैं।"},"num":71},{"id":"q72","q":{"en":"What is the historical 2007 milestone associated with Apple's 'iOS'?","hi":"Apple के 'iOS' से जुड़ा वर्ष 2007 का ऐतिहासिक माइलस्टोन क्या है?"},"a":{"en":"Apple introduced the first iPhone along with its mobile operating system in 2007 (originally known during that period as iPhone OS before being renamed iOS)","hi":"Apple ने 2007 में पहले iPhone के साथ उसका ऑपरेटिंग सिस्टम पेश किया (उस दौर को iPhone OS युग भी कहते हैं)"},"o":[{"en":"Apple introduced the first iPhone along with its mobile operating system in 2007 (originally known during that period as iPhone OS before being renamed iOS)","hi":"Apple ने 2007 में पहले iPhone के साथ उसका ऑपरेटिंग सिस्टम पेश किया (उस दौर को iPhone OS युग भी कहते हैं)"},{"en":"Apple released the Apple II desktop computer in 2007","hi":"एप्पल ने 2007 में Apple II डेस्कटॉप कंप्यूटर रिलीज़ किया"},{"en":"Apple merged iOS with Microsoft MS-DOS in 2007","hi":"एप्पल ने 2007 में iOS को माइक्रोसॉफ्ट MS-DOS के साथ मिला दिया"},{"en":"Apple made iOS an open-source Linux distribution in 2007","hi":"एप्पल ने 2007 में iOS को ओपन-सोर्स लिनक्स डिस्ट्रीब्यूशन बना दिया"}],"exp":{"en":"In 2007, Apple launched the first-generation iPhone running its touch-based mobile operating system, which was initially called 'iPhone OS' before being officially rebranded as 'iOS' in 2010.","hi":"वर्ष 2007 में Apple ने पहले iPhone के साथ उसका मोबाइल ऑपरेटिंग सिस्टम पेश किया था (शुरुआती दौर में इसे iPhone OS कहा जाता था, जिसे बाद में iOS नाम दिया गया)।"},"num":72},{"id":"q73","q":{"en":"What is 'Linux' accurately in technical and everyday usage?","hi":"तकनीकी और आम बोलचाल की भाषा में 'लिनक्स' (Linux) क्या है?"},"a":{"en":"Technically, Linux is the open-source OS kernel (created by Linus Torvalds) that forms the base of Linux distributions like Ubuntu and Fedora; in everyday usage, the entire OS family is also called Linux","hi":"तकनीकी रूप से यह ओपन-सोर्स कर्नेल है जो Ubuntu और Fedora जैसे डिस्ट्रीब्यूशन्स का आधार है; आम भाषा में पूरे OS परिवार को भी Linux कहते हैं"},"o":[{"en":"Technically, Linux is the open-source OS kernel (created by Linus Torvalds) that forms the base of Linux distributions like Ubuntu and Fedora; in everyday usage, the entire OS family is also called Linux","hi":"तकनीकी रूप से यह ओपन-सोर्स कर्नेल है जो Ubuntu और Fedora जैसे डिस्ट्रीब्यूशन्स का आधार है; आम भाषा में पूरे OS परिवार को भी Linux कहते हैं"},{"en":"A proprietary spreadsheet application owned by Microsoft","hi":"माइक्रोसॉफ्ट के स्वामित्व वाला एक प्रोप्राइटरी स्प्रेडशीट एप्लिकेशन"},{"en":"A hardware laser printer manufactured by IBM","hi":"आईबीएम द्वारा निर्मित एक हार्डवेयर लेजर प्रिंटर"},{"en":"An antivirus plugin exclusively for Classic Mac OS","hi":"क्लासिक मैक ओएस के लिए विशेष रूप से एक एंटीवायरस प्लगइन"}],"exp":{"en":"Strictly speaking, Linux is the open-source operating system kernel initially released by Linus Torvalds in 1991. When packaged with system utilities, libraries, and desktop environments, it forms complete operating systems (Linux distributions or 'distros' like Ubuntu, Fedora, Debian), which are collectively referred to as Linux.","hi":"तकनीकी रूप से Linux एक ओपन-सोर्स कर्नेल (open-source kernel) है जो Ubuntu, Fedora और Debian जैसे लिनक्स डिस्ट्रीब्यूशन्स (distributions) का आधार है। आम बोलचाल में इस पूरे ऑपरेटिंग सिस्टम परिवार को भी Linux कहा जाता है।"},"num":73},{"id":"q74","q":{"en":"What factors matter in keeping a Linux system secure?","hi":"Linux सिस्टम को सुरक्षित (Secure) रखने में किन बातों का महत्व होता है?"},"a":{"en":"Proper user/file permissions, timely security updates/patches, and correct system configuration (actual security depends on deployment and maintenance)","hi":"उचित परमिशन्स, समय पर अपडेट्स और सही कॉन्फ़िगरेशन (वास्तविक सुरक्षा डिप्लॉयमेंट और रखरखाव पर निर्भर करती है)"},"o":[{"en":"Proper user/file permissions, timely security updates/patches, and correct system configuration (actual security depends on deployment and maintenance)","hi":"उचित परमिशन्स, समय पर अपडेट्स और सही कॉन्फ़िगरेशन (वास्तविक सुरक्षा डिप्लॉयमेंट और रखरखाव पर निर्भर करती है)"},{"en":"Linux is mágically immune to all misconfigurations even if root passwords are public","hi":"भले ही रूट पासवर्ड सार्वजनिक हों, लिनक्स जादुई रूप से सभी खतरों से मुक्त रहता है"},{"en":"Unplugging the monitor cable every night","hi":"हर रात मॉनिटर केबल को अनप्लग करना"},{"en":"Deleting the Linux kernel before connecting to the internet","hi":"इंटरनेट से कनेक्ट करने से पहले लिनक्स कर्नेल को डिलीट करना"}],"exp":{"en":"Linux's strong privilege separation and permission model contribute to security, but actual system security relies on proper user/file permissions, timely patching/updates, and sound administrative configuration.","hi":"Linux को सुरक्षित रखने में मज़बूत यूज़र/फ़ाइल परमिशन्स (permissions), समय पर सुरक्षा अपडेट्स (timely updates) और सही कॉन्फ़िगरेशन की मुख्य भूमिका होती है; वास्तविक सुरक्षा सिस्टम के डिप्लॉयमेंट और मेंटेनेंस पर निर्भर करती है।"},"num":74},{"id":"q75","q":{"en":"When and where did the development of the 'Unix' operating system begin?","hi":"'यूनिक्स' (Unix) ऑपरेटिंग सिस्टम का विकास कब और कहाँ शुरू हुआ?"},"a":{"en":"In 1969 at AT&T Bell Labs (by Ken Thompson, Dennis Ritchie, and colleagues)","hi":"1969 में बेल लैब्स (Bell Labs) में"},"o":[{"en":"In 1969 at AT&T Bell Labs (by Ken Thompson, Dennis Ritchie, and colleagues)","hi":"1969 में बेल लैब्स (Bell Labs) में"},{"en":"In 1995 at Microsoft headquarters in Redmond","hi":"1995 में माइक्रोसॉफ्ट मुख्यालय में"},{"en":"In 1890 at the U.S. Census Bureau","hi":"1890 में अमेरिकी जनगणना ब्यूरो में"},{"en":"In 2008 at the Open Handset Alliance","hi":"2008 में ओपन हैंडसेट अलायंस में"}],"exp":{"en":"The development of Unix began in 1969 at AT&T's Bell Laboratories, led by Ken Thompson, Dennis Ritchie, Douglas McIlroy, and Joe Ossanna.","hi":"Unix ऑपरेटिंग सिस्टम का विकास वर्ष 1969 में AT&T के बेल लैब्स (Bell Labs) में शुरू हुआ था।"},"num":75},{"id":"q76","q":{"en":"What is the expansion of 'UNICS' (associated with the early name of Unix) given in the chapter notes?","hi":"नोट्स में दिए गए 'UNICS' (जो Unix के शुरुआती नाम से जुड़ा है) का पूर्ण रूप क्या है?"},"a":{"en":"Uniplexed Information and Computing System","hi":"यूनिप्लेक्स्ड इन्फॉर्मेशन एंड कंप्यूटिंग सिस्टम (Uniplexed Information and Computing System)"},"o":[{"en":"Uniplexed Information and Computing System","hi":"यूनिप्लेक्स्ड इन्फॉर्मेशन एंड कंप्यूटिंग सिस्टम (Uniplexed Information and Computing System)"},{"en":"Universal Network for Integrated Computer Software","hi":"यूनिवर्सल नेटवर्क फॉर इंटीग्रेटेड कंप्यूटर सॉफ्टवेयर"},{"en":"United National Internet Communication Standard","hi":"यूनाइटेड नेशनल इंटरनेट कम्युनिकेशन स्टैंडर्ड"},{"en":"Ultra Numerical Integer Calculation System","hi":"अल्ट्रा न्यूमेरिकल इंटीजर कैलकुलेशन सिस्टम"}],"exp":{"en":"Before the spelling settled on 'UNIX', the system was originally called UNICS, standing for Uniplexed Information and Computing System (a pun on MULTICS).","hi":"Unix के प्रारंभिक नाम 'UNICS' का विस्तार Uniplexed Information and Computing System है।"},"num":76},{"id":"q77","q":{"en":"Which of the following is an example of the Unix OS family mentioned in the notes, and what was Microsoft's historical Unix variant?","hi":"नोट्स में उल्लेखित Unix परिवार का उदाहरण कौन-सा है, और माइक्रोसॉफ्ट का ऐतिहासिक Unix वेरिएंट कौन-सा था?"},"a":{"en":"Oracle Solaris is a Unix family example; Microsoft's historical licensed Unix variant was Xenix (whereas Microsoft Windows is a separate OS family)","hi":"Oracle Solaris एक Unix उदाहरण है; माइक्रोसॉफ्ट का ऐतिहासिक Unix वेरिएंट Xenix था (जबकि Microsoft Windows एक अलग OS परिवार है)"},"o":[{"en":"Oracle Solaris is a Unix family example; Microsoft's historical licensed Unix variant was Xenix (whereas Microsoft Windows is a separate OS family)","hi":"Oracle Solaris एक Unix उदाहरण है; माइक्रोसॉफ्ट का ऐतिहासिक Unix वेरिएंट Xenix था (जबकि Microsoft Windows एक अलग OS परिवार है)"},{"en":"MS-DOS is a Unix variant, and Android is Microsoft's Unix","hi":"MS-DOS एक यूनिक्स वेरिएंट है, और एंड्रॉइड माइक्रोसॉफ्ट का यूनिक्स है"},{"en":"CorelDRAW is a Unix OS, and WordStar was Microsoft's Unix","hi":"CorelDRAW एक यूनिक्स ओएस है, और WordStar माइक्रोसॉफ्ट का यूनिक्स था"},{"en":"BIOS is a Unix family OS","hi":"BIOS एक यूनिक्स परिवार का ओएस है"}],"exp":{"en":"Oracle Solaris (and IBM AIX, HP-UX) belongs to the Unix family. In the late 1970s/1980s, Microsoft licensed Unix from AT&T and developed a historical Unix variant called 'Xenix'—note that modern Microsoft Windows (NT family) is a completely separate operating system family.","hi":"Oracle Solaris यूनिक्स (Unix) परिवार का एक प्रमुख उदाहरण है। माइक्रोसॉफ्ट का ऐतिहासिक लाइसेंस प्राप्त Unix वेरिएंट 'Xenix' था, जबकि आधुनिक Microsoft Windows एक अलग OS परिवार है।"},"num":77},{"id":"q78","q":{"en":"In which years were Microsoft Windows 1.0 and MS-DOS (initial era) released?","hi":"माइक्रोसॉफ्ट का 'Windows 1.0' और 'MS-DOS' कब रिलीज़ हुए?"},"a":{"en":"Windows 1.0 was released in 1985, and the initial release era of MS-DOS dates to 1981","hi":"Windows 1.0 वर्ष 1985 में रिलीज़ हुआ, और MS-DOS का शुरुआती दौर 1981 से जोड़ा जाता है"},"o":[{"en":"Windows 1.0 was released in 1985, and the initial release era of MS-DOS dates to 1981","hi":"Windows 1.0 वर्ष 1985 में रिलीज़ हुआ, और MS-DOS का शुरुआती दौर 1981 से जोड़ा जाता है"},{"en":"Windows 1.0 was released in 1969, and MS-DOS in 2001","hi":"Windows 1.0 1969 में और MS-DOS 2001 में रिलीज़ हुआ"},{"en":"Both were released in 2010 alongside Windows Phone","hi":"दोनों को 2010 में विंडोज़ फोन के साथ रिलीज़ किया गया था"},{"en":"Windows 1.0 was released in 1956, and MS-DOS in 1946","hi":"Windows 1.0 1956 में और MS-DOS 1946 में रिलीज़ हुआ"}],"exp":{"en":"MS-DOS (Microsoft Disk Operating System) was introduced in 1981 with the IBM PC, and Microsoft shipped the first retail version of Windows 1.0 in November 1985.","hi":"माइक्रोसॉफ्ट का पहला ग्राफिकल वातावरण Windows 1.0 वर्ष 1985 में रिलीज़ हुआ, जबकि MS-DOS का प्रारंभिक रिलीज़ वर्ष 1981 है।"},"num":78},{"id":"q79","q":{"en":"What are the commercial release years for Chrome OS (first Chromebooks) and Windows Phone 7?","hi":"Chrome OS (पहले क्रोमबुक्स) और Windows Phone के रिलीज़ वर्ष क्या हैं?"},"a":{"en":"First commercial Chromebooks with Chrome OS arrived in 2011, and Windows Phone 7 launched in 2010","hi":"Chrome OS वाले पहले कमर्शियल क्रोमबुक्स 2011 में आए, और Windows Phone 7 वर्ष 2010 में लॉन्च हुआ"},"o":[{"en":"First commercial Chromebooks with Chrome OS arrived in 2011, and Windows Phone 7 launched in 2010","hi":"Chrome OS वाले पहले कमर्शियल क्रोमबुक्स 2011 में आए, और Windows Phone 7 वर्ष 2010 में लॉन्च हुआ"},{"en":"Chrome OS arrived in 1981, and Windows Phone in 1985","hi":"Chrome OS 1981 में आया, और Windows Phone 1985 में"},{"en":"Both were launched in 1969 at Bell Labs","hi":"दोनों को 1969 में बेल लैब्स में लॉन्च किया गया था"},{"en":"Chrome OS arrived in 1995, and Windows Phone in 1998","hi":"Chrome OS 1995 में आया, और Windows Phone 1998 में"}],"exp":{"en":"Microsoft launched Windows Phone 7 in late 2010, and Google's first commercial Chromebooks running Chrome OS went on sale in 2011 (after Chrome OS was announced in 2009).","hi":"Chrome OS के साथ पहले कमर्शियल क्रोमबुक्स वर्ष 2011 में आए, जबकि माइक्रोसॉफ्ट का Windows Phone 7 वर्ष 2010 में लॉन्च हुआ।"},"num":79},{"id":"q80","q":{"en":"What release years are listed in the chapter's historical OS table for BlackBerry OS and Firefox OS?","hi":"अध्याय की रिलीज़-वर्ष तालिका में BlackBerry OS और Firefox OS के लिए कौन-से ऐतिहासिक वर्ष दिए गए हैं?"},"a":{"en":"BlackBerry OS in 1999, and the first commercial Firefox OS phones in 2013 (both are historical mobile OS entries)","hi":"BlackBerry OS: 1999, और Firefox OS के पहले कमर्शियल फ़ोन: 2013 (ये ऐतिहासिक प्रविष्टियाँ हैं)"},"o":[{"en":"BlackBerry OS in 1999, and the first commercial Firefox OS phones in 2013 (both are historical mobile OS entries)","hi":"BlackBerry OS: 1999, और Firefox OS के पहले कमर्शियल फ़ोन: 2013 (ये ऐतिहासिक प्रविष्टियाँ हैं)"},{"en":"BlackBerry OS in 1946, and Firefox OS in 1951","hi":"BlackBerry OS 1946 में, और Firefox OS 1951 में"},{"en":"BlackBerry OS in 2022, and Firefox OS in 2024","hi":"BlackBerry OS 2022 में, और Firefox OS 2024 में"},{"en":"Both were released in 1984","hi":"दोनों 1984 में रिलीज़ हुए थे"}],"exp":{"en":"In the chapter's operating system timeline table, BlackBerry OS is associated with its debut in 1999, and Mozilla's Firefox OS is associated with the release of its first commercial smartphones in 2013.","hi":"अध्याय की तालिका के अनुसार BlackBerry OS का प्रारंभिक वर्ष 1999 है और Firefox OS के पहले व्यावसायिक फ़ोन 2013 में आए (दोनों अब ऐतिहासिक मोबाइल OS प्रविष्टियाँ हैं)।"},"num":80},{"id":"q81","q":{"en":"In the chapter's release-year table, which specific OS line does the year '2001' next to Mac OS refer to?","hi":"अध्याय की रिलीज़-वर्ष तालिका में Mac OS के सामने दिया गया वर्ष '2001' किस विशिष्ट लाइन को संदर्भित करता है?"},"a":{"en":"Mac OS X (whereas Apple's original Macintosh System Software arrived in 1984)","hi":"Mac OS X को (जबकि मूल Macintosh सिस्टम सॉफ्टवेयर 1984 में आया था)"},"o":[{"en":"Mac OS X (whereas Apple's original Macintosh System Software arrived in 1984)","hi":"Mac OS X को (जबकि मूल Macintosh सिस्टम सॉफ्टवेयर 1984 में आया था)"},{"en":"Apple DOS 3.1 for the Apple II computer","hi":"Apple II कंप्यूटर के लिए Apple DOS 3.1 को"},{"en":"iOS 1.0 for the first-generation iPhone","hi":"प्रथम पीढ़ी के iPhone के लिए iOS 1.0 को"},{"en":"Microsoft Xenix for 16-bit microcomputers","hi":"16-बिट माइक्रो कंप्यूटरों के लिए माइक्रोसॉफ्ट Xenix को"}],"exp":{"en":"In the chapter's release-year summary table, the year 2001 next to Mac OS refers specifically to the release of Mac OS X (while the original Macintosh System Software debuted in 1984).","hi":"अध्याय की रिलीज़-वर्ष तालिका में Mac OS के सामने लिखा वर्ष 2001 विशेष रूप से 'Mac OS X' के रिलीज़ को दर्शाता है (जबकि मूल Macintosh सिस्टम सॉफ्टवेयर 1984 में आया था)।"},"num":81}]},{"title":{"en":"7. Types of Operating Systems","hi":"7. ऑपरेटिंग सिस्टम के प्रकार"},"questions":[{"id":"q82","q":{"en":"What does a 'Batch Operating System' do?","hi":"'बैच ऑपरेटिंग सिस्टम' (Batch OS) क्या करता है?"},"a":{"en":"It groups similar jobs together and executes them as a batch, typically with minimal or no direct user interaction during execution","hi":"यह समान प्रकार के कार्यों (similar jobs) को समूह (batch) में रखकर रन करता है, जहाँ निष्पादन के दौरान यूज़र इंटरैक्शन कम होता है"},"o":[{"en":"It groups similar jobs together and executes them as a batch, typically with minimal or no direct user interaction during execution","hi":"यह समान प्रकार के कार्यों (similar jobs) को समूह (batch) में रखकर रन करता है, जहाँ निष्पादन के दौरान यूज़र इंटरैक्शन कम होता है"},{"en":"It requires the user to click the mouse after every single CPU clock cycle","hi":"इसमें प्रत्येक CPU क्लॉक साइकिल के बाद यूज़र को माउस क्लिक करना पड़ता है"},{"en":"It is used exclusively for controlling automotive airbag sensors in microseconds","hi":"इसका उपयोग केवल माइक्रोसेकंड में ऑटोमोटिव एयरबैग सेंसर को नियंत्रित करने के लिए होता है"},{"en":"It only runs on touchscreen smartphones","hi":"यह केवल टचस्क्रीन स्मार्टफोन पर चलता है"}],"exp":{"en":"A Batch Operating System collects similar jobs/programs together into batches and processes them sequentially without requiring interactive user intervention during execution.","hi":"बैच ऑपरेटिंग सिस्टम (Batch OS) एक जैसे कार्यों (similar jobs) को समूहित करके बैच में रन करता है, जिसमें आम तौर पर निष्पादन (execution) के दौरान सीधे यूज़र इंटरैक्शन की आवश्यकता बहुत कम होती है।"},"num":82},{"id":"q83","q":{"en":"How do users submit jobs in a traditional Batch Processing system?","hi":"पारंपरिक बैच प्रोसेसिंग (Batch Processing) में यूज़र्स जॉब्स कैसे सबमिट करते हैं?"},"a":{"en":"One or more users submit jobs into a queue; in a traditional sequential batch setup, the next job starts when the current job completes","hi":"एक या कई यूज़र्स जॉब्स को कतार (queue) में सबमिट कर सकते हैं; पारंपरिक अनुक्रमिक बैच सेटअप में एक जॉब पूरी होने पर अगली जॉब चलती है"},"o":[{"en":"One or more users submit jobs into a queue; in a traditional sequential batch setup, the next job starts when the current job completes","hi":"एक या कई यूज़र्स जॉब्स को कतार (queue) में सबमिट कर सकते हैं; पारंपरिक अनुक्रमिक बैच सेटअप में एक जॉब पूरी होने पर अगली जॉब चलती है"},{"en":"Users speak commands into a voice assistant in real time","hi":"यूज़र्स रियल टाइम में वॉयस असिस्टेंट में कमांड बोलते हैं"},{"en":"Only one job can ever be submitted per year","hi":"प्रति वर्ष केवल एक ही जॉब सबमिट की जा सकती है"},{"en":"Jobs are executed only while the user holds down the Enter key","hi":"जॉब्स केवल तभी चलती हैं जब यूज़र Enter कुंजी दबाए रखता है"}],"exp":{"en":"In batch processing, multiple users can submit their jobs into a batch queue. In a classic sequential batch system, the operating system processes one job from the queue and automatically starts the next job once the current one finishes.","hi":"बैच प्रोसेसिंग में एक या कई उपयोगकर्ता अपनी जॉब्स को कतार (queue) में सबमिट कर सकते हैं। पारंपरिक सीक्वेंशियल बैच सेटअप में जब एक जॉब पूरी हो जाती है, तब अगली जॉब स्वतः शुरू होती है।"},"num":83},{"id":"q84","q":{"en":"Which part of payroll and banking data processing is a classic example of Batch Processing?","hi":"पेरोल (Payroll) और बैंकिंग प्रोसेसिंग का कौन-सा भाग बैच प्रोसेसिंग का प्रमुख उदाहरण है?"},"a":{"en":"Monthly salary runs, overnight bank statements/reports, or scheduled bulk transaction processing","hi":"मासिक वेतन गणना (Monthly salary runs), रातों-रात बनने वाली बैंक रिपोर्ट्स या निर्धारित बल्क प्रोसेसिंग"},"o":[{"en":"Monthly salary runs, overnight bank statements/reports, or scheduled bulk transaction processing","hi":"मासिक वेतन गणना (Monthly salary runs), रातों-रात बनने वाली बैंक रिपोर्ट्स या निर्धारित बल्क प्रोसेसिंग"},{"en":"Deploying a car's anti-lock brake in 2 milliseconds","hi":"2 मिलीसेकंड में कार का एंटी-लॉक ब्रेक लगाना"},{"en":"Playing a live multiplayer 3D video game","hi":"लाइव मल्टीप्लेयर 3D वीडियो गेम खेलना"},{"en":"Moving the mouse pointer across the desktop screen","hi":"डेस्कटॉप स्क्रीन पर माउस पॉइंटर घुमाना"}],"exp":{"en":"Scheduled bulk operations that do not require immediate interactive feedback—such as monthly employee payroll/salary runs, end-of-day bank interest calculations, and overnight statement generation—are classic examples of batch processing.","hi":"मासिक वेतन गणना (monthly salary runs), रात के समय तैयार होने वाली बैंक रिपोर्ट्स (overnight bank reports) या पूर्व-निर्धारित बल्क प्रोसेसिंग बैच प्रोसेसिंग के सटीक उदाहरण हैं।"},"num":84},{"id":"q85","q":{"en":"What is the key requirement of a 'Real-Time Operating System' (RTOS)?","hi":"'रियल-टाइम ऑपरेटिंग सिस्टम' (RTOS) की सबसे मुख्य आवश्यकता (Key Requirement) क्या है?"},"a":{"en":"Delivering a deterministic, predictable response to an input or event within a strict required deadline (time constraint)","hi":"किसी इनपुट या घटना (event) का पूर्वानुमानित प्रतिसाद (predictable response) निर्धारित समय-सीमा (deadline) के भीतर मिलना"},"o":[{"en":"Delivering a deterministic, predictable response to an input or event within a strict required deadline (time constraint)","hi":"किसी इनपुट या घटना (event) का पूर्वानुमानित प्रतिसाद (predictable response) निर्धारित समय-सीमा (deadline) के भीतर मिलना"},{"en":"Having the largest hard disk capacity in terabytes","hi":"टेराबाइट्स में सबसे बड़ी हार्ड डिस्क क्षमता होना"},{"en":"Grouping jobs for next week's overnight batch run","hi":"अगले सप्ताह के ओवरनाइट बैच रन के लिए जॉब्स का समूह बनाना"},{"en":"Running only freeware and open-source web browsers","hi":"केवल फ्रीवेयर और ओपन-सोर्स वेब ब्राउज़र चलाना"}],"exp":{"en":"The defining requirement of a Real-Time Operating System (RTOS) is timeliness and predictability: it must process sensor inputs or events and produce a response within a guaranteed, bounded time deadline.","hi":"रियल-टाइम ऑपरेटिंग सिस्टम (RTOS) की मुख्य शर्त यह है कि किसी इनपुट या इवेंट पर निर्धारित समय-सीमा (required deadline) के भीतर सटीक और पूर्वानुमानित रिस्पॉन्स (predictable response) मिलना चाहिए।"},"num":85},{"id":"q86","q":{"en":"What is the fundamental difference between a 'Hard Real-Time' system and a 'Soft Real-Time' system?","hi":"'हार्ड रियल-टाइम' (Hard Real-Time) और 'सॉफ्ट रियल-टाइम' (Soft Real-Time) सिस्टम में मुख्य अंतर क्या है?"},"a":{"en":"In a hard real-time system, missing a deadline can cause critical system failure or safety hazards; in a soft real-time system, an occasional delay only degrades performance or quality","hi":"हार्ड रियल-टाइम में डेडलाइन मिस होने पर सिस्टम फेलियर या असुरक्षित परिणाम हो सकता है; सॉफ्ट रियल-टाइम में कभी-कभार देरी से केवल गुणवत्ता (quality) घटती है"},"o":[{"en":"In a hard real-time system, missing a deadline can cause critical system failure or safety hazards; in a soft real-time system, an occasional delay only degrades performance or quality","hi":"हार्ड रियल-टाइम में डेडलाइन मिस होने पर सिस्टम फेलियर या असुरक्षित परिणाम हो सकता है; सॉफ्ट रियल-टाइम में कभी-कभार देरी से केवल गुणवत्ता (quality) घटती है"},{"en":"Hard real-time runs on hard disks, whereas soft real-time runs on floppy disks","hi":"हार्ड रियल-टाइम हार्ड डिस्क पर चलता है, जबकि सॉफ्ट रियल-टाइम फ्लॉपी डिस्क पर चलता है"},{"en":"Hard real-time has no deadlines, whereas soft real-time explodes if delayed by 1 nanosecond","hi":"हार्ड रियल-टाइम की कोई समय-सीमा नहीं होती, जबकि सॉफ्ट रियल-टाइम में देरी बर्दाश्त नहीं होती"},{"en":"Hard real-time is used for video streaming, whereas soft real-time is used for car airbags","hi":"हार्ड रियल-टाइम वीडियो स्ट्रीमिंग के लिए और सॉफ्ट रियल-टाइम कार एयरबैग के लिए होता है"}],"exp":{"en":"In a Hard Real-Time system, deadlines are absolute—missing a deadline results in catastrophic system failure or safety risk (e.g., airbag deployment). In a Soft Real-Time system, meeting deadlines is important, but an occasional slight delay only causes a temporary drop in service quality (e.g., dropped frames in video preview/streaming).","hi":"हार्ड रियल-टाइम सिस्टम में डेडलाइन चूकने पर गंभीर सिस्टम विफलता या सुरक्षा जोखिम हो सकता है (जैसे कार का एयरबैग न खुलना)। इसके विपरीत, सॉफ्ट रियल-टाइम में कभी-कभार मामूली देरी होने से केवल आउटपुट की गुणवत्ता (quality) थोड़ी प्रभावित होती है (जैसे वीडियो प्रीव्यू में फ्रेम ड्रॉप होना)।"},"num":86},{"id":"q87","q":{"en":"Automotive airbag deployment, anti-lock braking systems (ABS), and engine-control units (ECUs) are examples of which real-time class?","hi":"ऑटोमोटिव एयरबैग, एंटी-लॉक ब्रेक (ABS) और इंजन-कंट्रोल सिस्टम किस श्रेणी के उदाहरण हैं?"},"a":{"en":"Hard real-time systems, because their safety-critical control tasks have strict deadlines that must not be missed","hi":"हार्ड रियल-टाइम (Hard real-time), क्योंकि इनके सुरक्षा-संबंधी (safety-critical) नियंत्रण कार्यों की डेडलाइन बेहद सख्त होती है"},"o":[{"en":"Hard real-time systems, because their safety-critical control tasks have strict deadlines that must not be missed","hi":"हार्ड रियल-टाइम (Hard real-time), क्योंकि इनके सुरक्षा-संबंधी (safety-critical) नियंत्रण कार्यों की डेडलाइन बेहद सख्त होती है"},{"en":"Offline sequential batch processing systems","hi":"ऑफ़लाइन सीक्वेंशियल बैच प्रोसेसिंग सिस्टम"},{"en":"Soft real-time desktop publishing systems","hi":"सॉफ्ट रियल-टाइम डेस्कटॉप पब्लिशिंग सिस्टम"},{"en":"Single-user MS-DOS command-line tools","hi":"सिंगल-यूज़र MS-DOS कमांड-लाइन टूल"}],"exp":{"en":"Safety-critical embedded control tasks such as automotive airbag triggers, Anti-lock Braking Systems (ABS), and flight/engine control units require Hard Real-Time guarantees because any delay past the deadline can endanger life.","hi":"कार के एयरबैग, एंटी-लॉक ब्रेक (ABS) और इंजन-कंट्रोल सिस्टम के सुरक्षा-संबंधी (safety-critical) कार्य 'हार्ड रियल-टाइम' (Hard real-time) श्रेणी के उदाहरण हैं, जहाँ डेडलाइन चूकना असुरक्षित हो सकता है।"},"num":87},{"id":"q88","q":{"en":"In what sense are digital cameras and mobile phones cited as 'Soft Real-Time' examples in the chapter?","hi":"डिजिटल कैमरा और मोबाइल फ़ोन को अध्याय में किस अर्थ में 'सॉफ्ट रियल-टाइम' (Soft Real-Time) का उदाहरण कहा गया है?"},"a":{"en":"Tasks like live camera viewfinder preview and audio/video playback have timing targets, but can tolerate an occasional minor timing slip without catastrophic failure","hi":"कैमरा प्रीव्यू और ऑडियो/वीडियो प्लेबैक जैसे कार्य कभी-कभार मामूली टाइमिंग देरी (timing slip) को बिना किसी गंभीर नुकसान के सहन कर सकते हैं"},"o":[{"en":"Tasks like live camera viewfinder preview and audio/video playback have timing targets, but can tolerate an occasional minor timing slip without catastrophic failure","hi":"कैमरा प्रीव्यू और ऑडियो/वीडियो प्लेबैक जैसे कार्य कभी-कभार मामूली टाइमिंग देरी (timing slip) को बिना किसी गंभीर नुकसान के सहन कर सकते हैं"},{"en":"Because mobile phones are made of soft plastic casings","hi":"क्योंकि मोबाइल फ़ोन नरम प्लास्टिक के आवरण से बने होते हैं"},{"en":"Because cameras process photos in monthly overnight batches","hi":"क्योंकि कैमरे मासिक ओवरनाइट बैच में फोटो प्रोसेस करते हैं"},{"en":"Because they have no operating system or processor inside","hi":"क्योंकि उनके अंदर कोई ऑपरेटिंग सिस्टम या प्रोसेसर नहीं होता"}],"exp":{"en":"Consumer multimedia tasks on cameras and smartphones—such as live camera preview, voice calls, and audio/video streaming—are Soft Real-Time tasks: they aim for smooth real-time delivery, but an occasional delayed frame merely causes a brief stutter rather than a safety hazard.","hi":"डिजिटल कैमरे में लाइव प्रीव्यू (camera preview) और मोबाइल फ़ोन में ऑडियो/वीडियो प्लेबैक जैसे कार्य कभी-कभार होने वाली मामूली टाइमिंग चूक (timing slip) को सहन कर सकते हैं; इससे केवल थोड़ा लैग आता है, कोई सुरक्षा खतरा नहीं होता—इसीलिए इन्हें सॉफ्ट रियल-टाइम उदाहरण माना जाता है।"},"num":88},{"id":"q89","q":{"en":"Why are Air Traffic Control (ATC) and Autonomous Driving systems classified under Real-Time systems?","hi":"एयर ट्रैफिक कंट्रोल (Air Traffic Control) और ऑटोनॉमस ड्राइविंग सिस्टम को रियल-टाइम सिस्टम क्यों कहा जाता है?"},"a":{"en":"Because sensor data processing and control decisions must have strictly bounded response times (exact deadlines depend on the specific function)","hi":"क्योंकि इनमें सेंसर डेटा और निर्णयों का रिस्पॉन्स टाइम समय-सीमा में बँधा (bounded) होना चाहिए"},"o":[{"en":"Because sensor data processing and control decisions must have strictly bounded response times (exact deadlines depend on the specific function)","hi":"क्योंकि इनमें सेंसर डेटा और निर्णयों का रिस्पॉन्स टाइम समय-सीमा में बँधा (bounded) होना चाहिए"},{"en":"Because they only print monthly paper reports at the end of the year","hi":"क्योंकि वे केवल वर्ष के अंत में मासिक कागजी रिपोर्ट प्रिंट करते हैं"},{"en":"Because they use manual abacus beads for navigation","hi":"क्योंकि वे नेविगेशन के लिए मैनुअल अबेकस मोतियों का उपयोग करते हैं"},{"en":"Because they operate without any sensors or computers","hi":"क्योंकि वे बिना किसी सेंसर या कंप्यूटर के काम करते हैं"}],"exp":{"en":"Air traffic control and autonomous (self-driving) vehicles continuously process live radar/sensor telemetry and make navigation/collision-avoidance decisions that must complete within strictly bounded real-time deadlines.","hi":"एयर ट्रैफिक कंट्रोल और सेल्फ-ड्राइविंग (autonomous driving) सिस्टम्स में लाइव सेंसर डेटा के विश्लेषण और नियंत्रण निर्णयों का रिस्पॉन्स टाइम सख्त समय-सीमा के भीतर (bounded) होना अनिवार्य है; इसलिए ये रियल-टाइम सिस्टम हैं।"},"num":89},{"id":"q90","q":{"en":"How does a 'Time-Sharing Operating System' distribute CPU time among tasks or users?","hi":"'टाइम-शेयरिंग ऑपरेटिंग सिस्टम' (Time-Sharing OS) CPU के समय को कैसे बाँटता है?"},"a":{"en":"By allocating short CPU time slices (time quanta) in rapid rotation to ready tasks or users, thereby improving interactive response","hi":"तैयार कार्यों (ready tasks) या यूज़र्स को छोटे-छोटे 'टाइम स्लाइस' (short time slices) देकर, जिससे इंटरैक्टिव रिस्पॉन्स बेहतर होता है"},"o":[{"en":"By allocating short CPU time slices (time quanta) in rapid rotation to ready tasks or users, thereby improving interactive response","hi":"तैयार कार्यों (ready tasks) या यूज़र्स को छोटे-छोटे 'टाइम स्लाइस' (short time slices) देकर, जिससे इंटरैक्टिव रिस्पॉन्स बेहतर होता है"},{"en":"By giving the CPU to one user for an entire month before switching","hi":"स्विच करने से पहले एक पूरे महीने के लिए एक यूज़र को CPU देकर"},{"en":"By physically cutting the microprocessor chip into smaller pieces","hi":"माइक्रोप्रोसेसर चिप को भौतिक रूप से छोटे टुकड़ों में काटकर"},{"en":"By disabling the keyboard and mouse for all users","hi":"सभी उपयोगकर्ताओं के लिए कीबोर्ड और माउस को निष्क्रिय करके"}],"exp":{"en":"A Time-Sharing (multitasking) OS switches the CPU rapidly among multiple active processes or users by giving each ready task a short time slot called a 'time slice' or 'quantum', creating the illusion of simultaneous interactive execution.","hi":"टाइम-शेयरिंग OS सक्रिय कार्यों (ready tasks) या उपयोगकर्ताओं को बारी-बारी से बहुत छोटे समय अंतराल अर्थात् 'टाइम स्लाइस' (short time slices / time quantum) आवंटित करता है, जिससे सभी को तेज़ इंटरैक्टिव रिस्पॉन्स मिलता है।"},"num":90},{"id":"q91","q":{"en":"Which operating systems are listed in the chapter as standard examples of Time-Sharing / Multitasking systems?","hi":"अध्याय में टाइम-शेयरिंग / मल्टीटास्किंग (Time-sharing/Multitasking) सिस्टम के कौन-से उदाहरण दिए गए हैं?"},"a":{"en":"Unix, Windows, and Linux","hi":"Unix, Windows और Linux"},"o":[{"en":"Unix, Windows, and Linux","hi":"Unix, Windows और Linux"},{"en":"Only 1981 single-tasking MS-DOS","hi":"केवल 1981 का सिंगल-टास्किंग MS-DOS"},{"en":"BIOS andMBR boot sectors","hi":"BIOS और MBR बूट सेक्टर"},{"en":"Notepad, WordPad, and Paint","hi":"Notepad, WordPad और Paint"}],"exp":{"en":"The chapter lists Unix, Microsoft Windows, and Linux as prime examples of time-sharing / multitasking operating systems.","hi":"टाइम-शेयरिंग और मल्टीटास्किंग ऑपरेटिंग सिस्टम के प्रमुख उदाहरण Unix, Windows और Linux हैं।"},"num":91},{"id":"q92","q":{"en":"What is the primary goal of 'Multiprogramming' in an operating system?","hi":"'मल्टीप्रोग्रामिंग' (Multiprogramming) का मुख्य उद्देश्य क्या है?"},"a":{"en":"To reduce CPU idle time (maximize CPU utilization) by keeping multiple jobs ready in memory so that when one job waits for I/O, another can run on the CPU","hi":"कई जॉब्स को मेमोरी में तैयार रखकर CPU का खाली समय (idle time) कम करना; जब एक जॉब I/O वेट में हो तो दूसरी रन कर सके"},"o":[{"en":"To reduce CPU idle time (maximize CPU utilization) by keeping multiple jobs ready in memory so that when one job waits for I/O, another can run on the CPU","hi":"कई जॉब्स को मेमोरी में तैयार रखकर CPU का खाली समय (idle time) कम करना; जब एक जॉब I/O वेट में हो तो दूसरी रन कर सके"},{"en":"To keep the CPU idle 99% of the time to save electricity","hi":"बिजली बचाने के लिए 99% समय CPU को खाली रखना"},{"en":"To connect 100 external monitors to a single graphics card","hi":"एक ही ग्राफिक्स कार्ड से 100 बाहरी मॉनिटर जोड़ना"},{"en":"To write the same program in five different programming languages","hi":"एक ही प्रोग्राम को पाँच अलग-अलग प्रोग्रामिंग भाषाओं में लिखना"}],"exp":{"en":"The main objective of multiprogramming is to maximize CPU utilization (minimize CPU idle time). By keeping several jobs in main memory simultaneously, whenever the currently running job blocks waiting for slow I/O (disk/printer), the OS switches the CPU to another ready job in memory.","hi":"मल्टीप्रोग्रामिंग का मुख्य लक्ष्य कई जॉब्स को मेमोरी में तैयार रखकर CPU के खाली बैठने के समय (idle time) को कम करना है। यदि एक जॉब इनपुट/आउटपुट (I/O) के इंतज़ार में रुकती है, तो CPU तुरंत दूसरी जॉब को रन करने लगता है।"},"num":92},{"id":"q93","q":{"en":"What is the standard exam distinction between 'Time-Sharing' and 'Multiprogramming'?","hi":"परीक्षा की दृष्टि से 'टाइम-शेयरिंग' (Time-sharing) और 'मल्टीप्रोग्रामिंग' (Multiprogramming) में मुख्य अंतर क्या है?"},"a":{"en":"Time-sharing focuses on fast interactive response via frequent time-slicing, whereas multiprogramming focuses on maximizing CPU utilization when jobs wait for I/O","hi":"टाइम-शेयरिंग इंटरैक्टिव रिस्पॉन्स (interactive response) पर केंद्रित होता है, जबकि मल्टीप्रोग्रामिंग CPU उपयोगिता (CPU utilization) बढ़ाने पर केंद्रित होता है"},"o":[{"en":"Time-sharing focuses on fast interactive response via frequent time-slicing, whereas multiprogramming focuses on maximizing CPU utilization when jobs wait for I/O","hi":"टाइम-शेयरिंग इंटरैक्टिव रिस्पॉन्स (interactive response) पर केंद्रित होता है, जबकि मल्टीप्रोग्रामिंग CPU उपयोगिता (CPU utilization) बढ़ाने पर केंद्रित होता है"},{"en":"Time-sharing uses only punched cards, whereas multiprogramming uses voice assistants","hi":"टाइम-शेयरिंग केवल पंच कार्ड का उपयोग करता है, जबकि मल्टीप्रोग्रामिंग वॉयस असिस्टेंट का उपयोग करता है"},{"en":"Multiprogramming requires 100 separate computers over a WAN, whereas time-sharing runs without RAM","hi":"मल्टीप्रोग्रामिंग को WAN पर 100 कंप्यूटरों की आवश्यकता होती है, जबकि टाइम-शेयरिंग बिना RAM के चलता है"},{"en":"There is no difference; both mean single-tasking batch processing","hi":"कोई अंतर नहीं है; दोनों का अर्थ सिंगल-टास्किंग बैच प्रोसेसिंग है"}],"exp":{"en":"Exam cue: Multiprogramming is centered on keeping the CPU busy (maximizing CPU utilization by switching on I/O waits), whereas Time-Sharing (a logical extension of multiprogramming) is centered on minimizing user response time through rapid pre-emptive time slices.","hi":"परीक्षा के लिए मुख्य अंतर: टाइम-शेयरिंग का मुख्य फोकस छोटे टाइम-स्लाइस के ज़रिए त्वरित 'इंटरैक्टिव रिस्पॉन्स' (interactive response) देने पर होता है, जबकि मल्टीप्रोग्रामिंग का मुख्य फोकस 'CPU यूटिलाइजेशन' (CPU को खाली न बैठने देने) पर होता है।"},"num":93},{"id":"q94","q":{"en":"What is 'Multiprocessing', and how is it related to system throughput?","hi":"'मल्टीप्रोसेसिंग' (Multiprocessing) क्या है और यह थ्रूपुट (Throughput) से कैसे जुड़ा है?"},"a":{"en":"The use of two or more processors or CPU cores within a single computer system, allowing more work to be completed in parallel (increasing throughput)","hi":"एक ही कंप्यूटर सिस्टम में दो या अधिक प्रोसेसर या कोर का उपयोग, जिससे उपयुक्त वर्कलोड में अधिक कार्य समानांतर (parallel) रूप से पूरा हो सकता है"},"o":[{"en":"The use of two or more processors or CPU cores within a single computer system, allowing more work to be completed in parallel (increasing throughput)","hi":"एक ही कंप्यूटर सिस्टम में दो या अधिक प्रोसेसर या कोर का उपयोग, जिससे उपयुक्त वर्कलोड में अधिक कार्य समानांतर (parallel) रूप से पूरा हो सकता है"},{"en":"Running two programs one after another on a single-core calculator","hi":"सिंगल-कोर कैलकुलेटर पर एक के बाद एक दो प्रोग्राम चलाना"},{"en":"Printing multiple copies of a document on a dot matrix printer","hi":"डॉट मैट्रिक्स प्रिंटर पर किसी दस्तावेज़ की कई प्रतियाँ प्रिंट करना"},{"en":"Connecting two keyboards to a single USB port","hi":"एक ही USB पोर्ट से दो कीबोर्ड जोड़ना"}],"exp":{"en":"Multiprocessing refers to a computer system having two or more CPUs or processing cores sharing main memory, enabling true parallel execution of tasks and increasing overall system throughput.","hi":"एक ही कंप्यूटर सिस्टम में दो या अधिक प्रोसेसर अथवा कोर (cores) के उपयोग को 'मल्टीप्रोसेसिंग' कहते हैं। इससे एक साथ समानांतर (parallel) रूप में अधिक काम पूरा होता है, जिससे सिस्टम का थ्रूपुट (throughput) बढ़ता है।"},"num":94},{"id":"q95","q":{"en":"What is a 'Distributed System'?","hi":"'डिस्ट्रीब्यूटेड सिस्टम' (Distributed System) क्या होता है?"},"a":{"en":"Multiple autonomous networked computers that coordinate over a network to share workloads or resources (such as accessing remote files or distributed processing)","hi":"नेटवर्क से जुड़े कई अलग-अलग कंप्यूटर जो आपस में समन्वय करके वर्कलोड या संसाधन (जैसे रिमोट फ़ाइलें) साझा करते हैं"},"o":[{"en":"Multiple autonomous networked computers that coordinate over a network to share workloads or resources (such as accessing remote files or distributed processing)","hi":"नेटवर्क से जुड़े कई अलग-अलग कंप्यूटर जो आपस में समन्वय करके वर्कलोड या संसाधन (जैसे रिमोट फ़ाइलें) साझा करते हैं"},{"en":"A single desktop PC with two RAM sticks installed on the same motherboard","hi":"एक ही मदरबोर्ड पर दो RAM स्टिक लगा हुआ एक एकल डेस्कटॉप पीसी"},{"en":"A standalone pocket calculator running on solar cells","hi":"सौर सेल पर चलने वाला एक स्टैंडअलोन पॉकेट कैलकुलेटर"},{"en":"An offline printer connected via a 25-pin parallel cable","hi":"25-पिन पैरेलल केबल के माध्यम से जुड़ा एक ऑफ़लाइन प्रिंटर"}],"exp":{"en":"A Distributed Operating System / Distributed System manages a collection of independent, networked computers (nodes) and makes them coordinate to share computation workloads, storage, and remote files/resources.","hi":"डिस्ट्रीब्यूटेड सिस्टम में नेटवर्क से जुड़े कई स्वतंत्र कंप्यूटर आपस में समन्वय (coordinate) करके वर्कलोड या संसाधनों (जैसे रिमोट फ़ाइलों को एक्सेस करना) को साझा करते हैं।"},"num":95},{"id":"q96","q":{"en":"What is the key architectural difference between 'Multiprocessing' and 'Distributed Computing'?","hi":"'मल्टीप्रोसेसिंग' (Multiprocessing) और 'डिस्ट्रीब्यूटेड कंप्यूटिंग' (Distributed Computing) में मुख्य अंतर क्या है?"},"a":{"en":"Multiprocessing uses multiple processors/cores within one computer system, whereas distributed computing coordinates multiple separate computers connected over a network","hi":"मल्टीप्रोसेसिंग एक ही सिस्टम के प्रोसेसर्स/कोर पर केंद्रित है, जबकि डिस्ट्रीब्यूटेड कंप्यूटिंग नेटवर्क से जुड़े कई अलग सिस्टमों पर"},"o":[{"en":"Multiprocessing uses multiple processors/cores within one computer system, whereas distributed computing coordinates multiple separate computers connected over a network","hi":"मल्टीप्रोसेसिंग एक ही सिस्टम के प्रोसेसर्स/कोर पर केंद्रित है, जबकि डिस्ट्रीब्यूटेड कंप्यूटिंग नेटवर्क से जुड़े कई अलग सिस्टमों पर"},{"en":"Multiprocessing uses multiple separate computers across the internet, whereas distributed computing uses a single core on one chip","hi":"मल्टीप्रोसेसिंग इंटरनेट पर कई कंप्यूटरों का उपयोग करता है, जबकि डिस्ट्रीब्यूटेड कंप्यूटिंग एक चिप पर एकल कोर का उपयोग करता है"},{"en":"Both refer exclusively to single-core vacuum-tube mainframes","hi":"दोनों केवल सिंगल-कोर वैक्यूम-ट्यूब मेनफ्रेम को संदर्भित करते हैं"},{"en":"Multiprocessing is software, whereas distributed computing is a monitor cable","hi":"मल्टीप्रोसेसिंग सॉफ्टवेयर है, जबकि डिस्ट्रीब्यूटेड कंप्यूटिंग एक मॉनिटर केबल है"}],"exp":{"en":"Diagram distinction (PDF p. 64): Multiprocessing happens inside *one* computer system equipped with multiple CPU cores/processors (Core A + Core B sharing local buses/memory), whereas Distributed Computing spans *multiple* separate computers (PC A, PC B, etc.) linked across a communication network.","hi":"मुख्य अंतर: मल्टीप्रोसेसिंग एक ही कंप्यूटर सिस्टम के भीतर मौजूद कई प्रोसेसर्स या कोर (Core A + Core B) पर आधारित होती है, जबकि डिस्ट्रीब्यूटेड कंप्यूटिंग नेटवर्क से जुड़े कई अलग-अलग कंप्यूटर सिस्टमों (PC A, PC B) के समन्वय पर आधारित होती है।"},"num":96},{"id":"q97","q":{"en":"In a Distributed System, can service continue if one individual node/machine fails?","hi":"क्या डिस्ट्रीब्यूटेड सिस्टम में एक नोड (कंप्यूटर) फेल होने पर भी सेवा चालू रह सकती है?"},"a":{"en":"Yes, if the system design supports redundancy and failover (though failure of a critical shared dependency can still affect service)","hi":"हाँ, यदि सिस्टम का डिज़ाइन रिडंडेंसी (redundancy) और फेलओवर सपोर्ट करे (हालाँकि साझा निर्भरता फेल होने से सेवा प्रभावित भी हो सकती है)"},"o":[{"en":"Yes, if the system design supports redundancy and failover (though failure of a critical shared dependency can still affect service)","hi":"हाँ, यदि सिस्टम का डिज़ाइन रिडंडेंसी (redundancy) और फेलओवर सपोर्ट करे (हालाँकि साझा निर्भरता फेल होने से सेवा प्रभावित भी हो सकती है)"},{"en":"No — if one mouse unplugs in Tokyo, every computer in the world permanently melts","hi":"नहीं — यदि एक भी नोड रुक जाए तो दुनिया के सभी कंप्यूटर स्थायी रूप से खराब हो जाते हैं"},{"en":"No — distributed systems have zero fault tolerance by definition","hi":"नहीं — डिस्ट्रीब्यूटेड सिस्टम में फॉल्ट टॉलरेंस कभी नहीं हो सकता"},{"en":"Yes — because distributed systems do not use networks or electricity","hi":"हाँ — क्योंकि डिस्ट्रीब्यूटेड सिस्टम नेटवर्क या बिजली का उपयोग नहीं करते"}],"exp":{"en":"A well-designed distributed system with replication, redundancy, and failover mechanisms can continue providing service even if an individual node fails, by routing tasks to surviving nodes.","hi":"हाँ, यदि डिस्ट्रीब्यूटेड सिस्टम का डिज़ाइन रिडंडेंसी (redundancy) और फेलओवर (failover) को सपोर्ट करता है, तो एक नोड खराब होने पर भी अन्य नोड्स के माध्यम से सेवा चालू रह सकती है।"},"num":97},{"id":"q98","q":{"en":"What is an 'Embedded Operating System', and what example does the chapter provide?","hi":"'एम्बेडेड ऑपरेटिंग सिस्टम' (Embedded OS) क्या होता है और अध्याय में इसका क्या उदाहरण दिया गया है?"},"a":{"en":"A compact OS built inside a larger device or machine to control dedicated functions; the chapter gives an ATM (Automated Teller Machine) as an example","hi":"किसी बड़े उपकरण के अंदर समर्पित कार्यों (dedicated functions) को नियंत्रित करने के लिए बना OS; अध्याय में ATM का उदाहरण दिया गया है"},"o":[{"en":"A compact OS built inside a larger device or machine to control dedicated functions; the chapter gives an ATM (Automated Teller Machine) as an example","hi":"किसी बड़े उपकरण के अंदर समर्पित कार्यों (dedicated functions) को नियंत्रित करने के लिए बना OS; अध्याय में ATM का उदाहरण दिया गया है"},{"en":"A general-purpose OS used only for writing novels in MS Word","hi":"केवल MS Word में उपन्यास लिखने के लिए प्रयुक्त एक सामान्य-उद्देश्य OS"},{"en":"A supercomputer OS that occupies three buildings","hi":"तीन इमारतों में फैला एक सुपर कंप्यूटर OS"},{"en":"A web browser extension for blocking pop-up ads","hi":"पॉप-अप विज्ञापनों को रोकने के लिए एक वेब ब्राउज़र एक्सटेंशन"}],"exp":{"en":"An Embedded OS is a specialized, resource-efficient operating system integrated into a larger electronic device or appliance to control specific dedicated hardware functions—such as inside an ATM, smart appliance, router, or industrial controller.","hi":"किसी बड़े उपकरण या मशीन के अंदर विशेष समर्पित कार्यों (dedicated functions) को नियंत्रित करने के लिए बनाए गए ऑपरेटिंग सिस्टम को 'एम्बेडेड OS' कहते हैं। अध्याय में इसके लिए ATM मशीन का उदाहरण दिया गया है।"},"num":98},{"id":"q99","q":{"en":"What is the primary function of a 'Network Operating System' (NOS)?","hi":"'नेटवर्क ऑपरेटिंग सिस्टम' (Network OS) का मुख्य कार्य क्या है?"},"a":{"en":"To manage network resources and services such as multi-user access, shared files, shared printers, and security permissions across networked server and client devices","hi":"नेटवर्क पर यूज़र एक्सेस, फ़ाइल शेयरिंग, प्रिंटर और परमिशन्स जैसी सेवाएँ मैनेज करना (जहाँ सर्वर और क्लाइंट भूमिकाएँ साझा करते हैं)"},"o":[{"en":"To manage network resources and services such as multi-user access, shared files, shared printers, and security permissions across networked server and client devices","hi":"नेटवर्क पर यूज़र एक्सेस, फ़ाइल शेयरिंग, प्रिंटर और परमिशन्स जैसी सेवाएँ मैनेज करना (जहाँ सर्वर और क्लाइंट भूमिकाएँ साझा करते हैं)"},{"en":"To operate an offline mechanical typewriter without electricity","hi":"बिना बिजली के ऑफ़लाइन यांत्रिक टाइपराइटर चलाना"},{"en":"To erase UV-EPROM chips using ultraviolet lamps","hi":"पराबैंगनी लैंप का उपयोग करके UV-EPROM चिप्स को मिटाना"},{"en":"To cool down the power supply fan","hi":"पावर सप्लाई फैन को ठंडा करना"}],"exp":{"en":"A Network Operating System (NOS) runs on a server and enables networked client computers to share files, databases, printers, applications, and centralized security/directory services.","hi":"नेटवर्क ऑपरेटिंग सिस्टम (Network OS) का काम नेटवर्क से जुड़े कंप्यूटरों के बीच यूज़र एक्सेस, फ़ाइल शेयरिंग, प्रिंटर शेयरिंग और सुरक्षा परमिशन्स जैसी सेवाओं का प्रबंधन करना है।"},"num":99},{"id":"q100","q":{"en":"How does a Network Operating System manage multi-user access across a network?","hi":"नेटवर्क ऑपरेटिंग सिस्टम (Network OS) मल्टी-यूज़र एक्सेस को कैसे मैनेज करता है?"},"a":{"en":"Through user accounts, authentication (login verification), and shared-resource access permissions","hi":"यूज़र अकाउंट्स, ऑथेंटिकेशन (प्रमाणीकरण) और शेयर्ड-रिसोर्स परमिशन्स के माध्यम से"},"o":[{"en":"Through user accounts, authentication (login verification), and shared-resource access permissions","hi":"यूज़र अकाउंट्स, ऑथेंटिकेशन (प्रमाणीकरण) और शेयर्ड-रिसोर्स परमिशन्स के माध्यम से"},{"en":"By giving every anonymous visitor unrestricted physical access to the server room","hi":"हर अज्ञात आगंतुक को सर्वर रूम में बिना किसी रोक-टोक के प्रवेश देकर"},{"en":"By disconnecting the network cable whenever a second user logs in","hi":"जब भी कोई दूसरा यूज़र लॉग इन करता है तो नेटवर्क केबल को डिस्कनेक्ट करके"},{"en":"By formatting the hard drive after each login","hi":"प्रत्येक लॉगिन के बाद हार्ड ड्राइव को फ़ॉर्मेट करके"}],"exp":{"en":"A Network OS controls multi-user access by maintaining centralized user accounts, enforcing authentication (usernames, passwords, tokens), and applying role-based permissions/access control lists (ACLs) to shared folders and printers.","hi":"नेटवर्क ऑपरेटिंग सिस्टम अलग-अलग यूज़र अकाउंट्स (accounts), ऑथेंटिकेशन (authentication) और साझा संसाधनों की परमिशन्स (shared-resource permissions) की मदद से सुरक्षित मल्टी-यूज़र एक्सेस का प्रबंधन करता है।"},"num":100},{"id":"q101","q":{"en":"For which devices is a 'Mobile Operating System' designed, and what are its most common examples?","hi":"'मोबाइल ऑपरेटिंग सिस्टम' (Mobile OS) किन उपकरणों के लिए बना है और इसके सामान्य उदाहरण कौन-से हैं?"},"a":{"en":"Designed for portable handheld devices such as smartphones and tablets; Android and iOS are the most common examples","hi":"स्मार्टफोन और टैबलेट जैसे पोर्टेबल उपकरणों के लिए; Android और iOS इसके सामान्य उदाहरण हैं"},"o":[{"en":"Designed for portable handheld devices such as smartphones and tablets; Android and iOS are the most common examples","hi":"स्मार्टफोन और टैबलेट जैसे पोर्टेबल उपकरणों के लिए; Android और iOS इसके सामान्य उदाहरण हैं"},{"en":"Designed for 30-ton room-sized vacuum-tube computers; ENIAC and UNIVAC are examples","hi":"30-टन कमरे के आकार के वैक्यूम-ट्यूब कंप्यूटरों के लिए; ENIAC और UNIVAC उदाहरण हैं"},{"en":"Designed only for non-portable ATM kiosks and heavy CNC lathes","hi":"केवल गैर-पोर्टेबल एटीएम कियोस्क और भारी सीएनसी खराद मशीनों के लिए"},{"en":"Designed only for 25-pin parallel dot matrix printers","hi":"केवल 25-पिन पैरेलल डॉट मैट्रिक्स प्रिंटर के लिए"}],"exp":{"en":"A Mobile OS is specifically engineered for portable, battery-powered touchscreen devices like smartphones, tablets, and wearables—integrating cellular/wireless connectivity, touch gestures, and power management. Android and Apple iOS are the leading examples.","hi":"मोबाइल ऑपरेटिंग सिस्टम स्मार्टफोन और टैबलेट जैसे पोर्टेबल हैंडहेल्ड उपकरणों के लिए डिज़ाइन किया गया है। Google का Android और Apple का iOS इसके सबसे प्रमुख उदाहरण हैं।"},"num":101}]},{"title":{"en":"8. Windows Shortcuts & Version Order","hi":"8. विंडोज शॉर्टकट और संस्करण क्रम"},"questions":[{"id":"q102","q":{"en":"What does the Windows keyboard shortcut 'Win + Print Screen' (Win + PrtScn) do?","hi":"विंडोज़ कीबोर्ड शॉर्टकट 'Win + Print Screen' क्या करता है?"},"a":{"en":"Captures a full-screen screenshot and automatically saves it as an image file (typically in the Pictures > Screenshots folder)","hi":"पूरी स्क्रीन का स्क्रीनशॉट कैप्चर करके उसे आम सेटअप में 'Pictures > Screenshots' फ़ोल्डर में सेव करता है"},"o":[{"en":"Captures a full-screen screenshot and automatically saves it as an image file (typically in the Pictures > Screenshots folder)","hi":"पूरी स्क्रीन का स्क्रीनशॉट कैप्चर करके उसे आम सेटअप में 'Pictures > Screenshots' फ़ोल्डर में सेव करता है"},{"en":"Sends the current webpage directly to a dot matrix printer","hi":"वर्तमान वेबपेज को सीधे डॉट मैट्रिक्स प्रिंटर पर भेजता है"},{"en":"Turns off the computer monitor permanently","hi":"कंप्यूटर मॉनिटर को स्थायी रूप से बंद कर देता है"},{"en":"Deletes all photos from the Pictures folder","hi":"Pictures फ़ोल्डर से सभी तस्वीरें हटा देता है"}],"exp":{"en":"Pressing the Windows logo key + Print Screen (Win + PrtScn) captures a screenshot of the entire screen and automatically saves it as a PNG file in the `Pictures > Screenshots` folder.","hi":"'Win + Print Screen' दबाने पर पूरी स्क्रीन का स्क्रीनशॉट कैप्चर होता है और सामान्य विंडोज़ सेटअप में स्वतः ही `Pictures > Screenshots` फ़ोल्डर में एक इमेज फ़ाइल के रूप में सेव हो जाता है।"},"num":102},{"id":"q103","q":{"en":"What does the Windows keyboard shortcut 'Win + Pause/Break' open?","hi":"विंडोज़ कीबोर्ड शॉर्टकट 'Win + Pause/Break' क्या खोलता है?"},"a":{"en":"System Information / System Properties (opens the System > About settings page in modern Windows)","hi":"सिस्टम इन्फॉर्मेशन (आधुनिक विंडोज़ में यह Settings का 'About' पेज खोलता है)"},"o":[{"en":"System Information / System Properties (opens the System > About settings page in modern Windows)","hi":"सिस्टम इन्फॉर्मेशन (आधुनिक विंडोज़ में यह Settings का 'About' पेज खोलता है)"},{"en":"The Recycle Bin folder","hi":"रीसायकल बिन फ़ोल्डर"},{"en":"The Paint drawing application","hi":"पेंट ड्रॉइंग एप्लिकेशन"},{"en":"The calculator app","hi":"कैलकुलेटर ऐप"}],"exp":{"en":"Pressing Win + Pause/Break opens the System Properties dialog (or the `Settings > System > About` page in Windows 10/11), showing processor, RAM, and Windows edition details.","hi":"'Win + Pause/Break' शॉर्टकट कंप्यूटर की 'System Information' (आधुनिक विंडोज़ में Settings का 'About' पेज, जहाँ CPU, RAM और OS विवरण दिखता है) खोलता है।"},"num":103},{"id":"q104","q":{"en":"What does the Windows keyboard shortcut 'Win + E' open?","hi":"विंडोज़ कीबोर्ड शॉर्टकट 'Win + E' क्या खोलता है?"},"a":{"en":"File Explorer (formerly Windows Explorer)","hi":"फ़ाइल एक्सप्लोरर (File Explorer)"},"o":[{"en":"File Explorer (formerly Windows Explorer)","hi":"फ़ाइल एक्सप्लोरर (File Explorer)"},{"en":"Microsoft Excel","hi":"माइक्रोसॉफ्ट एक्सेल"},{"en":"Event Viewer log utility","hi":"इवेंट व्यूअर लॉग यूटिलिटी"},{"en":"The Eject menu for optical drives","hi":"ऑप्टिकल ड्राइव के लिए इजेक्ट मेनू"}],"exp":{"en":"Pressing the Windows logo key + E (`Win + E`) immediately opens a new File Explorer window.","hi":"'Win + E' शॉर्टकट सीधे विंडोज़ का 'फ़ाइल एक्सप्लोरर' (File Explorer) खोलता है।"},"num":104},{"id":"q105","q":{"en":"What does the Windows keyboard shortcut 'Win + L' do?","hi":"विंडोज़ कीबोर्ड शॉर्टकट 'Win + L' क्या करता है?"},"a":{"en":"Locks the PC screen or takes the user to the account-switch / lock screen","hi":"पीसी को लॉक (Lock) करता है या अकाउंट-स्विच स्क्रीन पर ले जाता है"},"o":[{"en":"Locks the PC screen or takes the user to the account-switch / lock screen","hi":"पीसी को लॉक (Lock) करता है या अकाउंट-स्विच स्क्रीन पर ले जाता है"},{"en":"Logs out and uninstalls Windows","hi":"लॉग आउट करता है और विंडोज़ को अनइंस्टॉल कर देता है"},{"en":"Left-aligns all desktop icons","hi":"सभी डेस्कटॉप आइकन्स को बाईं ओर संरेखित करता है"},{"en":"Launches LibreOffice Writer","hi":"लिब्रेऑफिस राइटर लॉन्च करता है"}],"exp":{"en":"Pressing the Windows logo key + L (`Win + L`) immediately locks the computer screen (displaying the lock/sign-in screen) or allows switching user accounts.","hi":"'Win + L' शॉर्टकट तुरंत पीसी को लॉक (Lock) कर देता है या यूज़र को अकाउंट-स्विच स्क्रीन पर ले जाता है।"},"num":105},{"id":"q106","q":{"en":"What does the Windows keyboard shortcut 'Win + M' do?","hi":"विंडोज़ कीबोर्ड शॉर्टकट 'Win + M' क्या करता है?"},"a":{"en":"Minimizes all open windows that support minimizing","hi":"मिनिमाइज़ होने वाली सभी खुली विंडोज़ को मिनिमाइज़ (Minimize) करता है"},"o":[{"en":"Minimizes all open windows that support minimizing","hi":"मिनिमाइज़ होने वाली सभी खुली विंडोज़ को मिनिमाइज़ (Minimize) करता है"},{"en":"Maximizes the active browser tab to full screen","hi":"सक्रिय ब्राउज़र टैब को फुल स्क्रीन में मैक्सिमाइज़ करता है"},{"en":"Mutes the system microphone","hi":"सिस्टम माइक्रोफोन को म्यूट करता है"},{"en":"Opens the Windows Magnifier accessibility tool","hi":"विंडोज़ मैग्निफ़ायर टूल खोलता है"}],"exp":{"en":"Pressing the Windows logo key + M (`Win + M`) minimizes all currently open application windows to the taskbar.","hi":"'Win + M' शॉर्टकट स्क्रीन पर खुली सभी मिनिमाइज़ होने योग्य विंडोज़ को एक साथ मिनिमाइज़ (Minimize) कर देता है।"},"num":106},{"id":"q107","q":{"en":"What does the Windows keyboard shortcut 'Win + D' do?","hi":"विंडोज़ कीबोर्ड शॉर्टकट 'Win + D' क्या करता है?"},"a":{"en":"Shows and hides the Desktop (toggles between the desktop view and open windows)","hi":"डेस्कटॉप को शो या हाइड (Show/Hide Desktop) करता है"},"o":[{"en":"Shows and hides the Desktop (toggles between the desktop view and open windows)","hi":"डेस्कटॉप को शो या हाइड (Show/Hide Desktop) करता है"},{"en":"Deletes the currently active window permanently","hi":"वर्तमान में सक्रिय विंडो को स्थायी रूप से हटा देता है"},{"en":"Opens the Device Manager utility","hi":"डिवाइस मैनेजर यूटिलिटी खोलता है"},{"en":"Disconnects the Wi-Fi network adapter","hi":"वाई-फाई नेटवर्क एडेप्टर को डिस्कनेक्ट करता है"}],"exp":{"en":"Pressing the Windows logo key + D (`Win + D`) toggles the Desktop: pressing it once hides/minimizes all open windows to show the desktop, and pressing it again restores those windows.","hi":"'Win + D' शॉर्टकट डेस्कटॉप को दिखाता या छिपाता (Desktop show/hide) है—इसे दबाने से सभी खुली विंडोज़ के पीछे का डेस्कटॉप तुरंत सामने आ जाता है और दोबारा दबाने पर विंडोज़ वापस आ जाती हैं।"},"num":107},{"id":"q108","q":{"en":"What does pressing 'Win + Number' (e.g., Win + 1, Win + 2, Win + 3) do in Windows?","hi":"विंडोज़ में 'Win + Number' (जैसे Win + 1 या Win + 2) दबाने से क्या होता है?"},"a":{"en":"It opens the pinned app or activates the running app at that corresponding position on the Taskbar (e.g., Win + 1 for the first taskbar position)","hi":"टास्कबार की पोजिशन के हिसाब से पिन किए गए ऐप को खोलता है या चल रहे ऐप को एक्टिवेट करता है (जैसे Win + 1 पहली पोजिशन के लिए)"},"o":[{"en":"It opens the pinned app or activates the running app at that corresponding position on the Taskbar (e.g., Win + 1 for the first taskbar position)","hi":"टास्कबार की पोजिशन के हिसाब से पिन किए गए ऐप को खोलता है या चल रहे ऐप को एक्टिवेट करता है (जैसे Win + 1 पहली पोजिशन के लिए)"},{"en":"It changes the screen brightness from 10% to 100%","hi":"यह स्क्रीन की ब्राइटनेस को 10% से 100% तक बदलता है"},{"en":"It switches the CPU between single-core and quad-core modes","hi":"यह CPU को सिंगल-कोर और क्वाड-कोर मोड के बीच बदलता है"},{"en":"It types the number in Roman numerals","hi":"यह संख्या को रोमन अंकों में टाइप करता है"}],"exp":{"en":"Pressing the Windows logo key + a number key (1 through 9) launches the application pinned to the Taskbar in the position indicated by that number, or switches to that app if it is already running.","hi":"'Win + Number' (जैसे Win + 1, Win + 2) दबाने पर टास्कबार (Taskbar) पर उस क्रम संख्या (position) पर पिन किया गया ऐप खुल जाता है या यदि वह पहले से चल रहा हो तो सक्रिय (activate) हो जाता है।"},"num":108},{"id":"q109","q":{"en":"What does the Windows keyboard shortcut 'Win + R' open?","hi":"विंडोज़ कीबोर्ड शॉर्टकट 'Win + R' क्या खोलता है?"},"a":{"en":"The Run dialog box","hi":"रन डायलॉग बॉक्स (Run dialog)"},"o":[{"en":"The Run dialog box","hi":"रन डायलॉग बॉक्स (Run dialog)"},{"en":"The Recycle Bin window","hi":"रीसायकल बिन विंडो"},{"en":"The Registry Editor directly without confirmation","hi":"बिना पुष्टि के सीधे रजिस्ट्री एडिटर"},{"en":"The Restart computer countdown","hi":"कंप्यूटर रीस्टार्ट काउंटडाउन"}],"exp":{"en":"Pressing the Windows logo key + R (`Win + R`) opens the 'Run' dialog box, allowing the user to quickly launch programs, folders, or system tools by typing their command name (like `cmd`, `calc`, `msconfig`).","hi":"'Win + R' शॉर्टकट विंडोज़ में 'रन डायलॉग बॉक्स' (Run dialog) खोलता है।"},"num":109},{"id":"q110","q":{"en":"Which menu does the keyboard shortcut 'Alt + Space' (Alt + Spacebar) open in Windows?","hi":"विंडोज़ में 'Alt + Space' शॉर्टकट किस मेनू को खोलता है?"},"a":{"en":"The system/window control menu for the currently active window (containing Restore, Move, Size, Minimize, Maximize, Close)","hi":"सक्रिय विंडो का सिस्टम/विंडो मेनू (System/Window menu)"},"o":[{"en":"The system/window control menu for the currently active window (containing Restore, Move, Size, Minimize, Maximize, Close)","hi":"सक्रिय विंडो का सिस्टम/विंडो मेनू (System/Window menu)"},{"en":"The Start Menu search bar","hi":"स्टार्ट मेनू सर्च बार"},{"en":"The BIOS boot order menu","hi":"BIOS बूट ऑर्डर मेनू"},{"en":"The File Explorer drive formatting menu","hi":"फ़ाइल एक्सप्लोरर ड्राइव फ़ॉर्मेटिंग मेनू"}],"exp":{"en":"Pressing Alt + Spacebar opens the shortcut/system menu for the active window's title bar, giving keyboard access to window commands like Restore, Move, Size, Minimize, Maximize, and Close.","hi":"'Alt + Space' दबाने से वर्तमान में सक्रिय विंडो का सिस्टम/विंडो मेनू (system/window menu) खुलता है, जिसमें विंडो को मिनिमाइज़, मैक्सिमाइज़, रीस्टोर या क्लोज़ करने के विकल्प होते हैं।"},"num":110},{"id":"q111","q":{"en":"What is the function of pressing 'Alt + Space, then X' on an active window in English Windows?","hi":"अंग्रेजी विंडोज़ में सक्रिय विंडो पर 'Alt + Space, फिर X' दबाने का क्या काम है?"},"a":{"en":"Maximize the active window (if supported by the window)","hi":"सक्रिय विंडो को मैक्सिमाइज़ (Maximize) करना"},"o":[{"en":"Maximize the active window (if supported by the window)","hi":"सक्रिय विंडो को मैक्सिमाइज़ (Maximize) करना"},{"en":"Cut and delete the window permanently","hi":"विंडो को स्थायी रूप से कट और डिलीट करना"},{"en":"Minimize the window to the system tray","hi":"विंडो को सिस्टम ट्रे में मिनिमाइज़ करना"},{"en":"Export the window as an Excel sheet","hi":"विंडो को एक्सेल शीट के रूप में एक्सपोर्ट करना"}],"exp":{"en":"In the English Windows system menu opened by Alt + Space, 'X' is the underlined accelerator key for 'Ma<u>x<\/u>imize', so pressing Alt + Space followed by X maximizes the active window.","hi":"अंग्रेजी विंडो मेनू में 'Alt + Space' दबाने के बाद 'X' दबाने से सक्रिय विंडो मैक्सिमाइज़ (Maximize — पूरी स्क्रीन पर बड़ी) हो जाती है।"},"num":111},{"id":"q112","q":{"en":"What is the function of pressing 'Alt + Space, then R' on a maximized window in English Windows?","hi":"अंग्रेजी विंडोज़ में 'Alt + Space, फिर R' दबाने का क्या काम है?"},"a":{"en":"Restore the active window to its previous (non-maximized) size","hi":"सक्रिय विंडो को उसके पिछले आकार में रीस्टोर (Restore) करना"},"o":[{"en":"Restore the active window to its previous (non-maximized) size","hi":"सक्रिय विंडो को उसके पिछले आकार में रीस्टोर (Restore) करना"},{"en":"Rename the application executable file","hi":"एप्लिकेशन फ़ाइल का नाम बदलना"},{"en":"Reboot the operating system kernel","hi":"ऑपरेटिंग सिस्टम कर्नेल को रीबूट करना"},{"en":"Rotate the window by 90 degrees","hi":"विंडो को 90 डिग्री घुमाना"}],"exp":{"en":"In the English window control menu opened via Alt + Space, 'R' is the accelerator key for '<u>R<\/u>estore', which restores a maximized window back to its previous normal window size.","hi":"अंग्रेजी विंडो मेनू में 'Alt + Space' के बाद 'R' दबाने से विंडो रीस्टोर (Restore — अपने पूर्व सामान्य आकार में वापस) हो जाती है।"},"num":112},{"id":"q113","q":{"en":"What is the function of pressing 'Alt + Space, then N' on an active window in English Windows?","hi":"अंग्रेजी विंडोज़ में 'Alt + Space, फिर N' दबाने का क्या काम है?"},"a":{"en":"Minimize the active window to the taskbar","hi":"सक्रिय विंडो को टास्कबार पर मिनिमाइज़ (Minimize) करना"},"o":[{"en":"Minimize the active window to the taskbar","hi":"सक्रिय विंडो को टास्कबार पर मिनिमाइज़ (Minimize) करना"},{"en":"Open a new blank desktop","hi":"एक नया खाली डेस्कटॉप खोलना"},{"en":"Disconnect from the local area network","hi":"लोकल एरिया नेटवर्क से डिस्कनेक्ट करना"},{"en":"Rename the window title","hi":"विंडो का शीर्षक बदलना"}],"exp":{"en":"In the English window control menu opened via Alt + Space, 'N' is the accelerator key for 'Mi<u>n<\/u>imize', which minimizes the active window.","hi":"अंग्रेजी विंडो मेनू में 'Alt + Space' के बाद 'N' दबाने से सक्रिय विंडो मिनिमाइज़ (Minimize) हो जाती है।"},"num":113},{"id":"q114","q":{"en":"What does the keyboard shortcut 'Alt + Tab' do in Windows?","hi":"विंडोज़ में 'Alt + Tab' शॉर्टकट क्या करता है?"},"a":{"en":"Switches between currently open applications or windows","hi":"खुले हुए ऐप्स या विंडोज़ के बीच स्विच (Switch) करता है"},"o":[{"en":"Switches between currently open applications or windows","hi":"खुले हुए ऐप्स या विंडोज़ के बीच स्विच (Switch) करता है"},{"en":"Inserts a new table into File Explorer","hi":"फ़ाइल एक्सप्लोरर में एक नई तालिका डालता है"},{"en":"Locks the keyboard and mouse","hi":"कीबोर्ड और माउस को लॉक करता है"},{"en":"Formats the C: drive","hi":"C: ड्राइव को फ़ॉर्मेट करता है"}],"exp":{"en":"Pressing Alt + Tab allows the user to quickly switch between open applications and windows on the desktop.","hi":"'Alt + Tab' शॉर्टकट खुले हुए एप्लिकेशन्स या विंडोज़ के बीच तेज़ी से स्विच (switch) करने के काम आता है।"},"num":114},{"id":"q115","q":{"en":"What does the keyboard shortcut 'Alt + F4' do in Windows?","hi":"विंडोज़ में 'Alt + F4' शॉर्टकट क्या करता है?"},"a":{"en":"Closes the currently active window/app; if the desktop is active with no window selected, it opens the Shut Down Windows dialog","hi":"सक्रिय विंडो को बंद (Close) करता है; यदि डेस्कटॉप सक्रिय हो तो शटडाउन डायलॉग खोलता है"},"o":[{"en":"Closes the currently active window/app; if the desktop is active with no window selected, it opens the Shut Down Windows dialog","hi":"सक्रिय विंडो को बंद (Close) करता है; यदि डेस्कटॉप सक्रिय हो तो शटडाउन डायलॉग खोलता है"},{"en":"Opens four new File Explorer windows simultaneously","hi":"एक साथ चार नई फ़ाइल एक्सप्लोरर विंडो खोलता है"},{"en":"Minimizes all windows and mutes audio","hi":"सभी विंडो को मिनिमाइज़ करता है और ऑडियो म्यूट करता है"},{"en":"Refreshes the desktop icons four times","hi":"डेस्कटॉप आइकन्स को चार बार रिफ्रेश करता है"}],"exp":{"en":"Pressing Alt + F4 closes the active application window. When pressed on the bare desktop with no active window, it opens the 'Shut Down Windows' dialog box.","hi":"'Alt + F4' दबाने से वर्तमान में सक्रिय विंडो बंद (close) हो जाती है, और यदि डेस्कटॉप सक्रिय हो तो यह विंडोज़ का शटडाउन डायलॉग (Shut Down dialog) खोलता है।"},"num":115},{"id":"q116","q":{"en":"Does 'Windows' have an official full form/acronym expansion from Microsoft?","hi":"क्या माइक्रोसॉफ्ट की ओर से 'Windows' का कोई आधिकारिक पूर्ण रूप (Official Full Form) है?"},"a":{"en":"No — 'Windows' is simply Microsoft's product name (the expansion given in some notes is an informal backronym, not an official name)","hi":"नहीं — 'Windows' माइक्रोसॉफ्ट का उत्पाद नाम (product name) है; अध्याय में दिया गया विस्तार कोई आधिकारिक नाम नहीं है"},"o":[{"en":"No — 'Windows' is simply Microsoft's product name (the expansion given in some notes is an informal backronym, not an official name)","hi":"नहीं — 'Windows' माइक्रोसॉफ्ट का उत्पाद नाम (product name) है; अध्याय में दिया गया विस्तार कोई आधिकारिक नाम नहीं है"},{"en":"Yes — Microsoft officially registered it as Wireless Integrated Network Disk Operating System","hi":"हाँ — माइक्रोसॉफ्ट ने इसे वायरलेस इंटीग्रेटेड नेटवर्क डिस्क ऑपरेटिंग सिस्टम के रूप में पंजीकृत किया है"},{"en":"Yes — it officially stands for World Internet Digital Operating Workstation System","hi":"हाँ — इसका आधिकारिक अर्थ वर्ल्ड इंटरनेट डिजिटल ऑपरेटिंग वर्कस्टेशन सिस्टम है"},{"en":"Yes — it is an acronym for Wide Interactive Network Development for Office Work Solution","hi":"हाँ — यह आधिकारिक तौर पर संक्षिप्त रूप में पंजीकृत नाम है"}],"exp":{"en":"Fact-Check Note: 'Windows' is simply an English word chosen by Microsoft as its product name (referring to rectangular graphical screen windows). Backronyms like 'Wide Interactive Network Development for Office Work Solution' appear in some coaching notes, but they are NOT official Microsoft expansions.","hi":"तथ्य-जाँच नोट: 'Windows' माइक्रोसॉफ्ट के ऑपरेटिंग सिस्टम का उत्पाद नाम (product name — स्क्रीन की आयताकार खिड़कियों के आधार पर) है। कुछ नोट्स में दिया जाने वाला इसका फुल फॉर्म केवल एक अनौपचारिक बैक्रोनम है, माइक्रोसॉफ्ट का आधिकारिक नाम नहीं।"},"num":116},{"id":"q117","q":{"en":"What is the historical relationship between Internet Explorer, Microsoft Edge, and Windows?","hi":"Internet Explorer और Microsoft Edge का Windows ऑपरेटिंग सिस्टम से क्या संबंध है?"},"a":{"en":"Internet Explorer was the bundled web browser in older Windows versions; Windows 10 introduced Microsoft Edge as the new default browser (while initially keeping IE for legacy compatibility)","hi":"Internet Explorer पुराने विंडोज़ संस्करणों का बंडल्ड ब्राउज़र था; Windows 10 ने Microsoft Edge पेश किया (और पुरानी संगतता के लिए शुरू में IE भी दिया)"},"o":[{"en":"Internet Explorer was the bundled web browser in older Windows versions; Windows 10 introduced Microsoft Edge as the new default browser (while initially keeping IE for legacy compatibility)","hi":"Internet Explorer पुराने विंडोज़ संस्करणों का बंडल्ड ब्राउज़र था; Windows 10 ने Microsoft Edge पेश किया (और पुरानी संगतता के लिए शुरू में IE भी दिया)"},{"en":"Microsoft Edge was released in 1985 with Windows 1.0, and Internet Explorer was released in 2021 with Windows 11","hi":"Microsoft Edge 1985 में Windows 1.0 के साथ आया, और Internet Explorer 2021 में Windows 11 के साथ"},{"en":"Both are open-source Linux kernels developed by Bell Labs","hi":"दोनों बेल लैब्स द्वारा विकसित ओपन-सोर्स लिनक्स कर्नेल हैं"},{"en":"Internet Explorer is a spreadsheet, whereas Microsoft Edge is an antivirus","hi":"Internet Explorer एक स्प्रेडशीट है, जबकि Microsoft Edge एक एंटीवायरस है"}],"exp":{"en":"Internet Explorer (IE) served as the default bundled web browser in older versions of Windows (from Windows 95 Plus! through Windows 8.1). With Windows 10 (2015), Microsoft introduced Microsoft Edge as the modern default browser, retaining IE temporarily only for backward compatibility.","hi":"Internet Explorer पुराने विंडोज़ संस्करणों के साथ आने वाला डिफ़ॉल्ट वेब ब्राउज़र था। Windows 10 के साथ माइक्रोसॉफ्ट ने आधुनिक ब्राउज़र 'Microsoft Edge' पेश किया (हालाँकि पुरानी वेबसाइटों की संगतता के लिए शुरू में IE भी उपलब्ध रखा गया था)।"},"num":117},{"id":"q118","q":{"en":"In the chapter's Windows version progression list, what is the chronological order from Windows 1.0 up to Windows 95?","hi":"अध्याय की सूची में Windows 1.0 से लेकर Windows 95 तक का क्रम क्या है?"},"a":{"en":"Windows 1.0 → Windows 2.0 → Windows 3.0 → Windows 3.1 → Windows NT 3.1/3.5 → Windows 95","hi":"Windows 1.0 → 2.0 → 3.0 → 3.1 → Windows NT 3.1/3.5 → Windows 95"},"o":[{"en":"Windows 1.0 → Windows 2.0 → Windows 3.0 → Windows 3.1 → Windows NT 3.1/3.5 → Windows 95","hi":"Windows 1.0 → 2.0 → 3.0 → 3.1 → Windows NT 3.1/3.5 → Windows 95"},{"en":"Windows 95 → Windows 3.1 → Windows 2.0 → Windows 1.0 → Windows NT","hi":"Windows 95 → 3.1 → 2.0 → 1.0 → Windows NT"},{"en":"Windows XP → Windows Vista → Windows 1.0 → Windows 95","hi":"Windows XP → Vista → 1.0 → 95"},{"en":"Windows 10 → Windows 8 → Windows 7 → Windows 95","hi":"Windows 10 → 8 → 7 → 95"}],"exp":{"en":"Following the chapter's chronological list of early Windows releases: Windows 1.0 (1985) → Windows 2.0 (1987) → Windows 3.0 (1990) → Windows 3.1 (1992) → Windows NT 3.1/3.5 (1993–1994) → Windows 95 (1995).","hi":"अध्याय की सूची के अनुसार Windows 1.0 से Windows 95 तक का सही क्रम है: Windows 1.0 → 2.0 → 3.0 → 3.1 → Windows NT 3.1/3.5 → Windows 95।"},"num":118},{"id":"q119","q":{"en":"After Windows 95, what is the chapter's listed order of releases up to Windows ME?","hi":"Windows 95 के बाद Windows ME तक अध्याय में दिया गया क्रम क्या है?"},"a":{"en":"Windows NT 4.0 → Windows 98 → Windows 2000 → Windows ME (the list shows both the NT and consumer 9x lines)","hi":"Windows NT 4.0 → Windows 98 → Windows 2000 → Windows ME (यह सूची कंज्यूमर और NT दोनों लाइनों को दिखाती है)"},"o":[{"en":"Windows NT 4.0 → Windows 98 → Windows 2000 → Windows ME (the list shows both the NT and consumer 9x lines)","hi":"Windows NT 4.0 → Windows 98 → Windows 2000 → Windows ME (यह सूची कंज्यूमर और NT दोनों लाइनों को दिखाती है)"},{"en":"Windows ME → Windows 98 → Windows 1.0 → Windows NT 4.0","hi":"Windows ME → 98 → 1.0 → NT 4.0"},{"en":"Windows 11 → Windows 10 → Windows 2000 → Windows ME","hi":"Windows 11 → 10 → 2000 → ME"},{"en":"Windows Vista → Windows 7 → Windows 98 → Windows ME","hi":"Windows Vista → 7 → 98 → ME"}],"exp":{"en":"After Windows 95, the chapter sequence lists: Windows NT 4.0 (1996) → Windows 98 (1998) → Windows 2000 (Feb 2000, NT line) → Windows ME / Millennium Edition (Sept 2000, consumer 9x line).","hi":"Windows 95 के बाद Windows ME तक का क्रम है: Windows NT 4.0 → Windows 98 → Windows 2000 → Windows ME (इसमें व्यावसायिक NT और घरेलू कंज्यूमर दोनों श्रृंखलाएँ शामिल हैं)।"},"num":119},{"id":"q120","q":{"en":"From Windows XP onwards, what is the exact release order up to Windows 11?","hi":"Windows XP से लेकर Windows 11 तक के संस्करणों का सही कालानुक्रमिक क्रम (Order) क्या है?"},"a":{"en":"Windows XP → Windows Vista → Windows 7 → Windows 8 → Windows 8.1 → Windows 10 → Windows 11","hi":"Windows XP → Vista → 7 → 8 → 8.1 → 10 → 11"},"o":[{"en":"Windows XP → Windows Vista → Windows 7 → Windows 8 → Windows 8.1 → Windows 10 → Windows 11","hi":"Windows XP → Vista → 7 → 8 → 8.1 → 10 → 11"},{"en":"Windows 7 → Windows XP → Windows Vista → Windows 10 → Windows 8 → Windows 11","hi":"Windows 7 → XP → Vista → 10 → 8 → 11"},{"en":"Windows XP → Windows 7 → Windows Vista → Windows 8.1 → Windows 8 → Windows 11","hi":"Windows XP → 7 → Vista → 8.1 → 8 → 11"},{"en":"Windows Vista → Windows XP → Windows 8 → Windows 7 → Windows 10 → Windows 11","hi":"Windows Vista → XP → 8 → 7 → 10 → 11"}],"exp":{"en":"The modern desktop Windows release sequence from Windows XP to Windows 11 is: Windows XP (2001) → Windows Vista (2006/2007) → Windows 7 (2009) → Windows 8 (2012) → Windows 8.1 (2013) → Windows 10 (2015) → Windows 11 (2021).","hi":"Windows XP के बाद से Windows 11 तक का सही क्रम है: Windows XP → Windows Vista → Windows 7 → Windows 8 → Windows 8.1 → Windows 10 → Windows 11।"},"num":120}]},{"title":{"en":"9. Kernel, Shell, Processes & System Tools","hi":"9. कर्नेल, शेल, प्रोसेस और सिस्टम टूल्स"},"questions":[{"id":"q121","q":{"en":"What is the 'Kernel' in an Operating System?","hi":"ऑपरेटिंग सिस्टम में 'कर्नेल' (Kernel) क्या होता है?"},"a":{"en":"The core component of the OS that manages system resources such as CPU scheduling, memory, and hardware devices","hi":"ऑपरेटिंग सिस्टम का मुख्य (core) भाग जो CPU शेड्यूलिंग, मेमोरी और डिवाइसेस जैसे संसाधनों का प्रबंधन करता है"},"o":[{"en":"The core component of the OS that manages system resources such as CPU scheduling, memory, and hardware devices","hi":"ऑपरेटिंग सिस्टम का मुख्य (core) भाग जो CPU शेड्यूलिंग, मेमोरी और डिवाइसेस जैसे संसाधनों का प्रबंधन करता है"},{"en":"An external plastic cover placed over a desktop keyboard","hi":"डेस्कटॉप कीबोर्ड के ऊपर रखा जाने वाला एक बाहरी प्लास्टिक कवर"},{"en":"A web browser plugin used for playing flash animations","hi":"फ्लैश एनीमेशन चलाने के लिए प्रयुक्त एक वेब ब्राउज़र प्लगइन"},{"en":"A printed user manual included in the computer box","hi":"कंप्यूटर बॉक्स में शामिल एक मुद्रित उपयोगकर्ता पुस्तिका"}],"exp":{"en":"The Kernel is the central, core component of an Operating System that stays in memory and directly manages hardware resources, including CPU scheduling, memory allocation, and device I/O control.","hi":"कर्नेल (Kernel) ऑपरेटिंग सिस्टम का सबसे मुख्य (core) घटक होता है, जो CPU शेड्यूलिंग, मेमोरी और हार्डवेयर डिवाइसेस जैसे सिस्टम संसाधनों को सीधे मैनेज करता है।"},"num":121},{"id":"q122","q":{"en":"What is a 'Shell' in an Operating System, and what are its examples?","hi":"ऑपरेटिंग सिस्टम में 'शेल' (Shell) क्या होता है और इसके उदाहरण क्या हैं?"},"a":{"en":"The outer user interface that accepts and interprets user commands; Command Prompt and Bash are examples (a terminal app can host a shell)","hi":"यूज़र के कमांड्स को स्वीकार और इंटरप्रेट (व्याख्या) करने वाला इंटरफेस; Command Prompt और Bash इसके उदाहरण हैं"},"o":[{"en":"The outer user interface that accepts and interprets user commands; Command Prompt and Bash are examples (a terminal app can host a shell)","hi":"यूज़र के कमांड्स को स्वीकार और इंटरप्रेट (व्याख्या) करने वाला इंटरफेस; Command Prompt और Bash इसके उदाहरण हैं"},{"en":"The metal cabinet that houses the power supply unit","hi":"पावर सप्लाई यूनिट को रखने वाला धातु का कैबिनेट"},{"en":"A magnetic platter inside a hard disk drive","hi":"हार्ड डिस्क ड्राइव के अंदर की एक चुंबकीय प्लेट"},{"en":"A non-volatile ROM chip soldered onto the motherboard","hi":"मदरबोर्ड पर सोल्डर की गई एक नॉन-वोलेटाइल ROM चिप"}],"exp":{"en":"A Shell is the command interpreter interface around the OS kernel that accepts user commands (typed or scripted) and requests the kernel to execute them. Windows Command Prompt (cmd.exe), PowerShell, and Unix/Linux Bash are classic examples (a terminal emulator application hosts a text shell).","hi":"शेल (Shell) वह कमांड इंटरफेस है जो उपयोगकर्ता से कमांड स्वीकार करता है और उन्हें इंटरप्रेट करके कर्नेल तक पहुँचाता है। Windows का Command Prompt और Linux का Bash इसके प्रमुख उदाहरण हैं (टर्मिनल ऐप शेल को होस्ट कर सकता है)।"},"num":122},{"id":"q123","q":{"en":"What is a 'Process' in operating system terminology?","hi":"ऑपरेटिंग सिस्टम शब्दावली में 'प्रोसेस' (Process) क्या है?"},"a":{"en":"An active instance of a running program, along with its current execution state and allocated system resources","hi":"किसी चल रहे प्रोग्राम (running program) का सक्रिय उदाहरण (instance), अपने एक्जीक्यूशन स्टेट और आवंटित संसाधनों के साथ"},"o":[{"en":"An active instance of a running program, along with its current execution state and allocated system resources","hi":"किसी चल रहे प्रोग्राम (running program) का सक्रिय उदाहरण (instance), अपने एक्जीक्यूशन स्टेट और आवंटित संसाधनों के साथ"},{"en":"A static text file saved on an unplugged USB pen drive","hi":"अनप्लग किए गए USB पेन ड्राइव पर सहेजी गई एक स्थिर टेक्स्ट फ़ाइल"},{"en":"The physical manufacturing process of silicon wafers","hi":"सिलिकॉन वेफर्स के भौतिक निर्माण की प्रक्रिया"},{"en":"A paper printout sitting in the printer tray","hi":"प्रिंटर ट्रे में रखा एक कागजी प्रिंटआउट"}],"exp":{"en":"While a program is a passive file stored on disk, a Process is an active instance of a program in execution, possessing its own address space, program counter/execution state, and allocated OS resources.","hi":"किसी रन हो रहे प्रोग्राम (running program) के सक्रिय रूप (instance) को, उसके वर्तमान एक्जीक्यूशन स्टेट और आवंटित सिस्टम संसाधनों के साथ, 'प्रोसेस' (Process) कहा जाता है।"},"num":123},{"id":"q124","q":{"en":"What is a 'Thread' in an Operating System?","hi":"ऑपरेटिंग सिस्टम में 'थ्रेड' (Thread) क्या है?"},"a":{"en":"A basic unit of CPU execution within a process; multiple threads of the same process can share the process's address space and resources","hi":"किसी प्रोसेस के अंदर निष्पादन (execution) की इकाई; एक ही प्रोसेस के कई थ्रेड्स एड्रेस स्पेस साझा (share) कर सकते हैं"},"o":[{"en":"A basic unit of CPU execution within a process; multiple threads of the same process can share the process's address space and resources","hi":"किसी प्रोसेस के अंदर निष्पादन (execution) की इकाई; एक ही प्रोसेस के कई थ्रेड्स एड्रेस स्पेस साझा (share) कर सकते हैं"},{"en":"A cotton string used to bind punched paper cards","hi":"पंच पेपर कार्डों को बाँधने के लिए प्रयुक्त एक सूती धागा"},{"en":"A physical copper wire inside a VGA monitor cable","hi":"VGA मॉनिटर केबल के अंदर का एक भौतिक तांबे का तार"},{"en":"An external hard disk partition formatted as FAT32","hi":"FAT32 के रूप में फ़ॉर्मेट किया गया एक बाहरी हार्ड डिस्क पार्टीशन"}],"exp":{"en":"A Thread (often called a lightweight process) is the smallest unit of scheduled execution within a process. Threads belonging to the same process share the process's memory address space, code, and open files.","hi":"थ्रेड (Thread) किसी प्रोसेस के भीतर निष्पादन (execution) की एक मूल इकाई है। एक ही प्रोसेस के विभिन्न थ्रेड्स उस प्रोसेस के साझा मेमोरी एड्रेस स्पेस (shared address space) का उपयोग कर सकते हैं।"},"num":124},{"id":"q125","q":{"en":"What is the structural relationship between a Process and a Thread?","hi":"प्रोसेस (Process) और थ्रेड (Thread) के बीच क्या संबंध है?"},"a":{"en":"A single process can contain one thread (single-threaded) or multiple concurrent threads (multithreaded) sharing its address space","hi":"एक प्रोसेस के अंदर एक या एक से अधिक (multiple) थ्रेड्स हो सकते हैं"},"o":[{"en":"A single process can contain one thread (single-threaded) or multiple concurrent threads (multithreaded) sharing its address space","hi":"एक प्रोसेस के अंदर एक या एक से अधिक (multiple) थ्रेड्स हो सकते हैं"},{"en":"A single thread contains 1,000 separate operating systems","hi":"एक अकेले थ्रेड के अंदर 1,000 अलग-अलग ऑपरेटिंग सिस्टम होते हैं"},{"en":"Processes and threads are physical printers and scanners","hi":"प्रोसेस और थ्रेड भौतिक प्रिंटर और स्कैनर हैं"},{"en":"A process can never have any threads","hi":"किसी प्रोसेस में कभी कोई थ्रेड नहीं हो सकता"}],"exp":{"en":"Diagram concept (PDF p. 68): A process is the resource container (holding the shared address space), and within one process there can be a single thread or multiple threads (Thread A, Thread B, etc.) executing concurrently.","hi":"एक प्रोसेस के भीतर एक थ्रेड (single-threaded) या एक से अधिक थ्रेड्स (multiple threads) हो सकते हैं जो उस प्रोसेस के एड्रेस स्पेस को साझा करते हुए कार्य करते हैं।"},"num":125},{"id":"q126","q":{"en":"What does 'Virtual Memory' do for running processes?","hi":"चल रहे प्रोसेसेज के लिए 'वर्चुअल मेमोरी' (Virtual Memory) क्या करती है?"},"a":{"en":"It provides processes with a virtual address space, and when needed, the OS can keep inactive memory pages in a disk-backed swap space or pagefile","hi":"यह प्रोसेसेज को वर्चुअल एड्रेस स्पेस देती है, और ज़रूरत पड़ने पर OS कुछ पेजों को डिस्क-आधारित स्वैप/पेजफ़ाइल (swap/pagefile) में रख सकता है"},"o":[{"en":"It provides processes with a virtual address space, and when needed, the OS can keep inactive memory pages in a disk-backed swap space or pagefile","hi":"यह प्रोसेसेज को वर्चुअल एड्रेस स्पेस देती है, और ज़रूरत पड़ने पर OS कुछ पेजों को डिस्क-आधारित स्वैप/पेजफ़ाइल (swap/pagefile) में रख सकता है"},{"en":"It physically solders extra SRAM chips onto the CPU die during runtime","hi":"यह रनटाइम के दौरान CPU चिप पर अतिरिक्त SRAM चिप्स को भौतिक रूप से सोल्डर करती है"},{"en":"It deletes the hard drive to make the monitor brighter","hi":"यह मॉनिटर को चमकीला बनाने के लिए हार्ड ड्राइव को मिटा देती है"},{"en":"It replaces the ALU with an optical CD-ROM drive","hi":"यह ALU को ऑप्टिकल CD-ROM ड्राइव से बदल देती है"}],"exp":{"en":"Virtual memory abstracts physical RAM by giving each process its own logical/virtual address space. When physical RAM is full, the OS swaps inactive memory pages out to a dedicated swap area or pagefile on secondary storage (HDD/SSD).","hi":"वर्चुअल मेमोरी प्रोसेसेज को एक वर्चुअल एड्रेस स्पेस प्रदान करती है। भौतिक RAM भरने या ज़रूरत पड़ने पर OS कुछ निष्क्रिय मेमोरी पेजों को डिस्क पर बने स्वैप स्पेस या पेजफ़ाइल (swap/pagefile) में रख सकता है।"},"num":126},{"id":"q127","q":{"en":"What is a 'Deadlock' in an Operating System?","hi":"ऑपरेटिंग सिस्टम में 'डेडलॉक' (Deadlock) क्या होता है?"},"a":{"en":"A situation where two or more processes or threads are blocked indefinitely, each waiting for a resource held by another involved process, so none can proceed","hi":"ऐसी स्थिति जहाँ दो या अधिक प्रोसेसेज या थ्रेड्स एक-दूसरे के संसाधनों (resources) के लिए इस तरह इंतज़ार करते हैं कि कोई भी आगे नहीं बढ़ पाता"},"o":[{"en":"A situation where two or more processes or threads are blocked indefinitely, each waiting for a resource held by another involved process, so none can proceed","hi":"ऐसी स्थिति जहाँ दो या अधिक प्रोसेसेज या थ्रेड्स एक-दूसरे के संसाधनों (resources) के लिए इस तरह इंतज़ार करते हैं कि कोई भी आगे नहीं बढ़ पाता"},{"en":"A security password used to lock the Windows desktop screen via Win + L","hi":"Win + L के माध्यम से विंडोज़ डेस्कटॉप स्क्रीन को लॉक करने के लिए प्रयुक्त एक सुरक्षा पासवर्ड"},{"en":"A high-speed turbo mode in quad-core processors","hi":"क्वाड-कोर प्रोसेसर में एक हाई-स्पीड टर्बो मोड"},{"en":"The normal completion and exit of a batch script","hi":"किसी बैच स्क्रिप्ट का सामान्य रूप से पूरा होकर बंद होना"}],"exp":{"en":"A deadlock is a standstill condition in multiprogramming/multitasking where a set of processes or threads are permanently blocked because each process holds a resource and waits circularly for another resource held by another process in the same set.","hi":"डेडलॉक वह गतिरोध स्थिति है जिसमें दो या अधिक प्रोसेसेज या थ्रेड्स संसाधनों (resources) के लिए एक-दूसरे का इस प्रकार अनिश्चितकालीन इंतज़ार करते हैं कि उनमें से किसी का भी निष्पादन (execution) आगे नहीं बढ़ पाता।"},"num":127},{"id":"q128","q":{"en":"How can an Operating System handle Deadlocks?","hi":"ऑपरेटिंग सिस्टम डेडलॉक (Deadlock) को कैसे हैंडल कर सकता है?"},"a":{"en":"It can use resource allocation policies to prevent or avoid deadlocks, or use deadlock detection and recovery mechanisms","hi":"यह संसाधन नीति (resource policy) से डेडलॉक को रोक/टाल (prevent/avoid) सकता है या डिटेक्शन और रिकवरी (detection and recovery) का उपयोग कर सकता है"},"o":[{"en":"It can use resource allocation policies to prevent or avoid deadlocks, or use deadlock detection and recovery mechanisms","hi":"यह संसाधन नीति (resource policy) से डेडलॉक को रोक/टाल (prevent/avoid) सकता है या डिटेक्शन और रिकवरी (detection and recovery) का उपयोग कर सकता है"},{"en":"By physically burning the motherboard whenever a process waits","hi":"जब भी कोई प्रोसेस इंतज़ार करता है तो मदरबोर्ड को भौतिक रूप से जलाकर"},{"en":"By converting the operating system into a word processor","hi":"ऑपरेटिंग सिस्टम को वर्ड प्रोसेसर में बदलकर"},{"en":"By unplugging the mouse and keyboard","hi":"माउस और कीबोर्ड को अनप्लग करके"}],"exp":{"en":"An OS can deal with deadlocks using prevention (disallowing one of the necessary deadlock conditions), avoidance (safe-state resource allocation like the Banker's algorithm), or deadlock detection followed by recovery (preempting resources or terminating a deadlocked process).","hi":"ऑपरेटिंग सिस्टम उचित रिसोर्स पॉलिसी की मदद से डेडलॉक को रोक या टाल (prevent/avoid) सकता है, अथवा डेडलॉक डिटेक्शन और रिकवरी (detection and recovery) तकनीकों का उपयोग कर सकता है।"},"num":128},{"id":"q129","q":{"en":"What does a 'File Extension' indicate, and what are its common examples?","hi":"'फ़ाइल एक्सटेंशन' (File Extension) क्या बताती है और इसके उदाहरण क्या हैं?"},"a":{"en":"The suffix at the end of a filename (after the dot) that indicates the file format/type and helps the OS associate it with a default application; examples are .pdf and .txt","hi":"फ़ाइल नाम का अंतिम प्रत्यय (suffix), जो फ़ाइल का प्रकार या संबंधित ऐप बताता है; जैसे .pdf और .txt"},"o":[{"en":"The suffix at the end of a filename (after the dot) that indicates the file format/type and helps the OS associate it with a default application; examples are .pdf and .txt","hi":"फ़ाइल नाम का अंतिम प्रत्यय (suffix), जो फ़ाइल का प्रकार या संबंधित ऐप बताता है; जैसे .pdf और .txt"},{"en":"An extension cord used to plug the computer into a distant wall socket","hi":"कंप्यूटर को दूर के सॉकेट में लगाने के लिए प्रयुक्त एक बिजली का एक्सटेंशन बोर्ड"},{"en":"The physical length of a magnetic tape reel in metres","hi":"मीटर में चुंबकीय टेप रील की भौतिक लंबाई"},{"en":"The number of CPU cores inside a server","hi":"सर्वर के अंदर CPU कोर की संख्या"}],"exp":{"en":"A file extension is the suffix at the end of a filename (typically following a period, such as `.pdf`, `.txt`, `.docx`, `.jpg`) that identifies the file's format/type and tells the OS which application should open it.","hi":"फ़ाइल नाम के अंत में डॉट (.) के बाद लगा सफिक्स (suffix) 'फ़ाइल एक्सटेंशन' कहलाता है। यह फ़ाइल के प्रकार (file type) या उससे जुड़े एप्लिकेशन की पहचान कराता है; जैसे `.pdf` और `.txt`।"},"num":129},{"id":"q130","q":{"en":"What is a 'Batch File', and what is its standard file extension in Windows/DOS?","hi":"'बैच फ़ाइल' (Batch File) क्या होती है और Windows/DOS में इसका मानक एक्सटेंशन क्या है?"},"a":{"en":"A text script file containing a sequence of commands to be executed automatically by the command interpreter, such as a `.bat` file in Windows","hi":"कमांड्स को ऑटोमेट करने वाली स्क्रिप्ट फ़ाइल, जैसे विंडोज़ की `.bat` फ़ाइल"},"o":[{"en":"A text script file containing a sequence of commands to be executed automatically by the command interpreter, such as a `.bat` file in Windows","hi":"कमांड्स को ऑटोमेट करने वाली स्क्रिप्ट फ़ाइल, जैसे विंडोज़ की `.bat` फ़ाइल"},{"en":"A high-resolution 3D animation file with a `.jpg` extension","hi":"`.jpg` एक्सटेंशन वाली एक उच्च-रिज़ॉल्यूशन 3D एनीमेशन फ़ाइल"},{"en":"An audio song file with a `.mp3` extension","hi":"`.mp3` एक्सटेंशन वाली एक ऑडियो सॉन्ग फ़ाइल"},{"en":"A hardware circuit board inside an inkjet printer","hi":"इंकजेट प्रिंटर के अंदर का एक हार्डवेयर सर्किट बोर्ड"}],"exp":{"en":"A batch file is a script file containing a series of shell commands designed to be executed sequentially to automate repetitive tasks—commonly saved with the `.bat` (or `.cmd`) extension in MS-DOS and Microsoft Windows.","hi":"बैच फ़ाइल कमांड्स की एक ऐसी स्क्रिप्ट फ़ाइल होती है जिसका उपयोग कई कमांड्स को स्वचालित (automate) रूप से एक के बाद एक चलाने के लिए किया जाता है, जैसे Windows की `.bat` फ़ाइल।"},"num":130},{"id":"q131","q":{"en":"Which of the following are standard examples of 'System Tools' (system maintenance utilities) listed in the chapter?","hi":"अध्याय में दिए गए 'सिस्टम टूल्स' (System Tools) के प्रमुख उदाहरण कौन-से हैं?"},"a":{"en":"Disk defragmenter, backup utility, and system monitor","hi":"डिस्क डीफ्रैगमेंटर (Disk defragmenter), बैकअप यूटिलिटी (Backup utility) और सिस्टम मॉनिटर (System monitor)"},"o":[{"en":"Disk defragmenter, backup utility, and system monitor","hi":"डिस्क डीफ्रैगमेंटर (Disk defragmenter), बैकअप यूटिलिटी (Backup utility) और सिस्टम मॉनिटर (System monitor)"},{"en":"Adobe Photoshop, CorelDRAW, and Picasa","hi":"Adobe Photoshop, CorelDRAW और Picasa"},{"en":"Autodesk Maya, Blender, and After Effects","hi":"Autodesk Maya, Blender और After Effects"},{"en":"WordStar, WordPerfect, and Lotus 1-2-3","hi":"WordStar, WordPerfect और Lotus 1-2-3"}],"exp":{"en":"System tools are built-in utility programs used to maintain, back up, and monitor system performance—such as a Disk Defragmenter, Backup Utility, and System/Resource Monitor.","hi":"सिस्टम टूल्स के प्रमुख उदाहरण डिस्क डीफ्रैगमेंटर (Disk defragmenter), बैकअप यूटिलिटी (Backup utility) और सिस्टम मॉनिटर (System monitor) हैं।"},"num":131},{"id":"q132","q":{"en":"What is a 'Daemon' in operating systems (particularly in Unix/Linux)?","hi":"ऑपरेटिंग सिस्टम (विशेषकर Unix/Linux के संदर्भ में) में 'डेमन' (Daemon) किसे कहते हैं?"},"a":{"en":"A background process that runs unattended without direct interactive user control to provide system or network services","hi":"एक बैकग्राउंड प्रोसेस (background process) जो सीधे यूज़र इंटरैक्शन के बिना सेवा प्रदान करता है (Unix/Linux में प्रचलित शब्द)"},"o":[{"en":"A background process that runs unattended without direct interactive user control to provide system or network services","hi":"एक बैकग्राउंड प्रोसेस (background process) जो सीधे यूज़र इंटरैक्शन के बिना सेवा प्रदान करता है (Unix/Linux में प्रचलित शब्द)"},{"en":"A computer virus that deletes the BIOS chip","hi":"BIOS चिप को मिटाने वाला एक कंप्यूटर वायरस"},{"en":"A gaming joystick with force-feedback vibration","hi":"फोर्स-फीडबैक कंपन वाला एक गेमिंग जॉयस्टिक"},{"en":"A graphical window menu opened with Alt + Space","hi":"Alt + Space से खुलने वाला एक ग्राफिकल विंडो मेनू"}],"exp":{"en":"In Unix, Linux, and multitasking operating systems, a daemon (comparable to a 'Service' in Windows) is a long-running background process that operates without direct user interaction to handle periodic requests or system/network services (e.g., `sshd`, `httpd`, `crond`).","hi":"सीधे यूज़र इंटरैक्शन के बिना बैकग्राउंड में चलकर सिस्टम या नेटवर्क सेवाएँ देने वाले प्रोसेस को 'डेमन' (Daemon) कहा जाता है। यह शब्द Unix और Linux के संदर्भ में बहुत आम है।"},"num":132}]},{"title":{"en":"10. Abbreviations — Organizations, Networks & Early Computing","hi":"10. संक्षिप्त रूप — संगठन, नेटवर्क और प्रारंभिक कंप्यूटिंग"},"questions":[{"id":"q133","q":{"en":"What is the full form of C-DAC?","hi":"C-DAC का पूर्ण रूप (Full Form) क्या है?"},"a":{"en":"Centre for Development of Advanced Computing","hi":"सेंटर फॉर डेवलपमेंट ऑफ एडवांस्ड कंप्यूटिंग (Centre for Development of Advanced Computing)"},"o":[{"en":"Centre for Development of Advanced Computing","hi":"सेंटर फॉर डेवलपमेंट ऑफ एडवांस्ड कंप्यूटिंग (Centre for Development of Advanced Computing)"},{"en":"Central Department of Analog Computers","hi":"सेंट्रल डिपार्टमेंट ऑफ एनालॉग कम्प्यूटर्स"},{"en":"Council for Digital Arithmetic and Communications","hi":"काउंसिल फॉर डिजिटल अरिथमेटिक एंड कम्युनिकेशन्स"},{"en":"Computer Design and Automation Corporation","hi":"कंप्यूटर डिज़ाइन एंड ऑटोमेशन कॉर्पोरेशन"}],"exp":{"en":"C-DAC stands for Centre for Development of Advanced Computing (the premier R&D organization in India that developed the PARAM series of supercomputers).","hi":"C-DAC का पूर्ण रूप Centre for Development of Advanced Computing है।"},"num":133},{"id":"q134","q":{"en":"What is the full form of C-DOT?","hi":"C-DOT का पूर्ण रूप (Full Form) क्या है?"},"a":{"en":"Centre for Development of Telematics","hi":"सेंटर फॉर डेवलपमेंट ऑफ टेलीमैटिक्स (Centre for Development of Telematics)"},"o":[{"en":"Centre for Development of Telematics","hi":"सेंटर फॉर डेवलपमेंट ऑफ टेलीमैटिक्स (Centre for Development of Telematics)"},{"en":"Central Disk Operating Terminal","hi":"सेंट्रल डिस्क ऑपरेटिंग टर्मिनल"},{"en":"Computerized Dot Matrix Technology","hi":"कंप्यूटराइज्ड डॉट मैट्रिक्स टेक्नोलॉजी"},{"en":"Council for Data and Optical Transmission","hi":"काउंसिल फॉर डेटा एंड ऑप्टिकल ट्रांसमिशन"}],"exp":{"en":"C-DOT stands for Centre for Development of Telematics (the Indian government telecommunications technology development centre).","hi":"C-DOT का पूर्ण रूप Centre for Development of Telematics है।"},"num":134},{"id":"q135","q":{"en":"What is the full form of HTTP?","hi":"HTTP का पूर्ण रूप (Full Form) क्या है?"},"a":{"en":"Hypertext Transfer Protocol","hi":"हाइपरटेक्स्ट ट्रांसफर प्रोटोकॉल (Hypertext Transfer Protocol)"},"o":[{"en":"Hypertext Transfer Protocol","hi":"हाइपरटेक्स्ट ट्रांसफर प्रोटोकॉल (Hypertext Transfer Protocol)"},{"en":"High Transmission Text Program","hi":"हाई ट्रांसमिशन टेक्स्ट प्रोग्राम"},{"en":"Hybrid Terminal Testing Process","hi":"हाइब्रिड टर्मिनल टेस्टिंग प्रोसेस"},{"en":"Hyperlink Tracking and Telematics Port","hi":"हाइपरलिंक ट्रैकिंग एंड टेलीमैटिक्स पोर्ट"}],"exp":{"en":"HTTP stands for Hypertext Transfer Protocol, the foundational application-layer protocol used for transmitting web pages over the World Wide Web.","hi":"HTTP का पूर्ण रूप Hypertext Transfer Protocol है।"},"num":135},{"id":"q136","q":{"en":"What is the full form of ROM?","hi":"ROM का पूर्ण रूप (Full Form) क्या है?"},"a":{"en":"Read-Only Memory","hi":"रीड-ओनली मेमोरी (Read-Only Memory)"},"o":[{"en":"Read-Only Memory","hi":"रीड-ओनली मेमोरी (Read-Only Memory)"},{"en":"Random Optical Memory","hi":"रैंडम ऑप्टिकल मेमोरी"},{"en":"Remote Operating Module","hi":"रिमोट ऑपरेटिंग मॉड्यूल"},{"en":"Rapid Output Microprocessor","hi":"रैपिड आउटपुट माइक्रोप्रोसेसर"}],"exp":{"en":"ROM stands for Read-Only Memory.","hi":"ROM का पूर्ण रूप Read-Only Memory है।"},"num":136},{"id":"q137","q":{"en":"What is the full form of RAM?","hi":"RAM का पूर्ण रूप (Full Form) क्या है?"},"a":{"en":"Random Access Memory","hi":"रैंडम एक्सेस मेमोरी (Random Access Memory)"},"o":[{"en":"Random Access Memory","hi":"रैंडम एक्सेस मेमोरी (Random Access Memory)"},{"en":"Read Always Memory","hi":"रीड ऑलवेज मेमोरी"},{"en":"Remote Array Mechanism","hi":"रिमोट ऐरे मैकेनिज्म"},{"en":"Register Arithmetic Module","hi":"रजिस्टर अरिथमेटिक मॉड्यूल"}],"exp":{"en":"RAM stands for Random Access Memory.","hi":"RAM का पूर्ण रूप Random Access Memory है।"},"num":137},{"id":"q138","q":{"en":"What is the full form of BIOS?","hi":"BIOS का पूर्ण रूप (Full Form) क्या है?"},"a":{"en":"Basic Input/Output System","hi":"बेसिक इनपुट/आउटपुट सिस्टम (Basic Input/Output System)"},"o":[{"en":"Basic Input/Output System","hi":"बेसिक इनपुट/आउटपुट सिस्टम (Basic Input/Output System)"},{"en":"Binary Internal Operating Software","hi":"बाइनरी इंटरनल ऑपरेटिंग सॉफ्टवेयर"},{"en":"Broadband Internet Operating Server","hi":"ब्रॉडबैंड इंटरनेट ऑपरेटिंग सर्वर"},{"en":"Buffered Instruction Output Storage","hi":"बफर्ड इंस्ट्रक्शन आउटपुट स्टोरेज"}],"exp":{"en":"BIOS stands for Basic Input/Output System.","hi":"BIOS का पूर्ण रूप Basic Input/Output System है।"},"num":138},{"id":"q139","q":{"en":"How is the word 'MODEM' formed (what is its full form)?","hi":"'MODEM' शब्द कैसे बना है (इसका पूर्ण रूप क्या है)?"},"a":{"en":"Modulator–Demodulator (a device that modulates and demodulates signals for data transmission)","hi":"मॉड्यूलेटर-डीमॉड्यूलेटर (Modulator–Demodulator)"},"o":[{"en":"Modulator–Demodulator (a device that modulates and demodulates signals for data transmission)","hi":"मॉड्यूलेटर-डीमॉड्यूलेटर (Modulator–Demodulator)"},{"en":"Modern Desktop Memory","hi":"मॉडर्न डेस्कटॉप मेमोरी"},{"en":"Mobile Data Electronic Machine","hi":"मोबाइल डेटा इलेक्ट्रॉनिक मशीन"},{"en":"Monitor Display Enhancement Module","hi":"मॉनिटर डिस्प्ले एन्हांसमेंट मॉड्यूल"}],"exp":{"en":"MODEM is a portmanteau of Modulator–Demodulator, a communication device that modulates digital data into analog carrier signals for transmission and demodulates received signals back into digital data.","hi":"MODEM शब्द 'Modulator–Demodulator' से मिलकर बना है; यह सिग्नलों को मॉड्यूलेट और डीमॉड्यूलेट करने का कार्य करता है।"},"num":139},{"id":"q140","q":{"en":"What is the full form of CAD?","hi":"CAD का पूर्ण रूप (Full Form) क्या है?"},"a":{"en":"Computer-Aided Design","hi":"कंप्यूटर-एडेड डिज़ाइन (Computer-Aided Design)"},"o":[{"en":"Computer-Aided Design","hi":"कंप्यूटर-एडेड डिज़ाइन (Computer-Aided Design)"},{"en":"Central Arithmetic Decoder","hi":"सेंट्रल अरिथमेटिक डिकोडर"},{"en":"Compact Audio Disc","hi":"कॉम्पैक्ट ऑडियो डिस्क"},{"en":"Command And Data","hi":"कमांड एंड डेटा"}],"exp":{"en":"CAD stands for Computer-Aided Design.","hi":"CAD का पूर्ण रूप Computer-Aided Design है।"},"num":140},{"id":"q141","q":{"en":"What is the full form of PSTN?","hi":"PSTN का पूर्ण रूप (Full Form) क्या है?"},"a":{"en":"Public Switched Telephone Network","hi":"पब्लिक स्विच्ड टेलीफोन नेटवर्क (Public Switched Telephone Network)"},"o":[{"en":"Public Switched Telephone Network","hi":"पब्लिक स्विच्ड टेलीफोन नेटवर्क (Public Switched Telephone Network)"},{"en":"Private Satellite Television Network","hi":"प्राइवेट सैटेलाइट टेलीविजन नेटवर्क"},{"en":"Programmable System Terminal Node","hi":"प्रोग्रामेबल सिस्टम टर्मिनल नोड"},{"en":"Parallel Serial Transfer Network","hi":"पैरेलल सीरियल ट्रांसफर नेटवर्क"}],"exp":{"en":"PSTN stands for Public Switched Telephone Network, the traditional circuit-switched telephone network infrastructure.","hi":"PSTN का पूर्ण रूप Public Switched Telephone Network है।"},"num":141},{"id":"q142","q":{"en":"What is the full form of PSPDN?","hi":"PSPDN का पूर्ण रूप (Full Form) क्या है?"},"a":{"en":"Packet-Switched Public Data Network","hi":"पैकेट-स्विच्ड पब्लिक डेटा नेटवर्क (Packet-Switched Public Data Network)"},"o":[{"en":"Packet-Switched Public Data Network","hi":"पैकेट-स्विच्ड पब्लिक डेटा नेटवर्क (Packet-Switched Public Data Network)"},{"en":"Primary Storage Programmed Disk Network","hi":"प्राइमरी स्टोरेज प्रोग्राम्ड डिस्क नेटवर्क"},{"en":"Personal System Parallel Data Node","hi":"पर्सनल सिस्टम पैरेलल डेटा नोड"},{"en":"Public Satellite Private Digital Network","hi":"पब्लिक सैटेलाइट प्राइवेट डिजिटल नेटवर्क"}],"exp":{"en":"PSPDN stands for Packet-Switched Public Data Network.","hi":"PSPDN का पूर्ण रूप Packet-Switched Public Data Network है।"},"num":142},{"id":"q143","q":{"en":"What is the expansion of the legacy telecom term 'RABMN' in the chapter list?","hi":"अध्याय की सूची में दिए गए पुराने टेलीकॉम शब्द 'RABMN' का पूर्ण रूप क्या है?"},"a":{"en":"Remote Area Business Message Network","hi":"रिमोट एरिया बिजनेस मैसेज नेटवर्क (Remote Area Business Message Network)"},"o":[{"en":"Remote Area Business Message Network","hi":"रिमोट एरिया बिजनेस मैसेज नेटवर्क (Remote Area Business Message Network)"},{"en":"Random Access Binary Memory Node","hi":"रैंडम एक्सेस बाइनरी मेमोरी नोड"},{"en":"Regional Automated Banking Mainframe Network","hi":"रीजनल ऑटोमेटेड बैंकिंग मेनफ्रेम नेटवर्क"},{"en":"Radio Antenna Broadband Mobile Network","hi":"रेडियो एंटीना ब्रॉडबैंड मोबाइल नेटवर्क"}],"exp":{"en":"In Indian telecommunications/networking exam glossaries, RABMN stands for Remote Area Business Message Network (a satellite-based data network service).","hi":"RABMN का पूर्ण रूप Remote Area Business Message Network है।"},"num":143},{"id":"q144","q":{"en":"What is the full form of LAN?","hi":"LAN का पूर्ण रूप (Full Form) क्या है?"},"a":{"en":"Local Area Network","hi":"लोकल एरिया नेटवर्क (Local Area Network)"},"o":[{"en":"Local Area Network","hi":"लोकल एरिया नेटवर्क (Local Area Network)"},{"en":"Large Array Node","hi":"लार्ज ऐरे नोड"},{"en":"Logical Arithmetic Network","hi":"लॉजिकल अरिथमेटिक नेटवर्क"},{"en":"Laser Assisted Navigation","hi":"लेजर असिस्टेड नेविगेशन"}],"exp":{"en":"LAN stands for Local Area Network (a computer network covering a small geographical area like a home, office, or building).","hi":"LAN का पूर्ण रूप Local Area Network है।"},"num":144},{"id":"q145","q":{"en":"What is the full form of WAN?","hi":"WAN का पूर्ण रूप (Full Form) क्या है?"},"a":{"en":"Wide Area Network","hi":"वाइड एरिया नेटवर्क (Wide Area Network)"},"o":[{"en":"Wide Area Network","hi":"वाइड एरिया नेटवर्क (Wide Area Network)"},{"en":"Wireless Analog Node","hi":"वायरलेस एनालॉग नोड"},{"en":"World Application Network","hi":"वर्ल्ड एप्लिकेशन नेटवर्क"},{"en":"Wired Access Terminal","hi":"वायर्ड एक्सेस टर्मिनल"}],"exp":{"en":"WAN stands for Wide Area Network (a network spanning a large geographical distance such as across cities, countries, or the globe).","hi":"WAN का पूर्ण रूप Wide Area Network है।"},"num":145},{"id":"q146","q":{"en":"What is the full form of MAN?","hi":"MAN का पूर्ण रूप (Full Form) क्या है?"},"a":{"en":"Metropolitan Area Network","hi":"मेट्रोपॉलिटन एरिया नेटवर्क (Metropolitan Area Network)"},"o":[{"en":"Metropolitan Area Network","hi":"मेट्रोपॉलिटन एरिया नेटवर्क (Metropolitan Area Network)"},{"en":"Mainframe Access Node","hi":"मेनफ्रेम एक्सेस नोड"},{"en":"Microprocessor Array Network","hi":"माइक्रोप्रोसेसर ऐरे नेटवर्क"},{"en":"Manual Analog Network","hi":"मैनुअल एनालॉग नेटवर्क"}],"exp":{"en":"MAN stands for Metropolitan Area Network (a network covering a city or large campus).","hi":"MAN का पूर्ण रूप Metropolitan Area Network है।"},"num":146},{"id":"q147","q":{"en":"What is the full form of CDMA?","hi":"CDMA का पूर्ण रूप (Full Form) क्या है?"},"a":{"en":"Code Division Multiple Access","hi":"कोड डिवीजन मल्टीपल एक्सेस (Code Division Multiple Access)"},"o":[{"en":"Code Division Multiple Access","hi":"कोड डिवीजन मल्टीपल एक्सेस (Code Division Multiple Access)"},{"en":"Central Direct Memory Access","hi":"सेंट्रल डायरेक्ट मेमोरी एक्सेस"},{"en":"Compact Disc Media Adapter","hi":"कॉम्पैक्ट डिस्क मीडिया एडेप्टर"},{"en":"Computer Driven Mobile Application","hi":"कंप्यूटर ड्रिवन मोबाइल एप्लिकेशन"}],"exp":{"en":"CDMA stands for Code Division Multiple Access, a digital cellular radio channel access method.","hi":"CDMA का पूर्ण रूप Code Division Multiple Access है।"},"num":147},{"id":"q148","q":{"en":"What is the full form of GIAS (sometimes printed as GAIS on exam slides)?","hi":"GIAS (जिसे स्लाइड में कभी-कभी GAIS क्रम में लिखा जाता है) का पूर्ण रूप क्या है?"},"a":{"en":"Gateway Internet Access Service (launched by VSNL in India in 1995)","hi":"गेटवे इंटरनेट एक्सेस सर्विस (Gateway Internet Access Service)"},"o":[{"en":"Gateway Internet Access Service (launched by VSNL in India in 1995)","hi":"गेटवे इंटरनेट एक्सेस सर्विस (Gateway Internet Access Service)"},{"en":"Global Information And Software","hi":"ग्लोबल इन्फॉर्मेशन एंड सॉफ्टवेयर"},{"en":"Graphical Interface Application System","hi":"ग्राफिकल इंटरफेस एप्लिकेशन सिस्टम"},{"en":"General Input Arithmetic Server","hi":"जनरल इनपुट अरिथमेटिक सर्वर"}],"exp":{"en":"GIAS (occasionally transposed as GAIS in slides) stands for Gateway Internet Access Service, which was VSNL's pioneering public internet service in India.","hi":"GIAS (स्रोत स्लाइड में GAIS) का पूर्ण रूप Gateway Internet Access Service है।"},"num":148},{"id":"q149","q":{"en":"What is the full form of E-mail?","hi":"E-mail का पूर्ण रूप (Full Form) क्या है?"},"a":{"en":"Electronic Mail","hi":"इलेक्ट्रॉनिक मेल (Electronic Mail)"},"o":[{"en":"Electronic Mail","hi":"इलेक्ट्रॉनिक मेल (Electronic Mail)"},{"en":"Emergency Mail","hi":"इमरजेंसी मेल"},{"en":"Encrypted Message Link","hi":"एन्क्रिप्टेड मैसेज लिंक"},{"en":"External Modem Line","hi":"एक्सटर्नल मॉडेम लाइन"}],"exp":{"en":"E-mail stands for Electronic Mail.","hi":"E-mail का पूर्ण रूप Electronic Mail है।"},"num":149},{"id":"q150","q":{"en":"What is the full form of CD?","hi":"CD का पूर्ण रूप (Full Form) क्या है?"},"a":{"en":"Compact Disc","hi":"कॉम्पैक्ट डिस्क (Compact Disc)"},"o":[{"en":"Compact Disc","hi":"कॉम्पैक्ट डिस्क (Compact Disc)"},{"en":"Central Display","hi":"सेंट्रल डिस्प्ले"},{"en":"Coded Data","hi":"कोडेड डेटा"},{"en":"Computer Driver","hi":"कंप्यूटर ड्राइवर"}],"exp":{"en":"CD stands for Compact Disc.","hi":"CD का पूर्ण रूप Compact Disc है।"},"num":150},{"id":"q151","q":{"en":"What is the chapter expansion of 'LDU', and what is the standard expansion of 'LCD'?","hi":"अध्याय में 'LDU' का विस्तार क्या दिया गया है, और 'LCD' का मानक विस्तार क्या है?"},"a":{"en":"LDU → Liquid Display Unit (contextual slide label); LCD → Liquid Crystal Display","hi":"LDU → लिक्विड डिस्प्ले यूनिट; LCD → लिक्विड क्रिस्टल डिस्प्ले (Liquid Crystal Display)"},"o":[{"en":"LDU → Liquid Display Unit (contextual slide label); LCD → Liquid Crystal Display","hi":"LDU → लिक्विड डिस्प्ले यूनिट; LCD → लिक्विड क्रिस्टल डिस्प्ले (Liquid Crystal Display)"},{"en":"LDU → Laser Disk Unit; LCD → Laser Cathode Diode","hi":"LDU → लेजर डिस्क यूनिट; LCD → लेजर कैथोड डायोड"},{"en":"LDU → Local Data Utility; LCD → Local Computer Display","hi":"LDU → लोकल डेटा यूटिलिटी; LCD → लोकल कंप्यूटर डिस्प्ले"},{"en":"LDU → Linear Logic Unit; LCD → Linear Circuit Board","hi":"LDU → लीनियर लॉजिक यूनिट; LCD → लीनियर सर्किट बोर्ड"}],"exp":{"en":"In the source slide's abbreviation list, LDU is expanded as Liquid Display Unit, while the standard display acronym LCD stands for Liquid Crystal Display.","hi":"अध्याय की स्लाइड में LDU का विस्तार Liquid Display Unit दिया गया है, जबकि मानक शब्द LCD का पूर्ण रूप Liquid Crystal Display है।"},"num":151},{"id":"q152","q":{"en":"What is the full form of CPU?","hi":"CPU का पूर्ण रूप (Full Form) क्या है?"},"a":{"en":"Central Processing Unit","hi":"सेंट्रल प्रोसेसिंग यूनिट (Central Processing Unit)"},"o":[{"en":"Central Processing Unit","hi":"सेंट्रल प्रोसेसिंग यूनिट (Central Processing Unit)"},{"en":"Control Program Utility","hi":"कंट्रोल प्रोग्राम यूटिलिटी"},{"en":"Central Peripheral Unit","hi":"सेंट्रल पेरिफेरल यूनिट"},{"en":"Computer Power Unit","hi":"कंप्यूटर पावर यूनिट"}],"exp":{"en":"CPU stands for Central Processing Unit.","hi":"CPU का पूर्ण रूप Central Processing Unit है।"},"num":152},{"id":"q153","q":{"en":"What is the full form of CAM?","hi":"CAM का पूर्ण रूप (Full Form) क्या है?"},"a":{"en":"Computer-Aided Manufacturing","hi":"कंप्यूटर-एडेड मैन्युफैक्चरिंग (Computer-Aided Manufacturing)"},"o":[{"en":"Computer-Aided Manufacturing","hi":"कंप्यूटर-एडेड मैन्युफैक्चरिंग (Computer-Aided Manufacturing)"},{"en":"Central Address Memory","hi":"सेंट्रल एड्रेस मेमोरी"},{"en":"Code Access Module","hi":"कोड एक्सेस मॉड्यूल"},{"en":"Compact Analog Monitor","hi":"कॉम्पैक्ट एनालॉग मॉनिटर"}],"exp":{"en":"CAM stands for Computer-Aided Manufacturing.","hi":"CAM का पूर्ण रूप Computer-Aided Manufacturing है।"},"num":153},{"id":"q154","q":{"en":"In medical imaging, what is the full form of 'CAT' in CAT Scan?","hi":"CAT स्कैन में 'CAT' का पूर्ण रूप क्या है?"},"a":{"en":"Computerized Axial Tomography","hi":"कंप्यूटराइज्ड एक्सियल टोमोग्राफी (Computerized Axial Tomography)"},"o":[{"en":"Computerized Axial Tomography","hi":"कंप्यूटराइज्ड एक्सियल टोमोग्राफी (Computerized Axial Tomography)"},{"en":"Computer Assisted Translation","hi":"कंप्यूटर असिस्टेड ट्रांसलेशन"},{"en":"Central Analog Terminal","hi":"सेंट्रल एनालॉग टर्मिनल"},{"en":"Cathode Anode Tube","hi":"कैथोड एनोड ट्यूब"}],"exp":{"en":"In a CAT scan (CT scan), CAT stands for Computerized (or Computed) Axial Tomography.","hi":"CAT स्कैन में CAT का पूर्ण रूप Computerized Axial Tomography है।"},"num":154},{"id":"q155","q":{"en":"What is the full form of COBOL?","hi":"COBOL का पूर्ण रूप (Full Form) क्या है?"},"a":{"en":"Common Business-Oriented Language","hi":"कॉमन बिजनेस-ओरिएंटेड लैंग्वेज (Common Business-Oriented Language)"},"o":[{"en":"Common Business-Oriented Language","hi":"कॉमन बिजनेस-ओरिएंटेड लैंग्वेज (Common Business-Oriented Language)"},{"en":"Computer Basic Operating Language","hi":"कंप्यूटर बेसिक ऑपरेटिंग लैंग्वेज"},{"en":"Compiled Binary Object Logic","hi":"कंपाइल्ड बाइनरी ऑब्जेक्ट लॉजिक"},{"en":"Central Business Optical Link","hi":"सेंट्रल बिजनेस ऑप्टिकल लिंक"}],"exp":{"en":"COBOL stands for Common Business-Oriented Language.","hi":"COBOL का पूर्ण रूप Common Business-Oriented Language है।"},"num":155},{"id":"q156","q":{"en":"What is the full form of the programming language 'COMAL'?","hi":"प्रोग्रामिंग भाषा 'COMAL' का पूर्ण रूप क्या है?"},"a":{"en":"Common Algorithmic Language","hi":"कॉमन एल्गोरिदमिक लैंग्वेज (Common Algorithmic Language)"},"o":[{"en":"Common Algorithmic Language","hi":"कॉमन एल्गोरिदमिक लैंग्वेज (Common Algorithmic Language)"},{"en":"Computer Machine Assembly Language","hi":"कंप्यूटर मशीन असेंबली लैंग्वेज"},{"en":"Commercial Mathematical Logic","hi":"कमर्शियल मैथमेटिकल लॉजिक"},{"en":"Central Office Mail Application","hi":"सेंट्रल ऑफिस मेल एप्लिकेशन"}],"exp":{"en":"COMAL stands for Common Algorithmic Language (a structured educational programming language blending elements of BASIC and Pascal).","hi":"COMAL का पूर्ण रूप Common Algorithmic Language है।"},"num":156},{"id":"q157","q":{"en":"What is the full form of DOS?","hi":"DOS का पूर्ण रूप (Full Form) क्या है?"},"a":{"en":"Disk Operating System","hi":"डिस्क ऑपरेटिंग सिस्टम (Disk Operating System)"},"o":[{"en":"Disk Operating System","hi":"डिस्क ऑपरेटिंग सिस्टम (Disk Operating System)"},{"en":"Digital Optical Storage","hi":"डिजिटल ऑप्टिकल स्टोरेज"},{"en":"Direct Output Server","hi":"डायरेक्ट आउटपुट सर्वर"},{"en":"Data Organization Software","hi":"डेटा ऑर्गेनाइजेशन सॉफ्टवेयर"}],"exp":{"en":"DOS stands for Disk Operating System.","hi":"DOS का पूर्ण रूप Disk Operating System है।"},"num":157},{"id":"q158","q":{"en":"What is the chapter expansion of 'DTS' in the abbreviation list?","hi":"अध्याय की संक्षिप्त रूप सूची में 'DTS' का विस्तार क्या दिया गया है?"},"a":{"en":"Desktop System (note that in audio/other contexts DTS can have other meanings)","hi":"डेस्कटॉप सिस्टम (Desktop System)"},"o":[{"en":"Desktop System (note that in audio/other contexts DTS can have other meanings)","hi":"डेस्कटॉप सिस्टम (Desktop System)"},{"en":"Disk Tape Storage","hi":"डिस्क टेप स्टोरेज"},{"en":"Dynamic Thread Scheduler","hi":"डायनेमिक थ्रेड शेड्यूलर"},{"en":"Digital Transistor Switch","hi":"डिजिटल ट्रांजिस्टर स्विच"}],"exp":{"en":"In the chapter's computer abbreviation table, DTS is expanded as Desktop System.","hi":"अध्याय की तालिका में DTS का विस्तार Desktop System दिया गया है (हालाँकि अलग-अलग संदर्भों में इसके अन्य अर्थ भी हो सकते हैं)।"},"num":158},{"id":"q159","q":{"en":"What is the full form of DTP?","hi":"DTP का पूर्ण रूप (Full Form) क्या है?"},"a":{"en":"Desktop Publishing","hi":"डेस्कटॉप पब्लिशिंग (Desktop Publishing)"},"o":[{"en":"Desktop Publishing","hi":"डेस्कटॉप पब्लिशिंग (Desktop Publishing)"},{"en":"Data Transfer Protocol","hi":"डेटा ट्रांसफर प्रोटोकॉल"},{"en":"Digital Text Processor","hi":"डिजिटल टेक्स्ट प्रोसेसर"},{"en":"Disk Track Partition","hi":"डिस्क ट्रैक पार्टीशन"}],"exp":{"en":"DTP stands for Desktop Publishing (using page-layout software on a computer to design books, magazines, brochures, and newspapers).","hi":"DTP का पूर्ण रूप Desktop Publishing है।"},"num":159},{"id":"q160","q":{"en":"What is the full form of E-commerce?","hi":"E-commerce का पूर्ण रूप (Full Form) क्या है?"},"a":{"en":"Electronic Commerce","hi":"इलेक्ट्रॉनिक कॉमर्स (Electronic Commerce)"},"o":[{"en":"Electronic Commerce","hi":"इलेक्ट्रॉनिक कॉमर्स (Electronic Commerce)"},{"en":"Enterprise Communication","hi":"एंटरप्राइज कम्युनिकेशन"},{"en":"External Computer Marketing","hi":"एक्सटर्नल कंप्यूटर मार्केटिंग"},{"en":"Electrical Component Manufacturing","hi":"इलेक्ट्रिकल कंपोनेंट मैन्युफैक्चरिंग"}],"exp":{"en":"E-commerce stands for Electronic Commerce (buying and selling goods and services over electronic networks such as the internet).","hi":"E-commerce का पूर्ण रूप Electronic Commerce है।"},"num":160},{"id":"q161","q":{"en":"What is the full form of ENIAC?","hi":"ENIAC का पूर्ण रूप (Full Form) क्या है?"},"a":{"en":"Electronic Numerical Integrator and Computer","hi":"इलेक्ट्रॉनिक न्यूमेरिकल इंटीग्रेटर एंड कंप्यूटर (Electronic Numerical Integrator and Computer)"},"o":[{"en":"Electronic Numerical Integrator and Computer","hi":"इलेक्ट्रॉनिक न्यूमेरिकल इंटीग्रेटर एंड कंप्यूटर (Electronic Numerical Integrator and Computer)"},{"en":"Electrical Network for Integrated Arithmetic Calculations","hi":"इलेक्ट्रिकल नेटवर्क फॉर इंटीग्रेटेड अरिथमेटिक कैलकुलेशन्स"},{"en":"Enhanced National Industrial Automatic Calculator","hi":"एन्हांस्ड नेशनल इंडस्ट्रियल ऑटोमैटिक कैलकुलेटर"},{"en":"Encoded Number Indicator and Compiler","hi":"एनकोडेड नंबर इंडिकेटर एंड कंपाइलर"}],"exp":{"en":"ENIAC stands for Electronic Numerical Integrator and Computer.","hi":"ENIAC का पूर्ण रूप Electronic Numerical Integrator and Computer है।"},"num":161},{"id":"q162","q":{"en":"Which word is 'Fax' a short form of, and what textbook backronym is given on the chapter slide?","hi":"'Fax' किस शब्द का संक्षिप्त रूप है, और अध्याय स्लाइड में इसका कौन-सा पाठ्यपुस्तक बैक्रोनम (Backronym) दिया गया है?"},"a":{"en":"Short form of 'Facsimile'; the slide also gives the textbook backronym 'Facsimile Automated Xerox'","hi":"'Facsimile' का संक्षिप्त रूप; स्लाइड में इसका बैक्रोनम 'Facsimile Automated Xerox' भी दिया गया है"},"o":[{"en":"Short form of 'Facsimile'; the slide also gives the textbook backronym 'Facsimile Automated Xerox'","hi":"'Facsimile' का संक्षिप्त रूप; स्लाइड में इसका बैक्रोनम 'Facsimile Automated Xerox' भी दिया गया है"},{"en":"Short form of 'Fast Axis'; backronym is 'Fast Audio Exchange'","hi":"'Fast Axis' का संक्षिप्त रूप; बैक्रोनम 'Fast Audio Exchange' है"},{"en":"Short form of 'Fiber Access'; backronym is 'Fiber Array X-ray'","hi":"'Fiber Access' का संक्षिप्त रूप; बैक्रोनम 'Fiber Array X-ray' है"},{"en":"Short form of 'File Archive'; backronym is 'File Application XML'","hi":"'File Archive' का संक्षिप्त रूप; बैक्रोनम 'File Application XML' है"}],"exp":{"en":"The word 'Fax' is the standard short form of 'Facsimile' (telefacsimile). Some Indian exam slides also list the textbook backronym 'Facsimile Automated Xerox'.","hi":"'Fax' वास्तव में 'Facsimile' (टेलीफैक्सिमिली) शब्द का संक्षिप्त रूप है। अध्याय की स्लाइड में इसका पाठ्यपुस्तक बैक्रोनम 'Facsimile Automated Xerox' भी दिया गया है।"},"num":162},{"id":"q163","q":{"en":"What is the full form of FLOPS?","hi":"FLOPS का पूर्ण रूप (Full Form) क्या है?"},"a":{"en":"Floating-Point Operations Per Second","hi":"फ्लोटिंग-पॉइंट ऑपरेशन्स पर सेकंड (Floating-Point Operations Per Second)"},"o":[{"en":"Floating-Point Operations Per Second","hi":"फ्लोटिंग-पॉइंट ऑपरेशन्स पर सेकंड (Floating-Point Operations Per Second)"},{"en":"File Loading Operating System","hi":"फ़ाइल लोडिंग ऑपरेटिंग सिस्टम"},{"en":"Fast Logical Output Per Second","hi":"फास्ट लॉजिकल आउटपुट पर सेकंड"},{"en":"Floppy Disk Operations Per Sector","hi":"फ्लॉपी डिस्क ऑपरेशन्स पर सेक्टर"}],"exp":{"en":"FLOPS stands for Floating-Point Operations Per Second, a standard measure of computer/supercomputer numerical performance.","hi":"FLOPS का पूर्ण रूप Floating-Point Operations Per Second है (इसका उपयोग मुख्य रूप से सुपर कंप्यूटर की गणना गति मापने में होता है)।"},"num":163},{"id":"q164","q":{"en":"What is the full form of FORTRAN?","hi":"FORTRAN का पूर्ण रूप (Full Form) क्या है?"},"a":{"en":"Formula Translation","hi":"फॉर्मूला ट्रांसलेशन (Formula Translation)"},"o":[{"en":"Formula Translation","hi":"फॉर्मूला ट्रांसलेशन (Formula Translation)"},{"en":"Forward Transistor Network","hi":"फॉरवर्ड ट्रांजिस्टर नेटवर्क"},{"en":"Format Transfer Utility","hi":"फॉर्मेट ट्रांसफर यूटिलिटी"},{"en":"Foreign Transaction System","hi":"फॉरेन ट्रांजेक्शन सिस्टम"}],"exp":{"en":"FORTRAN stands for Formula Translation, the pioneering high-level programming language developed by IBM for scientific and engineering calculations.","hi":"FORTRAN का पूर्ण रूप Formula Translation है।"},"num":164},{"id":"q165","q":{"en":"What is the full form of HLL?","hi":"HLL का पूर्ण रूप (Full Form) क्या है?"},"a":{"en":"High-Level Language","hi":"हाई-लेवल लैंग्वेज (High-Level Language)"},"o":[{"en":"High-Level Language","hi":"हाई-लेवल लैंग्वेज (High-Level Language)"},{"en":"Hardware Logic Layer","hi":"हार्डवेयर लॉजिक लेयर"},{"en":"Hyperlink Local List","hi":"हाइपरलिंक लोकल लिस्ट"},{"en":"Hybrid Laser Lens","hi":"हाइब्रिड लेजर लेंस"}],"exp":{"en":"HLL stands for High-Level Language.","hi":"HLL का पूर्ण रूप High-Level Language (उच्च-स्तरीय भाषा) है।"},"num":165}]},{"title":{"en":"11. Abbreviations — Hardware, Web & File Formats","hi":"11. संक्षिप्त रूप — हार्डवेयर, वेब और फाइल फॉर्मेट"},"questions":[{"id":"q166","q":{"en":"What is the full form of HTML?","hi":"HTML का पूर्ण रूप (Full Form) क्या है?"},"a":{"en":"Hypertext Markup Language","hi":"हाइपरटेक्स्ट मार्कअप लैंग्वेज (Hypertext Markup Language)"},"o":[{"en":"Hypertext Markup Language","hi":"हाइपरटेक्स्ट मार्कअप लैंग्वेज (Hypertext Markup Language)"},{"en":"High Text Machine Language","hi":"हाई टेक्स्ट मशीन लैंग्वेज"},{"en":"Hyperlink Transmission Module","hi":"हाइपरलिंक ट्रांसमिशन मॉड्यूल"},{"en":"Hybrid Terminal Markup Logic","hi":"हाइब्रिड टर्मिनल मार्कअप लॉजिक"}],"exp":{"en":"HTML stands for Hypertext Markup Language, the standard markup language used to structure web pages.","hi":"HTML का पूर्ण रूप Hypertext Markup Language है।"},"num":166},{"id":"q167","q":{"en":"What is the full form of IBM?","hi":"IBM का पूर्ण रूप (Full Form) क्या है?"},"a":{"en":"International Business Machines","hi":"इंटरनेशनल बिजनेस मशीन्स (International Business Machines)"},"o":[{"en":"International Business Machines","hi":"इंटरनेशनल बिजनेस मशीन्स (International Business Machines)"},{"en":"Integrated Binary Microprocessors","hi":"इंटीग्रेटेड बाइनरी माइक्रोप्रोसेसर्स"},{"en":"Indian Board of Microcomputers","hi":"इंडियन बोर्ड ऑफ माइक्रो कम्प्यूटर्स"},{"en":"Internal Bus Management","hi":"इंटरनल बस मैनेजमेंट"}],"exp":{"en":"IBM stands for International Business Machines Corporation.","hi":"IBM का पूर्ण रूप International Business Machines है।"},"num":167},{"id":"q168","q":{"en":"What is the full form of IC?","hi":"IC का पूर्ण रूप (Full Form) क्या है?"},"a":{"en":"Integrated Circuit","hi":"इंटीग्रेटेड सर्किट (Integrated Circuit)"},"o":[{"en":"Integrated Circuit","hi":"इंटीग्रेटेड सर्किट (Integrated Circuit)"},{"en":"Internal Computer","hi":"इंटरनल कंप्यूटर"},{"en":"Instruction Counter","hi":"इंस्ट्रक्शन काउंटर"},{"en":"Internet Connection","hi":"इंटरनेट कनेक्शन"}],"exp":{"en":"IC stands for Integrated Circuit (semiconductor microchip).","hi":"IC का पूर्ण रूप Integrated Circuit (एकीकृत परिपथ) है।"},"num":168},{"id":"q169","q":{"en":"What is the chapter expansion of the entry 'ISH' on page 70?","hi":"अध्याय (पृष्ठ 70) में 'ISH' का विस्तार क्या दिया गया है?"},"a":{"en":"International Super Highway (chapter-specific glossary wording, related to Information Superhighway)","hi":"इंटरनेशनल सुपर हाईवे (International Super Highway — अध्याय-विशिष्ट शब्दावली)"},"o":[{"en":"International Super Highway (chapter-specific glossary wording, related to Information Superhighway)","hi":"इंटरनेशनल सुपर हाईवे (International Super Highway — अध्याय-विशिष्ट शब्दावली)"},{"en":"Internal System Hardware","hi":"इंटरनल सिस्टम हार्डवेयर"},{"en":"Integrated Software Hub","hi":"इंटीग्रेटेड सॉफ्टवेयर हब"},{"en":"Internet Security Host","hi":"इंटरनेट सिक्योरिटी होस्ट"}],"exp":{"en":"In the chapter's abbreviation table on page 70, ISH is expanded as 'International Super Highway' (a chapter-specific wording variant of Information Superhighway).","hi":"अध्याय की संक्षिप्त रूप सूची (पृष्ठ 70) में ISH का विस्तार 'International Super Highway' दिया गया है।"},"num":169},{"id":"q170","q":{"en":"From which phrase does the programming language 'LISP' derive its name?","hi":"प्रोग्रामिंग भाषा 'LISP' का नाम किस वाक्यांश (Phrase) से आता है?"},"a":{"en":"List Processing (LISt Processing)","hi":"लिस्ट प्रोसेसिंग (List Processing)"},"o":[{"en":"List Processing (LISt Processing)","hi":"लिस्ट प्रोसेसिंग (List Processing)"},{"en":"Linear System Programming","hi":"लीनियर सिस्टम प्रोग्रामिंग"},{"en":"Logical Instruction Set Processor","hi":"लॉजिकल इंस्ट्रक्शन सेट प्रोसेसर"},{"en":"Local Internet Server Protocol","hi":"लोकल इंटरनेट सर्वर प्रोटोकॉल"}],"exp":{"en":"LISP derives its name from 'LISt Processing' (or List Processor), a pioneering high-level programming language designed by John McCarthy in 1958 and widely used in Artificial Intelligence.","hi":"LISP का नाम 'List Processing' (LISt Processing) वाक्यांश से बना है।"},"num":170},{"id":"q171","q":{"en":"What is the full form of LLL?","hi":"LLL का पूर्ण रूप (Full Form) क्या है?"},"a":{"en":"Low-Level Language","hi":"लो-लेवल लैंग्वेज (Low-Level Language)"},"o":[{"en":"Low-Level Language","hi":"लो-लेवल लैंग्वेज (Low-Level Language)"},{"en":"Long Laser Link","hi":"लॉन्ग लेजर लिंक"},{"en":"Local Logic Loop","hi":"लोकल लॉजिक लूप"},{"en":"Linear List Language","hi":"लीनियर लिस्ट लैंग्वेज"}],"exp":{"en":"LLL stands for Low-Level Language (such as machine language and assembly language).","hi":"LLL का पूर्ण रूप Low-Level Language (निम्न-स्तरीय भाषा) है।"},"num":171},{"id":"q172","q":{"en":"What is the full form of MICR?","hi":"MICR का पूर्ण रूप (Full Form) क्या है?"},"a":{"en":"Magnetic Ink Character Recognition (the reading device is called an MICR reader)","hi":"मैग्नेटिक इंक कैरेक्टर रिकग्निशन (डिवाइस को MICR रीडर कहते हैं)"},"o":[{"en":"Magnetic Ink Character Recognition (the reading device is called an MICR reader)","hi":"मैग्नेटिक इंक कैरेक्टर रिकग्निशन (डिवाइस को MICR रीडर कहते हैं)"},{"en":"Micro Integrated Core Register","hi":"माइक्रो इंटीग्रेटेड कोर रजिस्टर"},{"en":"Multiple Input Code Reader","hi":"मल्टीपल इनपुट कोड रीडर"},{"en":"Mechanical Inkjet Colour Roller","hi":"मैकेनिकल इंकजेट कलर रोलर"}],"exp":{"en":"MICR stands for Magnetic Ink Character Recognition (used to read characters printed with magnetic ink on bank cheques; the hardware device is called an MICR reader).","hi":"MICR का पूर्ण रूप Magnetic Ink Character Recognition है (और इसे पढ़ने वाले उपकरण को MICR रीडर कहते हैं)।"},"num":172},{"id":"q173","q":{"en":"What is the full form of MIPS?","hi":"MIPS का पूर्ण रूप (Full Form) क्या है?"},"a":{"en":"Million Instructions Per Second","hi":"मिलियन इंस्ट्रक्शन्स पर सेकंड (Million Instructions Per Second)"},"o":[{"en":"Million Instructions Per Second","hi":"मिलियन इंस्ट्रक्शन्स पर सेकंड (Million Instructions Per Second)"},{"en":"Memory Input Processing System","hi":"मेमोरी इनपुट प्रोसेसिंग सिस्टम"},{"en":"Multiple Integrated Processor Sockets","hi":"मल्टीपल इंटीग्रेटेड प्रोसेसर सॉकेट्स"},{"en":"Magnetic Ink Printing Speed","hi":"मैग्नेटिक इंक प्रिंटिंग स्पीड"}],"exp":{"en":"MIPS stands for Million Instructions Per Second, a measure of a computer processor's instruction execution speed.","hi":"MIPS का पूर्ण रूप Million Instructions Per Second है।"},"num":173},{"id":"q174","q":{"en":"What is the full form of MOPS?","hi":"MOPS का पूर्ण रूप (Full Form) क्या है?"},"a":{"en":"Million Operations Per Second","hi":"मिलियन ऑपरेशन्स पर सेकंड (Million Operations Per Second)"},"o":[{"en":"Million Operations Per Second","hi":"मिलियन ऑपरेशन्स पर सेकंड (Million Operations Per Second)"},{"en":"Mainframe Operating Program System","hi":"मेनफ्रेम ऑपरेटिंग प्रोग्राम सिस्टम"},{"en":"Memory Output Parallel Switch","hi":"मेमोरी आउटपुट पैरेलल स्विच"},{"en":"Micro Optical Pixel Sensor","hi":"माइक्रो ऑप्टिकल पिक्सेल सेंसर"}],"exp":{"en":"MOPS stands for Million Operations Per Second.","hi":"MOPS का पूर्ण रूप Million Operations Per Second है।"},"num":174},{"id":"q175","q":{"en":"What is the full form of 'MPU' in this chapter (and what is its alternate meaning in embedded hardware security)?","hi":"इस अध्याय में 'MPU' का पूर्ण रूप क्या है (तथा एम्बेडेड सुरक्षा के संदर्भ में इसका दूसरा अर्थ क्या होता है)?"},"a":{"en":"Microprocessor Unit in the chapter list (in embedded architecture/security, MPU also stands for Memory Protection Unit)","hi":"अध्याय में: माइक्रोप्रोसेसर यूनिट (Microprocessor Unit); एम्बेडेड सुरक्षा संदर्भ में: मेमोरी प्रोटेक्शन यूनिट (Memory Protection Unit)"},"o":[{"en":"Microprocessor Unit in the chapter list (in embedded architecture/security, MPU also stands for Memory Protection Unit)","hi":"अध्याय में: माइक्रोप्रोसेसर यूनिट (Microprocessor Unit); एम्बेडेड सुरक्षा संदर्भ में: मेमोरी प्रोटेक्शन यूनिट (Memory Protection Unit)"},{"en":"Main Printer Utility","hi":"मेन प्रिंटर यूटिलिटी"},{"en":"Magnetic Platter Unit","hi":"मैग्नेटिक प्लैटर यूनिट"},{"en":"Monitor Power Unit","hi":"मॉनिटर पावर यूनिट"}],"exp":{"en":"In the chapter's abbreviation table, MPU stands for Microprocessor Unit. Note that in computer architecture and embedded systems, MPU also commonly stands for Memory Protection Unit.","hi":"इस अध्याय में MPU का पूर्ण रूप Microprocessor Unit है (हालाँकि एम्बेडेड हार्डवेयर सुरक्षा के संदर्भ में MPU का एक अन्य अर्थ Memory Protection Unit भी होता है)।"},"num":175},{"id":"q176","q":{"en":"Which organization's network is called 'NICNET'?","hi":"'NICNET' किस संस्था के नेटवर्क का नाम है?"},"a":{"en":"The satellite-based computer network of the National Informatics Centre (NIC), Government of India","hi":"नेशनल इन्फॉर्मेटिक्स सेंटर (National Informatics Centre - NIC) का नेटवर्क"},"o":[{"en":"The satellite-based computer network of the National Informatics Centre (NIC), Government of India","hi":"नेशनल इन्फॉर्मेटिक्स सेंटर (National Informatics Centre - NIC) का नेटवर्क"},{"en":"The internal gaming network of Nintendo Corporation","hi":"निनटेंडो कॉर्पोरेशन का आंतरिक गेमिंग नेटवर्क"},{"en":"An offline printer cable standard from 1975","hi":"1975 का एक ऑफ़लाइन प्रिंटर केबल मानक"},{"en":"A local Bluetooth network for wireless mice","hi":"वायरलेस माउस के लिए एक लोकल ब्लूटूथ नेटवर्क"}],"exp":{"en":"NICNET (National Informatics Centre Network) is the nationwide satellite-based e-governance communication network operated by India's National Informatics Centre (NIC).","hi":"NICNET भारत के राष्ट्रीय सूचना विज्ञान केंद्र (National Informatics Centre - NIC) के नेटवर्क का नाम है।"},"num":176},{"id":"q177","q":{"en":"What is the full form of OMR?","hi":"OMR का पूर्ण रूप (Full Form) क्या है?"},"a":{"en":"Optical Mark Recognition (the hardware device is called an optical mark reader)","hi":"ऑप्टिकल मार्क रिकग्निशन (डिवाइस को ऑप्टिकल मार्क रीडर कहते हैं)"},"o":[{"en":"Optical Mark Recognition (the hardware device is called an optical mark reader)","hi":"ऑप्टिकल मार्क रिकग्निशन (डिवाइस को ऑप्टिकल मार्क रीडर कहते हैं)"},{"en":"Online Memory Register","hi":"ऑनलाइन मेमोरी रजिस्टर"},{"en":"Output Monitor Resolution","hi":"आउटपुट मॉनिटर रेजोल्यूशन"},{"en":"Optical Magnetic Ribbon","hi":"ऑप्टिकल मैग्नेटिक रिबन"}],"exp":{"en":"OMR stands for Optical Mark Recognition (and the scanning device is often called an Optical Mark Reader).","hi":"OMR का पूर्ण रूप Optical Mark Recognition है (और इसके उपकरण को ऑप्टिकल मार्क रीडर कहा जाता है)।"},"num":177},{"id":"q178","q":{"en":"What is the full form of PC-DOS?","hi":"PC-DOS का पूर्ण रूप (Full Form) क्या है?"},"a":{"en":"Personal Computer Disk Operating System","hi":"पर्सनल कंप्यूटर डिस्क ऑपरेटिंग सिस्टम (Personal Computer Disk Operating System)"},"o":[{"en":"Personal Computer Disk Operating System","hi":"पर्सनल कंप्यूटर डिस्क ऑपरेटिंग सिस्टम (Personal Computer Disk Operating System)"},{"en":"Parallel Central Data Operating Server","hi":"पैरेलल सेंट्रल डेटा ऑपरेटिंग सर्वर"},{"en":"Printed Circuit Digital Output System","hi":"प्रिंटेड सर्किट डिजिटल आउटपुट सिस्टम"},{"en":"Programmable Cache Disk Organization Software","hi":"प्रोग्रामेबल कैश डिस्क ऑर्गेनाइजेशन सॉफ्टवेयर"}],"exp":{"en":"PC-DOS stands for Personal Computer Disk Operating System (IBM's licensed version of MS-DOS shipped with the original IBM Personal Computer).","hi":"PC-DOS का पूर्ण रूप Personal Computer Disk Operating System है।"},"num":178},{"id":"q179","q":{"en":"What is the full form of PROM?","hi":"PROM का पूर्ण रूप (Full Form) क्या है?"},"a":{"en":"Programmable Read-Only Memory","hi":"प्रोग्रामेबल रीड-ओनली मेमोरी (Programmable Read-Only Memory)"},"o":[{"en":"Programmable Read-Only Memory","hi":"प्रोग्रामेबल रीड-ओनली मेमोरी (Programmable Read-Only Memory)"},{"en":"Primary Random Optical Memory","hi":"प्राइमरी रैंडम ऑप्टिकल मेमोरी"},{"en":"Processor Register Output Module","hi":"प्रोसेसर रजिस्टर आउटपुट मॉड्यूल"},{"en":"Public Read-Only Media","hi":"पब्लिक रीड-ओनली मीडिया"}],"exp":{"en":"PROM stands for Programmable Read-Only Memory.","hi":"PROM का पूर्ण रूप Programmable Read-Only Memory है।"},"num":179},{"id":"q180","q":{"en":"What is the conventional exam expansion of the historical programming language 'SNOBOL'?","hi":"ऐतिहासिक प्रोग्रामिंग भाषा 'SNOBOL' का पारंपरिक परीक्षा विस्तार (Full Form) क्या है?"},"a":{"en":"String-Oriented Symbolic Language","hi":"स्ट्रिंग-ओरिएंटेड सिम्बॉलिक लैंग्वेज (String-Oriented Symbolic Language)"},"o":[{"en":"String-Oriented Symbolic Language","hi":"स्ट्रिंग-ओरिएंटेड सिम्बॉलिक लैंग्वेज (String-Oriented Symbolic Language)"},{"en":"System Numeric Object Binary Language","hi":"सिस्टम न्यूमेरिक ऑब्जेक्ट बाइनरी लैंग्वेज"},{"en":"Standard Network Operating Business Language","hi":"स्टैंडर्ड नेटवर्क ऑपरेटिंग बिजनेस लैंग्वेज"},{"en":"Sequential Node Oriented Basic Logic","hi":"सीक्वेंशियल नोड ओरिएंटेड बेसिक लॉजिक"}],"exp":{"en":"SNOBOL (developed at Bell Labs in the 1960s for text/string manipulation) is conventionally expanded in exams as String-Oriented Symbolic Language (historically StriNg Oriented and symBOlic Language).","hi":"ऐतिहासिक प्रोग्रामिंग भाषा SNOBOL का पारंपरिक परीक्षा विस्तार String-Oriented Symbolic Language है।"},"num":180},{"id":"q181","q":{"en":"What is the full form of UPS?","hi":"UPS का पूर्ण रूप (Full Form) क्या है?"},"a":{"en":"Uninterruptible Power Supply","hi":"अनइंटरप्टिबल पावर सप्लाई (Uninterruptible Power Supply)"},"o":[{"en":"Uninterruptible Power Supply","hi":"अनइंटरप्टिबल पावर सप्लाई (Uninterruptible Power Supply)"},{"en":"Universal Processing System","hi":"यूनिवर्सल प्रोसेसिंग सिस्टम"},{"en":"Uniform Parallel Socket","hi":"यूनिफॉर्म पैरेलल सॉकेट"},{"en":"User Program Storage","hi":"यूज़र प्रोग्राम स्टोरेज"}],"exp":{"en":"UPS stands for Uninterruptible Power Supply (or Uninterruptible Power Source), which provides battery backup power when the main power source fails.","hi":"UPS का पूर्ण रूप Uninterruptible Power Supply है।"},"num":181},{"id":"q182","q":{"en":"What is the full form of VDU?","hi":"VDU का पूर्ण रूप (Full Form) क्या है?"},"a":{"en":"Visual Display Unit (or Video Display Unit, referring to a computer monitor)","hi":"विजुअल डिस्प्ले यूनिट (Visual Display Unit)"},"o":[{"en":"Visual Display Unit (or Video Display Unit, referring to a computer monitor)","hi":"विजुअल डिस्प्ले यूनिट (Visual Display Unit)"},{"en":"Virtual Disk Utility","hi":"वर्चुअल डिस्क यूटिलिटी"},{"en":"Variable Data Unit","hi":"वेरिएबल डेटा यूनिट"},{"en":"Volatile DRAM Unit","hi":"वोलेटाइल DRAM यूनिट"}],"exp":{"en":"VDU stands for Visual Display Unit (another name for a computer monitor/display screen).","hi":"VDU का पूर्ण रूप Visual Display Unit है।"},"num":182},{"id":"q183","q":{"en":"What is the full form of VLSI?","hi":"VLSI का पूर्ण रूप (Full Form) क्या है?"},"a":{"en":"Very-Large-Scale Integration","hi":"वेरी-लार्ज-स्केल इंटीग्रेशन (Very-Large-Scale Integration)"},"o":[{"en":"Very-Large-Scale Integration","hi":"वेरी-लार्ज-स्केल इंटीग्रेशन (Very-Large-Scale Integration)"},{"en":"Visual Light Sensor Interface","hi":"विजुअल लाइट सेंसर इंटरफेस"},{"en":"Virtual Local System Interconnect","hi":"वर्चुअल लोकल सिस्टम इंटरकनेक्ट"},{"en":"Variable Length Symbolic Instruction","hi":"वेरिएबल लेंथ सिम्बॉलिक इंस्ट्रक्शन"}],"exp":{"en":"VLSI stands for Very-Large-Scale Integration, the process of integrating hundreds of thousands or millions of transistors onto a single silicon microchip (characteristic of Fourth-Generation computers).","hi":"VLSI का पूर्ण रूप Very-Large-Scale Integration है।"},"num":183},{"id":"q184","q":{"en":"What is the full form of WWW?","hi":"WWW का पूर्ण रूप (Full Form) क्या है?"},"a":{"en":"World Wide Web","hi":"वर्ल्ड वाइड वेब (World Wide Web)"},"o":[{"en":"World Wide Web","hi":"वर्ल्ड वाइड वेब (World Wide Web)"},{"en":"Wide World Wireless","hi":"वाइड वर्ल्ड वायरलेस"},{"en":"Web Window Workstation","hi":"वेब विंडो वर्कस्टेशन"},{"en":"Whole World WAN","hi":"होल वर्ल्ड वैन"}],"exp":{"en":"WWW stands for World Wide Web (invented by Tim Berners-Lee in 1989).","hi":"WWW का पूर्ण रूप World Wide Web है।"},"num":184},{"id":"q185","q":{"en":"What is the full form of CCTV?","hi":"CCTV का पूर्ण रूप (Full Form) क्या है?"},"a":{"en":"Closed-Circuit Television","hi":"क्लोज्ड-सर्किट टेलीविजन (Closed-Circuit Television)"},"o":[{"en":"Closed-Circuit Television","hi":"क्लोज्ड-सर्किट टेलीविजन (Closed-Circuit Television)"},{"en":"Central Computer Terminal Video","hi":"सेंट्रल कंप्यूटर टर्मिनल वीडियो"},{"en":"Continuous Colour Television","hi":"कंटीन्यूअस कलर टेलीविजन"},{"en":"Cable Connected Transmitted Video","hi":"केबल कनेक्टेड ट्रांसमिटेड वीडियो"}],"exp":{"en":"CCTV stands for Closed-Circuit Television, a video surveillance system in which signals are transmitted to a specific, limited set of monitors rather than publicly broadcast.","hi":"CCTV का पूर्ण रूप Closed-Circuit Television है।"},"num":185},{"id":"q186","q":{"en":"With which phrase do the chapter notes associate 'Wi-Fi', and what is its actual status?","hi":"अध्याय नोट्स 'Wi-Fi' को किस वाक्यांश से जोड़ते हैं, और वास्तव में यह क्या है?"},"a":{"en":"Notes list 'Wireless Fidelity' (which appears in many exam glossaries, though technically Wi-Fi is a trademarked brand name for IEEE 802.11 wireless networking)","hi":"नोट्स में 'Wireless Fidelity' दिया गया है (हालाँकि तकनीकी रूप से Wi-Fi एक ब्रांड नाम है)"},"o":[{"en":"Notes list 'Wireless Fidelity' (which appears in many exam glossaries, though technically Wi-Fi is a trademarked brand name for IEEE 802.11 wireless networking)","hi":"नोट्स में 'Wireless Fidelity' दिया गया है (हालाँकि तकनीकी रूप से Wi-Fi एक ब्रांड नाम है)"},{"en":"Wired Fiber Internet","hi":"वायर्ड फाइबर इंटरनेट"},{"en":"Wide Frequency Interface","hi":"वाइड फ्रीक्वेंसी इंटरफेस"},{"en":"Windows File Integration","hi":"विंडोज़ फ़ाइल इंटीग्रेशन"}],"exp":{"en":"In standard Indian competitive exam glossaries and the chapter notes, Wi-Fi is expanded as 'Wireless Fidelity'. Fact-check note: Technically, Wi-Fi is a brand name coined by the Wi-Fi Alliance for IEEE 802.11 wireless LAN technology, but 'Wireless Fidelity' is the expected answer if an exam asks for its full form.","hi":"अध्याय के नोट्स और कई परीक्षा शब्दावलियों में Wi-Fi को 'Wireless Fidelity' से जोड़ा जाता है (यद्यपि तकनीकी रूप से Wi-Fi, IEEE 802.11 वायरलेस तकनीक का एक ब्रांड नाम है)।"},"num":186},{"id":"q187","q":{"en":"What is the full form of ISP?","hi":"ISP का पूर्ण रूप (Full Form) क्या है?"},"a":{"en":"Internet Service Provider","hi":"इंटरनेट सर्विस प्रोवाइडर (Internet Service Provider)"},"o":[{"en":"Internet Service Provider","hi":"इंटरनेट सर्विस प्रोवाइडर (Internet Service Provider)"},{"en":"Internal System Processor","hi":"इंटरनल सिस्टम प्रोसेसर"},{"en":"Integrated Software Package","hi":"इंटीग्रेटेड सॉफ्टवेयर पैकेज"},{"en":"International Signal Protocol","hi":"इंटरनेशनल सिग्नल प्रोटोकॉल"}],"exp":{"en":"ISP stands for Internet Service Provider, an organization that provides services for accessing and using the internet.","hi":"ISP का पूर्ण रूप Internet Service Provider है।"},"num":187},{"id":"q188","q":{"en":"What is the full form of GPS?","hi":"GPS का पूर्ण रूप (Full Form) क्या है?"},"a":{"en":"Global Positioning System","hi":"ग्लोबल पोजिशनिंग सिस्टम (Global Positioning System)"},"o":[{"en":"Global Positioning System","hi":"ग्लोबल पोजिशनिंग सिस्टम (Global Positioning System)"},{"en":"General Packet Service","hi":"जनरल पैकेट सर्विस"},{"en":"Graphical Processing System","hi":"ग्राफिकल प्रोसेसिंग सिस्टम"},{"en":"Geographic Plotting Software","hi":"जियोग्राफिक प्लॉटिंग सॉफ्टवेयर"}],"exp":{"en":"GPS stands for Global Positioning System, a satellite-based radio navigation system.","hi":"GPS का पूर्ण रूप Global Positioning System है।"},"num":188},{"id":"q189","q":{"en":"What is the full form of GPRS?","hi":"GPRS का पूर्ण रूप (Full Form) क्या है?"},"a":{"en":"General Packet Radio Service","hi":"जनरल पैकेट रेडियो सर्विस (General Packet Radio Service)"},"o":[{"en":"General Packet Radio Service","hi":"जनरल पैकेट रेडियो सर्विस (General Packet Radio Service)"},{"en":"Global Positioning Radio System","hi":"ग्लोबल पोजिशनिंग रेडियो सिस्टम"},{"en":"Gateway Protocol Routing Server","hi":"गेटवे प्रोटोकॉल रूटिंग सर्वर"},{"en":"Gigabit Parallel Ribbon Socket","hi":"गीगाबिट पैरेलल रिबन सॉकेट"}],"exp":{"en":"GPRS stands for General Packet Radio Service, a packet-oriented mobile data standard on 2G and 3G cellular communication networks.","hi":"GPRS का पूर्ण रूप General Packet Radio Service है।"},"num":189},{"id":"q190","q":{"en":"In E-mail, what is the full form of 'CC'?","hi":"ईमेल (E-mail) में 'CC' का पूर्ण रूप क्या है?"},"a":{"en":"Carbon Copy","hi":"कार्बन कॉपी (Carbon Copy)"},"o":[{"en":"Carbon Copy","hi":"कार्बन कॉपी (Carbon Copy)"},{"en":"Computer Code","hi":"कंप्यूटर कोड"},{"en":"Central Client","hi":"सेंट्रल क्लाइंट"},{"en":"Confidential Copy","hi":"कॉन्फिडेंशियल कॉपी"}],"exp":{"en":"In e-mail headers, CC stands for Carbon Copy (sending a visible copy of the email to additional recipients).","hi":"ईमेल में CC का पूर्ण रूप Carbon Copy है।"},"num":190},{"id":"q191","q":{"en":"In E-mail, what is the full form of 'BCC'?","hi":"ईमेल (E-mail) में 'BCC' का पूर्ण रूप क्या है?"},"a":{"en":"Blind Carbon Copy","hi":"ब्लाइंड कार्बन कॉपी (Blind Carbon Copy)"},"o":[{"en":"Blind Carbon Copy","hi":"ब्लाइंड कार्बन कॉपी (Blind Carbon Copy)"},{"en":"Binary Carbon Copy","hi":"बाइनरी कार्बन कॉपी"},{"en":"Backup Client Copy","hi":"बैकअप क्लाइंट कॉपी"},{"en":"Broadcast Communication Channel","hi":"ब्रॉडकास्ट कम्युनिकेशन चैनल"}],"exp":{"en":"In e-mail headers, BCC stands for Blind Carbon Copy (sending a copy of an email to recipients whose addresses remain hidden from other recipients).","hi":"ईमेल में BCC का पूर्ण रूप Blind Carbon Copy है।"},"num":191},{"id":"q192","q":{"en":"On a debit or credit card, what is the full form of 'CVV'?","hi":"डेबिट या क्रेडिट कार्ड के संदर्भ में 'CVV' का पूर्ण रूप क्या है?"},"a":{"en":"Card Verification Value","hi":"कार्ड वेरिफिकेशन वैल्यू (Card Verification Value)"},"o":[{"en":"Card Verification Value","hi":"कार्ड वेरिफिकेशन वैल्यू (Card Verification Value)"},{"en":"Central Vault Verification","hi":"सेंट्रल वॉल्ट वेरिफिकेशन"},{"en":"Computer Validated Voucher","hi":"कंप्यूटर वैलिडेटेड वाउचर"},{"en":"Credit Validity Version","hi":"क्रेडिट वैलिडिटी वर्शन"}],"exp":{"en":"CVV stands for Card Verification Value, the 3- or 4-digit security code printed on payment cards to verify card-not-present transactions.","hi":"CVV का पूर्ण रूप Card Verification Value है।"},"num":192},{"id":"q193","q":{"en":"What is the full form of FAQ?","hi":"FAQ का पूर्ण रूप (Full Form) क्या है?"},"a":{"en":"Frequently Asked Questions (or Frequently Asked Question in singular)","hi":"फ्रीक्वेंटली आस्क्ड क्वेश्चन्स (Frequently Asked Questions)"},"o":[{"en":"Frequently Asked Questions (or Frequently Asked Question in singular)","hi":"फ्रीक्वेंटली आस्क्ड क्वेश्चन्स (Frequently Asked Questions)"},{"en":"Fast Access Query","hi":"फास्ट एक्सेस क्वेरी"},{"en":"File Allocation Queue","hi":"फ़ाइल एलोकेशन क्यू"},{"en":"Formatted Application Quality","hi":"फ़ॉर्मेटेड एप्लिकेशन क्वालिटी"}],"exp":{"en":"FAQ stands for Frequently Asked Questions (or Frequently Asked Question).","hi":"FAQ का पूर्ण रूप Frequently Asked Questions (सिंगुलर में Frequently Asked Question) है।"},"num":193},{"id":"q194","q":{"en":"What is the full form of the image file format 'TIFF'?","hi":"इमेज फ़ाइल फ़ॉर्मेट 'TIFF' का पूर्ण रूप क्या है?"},"a":{"en":"Tagged Image File Format","hi":"टैग्ड इमेज फ़ाइल फ़ॉर्मेट (Tagged Image File Format)"},"o":[{"en":"Tagged Image File Format","hi":"टैग्ड इमेज फ़ाइल फ़ॉर्मेट (Tagged Image File Format)"},{"en":"Transparent Icon File Format","hi":"ट्रांसपेरेंट आइकन फ़ाइल फ़ॉर्मेट"},{"en":"Text Integrated Font File","hi":"टेक्स्ट इंटीग्रेटेड फ़ॉन्ट फ़ाइल"},{"en":"Thermal Inkjet Fax Format","hi":"थर्मल इंकजेट फैक्स फ़ॉर्मेट"}],"exp":{"en":"TIFF stands for Tagged Image File Format, a high-quality raster graphics format widely used in publishing, scanning, and photography.","hi":"TIFF का पूर्ण रूप Tagged Image File Format है।"},"num":194},{"id":"q195","q":{"en":"What is the full form of JPEG?","hi":"JPEG का पूर्ण रूप (Full Form) क्या है?"},"a":{"en":"Joint Photographic Experts Group","hi":"जॉइंट फोटोग्राफिक एक्सपर्ट्स ग्रुप (Joint Photographic Experts Group)"},"o":[{"en":"Joint Photographic Experts Group","hi":"जॉइंट फोटोग्राफिक एक्सपर्ट्स ग्रुप (Joint Photographic Experts Group)"},{"en":"Java Picture Encoding Graphics","hi":"जावा पिक्चर एनकोडिंग ग्राफिक्स"},{"en":"Junior Photo Editing Guide","hi":"जूनियर फोटो एडिटिंग गाइड"},{"en":"Joined Pixel Electronic Grid","hi":"जॉइन्ड पिक्सेल इलेक्ट्रॉनिक ग्रिड"}],"exp":{"en":"JPEG stands for Joint Photographic Experts Group, the committee that created the widely used lossy compression standard for digital photographs.","hi":"JPEG का पूर्ण रूप Joint Photographic Experts Group है।"},"num":195},{"id":"q196","q":{"en":"What is the full form of GIF?","hi":"GIF का पूर्ण रूप (Full Form) क्या है?"},"a":{"en":"Graphics Interchange Format","hi":"ग्राफिक्स इंटरचेंज फ़ॉर्मेट (Graphics Interchange Format)"},"o":[{"en":"Graphics Interchange Format","hi":"ग्राफिक्स इंटरचेंज फ़ॉर्मेट (Graphics Interchange Format)"},{"en":"Global Image File","hi":"ग्लोबल इमेज फ़ाइल"},{"en":"General Icon Format","hi":"जनरल आइकन फ़ॉर्मेट"},{"en":"Graphical Interface Frame","hi":"ग्राफिकल इंटरफेस फ्रेम"}],"exp":{"en":"GIF stands for Graphics Interchange Format, a bitmap image format supporting animations and lossless 8-bit colour.","hi":"GIF का पूर्ण रूप Graphics Interchange Format है।"},"num":196},{"id":"q197","q":{"en":"What is the full form of PNG?","hi":"PNG का पूर्ण रूप (Full Form) क्या है?"},"a":{"en":"Portable Network Graphics","hi":"पोर्टेबल नेटवर्क ग्राफिक्स (Portable Network Graphics)"},"o":[{"en":"Portable Network Graphics","hi":"पोर्टेबल नेटवर्क ग्राफिक्स (Portable Network Graphics)"},{"en":"Printable New Graphic","hi":"प्रिंटेबल न्यू ग्राफिक"},{"en":"Pixel Network Grid","hi":"पिक्सेल नेटवर्क ग्रिड"},{"en":"Photo Negative Group","hi":"फोटो नेगेटिव ग्रुप"}],"exp":{"en":"PNG stands for Portable Network Graphics, a lossless raster image format designed for transferring images on the internet.","hi":"PNG का पूर्ण रूप Portable Network Graphics है।"},"num":197},{"id":"q198","q":{"en":"What does the image file extension 'BMP' stand for?","hi":"इमेज फ़ाइल एक्सटेंशन 'BMP' का क्या अर्थ है?"},"a":{"en":"Bitmap Image file format (BitMaP)","hi":"बिटमैप इमेज फ़ाइल फ़ॉर्मेट (Bitmap Image)"},"o":[{"en":"Bitmap Image file format (BitMaP)","hi":"बिटमैप इमेज फ़ाइल फ़ॉर्मेट (Bitmap Image)"},{"en":"Binary Media Player","hi":"बाइनरी मीडिया प्लेयर"},{"en":"Basic Memory Page","hi":"बेसिक मेमोरी पेज"},{"en":"Broadband Modem Port","hi":"ब्रॉडबैंड मॉडेम पोर्ट"}],"exp":{"en":"BMP stands for Bitmap (Bitmap Image file format), a standard uncompressed raster graphics format on Microsoft Windows.","hi":"BMP का अर्थ Bitmap Image फ़ाइल फ़ॉर्मेट है।"},"num":198},{"id":"q199","q":{"en":"What is the full form of PDF?","hi":"PDF का पूर्ण रूप (Full Form) क्या है?"},"a":{"en":"Portable Document Format","hi":"पोर्टेबल डॉक्यूमेंट फ़ॉर्मेट (Portable Document Format)"},"o":[{"en":"Portable Document Format","hi":"पोर्टेबल डॉक्यूमेंट फ़ॉर्मेट (Portable Document Format)"},{"en":"Printed Data File","hi":"प्रिंटेड डेटा फ़ाइल"},{"en":"Public Document Folder","hi":"पब्लिक डॉक्यूमेंट फ़ोल्डर"},{"en":"Personal Desktop File","hi":"पर्सनल डेस्कटॉप फ़ाइल"}],"exp":{"en":"PDF stands for Portable Document Format (developed by Adobe to present documents consistently across all platforms).","hi":"PDF का पूर्ण रूप Portable Document Format है।"},"num":199},{"id":"q200","q":{"en":"What is the full form of 'PAN' in the Indian tax context (and what does it stand for in computer networking)?","hi":"भारतीय कर (Indian tax) के संदर्भ में 'PAN' का पूर्ण रूप क्या है (तथा कंप्यूटर नेटवर्किंग में इसका क्या अर्थ होता है)?"},"a":{"en":"Permanent Account Number in the Indian tax context (in computer networking, PAN stands for Personal Area Network)","hi":"भारतीय कर संदर्भ में: परमानेंट अकाउंट नंबर (Permanent Account Number); नेटवर्किंग संदर्भ में: पर्सनल एरिया नेटवर्क (Personal Area Network)"},"o":[{"en":"Permanent Account Number in the Indian tax context (in computer networking, PAN stands for Personal Area Network)","hi":"भारतीय कर संदर्भ में: परमानेंट अकाउंट नंबर (Permanent Account Number); नेटवर्किंग संदर्भ में: पर्सनल एरिया नेटवर्क (Personal Area Network)"},{"en":"Public Access Number","hi":"पब्लिक एक्सेस नंबर"},{"en":"Primary Arithmetic Node","hi":"प्राइमरी अरिथमेटिक नोड"},{"en":"Parallel Array Network","hi":"पैरेलल ऐरे नेटवर्क"}],"exp":{"en":"In the Indian taxation/financial context (listed alongside TIN on page 70), PAN stands for Permanent Account Number. In computer networking, PAN stands for Personal Area Network.","hi":"भारतीय कर (tax) के संदर्भ में PAN का पूर्ण रूप Permanent Account Number है, जबकि कंप्यूटर नेटवर्किंग के संदर्भ में PAN का अर्थ Personal Area Network होता है।"},"num":200},{"id":"q201","q":{"en":"What is the full form of 'TIN' in taxation and business records?","hi":"कराधान और व्यावसायिक रिकॉर्ड में 'TIN' का पूर्ण रूप (Full Form) क्या है?"},"a":{"en":"Taxpayer Identification Number","hi":"टैक्सपेयर आइडेंटिफिकेशन नंबर (Taxpayer Identification Number)"},"o":[{"en":"Taxpayer Identification Number","hi":"टैक्सपेयर आइडेंटिफिकेशन नंबर (Taxpayer Identification Number)"},{"en":"Terminal Input Node","hi":"टर्मिनल इनपुट नोड"},{"en":"Total Integer Number","hi":"टोटल इंटीजर नंबर"},{"en":"Telecom Internet Network","hi":"टेलीकॉम इंटरनेट नेटवर्क"}],"exp":{"en":"TIN stands for Taxpayer Identification Number.","hi":"TIN का पूर्ण रूप Taxpayer Identification Number है।"},"num":201},{"id":"q202","q":{"en":"What is the full form of 'ERP' in business management software?","hi":"व्यावसायिक प्रबंधन सॉफ्टवेयर में 'ERP' का पूर्ण रूप क्या है?"},"a":{"en":"Enterprise Resource Planning","hi":"एंटरप्राइज रिसोर्स प्लानिंग (Enterprise Resource Planning)"},"o":[{"en":"Enterprise Resource Planning","hi":"एंटरप्राइज रिसोर्स प्लानिंग (Enterprise Resource Planning)"},{"en":"Electronic Routing Protocol","hi":"इलेक्ट्रॉनिक रूटिंग प्रोटोकॉल"},{"en":"External RAM Partition","hi":"एक्सटर्नल रैम पार्टीशन"},{"en":"Error Recovery Process","hi":"एरर रिकवरी प्रोसेस"}],"exp":{"en":"ERP stands for Enterprise Resource Planning (integrated software used by organizations to manage core business processes like accounting, procurement, HR, and supply chain).","hi":"ERP का पूर्ण रूप Enterprise Resource Planning है।"},"num":202}]},{"title":{"en":"12. Abbreviations — Display, Power & Information Systems","hi":"12. संक्षिप्त रूप — डिस्प्ले, पावर और सूचना प्रणालियाँ"},"questions":[{"id":"q203","q":{"en":"What is the full form of 'MIS'?","hi":"'MIS' का पूर्ण रूप (Full Form) क्या है?"},"a":{"en":"Management Information System","hi":"मैनेजमेंट इन्फॉर्मेशन सिस्टम (Management Information System)"},"o":[{"en":"Management Information System","hi":"मैनेजमेंट इन्फॉर्मेशन सिस्टम (Management Information System)"},{"en":"Memory Instruction Set","hi":"मेमोरी इंस्ट्रक्शन सेट"},{"en":"Multiple Input Scanner","hi":"मल्टीपल इनपुट स्कैनर"},{"en":"Micro Integrated Chip","hi":"माइक्रो इंटीग्रेटेड चिप"}],"exp":{"en":"MIS stands for Management Information System (an information system used for decision-making and coordination, control, analysis, and visualization of information in an organization).","hi":"MIS का पूर्ण रूप Management Information System है।"},"num":203},{"id":"q204","q":{"en":"What is the full form of 'CSS' in web development?","hi":"वेब डेवलपमेंट में 'CSS' का पूर्ण रूप क्या है?"},"a":{"en":"Cascading Style Sheets","hi":"कास्केडिंग स्टाइल शीट्स (Cascading Style Sheets)"},"o":[{"en":"Cascading Style Sheets","hi":"कास्केडिंग स्टाइल शीट्स (Cascading Style Sheets)"},{"en":"Computer System Software","hi":"कंप्यूटर सिस्टम सॉफ्टवेयर"},{"en":"Central Server Storage","hi":"सेंट्रल सर्वर स्टोरेज"},{"en":"Compiled Source Script","hi":"कंपाइल्ड सोर्स स्क्रिप्ट"}],"exp":{"en":"CSS stands for Cascading Style Sheets, the style sheet language used for describing the presentation, layout, colours, and fonts of HTML documents.","hi":"CSS का पूर्ण रूप Cascading Style Sheets है।"},"num":204},{"id":"q205","q":{"en":"What is the full form of 'SQL'?","hi":"'SQL' का पूर्ण रूप (Full Form) क्या है?"},"a":{"en":"Structured Query Language","hi":"स्ट्रक्चर्ड क्वेरी लैंग्वेज (Structured Query Language)"},"o":[{"en":"Structured Query Language","hi":"स्ट्रक्चर्ड क्वेरी लैंग्वेज (Structured Query Language)"},{"en":"Standard Quantum Logic","hi":"स्टैंडर्ड क्वांटम लॉजिक"},{"en":"System Queue Loader","hi":"सिस्टम क्यू लोडर"},{"en":"Sequential Query List","hi":"सीक्वेंशियल क्वेरी लिस्ट"}],"exp":{"en":"SQL stands for Structured Query Language, the standard domain-specific language used for managing and querying data in relational database management systems (RDBMS).","hi":"SQL का पूर्ण रूप Structured Query Language है।"},"num":205},{"id":"q206","q":{"en":"What is the full form of 'USB'?","hi":"'USB' का पूर्ण रूप (Full Form) क्या है?"},"a":{"en":"Universal Serial Bus","hi":"यूनिवर्सल सीरियल बस (Universal Serial Bus)"},"o":[{"en":"Universal Serial Bus","hi":"यूनिवर्सल सीरियल बस (Universal Serial Bus)"},{"en":"Unified System Board","hi":"यूनिफाइड सिस्टम बोर्ड"},{"en":"Ultra Speed Buffer","hi":"अल्ट्रा स्पीड बफर"},{"en":"Universal Storage Backup","hi":"यूनिवर्सल स्टोरेज बैकअप"}],"exp":{"en":"USB stands for Universal Serial Bus.","hi":"USB का पूर्ण रूप Universal Serial Bus है।"},"num":206},{"id":"q207","q":{"en":"What is the full form of 'DVD' given in the chapter?","hi":"अध्याय में 'DVD' का पूर्ण रूप क्या दिया गया है?"},"a":{"en":"Digital Versatile Disc (also historically known as Digital Video Disc)","hi":"डिजिटल वर्सटाइल डिस्क (Digital Versatile Disc)"},"o":[{"en":"Digital Versatile Disc (also historically known as Digital Video Disc)","hi":"डिजिटल वर्सटाइल डिस्क (Digital Versatile Disc)"},{"en":"Dynamic Volatile Drive","hi":"डायनेमिक वोलेटाइल ड्राइव"},{"en":"Direct Visual Display","hi":"डायरेक्ट विजुअल डिस्प्ले"},{"en":"Dual Vector Device","hi":"डुअल वेक्टर डिवाइस"}],"exp":{"en":"In the chapter's abbreviation list, DVD stands for Digital Versatile Disc (also known as Digital Video Disc).","hi":"अध्याय में DVD का पूर्ण रूप Digital Versatile Disc दिया गया है।"},"num":207},{"id":"q208","q":{"en":"What is the full form of 'VGA'?","hi":"'VGA' का पूर्ण रूप (Full Form) क्या है?"},"a":{"en":"Video Graphics Array","hi":"वीडियो ग्राफिक्स ऐरे (Video Graphics Array)"},"o":[{"en":"Video Graphics Array","hi":"वीडियो ग्राफिक्स ऐरे (Video Graphics Array)"},{"en":"Visual Grid Adapter","hi":"विजुअल ग्रिड एडेप्टर"},{"en":"Virtual Graphics Application","hi":"वर्चुअल ग्राफिक्स एप्लिकेशन"},{"en":"Variable Gain Amplifier","hi":"वेरिएबल गेन एम्प्लीफायर"}],"exp":{"en":"VGA stands for Video Graphics Array, the classic display standard and 15-pin analog monitor connector introduced by IBM.","hi":"VGA का पूर्ण रूप Video Graphics Array है।"},"num":208},{"id":"q209","q":{"en":"What is the full form of 'LED'?","hi":"'LED' का पूर्ण रूप (Full Form) क्या है?"},"a":{"en":"Light-Emitting Diode","hi":"लाइट-एमिटिंग डायोड (Light-Emitting Diode)"},"o":[{"en":"Light-Emitting Diode","hi":"लाइट-एमिटिंग डायोड (Light-Emitting Diode)"},{"en":"Liquid Electronic Display","hi":"लिक्विड इलेक्ट्रॉनिक डिस्प्ले"},{"en":"Laser Emitting Device","hi":"लेजर एमिटिंग डिवाइस"},{"en":"Low Energy Display","hi":"लो एनर्जी डिस्प्ले"}],"exp":{"en":"LED stands for Light-Emitting Diode.","hi":"LED का पूर्ण रूप Light-Emitting Diode है।"},"num":209},{"id":"q210","q":{"en":"What is the full form of 'LCD'?","hi":"'LCD' का पूर्ण रूप (Full Form) क्या है?"},"a":{"en":"Liquid Crystal Display","hi":"लिक्विड क्रिस्टल डिस्प्ले (Liquid Crystal Display)"},"o":[{"en":"Liquid Crystal Display","hi":"लिक्विड क्रिस्टल डिस्प्ले (Liquid Crystal Display)"},{"en":"Light Cathode Diode","hi":"लाइट कैथोड डायोड"},{"en":"Linear Colour Display","hi":"लीनियर कलर डिस्प्ले"},{"en":"Local Computer Disk","hi":"लोकल कंप्यूटर डिस्क"}],"exp":{"en":"LCD stands for Liquid Crystal Display.","hi":"LCD का पूर्ण रूप Liquid Crystal Display है।"},"num":210},{"id":"q211","q":{"en":"What is the full form of 'SMPS' in a desktop computer?","hi":"डेस्कटॉप कंप्यूटर में 'SMPS' का पूर्ण रूप क्या है?"},"a":{"en":"Switched-Mode Power Supply (or Switch-Mode Power Supply)","hi":"स्विच्ड-मोड पावर सप्लाई (Switched-Mode Power Supply)"},"o":[{"en":"Switched-Mode Power Supply (or Switch-Mode Power Supply)","hi":"स्विच्ड-मोड पावर सप्लाई (Switched-Mode Power Supply)"},{"en":"System Memory Processing Server","hi":"सिस्टम मेमोरी प्रोसेसिंग सर्वर"},{"en":"Synchronous Mainframe Power Socket","hi":"सिंक्रोनस मेनफ्रेम पावर सॉकेट"},{"en":"Static Magnetic Platter Storage","hi":"स्टैटिक मैग्नेटिक प्लैटर स्टोरेज"}],"exp":{"en":"SMPS stands for Switched-Mode Power Supply, the electronic power supply unit in a computer that converts AC mains power into regulated low-voltage DC power for internal components.","hi":"SMPS का पूर्ण रूप Switched-Mode Power Supply है।"},"num":211},{"id":"q212","q":{"en":"On page 71, what is the quick match for CAD, DOS, and UPS?","hi":"पृष्ठ 71 पर दिए गए CAD, DOS और UPS का सही मिलान क्या है?"},"a":{"en":"CAD → Computer-Aided Design; DOS → Disk Operating System; UPS → Uninterruptible Power Supply","hi":"CAD → Computer-Aided Design; DOS → Disk Operating System; UPS → Uninterruptible Power Supply"},"o":[{"en":"CAD → Computer-Aided Design; DOS → Disk Operating System; UPS → Uninterruptible Power Supply","hi":"CAD → Computer-Aided Design; DOS → Disk Operating System; UPS → Uninterruptible Power Supply"},{"en":"CAD → Central Analog Disk; DOS → Data Output Server; UPS → Universal Port System","hi":"CAD → Central Analog Disk; DOS → Data Output Server; UPS → Universal Port System"},{"en":"CAD → Code And Data; DOS → Digital Optical System; UPS → User Program Software","hi":"CAD → Code And Data; DOS → Digital Optical System; UPS → User Program Software"},{"en":"CAD → Compact Audio Disc; DOS → Direct Operating Shell; UPS → Ultra Power Switch","hi":"CAD → Compact Audio Disc; DOS → Direct Operating Shell; UPS → Ultra Power Switch"}],"exp":{"en":"Quick revision match on page 71: CAD = Computer-Aided Design, DOS = Disk Operating System, and UPS = Uninterruptible Power Supply.","hi":"पृष्ठ 71 का त्वरित मिलान: CAD → Computer-Aided Design; DOS → Disk Operating System; UPS → Uninterruptible Power Supply।"},"num":212}]},{"title":{"en":"13. Exam Trap Reverse-Questions","hi":"13. परीक्षा के महत्वपूर्ण उल्टे प्रश्न"},"questions":[{"id":"q213","q":{"en":"What do we call a physical printed document on paper versus a digital document saved on a pen drive?","hi":"कागज पर छपे भौतिक दस्तावेज़ और पेन ड्राइव पर सेव किए गए डिजिटल दस्तावेज़ को क्रमशः क्या कहेंगे?"},"a":{"en":"Hard copy and Soft copy respectively","hi":"क्रमशः हार्ड कॉपी (Hard copy) और सॉफ्ट कॉपी (Soft copy)"},"o":[{"en":"Hard copy and Soft copy respectively","hi":"क्रमशः हार्ड कॉपी (Hard copy) और सॉफ्ट कॉपी (Soft copy)"},{"en":"Soft copy and Hard copy respectively","hi":"क्रमशः सॉफ्ट कॉपी और हार्ड कॉपी"},{"en":"Firmware and Freeware respectively","hi":"क्रमशः फर्मवेयर और फ्रीवेयर"},{"en":"Compiler and Interpreter respectively","hi":"क्रमशः कंपाइलर और इंटरप्रेटर"}],"exp":{"en":"Exam Trap: A physical printed document on paper is a Hard Copy, whereas an electronic document stored on a pen drive or displayed on a screen is a Soft Copy.","hi":"एग्जाम ट्रैप: कागज पर प्रिंट किए गए दस्तावेज़ को 'हार्ड कॉपी' (Hard copy) और पेन ड्राइव या स्क्रीन पर मौजूद डिजिटल दस्तावेज़ को 'सॉफ्ट कॉपी' (Soft copy) कहते हैं।"},"num":213},{"id":"q214","q":{"en":"Which program enables a hardware peripheral like a printer to communicate with the Operating System, and what category does it belong to?","hi":"प्रिंटर जैसे हार्डवेयर को ऑपरेटिंग सिस्टम (OS) से संवाद कराने वाला प्रोग्राम कौन-सा है और यह किस श्रेणी में आता है?"},"a":{"en":"Device driver, which is a System Software","hi":"डिवाइस ड्राइवर (Device driver), जो एक सिस्टम सॉफ्टवेयर है"},"o":[{"en":"Device driver, which is a System Software","hi":"डिवाइस ड्राइवर (Device driver), जो एक सिस्टम सॉफ्टवेयर है"},{"en":"Spreadsheet, which is an Application Software","hi":"स्प्रेडशीट, जो एक एप्लिकेशन सॉफ्टवेयर है"},{"en":"Assembler, which is a Database Software","hi":"असेंबलर, जो एक डेटाबेस सॉफ्टवेयर है"},{"en":"Plotter, which is a Hardware Bus","hi":"प्लॉटर, जो एक हार्डवेयर बस है"}],"exp":{"en":"Exam Trap: A Device Driver allows the OS to communicate with and control hardware peripherals like printers, and it is classified under System Software.","hi":"एग्जाम ट्रैप: प्रिंटर को OS से संवाद कराने वाला प्रोग्राम 'डिवाइस ड्राइवर' (Device driver) है, जो एक सिस्टम सॉफ्टवेयर (System software) है।"},"num":214},{"id":"q215","q":{"en":"Which language translator converts Assembly language source code into machine/object code?","hi":"असेंबली सोर्स कोड (Assembly source) को मशीन या ऑब्जेक्ट कोड में कौन बदलता है?"},"a":{"en":"Assembler","hi":"असेंबलर (Assembler)"},"o":[{"en":"Assembler","hi":"असेंबलर (Assembler)"},{"en":"Compiler","hi":"कंपाइलर"},{"en":"Interpreter","hi":"इंटरप्रेटर"},{"en":"Device Driver","hi":"डिवाइस ड्राइवर"}],"exp":{"en":"Exam Trap: An Assembler specifically converts 2GL Assembly language mnemonics into machine/object code (whereas compilers and interpreters handle high-level languages).","hi":"एग्जाम ट्रैप: असेंबली भाषा के सोर्स कोड को मशीन/ऑब्जेक्ट कोड में बदलने का काम 'असेंबलर' (Assembler) करता है।"},"num":215},{"id":"q216","q":{"en":"Which language tools correspond respectively to ahead-of-time source translation versus runtime evaluation and execution?","hi":"कंपाइल-टाइम ट्रांसलेशन और रनटाइम मूल्यांकन/निष्पादन (Runtime execution) वाले टूल्स का सही मिलान क्या है?"},"a":{"en":"Compiler translates source code into target code ahead of execution, whereas Interpreter evaluates and executes the program at runtime","hi":"कंपाइलर सोर्स कोड को ट्रांसलेट करता है, जबकि इंटरप्रेटर प्रोग्राम को रनटाइम पर मूल्यांकन और एक्जीक्यूट करता है"},"o":[{"en":"Compiler translates source code into target code ahead of execution, whereas Interpreter evaluates and executes the program at runtime","hi":"कंपाइलर सोर्स कोड को ट्रांसलेट करता है, जबकि इंटरप्रेटर प्रोग्राम को रनटाइम पर मूल्यांकन और एक्जीक्यूट करता है"},{"en":"Interpreter translates ahead of time, whereas Compiler executes line-by-line at runtime","hi":"इंटरप्रेटर पहले ट्रांसलेट करता है, जबकि कंपाइलर रनटाइम पर लाइन-बाय-लाइन चलाता है"},{"en":"Assembler executes SQL queries, whereas Linker formats hard disks","hi":"असेंबलर SQL क्वेरी चलाता है, जबकि लिंकर हार्ड डिस्क फ़ॉर्मेट करता है"},{"en":"Both are hardware buses on the motherboard","hi":"दोनों मदरबोर्ड पर हार्डवेयर बसें हैं"}],"exp":{"en":"Exam Trap: A Compiler translates the source program into target machine/object/bytecode prior to execution, whereas an Interpreter evaluates and executes program statements directly at runtime.","hi":"एग्जाम ट्रैप: कंपाइलर (Compiler) सोर्स कोड को पहले टारगेट कोड में ट्रांसलेट करता है, जबकि इंटरप्रेटर (Interpreter) प्रोग्राम को रनटाइम पर मूल्यांकन और निष्पादित (execute) करता है।"},"num":216},{"id":"q217","q":{"en":"What are the respective exam cues for 'Zero purchase price' versus 'Source-code modification and redistribution freedoms'?","hi":"'शून्य खरीद मूल्य' (Zero price) और 'सोर्स-कोड संशोधन व पुनर्वितरण की स्वतंत्रता' के लिए क्रमशः परीक्षा संकेत (Exam cues) क्या हैं?"},"a":{"en":"Zero price → Freeware; Source-modification and redistribution freedoms → FOSS (Free and Open Source Software)","hi":"शून्य कीमत → फ्रीवेयर (Freeware); सोर्स-संशोधन और पुनर्वितरण की स्वतंत्रता → FOSS"},"o":[{"en":"Zero price → Freeware; Source-modification and redistribution freedoms → FOSS (Free and Open Source Software)","hi":"शून्य कीमत → फ्रीवेयर (Freeware); सोर्स-संशोधन और पुनर्वितरण की स्वतंत्रता → FOSS"},{"en":"Zero price → Proprietary paid software; Source modification → Closed firmware","hi":"शून्य कीमत → सशुल्क प्रोप्राइटरी सॉफ्टवेयर; सोर्स संशोधन → बंद फर्मवेयर"},{"en":"Zero price → Hardware; Source modification → Hard copy","hi":"शून्य कीमत → हार्डवेयर; सोर्स संशोधन → हार्ड कॉपी"},{"en":"Both cues refer exclusively to paid trialware","hi":"दोनों संकेत केवल सशुल्क ट्रायलवेयर को संदर्भित करते हैं"}],"exp":{"en":"Exam Trap: If a question emphasizes zero cost/free of charge without source access, the answer is Freeware. If it emphasizes open source code and the freedom to study, modify, and redistribute, the answer is FOSS.","hi":"एग्जाम ट्रैप: 'शून्य कीमत' (zero price) का संकेत फ्रीवेयर (Freeware) की ओर होता है, जबकि 'सोर्स कोड में बदलाव और पुनर्वितरण की स्वतंत्रता' का संकेत FOSS (Free and Open Source Software) की ओर होता है।"},"num":217},{"id":"q218","q":{"en":"At hardware startup, BIOS is classified as which specific type of embedded software?","hi":"हार्डवेयर स्टार्टअप पर काम आने वाला BIOS किस प्रकार का सॉफ्टवेयर है?"},"a":{"en":"Firmware (boot firmware stored in non-volatile ROM/flash)","hi":"फर्मवेयर (Firmware)"},"o":[{"en":"Firmware (boot firmware stored in non-volatile ROM/flash)","hi":"फर्मवेयर (Firmware)"},{"en":"Spreadsheet application","hi":"स्प्रेडशीट एप्लिकेशन"},{"en":"Customised school management software","hi":"कस्टमाइज्ड स्कूल मैनेजमेंट सॉफ्टवेयर"},{"en":"Web browser plugin","hi":"वेब ब्राउज़र प्लगइन"}],"exp":{"en":"Exam Trap: BIOS (Basic Input/Output System) is embedded boot Firmware stored in non-volatile memory on the motherboard.","hi":"एग्जाम ट्रैप: हार्डवेयर स्टार्टअप पर काम करने वाला BIOS एक 'फर्मवेयर' (Firmware / बूट फर्मवेयर) है।"},"num":218},{"id":"q219","q":{"en":"Working with visual windows, icons, menus, and a pointer is the cue for which user interface?","hi":"आइकन्स (Icons), मेनू (Menus) और विंडोज़ की मदद से काम करना किस इंटरफेस की पहचान है?"},"a":{"en":"Graphical User Interface (GUI)","hi":"ग्राफिकल यूज़र इंटरफेस (GUI)"},"o":[{"en":"Graphical User Interface (GUI)","hi":"ग्राफिकल यूज़र इंटरफेस (GUI)"},{"en":"Command-Line Interface (CLI)","hi":"कमांड-लाइन इंटरफेस (CLI)"},{"en":"Batch Tape Interface","hi":"बैच टेप इंटरफेस"},{"en":"Punched Card Interface","hi":"पंच कार्ड इंटरफेस"}],"exp":{"en":"Exam Trap: Visual interaction using Windows, Icons, Menus, and Pointer (WIMP) is the defining characteristic of a Graphical User Interface (GUI).","hi":"एग्जाम ट्रैप: आइकन्स, मेनू और पॉइंटर की सहायता से विजुअल रूप में काम करना ग्राफिकल यूज़र इंटरफेस (GUI) की पहचान है।"},"num":219},{"id":"q220","q":{"en":"Match 'Monthly payroll processing' and 'Automotive airbag control' with their appropriate OS processing types:","hi":"'मासिक पेरोल प्रोसेसिंग' और 'कार एयरबैग कंट्रोल' को उनके सही OS प्रकारों से सुमेलित कीजिए:"},"a":{"en":"Monthly payroll → Batch processing; Airbag control → Hard real-time requirement","hi":"मासिक पेरोल → बैच प्रोसेसिंग; एयरबैग कंट्रोल → हार्ड रियल-टाइम आवश्यकता"},"o":[{"en":"Monthly payroll → Batch processing; Airbag control → Hard real-time requirement","hi":"मासिक पेरोल → बैच प्रोसेसिंग; एयरबैग कंट्रोल → हार्ड रियल-टाइम आवश्यकता"},{"en":"Monthly payroll → Hard real-time; Airbag control → Overnight batch processing","hi":"मासिक पेरोल → हार्ड रियल-टाइम; एयरबैग कंट्रोल → ओवरनाइट बैच प्रोसेसिंग"},{"en":"Both are single-user MS-DOS text editors","hi":"दोनों सिंगल-यूज़र MS-DOS टेक्स्ट एडिटर हैं"},{"en":"Monthly payroll → Soft real-time; Airbag control → Offline spreadsheet","hi":"मासिक पेरोल → सॉफ्ट रियल-टाइम; एयरबैग कंट्रोल → ऑफ़लाइन स्प्रेडशीट"}],"exp":{"en":"Exam Trap: Scheduled bulk jobs like monthly payroll runs use Batch Processing, whereas safety-critical instant responses like automotive airbag deployment require a Hard Real-Time OS.","hi":"एग्जाम ट्रैप: मासिक पेरोल (वेतन) गणना 'बैच प्रोसेसिंग' का उदाहरण है, जबकि कार का एयरबैग कंट्रोल 'हार्ड रियल-टाइम' (Hard real-time) सिस्टम की आवश्यकता है।"},"num":220},{"id":"q221","q":{"en":"Maximizing 'CPU utilization' versus providing fast 'Interactive response' are associated with which OS approaches respectively?","hi":"'CPU यूटिलाइजेशन' (उपयोगिता) बढ़ाने और तेज़ 'इंटरैक्टिव रिस्पॉन्स' देने का संबंध क्रमशः किन OS दृष्टिकोणों से है?"},"a":{"en":"CPU utilization → Multiprogramming; Interactive response → Time-sharing","hi":"CPU यूटिलाइजेशन → मल्टीप्रोग्रामिंग (Multiprogramming); इंटरैक्टिव रिस्पॉन्स → टाइम-शेयरिंग (Time-sharing)"},"o":[{"en":"CPU utilization → Multiprogramming; Interactive response → Time-sharing","hi":"CPU यूटिलाइजेशन → मल्टीप्रोग्रामिंग (Multiprogramming); इंटरैक्टिव रिस्पॉन्स → टाइम-शेयरिंग (Time-sharing)"},{"en":"CPU utilization → Batch tape; Interactive response → Punched card","hi":"CPU यूटिलाइजेशन → बैच टेप; इंटरैक्टिव रिस्पॉन्स → पंच कार्ड"},{"en":"CPU utilization → Deadlock; Interactive response → Spooling","hi":"CPU यूटिलाइजेशन → डेडलॉक; इंटरैक्टिव रिस्पॉन्स → स्पूलिंग"},{"en":"Both are associated only with single-tasking calculators","hi":"दोनों केवल सिंगल-टास्किंग कैलकुलेटर से जुड़े हैं"}],"exp":{"en":"Exam Trap: Keeping multiple jobs in memory to prevent CPU idleness during I/O waits (CPU utilization) is the cue for Multiprogramming, while rapid time-slicing for user responsiveness (interactive response) is the cue for Time-Sharing.","hi":"एग्जाम ट्रैप: CPU को खाली न रहने देकर उसकी उपयोगिता (CPU utilization) बढ़ाना 'मल्टीप्रोग्रामिंग' से जुड़ा है, जबकि टाइम-स्लाइस द्वारा त्वरित 'इंटरैक्टिव रिस्पॉन्स' देना 'टाइम-शेयरिंग' से जुड़ा है।"},"num":221},{"id":"q222","q":{"en":"Match 'Multiple CPU cores inside one computer' versus 'Multiple computers connected over a network':","hi":"'एक ही कंप्यूटर में कई कोर (Multiple cores)' और 'नेटवर्क पर जुड़े कई कंप्यूटर' का सही मिलान क्या है?"},"a":{"en":"Multiple cores in one computer → Multiprocessing; Multiple computers over a network → Distributed computing","hi":"एक कंप्यूटर में कई कोर → मल्टीप्रोसेसिंग (Multiprocessing); नेटवर्क पर कई कंप्यूटर → डिस्ट्रीब्यूटेड कंप्यूटिंग (Distributed computing)"},"o":[{"en":"Multiple cores in one computer → Multiprocessing; Multiple computers over a network → Distributed computing","hi":"एक कंप्यूटर में कई कोर → मल्टीप्रोसेसिंग (Multiprocessing); नेटवर्क पर कई कंप्यूटर → डिस्ट्रीब्यूटेड कंप्यूटिंग (Distributed computing)"},{"en":"Multiple cores in one computer → Distributed computing; Multiple computers over a network → Multiprogramming","hi":"एक कंप्यूटर में कई कोर → डिस्ट्रीब्यूटेड कंप्यूटिंग; नेटवर्क पर कई कंप्यूटर → मल्टीप्रोग्रामिंग"},{"en":"Both are called Single-core Batch Systems","hi":"दोनों को सिंगल-कोर बैच सिस्टम कहा जाता है"},{"en":"Both are called BIOS Firmware","hi":"दोनों को BIOS फर्मवेयर कहा जाता है"}],"exp":{"en":"Exam Trap: Multiple processors or cores operating inside a single computer system is Multiprocessing, whereas multiple separate computers collaborating over a network is Distributed Computing.","hi":"एग्जाम ट्रैप: एक ही कंप्यूटर में कई प्रोसेसर/कोर का होना 'मल्टीप्रोसेसिंग' (Multiprocessing) है, और नेटवर्क पर कई कंप्यूटरों का मिलकर काम करना 'डिस्ट्रीब्यूटेड कंप्यूटिंग' (Distributed computing) है।"},"num":222},{"id":"q223","q":{"en":"Did Apple release the original Macintosh System Software or Mac OS X in the year 2001?","hi":"वर्ष 2001 में Apple का क्लासिक मैकिंटोश सिस्टम आया था या Mac OS X?"},"a":{"en":"Mac OS X was released in 2001, whereas the original Macintosh System Software arrived in 1984","hi":"2001 में Mac OS X आया था, जबकि मूल Macintosh सिस्टम सॉफ्टवेयर 1984 में आया था"},"o":[{"en":"Mac OS X was released in 2001, whereas the original Macintosh System Software arrived in 1984","hi":"2001 में Mac OS X आया था, जबकि मूल Macintosh सिस्टम सॉफ्टवेयर 1984 में आया था"},{"en":"Original Macintosh System Software arrived in 2001, and Mac OS X in 1984","hi":"मूल मैकिंटोश 2001 में आया, और Mac OS X 1984 में"},{"en":"Both were released in 1969","hi":"दोनों 1969 में रिलीज़ हुए थे"},{"en":"Neither was released by Apple","hi":"दोनों में से कोई भी एप्पल द्वारा रिलीज़ नहीं किया गया था"}],"exp":{"en":"Exam Trap: 2001 is the release year of Mac OS X, whereas Apple's original Macintosh System Software (Classic Mac OS) was introduced in 1984.","hi":"एग्जाम ट्रैप: वर्ष 2001 में 'Mac OS X' रिलीज़ हुआ था, जबकि Apple का मूल Macintosh सिस्टम सॉफ्टवेयर 1984 में आया था।"},"num":223},{"id":"q224","q":{"en":"Which Windows shortcut key opens or activates the application pinned at position 3 on the Taskbar?","hi":"टास्कबार की पोजिशन 3 पर पिन किए गए ऐप को खोलने या सक्रिय करने के लिए कौन-सी शॉर्टकट कुंजी है?"},"a":{"en":"Win + 3","hi":"Win + 3"},"o":[{"en":"Win + 3","hi":"Win + 3"},{"en":"Alt + F3","hi":"Alt + F3"},{"en":"Ctrl + Shift + 3","hi":"Ctrl + Shift + 3"},{"en":"Tab + 3","hi":"Tab + 3"}],"exp":{"en":"Exam Trap: Pressing `Win + <number>` activates the corresponding taskbar icon position, so `Win + 3` opens or switches to the third pinned app on the Taskbar.","hi":"एग्जाम ट्रैप: टास्कबार की तीसरी पोजिशन वाले ऐप के लिए `Win + 3` शॉर्टकट कुंजी का उपयोग किया जाता है।"},"num":224},{"id":"q225","q":{"en":"What is the condition called when multiple tasks wait indefinitely for resources held by each other?","hi":"जब कई टास्क एक-दूसरे के संसाधनों (resources) के लिए अनिश्चित काल तक इंतज़ार में फँस जाएँ, तो उसे क्या कहते हैं?"},"a":{"en":"Deadlock","hi":"डेडलॉक (Deadlock)"},"o":[{"en":"Deadlock","hi":"डेडलॉक (Deadlock)"},{"en":"Bootloading","hi":"बूटलोडिंग"},{"en":"Defragmentation","hi":"डीफ्रैगमेंटेशन"},{"en":"Time-slicing","hi":"टाइम-स्लाइसिंग"}],"exp":{"en":"Exam Trap: Circular, indefinite waiting among processes/threads for mutually held resources is called a Deadlock.","hi":"एग्जाम ट्रैप: जब कई प्रोसेस या टास्क एक-दूसरे के पास मौजूद संसाधनों के लिए अनिश्चित काल तक इंतज़ार करते रह जाएँ, तो इस स्थिति को 'डेडलॉक' (Deadlock) कहते हैं।"},"num":225},{"id":"q226","q":{"en":"In which abbreviation's full form does the word 'Packet' appear: PSPDN or GPRS?","hi":"'Packet' शब्द किस संक्षिप्त रूप के विस्तार में आता है: PSPDN या GPRS?"},"a":{"en":"In both — Packet-Switched Public Data Network (PSPDN) and General Packet Radio Service (GPRS)","hi":"दोनों में — Packet-Switched Public Data Network (PSPDN) और General Packet Radio Service (GPRS)"},"o":[{"en":"In both — Packet-Switched Public Data Network (PSPDN) and General Packet Radio Service (GPRS)","hi":"दोनों में — Packet-Switched Public Data Network (PSPDN) और General Packet Radio Service (GPRS)"},{"en":"Only in PSTN","hi":"केवल PSTN में"},{"en":"Neither; both stand for Parallel Port","hi":"किसी में नहीं; दोनों का अर्थ पैरेलल पोर्ट है"},{"en":"Only in GPS","hi":"केवल GPS में"}],"exp":{"en":"Exam Trap: The word 'Packet' appears in both: PSPDN = Packet-Switched Public Data Network, and GPRS = General Packet Radio Service.","hi":"एग्जाम ट्रैप: 'Packet' शब्द दोनों के पूर्ण रूप में आता है: PSPDN = Packet-Switched Public Data Network, और GPRS = General Packet Radio Service।"},"num":226},{"id":"q227","q":{"en":"What are the standard short forms for 'Computer-Aided Design' and 'Computer-Aided Manufacturing'?","hi":"'Computer-Aided Design' और 'Computer-Aided Manufacturing' के संक्षिप्त रूप (Short forms) क्या हैं?"},"a":{"en":"CAD and CAM respectively","hi":"क्रमशः CAD और CAM"},"o":[{"en":"CAD and CAM respectively","hi":"क्रमशः CAD और CAM"},{"en":"CAT and COMAL respectively","hi":"क्रमशः CAT और COMAL"},{"en":"CSS and CGI respectively","hi":"क्रमशः CSS और CGI"},{"en":"CD and DVD respectively","hi":"क्रमशः CD और DVD"}],"exp":{"en":"Exam Trap: Computer-Aided Design is abbreviated as CAD, and Computer-Aided Manufacturing is abbreviated as CAM.","hi":"एग्जाम ट्रैप: Computer-Aided Design का संक्षिप्त रूप CAD है और Computer-Aided Manufacturing का संक्षिप्त रूप CAM है।"},"num":227}]},{"title":{"en":"14. Rapid-Fire Final Revision","hi":"14. त्वरित अंतिम पुनरावृत्ति"},"questions":[{"id":"q228","q":{"en":"What are the grammar rules for writing valid code in a programming language called?","hi":"प्रोग्रामिंग भाषा में वैध कोड लिखने के नियमों को क्या कहते हैं?"},"a":{"en":"Syntax","hi":"सिंटैक्स (Syntax)"},"o":[{"en":"Syntax","hi":"सिंटैक्स (Syntax)"},{"en":"Deadlock","hi":"डेडलॉक"},{"en":"Spooling","hi":"स्पूलिंग"},{"en":"Firmware","hi":"फर्मवेयर"}],"exp":{"en":"Rapid-Fire: The grammar and structural rules for writing valid code are called Syntax.","hi":"रैपिड-फायर: वैध कोड लिखने के व्याकरण नियमों को 'सिंटैक्स' (Syntax) कहते हैं।"},"num":228},{"id":"q229","q":{"en":"Which language generation consists of binary CPU instructions (0s and 1s)?","hi":"बाइनरी CPU निर्देशों (0 और 1) वाली भाषा कौन-सी है?"},"a":{"en":"Machine language (1GL)","hi":"मशीन भाषा (1GL)"},"o":[{"en":"Machine language (1GL)","hi":"मशीन भाषा (1GL)"},{"en":"Assembly language (2GL)","hi":"असेंबली भाषा (2GL)"},{"en":"High-level language (3GL)","hi":"हाई-लेवल भाषा (3GL)"},{"en":"Query language (4GL)","hi":"क्वेरी भाषा (4GL)"}],"exp":{"en":"Rapid-Fire: Binary CPU instructions constitute Machine Language (1GL).","hi":"रैपिड-फायर: बाइनरी CPU निर्देशों वाली भाषा मशीन भाषा (1GL) है।"},"num":229},{"id":"q230","q":{"en":"Which low-level language uses symbolic instructions (mnemonics)?","hi":"प्रतीकात्मक निर्देशों (Symbolic instructions / mnemonics) का उपयोग करने वाली भाषा कौन-सी है?"},"a":{"en":"Assembly language (2GL)","hi":"असेंबली भाषा (2GL)"},"o":[{"en":"Assembly language (2GL)","hi":"असेंबली भाषा (2GL)"},{"en":"Machine binary language (1GL)","hi":"मशीन बाइनरी भाषा (1GL)"},{"en":"HTML markup","hi":"HTML मार्कअप"},{"en":"CSS stylesheet","hi":"CSS स्टाइलशीट"}],"exp":{"en":"Rapid-Fire: Assembly language (2GL) uses symbolic mnemonics for instructions.","hi":"रैपिड-फायर: प्रतीकात्मक निमोनिक्स का उपयोग करने वाली भाषा असेंबली भाषा (2GL) है।"},"num":230},{"id":"q231","q":{"en":"What is the original program written by a programmer called?","hi":"प्रोग्रामर द्वारा लिखे गए मूल प्रोग्राम को क्या कहते हैं?"},"a":{"en":"Source code","hi":"सोर्स कोड (Source code)"},"o":[{"en":"Source code","hi":"सोर्स कोड (Source code)"},{"en":"Hard copy","hi":"हार्ड कॉपी"},{"en":"Device driver","hi":"डिवाइस ड्राइवर"},{"en":"BIOS chip","hi":"BIOS चिप"}],"exp":{"en":"Rapid-Fire: The original human-readable program written by a programmer is called Source Code.","hi":"रैपिड-फायर: प्रोग्रामर द्वारा लिखे गए मूल प्रोग्राम को 'सोर्स कोड' (Source code) कहते हैं।"},"num":231},{"id":"q232","q":{"en":"What are the Microsoft Office examples for Email, Presentation, and Spreadsheet respectively?","hi":"ईमेल, प्रेजेंटेशन और स्प्रेडशीट के लिए माइक्रोसॉफ्ट के उदाहरण क्रमशः कौन-से हैं?"},"a":{"en":"Outlook, PowerPoint, and Excel","hi":"Outlook, PowerPoint और Excel"},"o":[{"en":"Outlook, PowerPoint, and Excel","hi":"Outlook, PowerPoint और Excel"},{"en":"Excel, Word, and Access","hi":"Excel, Word और Access"},{"en":"PowerPoint, Outlook, and WordPad","hi":"PowerPoint, Outlook और WordPad"},{"en":"Edge, Paint, and Notepad","hi":"Edge, Paint और Notepad"}],"exp":{"en":"Rapid-Fire: Microsoft's examples are Outlook (Email), PowerPoint (Presentation), and Excel (Spreadsheet).","hi":"रैपिड-फायर: ईमेल के लिए Outlook, प्रेजेंटेशन के लिए PowerPoint और स्प्रेडशीट के लिए Excel माइक्रोसॉफ्ट के उदाहरण हैं।"},"num":232},{"id":"q233","q":{"en":"What is VLC Media Player primarily used for?","hi":"VLC Media Player किस काम के लिए उपयोग होता है?"},"a":{"en":"Multimedia (audio and video) playback","hi":"मल्टीमीडिया (ऑडियो और वीडियो) प्लेबैक"},"o":[{"en":"Multimedia (audio and video) playback","hi":"मल्टीमीडिया (ऑडियो और वीडियो) प्लेबैक"},{"en":"Compiling C++ source code","hi":"C++ सोर्स कोड कंपाइल करने के लिए"},{"en":"Formatting hard disk partitions","hi":"हार्ड डिस्क पार्टीशन फ़ॉर्मेट करने के लिए"},{"en":"Designing architectural blueprints","hi":"वास्तुशिल्प ब्लूप्रिंट डिज़ाइन करने के लिए"}],"exp":{"en":"Rapid-Fire: VLC Media Player is used for audio and video multimedia playback.","hi":"रैपिड-फायर: VLC का उपयोग मल्टीमीडिया (ऑडियो और वीडियो) प्लेबैक के लिए होता है।"},"num":233},{"id":"q234","q":{"en":"Mozilla Firefox and LibreOffice are classic examples of which software licensing category?","hi":"Firefox और LibreOffice किस लाइसेंस श्रेणी के प्रमुख उदाहरण हैं?"},"a":{"en":"FOSS (Free and Open Source Software)","hi":"FOSS (फ्री एंड ओपन सोर्स सॉफ्टवेयर)"},"o":[{"en":"FOSS (Free and Open Source Software)","hi":"FOSS (फ्री एंड ओपन सोर्स सॉफ्टवेयर)"},{"en":"Closed-source paid proprietary software","hi":"क्लोज्ड-सोर्स सशुल्क प्रोप्राइटरी सॉफ्टवेयर"},{"en":"Motherboard ROM firmware","hi":"मदरबोर्ड ROM फर्मवेयर"},{"en":"Hardware bus controllers","hi":"हार्डवेयर बस कंट्रोलर"}],"exp":{"en":"Rapid-Fire: Mozilla Firefox and LibreOffice are classic examples of FOSS (Free and Open Source Software).","hi":"रैपिड-फायर: Firefox और LibreOffice दोनों FOSS (Free and Open Source Software) श्रेणी के उदाहरण हैं।"},"num":234},{"id":"q235","q":{"en":"Which system software acts as the manager of all system resources?","hi":"सिस्टम संसाधनों का प्रबंधक (Manager of system resources) कौन होता है?"},"a":{"en":"Operating System (OS)","hi":"ऑपरेटिंग सिस्टम (Operating system)"},"o":[{"en":"Operating System (OS)","hi":"ऑपरेटिंग सिस्टम (Operating system)"},{"en":"Word Processor","hi":"वर्ड प्रोसेसर"},{"en":"Web Browser","hi":"वेब ब्राउज़र"},{"en":"Media Player","hi":"मीडिया प्लेयर"}],"exp":{"en":"Rapid-Fire: The Operating System is the central manager of all hardware and software system resources.","hi":"रैपिड-फायर: सिस्टम के सभी संसाधनों का प्रबंधक 'ऑपरेटिंग सिस्टम' (Operating system) होता है।"},"num":235},{"id":"q236","q":{"en":"Which type of user interface operates via spoken commands (e.g., Siri, OK Google)?","hi":"बोलकर दिए गए कमांड्स (Spoken commands) से चलने वाला यूज़र इंटरफेस कौन-सा है?"},"a":{"en":"Voice-based interface","hi":"वॉयस-आधारित इंटरफेस (Voice-based interface)"},"o":[{"en":"Voice-based interface","hi":"वॉयस-आधारित इंटरफेस (Voice-based interface)"},{"en":"Command-line text interface","hi":"कमांड-लाइन टेक्स्ट इंटरफेस"},{"en":"Batch punched-card interface","hi":"बैच पंच-कार्ड इंटरफेस"},{"en":"Mechanical jumper interface","hi":"मैकेनिकल जम्पर इंटरफेस"}],"exp":{"en":"Rapid-Fire: A Voice-Based Interface operates using spoken voice commands.","hi":"रैपिड-फायर: बोलकर कमांड देने वाला इंटरफेस 'वॉयस-आधारित इंटरफेस' (Voice-based interface) कहलाता है।"},"num":236},{"id":"q237","q":{"en":"In which year was the first commercial Android phone released?","hi":"पहला कमर्शियल Android फ़ोन किस वर्ष आया?"},"a":{"en":"2008","hi":"2008"},"o":[{"en":"2008","hi":"2008"},{"en":"1984","hi":"1984"},{"en":"1995","hi":"1995"},{"en":"2015","hi":"2015"}],"exp":{"en":"Rapid-Fire: The first commercial Android smartphone was released in 2008.","hi":"रैपिड-फायर: पहला व्यावसायिक Android फ़ोन वर्ष 2008 में रिलीज़ हुआ था।"},"num":237},{"id":"q238","q":{"en":"What is the release year of Microsoft Windows 1.0?","hi":"Windows 1.0 का रिलीज़ वर्ष क्या है?"},"a":{"en":"1985","hi":"1985"},"o":[{"en":"1985","hi":"1985"},{"en":"1969","hi":"1969"},{"en":"2001","hi":"2001"},{"en":"2008","hi":"2008"}],"exp":{"en":"Rapid-Fire: Microsoft Windows 1.0 was released in 1985.","hi":"रैपिड-फायर: Windows 1.0 का रिलीज़ वर्ष 1985 है।"},"num":238},{"id":"q239","q":{"en":"In which year did the development of Unix begin at Bell Labs?","hi":"बेल लैब्स में Unix की शुरुआत किस वर्ष हुई?"},"a":{"en":"1969","hi":"1969"},"o":[{"en":"1969","hi":"1969"},{"en":"1985","hi":"1985"},{"en":"1999","hi":"1999"},{"en":"2007","hi":"2007"}],"exp":{"en":"Rapid-Fire: Unix development began at AT&T Bell Labs in 1969.","hi":"रैपिड-फायर: Unix के विकास की शुरुआत वर्ष 1969 में हुई थी।"},"num":239},{"id":"q240","q":{"en":"Which type of OS is required when response deadlines must be strictly predictable?","hi":"जब रिस्पॉन्स की समय-सीमा (Deadline) पूरी तरह पूर्वानुमानित होनी चाहिए, तो कौन-सा OS उपयोग होता है?"},"a":{"en":"Real-Time Operating System (RTOS)","hi":"रियल-टाइम ऑपरेटिंग सिस्टम (Real-time OS)"},"o":[{"en":"Real-Time Operating System (RTOS)","hi":"रियल-टाइम ऑपरेटिंग सिस्टम (Real-time OS)"},{"en":"Offline Batch OS","hi":"ऑफ़लाइन बैच ओएस"},{"en":"Single-tasking DOS","hi":"सिंगल-टास्किंग डॉस"},{"en":"Desktop Publishing tool","hi":"डेस्कटॉप पब्लिशिंग टूल"}],"exp":{"en":"Rapid-Fire: A Real-Time Operating System (RTOS) guarantees predictable response within strict time deadlines.","hi":"रैपिड-फायर: निर्धारित समय-सीमा (deadline) के भीतर निश्चित रिस्पॉन्स के लिए 'रियल-टाइम OS' (RTOS) का उपयोग होता है।"},"num":240},{"id":"q241","q":{"en":"Processing similar jobs together in a group without user interaction is called what?","hi":"समान प्रकार की जॉब्स को समूह (Group) में एक साथ प्रोसेस करना क्या कहलाता है?"},"a":{"en":"Batch processing","hi":"बैच प्रोसेसिंग (Batch processing)"},"o":[{"en":"Batch processing","hi":"बैच प्रोसेसिंग (Batch processing)"},{"en":"Hard real-time processing","hi":"हार्ड रियल-टाइम प्रोसेसिंग"},{"en":"Voice recognition","hi":"वॉयस रिकग्निशन"},{"en":"Touch gesture processing","hi":"टच जेस्चर प्रोसेसिंग"}],"exp":{"en":"Rapid-Fire: Grouping similar jobs for non-interactive execution is called Batch Processing.","hi":"रैपिड-फायर: समान कार्यों को समूह में प्रोसेस करना 'बैच प्रोसेसिंग' (Batch processing) कहलाता है।"},"num":241},{"id":"q242","q":{"en":"Which two are the most widely used Smartphone Operating Systems?","hi":"प्रमुख स्मार्टफोन ऑपरेटिंग सिस्टम कौन-से हैं?"},"a":{"en":"Android and iOS","hi":"Android और iOS"},"o":[{"en":"Android and iOS","hi":"Android और iOS"},{"en":"MS-DOS and PC-DOS","hi":"MS-DOS और PC-DOS"},{"en":"Xenix and Solaris","hi":"Xenix और Solaris"},{"en":"WordStar and Calc","hi":"WordStar और Calc"}],"exp":{"en":"Rapid-Fire: Google Android and Apple iOS are the two dominant smartphone operating systems.","hi":"रैपिड-फायर: प्रमुख स्मार्टफोन ऑपरेटिंग सिस्टम Android और iOS हैं।"},"num":242},{"id":"q243","q":{"en":"What do the Windows shortcuts 'Win + E' and 'Win + R' open respectively?","hi":"'Win + E' और 'Win + R' शॉर्टकट क्रमशः क्या खोलते हैं?"},"a":{"en":"File Explorer and Run dialog box","hi":"फ़ाइल एक्सप्लोरर (File Explorer) और रन डायलॉग (Run dialog)"},"o":[{"en":"File Explorer and Run dialog box","hi":"फ़ाइल एक्सप्लोरर (File Explorer) और रन डायलॉग (Run dialog)"},{"en":"Run dialog and File Explorer","hi":"रन डायलॉग और फ़ाइल एक्सप्लोरर"},{"en":"Excel and Recycle Bin","hi":"एक्सेल और रीसायकल बिन"},{"en":"Edge browser and Registry","hi":"एज ब्राउज़र और रजिस्ट्री"}],"exp":{"en":"Rapid-Fire: `Win + E` opens File Explorer, and `Win + R` opens the Run dialog.","hi":"रैपिड-फायर: `Win + E` फ़ाइल एक्सप्लोरर खोलता है और `Win + R` रन डायलॉग बॉक्स खोलता है।"},"num":243},{"id":"q244","q":{"en":"What do the Windows shortcuts 'Win + D' and 'Win + L' do respectively?","hi":"'Win + D' और 'Win + L' शॉर्टकट क्रमशः क्या करते हैं?"},"a":{"en":"Show/hide desktop and Lock PC","hi":"डेस्कटॉप दिखाना/छिपाना (Show/hide desktop) और पीसी लॉक करना (Lock PC)"},"o":[{"en":"Show/hide desktop and Lock PC","hi":"डेस्कटॉप दिखाना/छिपाना (Show/hide desktop) और पीसी लॉक करना (Lock PC)"},{"en":"Delete file and Log off permanently","hi":"फ़ाइल डिलीट करना और स्थायी रूप से लॉग ऑफ करना"},{"en":"Open Device Manager and Launch Linux","hi":"डिवाइस मैनेजर खोलना और लिनक्स चलाना"},{"en":"Duplicate window and Left-align text","hi":"विंडो डुप्लीकेट करना और टेक्स्ट बाएँ संरेखित करना"}],"exp":{"en":"Rapid-Fire: `Win + D` shows/hides the desktop, and `Win + L` locks the PC.","hi":"रैपिड-फायर: `Win + D` डेस्कटॉप शो/हाइड करता है और `Win + L` पीसी को लॉक करता है।"},"num":244},{"id":"q245","q":{"en":"What is the core component of an Operating System called?","hi":"ऑपरेटिंग सिस्टम का सबसे मुख्य भाग (Core of OS) क्या कहलाता है?"},"a":{"en":"Kernel","hi":"कर्नेल (Kernel)"},"o":[{"en":"Kernel","hi":"कर्नेल (Kernel)"},{"en":"Shell","hi":"शेल"},{"en":"Applet","hi":"एप्लेट"},{"en":"Widget","hi":"विजेट"}],"exp":{"en":"Rapid-Fire: The core component of an Operating System is the Kernel.","hi":"रैपिड-फायर: ऑपरेटिंग सिस्टम के कोर (मूल भाग) को 'कर्नेल' (Kernel) कहते हैं।"},"num":245},{"id":"q246","q":{"en":"What is the OS interface that accepts and interprets user commands called?","hi":"यूज़र के कमांड्स को इंटरप्रेट करने वाला इंटरफेस क्या कहलाता है?"},"a":{"en":"Shell","hi":"शेल (Shell)"},"o":[{"en":"Shell","hi":"शेल (Shell)"},{"en":"Platter","hi":"प्लैटर"},{"en":"Register","hi":"रजिस्टर"},{"en":"Bus","hi":"बस"}],"exp":{"en":"Rapid-Fire: The command interpreter interface is called the Shell.","hi":"रैपिड-फायर: कमांड्स को स्वीकार और इंटरप्रेट करने वाले इंटरफेस को 'शेल' (Shell) कहते हैं।"},"num":246},{"id":"q247","q":{"en":"What is the Unix/Linux term for a background service process?","hi":"बैकग्राउंड सर्विस प्रोसेस के लिए Unix/Linux शब्द क्या है?"},"a":{"en":"Daemon","hi":"डेमन (Daemon)"},"o":[{"en":"Daemon","hi":"डेमन (Daemon)"},{"en":"Trojan","hi":"ट्रोजन"},{"en":"Macro","hi":"मैक्रो"},{"en":"Ribbon","hi":"रिबन"}],"exp":{"en":"Rapid-Fire: A background service process in Unix/Linux is called a Daemon.","hi":"रैपिड-फायर: Unix/Linux में बैकग्राउंड सर्विस प्रोसेस को 'डेमन' (Daemon) कहते हैं।"},"num":247},{"id":"q248","q":{"en":"What are the full forms of CSS and SQL?","hi":"CSS और SQL के पूर्ण रूप क्या हैं?"},"a":{"en":"Cascading Style Sheets and Structured Query Language","hi":"Cascading Style Sheets और Structured Query Language"},"o":[{"en":"Cascading Style Sheets and Structured Query Language","hi":"Cascading Style Sheets और Structured Query Language"},{"en":"Computer System Software and Standard Query List","hi":"Computer System Software और Standard Query List"},{"en":"Central Server Storage and Symbolic Quantum Logic","hi":"Central Server Storage और Symbolic Quantum Logic"},{"en":"Compiled Style Script and System Queue Loader","hi":"Compiled Style Script और System Queue Loader"}],"exp":{"en":"Rapid-Fire: CSS = Cascading Style Sheets, and SQL = Structured Query Language.","hi":"रैपिड-फायर: CSS का पूर्ण रूप Cascading Style Sheets और SQL का पूर्ण रूप Structured Query Language है।"},"num":248},{"id":"q249","q":{"en":"What are the full forms of GIF and PDF?","hi":"GIF और PDF के पूर्ण रूप क्या हैं?"},"a":{"en":"Graphics Interchange Format and Portable Document Format","hi":"Graphics Interchange Format और Portable Document Format"},"o":[{"en":"Graphics Interchange Format and Portable Document Format","hi":"Graphics Interchange Format और Portable Document Format"},{"en":"Global Image File and Printed Data File","hi":"Global Image File और Printed Data File"},{"en":"General Icon Format and Personal Desktop File","hi":"General Icon Format और Personal Desktop File"},{"en":"Graphical Interface Frame and Public Document Folder","hi":"Graphical Interface Frame और Public Document Folder"}],"exp":{"en":"Rapid-Fire: GIF = Graphics Interchange Format, and PDF = Portable Document Format.","hi":"रैपिड-फायर: GIF का पूर्ण रूप Graphics Interchange Format और PDF का पूर्ण रूप Portable Document Format है।"},"num":249},{"id":"q250","q":{"en":"What are the full forms of LED and LCD?","hi":"LED और LCD के पूर्ण रूप क्या हैं?"},"a":{"en":"Light-Emitting Diode and Liquid Crystal Display","hi":"Light-Emitting Diode और Liquid Crystal Display"},"o":[{"en":"Light-Emitting Diode and Liquid Crystal Display","hi":"Light-Emitting Diode और Liquid Crystal Display"},{"en":"Liquid Electronic Display and Light Cathode Diode","hi":"Liquid Electronic Display और Light Cathode Diode"},{"en":"Laser Emitting Device and Linear Colour Display","hi":"Laser Emitting Device और Linear Colour Display"},{"en":"Low Energy Diode and Local Computer Display","hi":"Low Energy Diode और Local Computer Display"}],"exp":{"en":"Rapid-Fire: LED = Light-Emitting Diode, and LCD = Liquid Crystal Display.","hi":"रैपिड-फायर: LED का पूर्ण रूप Light-Emitting Diode और LCD का पूर्ण रूप Liquid Crystal Display है।"},"num":250}]}],"4. Microsoft Office — Word, Excel, PowerPoint & Access":[{"title":{"en":"1. Microsoft Office & File Formats","hi":"1. माइक्रोसॉफ्ट ऑफिस और फाइल फॉर्मेट"},"questions":[{"id":"q1","q":{"en":"What is Microsoft Office?","hi":"माइक्रोसॉफ्ट ऑफिस (Microsoft Office) क्या है?"},"a":{"en":"A suite of Microsoft's client applications, server software, and productivity services","hi":"माइक्रोसॉफ्ट के क्लाइंट ऐप्स, सर्वर सॉफ्टवेयर और प्रोडक्टिविटी सेवाओं का एक सूट (Suite)"},"o":[{"en":"An open-source Linux kernel used only for hardware driver compilation","hi":"केवल हार्डवेयर ड्राइवर संकलन के लिए उपयोग किया जाने वाला एक ओपन-सोर्स लिनक्स कर्नेल"},{"en":"A suite of Microsoft's client applications, server software, and productivity services","hi":"माइक्रोसॉफ्ट के क्लाइंट ऐप्स, सर्वर सॉफ्टवेयर और प्रोडक्टिविटी सेवाओं का एक सूट (Suite)"},{"en":"A standalone antivirus utility built exclusively for mainframes","hi":"विशेष रूप से मेनफ्रेम के लिए बनाया गया एक स्टैंडअलोन एंटीवायरस यूटिलिटी"},{"en":"A physical semiconductor chip installed inside a printer","hi":"प्रिंटर के अंदर स्थापित एक भौतिक सेमीकंडक्टर चिप"}],"exp":{"en":"Microsoft Office is a comprehensive suite of Microsoft's client applications, server software, and productivity services designed for document creation, data analysis, presentations, and communication.","hi":"माइक्रोसॉफ्ट ऑफिस (Microsoft Office) माइक्रोसॉफ्ट के क्लाइंट ऐप्स, सर्वर सॉफ्टवेयर और प्रोडक्टिविटी सेवाओं का एक एकीकृत सूट (suite) है।"},"num":1},{"id":"q2","q":{"en":"Which versions of Microsoft Office are mentioned in the chapter notes (along with the subscription line and later standalone release)?","hi":"अध्याय नोट्स में माइक्रोसॉफ्ट ऑफिस के कौन-से संस्करण (Versions) दिए गए हैं?"},"a":{"en":"Office 2003, 2007, 2010, 2013, 2016, and 2019, plus the Office 365 subscription line (with Office 2024 as a later standalone release)","hi":"ऑफिस 2003, 2007, 2010, 2013, 2016 और 2019, साथ ही ऑफिस 365 सब्सक्रिप्शन लाइन (और बाद के स्टैंडअलोन रिलीज़ के रूप में ऑफिस 2024)"},"o":[{"en":"Only Office 1995 and Office 1997","hi":"केवल ऑफिस 1995 और ऑफिस 1997"},{"en":"Office 2003, 2007, 2010, 2013, 2016, and 2019, plus the Office 365 subscription line (with Office 2024 as a later standalone release)","hi":"ऑफिस 2003, 2007, 2010, 2013, 2016 और 2019, साथ ही ऑफिस 365 सब्सक्रिप्शन लाइन (और बाद के स्टैंडअलोन रिलीज़ के रूप में ऑफिस 2024)"},{"en":"Office XP, Office 2000, and Office Vista only","hi":"केवल ऑफिस XP, ऑफिस 2000 और ऑफिस विस्टा"},{"en":"Only Android Office Mobile 1.0","hi":"केवल एंड्रॉइड ऑफिस मोबाइल 1.0"}],"exp":{"en":"The chapter lists Office 2003, 2007, 2010, 2013, 2016, and 2019 along with the Office 365 subscription line, while noting Office 2024 as a later standalone release.","hi":"अध्याय में Office 2003, 2007, 2010, 2013, 2016 और 2019 के साथ-साथ Office 365 सब्सक्रिप्शन लाइन का उल्लेख है, तथा Office 2024 एक बाद का स्टैंडअलोन (standalone) रिलीज़ है।"},"num":2},{"id":"q3","q":{"en":"With which release of Microsoft Office was the 'Ribbon' interface introduced?","hi":"'रिबन' (Ribbon) इंटरफ़ेस माइक्रोसॉफ्ट ऑफिस के किस रिलीज़ से जुड़ा है?"},"a":{"en":"Office 2007 — The Ribbon organized commands into tabs and groups across core applications","hi":"ऑफिस 2007 — रिबन ने मुख्य ऐप्स में कमांड्स को टैब्स (tabs) और ग्रुप्स (groups) में व्यवस्थित किया"},"o":[{"en":"Office 1997 — It replaced the mouse with punch cards","hi":"ऑफिस 1997 — इसने माउस को पंच कार्ड से बदल दिया"},{"en":"Office 2003 — It removed all tabs and toolbars","hi":"ऑफिस 2003 — इसने सभी टैब और टूलबार हटा दिए"},{"en":"Office 2007 — The Ribbon organized commands into tabs and groups across core applications","hi":"ऑफिस 2007 — रिबन ने मुख्य ऐप्स में कमांड्स को टैब्स (tabs) और ग्रुप्स (groups) में व्यवस्थित किया"},{"en":"Office 2019 — It introduced command-line DOS menus","hi":"ऑफिस 2019 — इसने कमांड-लाइन DOS मेनू शुरू किया"}],"exp":{"en":"The Ribbon interface was introduced in Microsoft Office 2007, replacing traditional drop-down menus by organizing commands into visual tabs and groups in core apps.","hi":"रिबन (Ribbon) इंटरफ़ेस Office 2007 से जुड़ा है। रिबन ने मुख्य ऐप्स में सभी कमांड्स को टैब्स (tabs) और ग्रुप्स (groups) में व्यवस्थित किया।"},"num":3},{"id":"q4","q":{"en":"What are the main features of Office 365 / Microsoft 365?","hi":"Office 365 / Microsoft 365 की मुख्य विशेषताएँ क्या हैं?"},"a":{"en":"Subscription-based apps/services, cloud integration, and real-time collaboration in supported files","hi":"सब्सक्रिप्शन-आधारित ऐप्स/सेवाएँ, क्लाउड एकीकरण और समर्थित फाइलों में रियल-टाइम सहयोग (Collaboration)"},"o":[{"en":"Subscription-based apps/services, cloud integration, and real-time collaboration in supported files","hi":"सब्सक्रिप्शन-आधारित ऐप्स/सेवाएँ, क्लाउड एकीकरण और समर्थित फाइलों में रियल-टाइम सहयोग (Collaboration)"},{"en":"Offline-only floppy disk installation without internet support","hi":"बिना इंटरनेट सपोर्ट के केवल ऑफ़लाइन फ्लॉपी डिस्क इंस्टॉलेशन"},{"en":"Hardware BIOS flashing and motherboard overclocking","hi":"हार्डवेयर BIOS फ्लैशिंग और मदरबोर्ड ओवरक्लॉकिंग"},{"en":"Single-use CD-ROM that expires after 24 hours","hi":"एकल-उपयोग CD-ROM जो 24 घंटे के बाद समाप्त हो जाता है"}],"exp":{"en":"Office 365 (now Microsoft 365) provides subscription-based applications and services, seamless cloud integration (OneDrive/SharePoint), and real-time co-authoring/collaboration in supported files.","hi":"Office 365 / Microsoft 365 की मुख्य विशेषताएँ सब्सक्रिप्शन-आधारित ऐप्स/सेवाएँ, क्लाउड इंटीग्रेशन और समर्थित फाइलों में रियल-टाइम कोलैबोरेशन (सहयोग) हैं।"},"num":4},{"id":"q5","q":{"en":"Which user categories are targeted by 'Microsoft 365 Family' and 'Microsoft 365 Personal'?","hi":"'Microsoft 365 Family' और 'Microsoft 365 Personal' किन उपयोगकर्ताओं के लिए हैं?"},"a":{"en":"Family is for shared household use and Personal is for individual use (historically named Office 365 Home and Personal)","hi":"Family साझा घरेलू उपयोग के लिए और Personal व्यक्तिगत उपयोग के लिए है (अध्याय में इनके ऐतिहासिक नाम Office 365 Home और Personal भी दिए गए हैं)"},"o":[{"en":"Family is for nuclear research labs, and Personal is for ATM machines","hi":"Family परमाणु अनुसंधान प्रयोगशालाओं के लिए है और Personal एटीएम मशीनों के लिए है"},{"en":"Family is for shared household use and Personal is for individual use (historically named Office 365 Home and Personal)","hi":"Family साझा घरेलू उपयोग के लिए और Personal व्यक्तिगत उपयोग के लिए है (अध्याय में इनके ऐतिहासिक नाम Office 365 Home और Personal भी दिए गए हैं)"},{"en":"Both are exclusively for government mainframe servers","hi":"दोनों विशेष रूप से सरकारी मेनफ्रेम सर्वरों के लिए हैं"},{"en":"Family is for single-user offline use, and Personal supports 500 corporate employees","hi":"Family सिंगल-यूजर ऑफ़लाइन उपयोग के लिए है, और Personal 500 कॉर्पोरेट कर्मचारियों को सपोर्ट करता है"}],"exp":{"en":"Microsoft 365 Family is designed for shared household use, whereas Microsoft 365 Personal is meant for a single individual user (earlier known as Office 365 Home and Office 365 Personal).","hi":"Microsoft 365 Family साझा घरेलू उपयोग (shared household use) के लिए और Personal व्यक्तिगत उपयोग (individual use) के लिए है। अध्याय में इनके पुराने नाम Office 365 Home और Personal भी दिए गए हैं।"},"num":5},{"id":"q6","q":{"en":"Which of the following are cited as the main applications of the Microsoft Office suite in the chapter?","hi":"अध्याय में माइक्रोसॉफ्ट ऑफिस सूट के मुख्य ऐप्स (Main Apps) के रूप में कौन-से उदाहरण दिए गए हैं?"},"a":{"en":"Word, Excel, PowerPoint, Outlook, Access, and Publisher (availability depends on edition)","hi":"Word, Excel, PowerPoint, Outlook, Access और Publisher (ऐप की उपलब्धता एडिशन पर निर्भर करती है)"},"o":[{"en":"Photoshop, Illustrator, Premiere Pro, and After Effects","hi":"फ़ोटोशॉप, इलस्ट्रेटर, प्रीमियर प्रो और आफ्टर इफेक्ट्स"},{"en":"Word, Excel, PowerPoint, Outlook, Access, and Publisher (availability depends on edition)","hi":"Word, Excel, PowerPoint, Outlook, Access और Publisher (ऐप की उपलब्धता एडिशन पर निर्भर करती है)"},{"en":"AutoCAD, Maya, Blender, and SolidWorks","hi":"ऑटोकैड, माया, ब्लेंडर और सॉलिडवर्क्स"},{"en":"Ubuntu, Fedora, Debian, and Red Hat","hi":"उबंटू, फेडोरा, डेबियन और रेड हैट"}],"exp":{"en":"The primary applications in the Microsoft Office suite highlighted in the chapter are Word, Excel, PowerPoint, Outlook, Access, and Publisher, with exact app availability depending on the suite edition.","hi":"ऑफिस सूट के मुख्य ऐप्स के उदाहरण Word, Excel, PowerPoint, Outlook, Access और Publisher हैं, जहाँ ऐप्स की उपलब्धता ऑफिस एडिशन (edition) पर निर्भर करती है।"},"num":6},{"id":"q7","q":{"en":"What are the primary functions of Microsoft Word, Excel, and PowerPoint respectively?","hi":"Word, Excel और PowerPoint के मुख्य कार्य क्रमशः क्या हैं?"},"a":{"en":"Word for documents, Excel for spreadsheets and calculations, and PowerPoint for slide presentations","hi":"Word दस्तावेज़ों (documents) के लिए, Excel स्प्रेडशीट्स और गणनाओं (calculations) के लिए, तथा PowerPoint स्लाइड प्रेजेंटेशन के लिए"},"o":[{"en":"Word for documents, Excel for spreadsheets and calculations, and PowerPoint for slide presentations","hi":"Word दस्तावेज़ों (documents) के लिए, Excel स्प्रेडशीट्स और गणनाओं (calculations) के लिए, तथा PowerPoint स्लाइड प्रेजेंटेशन के लिए"},{"en":"Word for database tables, Excel for video editing, and PowerPoint for web browsing","hi":"Word डेटाबेस तालिकाओं के लिए, Excel वीडियो एडिटिंग के लिए और PowerPoint वेब ब्राउज़िंग के लिए"},{"en":"Word for slide shows, Excel for word processing, and PowerPoint for accounting ledgers","hi":"Word स्लाइड शो के लिए, Excel वर्ड प्रोसेसिंग के लिए और PowerPoint अकाउंटिंग लेजर के लिए"},{"en":"Word for audio mixing, Excel for 3D animation, and PowerPoint for antivirus scanning","hi":"Word ऑडियो मिक्सिंग के लिए, Excel 3D एनीमेशन के लिए और PowerPoint एंटीवायरस स्कैनिंग के लिए"}],"exp":{"en":"In the Office suite, MS Word is used for creating text documents, MS Excel is used for spreadsheets and numerical calculations, and MS PowerPoint is used for slide presentations.","hi":"Word का उपयोग डॉक्यूमेंट्स बनाने के लिए, Excel का उपयोग स्प्रेडशीट्स और कैलकुलेशन (गणनाओं) के लिए, और PowerPoint का उपयोग स्लाइड प्रेजेंटेशन के लिए किया जाता है।"},"num":7},{"id":"q8","q":{"en":"What is the difference between MS Word's .doc, .docx, and .docm file extensions?","hi":"MS Word की .doc, .docx और .docm फाइलों में क्या अंतर है?"},"a":{"en":".doc is a legacy document, .docx is the standard Office Open XML document, and .docm is a macro-enabled document","hi":".doc लीगेसी (पुराना) डॉक्यूमेंट है, .docx मानक Office Open XML डॉक्यूमेंट है और .docm मैक्रो-सक्षम (macro-enabled) डॉक्यूमेंट है"},"o":[{"en":".doc is an image file, .docx is an audio file, and .docm is a video file","hi":".doc एक इमेज फाइल है, .docx एक ऑडियो फाइल है और .docm एक वीडियो फाइल है"},{"en":".doc is a legacy document, .docx is the standard Office Open XML document, and .docm is a macro-enabled document","hi":".doc लीगेसी (पुराना) डॉक्यूमेंट है, .docx मानक Office Open XML डॉक्यूमेंट है और .docm मैक्रो-सक्षम (macro-enabled) डॉक्यूमेंट है"},{"en":".doc is for Excel, .docx is for PowerPoint, and .docm is for Access","hi":".doc एक्सेल के लिए है, .docx पावरपॉइंट के लिए है और .docm एक्सेस के लिए है"},{"en":"All three are identical plain-text Notepad formats","hi":"तीनों बिल्कुल समान प्लेन-टेक्स्ट नोटपैड फॉर्मेट हैं"}],"exp":{"en":"In MS Word, .doc is the legacy binary document format (Word 97–2003), .docx is the default Office Open XML document format (Word 2007+), and .docm is a macro-enabled document that stores VBA macros.","hi":"Word में .doc लीगेसी (पुराना) डॉक्यूमेंट फॉर्मेट है, .docx मानक Office Open XML डॉक्यूमेंट है और .docm मैक्रो-इनेबल्ड (macro-enabled) डॉक्यूमेंट है।"},"num":8},{"id":"q9","q":{"en":"What are the old (legacy) and new (XML-based) default file extensions of MS Excel and MS PowerPoint?","hi":"Excel और PowerPoint के पुराने (old) और नए (new) फाइल एक्सटेंशन क्या हैं?"},"a":{"en":"Excel: .xls / .xlsx; PowerPoint: .ppt / .pptx","hi":"एक्सेल: .xls / .xlsx; पावरपॉइंट: .ppt / .pptx"},"o":[{"en":"Excel: .doc / .docx; PowerPoint: .mdb / .accdb","hi":"एक्सेल: .doc / .docx; पावरपॉइंट: .mdb / .accdb"},{"en":"Excel: .xls / .xlsx; PowerPoint: .ppt / .pptx","hi":"एक्सेल: .xls / .xlsx; पावरपॉइंट: .ppt / .pptx"},{"en":"Excel: .wav / .mid; PowerPoint: .bmp / .png","hi":"एक्सेल: .wav / .mid; पावरपॉइंट: .bmp / .png"},{"en":"Excel: .txt / .rtf; PowerPoint: .htm / .html","hi":"एक्सेल: .txt / .rtf; पावरपॉइंट: .htm / .html"}],"exp":{"en":"MS Excel uses .xls as its legacy extension and .xlsx as its newer Office Open XML extension; MS PowerPoint uses .ppt as its legacy extension and .pptx as its newer extension.","hi":"Excel के पुराने और नए फाइल एक्सटेंशन .xls / .xlsx हैं, जबकि PowerPoint के पुराने और नए फाइल एक्सटेंशन .ppt / .pptx हैं।"},"num":9},{"id":"q10","q":{"en":"Which of the following are the common legacy and newer database file formats of Microsoft Access?","hi":"माइक्रोसॉफ्ट एक्सेस (Access) के सामान्य पुराने और नए फाइल फॉर्मेट कौन-से हैं?"},"a":{"en":".mdb (legacy) and .accdb (newer Access database format)","hi":".mdb (लीगेसी/पुराना) और .accdb (नया एक्सेस डेटाबेस फॉर्मेट)"},"o":[{"en":".mdb (legacy) and .accdb (newer Access database format)","hi":".mdb (लीगेसी/पुराना) और .accdb (नया एक्सेस डेटाबेस फॉर्मेट)"},{"en":".xls (legacy) and .xlsx (newer format)","hi":".xls (पुराना) और .xlsx (नया फॉर्मेट)"},{"en":".jpg (legacy) and .png (newer format)","hi":".jpg (पुराना) और .png (नया फॉर्मेट)"},{"en":".avi (legacy) and .mp4 (newer format)","hi":".avi (पुराना) और .mp4 (नया फॉर्मेट)"}],"exp":{"en":"Microsoft Access uses .mdb (Microsoft Database) as its legacy format and .accdb (Access Database, introduced in Access 2007) as its newer standard format.","hi":"Access के सामान्य फाइल फॉर्मेट्स में .mdb लीगेसी (पुराना) फॉर्मेट है और .accdb नया Access डेटाबेस फॉर्मेट है।"},"num":10},{"id":"q11","q":{"en":"What is the 'PIM' role of Microsoft Outlook?","hi":"माइक्रोसॉफ्ट आउटलुक (Outlook) की 'PIM' भूमिका क्या है?"},"a":{"en":"Personal Information Manager — It manages email, calendar, contacts/address book, and tasks","hi":"पर्सनल इन्फॉर्मेशन मैनेजर — यह ईमेल, कैलेंडर, कॉन्टैक्ट्स/एड्रेस बुक और टास्क (tasks) को मैनेज करता है"},"o":[{"en":"Picture Image Modifier — It edits bitmap photographs","hi":"पिक्चर इमेज मॉडिफायर — यह बिटमैप तस्वीरों को एडिट करता है"},{"en":"Personal Information Manager — It manages email, calendar, contacts/address book, and tasks","hi":"पर्सनल इन्फॉर्मेशन मैनेजर — यह ईमेल, कैलेंडर, कॉन्टैक्ट्स/एड्रेस बुक और टास्क (tasks) को मैनेज करता है"},{"en":"Processor Instruction Module — It controls CPU clock speed","hi":"प्रोसेसर इंस्ट्रक्शन मॉड्यूल — यह CPU क्लॉक स्पीड को नियंत्रित करता है"},{"en":"Programmable Internet Modem — It routes fiber-optic packets","hi":"प्रोग्रामेबल इंटरनेट मॉडेम — यह फाइबर-ऑप्टिक पैकेट्स को रूट करता है"}],"exp":{"en":"In Microsoft Outlook, PIM stands for Personal Information Manager. Beyond email, it manages calendars, contacts/address books, appointments, and user tasks.","hi":"Outlook की PIM भूमिका का अर्थ Personal Information Manager है। यह ईमेल (email), कैलेंडर, कॉन्टैक्ट्स/एड्रेस बुक और टास्क (tasks) को मैनेज करता है।"},"num":11},{"id":"q12","q":{"en":"What types of content can be stored and shared in Microsoft OneNote?","hi":"माइक्रोसॉफ्ट वननोट (OneNote) में क्या स्टोर और शेयर किया जा सकता है?"},"a":{"en":"Typed or handwritten notes, drawings, screen clippings, and audio (which can be shared with other users)","hi":"टाइप या हाथ से लिखे नोट्स, ड्रॉइंग, स्क्रीन क्लिपिंग और ऑडियो (जिन्हें समर्थित शेयरिंग से दूसरे यूज़र्स के साथ साझा किया जा सकता है)"},"o":[{"en":"Typed or handwritten notes, drawings, screen clippings, and audio (which can be shared with other users)","hi":"टाइप या हाथ से लिखे नोट्स, ड्रॉइंग, स्क्रीन क्लिपिंग और ऑडियो (जिन्हें समर्थित शेयरिंग से दूसरे यूज़र्स के साथ साझा किया जा सकता है)"},{"en":"Only BIOS firmware binary files","hi":"केवल BIOS फर्मवेयर बाइनरी फाइलें"},{"en":"Only relational SQL server triggers","hi":"केवल रिलेशनल SQL सर्वर ट्रिगर्स"},{"en":"Only uncompressed 8K Blu-ray ISO images","hi":"केवल अनकंप्रेस्ड 8K ब्लू-रे ISO इमेज"}],"exp":{"en":"Microsoft OneNote is a digital notebook application that stores typed or handwritten notes, drawings, screen clippings, and audio commentaries, and allows sharing notes with other users.","hi":"OneNote में टाइप किए गए या हस्तलिखित (handwritten) नोट्स, ड्रॉइंग, स्क्रीन क्लिपिंग और ऑडियो स्टोर किए जा सकते हैं तथा इन्हें अन्य उपयोगकर्ताओं के साथ शेयर किया जा सकता है।"},"num":12},{"id":"q13","q":{"en":"What type of application is Microsoft Publisher and what is it used for?","hi":"माइक्रोसॉफ्ट पब्लिशर (Publisher) किस प्रकार का एप्लिकेशन है और इसका उपयोग किसलिए होता है?"},"a":{"en":"A desktop publishing application used to create layouts for brochures, labels, calendars, business cards, newsletters, postcards, and greeting cards","hi":"एक डेस्कटॉप पब्लिशिंग एप्लिकेशन जो ब्रोशर, लेबल, कैलेंडर, बिजनेस कार्ड, न्यूज़लेटर, पोस्टकार्ड और ग्रीटिंग कार्ड के लेआउट बनाता है"},"o":[{"en":"A command-line compiler used for writing device drivers","hi":"डिवाइस ड्राइवर लिखने के लिए प्रयुक्त एक कमांड-लाइन कंपाइलर"},{"en":"A desktop publishing application used to create layouts for brochures, labels, calendars, business cards, newsletters, postcards, and greeting cards","hi":"एक डेस्कटॉप पब्लिशिंग एप्लिकेशन जो ब्रोशर, लेबल, कैलेंडर, बिजनेस कार्ड, न्यूज़लेटर, पोस्टकार्ड और ग्रीटिंग कार्ड के लेआउट बनाता है"},{"en":"A disk defragmentation utility built into Windows","hi":"विंडोज़ में निर्मित एक डिस्क डीफ़्रेग्मेंटेशन यूटिलिटी"},{"en":"An audio synthesizer for MIDI files","hi":"MIDI फाइलों के लिए एक ऑडियो सिंथेसाइज़र"}],"exp":{"en":"Microsoft Publisher is a desktop publishing (DTP) application emphasized for page layout and design rather than heavy text composition—ideal for brochures, labels, calendars, business cards, newsletters, postcards, and greeting cards.","hi":"Publisher एक डेस्कटॉप पब्लिशिंग (Desktop publishing) एप्लिकेशन है, जो ब्रोशर, लेबल, कैलेंडर, बिजनेस कार्ड, न्यूज़लेटर, पोस्टकार्ड और ग्रीटिंग कार्ड के लेआउट बनाता है।"},"num":13},{"id":"q14","q":{"en":"Which option correctly gives the expansions/formats of JPEG, AVI, BMP, PNG, and HTML?","hi":"JPEG, AVI, BMP, PNG और HTML का सही विस्तार (Full Form / Format) कौन-सा विकल्प देता है?"},"a":{"en":"Joint Photographic Experts Group, Audio Video Interleave, Bitmap image, Portable Network Graphics, and Hypertext Markup Language","hi":"जॉइंट फोटोग्राफिक एक्सपर्ट्स ग्रुप, ऑडियो वीडियो इंटरलीव, बिटमैप इमेज, पोर्टेबल नेटवर्क ग्राफिक्स और हाइपरटेक्स्ट मार्कअप लैंग्वेज"},"o":[{"en":"Joint Photographic Experts Group, Audio Video Interleave, Bitmap image, Portable Network Graphics, and Hypertext Markup Language","hi":"जॉइंट फोटोग्राफिक एक्सपर्ट्स ग्रुप, ऑडियो वीडियो इंटरलीव, बिटमैप इमेज, पोर्टेबल नेटवर्क ग्राफिक्स और हाइपरटेक्स्ट मार्कअप लैंग्वेज"},{"en":"Java Photo Engine Group, Analog Video Interface, Binary Media Picture, Printable Network Grid, and High Text Machine Language","hi":"जावा फोटो इंजन ग्रुप, एनालॉग वीडियो इंटरफेस, बाइनरी मीडिया पिक्चर, प्रिंटेबल नेटवर्क ग्रिड और हाई टेक्स्ट मशीन लैंग्वेज"},{"en":"Joint Pixel Encoding Grid, Audio Visual Index, Basic Matrix Photo, Personal Node Graphics, and Hyperlink Transfer Markup","hi":"जॉइंट पिक्सेल एनकोडिंग ग्रिड, ऑडियो विजुअल इंडेक्स, बेसिक मैट्रिक्स फोटो, पर्सनल नोड ग्राफिक्स और हाइपरलिंक ट्रांसफर मार्कअप"},{"en":"Journal of Photo Editing, Automated Video Integration, Bit Mapped Protocol, Portable New Graphic, and Home Tool Markup Language","hi":"जर्नल ऑफ फोटो एडिटिंग, ऑटोमेटेड वीडियो इंटीग्रेशन, बिट मैप्ड प्रोटोकॉल, पोर्टेबल न्यू ग्राफिक और होम टूल मार्कअप लैंग्वेज"}],"exp":{"en":"Standard expansions: JPEG = Joint Photographic Experts Group; AVI = Audio Video Interleave; BMP = Bitmap image; PNG = Portable Network Graphics; HTML = Hypertext Markup Language.","hi":"सही विस्तार: JPEG = Joint Photographic Experts Group, AVI = Audio Video Interleave, BMP = Bitmap image, PNG = Portable Network Graphics और HTML = Hypertext Markup Language।"},"num":14},{"id":"q15","q":{"en":"Which legacy audio file formats are mentioned as historical examples in the PowerPoint notes?","hi":"PowerPoint के नोट्स में कौन-से लीगेसी ऑडियो फॉर्मेट (Legacy audio formats) ऐतिहासिक उदाहरण के रूप में दिए गए हैं?"},"a":{"en":".wav and .mid (insert/playback compatibility depends on the PowerPoint version and system)","hi":".wav और .mid (इनकी इंसर्ट/प्लेबैक अनुकूलता PowerPoint संस्करण और सिस्टम पर निर्भर करती है)"},"o":[{"en":".doc and .docx","hi":".doc और .docx"},{"en":".wav and .mid (insert/playback compatibility depends on the PowerPoint version and system)","hi":".wav और .mid (इनकी इंसर्ट/प्लेबैक अनुकूलता PowerPoint संस्करण और सिस्टम पर निर्भर करती है)"},{"en":".xls and .csv","hi":".xls और .csv"},{"en":".exe and .dll","hi":".exe और .dll"}],"exp":{"en":"The PowerPoint study notes mention .wav (Waveform Audio) and .mid (MIDI audio) as historical examples of sound files, noting that insert and playback compatibility depends on the PowerPoint version and operating system.","hi":"PowerPoint नोट्स में .wav और .mid को ऐतिहासिक ऑडियो फॉर्मेट उदाहरणों के रूप में दिया गया है (इनकी इंसर्ट/प्लेबैक कम्पैटिबिलिटी PowerPoint वर्ज़न और सिस्टम पर निर्भर करती है)।"},"num":15}]},{"title":{"en":"2. Word Window, Tabs & Formatting","hi":"2. वर्ड विंडो, टैब्स और फॉर्मेटिंग"},"questions":[{"id":"q16","q":{"en":"Which of the following are the important components of the Microsoft Word application window?","hi":"माइक्रोसॉफ्ट वर्ड (Word) विंडो के महत्वपूर्ण घटक (Important components) कौन-से हैं?"},"a":{"en":"Title bar, Quick Access Toolbar, File tab, Ribbon, status bar, and zoom controls","hi":"टाइटल बार, क्विक एक्सेस टूलबार, फाइल टैब, रिबन, स्टेटस बार और ज़ूम कंट्रोल्स"},"o":[{"en":"Title bar, Quick Access Toolbar, File tab, Ribbon, status bar, and zoom controls","hi":"टाइटल बार, क्विक एक्सेस टूलबार, फाइल टैब, रिबन, स्टेटस बार और ज़ूम कंट्रोल्स"},{"en":"Formula bar, Name box, Sheet tab, and Row header only","hi":"केवल फॉर्मूला बार, नेम बॉक्स, शीट टैब और रो हेडर"},{"en":"Slide pane, Notes pane, and Slide Sorter only","hi":"केवल स्लाइड पेन, नोट्स पेन और स्लाइड सॉर्टर"},{"en":"Primary key, Foreign key, and SQL Query grid only","hi":"केवल प्राइमरी की, फॉरेन की और SQL क्वेरी ग्रिड"}],"exp":{"en":"The key interface elements of the MS Word window include the Title bar, Quick Access Toolbar (QAT), File tab (Backstage view), Ribbon, Status bar, and Zoom controls.","hi":"Word विंडो के प्रमुख घटक टाइटल बार (Title bar), क्विक एक्सेस टूलबार (Quick Access Toolbar), फाइल टैब (File tab), रिबन (Ribbon), स्टेटस बार (status bar) और ज़ूम कंट्रोल्स (zoom controls) हैं।"},"num":16},{"id":"q17","q":{"en":"What does the 'Title Bar' display in MS Word?","hi":"MS Word में 'टाइटल बार' (Title bar) क्या दिखाती है?"},"a":{"en":"The name of the active document or application window","hi":"सक्रिय दस्तावेज़ (Active document) या विंडो का नाम"},"o":[{"en":"The total number of words and pages in the document","hi":"डॉक्यूमेंट में शब्दों और पृष्ठों की कुल संख्या"},{"en":"The name of the active document or application window","hi":"सक्रिय दस्तावेज़ (Active document) या विंडो का नाम"},{"en":"The list of synonyms for the selected word","hi":"चयनित शब्द के पर्यायवाची शब्दों की सूची"},{"en":"The margin settings and page orientation only","hi":"केवल मार्जिन सेटिंग्स और पेज ओरिएंटेशन"}],"exp":{"en":"Situated at the very top of the application window, the Title bar displays the name of the currently active document (e.g., Document1) and the application name (Word).","hi":"टाइटल बार (Title bar) विंडो के सबसे ऊपरी भाग में सक्रिय डॉक्यूमेंट (active document) या एप्लिकेशन विंडो का नाम दिखाती है।"},"num":17},{"id":"q18","q":{"en":"What is the primary purpose of the 'Quick Access Toolbar' (QAT) in MS Word?","hi":"MS Word में 'क्विक एक्सेस टूलबार' (Quick Access Toolbar) का मुख्य कार्य क्या है?"},"a":{"en":"To provide quick access to frequently used commands like Save, Undo, and Redo (and its buttons can be customized)","hi":"बार-बार उपयोग होने वाले कमांड्स जैसे Save, Undo और Redo तक त्वरित पहुँच प्रदान करना (इसके बटन कस्टमाइज़ किए जा सकते हैं)"},"o":[{"en":"To provide quick access to frequently used commands like Save, Undo, and Redo (and its buttons can be customized)","hi":"बार-बार उपयोग होने वाले कमांड्स जैसे Save, Undo और Redo तक त्वरित पहुँच प्रदान करना (इसके बटन कस्टमाइज़ किए जा सकते हैं)"},{"en":"To display the bottom page footer and watermark","hi":"निचले पेज फुटर और वॉटरमार्क को प्रदर्शित करना"},{"en":"To permanently delete the operating system","hi":"ऑपरेटिंग सिस्टम को स्थायी रूप से हटाना"},{"en":"To store deleted emails in a recycle bin","hi":"हटाए गए ईमेल को रीसायकल बिन में स्टोर करना"}],"exp":{"en":"The Quick Access Toolbar (QAT) is a customizable toolbar that provides one-click access to frequently used commands such as Save, Undo, and Redo regardless of which Ribbon tab is active.","hi":"Quick Access Toolbar का काम बार-बार उपयोग किए जाने वाले कमांड्स (जैसे Save, Undo और Redo) तक त्वरित (quick) पहुँच देना है, और इसके बटनों को कस्टमाइज़ किया जा सकता है।"},"num":18},{"id":"q19","q":{"en":"What is the functional difference between the Ribbon, Status Bar, and Zoom Controls in MS Word?","hi":"रिबन (Ribbon), स्टेटस बार (Status bar) और ज़ूम कंट्रोल्स (Zoom controls) में क्या अंतर है?"},"a":{"en":"Ribbon organizes commands into tabs/groups, Status bar displays document details like page/word count, and Zoom controls change display magnification","hi":"रिबन कमांड्स को व्यवस्थित करता है, स्टेटस बार पेज/वर्ड काउंट जैसी जानकारी दिखाती है और ज़ूम कंट्रोल्स डिस्प्ले आवर्धन (magnification) बदलते हैं"},"o":[{"en":"Ribbon shows page numbers, Status bar organizes tabs, and Zoom controls print the file","hi":"रिबन पेज नंबर दिखाता है, स्टेटस बार टैब व्यवस्थित करता है और ज़ूम कंट्रोल फाइल प्रिंट करता है"},{"en":"Ribbon organizes commands into tabs/groups, Status bar displays document details like page/word count, and Zoom controls change display magnification","hi":"रिबन कमांड्स को व्यवस्थित करता है, स्टेटस बार पेज/वर्ड काउंट जैसी जानकारी दिखाती है और ज़ूम कंट्रोल्स डिस्प्ले आवर्धन (magnification) बदलते हैं"},{"en":"All three are used exclusively for mail merge","hi":"तीनों का उपयोग केवल मेल मर्ज के लिए किया जाता है"},{"en":"Ribbon changes screen brightness, Status bar edits macros, and Zoom controls check spelling","hi":"रिबन स्क्रीन की चमक बदलता है, स्टेटस बार मैक्रो एडिट करता है और ज़ूम कंट्रोल स्पेलिंग जांचता है"}],"exp":{"en":"In MS Word, the Ribbon organizes commands into tabs and groups; the Status bar (at the bottom) shows real-time document statistics like page number and word count; and Zoom controls adjust the viewing magnification.","hi":"रिबन कमांड्स को टैब्स और ग्रुप्स में व्यवस्थित करता है, स्टेटस बार पेज/वर्ड काउंट जैसे विवरण दिखाती है, और ज़ूम कंट्रोल्स पेज का डिस्प्ले मैग्निफिकेशन (आवर्धन) बदलते हैं।"},"num":19},{"id":"q20","q":{"en":"Which of the following are the common Ribbon tabs in MS Word?","hi":"MS Word के सामान्य टैब्स (Common Tabs) कौन-से हैं?"},"a":{"en":"File, Home, Insert, Design, Layout, References, Mailings, Review, and View (Page Layout in older versions; Acrobat tab via add-ins)","hi":"File, Home, Insert, Design, Layout, References, Mailings, Review और View (पुराने संस्करणों में Page Layout लेबल और ऐड-इन्स में Acrobat टैब मिल सकता है)"},"o":[{"en":"File, Home, Insert, Design, Layout, References, Mailings, Review, and View (Page Layout in older versions; Acrobat tab via add-ins)","hi":"File, Home, Insert, Design, Layout, References, Mailings, Review और View (पुराने संस्करणों में Page Layout लेबल और ऐड-इन्स में Acrobat टैब मिल सकता है)"},{"en":"File, Data, Formulas, Slide Show, and Animations","hi":"File, Data, Formulas, Slide Show और Animations"},{"en":"Home, Transitions, Record, Query, and External Data","hi":"Home, Transitions, Record, Query और External Data"},{"en":"Start, Run, Control Panel, Registry, and Terminal","hi":"Start, Run, Control Panel, Registry और Terminal"}],"exp":{"en":"Standard Word tabs include File, Home, Insert, Design, Layout, References, Mailings, Review, and View. Older versions combined design/layout under 'Page Layout', and third-party add-ins can add tabs like 'Acrobat'.","hi":"Word के सामान्य टैब्स File, Home, Insert, Design, Layout, References, Mailings, Review और View हैं। पुराने वर्ज़न में Page Layout लेबल और ऐड-इन्स के माध्यम से Acrobat टैब मिल सकता है।"},"num":20},{"id":"q21","q":{"en":"Which Backstage commands are found under the 'File' tab in MS Word?","hi":"MS Word के 'File' टैब (Backstage view) में कौन-से कमांड्स मिलते हैं?"},"a":{"en":"New, Open, Save, Save As, Print, Share, Export, Close, Account, Feedback, and Options","hi":"New, Open, Save, Save As, Print, Share, Export, Close, Account, Feedback और Options जैसे बैकस्टेज कमांड्स"},"o":[{"en":"Bold, Italic, Underline, Subscript, and Superscript","hi":"बोल्ड, इटैलिक, अंडरलाइन, सबस्क्रिप्ट और सुपरस्क्रिप्ट"},{"en":"New, Open, Save, Save As, Print, Share, Export, Close, Account, Feedback, and Options","hi":"New, Open, Save, Save As, Print, Share, Export, Close, Account, Feedback और Options जैसे बैकस्टेज कमांड्स"},{"en":"Margins, Orientation, Size, Columns, and Hyphenation","hi":"मार्जिन, ओरिएंटेशन, साइज़, कॉलम और हाइफ़नेशन"},{"en":"Track Changes, Thesaurus, Word Count, and Translate","hi":"ट्रैक चेंजेस, थिसॉरस, वर्ड काउंट और ट्रांसलेट"}],"exp":{"en":"Clicking the File tab opens the Backstage view, which contains file-management and application-level commands: New, Open, Save, Save As, Print, Share, Export, Close, Account, Feedback, and Options.","hi":"File टैब में New, Open, Save, Save As, Print, Share, Export, Close, Account, Feedback और Options जैसे बैकस्टेज (Backstage) कमांड्स मिलते हैं।"},"num":21},{"id":"q22","q":{"en":"Which command groups are located on the 'Home' tab in MS Word?","hi":"MS Word के 'Home' टैब में कौन-से कमांड ग्रुप्स (Groups) मिलते हैं?"},"a":{"en":"Clipboard, Font, Paragraph, Styles, and Editing","hi":"Clipboard, Font, Paragraph, Styles और Editing"},"o":[{"en":"Pages, Tables, Illustrations, Links, Header & Footer, Text, and Symbols","hi":"Pages, Tables, Illustrations, Links, Header & Footer, Text और Symbols"},{"en":"Clipboard, Font, Paragraph, Styles, and Editing","hi":"Clipboard, Font, Paragraph, Styles और Editing"},{"en":"Page Setup, Paragraph, and Arrange","hi":"Page Setup, Paragraph और Arrange"},{"en":"Proofing, Language, Comments, Tracking, and Changes","hi":"Proofing, Language, Comments, Tracking और Changes"}],"exp":{"en":"The Home tab in MS Word contains five core command groups arranged from left to right: Clipboard, Font, Paragraph, Styles, and Editing.","hi":"MS Word के Home टैब में पाँच मुख्य ग्रुप मिलते हैं: Clipboard, Font, Paragraph, Styles और Editing।"},"num":22},{"id":"q23","q":{"en":"What were the default font and font size in Word 2010 (and which font is used in newer Microsoft 365 default themes)?","hi":"Word 2010 में डिफ़ॉल्ट फ़ॉन्ट और फ़ॉन्ट आकार (Size) क्या थे (और नए Microsoft 365 में कौन-सा डिफ़ॉल्ट फ़ॉन्ट उपयोग हो सकता है)?"},"a":{"en":"Calibri, 11 pt (newer Microsoft 365 default theme can use Aptos)","hi":"Calibri, 11 pt (नए Microsoft 365 की डिफ़ॉल्ट थीम में Aptos का उपयोग हो सकता है)"},"o":[{"en":"Times New Roman, 12 pt (Comic Sans in Microsoft 365)","hi":"टाइम्स न्यू रोमन, 12 pt (Microsoft 365 में कॉमिक सैंस)"},{"en":"Calibri, 11 pt (newer Microsoft 365 default theme can use Aptos)","hi":"Calibri, 11 pt (नए Microsoft 365 की डिफ़ॉल्ट थीम में Aptos का उपयोग हो सकता है)"},{"en":"Arial, 10 pt (Courier New in Microsoft 365)","hi":"एरियल, 10 pt (Microsoft 365 में कूरियर न्यू)"},{"en":"Verdana, 14 pt (Impact in Microsoft 365)","hi":"वरदाना, 14 pt (Microsoft 365 में इम्पैक्ट)"}],"exp":{"en":"In Word 2010 (and Word 2007–2021), the default font was Calibri at 11 pt. Newer Microsoft 365 updates introduced Aptos as the default theme font.","hi":"Word 2010 में डिफ़ॉल्ट फ़ॉन्ट Calibri और साइज़ 11 pt था। नए Microsoft 365 की डिफ़ॉल्ट थीम में Aptos फ़ॉन्ट का उपयोग हो सकता है।"},"num":23},{"id":"q24","q":{"en":"What are the font-size limits in MS Word's dropdown list and manual entry?","hi":"MS Word के सोर्स नोट्स के अनुसार फ़ॉन्ट-आकार (Font-size) की सीमाएँ क्या हैं?"},"a":{"en":"Dropdown choices: 8 to 72 pt; Manual entry in desktop Word: 1 to 1638 pt","hi":"ड्रॉपडाउन विकल्प: 8 से 72 pt; डेस्कटॉप Word में मैन्युअल रूप से: 1 से 1638 pt"},"o":[{"en":"Dropdown choices: 8 to 72 pt; Manual entry in desktop Word: 1 to 1638 pt","hi":"ड्रॉपडाउन विकल्प: 8 से 72 pt; डेस्कटॉप Word में मैन्युअल रूप से: 1 से 1638 pt"},{"en":"Dropdown choices: 1 to 100 pt; Manual entry: 0 to 500 pt","hi":"ड्रॉपडाउन विकल्प: 1 से 100 pt; मैन्युअल रूप से: 0 से 500 pt"},{"en":"Dropdown choices: 10 to 48 pt; Manual entry: 5 to 1024 pt","hi":"ड्रॉपडाउन विकल्प: 10 से 48 pt; मैन्युअल रूप से: 5 से 1024 pt"},{"en":"Dropdown choices: 6 to 64 pt; Manual entry: 1 to 409 pt","hi":"ड्रॉपडाउन विकल्प: 6 से 64 pt; मैन्युअल रूप से: 1 से 409 pt"}],"exp":{"en":"In MS Word, the standard Font Size dropdown menu offers sizes from 8 pt to 72 pt, while typing a custom size manually in desktop Word supports 1 pt to 1638 pt.","hi":"Word में सामान्य ड्रॉपडाउन विकल्प 8 से 72 pt तक होते हैं, जबकि डेस्कटॉप Word मैन्युअल रूप से 1 से 1638 pt तक फ़ॉन्ट आकार की अनुमति देता है।"},"num":24},{"id":"q25","q":{"en":"Which option correctly lists the keyboard shortcuts for the four paragraph alignments in MS Word?","hi":"MS Word में चारों पैराग्राफ एलाइनमेंट (Paragraph alignments) के सही कीबोर्ड शॉर्टकट क्या हैं?"},"a":{"en":"Left: Ctrl+L, Center: Ctrl+E, Right: Ctrl+R, Justify: Ctrl+J","hi":"लेफ्ट: Ctrl+L, सेंटर: Ctrl+E, राइट: Ctrl+R, जस्टिफाई: Ctrl+J"},"o":[{"en":"Left: Ctrl+L, Center: Ctrl+C, Right: Ctrl+R, Justify: Ctrl+F","hi":"लेफ्ट: Ctrl+L, सेंटर: Ctrl+C, राइट: Ctrl+R, जस्टिफाई: Ctrl+F"},{"en":"Left: Ctrl+L, Center: Ctrl+E, Right: Ctrl+R, Justify: Ctrl+J","hi":"लेफ्ट: Ctrl+L, सेंटर: Ctrl+E, राइट: Ctrl+R, जस्टिफाई: Ctrl+J"},{"en":"Left: Alt+L, Center: Alt+C, Right: Alt+R, Justify: Alt+J","hi":"लेफ्ट: Alt+L, सेंटर: Alt+C, राइट: Alt+R, जस्टिफाई: Alt+J"},{"en":"Left: Ctrl+A, Center: Ctrl+M, Right: Ctrl+D, Justify: Ctrl+U","hi":"लेफ्ट: Ctrl+A, सेंटर: Ctrl+M, राइट: Ctrl+D, जस्टिफाई: Ctrl+U"}],"exp":{"en":"MS Word paragraph alignment shortcuts: Align Left = Ctrl+L, Center = Ctrl+E (since Ctrl+C is Copy), Align Right = Ctrl+R, and Justify = Ctrl+J.","hi":"Word में पैराग्राफ एलाइनमेंट के शॉर्टकट हैं: Left के लिए Ctrl+L, Center के लिए Ctrl+E, Right के लिए Ctrl+R और Justify के लिए Ctrl+J।"},"num":25},{"id":"q26","q":{"en":"Which elements can be added to a document using the 'Insert' tab in MS Word?","hi":"MS Word में 'Insert' टैब से डॉक्यूमेंट में क्या-क्या जोड़ा जा सकता है?"},"a":{"en":"Pages, tables, pictures, shapes, SmartArt, charts, add-ins, links, media, comments, header/footer, text box, Quick Parts, WordArt, Drop Cap, equation, and symbols","hi":"पेज, टेबल, पिक्चर, शेप्स, स्मार्टआर्ट, चार्ट, ऐड-इन्स, लिंक्स, मीडिया, कमेंट्स, हेडर/फुटर, टेक्स्ट बॉक्स, क्विक पार्ट्स, वर्डआर्ट, ड्रॉप कैप, इक्वेशन और सिंबल्स"},"o":[{"en":"Pages, tables, pictures, shapes, SmartArt, charts, add-ins, links, media, comments, header/footer, text box, Quick Parts, WordArt, Drop Cap, equation, and symbols","hi":"पेज, टेबल, पिक्चर, शेप्स, स्मार्टआर्ट, चार्ट, ऐड-इन्स, लिंक्स, मीडिया, कमेंट्स, हेडर/फुटर, टेक्स्ट बॉक्स, क्विक पार्ट्स, वर्डआर्ट, ड्रॉप कैप, इक्वेशन और सिंबल्स"},{"en":"Only margins, page orientation, and gutter settings","hi":"केवल मार्जिन, पेज ओरिएंटेशन और गटर सेटिंग्स"},{"en":"Only spell check, grammar check, and track changes","hi":"केवल स्पेल चेक, ग्रामर चेक और ट्रैक चेंजेस"},{"en":"Only mail merge recipients and address blocks","hi":"केवल मेल मर्ज प्राप्तकर्ता और एड्रेस ब्लॉक"}],"exp":{"en":"The Insert tab allows adding Pages (Cover Page, Blank Page, Page Break), Tables, Pictures, Shapes, SmartArt, Charts, Add-ins, Links, Media, Comments, Header/Footer/Page Number, Text Box, Quick Parts, WordArt, Drop Cap, Equations, and Symbols.","hi":"Insert टैब से Pages, tables, pictures, shapes, SmartArt, charts, add-ins, links, media, comments, header/footer, text box, Quick Parts, WordArt, Drop Cap, equation और symbols जोड़े जा सकते हैं।"},"num":26},{"id":"q27","q":{"en":"Where are the 'Header' and 'Footer' located on a page, and what information do they typically hold?","hi":"पेज पर 'हेडर' (Header) और 'फुटर' (Footer) कहाँ होते हैं और वे क्या दिखाते हैं?"},"a":{"en":"In the top and bottom regions of a page; they hold repeating details such as document title, page number, date, or time","hi":"पेज के ऊपरी (top) और निचले (bottom) क्षेत्रों में; वे शीर्षक (title), पेज नंबर, दिनांक या समय जैसे दोहराए जाने वाले विवरण रख सकते हैं"},"o":[{"en":"In the left and right margins; they hold only hidden VBA macro passwords","hi":"बाएँ और दाएँ मार्जिन में; वे केवल छिपे हुए VBA मैक्रो पासवर्ड रखते हैं"},{"en":"In the top and bottom regions of a page; they hold repeating details such as document title, page number, date, or time","hi":"पेज के ऊपरी (top) और निचले (bottom) क्षेत्रों में; वे शीर्षक (title), पेज नंबर, दिनांक या समय जैसे दोहराए जाने वाले विवरण रख सकते हैं"},{"en":"Only on the title bar of the operating system","hi":"केवल ऑपरेटिंग सिस्टम की टाइटल बार पर"},{"en":"Inside the Quick Access Toolbar dropdown menu","hi":"क्विक एक्सेस टूलबार के ड्रॉपडाउन मेनू के अंदर"}],"exp":{"en":"Headers and footers occupy the top and bottom margin regions of each page in a document and are used to display repeating metadata like chapter/document titles, page numbers, dates, or timestamps.","hi":"Header और Footer पेज के ऊपरी (top) और निचले (bottom) क्षेत्रों में होते हैं। इनमें टाइटल, पेज नंबर, तारीख (date) या समय (time) जैसे हर पेज पर दोहराए जाने वाले विवरण रखे जा सकते हैं।"},"num":27},{"id":"q28","q":{"en":"What is a 'Hyperlink' in MS Word and what is its keyboard shortcut?","hi":"MS Word में 'हाइपरलिंक' (Hyperlink) क्या होता है और इसका शॉर्टकट क्या है?"},"a":{"en":"Clickable text or image that navigates to a web page, file/document, or internal location; shortcut is Ctrl+K","hi":"क्लिक करने योग्य टेक्स्ट या इमेज जो किसी वेब पेज, डॉक्यूमेंट या आंतरिक स्थान (internal location) पर ले जा सकता है; शॉर्टकट Ctrl+K है"},"o":[{"en":"Clickable text or image that navigates to a web page, file/document, or internal location; shortcut is Ctrl+K","hi":"क्लिक करने योग्य टेक्स्ट या इमेज जो किसी वेब पेज, डॉक्यूमेंट या आंतरिक स्थान (internal location) पर ले जा सकता है; शॉर्टकट Ctrl+K है"},{"en":"An enlarged capital letter at the start of a paragraph; shortcut is Ctrl+D","hi":"पैराग्राफ की शुरुआत में एक बड़ा अक्षर; शॉर्टकट Ctrl+D है"},{"en":"A faint background image behind text; shortcut is Ctrl+W","hi":"टेक्स्ट के पीछे एक हल्की पृष्ठभूमि छवि; शॉर्टकट Ctrl+W है"},{"en":"An extra margin left for book binding; shortcut is Ctrl+H","hi":"बुक बाइंडिंग के लिए छोड़ा गया अतिरिक्त मार्जिन; शॉर्टकट Ctrl+H है"}],"exp":{"en":"A Hyperlink is clickable text or graphics that jumps to a web page (URL), an external file/document, an email address, or a bookmark/location within the same document. Its universal Office shortcut is Ctrl+K.","hi":"Hyperlink एक क्लिक करने योग्य (clickable) टेक्स्ट या इमेज है जो उपयोगकर्ता को किसी वेब पेज, डॉक्यूमेंट या आंतरिक लोकेशन पर ले जा सकता है। इसका शॉर्टकट Ctrl+K है।"},"num":28},{"id":"q29","q":{"en":"What is a 'Drop Cap' in MS Word and what are its available options?","hi":"MS Word में 'ड्रॉप कैप' (Drop Cap) क्या है और इसके विकल्प (Options) क्या हैं?"},"a":{"en":"An enlarged initial capital letter of a paragraph that extends down across multiple lines; options are None, Dropped, and In Margin","hi":"पैराग्राफ का बड़ा किया गया प्रारंभिक अक्षर, जो कई लाइनों तक नीचे फैलता है; इसके विकल्प None, Dropped और In Margin हैं"},"o":[{"en":"A tool that converts all text to lowercase; options are Small, Medium, and Large","hi":"सभी टेक्स्ट को लोअरकेस में बदलने वाला टूल; विकल्प Small, Medium और Large हैं"},{"en":"An enlarged initial capital letter of a paragraph that extends down across multiple lines; options are None, Dropped, and In Margin","hi":"पैराग्राफ का बड़ा किया गया प्रारंभिक अक्षर, जो कई लाइनों तक नीचे फैलता है; इसके विकल्प None, Dropped और In Margin हैं"},{"en":"A page break command; options are Top, Center, and Bottom","hi":"एक पेज ब्रेक कमांड; विकल्प Top, Center और Bottom हैं"},{"en":"A superscript math symbol; options are Left, Right, and Justify","hi":"एक सुपरस्क्रिप्ट गणित प्रतीक; विकल्प Left, Right और Justify हैं"}],"exp":{"en":"Drop Cap creates a decorative, enlarged initial letter at the beginning of a paragraph that drops down across multiple lines of text (3 lines by default). The Drop Cap menu offers three choices: None, Dropped, and In Margin.","hi":"Drop Cap किसी पैराग्राफ का बड़ा किया गया पहला अक्षर (enlarged initial letter) होता है, जो कई लाइनों तक विस्तारित होता है। इसके तीन विकल्प None, Dropped और In Margin हैं।"},"num":29},{"id":"q30","q":{"en":"What is the primary use of the 'Design' tab in MS Word?","hi":"MS Word में 'Design' टैब का मुख्य उपयोग क्या है?"},"a":{"en":"Setting document theme, colors, fonts, paragraph spacing, effects, and page background (including Watermark, Page Color, and Page Borders)","hi":"थीम, कलर्स, फ़ॉन्ट्स, पैराग्राफ स्पेसिंग, इफेक्ट्स और पेज बैकग्राउंड सेट करना (Page Color, Page Borders और Watermark यहीं मिलते हैं)"},"o":[{"en":"Setting document theme, colors, fonts, paragraph spacing, effects, and page background (including Watermark, Page Color, and Page Borders)","hi":"थीम, कलर्स, फ़ॉन्ट्स, पैराग्राफ स्पेसिंग, इफेक्ट्स और पेज बैकग्राउंड सेट करना (Page Color, Page Borders और Watermark यहीं मिलते हैं)"},{"en":"Connecting to an external SQL database for mail merge","hi":"मेल मर्ज के लिए बाहरी SQL डेटाबेस से जुड़ना"},{"en":"Checking spelling, grammar, and word count","hi":"स्पेलिंग, ग्रामर और वर्ड काउंट की जाँच करना"},{"en":"Splitting the window and recording VBA macros","hi":"विंडो को विभाजित करना और VBA मैक्रो रिकॉर्ड करना"}],"exp":{"en":"The Design tab controls document-wide formatting such as Themes, Colors, Fonts, Paragraph Spacing, Effects, and the Page Background group (Watermark, Page Color, and Page Borders).","hi":"Design टैब का उपयोग डॉक्यूमेंट की Theme, colors, fonts, paragraph spacing, effects और page background सेट करने के लिए होता है। Page Color, Page Borders और Watermark के विकल्प यहीं मिलते हैं।"},"num":30},{"id":"q31","q":{"en":"What is a 'Watermark' in MS Word?","hi":"MS Word में 'वॉटरमार्क' (Watermark) क्या होता है?"},"a":{"en":"Faint text or image that appears behind the main document content","hi":"हल्का (faint) टेक्स्ट या इमेज जो मुख्य डॉक्यूमेंट कंटेंट के पीछे दिखाई देता है"},"o":[{"en":"A bold red underline beneath misspelled words","hi":"गलत वर्तनी वाले शब्दों के नीचे एक गहरी लाल रेखा"},{"en":"Faint text or image that appears behind the main document content","hi":"हल्का (faint) टेक्स्ट या इमेज जो मुख्य डॉक्यूमेंट कंटेंट के पीछे दिखाई देता है"},{"en":"A hyperlink that opens an email client","hi":"एक हाइपरलिंक जो ईमेल क्लाइंट खोलता है"},{"en":"An encrypted password that locks the Ribbon","hi":"एक एन्क्रिप्टेड पासवर्ड जो रिबन को लॉक करता है"}],"exp":{"en":"A Watermark is a faint, semi-transparent text (such as 'CONFIDENTIAL' or 'DRAFT') or logo/image placed behind the main document text.","hi":"Watermark वह हल्का (faint) टेक्स्ट या इमेज है जो मुख्य डॉक्यूमेंट कंटेंट के पीछे (background में) दिखाई देता है।"},"num":31},{"id":"q32","q":{"en":"Which main commands are available under the 'Layout' (or Page Layout) tab in MS Word?","hi":"MS Word के 'Layout' (या Page Layout) टैब के मुख्य कमांड्स क्या हैं?"},"a":{"en":"Margins, Orientation, Size, Columns, Breaks, Line Numbers, Hyphenation, Indent, Spacing, and Arrange","hi":"Margins, Orientation, Size, Columns, Breaks, Line Numbers, Hyphenation, Indent, Spacing और Arrange"},"o":[{"en":"Margins, Orientation, Size, Columns, Breaks, Line Numbers, Hyphenation, Indent, Spacing, and Arrange","hi":"Margins, Orientation, Size, Columns, Breaks, Line Numbers, Hyphenation, Indent, Spacing और Arrange"},{"en":"Cut, Copy, Paste, Format Painter, and Replace","hi":"Cut, Copy, Paste, Format Painter और Replace"},{"en":"Subscript, Superscript, Strikethrough, and Text Highlight Color","hi":"Subscript, Superscript, Strikethrough और Text Highlight Color"},{"en":"Insert Citation, Bibliography, Cross-reference, and Index","hi":"Insert Citation, Bibliography, Cross-reference और Index"}],"exp":{"en":"The Layout tab houses Page Setup commands (Margins, Orientation, Size, Columns, Breaks, Line Numbers, Hyphenation), Paragraph layout controls (Indent, Spacing), and Arrange tools.","hi":"Layout टैब के मुख्य कमांड्स Margins, Orientation, Size, Columns, Breaks, Line Numbers, Hyphenation, Indent, Spacing और Arrange हैं।"},"num":32},{"id":"q33","q":{"en":"What is the difference between 'Portrait' and 'Landscape' page orientations?","hi":"'Portrait' और 'Landscape' पेज ओरिएंटेशन में क्या अंतर है?"},"a":{"en":"A Portrait page is taller than it is wide (vertical), whereas a Landscape page is wider than it is tall (horizontal)","hi":"Portrait पेज अधिक लंबा (tall/ऊर्ध्वाधर) होता है, जबकि Landscape पेज अधिक चौड़ा (wide/क्षैतिज) होता है"},"o":[{"en":"A Portrait page is taller than it is wide (vertical), whereas a Landscape page is wider than it is tall (horizontal)","hi":"Portrait पेज अधिक लंबा (tall/ऊर्ध्वाधर) होता है, जबकि Landscape पेज अधिक चौड़ा (wide/क्षैतिज) होता है"},{"en":"Portrait is used only for spreadsheets, and Landscape is used only for emails","hi":"Portrait केवल स्प्रेडशीट के लिए और Landscape केवल ईमेल के लिए उपयोग होता है"},{"en":"Portrait prints only in black and white, while Landscape prints in color","hi":"Portrait केवल ब्लैक एंड व्हाइट में प्रिंट करता है, जबकि Landscape रंगीन प्रिंट करता है"},{"en":"Portrait has no margins, whereas Landscape has 5-inch margins","hi":"Portrait में कोई मार्जिन नहीं होता, जबकि Landscape में 5-इंच का मार्जिन होता है"}],"exp":{"en":"In Portrait orientation (the default in MS Word), the page is oriented vertically (taller than wide). In Landscape orientation, the page is oriented horizontally (wider than tall).","hi":"Portrait ओरिएंटेशन में पेज अधिक लंबा (tall/वर्तिकल) होता है, जबकि Landscape ओरिएंटेशन में पेज अधिक चौड़ा (wide/हॉरिजॉन्टल) होता है।"},"num":33},{"id":"q34","q":{"en":"What is a 'Gutter Margin' in MS Word?","hi":"MS Word में 'गटर मार्जिन' (Gutter margin) क्या है?"},"a":{"en":"Extra margin space added to the side or top of a page to accommodate binding","hi":"बाइंडिंग (Binding) के लिए पेज के किनारे या ऊपर छोड़ा गया अतिरिक्त मार्जिन"},"o":[{"en":"The space between two adjacent words in a sentence","hi":"एक वाक्य में दो आसन्न शब्दों के बीच का स्थान"},{"en":"Extra margin space added to the side or top of a page to accommodate binding","hi":"बाइंडिंग (Binding) के लिए पेज के किनारे या ऊपर छोड़ा गया अतिरिक्त मार्जिन"},{"en":"The bottom area reserved exclusively for footnotes","hi":"विशेष रूप से फुटनोट्स के लिए आरक्षित निचला क्षेत्र"},{"en":"A margin that automatically deletes overflowing text","hi":"एक मार्जिन जो ओवरफ्लो होने वाले टेक्स्ट को स्वतः हटा देता है"}],"exp":{"en":"A Gutter margin adds extra white space to the side margin (left/inside) or top margin of a document to ensure that text is not obscured when pages are bound into a book or folder.","hi":"पेज की बाइंडिंग (Binding) के लिए छोड़े गए अतिरिक्त मार्जिन (extra margin) को गटर मार्जिन (Gutter margin) कहा जाता है।"},"num":34},{"id":"q35","q":{"en":"What is the difference between an 'Indent' and a 'Margin' in MS Word?","hi":"MS Word में 'इंडेंट' (Indent) और 'मार्जिन' (Margin) में क्या अंतर है?"},"a":{"en":"An Indent shifts a paragraph relative to the text boundaries, whereas a Margin sets the space between the page edge and the main content area","hi":"Indent किसी पैराग्राफ को टेक्स्ट सीमाओं (text boundaries) के सापेक्ष खिसकाता है, जबकि Margin पेज के किनारे (edge) और मुख्य कंटेंट क्षेत्र के बीच स्पेस सेट करता है"},"o":[{"en":"An Indent shifts a paragraph relative to the text boundaries, whereas a Margin sets the space between the page edge and the main content area","hi":"Indent किसी पैराग्राफ को टेक्स्ट सीमाओं (text boundaries) के सापेक्ष खिसकाता है, जबकि Margin पेज के किनारे (edge) और मुख्य कंटेंट क्षेत्र के बीच स्पेस सेट करता है"},{"en":"Indent applies to the entire printer tray, while Margin applies to a single character","hi":"Indent पूरे प्रिंटर ट्रे पर लागू होता है, जबकि Margin एक अक्षर पर लागू होता है"},{"en":"Margin shifts a single line, while Indent changes paper size from A4 to Legal","hi":"Margin एक लाइन को खिसकाता है, जबकि Indent पेपर का आकार A4 से Legal में बदलता है"},{"en":"There is no difference; both terms mean line spacing","hi":"कोई अंतर नहीं है; दोनों शब्दों का अर्थ लाइन स्पेसिंग है"}],"exp":{"en":"A Margin defines the overall whitespace between the physical edge of the page and the printable text area for the whole document/section, whereas an Indent shifts individual paragraphs inward or outward relative to those text boundaries.","hi":"Indent किसी पैराग्राफ को टेक्स्ट बाउंड्री के सापेक्ष (relative) शिफ्ट करता है, जबकि Margin पेज के बाहरी किनारे (edge) और कंटेंट एरिया के बीच की खाली जगह तय करता है।"},"num":35},{"id":"q36","q":{"en":"What does the 'Mail Merge' feature do in MS Word?","hi":"MS Word में 'मेल मर्ज' (Mail Merge) क्या कार्य करता है?"},"a":{"en":"It links a main document with a data source using merge fields to produce personalized letters, labels, or envelopes","hi":"यह मुख्य डॉक्यूमेंट (main document) और डेटा सोर्स (data source) को मर्ज फील्ड्स से जोड़कर व्यक्तिगत पत्र (letters), लेबल या लिफाफे (envelopes) बनाता है"},"o":[{"en":"It links a main document with a data source using merge fields to produce personalized letters, labels, or envelopes","hi":"यह मुख्य डॉक्यूमेंट (main document) और डेटा सोर्स (data source) को मर्ज फील्ड्स से जोड़कर व्यक्तिगत पत्र (letters), लेबल या लिफाफे (envelopes) बनाता है"},{"en":"It merges multiple PDF files into a single Excel chart","hi":"यह कई PDF फाइलों को एक एकल एक्सेल चार्ट में मर्ज करता है"},{"en":"It compresses audio and video files for email attachments","hi":"यह ईमेल अटैचमेंट के लिए ऑडियो और वीडियो फाइलों को कंप्रेस करता है"},{"en":"It checks grammar errors across different languages","hi":"यह विभिन्न भाषाओं में व्याकरण की त्रुटियों की जाँच करता है"}],"exp":{"en":"Mail Merge combines a standard template (Main Document) with a recipient list (Data Source, such as an Excel sheet or Access table) via Merge Fields to generate mass personalized letters, emails, envelopes, or mailing labels.","hi":"Mail Merge मुख्य डॉक्यूमेंट (main document) और डेटा सोर्स (data source) को मर्ज फील्ड्स (merge fields) से लिंक करके बड़ी संख्या में व्यक्तिगत पत्र (letters), लेबल या लिफाफे (envelopes) तैयार करता है।"},"num":36},{"id":"q37","q":{"en":"What is the typical step-by-step sequence of performing a Mail Merge in MS Word?","hi":"MS Word में मेल मर्ज (Mail Merge) करने का सामान्य क्रम (Typical order) क्या है?"},"a":{"en":"Start Mail Merge → Select Recipients → Insert Merge Fields → Preview Results → Finish & Merge","hi":"Start Mail Merge → Select Recipients → Insert Merge Fields → Preview Results → Finish & Merge"},"o":[{"en":"Finish & Merge → Preview Results → Select Recipients → Start Mail Merge","hi":"Finish & Merge → Preview Results → Select Recipients → Start Mail Merge"},{"en":"Start Mail Merge → Select Recipients → Insert Merge Fields → Preview Results → Finish & Merge","hi":"Start Mail Merge → Select Recipients → Insert Merge Fields → Preview Results → Finish & Merge"},{"en":"Insert Merge Fields → Start Mail Merge → Finish & Merge → Select Recipients","hi":"Insert Merge Fields → Start Mail Merge → Finish & Merge → Select Recipients"},{"en":"Preview Results → Start Mail Merge → Select Recipients → Finish & Merge","hi":"Preview Results → Start Mail Merge → Select Recipients → Finish & Merge"}],"exp":{"en":"The standard workflow on the Mailings tab follows five logical steps: Start Mail Merge → Select Recipients → Insert Merge Fields → Preview Results → Finish & Merge.","hi":"मेल मर्ज का सामान्य क्रम है: Start Mail Merge → Select Recipients → Insert Merge Fields → Preview Results → Finish & Merge।"},"num":37},{"id":"q38","q":{"en":"Which command groups are found under the 'Mailings' tab in MS Word?","hi":"MS Word के 'Mailings' टैब में कौन-से ग्रुप्स (Groups) मिलते हैं?"},"a":{"en":"Create, Start Mail Merge, Write & Insert Fields, Preview Results, and Finish","hi":"Create, Start Mail Merge, Write & Insert Fields, Preview Results और Finish"},"o":[{"en":"Create, Start Mail Merge, Write & Insert Fields, Preview Results, and Finish","hi":"Create, Start Mail Merge, Write & Insert Fields, Preview Results और Finish"},{"en":"Clipboard, Font, Paragraph, Styles, and Editing","hi":"Clipboard, Font, Paragraph, Styles और Editing"},{"en":"Views, Immersive, Page Movement, Show, Zoom, Window, and Macros","hi":"Views, Immersive, Page Movement, Show, Zoom, Window और Macros"},{"en":"Table of Contents, Footnotes, Citations & Bibliography, and Captions","hi":"Table of Contents, Footnotes, Citations & Bibliography और Captions"}],"exp":{"en":"The Mailings tab is organized into five groups from left to right: Create (Envelopes, Labels), Start Mail Merge, Write & Insert Fields, Preview Results, and Finish.","hi":"Mailings टैब में मिलने वाले मुख्य ग्रुप्स हैं: Create, Start Mail Merge, Write & Insert Fields, Preview Results और Finish।"},"num":38},{"id":"q39","q":{"en":"Which features and tools are available under the 'Review' tab in MS Word?","hi":"MS Word के 'Review' टैब में कौन-से फीचर्स मिलते हैं?"},"a":{"en":"Spelling & Grammar, Thesaurus, Translate, Research (legacy), Track Changes, Compare, and Protect/Restrict Editing","hi":"Spelling/Grammar, Thesaurus, Translate, Research (पुराने संस्करणों में), Track Changes, Compare और Protect/Restrict Editing"},"o":[{"en":"Spelling & Grammar, Thesaurus, Translate, Research (legacy), Track Changes, Compare, and Protect/Restrict Editing","hi":"Spelling/Grammar, Thesaurus, Translate, Research (पुराने संस्करणों में), Track Changes, Compare और Protect/Restrict Editing"},{"en":"Watermark, Page Color, Page Borders, and Document Themes","hi":"Watermark, Page Color, Page Borders और Document Themes"},{"en":"Cover Page, Blank Page, Page Break, Table, and SmartArt","hi":"Cover Page, Blank Page, Page Break, Table और SmartArt"},{"en":"Margins, Orientation, Size, Columns, and Hyphenation","hi":"Margins, Orientation, Size, Columns और Hyphenation"}],"exp":{"en":"The Review tab provides proofing, language, tracking, and security tools: Spelling & Grammar, Thesaurus, Word Count, Translate, Research (in legacy versions), Comments, Track Changes, Compare, and Protect/Restrict Editing.","hi":"Review टैब में Spelling/Grammar, Thesaurus, Translate, Research (लीगेसी), Track Changes, Compare और Protect/Restrict Editing जैसे फीचर्स मिलते हैं।"},"num":39},{"id":"q40","q":{"en":"What are the respective uses of 'Thesaurus' and 'Track Changes' in MS Word?","hi":"MS Word में 'थिसॉरस' (Thesaurus) और 'ट्रैक चेंजेस' (Track Changes) का उपयोग किसलिए होता है?"},"a":{"en":"Thesaurus suggests synonyms (and antonyms) for a selected word; Track Changes records all edits made to a document so they can be reviewed, accepted, or rejected","hi":"Thesaurus पर्यायवाची शब्द (synonyms) सुझाता है; Track Changes डॉक्यूमेंट में किए गए बदलावों (edits) को रिकॉर्ड करता है ताकि उनकी समीक्षा की जा सके"},"o":[{"en":"Thesaurus inserts page numbers; Track Changes counts total paragraphs","hi":"Thesaurus पेज नंबर डालता है; Track Changes कुल पैराग्राफ गिनता है"},{"en":"Thesaurus suggests synonyms (and antonyms) for a selected word; Track Changes records all edits made to a document so they can be reviewed, accepted, or rejected","hi":"Thesaurus पर्यायवाची शब्द (synonyms) सुझाता है; Track Changes डॉक्यूमेंट में किए गए बदलावों (edits) को रिकॉर्ड करता है ताकि उनकी समीक्षा की जा सके"},{"en":"Thesaurus translates whole files into binary; Track Changes deletes old versions","hi":"Thesaurus पूरी फाइलों को बाइनरी में अनुवादित करता है; Track Changes पुराने संस्करणों को हटा देता है"},{"en":"Thesaurus creates table borders; Track Changes adjusts zoom magnification","hi":"Thesaurus टेबल बॉर्डर बनाता है; Track Changes ज़ूम आवर्धन को समायोजित करता है"}],"exp":{"en":"In MS Word, the Thesaurus tool (Shift+F7) suggests synonyms and related words, while Track Changes (Ctrl+Shift+E) logs insertions, deletions, and formatting edits for collaborative review.","hi":"Thesaurus चयनित शब्द के लिए पर्यायवाची शब्द (synonyms) सुझाता है, जबकि Track Changes डॉक्यूमेंट में किए गए सभी संपादनों (edits) को रिकॉर्ड करता है ताकि बाद में उन्हें रिव्यू (स्वीकार या अस्वीकार) किया जा सके।"},"num":40},{"id":"q41","q":{"en":"Which options and tools are available under the 'View' tab in MS Word?","hi":"MS Word के 'View' टैब से कौन-से विकल्प (Options) मिलते हैं?"},"a":{"en":"Print Layout, Read Mode/Full Screen Reading, Web Layout, Outline, Draft, Page Movement, Show, Zoom, Window tools, and Macros","hi":"Print Layout, Read Mode/Full Screen Reading, Web Layout, Outline, Draft, Page Movement, Show, Zoom, Window टूल्स और Macros"},"o":[{"en":"Print Layout, Read Mode/Full Screen Reading, Web Layout, Outline, Draft, Page Movement, Show, Zoom, Window tools, and Macros","hi":"Print Layout, Read Mode/Full Screen Reading, Web Layout, Outline, Draft, Page Movement, Show, Zoom, Window टूल्स और Macros"},{"en":"Spelling & Grammar, Thesaurus, Word Count, and Track Changes","hi":"Spelling & Grammar, Thesaurus, Word Count और Track Changes"},{"en":"Margins, Orientation, Size, Columns, and Gutter","hi":"Margins, Orientation, Size, Columns और Gutter"},{"en":"Table of Contents, Insert Footnote, Citations, and Captions","hi":"Table of Contents, Insert Footnote, Citations और Captions"}],"exp":{"en":"The View tab in MS Word provides document view modes (Print Layout, Read Mode/Full Screen Reading, Web Layout, Outline, Draft), Page Movement, Show (Ruler, Gridlines, Navigation Pane), Zoom controls, Window management tools, and Macros.","hi":"View टैब से Print Layout, Read Mode/Full Screen Reading, Web Layout, Outline, Draft, Page Movement, Show, Zoom, Window टूल्स और Macros के विकल्प मिलते हैं।"},"num":41},{"id":"q42","q":{"en":"Which commands are found inside the 'Window' group of the View tab in MS Word?","hi":"MS Word में View टैब के 'Window' ग्रुप में क्या विकल्प मिल सकते हैं?"},"a":{"en":"New Window, Arrange All, Split, and Switch Windows","hi":"New Window, Arrange All, Split और Switch Windows"},"o":[{"en":"New Window, Arrange All, Split, and Switch Windows","hi":"New Window, Arrange All, Split और Switch Windows"},{"en":"Cut, Copy, Paste, and Format Painter","hi":"Cut, Copy, Paste और Format Painter"},{"en":"Header, Footer, Page Number, and Drop Cap","hi":"Header, Footer, Page Number और Drop Cap"},{"en":"Start Mail Merge, Select Recipients, and Finish","hi":"Start Mail Merge, Select Recipients और Finish"}],"exp":{"en":"The Window group on the View tab contains commands for managing open document windows: New Window, Arrange All, Split (dividing the document into two scrollable panes), and Switch Windows.","hi":"View टैब के Window ग्रुप में New Window, Arrange All, Split और Switch Windows के विकल्प मिलते हैं।"},"num":42},{"id":"q43","q":{"en":"What is a 'Macro' in Microsoft Office?","hi":"माइक्रोसॉफ्ट ऑफिस में 'मैक्रो' (Macro) क्या होता है?"},"a":{"en":"Recorded commands or VBA (Visual Basic for Applications) code that automate repeated tasks","hi":"रिकॉर्ड किए गए कमांड्स या VBA कोड जो बार-बार किए जाने वाले कार्यों (repeated tasks) को स्वचालित (automate) करते हैं"},"o":[{"en":"A hardware scanner used for reading barcodes","hi":"बारकोड पढ़ने के लिए उपयोग किया जाने वाला एक हार्डवेयर स्कैनर"},{"en":"Recorded commands or VBA (Visual Basic for Applications) code that automate repeated tasks","hi":"रिकॉर्ड किए गए कमांड्स या VBA कोड जो बार-बार किए जाने वाले कार्यों (repeated tasks) को स्वचालित (automate) करते हैं"},{"en":"A faint background watermark placed behind text","hi":"टेक्स्ट के पीछे लगाया गया एक हल्का बैकग्राउंड वॉटरमार्क"},{"en":"An extra margin reserved for spiral binding","hi":"स्पाइरल बाइंडिंग के लिए आरक्षित एक अतिरिक्त मार्जिन"}],"exp":{"en":"A Macro is a saved sequence of recorded keystrokes/commands or Visual Basic for Applications (VBA) code used to automate repetitive tasks in Word, Excel, and other Office apps.","hi":"Macro रिकॉर्ड किए गए कमांड्स या VBA (Visual Basic for Applications) कोड होते हैं जो बार-बार दोहराए जाने वाले कार्यों (repeated tasks) को ऑटोमेट (स्वचालित) करते हैं।"},"num":43},{"id":"q44","q":{"en":"What is the classic role of 'Windows Disk Defragmenter' (and how does SSD optimization differ)?","hi":"'Windows Disk Defragmenter' की क्लासिक भूमिका क्या है (और SSD ऑप्टिमाइजेशन इससे कैसे भिन्न है)?"},"a":{"en":"Reorganizing fragmented data on an HDD to improve access speed (while SSD optimization uses different mechanisms like TRIM)","hi":"HDD पर बिखरे हुए (fragmented) डेटा को पुनर्व्यवस्थित करके एक्सेस सुधारना (जबकि SSD ऑप्टिमाइजेशन में TRIM जैसे अलग तंत्र उपयोग हो सकते हैं)"},"o":[{"en":"Reorganizing fragmented data on an HDD to improve access speed (while SSD optimization uses different mechanisms like TRIM)","hi":"HDD पर बिखरे हुए (fragmented) डेटा को पुनर्व्यवस्थित करके एक्सेस सुधारना (जबकि SSD ऑप्टिमाइजेशन में TRIM जैसे अलग तंत्र उपयोग हो सकते हैं)"},{"en":"Encrypting Word documents with a 256-bit password","hi":"256-बिट पासवर्ड के साथ Word डॉक्यूमेंट्स को एन्क्रिप्ट करना"},{"en":"Deleting all system fonts to save RAM capacity","hi":"RAM क्षमता बचाने के लिए सभी सिस्टम फ़ॉन्ट्स को हटाना"},{"en":"Converting analog audio signals into digital MIDI tracks","hi":"एनालॉग ऑडियो सिग्नलों को डिजिटल MIDI ट्रैक में बदलना"}],"exp":{"en":"Windows Disk Defragmenter classically rearranges fragmented files into contiguous blocks on mechanical Hard Disk Drives (HDDs) to speed up read/write access, whereas Solid State Drives (SSDs) use different optimization mechanisms such as TRIM.","hi":"Windows Disk Defragmenter का मुख्य कार्य HDD पर बिखरे (fragmented) डेटा को पुनर्व्यवस्थित करके डेटा एक्सेस में सुधार करना है। SSD ऑप्टिमाइजेशन में TRIM जैसे अलग मैकेनिज्म का उपयोग होता है।"},"num":44},{"id":"q45","q":{"en":"What is the zoom range of MS Word 2010 according to the source notes?","hi":"सोर्स नोट्स के अनुसार MS Word 2010 की ज़ूम रेंज (Zoom Range) क्या है?"},"a":{"en":"10% to 500%","hi":"10% से 500%"},"o":[{"en":"10% to 400%","hi":"10% से 400%"},{"en":"10% to 500%","hi":"10% से 500%"},{"en":"20% to 1000%","hi":"20% से 1000%"},{"en":"50% to 200%","hi":"50% से 200%"}],"exp":{"en":"In MS Word (including Word 2010), the minimum zoom magnification is 10% and the maximum zoom magnification is 500% (whereas Excel and PowerPoint typically max out at 400%).","hi":"MS Word 2010 में ज़ूम रेंज न्यूनतम 10% से अधिकतम 500% तक होती है।"},"num":45},{"id":"q46","q":{"en":"What does the exam fact '63 columns' refer to in an MS Word table (and what is noted about rows)?","hi":"MS Word टेबल में '63 कॉलम' (63 columns) का परीक्षा तथ्य किस बारे में है?"},"a":{"en":"The maximum number of columns in a single Word table is 63 (rows are described as unlimited on the slide, subject to overall table/document size limits)","hi":"एक Word टेबल में अधिकतम 63 कॉलम हो सकते हैं (स्लाइड में पंक्तियों/rows को असीमित कहा गया है, लेकिन टेबल/डॉक्यूमेंट के आकार पर एप्लिकेशन सीमाएँ लागू होती हैं)"},"o":[{"en":"The maximum number of columns in a single Word table is 63 (rows are described as unlimited on the slide, subject to overall table/document size limits)","hi":"एक Word टेबल में अधिकतम 63 कॉलम हो सकते हैं (स्लाइड में पंक्तियों/rows को असीमित कहा गया है, लेकिन टेबल/डॉक्यूमेंट के आकार पर एप्लिकेशन सीमाएँ लागू होती हैं)"},{"en":"The minimum number of columns required to create a table in Word is 63","hi":"Word में टेबल बनाने के लिए आवश्यक न्यूनतम कॉलम 63 हैं"},{"en":"Word allows a maximum of 63 rows and only 5 columns","hi":"Word अधिकतम 63 पंक्तियों और केवल 5 कॉलम की अनुमति देता है"},{"en":"A Word document can contain at most 63 words per page","hi":"एक Word डॉक्यूमेंट में प्रति पेज अधिकतम 63 शब्द हो सकते हैं"}],"exp":{"en":"In MS Word, the maximum number of columns allowed in a single table is 63. While standard notes/slides often state rows are 'unlimited', practical application/document memory limits (such as 32,767 rows) apply.","hi":"एक MS Word टेबल में अधिकतम 63 कॉलम (columns) हो सकते हैं। नोट्स की स्लाइड में पंक्तियों (rows) को असीमित कहा गया है, हालांकि टेबल/डॉक्यूमेंट के आकार पर एप्लिकेशन सीमाएँ लागू होती हैं।"},"num":46},{"id":"q47","q":{"en":"What is the fundamental difference between 'Editing' and 'Formatting' a document?","hi":"किसी डॉक्यूमेंट में 'एडिटिंग' (Editing) और 'फॉर्मेटिंग' (Formatting) में क्या अंतर है?"},"a":{"en":"Editing changes the actual content/text, whereas Formatting changes its visual appearance","hi":"Editing डॉक्यूमेंट के कंटेंट (सामग्री) को बदलती है, जबकि Formatting उसके दिखने के रूप (appearance) को बदलती है"},"o":[{"en":"Editing changes the actual content/text, whereas Formatting changes its visual appearance","hi":"Editing डॉक्यूमेंट के कंटेंट (सामग्री) को बदलती है, जबकि Formatting उसके दिखने के रूप (appearance) को बदलती है"},{"en":"Editing changes font color, whereas Formatting deletes paragraphs","hi":"Editing फ़ॉन्ट का रंग बदलती है, जबकि Formatting पैराग्राफ को हटाती है"},{"en":"Editing prints the document, while Formatting sends it via email","hi":"Editing डॉक्यूमेंट को प्रिंट करती है, जबकि Formatting उसे ईमेल द्वारा भेजती है"},{"en":"Both terms mean saving the file to a flash drive","hi":"दोनों शब्दों का अर्थ फाइल को फ्लैश ड्राइव में सेव करना है"}],"exp":{"en":"Editing involves modifying, inserting, deleting, or correcting the actual text/content of a document, whereas Formatting alters the visual presentation and appearance (such as font style, size, color, alignment, and margins).","hi":"Editing डॉक्यूमेंट के वास्तविक कंटेंट (शब्दों/वाक्यों) में बदलाव करती है, जबकि Formatting उसके बाहरी रूप या दिखावट (appearance) को बदलती है।"},"num":47}]},{"title":{"en":"3. Word Editing, Formatting & Ribbon Shortcuts","hi":"3. वर्ड एडिटिंग, फॉर्मेटिंग और रिबन शॉर्टकट"},"questions":[{"id":"q48","q":{"en":"Which keyboard shortcuts are used in MS Word to create a New document, Open, Save, Print, and Close the current document?","hi":"MS Word में नया डॉक्यूमेंट बनाने (New), खोलने (Open), सेव करने (Save), प्रिंट करने (Print) और बंद करने (Close) के शॉर्टकट क्या हैं?"},"a":{"en":"Ctrl+N (New), Ctrl+O (Open), Ctrl+S (Save), Ctrl+P (Print), and Ctrl+W or Ctrl+F4 (Close)","hi":"Ctrl+N, Ctrl+O, Ctrl+S, Ctrl+P और Ctrl+W (Ctrl+F4 भी वर्तमान डॉक्यूमेंट को बंद करता है)"},"o":[{"en":"Ctrl+N (New), Ctrl+O (Open), Ctrl+S (Save), Ctrl+P (Print), and Ctrl+W or Ctrl+F4 (Close)","hi":"Ctrl+N, Ctrl+O, Ctrl+S, Ctrl+P और Ctrl+W (Ctrl+F4 भी वर्तमान डॉक्यूमेंट को बंद करता है)"},{"en":"Alt+N, Alt+O, Alt+S, Alt+P, and Alt+W","hi":"Alt+N, Alt+O, Alt+S, Alt+P और Alt+W"},{"en":"Ctrl+M, Ctrl+D, Ctrl+A, Ctrl+K, and Ctrl+Q","hi":"Ctrl+M, Ctrl+D, Ctrl+A, Ctrl+K और Ctrl+Q"},{"en":"Shift+N, Shift+O, Shift+S, Shift+P, and Shift+W","hi":"Shift+N, Shift+O, Shift+S, Shift+P और Shift+W"}],"exp":{"en":"Standard file operation shortcuts in MS Word: Ctrl+N creates a new document, Ctrl+O opens an existing document, Ctrl+S saves, Ctrl+P opens Print, and Ctrl+W (or Ctrl+F4) closes the active document window.","hi":"Word में New के लिए Ctrl+N, Open के लिए Ctrl+O, Save के लिए Ctrl+S, Print के लिए Ctrl+P और Close के लिए Ctrl+W (या Ctrl+F4) शॉर्टकट का उपयोग होता है।"},"num":48},{"id":"q49","q":{"en":"What are the universal keyboard shortcuts for Select All, Cut, Copy, and Paste respectively?","hi":"Select All, Cut, Copy और Paste के लिए क्रमशः कीबोर्ड शॉर्टकट क्या हैं?"},"a":{"en":"Ctrl+A, Ctrl+X, Ctrl+C, and Ctrl+V","hi":"Ctrl+A, Ctrl+X, Ctrl+C और Ctrl+V"},"o":[{"en":"Ctrl+S, Ctrl+X, Ctrl+C, and Ctrl+P","hi":"Ctrl+S, Ctrl+X, Ctrl+C और Ctrl+P"},{"en":"Ctrl+A, Ctrl+X, Ctrl+C, and Ctrl+V","hi":"Ctrl+A, Ctrl+X, Ctrl+C और Ctrl+V"},{"en":"Ctrl+A, Ctrl+D, Ctrl+C, and Ctrl+B","hi":"Ctrl+A, Ctrl+D, Ctrl+C और Ctrl+B"},{"en":"Alt+A, Alt+X, Alt+C, and Alt+V","hi":"Alt+A, Alt+X, Alt+C और Alt+V"}],"exp":{"en":"Across MS Word and Windows: Ctrl+A selects all content, Ctrl+X cuts the selection to the clipboard, Ctrl+C copies the selection, and Ctrl+V pastes the clipboard content.","hi":"Select all के लिए Ctrl+A, Cut के लिए Ctrl+X, Copy के लिए Ctrl+C और Paste के लिए Ctrl+V शॉर्टकट का उपयोग किया जाता है।"},"num":49},{"id":"q50","q":{"en":"Which keys are used for Undo, Redo, and Cancel command respectively in MS Word?","hi":"MS Word में Undo, Redo और किसी कमांड को Cancel करने की कुंजियाँ (Keys) क्रमशः क्या हैं?"},"a":{"en":"Ctrl+Z, Ctrl+Y, and Esc","hi":"Ctrl+Z, Ctrl+Y और Esc"},"o":[{"en":"Ctrl+U, Ctrl+R, and Backspace","hi":"Ctrl+U, Ctrl+R और Backspace"},{"en":"Ctrl+Z, Ctrl+Y, and Esc","hi":"Ctrl+Z, Ctrl+Y और Esc"},{"en":"Ctrl+X, Ctrl+Z, and Delete","hi":"Ctrl+X, Ctrl+Z और Delete"},{"en":"Alt+Z, Alt+Y, and Tab","hi":"Alt+Z, Alt+Y और Tab"}],"exp":{"en":"In MS Word, Ctrl+Z reverses (undoes) the last action, Ctrl+Y repeats or redoes the action, and the Esc key cancels an active dialog, menu, or command.","hi":"Undo के लिए Ctrl+Z, Redo के लिए Ctrl+Y और कमांड रद्द (Cancel) करने के लिए Esc कुंजी का उपयोग होता है।"},"num":50},{"id":"q51","q":{"en":"What are the MS Word shortcuts for Bold, Italic, Underline, and 'Word-Only Underline' (excluding spaces)?","hi":"MS Word में Bold, Italic, Underline और 'केवल शब्दों को अंडरलाइन' (Words-only underline) करने के शॉर्टकट क्या हैं?"},"a":{"en":"Ctrl+B (Bold), Ctrl+I (Italic), Ctrl+U (Underline), and Ctrl+Shift+W (underline words only)","hi":"Ctrl+B, Ctrl+I और Ctrl+U; जबकि Ctrl+Shift+W केवल शब्दों (words) को अंडरलाइन करता है"},"o":[{"en":"Ctrl+B (Bold), Ctrl+I (Italic), Ctrl+U (Underline), and Ctrl+Shift+W (underline words only)","hi":"Ctrl+B, Ctrl+I और Ctrl+U; जबकि Ctrl+Shift+W केवल शब्दों (words) को अंडरलाइन करता है"},{"en":"Ctrl+B, Ctrl+T, Ctrl+L, and Ctrl+Alt+W","hi":"Ctrl+B, Ctrl+T, Ctrl+L और Ctrl+Alt+W"},{"en":"Alt+B, Alt+I, Alt+U, and Alt+W","hi":"Alt+B, Alt+I, Alt+U और Alt+W"},{"en":"Ctrl+1, Ctrl+2, Ctrl+3, and Ctrl+4","hi":"Ctrl+1, Ctrl+2, Ctrl+3 और Ctrl+4"}],"exp":{"en":"Ctrl+B applies Bold, Ctrl+I applies Italic, and Ctrl+U underlines both words and spaces. Pressing Ctrl+Shift+W applies 'Words Only' underline (skipping spaces between words).","hi":"Bold के लिए Ctrl+B, Italic के लिए Ctrl+I और Underline के लिए Ctrl+U का उपयोग होता है। Ctrl+Shift+W स्पेस को छोड़कर केवल शब्दों (words) को अंडरलाइन करता है।"},"num":51},{"id":"q52","q":{"en":"What are the MS Word keyboard shortcuts for Find, Replace, and Go To?","hi":"MS Word में Find, Replace और Go To के शॉर्टकट क्या हैं?"},"a":{"en":"Ctrl+F (Find), Ctrl+H (Replace), and Ctrl+G or F5 (Go To)","hi":"Ctrl+F, Ctrl+H और Ctrl+G (F5 कुंजी भी Go To डायलॉग खोलती है)"},"o":[{"en":"Ctrl+F (Find), Ctrl+R (Replace), and Ctrl+T (Go To)","hi":"Ctrl+F, Ctrl+R और Ctrl+T"},{"en":"Ctrl+F (Find), Ctrl+H (Replace), and Ctrl+G or F5 (Go To)","hi":"Ctrl+F, Ctrl+H और Ctrl+G (F5 कुंजी भी Go To डायलॉग खोलती है)"},{"en":"Ctrl+S (Find), Ctrl+H (Replace), and Ctrl+J (Go To)","hi":"Ctrl+S, Ctrl+H और Ctrl+J"},{"en":"Alt+F (Find), Alt+R (Replace), and Alt+G (Go To)","hi":"Alt+F, Alt+R और Alt+G"}],"exp":{"en":"In MS Word, Ctrl+F opens Find/Navigation, Ctrl+H opens the Replace tab of the Find and Replace dialog, and both Ctrl+G and F5 open the Go To tab.","hi":"Word में Find के लिए Ctrl+F, Replace के लिए Ctrl+H और Go To के लिए Ctrl+G (तथा F5 कुंजी भी Go To डायलॉग खोलती है) का उपयोग होता है।"},"num":52},{"id":"q53","q":{"en":"Which shortcuts open the Font dialog/controls and increase or decrease font size in MS Word?","hi":"MS Word में Font डायलॉग खोलने और फ़ॉन्ट आकार (Font-size) बढ़ाने/घटाने के शॉर्टकट क्या हैं?"},"a":{"en":"Ctrl+D or Ctrl+Shift+F opens Font controls; Ctrl+] / Ctrl+[ changes size by 1 pt; Ctrl+Shift+> / Ctrl+Shift+< changes size in preset dropdown steps / Ctrl+D या Ctrl+Shift+F फ़ॉन्ट कंट्रोल खोलते हैं; Ctrl+] / Ctrl+[ साइज़ 1 pt बढ़ाते/घटाते हैं; Ctrl+Shift+>","hi":"Ctrl+Shift+< प्रीसेट स्टेप्स में साइज़ बदलते हैं"},"o":[{"en":"Ctrl+D or Ctrl+Shift+F opens Font controls; Ctrl+] / Ctrl+[ changes size by 1 pt; Ctrl+Shift+> / Ctrl+Shift+< changes size in preset dropdown steps / Ctrl+D या Ctrl+Shift+F फ़ॉन्ट कंट्रोल खोलते हैं; Ctrl+] / Ctrl+[ साइज़ 1 pt बढ़ाते/घटाते हैं; Ctrl+Shift+>","hi":"Ctrl+Shift+< प्रीसेट स्टेप्स में साइज़ बदलते हैं"},{"en":"Ctrl+F opens Font dialog; Ctrl+Up / Ctrl+Down changes size by 5 pt / Ctrl+F फ़ॉन्ट डायलॉग खोलता है; Ctrl+Up","hi":"Ctrl+Down साइज़ 5 pt बदलते हैं"},{"en":"Alt+D opens Font dialog; Ctrl++ / Ctrl+- changes size by 10 pt / Alt+D फ़ॉन्ट डायलॉग खोलता है; Ctrl++","hi":"Ctrl+- साइज़ 10 pt बदलते हैं"},{"en":"Ctrl+G opens Font dialog; Shift+F3 changes font size","hi":"Ctrl+G फ़ॉन्ट डायलॉग खोलता है; Shift+F3 फ़ॉन्ट साइज़ बदलता है"}],"exp":{"en":"In MS Word, Ctrl+D or Ctrl+Shift+F opens the Font dialog box. Ctrl+] increases and Ctrl+[ decreases font size by exactly 1 point, whereas Ctrl+Shift+> and Ctrl+Shift+< increase/decrease font size according to the preset dropdown steps (e.g., 8, 9, 10, 11, 12, 14...).","hi":"Ctrl+D या Ctrl+Shift+F फ़ॉन्ट कंट्रोल्स खोलते हैं। Ctrl+] और Ctrl+[ फ़ॉन्ट साइज़ को 1 pt बढ़ाते/घटाते हैं, जबकि Ctrl+Shift+> और Ctrl+Shift+< प्रीसेट ड्रॉपडाउन स्टेप्स में साइज़ बदलते हैं।"},"num":53},{"id":"q54","q":{"en":"What are the keyboard shortcuts in MS Word for Single, Double, and 1.5 line spacing respectively?","hi":"MS Word में सिंगल (Single), डबल (Double) और 1.5 लाइन स्पेसिंग के शॉर्टकट क्रमशः क्या हैं?"},"a":{"en":"Ctrl+1, Ctrl+2, and Ctrl+5","hi":"Ctrl+1, Ctrl+2 और Ctrl+5"},"o":[{"en":"Ctrl+1, Ctrl+2, and Ctrl+5","hi":"Ctrl+1, Ctrl+2 और Ctrl+5"},{"en":"Ctrl+1, Ctrl+2, and Ctrl+1.5","hi":"Ctrl+1, Ctrl+2 और Ctrl+1.5"},{"en":"Alt+1, Alt+2, and Alt+5","hi":"Alt+1, Alt+2 और Alt+5"},{"en":"Ctrl+F1, Ctrl+F2, and Ctrl+F5","hi":"Ctrl+F1, Ctrl+F2 और Ctrl+F5"}],"exp":{"en":"In MS Word, pressing Ctrl+1 sets single line spacing, Ctrl+2 sets double line spacing, and Ctrl+5 sets 1.5-line spacing for the selected paragraph(s).","hi":"MS Word में Single लाइन स्पेसिंग के लिए Ctrl+1, Double लाइन स्पेसिंग के लिए Ctrl+2 और 1.5 लाइन स्पेसिंग के लिए Ctrl+5 शॉर्टकट है।"},"num":54},{"id":"q55","q":{"en":"Which shortcut adds or removes space before a paragraph in desktop MS Word?","hi":"डेस्कटॉप MS Word में किसी पैराग्राफ के पहले स्पेस जोड़ने या हटाने (Add/remove space before paragraph) का शॉर्टकट क्या है?"},"a":{"en":"Ctrl+0 (Zero)","hi":"Ctrl+0 (शून्य)"},"o":[{"en":"Ctrl+0 (Zero)","hi":"Ctrl+0 (शून्य)"},{"en":"Ctrl+9","hi":"Ctrl+9"},{"en":"Ctrl+Spacebar","hi":"Ctrl+Spacebar"},{"en":"Alt+Enter","hi":"Alt+Enter"}],"exp":{"en":"In desktop MS Word, pressing Ctrl+0 (zero) toggles (adds or removes) one line of spacing (12 pt) before the current paragraph.","hi":"डेस्कटॉप Word शॉर्टकट संदर्भ में, पैराग्राफ के पहले स्पेस जोड़ने या हटाने का शॉर्टकट Ctrl+0 है।"},"num":55},{"id":"q56","q":{"en":"Which shortcuts control Paragraph Indent and Hanging Indent (and reducing them) in MS Word?","hi":"MS Word में पैराग्राफ इंडेंट (Paragraph indent) और हैंगिंग इंडेंट (Hanging indent) तथा उन्हें कम करने के शॉर्टकट क्या हैं?"},"a":{"en":"Ctrl+M indents paragraph (Ctrl+Shift+M reduces); Ctrl+T creates hanging indent (Ctrl+Shift+T reduces)","hi":"Ctrl+M पैराग्राफ इंडेंट करता है (Ctrl+Shift+M घटाता है); Ctrl+T हैंगिंग इंडेंट बनाता है (Ctrl+Shift+T घटाता है)"},"o":[{"en":"Ctrl+M indents paragraph (Ctrl+Shift+M reduces); Ctrl+T creates hanging indent (Ctrl+Shift+T reduces)","hi":"Ctrl+M पैराग्राफ इंडेंट करता है (Ctrl+Shift+M घटाता है); Ctrl+T हैंगिंग इंडेंट बनाता है (Ctrl+Shift+T घटाता है)"},{"en":"Ctrl+I indents paragraph; Ctrl+H creates hanging indent","hi":"Ctrl+I पैराग्राफ इंडेंट करता है; Ctrl+H हैंगिंग इंडेंट बनाता है"},{"en":"Ctrl+P indents paragraph; Ctrl+G creates hanging indent","hi":"Ctrl+P पैराग्राफ इंडेंट करता है; Ctrl+G हैंगिंग इंडेंट बनाता है"},{"en":"Alt+M indents paragraph; Alt+T creates hanging indent","hi":"Alt+M पैराग्राफ इंडेंट करता है; Alt+T हैंगिंग इंडेंट बनाता है"}],"exp":{"en":"In MS Word, Ctrl+M increases left paragraph indent and Ctrl+Shift+M decreases it; Ctrl+T creates a hanging indent (indenting all lines except the first) and Ctrl+Shift+T reduces it.","hi":"Ctrl+M पैराग्राफ इंडेंट बढ़ाता है और Ctrl+Shift+M उसे कम करता है। Ctrl+T हैंगिंग इंडेंट लगाता है और Ctrl+Shift+T उसे कम करता है।"},"num":56},{"id":"q57","q":{"en":"How do you clear paragraph formatting versus direct character formatting using keyboard shortcuts in MS Word?","hi":"MS Word में पैराग्राफ फॉर्मेटिंग या डायरेक्ट कैरेक्टर फॉर्मेटिंग को क्लियर (Clear) करने के शॉर्टकट क्या हैं?"},"a":{"en":"Ctrl+Q clears paragraph formatting; Ctrl+Spacebar clears direct character formatting","hi":"Ctrl+Q पैराग्राफ फॉर्मेटिंग क्लियर करता है; Ctrl+Spacebar डायरेक्ट कैरेक्टर फॉर्मेटिंग क्लियर करता है"},"o":[{"en":"Ctrl+Q clears paragraph formatting; Ctrl+Spacebar clears direct character formatting","hi":"Ctrl+Q पैराग्राफ फॉर्मेटिंग क्लियर करता है; Ctrl+Spacebar डायरेक्ट कैरेक्टर फॉर्मेटिंग क्लियर करता है"},{"en":"Ctrl+C clears paragraph formatting; Ctrl+Delete clears character formatting","hi":"Ctrl+C पैराग्राफ फॉर्मेटिंग क्लियर करता है; Ctrl+Delete कैरेक्टर फॉर्मेटिंग क्लियर करता है"},{"en":"Ctrl+W clears paragraph formatting; Alt+Spacebar clears character formatting","hi":"Ctrl+W पैराग्राफ फॉर्मेटिंग क्लियर करता है; Alt+Spacebar कैरेक्टर फॉर्मेटिंग क्लियर करता है"},{"en":"Esc clears paragraph formatting; Backspace clears character formatting","hi":"Esc पैराग्राफ फॉर्मेटिंग क्लियर करता है; Backspace कैरेक्टर फॉर्मेटिंग क्लियर करता है"}],"exp":{"en":"Pressing Ctrl+Q removes manual paragraph formatting (indents, line spacing, alignment) without changing character styles, whereas Ctrl+Spacebar resets selected text to default font/character formatting.","hi":"Ctrl+Q पैराग्राफ फॉर्मेटिंग को हटाता (clear करता) है, जबकि Ctrl+Spacebar डायरेक्ट कैरेक्टर फॉर्मेटिंग (जैसे बोल्ड, इटैलिक, फ़ॉन्ट साइज़) को क्लियर करता है।"},"num":57},{"id":"q58","q":{"en":"What are the MS Word keyboard shortcuts for Superscript and Subscript?","hi":"MS Word में सुपरस्क्रिप्ट (Superscript) और सबस्क्रिप्ट (Subscript) के शॉर्टकट क्या हैं?"},"a":{"en":"In classic Word for Windows: Ctrl+Shift+= (Superscript) and Ctrl+= (Subscript) [Microsoft's current list also gives Ctrl+Shift+− for Subscript]","hi":"क्लासिक Word में: Ctrl+Shift+= सुपरस्क्रिप्ट और Ctrl+= सबस्क्रिप्ट (Microsoft की वर्तमान सूची सबस्क्रिप्ट के लिए Ctrl+Shift+− भी देती है)"},"o":[{"en":"In classic Word for Windows: Ctrl+Shift+= (Superscript) and Ctrl+= (Subscript) [Microsoft's current list also gives Ctrl+Shift+− for Subscript]","hi":"क्लासिक Word में: Ctrl+Shift+= सुपरस्क्रिप्ट और Ctrl+= सबस्क्रिप्ट (Microsoft की वर्तमान सूची सबस्क्रिप्ट के लिए Ctrl+Shift+− भी देती है)"},{"en":"Ctrl+Up Arrow for Superscript and Ctrl+Down Arrow for Subscript","hi":"सुपरस्क्रिप्ट के लिए Ctrl+Up Arrow और सबस्क्रिप्ट के लिए Ctrl+Down Arrow"},{"en":"Alt+S for Superscript and Alt+B for Subscript","hi":"सुपरस्क्रिप्ट के लिए Alt+S और सबस्क्रिप्ट के लिए Alt+B"},{"en":"Ctrl+F1 for Superscript and Ctrl+F2 for Subscript","hi":"सुपरस्क्रिप्ट के लिए Ctrl+F1 और सबस्क्रिप्ट के लिए Ctrl+F2"}],"exp":{"en":"In classic Word for Windows exams, Ctrl+Shift+= (Ctrl + Plus) toggles Superscript and Ctrl+= toggles Subscript. Note that Microsoft's current documentation also lists Ctrl+Shift+− (minus) for Subscript.","hi":"क्लासिक Word for Windows में Ctrl+Shift+= सुपरस्क्रिप्ट और Ctrl+= सबस्क्रिप्ट का शॉर्टकट है। Microsoft की वर्तमान शॉर्टकट सूची सबस्क्रिप्ट के लिए Ctrl+Shift+− भी देती है।"},"num":58},{"id":"q59","q":{"en":"What are the keyboard shortcuts for inserting a Line Break, Page Break, and Column Break respectively in MS Word?","hi":"MS Word में क्रमशः लाइन ब्रेक (Line break), पेज ब्रेक (Page break) और कॉलम ब्रेक (Column break) डालने के शॉर्टकट क्या हैं?"},"a":{"en":"Shift+Enter (Line break), Ctrl+Enter (Page break), and Ctrl+Shift+Enter (Column break)","hi":"क्रमशः Shift+Enter, Ctrl+Enter और Ctrl+Shift+Enter"},"o":[{"en":"Shift+Enter (Line break), Ctrl+Enter (Page break), and Ctrl+Shift+Enter (Column break)","hi":"क्रमशः Shift+Enter, Ctrl+Enter और Ctrl+Shift+Enter"},{"en":"Ctrl+Enter (Line break), Alt+Enter (Page break), and Shift+Enter (Column break)","hi":"क्रमशः Ctrl+Enter, Alt+Enter और Shift+Enter"},{"en":"Enter (Line break), Shift+Enter (Page break), and Alt+Shift+Enter (Column break)","hi":"क्रमशः Enter, Shift+Enter और Alt+Shift+Enter"},{"en":"Ctrl+L (Line break), Ctrl+P (Page break), and Ctrl+C (Column break)","hi":"क्रमशः Ctrl+L, Ctrl+P और Ctrl+C"}],"exp":{"en":"In MS Word, Shift+Enter inserts a manual line break within the same paragraph, Ctrl+Enter inserts a manual page break, and Ctrl+Shift+Enter inserts a column break.","hi":"MS Word में Line break के लिए Shift+Enter, Page break के लिए Ctrl+Enter और Column break के लिए Ctrl+Shift+Enter का उपयोग होता है।"},"num":59},{"id":"q60","q":{"en":"Which keys move the cursor to the start/end of a document and one word to the left/right in MS Word?","hi":"MS Word में डॉक्यूमेंट के आरंभ/अंत (Start/End) में जाने और एक शब्द बाएँ/दाएँ (One-word left/right) मूव करने की कुंजियाँ क्या हैं?"},"a":{"en":"Ctrl+Home / Ctrl+End for document start/end; Ctrl+Left / Ctrl+Right to move one word left/right","hi":"डॉक्यूमेंट के आरंभ/अंत के लिए Ctrl+Home / Ctrl+End; एक शब्द बाएँ/दाएँ जाने के लिए Ctrl+Left / Ctrl+Right"},"o":[{"en":"Ctrl+Home / Ctrl+End for document start/end; Ctrl+Left / Ctrl+Right to move one word left/right","hi":"डॉक्यूमेंट के आरंभ/अंत के लिए Ctrl+Home / Ctrl+End; एक शब्द बाएँ/दाएँ जाने के लिए Ctrl+Left / Ctrl+Right"},{"en":"Home / End for document start/end; Alt+Left / Alt+Right for one word","hi":"डॉक्यूमेंट के आरंभ/अंत के लिए Home / End; एक शब्द के लिए Alt+Left / Alt+Right"},{"en":"Page Up / Page Down for document start/end; Shift+Left / Shift+Right for one word","hi":"डॉक्यूमेंट के आरंभ/अंत के लिए Page Up / Page Down; एक शब्द के लिए Shift+Left / Shift+Right"},{"en":"Ctrl+Page Up / Ctrl+Page Down for start/end; Tab / Shift+Tab for one word","hi":"आरंभ/अंत के लिए Ctrl+Page Up / Ctrl+Page Down; एक शब्द के लिए Tab / Shift+Tab"}],"exp":{"en":"In MS Word, Ctrl+Home jumps to the very beginning of the document and Ctrl+End jumps to the end (whereas Home/End alone move to the start/end of the current line). Ctrl+Left Arrow and Ctrl+Right Arrow move the cursor one whole word to the left or right.","hi":"डॉक्यूमेंट के आरंभ और अंत में जाने के लिए Ctrl+Home / Ctrl+End का उपयोग होता है, जबकि कर्सर को एक शब्द बाएँ या दाएँ ले जाने के लिए Ctrl+Left / Ctrl+Right कुंजियों का उपयोग होता है।"},"num":60},{"id":"q61","q":{"en":"How do you delete a single character versus an entire word to the left or right of the cursor in MS Word?","hi":"MS Word में कर्सर के बाएँ/दाएँ एक अक्षर (Character) और एक पूरा शब्द (Word) कैसे डिलीट करते हैं?"},"a":{"en":"Backspace / Delete for left/right character; Ctrl+Backspace / Ctrl+Delete for left/right word","hi":"बाएँ/दाएँ अक्षर के लिए Backspace / Delete; बाएँ/दाएँ पूरे शब्द के लिए Ctrl+Backspace / Ctrl+Delete"},"o":[{"en":"Backspace / Delete for left/right character; Ctrl+Backspace / Ctrl+Delete for left/right word","hi":"बाएँ/दाएँ अक्षर के लिए Backspace / Delete; बाएँ/दाएँ पूरे शब्द के लिए Ctrl+Backspace / Ctrl+Delete"},{"en":"Delete / Backspace for left/right character; Shift+Backspace / Shift+Delete for left/right word","hi":"बाएँ/दाएँ अक्षर के लिए Delete / Backspace; बाएँ/दाएँ शब्द के लिए Shift+Backspace / Shift+Delete"},{"en":"Alt+Backspace for left character; Alt+Delete for right word","hi":"बाएँ अक्षर के लिए Alt+Backspace; दाएँ शब्द के लिए Alt+Delete"},{"en":"Ctrl+X for left character; Ctrl+Z for right word","hi":"बाएँ अक्षर के लिए Ctrl+X; दाएँ शब्द के लिए Ctrl+Z"}],"exp":{"en":"Backspace deletes one character to the left and Delete removes one character to the right. Holding Ctrl modifies them to delete a whole word: Ctrl+Backspace deletes one word to the left, and Ctrl+Delete deletes one word to the right.","hi":"बाएँ या दाएँ के एक अक्षर को मिटाने के लिए क्रमशः Backspace और Delete का उपयोग होता है, जबकि बाएँ या दाएँ का पूरा शब्द मिटाने के लिए क्रमशः Ctrl+Backspace और Ctrl+Delete का उपयोग होता है।"},"num":61},{"id":"q62","q":{"en":"What do the 'Tab' and 'Shift+Tab' keys do inside an MS Word table?","hi":"MS Word टेबल के अंदर 'Tab' और 'Shift+Tab' कुंजियाँ क्या कार्य करती हैं?"},"a":{"en":"Move to the next cell and previous cell respectively (and pressing Tab in the last cell adds a new row)","hi":"क्रमशः अगले (next) और पिछले (previous) सेल में ले जाती हैं (और अंतिम सेल पर Tab दबाने से एक नई पंक्ति/row जुड़ सकती है)"},"o":[{"en":"Move to the next cell and previous cell respectively (and pressing Tab in the last cell adds a new row)","hi":"क्रमशः अगले (next) और पिछले (previous) सेल में ले जाती हैं (और अंतिम सेल पर Tab दबाने से एक नई पंक्ति/row जुड़ सकती है)"},{"en":"Delete the current column and row respectively","hi":"क्रमशः वर्तमान कॉलम और पंक्ति को हटाती हैं"},{"en":"Merge all cells and split the table respectively","hi":"क्रमशः सभी सेल्स को मर्ज करती हैं और टेबल को विभाजित करती हैं"},{"en":"Exit the Word application immediately","hi":"तुरंत Word एप्लिकेशन को बंद कर देती हैं"}],"exp":{"en":"Inside a Word table, pressing Tab moves the cursor to the next cell in the row, and Shift+Tab moves to the preceding cell. If the cursor is in the very last cell of the table, pressing Tab inserts a new row at the bottom.","hi":"Word टेबल में Tab अगली (next) सेल पर और Shift+Tab पिछली (previous) सेल पर ले जाता है। टेबल की अंतिम सेल पर Tab दबाने से एक नई पंक्ति (row) जुड़ जाती है।"},"num":62},{"id":"q63","q":{"en":"How do you select a single character or move a paragraph up/down using keyboard shortcuts in MS Word?","hi":"MS Word में कीबोर्ड से एक अक्षर (Character) सेलेक्ट करने या किसी पैराग्राफ को ऊपर/नीचे मूव करने का शॉर्टकट क्या है?"},"a":{"en":"Shift+Left/Right selects one character; Alt+Shift+Up/Down moves a paragraph up or down","hi":"Shift+Left/Right एक अक्षर सेलेक्ट करता है; Alt+Shift+Up/Down समर्थित पैराग्राफ/आउटलाइन संदर्भ में पैराग्राफ को ऊपर या नीचे मूव करता है"},"o":[{"en":"Shift+Left/Right selects one character; Alt+Shift+Up/Down moves a paragraph up or down","hi":"Shift+Left/Right एक अक्षर सेलेक्ट करता है; Alt+Shift+Up/Down समर्थित पैराग्राफ/आउटलाइन संदर्भ में पैराग्राफ को ऊपर या नीचे मूव करता है"},{"en":"Ctrl+Left/Right selects one character; Ctrl+Up/Down moves a paragraph","hi":"Ctrl+Left/Right एक अक्षर सेलेक्ट करता है; Ctrl+Up/Down पैराग्राफ मूव करता है"},{"en":"Alt+Left/Right selects one character; Shift+Up/Down moves a paragraph","hi":"Alt+Left/Right एक अक्षर सेलेक्ट करता है; Shift+Up/Down पैराग्राफ मूव करता है"},{"en":"Tab selects one character; Enter moves a paragraph up","hi":"Tab एक अक्षर सेलेक्ट करता है; Enter पैराग्राफ को ऊपर ले जाता है"}],"exp":{"en":"Pressing Shift+Left Arrow or Shift+Right Arrow extends the selection by one character to the left or right. Pressing Alt+Shift+Up Arrow or Alt+Shift+Down Arrow moves the current paragraph (or outline item) up or down without cutting and pasting.","hi":"Shift+Left/Right एक कैरेक्टर सेलेक्ट करता है, जबकि Alt+Shift+Up/Down समर्थित पैराग्राफ/आउटलाइन संदर्भ में पूरे पैराग्राफ को ऊपर या नीचे मूव करता है।"},"num":63},{"id":"q64","q":{"en":"What do 'Double-click' and 'Triple-click' select within the main document body text in MS Word?","hi":"MS Word डॉक्यूमेंट के मुख्य बॉडी टेक्स्ट में 'डबल-क्लिक' (Double-click) और 'ट्रिपल-क्लिक' (Triple-click) क्या सेलेक्ट करते हैं?"},"a":{"en":"Double-click selects a word; Triple-click in body text selects the entire paragraph (selection margin clicks behave differently)","hi":"डबल-क्लिक एक शब्द (word) सेलेक्ट करता है; बॉडी टेक्स्ट में ट्रिपल-क्लिक पूरा पैराग्राफ सेलेक्ट करता है (सेलेक्शन मार्जिन में क्लिक का व्यवहार अलग हो सकता है)"},"o":[{"en":"Double-click selects a word; Triple-click in body text selects the entire paragraph (selection margin clicks behave differently)","hi":"डबल-क्लिक एक शब्द (word) सेलेक्ट करता है; बॉडी टेक्स्ट में ट्रिपल-क्लिक पूरा पैराग्राफ सेलेक्ट करता है (सेलेक्शन मार्जिन में क्लिक का व्यवहार अलग हो सकता है)"},{"en":"Double-click selects a sentence; Triple-click closes the document","hi":"डबल-क्लिक एक वाक्य सेलेक्ट करता है; ट्रिपल-क्लिक डॉक्यूमेंट बंद कर देता है"},{"en":"Double-click selects a single letter; Triple-click selects a word","hi":"डबल-क्लिक एक अक्षर सेलेक्ट करता है; ट्रिपल-क्लिक एक शब्द सेलेक्ट करता है"},{"en":"Double-click selects a page; Triple-click deletes the paragraph","hi":"डबल-क्लिक एक पेज सेलेक्ट करता है; ट्रिपल-क्लिक पैराग्राफ को डिलीट करता है"}],"exp":{"en":"When clicking directly on body text in MS Word, double-clicking selects the current word and triple-clicking selects the entire paragraph. (Note: In the left selection bar/margin, a single click selects a line, double-click selects a paragraph, and triple-click selects the entire document.)","hi":"डॉक्यूमेंट के बॉडी टेक्स्ट में डबल-क्लिक करने पर एक शब्द (word) और ट्रिपल-क्लिक करने पर पूरा पैराग्राफ (paragraph) सेलेक्ट होता है (सेलेक्शन मार्जिन में क्लिक का व्यवहार अलग हो सकता है)।"},"num":64},{"id":"q65","q":{"en":"What is the important version trap regarding 'Paste Special' and 'Paste Formatting / Paste Text Only' shortcuts in MS Word?","hi":"MS Word में 'Paste Special' और 'Paste Formatting' शॉर्टकट्स में वर्ज़न ट्रैप (Version trap) क्या है?"},"a":{"en":"In older Word notes: Ctrl+Shift+V is Paste Formatting and Ctrl+Alt+V is Paste Special; in current Microsoft 365 Word: Ctrl+Shift+V is Paste Text Only and Ctrl+Alt+V is Paste Formatting (Paste Special is also under Home → Paste)","hi":"पुराने Word नोट्स में Ctrl+Shift+V पेस्ट फॉर्मेटिंग और Ctrl+Alt+V पेस्ट स्पेशल था; वर्तमान Microsoft 365 Word में Ctrl+Shift+V केवल टेक्स्ट पेस्ट (Paste Text Only) और Ctrl+Alt+V पेस्ट फॉर्मेटिंग है"},"o":[{"en":"In older Word notes: Ctrl+Shift+V is Paste Formatting and Ctrl+Alt+V is Paste Special; in current Microsoft 365 Word: Ctrl+Shift+V is Paste Text Only and Ctrl+Alt+V is Paste Formatting (Paste Special is also under Home → Paste)","hi":"पुराने Word नोट्स में Ctrl+Shift+V पेस्ट फॉर्मेटिंग और Ctrl+Alt+V पेस्ट स्पेशल था; वर्तमान Microsoft 365 Word में Ctrl+Shift+V केवल टेक्स्ट पेस्ट (Paste Text Only) और Ctrl+Alt+V पेस्ट फॉर्मेटिंग है"},{"en":"Ctrl+V is Paste Special in all versions and Ctrl+P is Paste Formatting","hi":"सभी संस्करणों में Ctrl+V पेस्ट स्पेशल है और Ctrl+P पेस्ट फॉर्मेटिंग है"},{"en":"Alt+F4 is Paste Special in older Word and Ctrl+W in Microsoft 365","hi":"पुराने Word में Alt+F4 पेस्ट स्पेशल है और Microsoft 365 में Ctrl+W है"},{"en":"There is no keyboard shortcut for pasting in any version of Word","hi":"Word के किसी भी संस्करण में पेस्ट करने का कोई कीबोर्ड शॉर्टकट नहीं है"}],"exp":{"en":"Exam version trap: Classic Word documentation/exams map Ctrl+Shift+V to Paste Formatting (companion to Ctrl+Shift+C) and Ctrl+Alt+V to Paste Special. However, current Microsoft 365 Word reassigned Ctrl+Shift+V to 'Paste Text Only' (unformatted text) and Ctrl+Alt+V to 'Paste Formatting'.","hi":"पुराने Word नोट्स में Ctrl+Shift+V 'Paste Formatting' और Ctrl+Alt+V 'Paste Special' के लिए होता है, जबकि वर्तमान Microsoft 365 Word शॉर्टकट सूची में Ctrl+Shift+V 'Paste Text Only' और Ctrl+Alt+V 'Paste Formatting' करता है (रिबन से Home → Paste → Paste Special भी उपलब्ध है)।"},"num":65},{"id":"q66","q":{"en":"What are the classic MS Word keyboard shortcuts for inserting the Copyright (©), Registered (®), and Trademark (™) symbols?","hi":"MS Word में कॉपीराइट (©), रजिस्टर्ड (®) और ट्रेडमार्क (™) सिंबल डालने के क्लासिक शॉर्टकट क्या हैं?"},"a":{"en":"Ctrl+Alt+C → ©, Ctrl+Alt+R → ®, and Ctrl+Alt+T → ™ (in newer builds Ctrl+Alt+C may map to Copy Formatting; also accessible via Insert → Symbol)","hi":"क्लासिक मैपिंग: Ctrl+Alt+C → ©, Ctrl+Alt+R → ®, Ctrl+Alt+T → ™ (नए वर्ज़न में Ctrl+Alt+C कॉपी फॉर्मेटिंग के लिए मैप हो सकता है; Insert → Symbol से भी उपलब्ध)"},"o":[{"en":"Ctrl+Alt+C → ©, Ctrl+Alt+R → ®, and Ctrl+Alt+T → ™ (in newer builds Ctrl+Alt+C may map to Copy Formatting; also accessible via Insert → Symbol)","hi":"क्लासिक मैपिंग: Ctrl+Alt+C → ©, Ctrl+Alt+R → ®, Ctrl+Alt+T → ™ (नए वर्ज़न में Ctrl+Alt+C कॉपी फॉर्मेटिंग के लिए मैप हो सकता है; Insert → Symbol से भी उपलब्ध)"},{"en":"Ctrl+C → ©, Ctrl+R → ®, and Ctrl+T → ™","hi":"Ctrl+C → ©, Ctrl+R → ®, और Ctrl+T → ™"},{"en":"Shift+C → ©, Shift+R → ®, and Shift+T → ™","hi":"Shift+C → ©, Shift+R → ®, और Shift+T → ™"},{"en":"Alt+1 → ©, Alt+2 → ®, and Alt+3 → ™","hi":"Alt+1 → ©, Alt+2 → ®, और Alt+3 → ™"}],"exp":{"en":"In classic MS Word mappings: Ctrl+Alt+C inserts © (Copyright), Ctrl+Alt+R inserts ® (Registered trademark), and Ctrl+Alt+T inserts ™ (Trademark). Note that in newer Microsoft 365 builds, Ctrl+Alt+C can map to Copy Formatting.","hi":"क्लासिक Word मैपिंग में Ctrl+Alt+C → ©, Ctrl+Alt+R → ® और Ctrl+Alt+T → ™ है। नए Word बिल्ड में Ctrl+Alt+C 'Copy Formatting' के लिए मैप हो सकता है, तथा इन्हें Insert → Symbol से भी इंसर्ट किया जा सकता है।"},"num":66},{"id":"q67","q":{"en":"What are the keyboard shortcuts in MS Word to insert a Footnote, an Endnote, and a Comment respectively?","hi":"MS Word में क्रमशः फुटनोट (Footnote), एंडनोट (Endnote) और कमेंट (Comment) इंसर्ट करने के शॉर्टकट क्या हैं?"},"a":{"en":"Ctrl+Alt+F (Footnote), Ctrl+Alt+D (Endnote), and Ctrl+Alt+M (Comment)","hi":"Ctrl+Alt+F, Ctrl+Alt+D और Ctrl+Alt+M"},"o":[{"en":"Ctrl+Alt+F (Footnote), Ctrl+Alt+D (Endnote), and Ctrl+Alt+M (Comment)","hi":"Ctrl+Alt+F, Ctrl+Alt+D और Ctrl+Alt+M"},{"en":"Ctrl+F (Footnote), Ctrl+E (Endnote), and Ctrl+M (Comment)","hi":"Ctrl+F, Ctrl+E और Ctrl+M"},{"en":"Alt+F (Footnote), Alt+E (Endnote), and Alt+C (Comment)","hi":"Alt+F, Alt+E और Alt+C"},{"en":"Ctrl+Shift+F (Footnote), Ctrl+Shift+E (Endnote), and Ctrl+Shift+C (Comment)","hi":"Ctrl+Shift+F, Ctrl+Shift+E और Ctrl+Shift+C"}],"exp":{"en":"In MS Word: Ctrl+Alt+F inserts a Footnote at the bottom of the current page, Ctrl+Alt+D inserts an Endnote at the end of the document/section, and Ctrl+Alt+M inserts a new Comment.","hi":"MS Word में Footnote के लिए Ctrl+Alt+F, Endnote के लिए Ctrl+Alt+D और Comment जोड़ने के लिए Ctrl+Alt+M शॉर्टकट का उपयोग होता है।"},"num":67},{"id":"q68","q":{"en":"Which keyboard shortcuts insert the current Date field and current Time field in MS Word?","hi":"MS Word में वर्तमान दिनांक (Current Date) और समय (Time) फील्ड इंसर्ट करने के शॉर्टकट क्या हैं?"},"a":{"en":"Alt+Shift+D for Date field, and Alt+Shift+T for Time field","hi":"दिनांक (Date) के लिए Alt+Shift+D और समय (Time) के लिए Alt+Shift+T"},"o":[{"en":"Alt+Shift+D for Date field, and Alt+Shift+T for Time field","hi":"दिनांक (Date) के लिए Alt+Shift+D और समय (Time) के लिए Alt+Shift+T"},{"en":"Ctrl+D for Date field, and Ctrl+T for Time field","hi":"दिनांक के लिए Ctrl+D और समय के लिए Ctrl+T"},{"en":"Ctrl+; for Date field, and Ctrl+Shift+; for Time field","hi":"दिनांक के लिए Ctrl+; और समय के लिए Ctrl+Shift+;"},{"en":"Alt+D for Date field, and Alt+T for Time field","hi":"दिनांक के लिए Alt+D और समय के लिए Alt+T"}],"exp":{"en":"In MS Word, pressing Alt+Shift+D inserts a dynamic DATE field, and pressing Alt+Shift+T inserts a dynamic TIME field. (Note: Ctrl+; and Ctrl+Shift+; are used in Excel, not Word!)","hi":"MS Word में वर्तमान Date फील्ड डालने के लिए Alt+Shift+D और वर्तमान Time फील्ड डालने के लिए Alt+Shift+T शॉर्टकट का उपयोग किया जाता है।"},"num":68},{"id":"q69","q":{"en":"Which shortcuts are used in MS Word to mark a Citation, a Table of Contents (TOC) entry, and an Index entry respectively?","hi":"MS Word में क्रमशः साइटेशन (Citation), टेबल ऑफ कंटेंट्स (TOC) एंट्री और इंडेक्स (Index) एंट्री मार्क करने के शॉर्टकट क्या हैं?"},"a":{"en":"Alt+Shift+I (mark Citation), Alt+Shift+O (mark TOC entry), and Alt+Shift+X (mark Index entry)","hi":"Alt+Shift+I साइटेशन, Alt+Shift+O TOC एंट्री और Alt+Shift+X इंडेक्स एंट्री"},"o":[{"en":"Alt+Shift+I (mark Citation), Alt+Shift+O (mark TOC entry), and Alt+Shift+X (mark Index entry)","hi":"Alt+Shift+I साइटेशन, Alt+Shift+O TOC एंट्री और Alt+Shift+X इंडेक्स एंट्री"},{"en":"Ctrl+I (Citation), Ctrl+O (TOC entry), and Ctrl+X (Index entry)","hi":"Ctrl+I साइटेशन, Ctrl+O TOC एंट्री और Ctrl+X इंडेक्स एंट्री"},{"en":"Ctrl+Alt+I (Citation), Ctrl+Alt+O (TOC entry), and Ctrl+Alt+X (Index entry)","hi":"Ctrl+Alt+I साइटेशन, Ctrl+Alt+O TOC एंट्री और Ctrl+Alt+X इंडेक्स एंट्री"},{"en":"Shift+F1 (Citation), Shift+F2 (TOC entry), and Shift+F3 (Index entry)","hi":"Shift+F1 साइटेशन, Shift+F2 TOC एंट्री और Shift+F3 इंडेक्स एंट्री"}],"exp":{"en":"Reference marking shortcuts in MS Word: Alt+Shift+I marks a Table of Authorities citation, Alt+Shift+O marks a Table of Contents (TOC) entry, and Alt+Shift+X marks an Index entry.","hi":"MS Word में Citation मार्क करने के लिए Alt+Shift+I, TOC (Table of Contents) एंट्री मार्क करने के लिए Alt+Shift+O और Index एंट्री मार्क करने के लिए Alt+Shift+X का उपयोग होता है।"},"num":69},{"id":"q70","q":{"en":"What are the keyboard shortcuts in MS Word to apply the 'Normal' style and 'Heading 1', 'Heading 2', and 'Heading 3' styles?","hi":"MS Word में 'Normal' स्टाइल और 'Heading 1–3' स्टाइल्स लागू करने की शॉर्टकट कुंजियाँ क्या हैं?"},"a":{"en":"Ctrl+Shift+N for Normal style; Ctrl+Alt+1, Ctrl+Alt+2, and Ctrl+Alt+3 for Heading 1, 2, and 3 respectively / Normal के लिए Ctrl+Shift+N; तथा संबंधित Heading 1, 2 और 3 के लिए क्रमशः Ctrl+Alt+1 / 2","hi":"3"},"o":[{"en":"Ctrl+Shift+N for Normal style; Ctrl+Alt+1, Ctrl+Alt+2, and Ctrl+Alt+3 for Heading 1, 2, and 3 respectively / Normal के लिए Ctrl+Shift+N; तथा संबंधित Heading 1, 2 और 3 के लिए क्रमशः Ctrl+Alt+1 / 2","hi":"3"},{"en":"Ctrl+N for Normal style; Ctrl+1, Ctrl+2, and Ctrl+3 for Heading 1, 2, and 3","hi":"Normal के लिए Ctrl+N; तथा Heading 1, 2, 3 के लिए Ctrl+1, Ctrl+2, Ctrl+3"},{"en":"Alt+N for Normal style; Alt+1, Alt+2, and Alt+3 for Heading 1, 2, and 3","hi":"Normal के लिए Alt+N; तथा Heading 1, 2, 3 के लिए Alt+1, Alt+2, Alt+3"},{"en":"Ctrl+0 for Normal style; F1, F2, and F3 for Heading 1, 2, and 3","hi":"Normal के लिए Ctrl+0; तथा Heading 1, 2, 3 के लिए F1, F2, F3"}],"exp":{"en":"In MS Word, pressing Ctrl+Shift+N applies the Normal paragraph style, while Ctrl+Alt+1, Ctrl+Alt+2, and Ctrl+Alt+3 apply Heading 1, Heading 2, and Heading 3 styles respectively.","hi":"Word में Normal स्टाइल लागू करने के लिए Ctrl+Shift+N तथा Heading 1, Heading 2 और Heading 3 लागू करने के लिए क्रमशः Ctrl+Alt+1, Ctrl+Alt+2 और Ctrl+Alt+3 का उपयोग होता है।"},"num":70},{"id":"q71","q":{"en":"Which keyboard shortcuts open the 'Apply Styles' task pane and the main 'Styles' pane in MS Word?","hi":"MS Word में 'Apply Styles' और 'Styles' पेन खोलने के कीबोर्ड शॉर्टकट क्या हैं?"},"a":{"en":"Ctrl+Shift+S opens Apply Styles; Ctrl+Alt+Shift+S opens the Styles pane","hi":"Ctrl+Shift+S 'Apply Styles' खोलता है; Ctrl+Alt+Shift+S 'Styles' पेन खोलता है"},"o":[{"en":"Ctrl+Shift+S opens Apply Styles; Ctrl+Alt+Shift+S opens the Styles pane","hi":"Ctrl+Shift+S 'Apply Styles' खोलता है; Ctrl+Alt+Shift+S 'Styles' पेन खोलता है"},{"en":"Ctrl+S opens Apply Styles; Alt+S opens the Styles pane","hi":"Ctrl+S 'Apply Styles' खोलता है; Alt+S 'Styles' पेन खोलता है"},{"en":"Ctrl+F1 opens Apply Styles; Ctrl+F2 opens the Styles pane","hi":"Ctrl+F1 'Apply Styles' खोलता है; Ctrl+F2 'Styles' पेन खोलता है"},{"en":"Shift+S opens Apply Styles; Alt+Shift+S opens the Styles pane","hi":"Shift+S 'Apply Styles' खोलता है; Alt+Shift+S 'Styles' पेन खोलता है"}],"exp":{"en":"In MS Word, pressing Ctrl+Shift+S opens the floating 'Apply Styles' box, while pressing Ctrl+Alt+Shift+S opens the docked 'Styles' task pane.","hi":"MS Word में Apply Styles टूल खोलने के लिए Ctrl+Shift+S और Styles पेन (pane) खोलने के लिए Ctrl+Alt+Shift+S शॉर्टकट का उपयोग किया जाता है।"},"num":71},{"id":"q72","q":{"en":"What are the keyboard shortcuts to switch to Print Layout, Outline, and Draft views respectively in MS Word?","hi":"MS Word में क्रमशः Print Layout, Outline और Draft व्यू में स्विच करने के शॉर्टकट क्या हैं?"},"a":{"en":"Ctrl+Alt+P (Print Layout), Ctrl+Alt+O (Outline), and Ctrl+Alt+N (Draft)","hi":"क्रमशः Ctrl+Alt+P, Ctrl+Alt+O और Ctrl+Alt+N"},"o":[{"en":"Ctrl+Alt+P (Print Layout), Ctrl+Alt+O (Outline), and Ctrl+Alt+N (Draft)","hi":"क्रमशः Ctrl+Alt+P, Ctrl+Alt+O और Ctrl+Alt+N"},{"en":"Ctrl+P (Print Layout), Ctrl+O (Outline), and Ctrl+D (Draft)","hi":"क्रमशः Ctrl+P, Ctrl+O और Ctrl+D"},{"en":"Alt+P (Print Layout), Alt+O (Outline), and Alt+N (Draft)","hi":"क्रमशः Alt+P, Alt+O और Alt+N"},{"en":"Ctrl+Shift+P (Print Layout), Ctrl+Shift+O (Outline), and Ctrl+Shift+N (Draft)","hi":"क्रमशः Ctrl+Shift+P, Ctrl+Shift+O और Ctrl+Shift+N"}],"exp":{"en":"View switching shortcuts in MS Word: Ctrl+Alt+P switches to Print Layout view, Ctrl+Alt+O switches to Outline view, and Ctrl+Alt+N switches to Draft view (formerly called Normal view, hence 'N').","hi":"Print Layout व्यू के लिए Ctrl+Alt+P, Outline व्यू के लिए Ctrl+Alt+O और Draft व्यू (पूर्व नाम Normal व्यू) के लिए Ctrl+Alt+N शॉर्टकट है।"},"num":72},{"id":"q73","q":{"en":"What is the Ribbon access key sequence for entering 'Read Mode' in MS Word, and how do you navigate or exit inside it?","hi":"MS Word में 'Read Mode' खोलने का एक्सेस की-सीक्वेंस (Access key sequence) और उसमें नेविगेशन का तरीका क्या है?"},"a":{"en":"Alt+W, F opens Read Mode; Home/End moves to beginning/end, typing a page number + Enter jumps to that page, and Esc exits Read Mode","hi":"Alt+W, F से Read Mode खुलता है; इसमें Home/End से आरंभ/अंत पर जाते हैं, पेज नंबर + Enter से विशिष्ट पेज पर जाते हैं और Esc से बाहर निकलते हैं"},"o":[{"en":"Alt+W, F opens Read Mode; Home/End moves to beginning/end, typing a page number + Enter jumps to that page, and Esc exits Read Mode","hi":"Alt+W, F से Read Mode खुलता है; इसमें Home/End से आरंभ/अंत पर जाते हैं, पेज नंबर + Enter से विशिष्ट पेज पर जाते हैं और Esc से बाहर निकलते हैं"},{"en":"Ctrl+R opens Read Mode; Backspace exits Read Mode","hi":"Ctrl+R से Read Mode खुलता है; Backspace से बाहर निकलते हैं"},{"en":"Alt+F, R opens Read Mode; Ctrl+W exits Read Mode","hi":"Alt+F, R से Read Mode खुलता है; Ctrl+W से बाहर निकलते हैं"},{"en":"F5 opens Read Mode; Delete exits Read Mode","hi":"F5 से Read Mode खुलता है; Delete से बाहर निकलते हैं"}],"exp":{"en":"Pressing Alt+W followed by F activates Read Mode (Full Screen Reading). While in Read Mode, Home/End jumps to the start/end of the document, typing a page number and pressing Enter goes to that page, and Esc exits back to Print Layout.","hi":"Word में Read Mode का एक्सेस की-सीक्वेंस Alt+W, F है। Read Mode में Home/End से शुरुआत/अंत में जाते हैं, पेज नंबर + Enter से किसी खास पेज पर जाते हैं और Esc दबाकर बाहर (exit) आते हैं।"},"num":73},{"id":"q74","q":{"en":"Which keyboard shortcuts are used to split and unsplit (remove split from) a document window in MS Word?","hi":"MS Word में डॉक्यूमेंट विंडो को स्प्लिट (Split) और अनस्प्लिट (Unsplit) करने के शॉर्टकट क्या हैं?"},"a":{"en":"Ctrl+Alt+S splits the window; Alt+Shift+C (or Ctrl+Alt+S again) removes the split depending on Word version/context","hi":"Ctrl+Alt+S विंडो स्प्लिट करता है; तथा Alt+Shift+C (Word वर्ज़न/संदर्भ के अनुसार) स्प्लिट हटा सकता है"},"o":[{"en":"Ctrl+Alt+S splits the window; Alt+Shift+C (or Ctrl+Alt+S again) removes the split depending on Word version/context","hi":"Ctrl+Alt+S विंडो स्प्लिट करता है; तथा Alt+Shift+C (Word वर्ज़न/संदर्भ के अनुसार) स्प्लिट हटा सकता है"},{"en":"Ctrl+S splits the window; Ctrl+C removes the split","hi":"Ctrl+S विंडो स्प्लिट करता है; Ctrl+C स्प्लिट हटाता है"},{"en":"Alt+S splits the window; Esc removes the split","hi":"Alt+S विंडो स्प्लिट करता है; Esc स्प्लिट हटाता है"},{"en":"Ctrl+Shift+W splits the window; Ctrl+W removes the split","hi":"Ctrl+Shift+W विंडो स्प्लिट करता है; Ctrl+W स्प्लिट हटाता है"}],"exp":{"en":"In MS Word, pressing Ctrl+Alt+S splits the document window into two horizontal panes, while pressing Alt+Shift+C (or toggling Ctrl+Alt+S) closes/removes the split pane.","hi":"डॉक्यूमेंट विंडो को विभाजित (split) करने के लिए Ctrl+Alt+S का उपयोग होता है, और Word वर्ज़न/संदर्भ के हिसाब से Alt+Shift+C (या पुनः Ctrl+Alt+S) स्प्लिट को हटाता है।"},"num":74},{"id":"q75","q":{"en":"What is the step-by-step keyboard procedure to close an open Task Pane in MS Word?","hi":"MS Word में किसी खुले हुए टास्क पेन (Task Pane) को कीबोर्ड से बंद (Close) कैसे करते हैं?"},"a":{"en":"Press F6 to move focus to the pane, press Ctrl+Spacebar to open the pane menu, use Arrow keys to select Close, and press Enter","hi":"F6 से पेन पर फोकस करें, Ctrl+Spacebar से पेन मेनू खोलें, एरो कुंजियों से Close सेलेक्ट करके Enter दबाएँ"},"o":[{"en":"Press F6 to move focus to the pane, press Ctrl+Spacebar to open the pane menu, use Arrow keys to select Close, and press Enter","hi":"F6 से पेन पर फोकस करें, Ctrl+Spacebar से पेन मेनू खोलें, एरो कुंजियों से Close सेलेक्ट करके Enter दबाएँ"},{"en":"Press Alt+F4 to close only the task pane while keeping Word open","hi":"Word को खुला रखते हुए केवल टास्क पेन बंद करने के लिए Alt+F4 दबाएँ"},{"en":"Press Ctrl+Delete twice inside the paragraph","hi":"पैराग्राफ के अंदर दो बार Ctrl+Delete दबाएँ"},{"en":"Press F12 and type EXIT","hi":"F12 दबाएँ और EXIT टाइप करें"}],"exp":{"en":"To close a Word task pane using only the keyboard: press F6 to cycle focus to the task pane, press Ctrl+Spacebar to open the task pane's control menu, use the Up/Down arrow keys to highlight 'Close', and press Enter.","hi":"कीबोर्ड से Task pane बंद करने का क्रम: F6 से पेन पर फोकस लाएँ, Ctrl+Spacebar से पेन मेनू खोलें, एरो कीज़ (arrows) से Close चुनें और Enter दबाएँ।"},"num":75},{"id":"q76","q":{"en":"What are the Alt-key access shortcuts for Ribbon Search and the primary tabs (File, Home, Insert, Design, Layout) in MS Word?","hi":"MS Word में रिबन सर्च (Search) और शुरुआती मुख्य टैब्स (File, Home, Insert, Design, Layout) की एक्सेस कुंजियाँ क्या हैं?"},"a":{"en":"Alt+Q (Search), Alt+F (File), Alt+H (Home), Alt+N (Insert), Alt+G (Design), and Alt+P (Layout)","hi":"Alt+Q सर्च, Alt+F फाइल, Alt+H होम, Alt+N इंसर्ट, Alt+G डिज़ाइन और Alt+P लेआउट"},"o":[{"en":"Alt+Q (Search), Alt+F (File), Alt+H (Home), Alt+N (Insert), Alt+G (Design), and Alt+P (Layout)","hi":"Alt+Q सर्च, Alt+F फाइल, Alt+H होम, Alt+N इंसर्ट, Alt+G डिज़ाइन और Alt+P लेआउट"},{"en":"Alt+S (Search), Alt+F (File), Alt+H (Home), Alt+I (Insert), Alt+D (Design), and Alt+L (Layout)","hi":"Alt+S सर्च, Alt+F फाइल, Alt+H होम, Alt+I इंसर्ट, Alt+D डिज़ाइन और Alt+L लेआउट"},{"en":"Ctrl+Q (Search), Ctrl+F (File), Ctrl+H (Home), Ctrl+N (Insert), Ctrl+G (Design), and Ctrl+P (Layout)","hi":"Ctrl+Q सर्च, Ctrl+F फाइल, Ctrl+H होम, Ctrl+N इंसर्ट, Ctrl+G डिज़ाइन और Ctrl+P लेआउट"},{"en":"F1 (Search), F2 (File), F3 (Home), F4 (Insert), F5 (Design), and F6 (Layout)","hi":"F1 सर्च, F2 फाइल, F3 होम, F4 इंसर्ट, F5 डिज़ाइन और F6 लेआउट"}],"exp":{"en":"KeyTip access shortcuts in MS Word: Alt+Q jumps to the 'Tell me / Search' box, Alt+F opens File, Alt+H opens Home, Alt+N opens Insert, Alt+G opens Design, and Alt+P opens Layout (formerly Page Layout).","hi":"Word रिबन में Search के लिए Alt+Q, File के लिए Alt+F, Home के लिए Alt+H, Insert के लिए Alt+N, Design के लिए Alt+G और Layout के लिए Alt+P एक्सेस कुंजियाँ हैं।"},"num":76},{"id":"q77","q":{"en":"What are the Alt-key access shortcuts for the References, Mailings, Review, and View tabs respectively in MS Word?","hi":"MS Word में References, Mailings, Review और View टैब्स की एक्सेस कुंजियाँ (Access keys) क्रमशः क्या हैं?"},"a":{"en":"Alt+S (References), Alt+M (Mailings), Alt+R (Review), and Alt+W (View)","hi":"क्रमशः Alt+S, Alt+M, Alt+R और Alt+W"},"o":[{"en":"Alt+S (References), Alt+M (Mailings), Alt+R (Review), and Alt+W (View)","hi":"क्रमशः Alt+S, Alt+M, Alt+R और Alt+W"},{"en":"Alt+R (References), Alt+M (Mailings), Alt+V (Review), and Alt+W (View)","hi":"क्रमशः Alt+R, Alt+M, Alt+V और Alt+W"},{"en":"Ctrl+S (References), Ctrl+M (Mailings), Ctrl+R (Review), and Ctrl+W (View)","hi":"क्रमशः Ctrl+S, Ctrl+M, Ctrl+R और Ctrl+W"},{"en":"Alt+F (References), Alt+L (Mailings), Alt+E (Review), and Alt+V (View)","hi":"क्रमशः Alt+F, Alt+L, Alt+E और Alt+V"}],"exp":{"en":"In MS Word, pressing Alt+S opens the References tab, Alt+M opens Mailings, Alt+R opens Review, and Alt+W opens the View tab.","hi":"Word में References के लिए Alt+S, Mailings के लिए Alt+M, Review के लिए Alt+R और View टैब के लिए Alt+W एक्सेस कुंजी का उपयोग होता है।"},"num":77},{"id":"q78","q":{"en":"How do you open the Zoom dialog box and Print Preview using keyboard shortcuts in MS Word?","hi":"MS Word में कीबोर्ड से Zoom डायलॉग और Print Preview कैसे खोलते हैं?"},"a":{"en":"Alt+W, Q opens the Zoom dialog; Ctrl+F2 opens Backstage Print Preview (and Ctrl+Alt+I toggles legacy Print Preview mode where supported)","hi":"Alt+W, Q ज़ूम डायलॉग खोलता है; Ctrl+F2 बैकस्टेज प्रिंट प्रीव्यू खोलता है (और Ctrl+Alt+I समर्थित वर्ज़न में लीगेसी प्रिंट प्रीव्यू मोड टॉगल करता है)"},"o":[{"en":"Alt+W, Q opens the Zoom dialog; Ctrl+F2 opens Backstage Print Preview (and Ctrl+Alt+I toggles legacy Print Preview mode where supported)","hi":"Alt+W, Q ज़ूम डायलॉग खोलता है; Ctrl+F2 बैकस्टेज प्रिंट प्रीव्यू खोलता है (और Ctrl+Alt+I समर्थित वर्ज़न में लीगेसी प्रिंट प्रीव्यू मोड टॉगल करता है)"},{"en":"Ctrl+Z opens Zoom dialog; F2 opens Print Preview","hi":"Ctrl+Z ज़ूम डायलॉग खोलता है; F2 प्रिंट प्रीव्यू खोलता है"},{"en":"Alt+Z opens Zoom dialog; Shift+F2 opens Print Preview","hi":"Alt+Z ज़ूम डायलॉग खोलता है; Shift+F2 प्रिंट प्रीव्यू खोलता है"},{"en":"Ctrl+Q opens Zoom dialog; Alt+P opens Print Preview","hi":"Ctrl+Q ज़ूम डायलॉग खोलता है; Alt+P प्रिंट प्रीव्यू खोलता है"}],"exp":{"en":"Pressing Alt+W followed by Q opens the Zoom dialog box in MS Word. For Print Preview, Ctrl+F2 (or Ctrl+P) opens the Backstage Print & Preview pane, while Ctrl+Alt+I is the classic shortcut to toggle Print Preview mode.","hi":"Zoom डायलॉग खोलने के लिए Alt+W, Q का उपयोग होता है। Ctrl+F2 बैकस्टेज Print Preview खोलता है, जबकि Ctrl+Alt+I समर्थित संस्करणों में लीगेसी Print Preview मोड को टॉगल करता है।"},"num":78},{"id":"q79","q":{"en":"How do you navigate across pages while in Print Preview in MS Word?","hi":"MS Word के Print Preview में पेजों के बीच नेविगेशन (Navigation) कैसे करते हैं?"},"a":{"en":"Arrow keys move around a zoomed-in page; Page Up / Page Down move by page in zoomed-out view; Ctrl+Home / Ctrl+End jump to the first / last preview page","hi":"ज़ूम-इन पेज में एरो कीज़ (arrows); ज़ूम-आउट व्यू में Page Up/Down; और पहले/आखिरी प्रीव्यू पेज के लिए Ctrl+Home/End"},"o":[{"en":"Arrow keys move around a zoomed-in page; Page Up / Page Down move by page in zoomed-out view; Ctrl+Home / Ctrl+End jump to the first / last preview page","hi":"ज़ूम-इन पेज में एरो कीज़ (arrows); ज़ूम-आउट व्यू में Page Up/Down; और पहले/आखिरी प्रीव्यू पेज के लिए Ctrl+Home/End"},{"en":"Only the Tab key can scroll pages in Print Preview","hi":"प्रिंट प्रीव्यू में केवल Tab कुंजी ही पेज स्क्रॉल कर सकती है"},{"en":"Backspace moves to the first page and Delete moves to the last page","hi":"Backspace पहले पेज पर और Delete अंतिम पेज पर ले जाता है"},{"en":"F1 moves up and F12 moves down","hi":"F1 ऊपर ले जाता है और F12 नीचे ले जाता है"}],"exp":{"en":"In Print Preview, the Arrow keys scroll around a zoomed-in page, Page Up and Page Down move between pages when zoomed out, and Ctrl+Home / Ctrl+End jump directly to the first or last page of the document.","hi":"Print Preview में ज़ूम-इन पेज पर घूमने के लिए एरो कुंजियाँ (arrows), ज़ूम-आउट व्यू में पेज बदलने के लिए Page Up/Down, और पहले या अंतिम प्रीव्यू पेज पर जाने के लिए Ctrl+Home/End का उपयोग होता है।"},"num":79},{"id":"q80","q":{"en":"What are the functions of 'Alt+Left Arrow', 'Alt+Right Arrow', and 'F9' in web/document contexts in MS Word?","hi":"वेब/डॉक्यूमेंट संदर्भ में 'Alt+Left', 'Alt+Right' और 'F9' कुंजियों के क्या कार्य हैं?"},"a":{"en":"In supported web/hyperlink navigation, Alt+Left / Alt+Right go to the previous / next page; in a Word document, F9 updates selected fields","hi":"समर्थित वेब नेविगेशन में Alt+Left/Right पिछले/अगले पेज पर ले जाते हैं; और Word डॉक्यूमेंट में F9 चयनित फील्ड्स (selected fields) को अपडेट करता है"},"o":[{"en":"In supported web/hyperlink navigation, Alt+Left / Alt+Right go to the previous / next page; in a Word document, F9 updates selected fields","hi":"समर्थित वेब नेविगेशन में Alt+Left/Right पिछले/अगले पेज पर ले जाते हैं; और Word डॉक्यूमेंट में F9 चयनित फील्ड्स (selected fields) को अपडेट करता है"},{"en":"Alt+Left/Right delete words; F9 saves the document","hi":"Alt+Left/Right शब्दों को हटाते हैं; F9 डॉक्यूमेंट को सेव करता है"},{"en":"Alt+Left/Right change page margins; F9 checks spelling","hi":"Alt+Left/Right पेज मार्जिन बदलते हैं; F9 स्पेलिंग चेक करता है"},{"en":"Alt+Left/Right rotate images; F9 closes the window","hi":"Alt+Left/Right इमेज घुमाते हैं; F9 विंडो बंद करता है"}],"exp":{"en":"In web browsers and supported hyperlink navigation contexts, Alt+Left Arrow goes back to the previous page and Alt+Right Arrow goes forward to the next page. Within an MS Word document, pressing F9 updates selected dynamic fields (such as dates, formulas, or tables of contents).","hi":"समर्थित वेब नेविगेशन में Alt+Left और Alt+Right क्रमशः पिछले (previous) और अगले (next) पेज पर ले जाते हैं, जबकि Word डॉक्यूमेंट में F9 चयनित फील्ड्स (selected fields) को अपडेट करता है।"},"num":80},{"id":"q81","q":{"en":"In which context are the 'Ctrl+\\' and 'Alt+Shift+L' shortcuts used according to the source notes?","hi":"सोर्स नोट्स के अनुसार MS Word में 'Ctrl+\\' और 'Alt+Shift+L' शॉर्टकट किस संदर्भ में उपयोग किए जाते हैं?"},"a":{"en":"Outline/Master Document context (Ctrl+\\ is a legacy shortcut to collapse/expand subdocuments; Alt+Shift+L toggles showing the first body-text line or all body text)","hi":"आउटलाइन/मास्टर डॉक्यूमेंट संदर्भ (Ctrl+\\ सबडॉक्यूमेंट को कोलैप्स/एक्सपैंड करने का लीगेसी शॉर्टकट है; Alt+Shift+L आउटलाइन में केवल पहली बॉडी-टेक्स्ट लाइन या सभी बॉडी टेक्स्ट दिखाने को टॉगल करता है)"},"o":[{"en":"Outline/Master Document context (Ctrl+\\ is a legacy shortcut to collapse/expand subdocuments; Alt+Shift+L toggles showing the first body-text line or all body text)","hi":"आउटलाइन/मास्टर डॉक्यूमेंट संदर्भ (Ctrl+\\ सबडॉक्यूमेंट को कोलैप्स/एक्सपैंड करने का लीगेसी शॉर्टकट है; Alt+Shift+L आउटलाइन में केवल पहली बॉडी-टेक्स्ट लाइन या सभी बॉडी टेक्स्ट दिखाने को टॉगल करता है)"},{"en":"Mail Merge context","hi":"मेल मर्ज संदर्भ"},{"en":"Macro recording context","hi":"मैक्रो रिकॉर्डिंग संदर्भ"},{"en":"Page layout margin adjustment","hi":"पेज लेआउट मार्जिन समायोजन"}],"exp":{"en":"In Word's Outline or Master Document view, Ctrl+\\ is a legacy shortcut to expand or collapse subdocuments. Alt+Shift+L toggles between showing only the first line of body text and showing all body text.","hi":"Word के आउटलाइन (Outline) या मास्टर डॉक्यूमेंट व्यू में, Ctrl+\\ सबडॉक्यूमेंट को कोलैप्स/एक्सपैंड करने का लीगेसी शॉर्टकट है। Alt+Shift+L बॉडी टेक्स्ट की केवल पहली लाइन या सभी लाइनें दिखाने को टॉगल करता है।"},"num":81},{"id":"q82","q":{"en":"What is the legacy shortcut for the 'AutoFormat' command in MS Word mentioned in the chapter?","hi":"अध्याय में MS Word के 'AutoFormat' कमांड के लिए कौन-सा लीगेसी शॉर्टकट दिया गया है?"},"a":{"en":"Ctrl+Alt+K (availability depends on Word version and command setup)","hi":"Ctrl+Alt+K (उपलब्धता Word वर्ज़न और कमांड सेटअप पर निर्भर करती है)"},"o":[{"en":"Ctrl+Shift+A","hi":"Ctrl+Shift+A"},{"en":"Ctrl+Alt+K (availability depends on Word version and command setup)","hi":"Ctrl+Alt+K (उपलब्धता Word वर्ज़न और कमांड सेटअप पर निर्भर करती है)"},{"en":"Alt+F8","hi":"Alt+F8"},{"en":"Shift+Enter","hi":"Shift+Enter"}],"exp":{"en":"Classic MS Word documentation lists Ctrl+Alt+K as the shortcut to invoke AutoFormat, though its availability can vary depending on the specific Word version and customized command setup.","hi":"क्लासिक Word नोट्स के अनुसार AutoFormat का शॉर्टकट Ctrl+Alt+K है। (ध्यान दें: इसकी उपलब्धता Word के संस्करण और कमांड सेटअप पर निर्भर कर सकती है)।"},"num":82},{"id":"q83","q":{"en":"Which of the following correctly pairs Windows and Chrome shortcuts mentioned in the Word section notes?","hi":"Word सेक्शन नोट्स में उल्लिखित Windows और Chrome शॉर्टकट्स का सही मिलान कौन-सा है?"},"a":{"en":"Win+L locks PC, Win+D shows desktop; Chrome: Ctrl+Tab (next tab), Ctrl+D (bookmark)","hi":"Win+L पीसी लॉक करता है, Win+D डेस्कटॉप दिखाता है; Chrome: Ctrl+Tab (अगला टैब), Ctrl+D (बुकमार्क)"},"o":[{"en":"Win+L locks PC, Win+D shows desktop; Chrome: Ctrl+Tab (next tab), Ctrl+D (bookmark)","hi":"Win+L पीसी लॉक करता है, Win+D डेस्कटॉप दिखाता है; Chrome: Ctrl+Tab (अगला टैब), Ctrl+D (बुकमार्क)"},{"en":"Win+A locks PC, Win+X shows desktop; Chrome: Ctrl+T (bookmark)","hi":"Win+A पीसी लॉक करता है, Win+X डेस्कटॉप दिखाता है; Chrome: Ctrl+T (बुकमार्क)"},{"en":"Win+P locks PC, Win+S shows desktop; Chrome: Ctrl+W (bookmark)","hi":"Win+P पीसी लॉक करता है, Win+S डेस्कटॉप दिखाता है; Chrome: Ctrl+W (बुकमार्क)"},{"en":"Win+O locks PC, Win+M shows desktop; Chrome: Ctrl+S (bookmark)","hi":"Win+O पीसी लॉक करता है, Win+M डेस्कटॉप दिखाता है; Chrome: Ctrl+S (बुकमार्क)"}],"exp":{"en":"General OS/Browser shortcuts noted: Windows+L locks the screen, Windows+D shows the desktop, Alt+Tab switches apps. In Google Chrome: Ctrl+Tab moves to the next tab, Ctrl+Page Up moves to the previous tab, and Ctrl+D bookmarks the current page.","hi":"नोट्स के अनुसार Windows में: Win+L पीसी लॉक करता है, Win+D डेस्कटॉप दिखाता है, Alt+Tab ऐप्स स्विच करता है। Chrome में: Ctrl+Tab अगला टैब, Ctrl+Page Up पिछला टैब, और Ctrl+D बुकमार्क बनाता है।"},"num":83},{"id":"q84","q":{"en":"Which function key examples for Windows / File Explorer are correctly described?","hi":"Windows / फाइल एक्सप्लोरर के लिए फंक्शन कुंजियों (Function keys) के कौन-से उदाहरण सही हैं?"},"a":{"en":"F1 Help, F2 rename, F3 search, F4 address-bar list, F5 refresh (Alt+Print Screen captures the active window)","hi":"F1 हेल्प, F2 रीनेम (नाम बदलना), F3 सर्च, F4 एड्रेस-बार लिस्ट, F5 रिफ्रेश (तथा Alt+Print Screen सक्रिय विंडो कैप्चर करता है)"},"o":[{"en":"F1 Help, F2 rename, F3 search, F4 address-bar list, F5 refresh (Alt+Print Screen captures the active window)","hi":"F1 हेल्प, F2 रीनेम (नाम बदलना), F3 सर्च, F4 एड्रेस-बार लिस्ट, F5 रिफ्रेश (तथा Alt+Print Screen सक्रिय विंडो कैप्चर करता है)"},{"en":"F1 save, F2 delete, F3 refresh, F4 undo, F5 redo","hi":"F1 सेव, F2 डिलीट, F3 रिफ्रेश, F4 अनडू, F5 रीडू"},{"en":"F1 format, F2 copy, F3 paste, F4 cut, F5 print","hi":"F1 फॉर्मेट, F2 कॉपी, F3 पेस्ट, F4 कट, F5 प्रिंट"},{"en":"F1 volume down, F2 volume up, F3 mute, F4 brightness down, F5 brightness up","hi":"F1 वॉल्यूम डाउन, F2 वॉल्यूम अप, F3 म्यूट, F4 ब्राइटनेस डाउन, F5 ब्राइटनेस अप"}],"exp":{"en":"Standard Windows/Explorer behavior: F1 opens Help, F2 renames the selected item, F3 opens Search, F4 focuses the address bar list, and F5 refreshes the active window. Also, Alt+Print Screen captures only the currently active window.","hi":"Windows में: F1 (Help), F2 (फ़ाइल/फ़ोल्डर का नाम बदलना), F3 (सर्च), F4 (एड्रेस-बार लिस्ट) और F5 (रिफ्रेश) का उपयोग होता है। (Alt+Print Screen केवल सक्रिय विंडो को कैप्चर करता है)।"},"num":84},{"id":"q85","q":{"en":"What is the source action of 'Alt+click' in MS Word?","hi":"MS Word में 'Alt+click' का स्रोत कार्य (Source action) क्या है?"},"a":{"en":"In older Word versions, it opens the Research pane for the selected word (feature availability depends on the Word version)","hi":"पुराने Word संस्करणों में, यह चयनित शब्द के लिए 'रिसर्च पेन' (Research pane) खोलता है (यह सुविधा Word के संस्करण पर निर्भर करती है)"},"o":[{"en":"It deletes the entire sentence","hi":"यह पूरे वाक्य को डिलीट कर देता है"},{"en":"In older Word versions, it opens the Research pane for the selected word (feature availability depends on the Word version)","hi":"पुराने Word संस्करणों में, यह चयनित शब्द के लिए 'रिसर्च पेन' (Research pane) खोलता है (यह सुविधा Word के संस्करण पर निर्भर करती है)"},{"en":"It changes the font color to red","hi":"यह फ़ॉन्ट का रंग लाल कर देता है"},{"en":"It inserts a page break","hi":"यह एक पेज ब्रेक डालता है"}],"exp":{"en":"In older versions of MS Word (like Word 2010), holding Alt and clicking a word opens the Research task pane to look up definitions and synonyms. In newer Microsoft 365 versions, this feature may be replaced or turned off by default.","hi":"पुराने MS Word (जैसे Word 2010) में किसी शब्द पर Alt के साथ क्लिक (Alt+click) करने से 'रिसर्च पेन' (Research pane) खुलता है, जिससे शब्द के अर्थ और पर्यायवाची खोजे जा सकते हैं।"},"num":85}]},{"title":{"en":"4. Word Function Keys F1–F12","hi":"4. वर्ड फंक्शन कीज़ F1–F12"},"questions":[{"id":"q86","q":{"en":"What do 'F1' and 'Shift+F1' do in MS Word?","hi":"MS Word में 'F1' और 'Shift+F1' क्या करते हैं?"},"a":{"en":"F1 opens Help; Shift+F1 opens context-sensitive help or the Reveal Formatting pane","hi":"F1 'हेल्प' (Help) खोलता है; Shift+F1 कॉन्टेक्स्ट-सेंसिटिव हेल्प या 'रिवील फॉर्मेटिंग' (Reveal Formatting) पेन खोलता है"},"o":[{"en":"F1 saves the file; Shift+F1 prints it","hi":"F1 फाइल सेव करता है; Shift+F1 उसे प्रिंट करता है"},{"en":"F1 opens Help; Shift+F1 opens context-sensitive help or the Reveal Formatting pane","hi":"F1 'हेल्प' (Help) खोलता है; Shift+F1 कॉन्टेक्स्ट-सेंसिटिव हेल्प या 'रिवील फॉर्मेटिंग' (Reveal Formatting) पेन खोलता है"},{"en":"F1 deletes text; Shift+F1 recovers it","hi":"F1 टेक्स्ट डिलीट करता है; Shift+F1 उसे रिकवर करता है"},{"en":"F1 opens the Home tab; Shift+F1 opens the Insert tab","hi":"F1 होम टैब खोलता है; Shift+F1 इंसर्ट टैब खोलता है"}],"exp":{"en":"In MS Word, F1 always opens the Help window/pane. Shift+F1 activates the Reveal Formatting task pane (or the legacy 'What's This?' context-sensitive help pointer).","hi":"Word में F1 कुंजी Help (सहायता) खोलती है, जबकि Shift+F1 'Reveal Formatting' टास्क पेन (या पुराने वर्ज़न में कॉन्टेक्स्ट-सेंसिटिव हेल्प) खोलता है।"},"num":86},{"id":"q87","q":{"en":"What are the actions of 'Ctrl+F1', 'Alt+F1', and 'Alt+Shift+F1' respectively in MS Word?","hi":"MS Word में 'Ctrl+F1', 'Alt+F1' और 'Alt+Shift+F1' के क्या कार्य हैं?"},"a":{"en":"Ctrl+F1 shows/hides the Ribbon; Alt+F1 goes to the next field; Alt+Shift+F1 goes to the previous field","hi":"Ctrl+F1 रिबन को शो/हाइड (Show/hide) करता है; Alt+F1 अगले फील्ड (next field) पर जाता है; Alt+Shift+F1 पिछले फील्ड (previous field) पर जाता है"},"o":[{"en":"Ctrl+F1 shows/hides the Ribbon; Alt+F1 goes to the next field; Alt+Shift+F1 goes to the previous field","hi":"Ctrl+F1 रिबन को शो/हाइड (Show/hide) करता है; Alt+F1 अगले फील्ड (next field) पर जाता है; Alt+Shift+F1 पिछले फील्ड (previous field) पर जाता है"},{"en":"Ctrl+F1 minimizes the window; Alt+F1 maximizes it; Alt+Shift+F1 closes it","hi":"Ctrl+F1 विंडो को मिनिमाइज़ करता है; Alt+F1 मैक्सिमाइज़ करता है; Alt+Shift+F1 उसे बंद करता है"},{"en":"Ctrl+F1 copies text; Alt+F1 cuts it; Alt+Shift+F1 pastes it","hi":"Ctrl+F1 टेक्स्ट कॉपी करता है; Alt+F1 कट करता है; Alt+Shift+F1 पेस्ट करता है"},{"en":"Ctrl+F1 opens fonts; Alt+F1 opens colors; Alt+Shift+F1 opens borders","hi":"Ctrl+F1 फ़ॉन्ट खोलता है; Alt+F1 रंग खोलता है; Alt+Shift+F1 बॉर्डर खोलता है"}],"exp":{"en":"Ctrl+F1 expands or collapses the Ribbon. Alt+F1 moves to the next field in the document, and Alt+Shift+F1 moves to the previous field.","hi":"Word में Ctrl+F1 रिबन को दिखाने या छिपाने (Show/hide) के लिए है। Alt+F1 डॉक्यूमेंट में अगले फील्ड पर जाने के लिए और Alt+Shift+F1 पिछले फील्ड पर जाने के लिए है।"},"num":87},{"id":"q88","q":{"en":"What do 'F2' and 'Shift+F2' do in MS Word?","hi":"MS Word में 'F2' और 'Shift+F2' का क्या काम है?"},"a":{"en":"F2 moves selected text/graphic and Shift+F2 copies it (position the cursor and press Enter to complete, or Esc to cancel)","hi":"F2 सेलेक्ट किए गए टेक्स्ट/ग्राफिक को मूव (Move/Cut) करता है और Shift+F2 उसे कॉपी करता है (नई जगह पर कर्सर रखकर Enter दबाएँ, या रद्द करने के लिए Esc दबाएँ)"},"o":[{"en":"F2 moves selected text/graphic and Shift+F2 copies it (position the cursor and press Enter to complete, or Esc to cancel)","hi":"F2 सेलेक्ट किए गए टेक्स्ट/ग्राफिक को मूव (Move/Cut) करता है और Shift+F2 उसे कॉपी करता है (नई जगह पर कर्सर रखकर Enter दबाएँ, या रद्द करने के लिए Esc दबाएँ)"},{"en":"F2 deletes a word; Shift+F2 restores it","hi":"F2 एक शब्द को डिलीट करता है; Shift+F2 उसे रिस्टोर करता है"},{"en":"F2 opens the spell checker; Shift+F2 opens the thesaurus","hi":"F2 स्पेल चेकर खोलता है; Shift+F2 थिसॉरस खोलता है"},{"en":"F2 underlines text; Shift+F2 bolds text","hi":"F2 टेक्स्ट को अंडरलाइन करता है; Shift+F2 बोल्ड करता है"}],"exp":{"en":"In MS Word, selecting text and pressing F2 activates 'Move to where?' (cut). Pressing Shift+F2 activates 'Copy to where?' (copy). You then move the cursor and press Enter to paste.","hi":"Word में F2 कुंजी सेलेक्ट किए गए टेक्स्ट को मूव (Cut) करने के लिए और Shift+F2 कॉपी करने के लिए है। (इसके बाद कर्सर को नई जगह पर रखकर Enter दबाने से टेक्स्ट पेस्ट हो जाता है)।"},"num":88},{"id":"q89","q":{"en":"What are the actions of 'Ctrl+F2', 'Alt+Shift+F2', and 'Ctrl+Alt+F2' respectively in MS Word?","hi":"MS Word में 'Ctrl+F2', 'Alt+Shift+F2' और 'Ctrl+Alt+F2' का क्या कार्य है?"},"a":{"en":"Ctrl+F2 opens Print Preview, Alt+Shift+F2 opens Save, and Ctrl+Alt+F2 opens the Open dialog","hi":"क्रमशः Print Preview, Save और Open डायलॉग खोलते हैं"},"o":[{"en":"Ctrl+F2 opens Print Preview, Alt+Shift+F2 opens Save, and Ctrl+Alt+F2 opens the Open dialog","hi":"क्रमशः Print Preview, Save और Open डायलॉग खोलते हैं"},{"en":"Ctrl+F2 opens Fonts, Alt+Shift+F2 opens Paragraphs, and Ctrl+Alt+F2 opens Styles","hi":"क्रमशः Fonts, Paragraphs और Styles खोलते हैं"},{"en":"Ctrl+F2 closes the document, Alt+Shift+F2 minimizes Word, and Ctrl+Alt+F2 maximizes it","hi":"क्रमशः डॉक्यूमेंट बंद करता है, Word मिनिमाइज़ करता है, और मैक्सिमाइज़ करता है"},{"en":"Ctrl+F2 adds a table, Alt+Shift+F2 adds a picture, and Ctrl+Alt+F2 adds a chart","hi":"क्रमशः टेबल, पिक्चर और चार्ट जोड़ते हैं"}],"exp":{"en":"Ctrl+F2 opens the Backstage Print (Print Preview) view. Alt+Shift+F2 invokes the Save command. Ctrl+Alt+F2 opens the Open dialog box.","hi":"Word में Ctrl+F2 से Print Preview (प्रिंट प्रीव्यू) खुलता है, Alt+Shift+F2 से Save (सेव) होता है, और Ctrl+Alt+F2 से Open (ओपन) डायलॉग खुलता है।"},"num":89},{"id":"q90","q":{"en":"What do 'Shift+F3' and 'Alt+F3' do in MS Word?","hi":"MS Word में 'Shift+F3' और 'Alt+F3' क्या करते हैं?"},"a":{"en":"Shift+F3 cycles through selected text cases (lowercase, Title Case, UPPERCASE); Alt+F3 creates a new Building Block (Quick Part)","hi":"Shift+F3 सेलेक्ट किए गए टेक्स्ट के केस (lowercase, Title Case, UPPERCASE) को साइकिल करता है; Alt+F3 नया 'बिल्डिंग ब्लॉक' (Building Block) बनाता है"},"o":[{"en":"Shift+F3 highlights text; Alt+F3 changes the font color","hi":"Shift+F3 टेक्स्ट हाईलाइट करता है; Alt+F3 फ़ॉन्ट रंग बदलता है"},{"en":"Shift+F3 cycles through selected text cases (lowercase, Title Case, UPPERCASE); Alt+F3 creates a new Building Block (Quick Part)","hi":"Shift+F3 सेलेक्ट किए गए टेक्स्ट के केस (lowercase, Title Case, UPPERCASE) को साइकिल करता है; Alt+F3 नया 'बिल्डिंग ब्लॉक' (Building Block) बनाता है"},{"en":"Shift+F3 prints the document; Alt+F3 saves as PDF","hi":"Shift+F3 डॉक्यूमेंट प्रिंट करता है; Alt+F3 PDF के रूप में सेव करता है"},{"en":"Shift+F3 inserts a page break; Alt+F3 inserts a blank page","hi":"Shift+F3 पेज ब्रेक डालता है; Alt+F3 ब्लैंक पेज डालता है"}],"exp":{"en":"Selecting text and pressing Shift+F3 toggles its capitalization (lowercase, UPPERCASE, Title Case). Pressing Alt+F3 opens the 'Create New Building Block' dialog to save selected content as a Quick Part.","hi":"Shift+F3 सेलेक्ट किए गए टेक्स्ट के केस (लोअरकेस, अपरकेस, टाइटल केस) को बदलता है। Alt+F3 सेलेक्ट किए गए कंटेंट का एक नया 'बिल्डिंग ब्लॉक' (Building Block / Quick Part) बनाता है।"},"num":90},{"id":"q91","q":{"en":"How is content cut and pasted using the 'Spike' feature in MS Word?","hi":"MS Word के 'स्पाइक' (Spike) फीचर में कंटेंट को कट (Cut) और पेस्ट (Paste) कैसे किया जाता है?"},"a":{"en":"Ctrl+F3 cuts content to the Spike (adding to it), and Ctrl+Shift+F3 pastes the collected Spike content","hi":"Ctrl+F3 कंटेंट को स्पाइक में कट करता है (उसमें जोड़ता जाता है), और Ctrl+Shift+F3 जमा किए गए स्पाइक कंटेंट को पेस्ट करता है"},"o":[{"en":"Ctrl+F3 cuts content to the Spike (adding to it), and Ctrl+Shift+F3 pastes the collected Spike content","hi":"Ctrl+F3 कंटेंट को स्पाइक में कट करता है (उसमें जोड़ता जाता है), और Ctrl+Shift+F3 जमा किए गए स्पाइक कंटेंट को पेस्ट करता है"},{"en":"Ctrl+S cuts to the Spike; Ctrl+V pastes it","hi":"Ctrl+S स्पाइक में कट करता है; Ctrl+V पेस्ट करता है"},{"en":"Shift+F1 cuts to the Spike; Shift+F2 pastes it","hi":"Shift+F1 स्पाइक में कट करता है; Shift+F2 पेस्ट करता है"},{"en":"Alt+C cuts to the Spike; Alt+P pastes it","hi":"Alt+C स्पाइक में कट करता है; Alt+P पेस्ट करता है"}],"exp":{"en":"The Spike is a special Word clipboard that accumulates text. Ctrl+F3 cuts and appends selected text to the Spike, while Ctrl+Shift+F3 inserts all the collected text and empties the Spike.","hi":"Spike एक विशेष क्लिपबोर्ड है जो कई टेक्स्ट को जमा करता है। Ctrl+F3 सेलेक्ट किए गए टेक्स्ट को कट करके स्पाइक में जोड़ता है, और Ctrl+Shift+F3 स्पाइक में जमा हुए सभी कंटेंट को एक साथ पेस्ट करता है।"},"num":91},{"id":"q92","q":{"en":"What are the actions of 'F4', 'Shift+F4', 'Ctrl+F4', and 'Alt+F4' respectively in MS Word?","hi":"MS Word में क्रमशः 'F4', 'Shift+F4', 'Ctrl+F4' और 'Alt+F4' का एक्शन क्या है?"},"a":{"en":"Repeat last action, repeat last Find/Go To, close current document, and close Word/window","hi":"क्रमशः लास्ट एक्शन रिपीट करना, लास्ट Find/Go To रिपीट करना, वर्तमान डॉक्यूमेंट बंद करना, और Word/विंडो बंद करना"},"o":[{"en":"Repeat last action, repeat last Find/Go To, close current document, and close Word/window","hi":"क्रमशः लास्ट एक्शन रिपीट करना, लास्ट Find/Go To रिपीट करना, वर्तमान डॉक्यूमेंट बंद करना, और Word/विंडो बंद करना"},{"en":"Save file, Open file, Print file, and Share file","hi":"सेव, ओपन, प्रिंट और शेयर"},{"en":"Align left, Align center, Align right, and Justify","hi":"एलाइन लेफ्ट, सेंटर, राइट और जस्टिफाई"},{"en":"Insert table, Insert picture, Insert chart, and Insert hyperlink","hi":"टेबल, पिक्चर, चार्ट और हाइपरलिंक इन्सर्ट करना"}],"exp":{"en":"F4 repeats the last typing/formatting action. Shift+F4 repeats the last Find/Go To search. Ctrl+F4 closes the active document window. Alt+F4 exits the entire Word application.","hi":"F4 पिछला एक्शन रिपीट करता है, Shift+F4 पिछली खोज (Find) रिपीट करता है, Ctrl+F4 केवल वर्तमान डॉक्यूमेंट को बंद करता है, और Alt+F4 पूरे Word एप्लिकेशन को बंद करता है।"},"num":92},{"id":"q93","q":{"en":"What are the actions of 'F5' and 'Shift+F5' in MS Word?","hi":"MS Word में 'F5' और 'Shift+F5' का एक्शन क्या है?"},"a":{"en":"F5 opens the Go To dialog; Shift+F5 jumps to the most recent edit location","hi":"F5 'Go To' डायलॉग खोलता है; Shift+F5 सबसे हालिया एडिट लोकेशन (recent edit location) पर जंप करता है"},"o":[{"en":"F5 refreshes the page; Shift+F5 prints it","hi":"F5 पेज रिफ्रेश करता है; Shift+F5 उसे प्रिंट करता है"},{"en":"F5 opens the Go To dialog; Shift+F5 jumps to the most recent edit location","hi":"F5 'Go To' डायलॉग खोलता है; Shift+F5 सबसे हालिया एडिट लोकेशन (recent edit location) पर जंप करता है"},{"en":"F5 saves the document; Shift+F5 opens it","hi":"F5 डॉक्यूमेंट सेव करता है; Shift+F5 उसे खोलता है"},{"en":"F5 aligns text to the left; Shift+F5 aligns text to the right","hi":"F5 टेक्स्ट को बाएँ एलाइन करता है; Shift+F5 दाएँ एलाइन करता है"}],"exp":{"en":"In MS Word, pressing F5 opens the Find and Replace dialog directly to the 'Go To' tab. Shift+F5 cycles the cursor back through the last few places where you made edits in the document.","hi":"F5 कुंजी 'Go To' डायलॉग खोलती है। Shift+F5 दबाने से कर्सर डॉक्यूमेंट में वहाँ पहुँच जाता है जहाँ आपने सबसे हाल ही में कोई संपादन (edit) किया था।"},"num":93},{"id":"q94","q":{"en":"What do 'Ctrl+Shift+F5' and 'Alt+F5' do in MS Word?","hi":"MS Word में 'Ctrl+Shift+F5' और 'Alt+F5' क्या करते हैं?"},"a":{"en":"Ctrl+Shift+F5 opens the Bookmark dialog; Alt+F5 restores the document window size","hi":"Ctrl+Shift+F5 बुकमार्क डायलॉग खोलता है; Alt+F5 विंडो साइज़ को रिस्टोर (restore) करता है"},"o":[{"en":"Ctrl+Shift+F5 opens the Bookmark dialog; Alt+F5 restores the document window size","hi":"Ctrl+Shift+F5 बुकमार्क डायलॉग खोलता है; Alt+F5 विंडो साइज़ को रिस्टोर (restore) करता है"},{"en":"Ctrl+Shift+F5 deletes a word; Alt+F5 inserts a picture","hi":"Ctrl+Shift+F5 शब्द डिलीट करता है; Alt+F5 पिक्चर डालता है"},{"en":"Ctrl+Shift+F5 changes font style; Alt+F5 changes paragraph spacing","hi":"Ctrl+Shift+F5 फ़ॉन्ट स्टाइल बदलता है; Alt+F5 पैराग्राफ स्पेसिंग बदलता है"},{"en":"Ctrl+Shift+F5 creates a macro; Alt+F5 deletes it","hi":"Ctrl+Shift+F5 मैक्रो बनाता है; Alt+F5 उसे डिलीट करता है"}],"exp":{"en":"Pressing Ctrl+Shift+F5 opens the Bookmark dialog box to add or navigate to bookmarks. Alt+F5 restores a maximized document window to its previous smaller size.","hi":"Ctrl+Shift+F5 कुंजी से बुकमार्क (Bookmark) डायलॉग बॉक्स खुलता है, और Alt+F5 मैक्सिमाइज़ (maximize) की गई डॉक्यूमेंट विंडो को उसके पिछले छोटे साइज़ में रिस्टोर करता है।"},"num":94},{"id":"q95","q":{"en":"What do 'F6' and 'Shift+F6' do in MS Word?","hi":"MS Word में 'F6' और 'Shift+F6' क्या करते हैं?"},"a":{"en":"Cycle focus forward/reverse between the document, task pane, status bar, and Ribbon (split panes can also be part of the cycle)","hi":"डॉक्यूमेंट, टास्क पेन, स्टेटस बार और रिबन के बीच फॉरवर्ड/रिवर्स फोकस साइकिल करते हैं (विभाजित पेन भी इस साइकिल का हिस्सा हो सकते हैं)"},"o":[{"en":"F6 saves the document; Shift+F6 prints it","hi":"F6 डॉक्यूमेंट सेव करता है; Shift+F6 उसे प्रिंट करता है"},{"en":"F6 changes font color; Shift+F6 changes font size","hi":"F6 फ़ॉन्ट रंग बदलता है; Shift+F6 फ़ॉन्ट साइज़ बदलता है"},{"en":"Cycle focus forward/reverse between the document, task pane, status bar, and Ribbon (split panes can also be part of the cycle)","hi":"डॉक्यूमेंट, टास्क पेन, स्टेटस बार और रिबन के बीच फॉरवर्ड/रिवर्स फोकस साइकिल करते हैं (विभाजित पेन भी इस साइकिल का हिस्सा हो सकते हैं)"},{"en":"F6 opens the Thesaurus; Shift+F6 opens the Spelling checker","hi":"F6 थिसॉरस खोलता है; Shift+F6 स्पेलिंग चेकर खोलता है"}],"exp":{"en":"F6 moves keyboard focus to the next pane (e.g., from document to task pane, to status bar, to Ribbon tabs). Shift+F6 cycles focus in the reverse direction. If the window is split, it also cycles between the split document panes.","hi":"F6 कुंजी कीबोर्ड फोकस को डॉक्यूमेंट, खुले हुए टास्क पेन, स्टेटस बार और रिबन के बीच आगे (forward) घुमाती है। Shift+F6 यही काम उल्टी दिशा (reverse) में करता है।"},"num":95},{"id":"q96","q":{"en":"What do 'Ctrl+F6', 'Ctrl+Shift+F6', and 'Alt+F6' do in MS Word?","hi":"MS Word में 'Ctrl+F6', 'Ctrl+Shift+F6' और 'Alt+F6' क्या करते हैं?"},"a":{"en":"Switch to next open document, switch to previous open document, and return to document focus from a supported dialog","hi":"क्रमशः अगले खुले डॉक्यूमेंट पर जाना, पिछले खुले डॉक्यूमेंट पर जाना, और किसी समर्थित डायलॉग से डॉक्यूमेंट फोकस पर वापस आना"},"o":[{"en":"Switch to next open document, switch to previous open document, and return to document focus from a supported dialog","hi":"क्रमशः अगले खुले डॉक्यूमेंट पर जाना, पिछले खुले डॉक्यूमेंट पर जाना, और किसी समर्थित डायलॉग से डॉक्यूमेंट फोकस पर वापस आना"},{"en":"Zoom in, Zoom out, and Fit to page","hi":"ज़ूम इन, ज़ूम आउट और फिट टू पेज"},{"en":"Align left, Align center, and Align right","hi":"एलाइन लेफ्ट, सेंटर और राइट"},{"en":"Open File menu, Open Home menu, and Open Insert menu","hi":"फाइल मेनू, होम मेनू और इंसर्ट मेनू खोलना"}],"exp":{"en":"If multiple Word documents are open, Ctrl+F6 switches to the next window and Ctrl+Shift+F6 switches to the previous one. Alt+F6 switches focus from an open dialog box back to the document.","hi":"यदि कई Word डॉक्यूमेंट खुले हैं, तो Ctrl+F6 अगले (next) डॉक्यूमेंट पर ले जाता है और Ctrl+Shift+F6 पिछले (previous) डॉक्यूमेंट पर ले जाता है। Alt+F6 किसी डायलॉग बॉक्स से वापस डॉक्यूमेंट पर फोकस लाता है।"},"num":96},{"id":"q97","q":{"en":"What do 'F7' and 'Shift+F7' do in MS Word?","hi":"MS Word में 'F7' और 'Shift+F7' क्या करते हैं?"},"a":{"en":"F7 opens the spelling/grammar Editor; Shift+F7 opens the Thesaurus","hi":"F7 स्पेलिंग/ग्रामर 'एडिटर' (Editor) खोलता है; Shift+F7 'थिसॉरस' (Thesaurus) खोलता है"},"o":[{"en":"F7 saves the file; Shift+F7 closes the application","hi":"F7 फाइल सेव करता है; Shift+F7 एप्लिकेशन बंद करता है"},{"en":"F7 opens the spelling/grammar Editor; Shift+F7 opens the Thesaurus","hi":"F7 स्पेलिंग/ग्रामर 'एडिटर' (Editor) खोलता है; Shift+F7 'थिसॉरस' (Thesaurus) खोलता है"},{"en":"F7 changes text case; Shift+F7 bolds text","hi":"F7 टेक्स्ट केस बदलता है; Shift+F7 टेक्स्ट को बोल्ड करता है"},{"en":"F7 inserts a table; Shift+F7 inserts a picture","hi":"F7 टेबल डालता है; Shift+F7 पिक्चर डालता है"}],"exp":{"en":"F7 runs the Spelling and Grammar check (opening the Editor pane in modern Word). Shift+F7 opens the Thesaurus pane for the currently selected word.","hi":"Word में F7 कुंजी से स्पेलिंग और ग्रामर (Editor) की जाँच शुरू होती है। Shift+F7 सेलेक्ट किए गए शब्द के पर्यायवाची खोजने के लिए थिसॉरस (Thesaurus) खोलता है।"},"num":97},{"id":"q98","q":{"en":"What do 'Ctrl+Shift+F7', 'Alt+F7', and 'Alt+Shift+F7' do in MS Word?","hi":"MS Word में 'Ctrl+Shift+F7', 'Alt+F7' और 'Alt+Shift+F7' क्या करते हैं?"},"a":{"en":"Update linked source info, find next spelling/grammar issue, and open Translator pane","hi":"क्रमशः लिंक्ड सोर्स इन्फो अपडेट करना, अगली स्पेलिंग/ग्रामर त्रुटि (issue) खोजना, और ट्रांसलेटर (Translator) पेन खोलना"},"o":[{"en":"Update linked source info, find next spelling/grammar issue, and open Translator pane","hi":"क्रमशः लिंक्ड सोर्स इन्फो अपडेट करना, अगली स्पेलिंग/ग्रामर त्रुटि (issue) खोजना, और ट्रांसलेटर (Translator) पेन खोलना"},{"en":"Cut, Copy, and Paste text","hi":"टेक्स्ट को कट, कॉपी और पेस्ट करना"},{"en":"Insert page break, Insert line break, and Insert column break","hi":"पेज ब्रेक, लाइन ब्रेक और कॉलम ब्रेक डालना"},{"en":"Add bookmark, Add hyperlink, and Add cross-reference","hi":"बुकमार्क, हाइपरलिंक और क्रॉस-रेफरेंस जोड़ना"}],"exp":{"en":"Ctrl+Shift+F7 updates linked information in a source document. Alt+F7 jumps to the next spelling or grammatical error. Alt+Shift+F7 opens the Translator (Dictionary) task pane.","hi":"Ctrl+Shift+F7 स्रोत डॉक्यूमेंट में लिंक्ड जानकारी अपडेट करता है, Alt+F7 अगली स्पेलिंग या ग्रामर की गलती (error) पर जाता है, और Alt+Shift+F7 ट्रांसलेटर (Translator) पेन खोलता है।"},"num":98},{"id":"q99","q":{"en":"What are the actions of 'F8', 'Shift+F8', and 'Ctrl+Shift+F8' in MS Word?","hi":"MS Word में 'F8', 'Shift+F8' और 'Ctrl+Shift+F8' का एक्शन क्या है?"},"a":{"en":"Extend selection (character, word, sentence, paragraph), reduce selection, and toggle extend-selection mode according to Microsoft's function-key list","hi":"क्रमशः सेलेक्शन बढ़ाना (character, word, sentence, paragraph), सेलेक्शन कम करना, और Microsoft की सूची के अनुसार 'एक्सटेंड-सेलेक्शन मोड' (extend-selection mode) टॉगल करना"},"o":[{"en":"Extend selection (character, word, sentence, paragraph), reduce selection, and toggle extend-selection mode according to Microsoft's function-key list","hi":"क्रमशः सेलेक्शन बढ़ाना (character, word, sentence, paragraph), सेलेक्शन कम करना, और Microsoft की सूची के अनुसार 'एक्सटेंड-सेलेक्शन मोड' (extend-selection mode) टॉगल करना"},{"en":"Save, Save As, and Print","hi":"सेव, सेव ऐज़, और प्रिंट"},{"en":"Undo, Redo, and Repeat","hi":"अनडू, रीडू, और रिपीट"},{"en":"Open file, Close file, and Delete file","hi":"ओपन फाइल, क्लोज फाइल, और डिलीट फाइल"}],"exp":{"en":"F8 turns on extend mode (pressing it repeatedly expands selection from a word to a sentence, paragraph, and whole document). Shift+F8 shrinks the selection. Ctrl+Shift+F8 toggles extend selection mode (block selection).","hi":"F8 'एक्सटेंड मोड' चालू करता है (इसे बार-बार दबाने से सेलेक्शन शब्द से वाक्य, फिर पैराग्राफ तक बढ़ता है)। Shift+F8 सेलेक्शन को कम करता है, और Ctrl+Shift+F8 एक्सटेंड-सेलेक्शन मोड को टॉगल करता है।"},"num":99},{"id":"q100","q":{"en":"What is the function-key shortcut for the Macro dialog in MS Word, and what can you do there?","hi":"MS Word में मैक्रो (Macro) डायलॉग का फंक्शन-की शॉर्टकट क्या है और वहां क्या किया जा सकता है?"},"a":{"en":"Alt+F8; you can create, run, edit, or delete macros","hi":"Alt+F8; इसमें मैक्रो को क्रिएट (create), रन (run), एडिट (edit) या डिलीट (delete) कर सकते हैं"},"o":[{"en":"Alt+F8; you can create, run, edit, or delete macros","hi":"Alt+F8; इसमें मैक्रो को क्रिएट (create), रन (run), एडिट (edit) या डिलीट (delete) कर सकते हैं"},{"en":"F2; you can rename files","hi":"F2; इससे फाइल का नाम बदल सकते हैं"},{"en":"Ctrl+F8; you can change font sizes","hi":"Ctrl+F8; इससे फ़ॉन्ट साइज़ बदल सकते हैं"},{"en":"Shift+F8; you can count words","hi":"Shift+F8; इससे शब्द गिन सकते हैं"}],"exp":{"en":"Pressing Alt+F8 opens the Macros dialog box, where you can view the list of available macros to run, step into, edit, create, or delete them.","hi":"Alt+F8 दबाने से Macros डायलॉग बॉक्स खुलता है, जहाँ से आप उपलब्ध मैक्रोज़ को रन, एडिट, क्रिएट या डिलीट कर सकते हैं।"},"num":100},{"id":"q101","q":{"en":"What do 'F9', 'Shift+F9', and 'Ctrl+F9' do in MS Word?","hi":"MS Word में 'F9', 'Shift+F9' और 'Ctrl+F9' क्या करते हैं?"},"a":{"en":"Update selected fields, toggle selected field code/result, and insert a blank field (curly braces)","hi":"क्रमशः चयनित फील्ड्स (selected fields) को अपडेट करना, चयनित फील्ड कोड/रिजल्ट को टॉगल करना, और एक ब्लैंक फील्ड { } डालना"},"o":[{"en":"Update selected fields, toggle selected field code/result, and insert a blank field (curly braces)","hi":"क्रमशः चयनित फील्ड्स (selected fields) को अपडेट करना, चयनित फील्ड कोड/रिजल्ट को टॉगल करना, और एक ब्लैंक फील्ड { } डालना"},{"en":"Change text case, bold text, and underline text","hi":"टेक्स्ट केस बदलना, बोल्ड करना और अंडरलाइन करना"},{"en":"Zoom in, Zoom out, and Print","hi":"ज़ूम इन, ज़ूम आउट और प्रिंट"},{"en":"Open Word, Close Word, and Save Word","hi":"Word खोलना, बंद करना और सेव करना"}],"exp":{"en":"F9 updates dynamic fields (like date, TOC). Shift+F9 toggles between viewing the field code (e.g., { DATE }) and its result. Ctrl+F9 inserts empty field braces { } to manually create a field.","hi":"F9 चयनित फील्ड्स (जैसे TOC या डेट) को अपडेट करता है। Shift+F9 फील्ड कोड और उसके रिजल्ट के बीच टॉगल करता है। Ctrl+F9 मैन्युअल रूप से फील्ड बनाने के लिए ब्लैंक { } ब्रेसिज़ डालता है।"},"num":101},{"id":"q102","q":{"en":"What do 'Ctrl+Shift+F9', 'Alt+F9', and 'Alt+Shift+F9' do in MS Word?","hi":"MS Word में 'Ctrl+Shift+F9', 'Alt+F9' और 'Alt+Shift+F9' क्या करते हैं?"},"a":{"en":"Unlink a field (convert to plain text), toggle all field codes/results in the document, and run a supported GOTOBUTTON/MACROBUTTON field","hi":"क्रमशः फील्ड को अनलिंक (unlink) करना (प्लेन टेक्स्ट में बदलना), डॉक्यूमेंट के सभी फील्ड कोड्स/रिजल्ट्स को टॉगल करना, और समर्थित GOTOBUTTON/MACROBUTTON फील्ड रन करना"},"o":[{"en":"Unlink a field (convert to plain text), toggle all field codes/results in the document, and run a supported GOTOBUTTON/MACROBUTTON field","hi":"क्रमशः फील्ड को अनलिंक (unlink) करना (प्लेन टेक्स्ट में बदलना), डॉक्यूमेंट के सभी फील्ड कोड्स/रिजल्ट्स को टॉगल करना, और समर्थित GOTOBUTTON/MACROBUTTON फील्ड रन करना"},{"en":"Add page numbers, delete page numbers, and format page numbers","hi":"पेज नंबर जोड़ना, हटाना और फॉर्मेट करना"},{"en":"Open Font dialog, Open Paragraph dialog, and Open Styles pane","hi":"फ़ॉन्ट डायलॉग, पैराग्राफ डायलॉग और स्टाइल्स पेन खोलना"},{"en":"Check spelling, Check grammar, and Check word count","hi":"स्पेलिंग, ग्रामर और वर्ड काउंट चेक करना"}],"exp":{"en":"Ctrl+Shift+F9 unlinks a field (permanently replacing it with its current text result). Alt+F9 toggles field codes on or off for the entire document. Alt+Shift+F9 runs a GOTOBUTTON or MACROBUTTON from the field results.","hi":"Ctrl+Shift+F9 फील्ड को अनलिंक (प्लेन टेक्स्ट) कर देता है। Alt+F9 पूरे डॉक्यूमेंट के सभी फील्ड कोड्स/रिजल्ट्स को एक साथ टॉगल करता है। Alt+Shift+F9 समर्थित बटन फील्ड को रन करता है।"},"num":102},{"id":"q103","q":{"en":"What do 'F10', 'Shift+F10', and 'Ctrl+F10' do in MS Word?","hi":"MS Word में 'F10', 'Shift+F10' और 'Ctrl+F10' क्या करते हैं?"},"a":{"en":"Toggle KeyTips, open the right-click context menu, and maximize/restore the document window","hi":"क्रमशः 'की-टिप्स' (KeyTips) टॉगल करना, राइट-क्लिक कॉन्टेक्स्ट मेनू (context menu) खोलना, और डॉक्यूमेंट विंडो को मैक्सिमाइज़/रिस्टोर करना"},"o":[{"en":"Toggle KeyTips, open the right-click context menu, and maximize/restore the document window","hi":"क्रमशः 'की-टिप्स' (KeyTips) टॉगल करना, राइट-क्लिक कॉन्टेक्स्ट मेनू (context menu) खोलना, और डॉक्यूमेंट विंडो को मैक्सिमाइज़/रिस्टोर करना"},{"en":"Save file, Print file, and Share file","hi":"फाइल सेव करना, प्रिंट करना और शेयर करना"},{"en":"Add bookmark, Add hyperlink, and Add cross-reference","hi":"बुकमार्क, हाइपरलिंक और क्रॉस-रेफरेंस जोड़ना"},{"en":"Align left, Align center, and Align right","hi":"एलाइन लेफ्ट, सेंटर और राइट"}],"exp":{"en":"F10 (like the Alt key) displays KeyTips on the Ribbon. Shift+F10 acts like a right-click, opening the context menu for the selection. Ctrl+F10 maximizes or restores the active document window.","hi":"F10 रिबन पर की-टिप्स (KeyTips) दिखाता है। Shift+F10 माउस के राइट-क्लिक की तरह कॉन्टेक्स्ट मेनू खोलता है। Ctrl+F10 डॉक्यूमेंट विंडो को मैक्सिमाइज़ या रिस्टोर करता है।"},"num":103},{"id":"q104","q":{"en":"What are the actions of 'Alt+F10' and 'Alt+Shift+F10' in MS Word?","hi":"MS Word में 'Alt+F10' और 'Alt+Shift+F10' का एक्शन क्या है?"},"a":{"en":"Open the Selection pane and display a menu of available actions/options (like paste or AutoCorrect options)","hi":"क्रमशः 'सेलेक्शन' (Selection) पेन खोलना और उपलब्ध एक्शन/विकल्पों (जैसे पेस्ट या AutoCorrect विकल्प) का मेनू प्रदर्शित करना"},"o":[{"en":"Open the Selection pane and display a menu of available actions/options (like paste or AutoCorrect options)","hi":"क्रमशः 'सेलेक्शन' (Selection) पेन खोलना और उपलब्ध एक्शन/विकल्पों (जैसे पेस्ट या AutoCorrect विकल्प) का मेनू प्रदर्शित करना"},{"en":"Change font size and change font color","hi":"फ़ॉन्ट साइज़ और फ़ॉन्ट कलर बदलना"},{"en":"Undo last action and Redo last action","hi":"पिछला एक्शन अनडू और रीडू करना"},{"en":"Insert page break and Insert line break","hi":"पेज ब्रेक और लाइन ब्रेक डालना"}],"exp":{"en":"Alt+F10 opens the Selection task pane (useful for managing shapes/graphics). Alt+Shift+F10 displays a menu or message for an available action, such as the smart tag menu for AutoCorrect or Paste Options.","hi":"Alt+F10 से 'सेलेक्शन' (Selection) टास्क पेन खुलता है। Alt+Shift+F10 किसी उपलब्ध स्मार्ट टैग, पेस्ट विकल्प या AutoCorrect विकल्पों का मेनू खोलता है।"},"num":104},{"id":"q105","q":{"en":"What do 'F11', 'Shift+F11', 'Ctrl+F11', and 'Ctrl+Shift+F11' do in MS Word?","hi":"MS Word में 'F11', 'Shift+F11', 'Ctrl+F11' और 'Ctrl+Shift+F11' क्या करते हैं?"},"a":{"en":"Go to the next field, previous field, lock field, and unlock field respectively","hi":"क्रमशः अगले फील्ड पर जाना, पिछले फील्ड पर जाना, फील्ड को लॉक करना, और फील्ड को अनलॉक करना"},"o":[{"en":"Go to the next field, previous field, lock field, and unlock field respectively","hi":"क्रमशः अगले फील्ड पर जाना, पिछले फील्ड पर जाना, फील्ड को लॉक करना, और फील्ड को अनलॉक करना"},{"en":"Bold text, Italicize text, Underline text, and Strikethrough text","hi":"टेक्स्ट बोल्ड, इटैलिक, अंडरलाइन और स्ट्राइकथ्रू करना"},{"en":"Zoom to 100%, Zoom to 200%, Zoom to page width, and Zoom to whole page","hi":"ज़ूम 100%, 200%, पेज चौड़ाई, और पूरे पेज तक ज़ूम करना"},{"en":"Insert table, Delete table, Merge cells, and Split cells","hi":"टेबल डालना, टेबल हटाना, सेल मर्ज करना, और सेल स्प्लिट करना"}],"exp":{"en":"F11 moves to the next field in the document. Shift+F11 moves to the previous field. Ctrl+F11 locks the current field (preventing updates), and Ctrl+Shift+F11 unlocks a locked field.","hi":"F11 अगले फील्ड और Shift+F11 पिछले फील्ड पर ले जाता है। Ctrl+F11 चयनित फील्ड को लॉक कर देता है (ताकि वह अपडेट न हो), और Ctrl+Shift+F11 उसे अनलॉक करता है।"},"num":105},{"id":"q106","q":{"en":"What does 'Alt+F11' open in MS Word?","hi":"MS Word में 'Alt+F11' क्या खोलता है?"},"a":{"en":"The Visual Basic for Applications (VBA) editor","hi":"विजुअल बेसिक फॉर एप्लिकेशंस (VBA) एडिटर"},"o":[{"en":"The Visual Basic for Applications (VBA) editor","hi":"विजुअल बेसिक फॉर एप्लिकेशंस (VBA) एडिटर"},{"en":"The Print dialog box","hi":"प्रिंट डायलॉग बॉक्स"},{"en":"The Font dialog box","hi":"फ़ॉन्ट डायलॉग बॉक्स"},{"en":"The Paragraph dialog box","hi":"पैराग्राफ डायलॉग बॉक्स"}],"exp":{"en":"Pressing Alt+F11 in Word (or Excel/PowerPoint) launches the Visual Basic for Applications (VBA) editor, where you can write and edit macro code.","hi":"Word, Excel या PowerPoint में Alt+F11 दबाने से Visual Basic for Applications (VBA) एडिटर खुलता है, जहाँ मैक्रो कोड लिखा या एडिट किया जाता है।"},"num":106},{"id":"q107","q":{"en":"What are the actions of 'F12', 'Shift+F12', and 'Ctrl+F12' in MS Word?","hi":"MS Word में 'F12', 'Shift+F12' और 'Ctrl+F12' का एक्शन क्या है?"},"a":{"en":"Save As dialog, Save (like Ctrl+S), and Open dialog (like Ctrl+O)","hi":"क्रमशः 'Save As' डायलॉग, Save करना (Ctrl+S की तरह), और 'Open' डायलॉग (Ctrl+O की तरह)"},"o":[{"en":"Save As dialog, Save (like Ctrl+S), and Open dialog (like Ctrl+O)","hi":"क्रमशः 'Save As' डायलॉग, Save करना (Ctrl+S की तरह), और 'Open' डायलॉग (Ctrl+O की तरह)"},{"en":"Print preview, Print, and Page setup","hi":"प्रिंट प्रीव्यू, प्रिंट और पेज सेटअप"},{"en":"Copy, Cut, and Paste","hi":"कॉपी, कट और पेस्ट"},{"en":"Find, Replace, and Go To","hi":"फाइंड, रिप्लेस और गो टू"}],"exp":{"en":"F12 opens the Save As dialog box. Shift+F12 executes the Save command (saving the current document). Ctrl+F12 opens the Open dialog box.","hi":"F12 से 'Save As' डायलॉग खुलता है, Shift+F12 फाइल को Save करता है (Ctrl+S की तरह), और Ctrl+F12 से 'Open' डायलॉग खुलता है (Ctrl+O की तरह)।"},"num":107},{"id":"q108","q":{"en":"What are the uses of 'Ctrl+Shift+F12' and 'Alt+Shift+F12' in MS Word?","hi":"MS Word में 'Ctrl+Shift+F12' और 'Alt+Shift+F12' का उपयोग क्या है?"},"a":{"en":"Ctrl+Shift+F12 opens the Print tab in Backstage view; Alt+Shift+F12 selects the TOC button of the active Table of Contents container","hi":"Ctrl+Shift+F12 बैकस्टेज व्यू में 'Print' टैब खोलता है; Alt+Shift+F12 सक्रिय 'टेबल ऑफ कंटेंट्स' (TOC) कंटेनर का TOC बटन सेलेक्ट करता है"},"o":[{"en":"Ctrl+Shift+F12 opens the Print tab in Backstage view; Alt+Shift+F12 selects the TOC button of the active Table of Contents container","hi":"Ctrl+Shift+F12 बैकस्टेज व्यू में 'Print' टैब खोलता है; Alt+Shift+F12 सक्रिय 'टेबल ऑफ कंटेंट्स' (TOC) कंटेनर का TOC बटन सेलेक्ट करता है"},{"en":"Ctrl+Shift+F12 closes Word; Alt+Shift+F12 opens Excel","hi":"Ctrl+Shift+F12 Word बंद करता है; Alt+Shift+F12 Excel खोलता है"},{"en":"Ctrl+Shift+F12 creates a macro; Alt+Shift+F12 deletes a macro","hi":"Ctrl+Shift+F12 मैक्रो बनाता है; Alt+Shift+F12 मैक्रो डिलीट करता है"},{"en":"Ctrl+Shift+F12 highlights text; Alt+Shift+F12 removes highlights","hi":"Ctrl+Shift+F12 टेक्स्ट को हाईलाइट करता है; Alt+Shift+F12 हाईलाइट हटाता है"}],"exp":{"en":"Ctrl+Shift+F12 is a classic shortcut to switch to the Print tab (Print Preview). Alt+Shift+F12 selects the Table of Contents button in the active TOC container when working with references.","hi":"Ctrl+Shift+F12 बैकस्टेज में 'Print' (प्रिंट प्रीव्यू) टैब खोलता है। Alt+Shift+F12 सक्रिय Table of Contents (TOC) कंटेनर के बटन को सेलेक्ट करता है।"},"num":108}]},{"title":{"en":"5. Excel Window, Workbook & Worksheet Limits","hi":"5. एक्सेल विंडो, वर्कबुक और वर्कशीट लिमिट"},"questions":[{"id":"q109","q":{"en":"What type of software is Microsoft Excel, and what is the full form of VBA?","hi":"एक्सेल (Excel) किस प्रकार का सॉफ्टवेयर है और VBA का फुल फॉर्म क्या है?"},"a":{"en":"Spreadsheet software; Visual Basic for Applications (used for macros and automation)","hi":"स्प्रेडशीट सॉफ्टवेयर; विजुअल बेसिक फॉर एप्लिकेशंस (मैक्रोज़ और ऑटोमेशन के लिए उपयोग होता है)"},"o":[{"en":"Spreadsheet software; Visual Basic for Applications (used for macros and automation)","hi":"स्प्रेडशीट सॉफ्टवेयर; विजुअल बेसिक फॉर एप्लिकेशंस (मैक्रोज़ और ऑटोमेशन के लिए उपयोग होता है)"},{"en":"Database software; Visual Binary Applications","hi":"डेटाबेस सॉफ्टवेयर; विजुअल बाइनरी एप्लिकेशंस"},{"en":"Word processing software; Very Basic Applications","hi":"वर्ड प्रोसेसिंग सॉफ्टवेयर; वेरी बेसिक एप्लिकेशंस"},{"en":"Presentation software; Video Broadcasting Application","hi":"प्रेजेंटेशन सॉफ्टवेयर; वीडियो ब्रॉडकास्टिंग एप्लिकेशन"}],"exp":{"en":"MS Excel is a powerful electronic spreadsheet application used for data analysis, and it supports VBA (Visual Basic for Applications) for creating macros to automate repetitive tasks.","hi":"Microsoft Excel एक स्प्रेडशीट (Spreadsheet) सॉफ्टवेयर है। इसमें मैक्रोज़ और ऑटोमेशन के लिए VBA (Visual Basic for Applications) का उपयोग किया जाता है।"},"num":109},{"id":"q110","q":{"en":"In addition to calculations, what are the primary uses of MS Excel?","hi":"गणनाओं (calculations) के अलावा MS Excel किस काम आता है?"},"a":{"en":"Creating charts, graphs, data organization, filtering, PivotTables, and automation","hi":"चार्ट, ग्राफ, डेटा संगठन (organization), फ़िल्टरिंग, पाइवट टेबल्स (PivotTables) और ऑटोमेशन के लिए"},"o":[{"en":"Creating charts, graphs, data organization, filtering, PivotTables, and automation","hi":"चार्ट, ग्राफ, डेटा संगठन (organization), फ़िल्टरिंग, पाइवट टेबल्स (PivotTables) और ऑटोमेशन के लिए"},{"en":"Editing high-resolution 4K videos and audio tracks","hi":"उच्च-रिज़ॉल्यूशन वाले 4K वीडियो और ऑडियो ट्रैक को एडिट करने के लिए"},{"en":"Writing compiled C++ operating systems","hi":"संकलित C++ ऑपरेटिंग सिस्टम लिखने के लिए"},{"en":"Browsing the dark web securely","hi":"डार्क वेब को सुरक्षित रूप से ब्राउज़ करने के लिए"}],"exp":{"en":"Beyond basic arithmetic, Excel is heavily used for data organization, formatting, creating Charts and Graphs, sorting and filtering data, complex data analysis via PivotTables, and automation.","hi":"कैलकुलेशन के अलावा, Excel का मुख्य उपयोग चार्ट/ग्राफ बनाने, डेटा व्यवस्थित करने, फ़िल्टरिंग, PivotTables (डेटा एनालिसिस) और ऑटोमेशन के लिए होता है।"},"num":110},{"id":"q111","q":{"en":"What is the intersection of a row and a column called in MS Excel?","hi":"MS Excel में रो (row) और कॉलम (column) के प्रतिच्छेदन (intersection) को क्या कहा जाता है?"},"a":{"en":"Cell (the currently selected working cell is called the 'active cell')","hi":"सेल (वर्तमान में सेलेक्ट की गई वर्किंग सेल को 'एक्टिव सेल' कहा जाता है)"},"o":[{"en":"Cell (the currently selected working cell is called the 'active cell')","hi":"सेल (वर्तमान में सेलेक्ट की गई वर्किंग सेल को 'एक्टिव सेल' कहा जाता है)"},{"en":"Gridline","hi":"ग्रिडलाइन"},{"en":"Formula bar","hi":"फॉर्मूला बार"},{"en":"Header","hi":"हेडर"}],"exp":{"en":"A cell is the fundamental box formed by the intersection of a column and a row. The cell you are currently clicked on and working in is known as the active cell.","hi":"रो (row) और कॉलम (column) के इंटरसेक्शन से बने बॉक्स को Cell कहा जाता है। वर्तमान में जिस सेल को सेलेक्ट किया गया है, वह Active cell कहलाती है।"},"num":111},{"id":"q112","q":{"en":"What is the difference between a 'Worksheet' and a 'Workbook' in MS Excel?","hi":"MS Excel में 'वर्कशीट' (Worksheet) और 'वर्कबुक' (Workbook) में क्या अंतर है?"},"a":{"en":"A worksheet is a grid of cells; a workbook is the Excel file itself, which can contain one or more sheets","hi":"वर्कशीट सेल्स की एक ग्रिड (grid) है; वर्कबुक वह एक्सेल फाइल है जिसमें एक या अधिक शीट्स हो सकती हैं"},"o":[{"en":"A worksheet is a grid of cells; a workbook is the Excel file itself, which can contain one or more sheets","hi":"वर्कशीट सेल्स की एक ग्रिड (grid) है; वर्कबुक वह एक्सेल फाइल है जिसमें एक या अधिक शीट्स हो सकती हैं"},{"en":"A worksheet is for text only; a workbook is for numbers only","hi":"वर्कशीट केवल टेक्स्ट के लिए है; वर्कबुक केवल संख्याओं के लिए है"},{"en":"A workbook is a printed paper manual; a worksheet is an online form","hi":"वर्कबुक एक छपा हुआ पेपर मैनुअल है; वर्कशीट एक ऑनलाइन फॉर्म है"},{"en":"There is no difference; they are exactly the same","hi":"कोई अंतर नहीं है; दोनों बिल्कुल एक समान हैं"}],"exp":{"en":"A Worksheet (or sheet) is a single grid of rows and columns where data is entered. A Workbook is the actual Excel file (e.g., Book1.xlsx) that houses one or multiple worksheets.","hi":"Worksheet रो और कॉलम से बनी सेल्स की ग्रिड (एक पन्ना) है। Workbook पूरी एक्सेल फाइल होती है, जिसमें एक या एक से अधिक वर्कशीट शामिल हो सकती हैं।"},"num":112},{"id":"q113","q":{"en":"What is the address of the very first cell in a worksheet, and how are columns and rows identified?","hi":"वर्कशीट की पहली सेल का एड्रेस (address) क्या है, और कॉलम व रो को कैसे पहचाना जाता है?"},"a":{"en":"Address is A1; columns are identified by letters and rows by numbers","hi":"एड्रेस A1 है; कॉलम की पहचान अक्षरों (letters) से और रो की पहचान संख्याओं (numbers) से होती है"},"o":[{"en":"Address is A1; columns are identified by letters and rows by numbers","hi":"एड्रेस A1 है; कॉलम की पहचान अक्षरों (letters) से और रो की पहचान संख्याओं (numbers) से होती है"},{"en":"Address is 1A; columns are identified by numbers and rows by letters","hi":"एड्रेस 1A है; कॉलम की पहचान संख्याओं से और रो की पहचान अक्षरों से होती है"},{"en":"Address is X1; both are identified by letters","hi":"एड्रेस X1 है; दोनों की पहचान अक्षरों से होती है"},{"en":"Address is 00; both are identified by numbers","hi":"एड्रेस 00 है; दोनों की पहचान संख्याओं से होती है"}],"exp":{"en":"In Excel, columns are lettered (A, B, C...) and rows are numbered (1, 2, 3...). The first cell, located in column A and row 1, is addressed as A1.","hi":"Excel में कॉलम को अक्षरों (A, B, C) से और रो को संख्याओं (1, 2, 3) से पहचाना जाता है। पहली सेल (कॉलम A और रो 1) का एड्रेस A1 होता है।"},"num":113},{"id":"q114","q":{"en":"What do the 'Formula bar', 'Name Box', and 'Sheet tabs' display in Excel?","hi":"Excel में 'फॉर्मूला बार', 'नेम बॉक्स' और 'शीट टैब्स' क्या दिखाते हैं?"},"a":{"en":"Formula bar shows the active cell's content/formula; Name Box shows the active cell's address or defined name; Sheet tabs display the sheets in the workbook","hi":"फॉर्मूला बार एक्टिव सेल का कंटेंट/फॉर्मूला दिखाता है; नेम बॉक्स एक्टिव सेल का एड्रेस या डिफाइंड नाम दिखाता है; शीट टैब्स वर्कबुक की शीट्स दिखाते हैं"},"o":[{"en":"Formula bar shows the active cell's content/formula; Name Box shows the active cell's address or defined name; Sheet tabs display the sheets in the workbook","hi":"फॉर्मूला बार एक्टिव सेल का कंटेंट/फॉर्मूला दिखाता है; नेम बॉक्स एक्टिव सेल का एड्रेस या डिफाइंड नाम दिखाता है; शीट टैब्स वर्कबुक की शीट्स दिखाते हैं"},{"en":"Formula bar shows page layout; Name Box shows the file name; Sheet tabs show printer status","hi":"फॉर्मूला बार पेज लेआउट दिखाता है; नेम बॉक्स फाइल का नाम दिखाता है; शीट टैब्स प्रिंटर स्टेटस दिखाते हैं"},{"en":"Formula bar changes font size; Name Box saves the file; Sheet tabs open macros","hi":"फॉर्मूला बार फ़ॉन्ट साइज़ बदलता है; नेम बॉक्स फाइल सेव करता है; शीट टैब्स मैक्रोज़ खोलते हैं"},{"en":"All three display the date and time","hi":"तीनों दिनांक और समय दिखाते हैं"}],"exp":{"en":"The Name Box (top left) shows the cell reference of the active cell. The Formula bar (next to it) displays the data or formula inside that cell. Sheet tabs (at the bottom) let you navigate between different worksheets.","hi":"नेम बॉक्स (Name Box) एक्टिव सेल का एड्रेस दिखाता है। फॉर्मूला बार (Formula bar) उस सेल के अंदर का फॉर्मूला या डेटा दिखाता है। शीट टैब्स (Sheet tabs) वर्कबुक में मौजूद अलग-अलग शीट्स को दर्शाते हैं।"},"num":114},{"id":"q115","q":{"en":"What is the maximum grid size (rows and columns) of a worksheet in Excel 2010 or newer versions?","hi":"Excel 2010 या उसके बाद के संस्करणों में एक वर्कशीट का अधिकतम ग्रिड आकार (Rows and Columns) क्या है?"},"a":{"en":"1,048,576 rows × 16,384 columns (Last column is XFD)","hi":"1,048,576 पंक्तियाँ (rows) × 16,384 कॉलम (अंतिम कॉलम XFD है)"},"o":[{"en":"1,048,576 rows × 16,384 columns (Last column is XFD)","hi":"1,048,576 पंक्तियाँ (rows) × 16,384 कॉलम (अंतिम कॉलम XFD है)"},{"en":"65,536 rows × 256 columns (Last column is IV)","hi":"65,536 पंक्तियाँ × 256 कॉलम (अंतिम कॉलम IV है)"},{"en":"1,000,000 rows × 10,000 columns","hi":"1,000,000 पंक्तियाँ × 10,000 कॉलम"},{"en":"Unlimited rows × Unlimited columns","hi":"असीमित पंक्तियाँ × असीमित कॉलम"}],"exp":{"en":"Starting with Excel 2007 (and continuing through Excel 2010, 2016, 2019, Microsoft 365), the worksheet limit is 1,048,576 rows by 16,384 columns. The final column heading is XFD.","hi":"Excel 2007 और उसके बाद के वर्ज़न (जैसे 2010) में एक वर्कशीट में अधिकतम 1,048,576 रो (rows) और 16,384 कॉलम होते हैं। अंतिम कॉलम का नाम XFD है।"},"num":115},{"id":"q116","q":{"en":"What was the maximum grid size (rows and columns) of a worksheet in older Excel 2003?","hi":"पुराने Excel 2003 में एक वर्कशीट का अधिकतम ग्रिड आकार क्या था?"},"a":{"en":"65,536 rows × 256 columns (Last column is IV)","hi":"65,536 पंक्तियाँ × 256 कॉलम (अंतिम कॉलम IV है)"},"o":[{"en":"65,536 rows × 256 columns (Last column is IV)","hi":"65,536 पंक्तियाँ × 256 कॉलम (अंतिम कॉलम IV है)"},{"en":"1,048,576 rows × 16,384 columns","hi":"1,048,576 पंक्तियाँ × 16,384 कॉलम"},{"en":"10,000 rows × 100 columns","hi":"10,000 पंक्तियाँ × 100 कॉलम"},{"en":"32,767 rows × 128 columns","hi":"32,767 पंक्तियाँ × 128 कॉलम"}],"exp":{"en":"In older versions like Excel 2003 (.xls format), a worksheet was strictly limited to 65,536 rows and 256 columns (ending at column IV).","hi":"पुराने Excel 2003 (.xls फॉर्मेट) में एक वर्कशीट अधिकतम 65,536 रो (rows) और 256 कॉलम तक सीमित थी। अंतिम कॉलम IV होता था।"},"num":116},{"id":"q117","q":{"en":"What is the maximum number of characters that can be contained in a single cell in Excel 2010?","hi":"Excel 2010 में एक सेल में अधिकतम कितने अक्षर (characters) आ सकते हैं?"},"a":{"en":"Maximum 32,767 characters","hi":"अधिकतम 32,767 कैरेक्टर्स"},"o":[{"en":"Maximum 32,767 characters","hi":"अधिकतम 32,767 कैरेक्टर्स"},{"en":"Maximum 255 characters","hi":"अधिकतम 255 कैरेक्टर्स"},{"en":"Maximum 1,024 characters","hi":"अधिकतम 1,024 कैरेक्टर्स"},{"en":"Maximum 1,048,576 characters","hi":"अधिकतम 1,048,576 कैरेक्टर्स"}],"exp":{"en":"The total number of characters that a single cell can contain in Excel (2007 and newer) is 32,767 characters.","hi":"Excel 2010 (और नए संस्करणों) में एक सेल के अंदर आप अधिकतम 32,767 कैरेक्टर्स (अक्षर) टाइप कर सकते हैं।"},"num":117},{"id":"q118","q":{"en":"What is the zoom range of an Excel worksheet as per the source notes?","hi":"सोर्स नोट्स के अनुसार Excel वर्कशीट की ज़ूम रेंज (Zoom range) क्या है?"},"a":{"en":"10% to 400%","hi":"10% से 400%"},"o":[{"en":"10% to 400%","hi":"10% से 400%"},{"en":"10% to 500%","hi":"10% से 500%"},{"en":"5% to 200%","hi":"5% से 200%"},{"en":"100% to 1000%","hi":"100% से 1000%"}],"exp":{"en":"According to standard Excel specifications and the source notes, the zoom magnification in an Excel worksheet ranges from a minimum of 10% to a maximum of 400%.","hi":"Excel वर्कशीट में आप पेज को न्यूनतम 10% से लेकर अधिकतम 400% तक ज़ूम कर सकते हैं (Word का अधिकतम ज़ूम 500% होता है)।"},"num":118},{"id":"q119","q":{"en":"What is the exam trap regarding the default and maximum number of sheets in an Excel workbook?","hi":"Excel वर्कबुक में शीट्स की डिफ़ॉल्ट और अधिकतम संख्या (Maximum sheets) के बारे में परीक्षा ट्रैप (Exam trap) क्या है?"},"a":{"en":"In Excel 2010, the common default was 3 sheets (which could be changed in settings); in modern Excel, the maximum number depends on available memory (do not memorize 255 as a universal maximum)","hi":"Excel 2010 में सामान्य डिफ़ॉल्ट 3 शीट्स था (जिसे सेटिंग्स से बदला जा सकता था); आधुनिक Excel में अधिकतम संख्या उपलब्ध मेमोरी (RAM) पर निर्भर करती है (255 को यूनिवर्सल अधिकतम के रूप में याद न करें)"},"o":[{"en":"In Excel 2010, the common default was 3 sheets (which could be changed in settings); in modern Excel, the maximum number depends on available memory (do not memorize 255 as a universal maximum)","hi":"Excel 2010 में सामान्य डिफ़ॉल्ट 3 शीट्स था (जिसे सेटिंग्स से बदला जा सकता था); आधुनिक Excel में अधिकतम संख्या उपलब्ध मेमोरी (RAM) पर निर्भर करती है (255 को यूनिवर्सल अधिकतम के रूप में याद न करें)"},{"en":"Every version always defaults to 1 sheet and has a strict maximum of 255 sheets","hi":"हर संस्करण में डिफ़ॉल्ट रूप से 1 शीट होती है और अधिकतम सीमा 255 शीट्स है"},{"en":"The default is 5 sheets and the maximum is exactly 10,000","hi":"डिफ़ॉल्ट 5 शीट्स है और अधिकतम ठीक 10,000 है"},{"en":"Workbooks can only contain a single sheet","hi":"वर्कबुक में केवल एक ही शीट हो सकती है"}],"exp":{"en":"Older exams often stated a default of 3 sheets for a new workbook (true for Excel 2010). Modern versions default to 1 sheet. The maximum number of sheets you can add is limited only by your computer's available memory, not a hardcoded 255 limit.","hi":"Excel 2010 में डिफ़ॉल्ट रूप से 3 शीट्स (Sheet1, Sheet2, Sheet3) आती थीं। आधुनिक Excel में एक वर्कबुक में कितनी शीट्स हो सकती हैं, यह कंप्यूटर की उपलब्ध मेमोरी (RAM) पर निर्भर करता है (255 की सीमा केवल पुराने प्रश्नों का ट्रैप है)।"},"num":119},{"id":"q120","q":{"en":"What are the font size limits and the typical default font noted for Excel?","hi":"एक्सेल के लिए फ़ॉन्ट आकार की सीमाएँ और सामान्य डिफ़ॉल्ट फ़ॉन्ट क्या बताए गए हैं?"},"a":{"en":"Classic ribbon choices: 8–72 pt; Manual range: 1–409 pt. Typical Excel 2010 default was Calibri 11 pt (New Microsoft 365 themes may use Aptos)","hi":"क्लासिक रिबन विकल्प: 8–72 pt; मैन्युअल रेंज: 1–409 pt. Excel 2010 का सामान्य डिफ़ॉल्ट Calibri 11 pt था (नई Microsoft 365 थीम Aptos का उपयोग कर सकती हैं)"},"o":[{"en":"Classic ribbon choices: 8–72 pt; Manual range: 1–409 pt. Typical Excel 2010 default was Calibri 11 pt (New Microsoft 365 themes may use Aptos)","hi":"क्लासिक रिबन विकल्प: 8–72 pt; मैन्युअल रेंज: 1–409 pt. Excel 2010 का सामान्य डिफ़ॉल्ट Calibri 11 pt था (नई Microsoft 365 थीम Aptos का उपयोग कर सकती हैं)"},{"en":"Classic ribbon choices: 1–100 pt; Manual range: 1–1638 pt. Default was Times New Roman 12 pt","hi":"क्लासिक रिबन विकल्प: 1–100 pt; मैन्युअल रेंज: 1–1638 pt. डिफ़ॉल्ट टाइम्स न्यू रोमन 12 pt था"},{"en":"Classic ribbon choices: 10–50 pt; Manual range: 1–255 pt. Default was Arial 10 pt","hi":"क्लासिक रिबन विकल्प: 10–50 pt; मैन्युअल रेंज: 1–255 pt. डिफ़ॉल्ट एरियल 10 pt था"},{"en":"Classic ribbon choices: 12–36 pt; Manual range: 1–100 pt. Default was Courier 14 pt","hi":"क्लासिक रिबन विकल्प: 12–36 pt; मैन्युअल रेंज: 1–100 pt. डिफ़ॉल्ट कूरियर 14 pt था"}],"exp":{"en":"In Excel, the dropdown font size options are 8 to 72 pt, and you can manually type a size from 1 to 409 pt. (Unlike Word, which goes up to 1638 pt). The default font since Excel 2007 was Calibri 11 pt.","hi":"Excel में फ़ॉन्ट साइज़ 1 से 409 pt तक सेट किया जा सकता है (जबकि Word में 1638 pt तक होता है)। Excel 2010 का डिफ़ॉल्ट फ़ॉन्ट Calibri 11 pt था, जो अब नए संस्करणों में Aptos हो सकता है।"},"num":120},{"id":"q121","q":{"en":"What are the default horizontal and vertical alignments for text and numbers in an Excel cell (General format)?","hi":"Excel सेल (General फॉर्मेट) में टेक्स्ट और नंबरों के लिए डिफ़ॉल्ट क्षैतिज (horizontal) और ऊर्ध्वाधर (vertical) अलाइनमेंट क्या हैं?"},"a":{"en":"Text is normally aligned left, numbers are aligned right, and vertical alignment is at the bottom (unless formatting is changed)","hi":"टेक्स्ट सामान्यतः बाएँ (left) संरेखित होता है, नंबर दाएँ (right) संरेखित होते हैं, और ऊर्ध्वाधर अलाइनमेंट नीचे (bottom) होता है (जब तक कि फॉर्मेटिंग बदली न जाए)"},"o":[{"en":"Text is normally aligned left, numbers are aligned right, and vertical alignment is at the bottom (unless formatting is changed)","hi":"टेक्स्ट सामान्यतः बाएँ (left) संरेखित होता है, नंबर दाएँ (right) संरेखित होते हैं, और ऊर्ध्वाधर अलाइनमेंट नीचे (bottom) होता है (जब तक कि फॉर्मेटिंग बदली न जाए)"},{"en":"Text is centered, numbers are left-aligned, and vertical alignment is at the top","hi":"टेक्स्ट बीच में होता है, नंबर बाएँ होते हैं, और ऊर्ध्वाधर अलाइनमेंट ऊपर होता है"},{"en":"Both text and numbers are right-aligned and vertically centered","hi":"टेक्स्ट और नंबर दोनों दाएँ होते हैं और ऊर्ध्वाधर रूप से बीच में होते हैं"},{"en":"Text is right-aligned, numbers are centered, and vertical alignment is at the bottom","hi":"टेक्स्ट दाएँ होता है, नंबर बीच में होते हैं, और ऊर्ध्वाधर अलाइनमेंट नीचे होता है"}],"exp":{"en":"By default in Excel's General format, text is left-aligned and numbers are right-aligned horizontally, while all cell contents are bottom-aligned vertically.","hi":"Excel के General फॉर्मेट में डिफ़ॉल्ट रूप से टेक्स्ट बाएँ (left) और नंबर दाएँ (right) अलाइन होते हैं। वर्टिकल अलाइनमेंट में सभी डेटा सेल के नीचे (bottom) होते हैं।"},"num":121},{"id":"q122","q":{"en":"What is a practical method to rename a worksheet in Excel, and what does the Ctrl+R shortcut do?","hi":"Excel में वर्कशीट का नाम बदलने (Rename) का व्यावहारिक तरीका क्या है, और Ctrl+R शॉर्टकट क्या करता है?"},"a":{"en":"Double-click the sheet tab (or right-click → Rename); Ctrl+R is the shortcut for 'Fill Right'","hi":"शीट टैब पर डबल-क्लिक करें (या राइट-क्लिक → Rename); Ctrl+R 'फ़िल राइट' (Fill Right) का शॉर्टकट है"},"o":[{"en":"Double-click the sheet tab (or right-click → Rename); Ctrl+R is the shortcut for 'Fill Right'","hi":"शीट टैब पर डबल-क्लिक करें (या राइट-क्लिक → Rename); Ctrl+R 'फ़िल राइट' (Fill Right) का शॉर्टकट है"},{"en":"Press F2 to rename a sheet; Ctrl+R renames the workbook","hi":"शीट का नाम बदलने के लिए F2 दबाएँ; Ctrl+R वर्कबुक का नाम बदलता है"},{"en":"Press Ctrl+R to rename a sheet; it has no other function","hi":"शीट का नाम बदलने के लिए Ctrl+R दबाएँ; इसका कोई अन्य कार्य नहीं है"},{"en":"Double-click the formula bar to rename; Ctrl+R opens the ribbon","hi":"नाम बदलने के लिए फॉर्मूला बार पर डबल-क्लिक करें; Ctrl+R रिबन खोलता है"}],"exp":{"en":"To rename a worksheet, you typically double-click the sheet tab or right-click it and choose 'Rename'. (Note: In Excel, Ctrl+R is used for 'Fill Right', not renaming).","hi":"वर्कशीट का नाम बदलने के लिए शीट टैब पर डबल-क्लिक करें या राइट-क्लिक करके Rename चुनें। (ध्यान दें: Excel में Ctrl+R का उपयोग 'Fill Right' के लिए होता है)।"},"num":122},{"id":"q123","q":{"en":"Which options are typically found in the context menu when you right-click a sheet tab in Excel?","hi":"Excel में शीट टैब पर राइट-क्लिक करने पर कॉन्टेक्स्ट मेनू में कौन-से विकल्प मिलते हैं?"},"a":{"en":"Insert, Delete, Rename, Move or Copy, View Code, Protect Sheet, Tab Color, Hide, Unhide, and Select All Sheets","hi":"Insert, Delete, Rename, Move or Copy, View Code, Protect Sheet, Tab Color, Hide, Unhide और Select All Sheets"},"o":[{"en":"Insert, Delete, Rename, Move or Copy, View Code, Protect Sheet, Tab Color, Hide, Unhide, and Select All Sheets","hi":"Insert, Delete, Rename, Move or Copy, View Code, Protect Sheet, Tab Color, Hide, Unhide और Select All Sheets"},{"en":"Cut, Copy, Paste, Format Painter, and Clear Contents","hi":"Cut, Copy, Paste, Format Painter और Clear Contents"},{"en":"Merge Cells, Wrap Text, Orientation, and Indent","hi":"Merge Cells, Wrap Text, Orientation और Indent"},{"en":"Sort, Filter, Data Validation, and Subtotal","hi":"Sort, Filter, Data Validation और Subtotal"}],"exp":{"en":"Right-clicking an Excel sheet tab opens a menu offering options like Insert, Delete, Rename, Move or Copy, View Code, Protect Sheet, Tab Color, Hide, Unhide, and Select All Sheets.","hi":"शीट टैब के राइट-क्लिक मेनू में Insert, Delete, Rename, Move or Copy, View Code, Protect Sheet, Tab Color, Hide, Unhide और Select All Sheets के विकल्प होते हैं।"},"num":123},{"id":"q124","q":{"en":"What are the keyboard shortcuts to insert a new worksheet in MS Excel?","hi":"MS Excel में नई वर्कशीट (New worksheet) डालने के शॉर्टकट क्या हैं?"},"a":{"en":"Shift+F11 or Alt+Shift+F1","hi":"Shift+F11 या Alt+Shift+F1"},"o":[{"en":"Shift+F11 or Alt+Shift+F1","hi":"Shift+F11 या Alt+Shift+F1"},{"en":"Ctrl+N or Alt+N","hi":"Ctrl+N या Alt+N"},{"en":"Ctrl+W or Ctrl+F4","hi":"Ctrl+W या Ctrl+F4"},{"en":"F2 or Shift+F2","hi":"F2 या Shift+F2"}],"exp":{"en":"In MS Excel, pressing Shift+F11 (or Alt+Shift+F1) inserts a new worksheet to the left of the active sheet.","hi":"Excel में एक नई वर्कशीट जोड़ने के लिए Shift+F11 या Alt+Shift+F1 शॉर्टकट का उपयोग किया जाता है।"},"num":124},{"id":"q125","q":{"en":"How do you select multiple non-adjacent worksheets in an Excel workbook?","hi":"Excel वर्कबुक में कई गैर-आसन्न (non-adjacent) वर्कशीट को कैसे सेलेक्ट करते हैं?"},"a":{"en":"Click the first sheet tab, then hold the Ctrl key and click the other sheet tabs","hi":"पहला शीट टैब क्लिक करें, फिर Ctrl कुंजी दबाकर अन्य शीट टैब्स पर क्लिक करें"},"o":[{"en":"Click the first sheet tab, then hold the Ctrl key and click the other sheet tabs","hi":"पहला शीट टैब क्लिक करें, फिर Ctrl कुंजी दबाकर अन्य शीट टैब्स पर क्लिक करें"},{"en":"Hold the Shift key and click the first and last sheet tabs","hi":"Shift कुंजी दबाकर पहले और आखिरी शीट टैब पर क्लिक करें"},{"en":"Hold the Alt key and click the sheet tabs","hi":"Alt कुंजी दबाकर शीट टैब्स पर क्लिक करें"},{"en":"Press Ctrl+A to select all non-adjacent sheets","hi":"सभी गैर-आसन्न शीट्स को सेलेक्ट करने के लिए Ctrl+A दबाएँ"}],"exp":{"en":"To select non-adjacent sheets, click the first sheet tab, press and hold the Ctrl key, and then click the tabs of the other sheets you want to select.","hi":"गैर-आसन्न (अलग-अलग) शीट्स को सेलेक्ट करने के लिए पहले एक शीट टैब पर क्लिक करें, फिर Ctrl (कंट्रोल) कुंजी दबाए रखते हुए अन्य शीट्स के टैब पर क्लिक करें।"},"num":125},{"id":"q126","q":{"en":"How does filtering work in an Excel Table, and what shortcuts open the 'Create Table' dialog?","hi":"Excel टेबल में फ़िल्टरिंग (Filtering) कैसे काम करती है, और 'Create Table' डायलॉग खोलने के शॉर्टकट क्या हैं?"},"a":{"en":"You can filter or sort column values using header dropdowns; Ctrl+T or Ctrl+L opens the Create Table dialog","hi":"आप हेडर ड्रॉपडाउन (header dropdowns) से कॉलम वैल्यूज़ को फ़िल्टर या सॉर्ट कर सकते हैं; Ctrl+T या Ctrl+L 'Create Table' डायलॉग खोलता है"},"o":[{"en":"You can filter or sort column values using header dropdowns; Ctrl+T or Ctrl+L opens the Create Table dialog","hi":"आप हेडर ड्रॉपडाउन (header dropdowns) से कॉलम वैल्यूज़ को फ़िल्टर या सॉर्ट कर सकते हैं; Ctrl+T या Ctrl+L 'Create Table' डायलॉग खोलता है"},{"en":"Filtering requires writing VBA macros; Ctrl+F opens the Table dialog","hi":"फ़िल्टरिंग के लिए VBA मैक्रोज़ लिखना आवश्यक है; Ctrl+F टेबल डायलॉग खोलता है"},{"en":"Filtering automatically deletes hidden rows; Ctrl+Shift+T creates a table","hi":"फ़िल्टरिंग छिपी हुई पंक्तियों को स्वतः हटा देती है; Ctrl+Shift+T एक टेबल बनाता है"},{"en":"Filtering only works on numbers; Alt+T creates a table","hi":"फ़िल्टरिंग केवल संख्याओं पर काम करती है; Alt+T टेबल बनाता है"}],"exp":{"en":"In an Excel Table, header dropdowns allow sorting and filtering data. You can quickly convert a data range into a Table by pressing Ctrl+T or Ctrl+L.","hi":"Excel टेबल में, हेडर ड्रॉपडाउन (dropdown) का उपयोग करके आप डेटा को फ़िल्टर या सॉर्ट कर सकते हैं। डेटा को टेबल में बदलने के लिए Ctrl+T या Ctrl+L का उपयोग होता है।"},"num":126},{"id":"q127","q":{"en":"Under which Ribbon tab is the 'Remove Duplicates' command found in MS Excel?","hi":"MS Excel में 'Remove Duplicates' कमांड किस रिबन टैब के अंतर्गत मिलता है?"},"a":{"en":"Data tab","hi":"Data टैब"},"o":[{"en":"Data tab","hi":"Data टैब"},{"en":"Home tab","hi":"Home टैब"},{"en":"Insert tab","hi":"Insert टैब"},{"en":"Review tab","hi":"Review टैब"}],"exp":{"en":"The 'Remove Duplicates' tool, which deletes duplicate rows from a selected range, is located on the Data tab (in the Data Tools group).","hi":"Excel में डुप्लीकेट पंक्तियों (rows) को हटाने वाला 'Remove Duplicates' कमांड Data टैब (डेटा टूल्स ग्रुप) में मिलता है।"},"num":127},{"id":"q128","q":{"en":"What does the Name Box display when you select the range B3:G9?","hi":"जब आप B3:G9 रेंज सेलेक्ट करते हैं तो नेम बॉक्स (Name Box) क्या दिखाता है?"},"a":{"en":"It shows the address of the active cell after selection, such as B3 (while dragging, it may temporarily show the dimensions like 7R x 6C)","hi":"सेलेक्शन के बाद यह एक्टिव सेल का एड्रेस (जैसे B3) दिखाता है (ड्रैग करते समय यह अस्थायी रूप से 7R x 6C जैसे आयाम/dimensions दिखा सकता है)"},"o":[{"en":"It shows the address of the active cell after selection, such as B3 (while dragging, it may temporarily show the dimensions like 7R x 6C)","hi":"सेलेक्शन के बाद यह एक्टिव सेल का एड्रेस (जैसे B3) दिखाता है (ड्रैग करते समय यह अस्थायी रूप से 7R x 6C जैसे आयाम/dimensions दिखा सकता है)"},{"en":"It always shows the text 'B3:G9' permanently","hi":"यह हमेशा स्थायी रूप से टेक्स्ट 'B3:G9' दिखाता है"},{"en":"It shows the total sum of the numbers in the range","hi":"यह रेंज में संख्याओं का कुल योग दिखाता है"},{"en":"It shows 'G9', the last cell in the range","hi":"यह रेंज की अंतिम सेल 'G9' दिखाता है"}],"exp":{"en":"While you are clicking and dragging to select B3:G9, the Name Box temporarily shows the dimensions (e.g., 7R x 6C). Once you release the mouse, it displays the address of the active cell in that selection (usually B3).","hi":"जब आप B3 से G9 तक ड्रैग करते हैं, तो नेम बॉक्स अस्थायी रूप से (7R x 6C) दिखा सकता है, लेकिन माउस छोड़ने के बाद यह उस रेंज की एक्टिव सेल (आमतौर पर B3) का एड्रेस दिखाता है।"},"num":128},{"id":"q129","q":{"en":"How many total cells are contained in the range A4:C10?","hi":"A4:C10 रेंज में कुल कितने सेल्स (cells) होते हैं?"},"a":{"en":"7 rows × 3 columns = 21 (Row count is 10−4+1)","hi":"7 पंक्तियाँ × 3 कॉलम = 21 (रो की गिनती 10−4+1 है)"},"o":[{"en":"7 rows × 3 columns = 21 (Row count is 10−4+1)","hi":"7 पंक्तियाँ × 3 कॉलम = 21 (रो की गिनती 10−4+1 है)"},{"en":"6 rows × 3 columns = 18","hi":"6 पंक्तियाँ × 3 कॉलम = 18"},{"en":"10 rows × 3 columns = 30","hi":"10 पंक्तियाँ × 3 कॉलम = 30"},{"en":"4 rows × 10 columns = 40","hi":"4 पंक्तियाँ × 10 कॉलम = 40"}],"exp":{"en":"The range A4:C10 spans columns A, B, and C (3 columns) and rows 4 through 10 (10 - 4 + 1 = 7 rows). Therefore, 3 x 7 = 21 cells.","hi":"A4:C10 रेंज में कॉलम A, B, C (3 कॉलम) और रो 4 से 10 (10-4+1 = 7 रो) होते हैं। अतः 7 रो × 3 कॉलम = 21 सेल्स।"},"num":129}]},{"title":{"en":"6. Excel References, Ribbon & Charts","hi":"6. एक्सेल रेफरेंस, रिबन और चार्ट्स"},"questions":[{"id":"q130","q":{"en":"What are relative, absolute, and mixed cell references in MS Excel?","hi":"MS Excel में रिलेटिव (relative), एब्सोल्यूट (absolute) और मिक्स्ड (mixed) सेल रिफरेन्स क्या होते हैं?"},"a":{"en":"A1 adjusts both row and column (relative); $A$1 locks both (absolute); $A1 locks column and A$1 locks row (mixed)","hi":"A1 दोनों को एडजस्ट करता है (रिलेटिव); $A$1 दोनों को लॉक करता है (एब्सोल्यूट); $A1 कॉलम को लॉक करता है और A$1 रो को लॉक करता है (मिक्स्ड)"},"o":[{"en":"A1 adjusts both row and column (relative); $A$1 locks both (absolute); $A1 locks column and A$1 locks row (mixed)","hi":"A1 दोनों को एडजस्ट करता है (रिलेटिव); $A$1 दोनों को लॉक करता है (एब्सोल्यूट); $A1 कॉलम को लॉक करता है और A$1 रो को लॉक करता है (मिक्स्ड)"},{"en":"$A1 adjusts both; A1 locks both; $A$1 locks column only","hi":"$A1 दोनों को एडजस्ट करता है; A1 दोनों को लॉक करता है; $A$1 केवल कॉलम को लॉक करता है"},{"en":"A1 locks row; $A$1 locks column; A$1 adjusts both","hi":"A1 रो को लॉक करता है; $A$1 कॉलम को लॉक करता है; A$1 दोनों को एडजस्ट करता है"},{"en":"Absolute references use % signs, relative use # signs, mixed use @ signs","hi":"एब्सोल्यूट रिफरेन्स % का उपयोग करते हैं, रिलेटिव # का, और मिक्स्ड @ का"}],"exp":{"en":"A relative reference (A1) changes when copied. An absolute reference ($A$1) stays locked. A mixed reference locks either the column ($A1) or the row (A$1).","hi":"A1 (Relative) कॉपी करने पर बदल जाता है। $A$1 (Absolute) रो और कॉलम दोनों को लॉक रखता है। $A1 और A$1 (Mixed) में कोई एक (कॉलम या रो) लॉक होता है।"},"num":130},{"id":"q131","q":{"en":"What happens if you copy the relative formula '=B5*C5' one row down?","hi":"यदि आप रिलेटिव फॉर्मूला '=B5*C5' को एक रो नीचे (one row down) कॉपी करते हैं तो क्या होगा?"},"a":{"en":"It becomes =B6*C6 (the references for quantity and unit price shift to the new row)","hi":"यह =B6*C6 हो जाएगा (मात्रा और इकाई मूल्य के रिफरेन्स नई पंक्ति पर शिफ्ट हो जाते हैं)"},"o":[{"en":"It becomes =B6*C6 (the references for quantity and unit price shift to the new row)","hi":"यह =B6*C6 हो जाएगा (मात्रा और इकाई मूल्य के रिफरेन्स नई पंक्ति पर शिफ्ट हो जाते हैं)"},{"en":"It stays =B5*C5","hi":"यह =B5*C5 ही रहेगा"},{"en":"It becomes =C5*D5","hi":"यह =C5*D5 हो जाएगा"},{"en":"It becomes =B4*C4","hi":"यह =B4*C4 हो जाएगा"}],"exp":{"en":"Because B5 and C5 are relative references, copying the formula down one row automatically updates the row numbers to B6 and C6.","hi":"चूँकि B5 और C5 रिलेटिव (relative) रिफरेन्स हैं, इसलिए फॉर्मूला एक रो नीचे कॉपी करने पर अपने आप रो नंबर बदलकर =B6*C6 हो जाएगा।"},"num":131},{"id":"q132","q":{"en":"In the formula '=B3*$H$3', why is '$H$3' used?","hi":"फॉर्मूला '=B3*$H$3' में '$H$3' का उपयोग क्यों किया गया है?"},"a":{"en":"To lock the fixed conversion rate (so when copied one row down, it becomes =B4*$H$3)","hi":"एक निश्चित रूपांतरण दर (fixed conversion rate) को लॉक करने के लिए (ताकि एक रो नीचे कॉपी करने पर यह =B4*$H$3 हो जाए)"},"o":[{"en":"To lock the fixed conversion rate (so when copied one row down, it becomes =B4*$H$3)","hi":"एक निश्चित रूपांतरण दर (fixed conversion rate) को लॉक करने के लिए (ताकि एक रो नीचे कॉपी करने पर यह =B4*$H$3 हो जाए)"},{"en":"To delete column H","hi":"कॉलम H को डिलीट करने के लिए"},{"en":"To divide B3 by H3","hi":"B3 को H3 से विभाजित करने के लिए"},{"en":"To randomly generate a number","hi":"एक नंबर बेतरतीब ढंग (randomly) से जेनरेट करने के लिए"}],"exp":{"en":"The dollar signs in $H$3 make it an absolute reference, fixing it to that specific cell (e.g., a tax or conversion rate) so it doesn't change when the formula is copied elsewhere.","hi":"फॉर्मूले में $H$3 एक एब्सोल्यूट रिफरेन्स है। यह उस सेल (जैसे टैक्स या रूपांतरण दर) को लॉक कर देता है ताकि फॉर्मूला नीचे कॉपी करने पर भी यह $H$3 ही रहे (जबकि B3 बदलकर B4 हो जाएगा)।"},"num":132},{"id":"q133","q":{"en":"What happens if you copy the formulas '=$A1' and '=A$1' one column to the right and one row down?","hi":"यदि आप फॉर्मूला '=$A1' और '=A$1' को एक कॉलम दाएँ (right) और एक रो नीचे (down) कॉपी करते हैं तो वे क्या बन जाएंगे?"},"a":{"en":"=$A1 becomes =$A2, and =A$1 becomes =B$1","hi":"=$A1 बदलकर =$A2 हो जाएगा, और =A$1 बदलकर =B$1 हो जाएगा"},"o":[{"en":"=$A1 becomes =$A2, and =A$1 becomes =B$1","hi":"=$A1 बदलकर =$A2 हो जाएगा, और =A$1 बदलकर =B$1 हो जाएगा"},{"en":"=$A1 stays =$A1, and =A$1 stays =A$1","hi":"=$A1 बदलकर =$A1 ही रहेगा, और =A$1 बदलकर =A$1 ही रहेगा"},{"en":"=$A1 becomes =$B2, and =A$1 becomes =B$2","hi":"=$A1 बदलकर =$B2 हो जाएगा, और =A$1 बदलकर =B$2 हो जाएगा"},{"en":"=$A1 becomes =B1, and =A$1 becomes =A2","hi":"=$A1 बदलकर =B1 हो जाएगा, और =A$1 बदलकर =A2 हो जाएगा"}],"exp":{"en":"For =$A1 (column locked): right shift does nothing to A, down shift changes 1 to 2 -> =$A2. For =A$1 (row locked): right shift changes A to B, down shift does nothing to 1 -> =B$1.","hi":"=$A1 में कॉलम (A) लॉक है, इसलिए दाएँ जाने पर यह नहीं बदलेगा, लेकिन नीचे जाने पर रो 2 हो जाएगी (=$A2)। =A$1 में रो (1) लॉक है, इसलिए दाएँ जाने पर कॉलम B हो जाएगा, लेकिन रो 1 ही रहेगी (=B$1)।"},"num":133},{"id":"q134","q":{"en":"What does pressing 'F4' while editing a formula reference do in MS Excel?","hi":"MS Excel में फॉर्मूला एडिट करते समय 'F4' कुंजी दबाने से क्या होता है?"},"a":{"en":"It cycles the selected reference through forms like A1, $A$1, A$1, and $A1","hi":"यह सेलेक्ट किए गए रिफरेन्स को A1, $A$1, A$1 और $A1 जैसे रूपों में बदलता (cycle करता) है"},"o":[{"en":"It cycles the selected reference through forms like A1, $A$1, A$1, and $A1","hi":"यह सेलेक्ट किए गए रिफरेन्स को A1, $A$1, A$1 और $A1 जैसे रूपों में बदलता (cycle करता) है"},{"en":"It recalculates the entire workbook","hi":"यह पूरी वर्कबुक की फिर से गणना (recalculate) करता है"},{"en":"It applies the SUM function to the column","hi":"यह कॉलम पर SUM फंक्शन लगाता है"},{"en":"It highlights the cell in red","hi":"यह सेल को लाल रंग में हाईलाइट करता है"}],"exp":{"en":"When editing a cell reference in the formula bar, pressing F4 toggles it between relative (A1), absolute ($A$1), and mixed (A$1, $A1) reference modes.","hi":"जब आप किसी फॉर्मूले में सेल रिफरेन्स पर होते हैं, तो F4 दबाने से वह रिलेटिव (A1), एब्सोल्यूट ($A$1) और मिक्स्ड (A$1, $A1) रिफरेन्स के बीच बदलता (टॉगल करता) है।"},"num":134},{"id":"q135","q":{"en":"Which of the following are the main Ribbon tabs in MS Excel?","hi":"MS Excel के मुख्य रिबन टैब (Ribbon tabs) कौन-से हैं?"},"a":{"en":"File, Home, Insert, Page Layout, Formulas, Data, Review, and View","hi":"File, Home, Insert, Page Layout, Formulas, Data, Review और View"},"o":[{"en":"File, Home, Insert, Page Layout, Formulas, Data, Review, and View","hi":"File, Home, Insert, Page Layout, Formulas, Data, Review और View"},{"en":"File, Home, Slides, Animations, and Transitions","hi":"File, Home, Slides, Animations और Transitions"},{"en":"File, Design, Mailings, References, and Layout","hi":"File, Design, Mailings, References और Layout"},{"en":"File, Query, Database Tools, and Macros","hi":"File, Query, Database Tools और Macros"}],"exp":{"en":"The core standard tabs in MS Excel are File, Home, Insert, Page Layout, Formulas, Data, Review, and View.","hi":"Excel के मुख्य रिबन टैब्स File, Home, Insert, Page Layout, Formulas, Data, Review और View हैं। (Word में 'Mailings' और PowerPoint में 'Transitions/Animations' होते हैं)।"},"num":135},{"id":"q136","q":{"en":"Which common command groups are found on the 'Home' tab in MS Excel?","hi":"MS Excel के 'Home' टैब में कौन-से सामान्य ग्रुप्स (Command groups) मिलते हैं?"},"a":{"en":"Clipboard, Font, Alignment, Number, Styles, Cells, and Editing","hi":"Clipboard, Font, Alignment, Number, Styles, Cells और Editing"},"o":[{"en":"Clipboard, Font, Alignment, Number, Styles, Cells, and Editing","hi":"Clipboard, Font, Alignment, Number, Styles, Cells और Editing"},{"en":"Tables, Illustrations, Charts, Sparklines, and Filters","hi":"Tables, Illustrations, Charts, Sparklines और Filters"},{"en":"Themes, Page Setup, Scale to Fit, and Sheet Options","hi":"Themes, Page Setup, Scale to Fit और Sheet Options"},{"en":"Function Library, Defined Names, and Formula Auditing","hi":"Function Library, Defined Names और Formula Auditing"}],"exp":{"en":"The Excel Home tab holds groups for basic formatting and editing: Clipboard, Font, Alignment, Number, Styles (like Conditional Formatting), Cells, and Editing.","hi":"Excel के Home टैब में बुनियादी फॉर्मेटिंग और एडिटिंग के ग्रुप्स होते हैं: Clipboard, Font, Alignment, Number, Styles, Cells और Editing।"},"num":136},{"id":"q137","q":{"en":"What can be added to an Excel worksheet using the 'Insert' tab?","hi":"Excel के 'Insert' टैब से वर्कशीट में क्या-क्या जोड़ा जा सकता है?"},"a":{"en":"Tables, PivotTables, charts, pictures, shapes, add-ins, 3D Maps, and sparklines","hi":"Tables, PivotTables, charts, pictures, shapes, add-ins, 3D Maps और sparklines"},"o":[{"en":"Tables, PivotTables, charts, pictures, shapes, add-ins, 3D Maps, and sparklines","hi":"Tables, PivotTables, charts, pictures, shapes, add-ins, 3D Maps और sparklines"},{"en":"Only text boxes and page breaks","hi":"केवल टेक्स्ट बॉक्स और पेज ब्रेक"},{"en":"Only math functions and defined names","hi":"केवल गणित के फंक्शन और डिफाइंड नेम्स"},{"en":"Only margins and print areas","hi":"केवल मार्जिन और प्रिंट एरिया"}],"exp":{"en":"The Insert tab is used to add objects like PivotTables, recommended Tables, Pictures, Shapes, various Charts, 3D Maps, Sparklines, Links, and Text/Symbols.","hi":"Insert टैब से आप Tables, PivotTables, charts, pictures, shapes, add-ins, 3D Maps और sparklines (मिनी चार्ट) जैसी चीज़ें वर्कशीट में जोड़ सकते हैं।"},"num":137},{"id":"q138","q":{"en":"What is the difference between standard chart types and 'sparklines' in Excel?","hi":"Excel में स्टैण्डर्ड चार्ट (Chart types) और 'स्पार्कलाइन्स' (Sparklines) में क्या अंतर है?"},"a":{"en":"Column, line, pie, bar, area, and scatter are full charts; Line, column, and win/loss sparklines are single-cell mini charts","hi":"Column, line, pie, bar, area और scatter पूरे (full) चार्ट हैं; जबकि Line, column और win/loss स्पार्कलाइन्स सिंगल-सेल (एक सेल के भीतर) मिनी चार्ट हैं"},"o":[{"en":"Column, line, pie, bar, area, and scatter are full charts; Line, column, and win/loss sparklines are single-cell mini charts","hi":"Column, line, pie, bar, area और scatter पूरे (full) चार्ट हैं; जबकि Line, column और win/loss स्पार्कलाइन्स सिंगल-सेल (एक सेल के भीतर) मिनी चार्ट हैं"},{"en":"Sparklines are for 3D modeling, while standard charts are for plain text","hi":"स्पार्कलाइन्स 3D मॉडलिंग के लिए हैं, जबकि स्टैण्डर्ड चार्ट प्लेन टेक्स्ट के लिए हैं"},{"en":"Standard charts only work in Word, while sparklines only work in PowerPoint","hi":"स्टैण्डर्ड चार्ट केवल Word में काम करते हैं, जबकि स्पार्कलाइन्स केवल PowerPoint में"},{"en":"There is no difference; they are exactly the same","hi":"कोई अंतर नहीं है; दोनों बिल्कुल एक समान हैं"}],"exp":{"en":"Standard charts (Pie, Bar, Line) are floating graphical objects. Sparklines are tiny, lightweight charts (Line, Column, Win/Loss) that reside entirely inside a single cell to show data trends.","hi":"स्टैण्डर्ड चार्ट (जैसे पाई, बार, कॉलम) बड़े ग्राफ होते हैं, जबकि स्पार्कलाइन्स (Sparklines) डेटा का ट्रेंड दिखाने के लिए किसी एक सेल के अंदर (single-cell) बनने वाले बहुत छोटे चार्ट होते हैं।"},"num":138},{"id":"q139","q":{"en":"What is the primary use of the 'Formulas' tab in MS Excel?","hi":"MS Excel में 'Formulas' टैब का मुख्य उपयोग क्या है?"},"a":{"en":"Providing options like Insert Function, Function Library, Defined Names, Formula Auditing, and Calculation options","hi":"Insert Function, Function Library, Defined Names, Formula Auditing और Calculation options (गणना विकल्प) जैसी सुविधाएँ देना"},"o":[{"en":"Providing options like Insert Function, Function Library, Defined Names, Formula Auditing, and Calculation options","hi":"Insert Function, Function Library, Defined Names, Formula Auditing और Calculation options (गणना विकल्प) जैसी सुविधाएँ देना"},{"en":"Applying cell borders, fill colors, and conditional formatting","hi":"सेल बॉर्डर, फिल कलर्स और कंडीशनल फॉर्मेटिंग लागू करना"},{"en":"Sorting data, removing duplicates, and data validation","hi":"डेटा सॉर्ट करना, डुप्लिकेट हटाना और डेटा वैलिडेशन"},{"en":"Changing document views and freezing panes","hi":"डॉक्यूमेंट व्यू बदलना और पेन (panes) फ्रीज़ करना"}],"exp":{"en":"The Formulas tab contains the Function Library (categorized formulas), the Defined Names group (Name Manager), Formula Auditing tools (Trace Precedents/Dependents), and Calculation options.","hi":"Formulas टैब में Insert Function, Function Library (सभी फंक्शन की सूची), Defined Names (नाम तय करना), Formula Auditing (ट्रेस करना) और Calculation के विकल्प मिलते हैं।"},"num":139},{"id":"q140","q":{"en":"What are the practical uses of the 'Data', 'Review', and 'View' tabs respectively in Excel?","hi":"Excel में 'Data', 'Review' और 'View' टैब के व्यावहारिक उपयोग (Practical uses) क्रमशः क्या हैं?"},"a":{"en":"Data for sort/filter/import, Review for proofing/comments/protection, and View for gridlines, zoom, and window/pane controls","hi":"Data टैब डेटा को सॉर्ट/फ़िल्टर/इम्पोर्ट करने के लिए, Review टैब प्रूफिंग/कमेंट्स/प्रोटेक्शन (सुरक्षा) के लिए, और View टैब ग्रिडलाइन्स, ज़ूम और विंडो/पेन कंट्रोल्स के लिए"},"o":[{"en":"Data for sort/filter/import, Review for proofing/comments/protection, and View for gridlines, zoom, and window/pane controls","hi":"Data टैब डेटा को सॉर्ट/फ़िल्टर/इम्पोर्ट करने के लिए, Review टैब प्रूफिंग/कमेंट्स/प्रोटेक्शन (सुरक्षा) के लिए, और View टैब ग्रिडलाइन्स, ज़ूम और विंडो/पेन कंट्रोल्स के लिए"},{"en":"Data for changing fonts, Review for making charts, and View for printing","hi":"Data फ़ॉन्ट बदलने के लिए, Review चार्ट बनाने के लिए, और View प्रिंटिंग के लिए"},{"en":"Data for mail merge, Review for slide transitions, and View for databases","hi":"Data मेल मर्ज के लिए, Review स्लाइड ट्रांज़िशन के लिए, और View डेटाबेस के लिए"},{"en":"All three are used for creating VBA macros","hi":"तीनों का उपयोग VBA मैक्रोज़ बनाने के लिए किया जाता है"}],"exp":{"en":"The Data tab handles external data, sorting, and filtering. The Review tab offers spell check, comments, and sheet protection. The View tab controls layout views, Zoom, Gridlines display, and Freeze Panes.","hi":"Data टैब डेटा को सॉर्ट, फ़िल्टर और इम्पोर्ट करने के काम आता है। Review टैब स्पेलिंग चेक, कमेंट्स और शीट को प्रोटेक्ट करने के लिए है। View टैब ग्रिडलाइन्स देखने, ज़ूम करने और विंडो (जैसे Freeze Panes) कंट्रोल के लिए है।"},"num":140}]},{"title":{"en":"7. Excel Functions & Worked Examples","hi":"7. एक्सेल फंक्शन्स और उदाहरण"},"questions":[{"id":"q141","q":{"en":"What do the 'LOWER' and 'UPPER' functions do in Excel?","hi":"Excel में 'LOWER' और 'UPPER' फंक्शन क्या करते हैं?"},"a":{"en":"=LOWER(\"ABC\") returns 'abc', and =UPPER(\"abc\") returns 'ABC'","hi":"=LOWER(\"ABC\") 'abc' देता है, और =UPPER(\"abc\") 'ABC' देता है"},"o":[{"en":"=LOWER(\"ABC\") returns 'abc', and =UPPER(\"abc\") returns 'ABC'","hi":"=LOWER(\"ABC\") 'abc' देता है, और =UPPER(\"abc\") 'ABC' देता है"},{"en":"=LOWER subtracts numbers, and =UPPER adds numbers","hi":"=LOWER संख्याएँ घटाता है, और =UPPER संख्याएँ जोड़ता है"},{"en":"=LOWER aligns text left, and =UPPER aligns text right","hi":"=LOWER टेक्स्ट को बाएँ एलाइन करता है, और =UPPER दाएँ एलाइन करता है"},{"en":"=LOWER deletes the lowest number, and =UPPER deletes the highest","hi":"=LOWER सबसे छोटी संख्या हटाता है, और =UPPER सबसे बड़ी हटाता है"}],"exp":{"en":"The LOWER function converts all uppercase letters in a text string to lowercase. The UPPER function converts all lowercase letters to uppercase.","hi":"LOWER फंक्शन टेक्स्ट के सभी अक्षरों को छोटे (lowercase) में बदल देता है, जबकि UPPER फंक्शन सभी अक्षरों को बड़े (UPPERCASE) में बदल देता है।"},"num":141},{"id":"q142","q":{"en":"What does the 'PROPER' function do in Excel?","hi":"Excel में 'PROPER' फंक्शन क्या करता है?"},"a":{"en":"It capitalizes the initial letters of words; e.g., =PROPER(\"rishank singh\") returns 'Rishank Singh'","hi":"यह शब्दों के शुरुआती अक्षरों (initial letters) को कैपिटल करता है; जैसे, =PROPER(\"rishank singh\") से 'Rishank Singh' मिलता है"},"o":[{"en":"It capitalizes the initial letters of words; e.g., =PROPER(\"rishank singh\") returns 'Rishank Singh'","hi":"यह शब्दों के शुरुआती अक्षरों (initial letters) को कैपिटल करता है; जैसे, =PROPER(\"rishank singh\") से 'Rishank Singh' मिलता है"},{"en":"It checks if a formula is grammatically correct","hi":"यह जाँचता है कि क्या कोई फॉर्मूला व्याकरणिक रूप से सही है"},{"en":"It converts text into numbers","hi":"यह टेक्स्ट को संख्याओं में बदलता है"},{"en":"It removes all spaces from a text string","hi":"यह टेक्स्ट से सभी रिक्त स्थान (spaces) हटा देता है"}],"exp":{"en":"The PROPER function converts the first letter of each word in a text string to uppercase and all other letters to lowercase.","hi":"PROPER फंक्शन टेक्स्ट के हर शब्द के पहले अक्षर को कैपिटल (बड़ा) कर देता है और बाकी को छोटा रखता है (जैसे नाम लिखने का सही तरीका)।"},"num":142},{"id":"q143","q":{"en":"What is the use of the 'CONCATENATE' function (and what operator can do the same)?","hi":"'CONCATENATE' फंक्शन का क्या उपयोग है (और कौन-सा ऑपरेटर यही काम कर सकता है)?"},"a":{"en":"It joins text strings; e.g., =CONCATENATE(\"Exam\",\"Fusion\") returns 'ExamFusion' (the '&' operator can also join text)","hi":"यह टेक्स्ट स्ट्रिंग्स को जोड़ता है; जैसे =CONCATENATE(\"Exam\",\"Fusion\") से 'ExamFusion' मिलेगा (तथा '&' ऑपरेटर भी टेक्स्ट को जोड़ सकता है)"},"o":[{"en":"It joins text strings; e.g., =CONCATENATE(\"Exam\",\"Fusion\") returns 'ExamFusion' (the '&' operator can also join text)","hi":"यह टेक्स्ट स्ट्रिंग्स को जोड़ता है; जैसे =CONCATENATE(\"Exam\",\"Fusion\") से 'ExamFusion' मिलेगा (तथा '&' ऑपरेटर भी टेक्स्ट को जोड़ सकता है)"},{"en":"It splits text into columns (the '*' operator can also do this)","hi":"यह टेक्स्ट को कॉलम में विभाजित करता है ('*' ऑपरेटर भी ऐसा कर सकता है)"},{"en":"It counts the number of words (the '+' operator can also do this)","hi":"यह शब्दों की संख्या गिनता है ('+' ऑपरेटर भी ऐसा कर सकता है)"},{"en":"It reverses the text string (the '-' operator can also do this)","hi":"यह टेक्स्ट को उल्टा करता है ('-' ऑपरेटर भी ऐसा कर सकता है)"}],"exp":{"en":"CONCATENATE (or CONCAT in newer versions) links multiple text strings together into one. The ampersand (&) operator achieves the exact same result (e.g., =A1 & B1).","hi":"CONCATENATE फंक्शन दो या अधिक टेक्स्ट स्ट्रिंग्स (शब्दों) को एक साथ जोड़ता है। एक्सेल में '&' (ampersand) ऑपरेटर का उपयोग करके भी टेक्स्ट को जोड़ा जा सकता है।"},"num":143},{"id":"q144","q":{"en":"What do the 'LEFT' and 'RIGHT' functions return in Excel?","hi":"Excel में 'LEFT' और 'RIGHT' फंक्शन क्या देते (return करते) हैं?"},"a":{"en":"=LEFT(\"EXCEL\",2) returns 'EX', and =RIGHT(\"EXCEL\",2) returns 'EL'","hi":"=LEFT(\"EXCEL\",2) से 'EX' मिलता है, और =RIGHT(\"EXCEL\",2) से 'EL' मिलता है"},"o":[{"en":"=LEFT(\"EXCEL\",2) returns 'EX', and =RIGHT(\"EXCEL\",2) returns 'EL'","hi":"=LEFT(\"EXCEL\",2) से 'EX' मिलता है, और =RIGHT(\"EXCEL\",2) से 'EL' मिलता है"},{"en":"=LEFT moves the cell to the left, and =RIGHT moves it to the right","hi":"=LEFT सेल को बाएँ ले जाता है, और =RIGHT उसे दाएँ ले जाता है"},{"en":"=LEFT returns the smallest number, and =RIGHT returns the largest","hi":"=LEFT सबसे छोटी संख्या देता है, और =RIGHT सबसे बड़ी संख्या देता है"},{"en":"=LEFT deletes the first two characters, and =RIGHT deletes the last two","hi":"=LEFT पहले दो अक्षर हटाता है, और =RIGHT अंतिम दो अक्षर हटाता है"}],"exp":{"en":"The LEFT function extracts a specified number of characters from the beginning (left side) of a string, while the RIGHT function extracts characters from the end (right side).","hi":"LEFT फंक्शन किसी टेक्स्ट के शुरुआत (बाएँ) से निश्चित संख्या में अक्षर निकालता है, जबकि RIGHT फंक्शन अंत (दाएँ) से अक्षर निकालता है।"},"num":144},{"id":"q145","q":{"en":"What does the 'LEN' function count in Excel?","hi":"Excel में 'LEN' फंक्शन क्या गिनता (count करता) है?"},"a":{"en":"Characters in a text string, including spaces (e.g., =LEN(\"A B\") returns 3)","hi":"किसी टेक्स्ट स्ट्रिंग में कैरेक्टर्स (अक्षर), जिसमें रिक्त स्थान (spaces) भी शामिल हैं (जैसे, =LEN(\"A B\") 3 देता है)"},"o":[{"en":"Characters in a text string, including spaces (e.g., =LEN(\"A B\") returns 3)","hi":"किसी टेक्स्ट स्ट्रिंग में कैरेक्टर्स (अक्षर), जिसमें रिक्त स्थान (spaces) भी शामिल हैं (जैसे, =LEN(\"A B\") 3 देता है)"},{"en":"Only numeric digits in a cell","hi":"सेल में केवल संख्यात्मक अंक"},{"en":"The number of words in a sentence","hi":"एक वाक्य में शब्दों की संख्या"},{"en":"The number of blank cells in a range","hi":"एक रेंज में खाली सेल्स की संख्या"}],"exp":{"en":"The LEN function returns the total length (number of characters) of a given text string, counting letters, numbers, punctuation, and spaces.","hi":"LEN फंक्शन किसी टेक्स्ट के भीतर मौजूद कुल कैरेक्टर्स (अक्षरों और स्पेस) की संख्या गिनता है। (उदा: \"A B\" में A, स्पेस, और B मिलाकर कुल 3 हैं)।"},"num":145},{"id":"q146","q":{"en":"What does the 'EXACT' function check in Excel?","hi":"Excel में 'EXACT' फंक्शन क्या जाँचता (check करता) है?"},"a":{"en":"Whether two strings are identical in a case-sensitive comparison (e.g., =EXACT(\"Excel\",\"EXCEL\") returns FALSE)","hi":"क्या दो स्ट्रिंग्स केस-सेंसिटिव (case-sensitive) तुलना में बिल्कुल समान हैं (जैसे, =EXACT(\"Excel\",\"EXCEL\") FALSE देता है)"},"o":[{"en":"Whether two strings are identical in a case-sensitive comparison (e.g., =EXACT(\"Excel\",\"EXCEL\") returns FALSE)","hi":"क्या दो स्ट्रिंग्स केस-सेंसिटिव (case-sensitive) तुलना में बिल्कुल समान हैं (जैसे, =EXACT(\"Excel\",\"EXCEL\") FALSE देता है)"},{"en":"Whether a number is an exact integer","hi":"क्या कोई संख्या पूर्ण पूर्णांक (exact integer) है"},{"en":"Whether the spelling of a word is correct","hi":"क्या किसी शब्द की स्पेलिंग सही है"},{"en":"Whether a date is exactly today's date","hi":"क्या कोई तारीख बिल्कुल आज की तारीख है"}],"exp":{"en":"The EXACT function compares two text strings and returns TRUE if they are exactly the same, including their case (uppercase/lowercase match). Otherwise, it returns FALSE.","hi":"EXACT फंक्शन दो टेक्स्ट स्ट्रिंग्स की तुलना करता है। यह केस-सेंसिटिव होता है, इसलिए \"Excel\" और \"EXCEL\" को अलग मानता है और FALSE रिटर्न करेगा।"},"num":146},{"id":"q147","q":{"en":"What is the use of the 'TIME' function in Excel?","hi":"Excel में 'TIME' फंक्शन का क्या उपयोग है?"},"a":{"en":"It creates an Excel time value from hour, minute, and second components (e.g., =TIME(12,8,56) displays 12:08:56 in time format)","hi":"यह घंटे, मिनट और सेकंड से एक्सेल टाइम वैल्यू बनाता है (जैसे, =TIME(12,8,56) टाइम-फॉर्मेट में 12:08:56 दिखाता है)"},"o":[{"en":"It creates an Excel time value from hour, minute, and second components (e.g., =TIME(12,8,56) displays 12:08:56 in time format)","hi":"यह घंटे, मिनट और सेकंड से एक्सेल टाइम वैल्यू बनाता है (जैसे, =TIME(12,8,56) टाइम-फॉर्मेट में 12:08:56 दिखाता है)"},{"en":"It starts a stopwatch in the worksheet","hi":"यह वर्कशीट में स्टॉपवॉच शुरू करता है"},{"en":"It calculates the time difference between two time zones","hi":"यह दो टाइम ज़ोन के बीच के समय का अंतर निकालता है"},{"en":"It inserts today's current live time continuously","hi":"यह आज का वर्तमान लाइव समय लगातार डालता है"}],"exp":{"en":"The TIME function (Syntax: TIME(hour, minute, second)) converts distinct hour, minute, and second numbers into a valid Excel time serial number/format.","hi":"TIME फंक्शन अलग-अलग दिए गए घंटे, मिनट और सेकंड को मिलाकर एक मान्य एक्सेल टाइम फॉर्मेट बनाता है।"},"num":147},{"id":"q148","q":{"en":"What is the difference between the 'TODAY()' and 'NOW()' functions in Excel?","hi":"Excel में 'TODAY()' और 'NOW()' फंक्शन के बीच क्या अंतर है?"},"a":{"en":"TODAY() returns the current date only; NOW() returns the current date and time (both can update upon workbook recalculation)","hi":"TODAY() केवल वर्तमान दिनांक (date) देता है; NOW() वर्तमान दिनांक और समय (date and time) दोनों देता है (दोनों वर्कबुक रीकैलकुलेशन के साथ अपडेट हो सकते हैं)"},"o":[{"en":"TODAY() returns the current date only; NOW() returns the current date and time (both can update upon workbook recalculation)","hi":"TODAY() केवल वर्तमान दिनांक (date) देता है; NOW() वर्तमान दिनांक और समय (date and time) दोनों देता है (दोनों वर्कबुक रीकैलकुलेशन के साथ अपडेट हो सकते हैं)"},{"en":"TODAY() returns tomorrow's date; NOW() returns yesterday's date","hi":"TODAY() कल की तारीख देता है; NOW() कल की तारीख देता है"},{"en":"TODAY() returns the time only; NOW() returns the date only","hi":"TODAY() केवल समय देता है; NOW() केवल तारीख देता है"},{"en":"There is no difference; they both return only the year","hi":"कोई अंतर नहीं है; दोनों केवल वर्ष देते हैं"}],"exp":{"en":"TODAY() yields the current system date. NOW() yields both the current system date and the current time. Both are volatile functions that update whenever the sheet calculates.","hi":"TODAY() फंक्शन केवल वर्तमान तारीख (Date) देता है, जबकि NOW() फंक्शन वर्तमान तारीख और समय (Date and Time) दोनों देता है।"},"num":148},{"id":"q149","q":{"en":"What is the use of the 'DATEVALUE' function in Excel?","hi":"Excel में 'DATEVALUE' फंक्शन का क्या उपयोग है?"},"a":{"en":"It converts a recognizable text date into an Excel date serial number (text format may depend on regional settings)","hi":"यह पहचानने योग्य टेक्स्ट डेट को एक्सेल डेट सीरियल नंबर (date serial number) में बदलता है (टेक्स्ट का फॉर्मेट क्षेत्रीय सेटिंग्स/regional settings पर निर्भर कर सकता है)"},"o":[{"en":"It converts a recognizable text date into an Excel date serial number (text format may depend on regional settings)","hi":"यह पहचानने योग्य टेक्स्ट डेट को एक्सेल डेट सीरियल नंबर (date serial number) में बदलता है (टेक्स्ट का फॉर्मेट क्षेत्रीय सेटिंग्स/regional settings पर निर्भर कर सकता है)"},{"en":"It extracts the day of the week from a date","hi":"यह किसी तारीख से सप्ताह का दिन (day of the week) निकालता है"},{"en":"It formats a number into currency","hi":"यह किसी संख्या को मुद्रा (currency) में फॉर्मेट करता है"},{"en":"It counts how many days have passed since 1900","hi":"यह गिनता है कि 1900 के बाद से कितने दिन बीत चुके हैं"}],"exp":{"en":"The DATEVALUE function converts a date represented as a text string (e.g., \"01-Jan-2023\") into a valid Excel serial number that can be used in date math.","hi":"DATEVALUE फंक्शन टेक्स्ट के रूप में लिखी गई तारीख (Date) को एक्सेल के समझने योग्य डेट सीरियल नंबर में बदल देता है।"},"num":149},{"id":"q150","q":{"en":"What is the difference between 'SUM' and 'AutoSum' in Excel?","hi":"Excel में 'SUM' और 'AutoSum' में क्या अंतर है?"},"a":{"en":"SUM adds numbers together; AutoSum automatically inserts a SUM formula for a selected or adjacent range (Windows shortcut is Alt+=)","hi":"SUM संख्याओं को जोड़ता है; AutoSum किसी चयनित या आसन्न (adjacent) रेंज के लिए स्वतः SUM फॉर्मूला डाल देता है (विंडोज़ शॉर्टकट Alt+= है)"},"o":[{"en":"SUM adds numbers together; AutoSum automatically inserts a SUM formula for a selected or adjacent range (Windows shortcut is Alt+=)","hi":"SUM संख्याओं को जोड़ता है; AutoSum किसी चयनित या आसन्न (adjacent) रेंज के लिए स्वतः SUM फॉर्मूला डाल देता है (विंडोज़ शॉर्टकट Alt+= है)"},{"en":"SUM subtracts numbers; AutoSum multiplies them","hi":"SUM संख्याएँ घटाता है; AutoSum उन्हें गुणा करता है"},{"en":"SUM works only on rows; AutoSum works only on columns","hi":"SUM केवल पंक्तियों (rows) पर काम करता है; AutoSum केवल कॉलम पर काम करता है"},{"en":"There is no difference; AutoSum is just the Spanish translation of SUM","hi":"कोई अंतर नहीं है; AutoSum केवल SUM का स्पेनिश अनुवाद है"}],"exp":{"en":"SUM is the mathematical function (=SUM(A1:A5)). AutoSum is a Ribbon tool/shortcut (Alt+=) that automatically detects a range of numbers and inserts the SUM function for you.","hi":"SUM एक फंक्शन है जो संख्याओं को जोड़ता है। AutoSum एक टूल/बटन है जो स्वतः रेंज को पहचान कर उसमें SUM फॉर्मूला लगा देता है (इसका शॉर्टकट Alt+= है)।"},"num":150},{"id":"q151","q":{"en":"What do the 'MAX' and 'MIN' functions return in Excel?","hi":"Excel में 'MAX' और 'MIN' फंक्शन क्या देते (return करते) हैं?"},"a":{"en":"The largest and smallest values respectively (e.g., =MAX(20,25,15) returns 25, and =MIN(20,25,15) returns 15)","hi":"क्रमशः सबसे बड़ी और सबसे छोटी वैल्यूज़ (जैसे, =MAX(20,25,15) 25 देता है, और =MIN(20,25,15) 15 देता है)"},"o":[{"en":"The largest and smallest values respectively (e.g., =MAX(20,25,15) returns 25, and =MIN(20,25,15) returns 15)","hi":"क्रमशः सबसे बड़ी और सबसे छोटी वैल्यूज़ (जैसे, =MAX(20,25,15) 25 देता है, और =MIN(20,25,15) 15 देता है)"},{"en":"The average and sum of values respectively","hi":"क्रमशः औसत और संख्याओं का योग"},{"en":"The length of text and number of spaces respectively","hi":"क्रमशः टेक्स्ट की लंबाई और रिक्त स्थान की संख्या"},{"en":"The first and last values in a column respectively","hi":"क्रमशः एक कॉलम में पहला और अंतिम मान"}],"exp":{"en":"MAX evaluates a range of numbers and returns the highest (maximum) value. MIN evaluates a range and returns the lowest (minimum) value.","hi":"MAX फंक्शन दी गई संख्याओं में से सबसे बड़ी (Maximum) संख्या बताता है, जबकि MIN फंक्शन सबसे छोटी (Minimum) संख्या बताता है।"},"num":151},{"id":"q152","q":{"en":"What does the 'COUNT' function count in Excel?","hi":"Excel में 'COUNT' फंक्शन क्या गिनता है?"},"a":{"en":"It counts numerical entries in a range (e.g., =COUNT(2,\"Text\",7) returns 2; dates and times can also be counted as numeric values)","hi":"यह एक रेंज में संख्यात्मक प्रविष्टियों (numerical entries) को गिनता है (जैसे, =COUNT(2,\"Text\",7) 2 देता है; दिनांक और समय को भी संख्यात्मक मान के रूप में गिना जा सकता है)"},"o":[{"en":"It counts numerical entries in a range (e.g., =COUNT(2,\"Text\",7) returns 2; dates and times can also be counted as numeric values)","hi":"यह एक रेंज में संख्यात्मक प्रविष्टियों (numerical entries) को गिनता है (जैसे, =COUNT(2,\"Text\",7) 2 देता है; दिनांक और समय को भी संख्यात्मक मान के रूप में गिना जा सकता है)"},{"en":"It counts only blank cells","hi":"यह केवल खाली (blank) सेल्स को गिनता है"},{"en":"It counts all cells containing text","hi":"यह टेक्स्ट वाली सभी सेल्स को गिनता है"},{"en":"It counts grammatical errors","hi":"यह व्याकरण की त्रुटियों को गिनता है"}],"exp":{"en":"The COUNT function only tallies cells that contain numbers (including dates and times, which are stored as serial numbers). It ignores empty cells, text, and errors.","hi":"COUNT फंक्शन केवल उन सेल्स को गिनता है जिनमें संख्याएँ (Numbers) होती हैं (दिनांक और समय भी संख्याओं के रूप में गिने जाते हैं)। यह टेक्स्ट या खाली सेल्स को नहीं गिनता।"},"num":152},{"id":"q153","q":{"en":"What is the use of the 'COUNTIF' function and what is an example of it?","hi":"Excel में 'COUNTIF' फंक्शन का उपयोग और उसका उदाहरण क्या है?"},"a":{"en":"It counts cells that meet specific criteria; e.g., =COUNTIF(A1:A10,\">=60\") counts values that are 60 or greater","hi":"यह उन सेल्स को गिनता है जो विशिष्ट मानदंडों (criteria) को पूरा करती हैं; जैसे, =COUNTIF(A1:A10,\">=60\") उन मानों को गिनता है जो 60 या उससे अधिक हैं"},"o":[{"en":"It counts cells that meet specific criteria; e.g., =COUNTIF(A1:A10,\">=60\") counts values that are 60 or greater","hi":"यह उन सेल्स को गिनता है जो विशिष्ट मानदंडों (criteria) को पूरा करती हैं; जैसे, =COUNTIF(A1:A10,\">=60\") उन मानों को गिनता है जो 60 या उससे अधिक हैं"},{"en":"It adds numbers if they are positive","hi":"यह संख्याओं को जोड़ता है यदि वे सकारात्मक हैं"},{"en":"It deletes cells containing duplicate values","hi":"यह डुप्लिकेट मान वाली सेल्स को हटा देता है"},{"en":"It checks if a cell contains text","hi":"यह जाँचता है कि क्या सेल में टेक्स्ट है"}],"exp":{"en":"COUNTIF conditionally counts cells within a range that match a single criterion (like numbers greater than 60, or text equal to 'Apple').","hi":"COUNTIF फंक्शन किसी रेंज में केवल उन सेल्स की गिनती करता है जो एक दी गई शर्त (criteria) को पूरा करती हैं।"},"num":153},{"id":"q154","q":{"en":"What is the use of the 'SUMIF' function and what is an example of it?","hi":"Excel में 'SUMIF' फंक्शन का उपयोग और उसका उदाहरण क्या है?"},"a":{"en":"It adds corresponding values when criteria are matched; e.g., =SUMIF(A2:A10,\"Bihar\",B2:B10) adds the B values for rows where A is 'Bihar'","hi":"जब मानदंड (criteria) मेल खाते हैं तो यह संबंधित मानों (corresponding values) को जोड़ता है; जैसे, =SUMIF(A2:A10,\"Bihar\",B2:B10) 'Bihar' वाली पंक्तियों के लिए कॉलम B के मानों को जोड़ता है"},"o":[{"en":"It adds corresponding values when criteria are matched; e.g., =SUMIF(A2:A10,\"Bihar\",B2:B10) adds the B values for rows where A is 'Bihar'","hi":"जब मानदंड (criteria) मेल खाते हैं तो यह संबंधित मानों (corresponding values) को जोड़ता है; जैसे, =SUMIF(A2:A10,\"Bihar\",B2:B10) 'Bihar' वाली पंक्तियों के लिए कॉलम B के मानों को जोड़ता है"},{"en":"It counts cells that are empty","hi":"यह उन सेल्स को गिनता है जो खाली हैं"},{"en":"It subtracts values if they are negative","hi":"यदि मान नकारात्मक हैं तो यह उन्हें घटाता है"},{"en":"It finds the maximum value in a range","hi":"यह एक रेंज में अधिकतम मान खोजता है"}],"exp":{"en":"SUMIF evaluates a range against a criterion and sums the numeric values in a corresponding sum_range for every row that matches.","hi":"SUMIF फंक्शन दी गई शर्त (criteria) के आधार पर मूल्यों (values) को जोड़ता है। उदाहरण में, जहाँ-जहाँ A कॉलम में 'Bihar' लिखा होगा, वह B कॉलम के सिर्फ उन्हीं नंबरों को जोड़ेगा।"},"num":154},{"id":"q155","q":{"en":"What do the 'AVERAGE' and 'PRODUCT' functions return in Excel?","hi":"Excel में 'AVERAGE' और 'PRODUCT' फंक्शन क्या देते हैं?"},"a":{"en":"AVERAGE returns the arithmetic mean, and PRODUCT returns the multiplication result (e.g., =AVERAGE(2,4,6) returns 4, and =PRODUCT(2,3,4) returns 24)","hi":"AVERAGE अंकगणितीय माध्य (arithmetic mean) देता है, और PRODUCT गुणन (multiplication) परिणाम देता है (जैसे, =AVERAGE(2,4,6) 4 देता है, और =PRODUCT(2,3,4) 24 देता है)"},"o":[{"en":"AVERAGE returns the arithmetic mean, and PRODUCT returns the multiplication result (e.g., =AVERAGE(2,4,6) returns 4, and =PRODUCT(2,3,4) returns 24)","hi":"AVERAGE अंकगणितीय माध्य (arithmetic mean) देता है, और PRODUCT गुणन (multiplication) परिणाम देता है (जैसे, =AVERAGE(2,4,6) 4 देता है, और =PRODUCT(2,3,4) 24 देता है)"},{"en":"AVERAGE finds the median, and PRODUCT finds the mode","hi":"AVERAGE माध्यिका (median) खोजता है, और PRODUCT बहुलक (mode) खोजता है"},{"en":"AVERAGE adds numbers, and PRODUCT subtracts them","hi":"AVERAGE संख्याएँ जोड़ता है, और PRODUCT उन्हें घटाता है"},{"en":"AVERAGE returns the highest value, and PRODUCT returns the lowest","hi":"AVERAGE उच्चतम मान देता है, और PRODUCT न्यूनतम मान देता है"}],"exp":{"en":"AVERAGE computes the arithmetic mean of given numbers. PRODUCT multiplies all numbers given as arguments together.","hi":"AVERAGE फंक्शन संख्याओं का औसत (mean) निकालता है, और PRODUCT फंक्शन दी गई संख्याओं को आपस में गुणा (multiply) करता है।"},"num":155},{"id":"q156","q":{"en":"What is the difference between the 'AND', 'OR', and 'NOT' functions in Excel?","hi":"Excel में 'AND', 'OR' और 'NOT' फंक्शन के बीच क्या अंतर है?"},"a":{"en":"AND requires all conditions to be TRUE; OR requires at least one condition to be TRUE; NOT reverses the Boolean value","hi":"AND में सभी शर्तों (conditions) का TRUE होना आवश्यक है; OR में कम से कम एक शर्त का TRUE होना आवश्यक है; NOT बूलियन (Boolean) मान को उलट देता है (reverse करता है)"},"o":[{"en":"AND requires all conditions to be TRUE; OR requires at least one condition to be TRUE; NOT reverses the Boolean value","hi":"AND में सभी शर्तों (conditions) का TRUE होना आवश्यक है; OR में कम से कम एक शर्त का TRUE होना आवश्यक है; NOT बूलियन (Boolean) मान को उलट देता है (reverse करता है)"},{"en":"AND joins text, OR splits text, NOT deletes text","hi":"AND टेक्स्ट जोड़ता है, OR टेक्स्ट विभाजित करता है, NOT टेक्स्ट हटाता है"},{"en":"AND multiplies, OR divides, NOT subtracts","hi":"AND गुणा करता है, OR विभाजित करता है, NOT घटाता है"},{"en":"There is no difference; all three mean TRUE","hi":"कोई अंतर नहीं है; तीनों का अर्थ TRUE है"}],"exp":{"en":"These are logical functions. AND returns TRUE only if every argument is true. OR returns TRUE if any one argument is true. NOT flips TRUE to FALSE (and vice versa).","hi":"AND में परिणाम तभी TRUE आता है जब सभी शर्तें पूरी हों। OR में कोई भी एक शर्त पूरी होने पर परिणाम TRUE आता है। NOT परिणाम को उल्टा कर देता है (TRUE को FALSE और FALSE को TRUE)।"},"num":156},{"id":"q157","q":{"en":"What is the syntax of the 'IF' function and what is an example of it?","hi":"Excel में 'IF' फंक्शन का सिंटैक्स (syntax) और उदाहरण क्या है?"},"a":{"en":"=IF(test, value_if_true, value_if_false); e.g., =IF(A2>=40,\"Pass\",\"Fail\")","hi":"=IF(test, value_if_true, value_if_false); जैसे, =IF(A2>=40,\"Pass\",\"Fail\")"},"o":[{"en":"=IF(test, value_if_true, value_if_false); e.g., =IF(A2>=40,\"Pass\",\"Fail\")","hi":"=IF(test, value_if_true, value_if_false); जैसे, =IF(A2>=40,\"Pass\",\"Fail\")"},{"en":"=IF(value_if_true, test, value_if_false); e.g., =IF(\"Pass\", A2>=40, \"Fail\")","hi":"=IF(value_if_true, test, value_if_false); जैसे, =IF(\"Pass\", A2>=40, \"Fail\")"},{"en":"=IF(value_if_false, value_if_true, test); e.g., =IF(\"Fail\", \"Pass\", A2>=40)","hi":"=IF(value_if_false, value_if_true, test); जैसे, =IF(\"Fail\", \"Pass\", A2>=40)"},{"en":"=IF(test); e.g., =IF(A2>=40)","hi":"=IF(test); जैसे, =IF(A2>=40)"}],"exp":{"en":"The IF function runs a logical test. If the test evaluates to TRUE, it returns the second argument; if FALSE, it returns the third argument.","hi":"IF फंक्शन एक शर्त (logical test) की जाँच करता है। यदि शर्त सही (TRUE) है तो यह पहला परिणाम देता है (जैसे \"Pass\"), और यदि गलत (FALSE) है तो यह दूसरा परिणाम देता है (जैसे \"Fail\")।"},"num":157},{"id":"q158","q":{"en":"What are the uses of the 'SQRT' and 'POWER' functions in Excel?","hi":"Excel में 'SQRT' और 'POWER' फंक्शन का उपयोग क्या है?"},"a":{"en":"=SQRT(49) returns the positive square root 7; =POWER(2,3) returns 8 (2 raised to power 3)","hi":"=SQRT(49) धनात्मक वर्गमूल (positive square root) 7 देता है; =POWER(2,3) 8 देता है (2 की घात 3)"},"o":[{"en":"=SQRT(49) returns the positive square root 7; =POWER(2,3) returns 8 (2 raised to power 3)","hi":"=SQRT(49) धनात्मक वर्गमूल (positive square root) 7 देता है; =POWER(2,3) 8 देता है (2 की घात 3)"},{"en":"=SQRT squares a number; =POWER finds the square root","hi":"=SQRT संख्या का वर्ग करता है; =POWER वर्गमूल खोजता है"},{"en":"=SQRT divides by 2; =POWER multiplies by 10","hi":"=SQRT 2 से विभाजित करता है; =POWER 10 से गुणा करता है"},{"en":"Both functions generate random numbers","hi":"दोनों फंक्शन यादृच्छिक (random) संख्याएँ उत्पन्न करते हैं"}],"exp":{"en":"SQRT returns the positive square root of a number. POWER returns the result of a number raised to a specified exponent/power.","hi":"SQRT फंक्शन किसी संख्या का वर्गमूल (Square root) निकालता है (जैसे 49 का 7)। POWER फंक्शन किसी संख्या की घात (power) की गणना करता है (जैसे 2^3 = 8)।"},"num":158},{"id":"q159","q":{"en":"What do the 'ABS' and 'MOD' functions return in Excel?","hi":"Excel में 'ABS' और 'MOD' फंक्शन क्या देते (return करते) हैं?"},"a":{"en":"=ABS(-2) returns the absolute value 2; =MOD(12,5) returns the remainder 2","hi":"=ABS(-2) निरपेक्ष मान (absolute value) 2 देता है; =MOD(12,5) शेषफल (remainder) 2 देता है"},"o":[{"en":"=ABS(-2) returns the absolute value 2; =MOD(12,5) returns the remainder 2","hi":"=ABS(-2) निरपेक्ष मान (absolute value) 2 देता है; =MOD(12,5) शेषफल (remainder) 2 देता है"},{"en":"=ABS adds numbers; =MOD subtracts numbers","hi":"=ABS संख्याएँ जोड़ता है; =MOD संख्याएँ घटाता है"},{"en":"=ABS returns text; =MOD returns dates","hi":"=ABS टेक्स्ट देता है; =MOD तारीखें देता है"},{"en":"=ABS finds the average; =MOD finds the median","hi":"=ABS औसत खोजता है; =MOD माध्यिका खोजता है"}],"exp":{"en":"ABS returns the absolute (positive) value of a number by removing its sign. MOD returns the remainder after a number is divided by a divisor.","hi":"ABS फंक्शन किसी संख्या का निरपेक्ष मान (बिना माइनस चिह्न के) देता है। MOD फंक्शन किसी संख्या को भाग देने पर बचने वाला शेषफल (Remainder) बताता है (जैसे 12 को 5 से भाग देने पर शेष 2)।"},"num":159},{"id":"q160","q":{"en":"What are examples of the 'FLOOR' and 'CEILING' functions with positive numbers?","hi":"धनात्मक संख्याओं (positive numbers) के साथ 'FLOOR' और 'CEILING' फंक्शन के उदाहरण क्या हैं?"},"a":{"en":"=FLOOR(27,6) rounds down to a multiple of 6 (returns 24); =CEILING(27,6) rounds up (returns 30); =CEILING(7,5) rounds up to 10","hi":"=FLOOR(27,6) 6 के गुणज (multiple) तक नीचे (round down) करता है (24 देता है); =CEILING(27,6) ऊपर (round up) करता है (30 देता है); =CEILING(7,5) 10 तक राउंड अप करता है"},"o":[{"en":"=FLOOR(27,6) rounds down to a multiple of 6 (returns 24); =CEILING(27,6) rounds up (returns 30); =CEILING(7,5) rounds up to 10","hi":"=FLOOR(27,6) 6 के गुणज (multiple) तक नीचे (round down) करता है (24 देता है); =CEILING(27,6) ऊपर (round up) करता है (30 देता है); =CEILING(7,5) 10 तक राउंड अप करता है"},{"en":"=FLOOR rounds up to 100; =CEILING rounds down to 0","hi":"=FLOOR 100 तक राउंड अप करता है; =CEILING 0 तक राउंड डाउन करता है"},{"en":"=FLOOR counts cells; =CEILING adds cells","hi":"=FLOOR सेल्स गिनता है; =CEILING सेल्स जोड़ता है"},{"en":"Both functions return the exact number without rounding","hi":"दोनों फंक्शन बिना राउंड किए सटीक संख्या देते हैं"}],"exp":{"en":"FLOOR rounds a number down toward zero to the nearest specified multiple. CEILING rounds a number up away from zero to the nearest multiple.","hi":"FLOOR फंक्शन संख्या को दिए गए गुणज (multiple) तक नीचे (round down) ले जाता है (जैसे 27, 6 के पहाड़े में नीचे 24 तक जाता है)। CEILING फंक्शन संख्या को ऊपर (round up) ले जाता है (जैसे 27 के बाद 6 के पहाड़े में 30)।"},"num":160},{"id":"q161","q":{"en":"Does the 'FLOOR' function always round toward zero in Excel?","hi":"क्या 'FLOOR' फंक्शन Excel में हमेशा शून्य (zero) की ओर राउंड करता है?"},"a":{"en":"No, for negative values the behavior depends on the specific function (e.g., FLOOR vs FLOOR.MATH) and the sign of the significance; e.g., =FLOOR(-7,5) returns -10 (rounds away from zero)","hi":"नहीं, नकारात्मक (negative) मानों के लिए व्यवहार विशिष्ट फंक्शन (जैसे FLOOR बनाम FLOOR.MATH) और सार्थकता (significance) के चिह्न पर निर्भर करता है; जैसे =FLOOR(-7,5) -10 देता है (शून्य से दूर राउंड करता है)"},"o":[{"en":"No, for negative values the behavior depends on the specific function (e.g., FLOOR vs FLOOR.MATH) and the sign of the significance; e.g., =FLOOR(-7,5) returns -10 (rounds away from zero)","hi":"नहीं, नकारात्मक (negative) मानों के लिए व्यवहार विशिष्ट फंक्शन (जैसे FLOOR बनाम FLOOR.MATH) और सार्थकता (significance) के चिह्न पर निर्भर करता है; जैसे =FLOOR(-7,5) -10 देता है (शून्य से दूर राउंड करता है)"},{"en":"Yes, it always rounds exactly to zero regardless of the number","hi":"हाँ, यह हमेशा संख्या की परवाह किए बिना बिल्कुल शून्य की ओर राउंड करता है"},{"en":"It rounds positive numbers up and negative numbers up","hi":"यह सकारात्मक संख्याओं को ऊपर (up) और नकारात्मक संख्याओं को ऊपर राउंड करता है"},{"en":"It only works with positive integers","hi":"यह केवल सकारात्मक पूर्णांकों (positive integers) के साथ काम करता है"}],"exp":{"en":"While FLOOR rounds positive numbers down (toward zero) to a multiple, for negative numbers like =FLOOR(-7,5), it rounds away from zero to -10 (a lower number). (For exams, focus on the positive rounding behavior).","hi":"धनात्मक (positive) संख्याओं के लिए FLOOR हमेशा नीचे (शून्य की ओर) राउंड करता है, लेकिन ऋणात्मक (negative) संख्याओं (जैसे -7) के लिए यह -10 (शून्य से दूर) राउंड करता है। परीक्षा के लिए सकारात्मक उदाहरण (lower multiple) याद रखना बेहतर है।"},"num":161},{"id":"q162","q":{"en":"What will be the result of the formula '=ROUND(5.23692, 4)'?","hi":"फॉर्मूला '=ROUND(5.23692, 4)' का परिणाम क्या होगा?"},"a":{"en":"5.2369 (the second argument specifies the number of decimal places)","hi":"5.2369 (दूसरा तर्क/argument दशमलव स्थानों की संख्या निर्दिष्ट करता है)"},"o":[{"en":"5.2369 (the second argument specifies the number of decimal places)","hi":"5.2369 (दूसरा तर्क/argument दशमलव स्थानों की संख्या निर्दिष्ट करता है)"},{"en":"5.2370","hi":"5.2370"},{"en":"5.0000","hi":"5.0000"},{"en":"5.236","hi":"5.236"}],"exp":{"en":"The ROUND function rounds a number to a specified number of digits. =ROUND(5.23692, 4) rounds the number to 4 decimal places. The 5th digit '2' is less than 5, so it rounds down to 5.2369.","hi":"ROUND फंक्शन संख्या को निर्दिष्ट दशमलव (decimal) स्थानों तक राउंड करता है। 4 दशमलव स्थानों के बाद पाँचवाँ अंक 2 है (जो 5 से कम है), इसलिए परिणाम 5.2369 ही रहेगा।"},"num":162},{"id":"q163","q":{"en":"What are the results of '=EVEN(11)', '=EVEN(-9)', and '=ODD(8)' respectively?","hi":"क्रमशः '=EVEN(11)', '=EVEN(-9)' और '=ODD(8)' का परिणाम क्या होगा?"},"a":{"en":"12, -10, and 9 (EVEN/ODD functions round away from zero to the next relevant parity)","hi":"12, -10, और 9 (EVEN/ODD फंक्शन प्रासंगिक सम/विषम संख्या तक शून्य से दूर/away from zero राउंड करते हैं)"},"o":[{"en":"12, -10, and 9 (EVEN/ODD functions round away from zero to the next relevant parity)","hi":"12, -10, और 9 (EVEN/ODD फंक्शन प्रासंगिक सम/विषम संख्या तक शून्य से दूर/away from zero राउंड करते हैं)"},{"en":"10, -8, and 7","hi":"10, -8, और 7"},{"en":"11, -9, and 8","hi":"11, -9, और 8"},{"en":"12.1, -9.1, and 8.1","hi":"12.1, -9.1, और 8.1"}],"exp":{"en":"The EVEN function rounds a number up (away from zero) to the nearest even integer, and ODD rounds up (away from zero) to the nearest odd integer.","hi":"EVEN फंक्शन संख्या को अगले सम (even) पूर्णांक तक और ODD फंक्शन अगले विषम (odd) पूर्णांक तक (शून्य से दूर) ले जाते हैं। इसलिए 11 का 12, -9 का -10, और 8 का 9 होगा।"},"num":163},{"id":"q164","q":{"en":"What does the 'MATCH' function return in Excel?","hi":"Excel में 'MATCH' फंक्शन क्या देता (return करता) है?"},"a":{"en":"The relative position of a lookup value in an array/range (e.g., =MATCH(\"B\",A1:A3,0) returns its exact match position)","hi":"किसी एरे/रेंज में खोजी गई वैल्यू (lookup value) की सापेक्ष स्थिति (relative position) (जैसे, =MATCH(\"B\",A1:A3,0) सटीक मैच की स्थिति बताता है)"},"o":[{"en":"The relative position of a lookup value in an array/range (e.g., =MATCH(\"B\",A1:A3,0) returns its exact match position)","hi":"किसी एरे/रेंज में खोजी गई वैल्यू (lookup value) की सापेक्ष स्थिति (relative position) (जैसे, =MATCH(\"B\",A1:A3,0) सटीक मैच की स्थिति बताता है)"},{"en":"The actual value from the cell instead of its position","hi":"स्थिति (position) के बजाय सेल से वास्तविक मान (actual value)"},{"en":"The number of cells that match the criteria","hi":"उन सेल्स की संख्या जो मानदंड से मेल खाती हैं"},{"en":"The sum of all matched values","hi":"सभी मेल खाने वाले मानों का योग"}],"exp":{"en":"The MATCH function searches for a specified item in a range of cells, and then returns the relative position of that item in the range (not the value itself).","hi":"MATCH फंक्शन किसी रेंज में किसी विशेष आइटम को खोजता है और उसकी सापेक्ष स्थिति (Position/स्थान) बताता है कि वह रेंज में किस नंबर पर है।"},"num":164},{"id":"q165","q":{"en":"What is the difference between a 'formula' and a 'function' in Excel?","hi":"Excel में 'फॉर्मूला' (Formula) और 'फंक्शन' (Function) में क्या अंतर है?"},"a":{"en":"A formula is a calculation expression written by the user that starts with '='; a function is a predefined built-in operation (like SUM or IF)","hi":"फॉर्मूला उपयोगकर्ता द्वारा लिखा गया एक गणना व्यंजक (calculation expression) है जो '=' से शुरू होता है; फंक्शन एक पूर्व-परिभाषित अंतर्निहित ऑपरेशन (predefined built-in operation) है (जैसे SUM या IF)"},"o":[{"en":"A formula is a calculation expression written by the user that starts with '='; a function is a predefined built-in operation (like SUM or IF)","hi":"फॉर्मूला उपयोगकर्ता द्वारा लिखा गया एक गणना व्यंजक (calculation expression) है जो '=' से शुरू होता है; फंक्शन एक पूर्व-परिभाषित अंतर्निहित ऑपरेशन (predefined built-in operation) है (जैसे SUM या IF)"},{"en":"A function starts with a '+'; a formula starts with a '-'","hi":"फंक्शन '+' से शुरू होता है; फॉर्मूला '-' से शुरू होता है"},{"en":"Formulas only use letters; functions only use numbers","hi":"फॉर्मूले केवल अक्षरों का उपयोग करते हैं; फंक्शन केवल संख्याओं का उपयोग करते हैं"},{"en":"There is no difference; the terms are perfectly interchangeable in all contexts","hi":"कोई अंतर नहीं है; दोनों शब्द सभी संदर्भों में पूरी तरह से विनिमेय (interchangeable) हैं"}],"exp":{"en":"A Formula is any equation you type into a cell (e.g., =A1+B1). A Function is a pre-programmed calculation built into Excel (e.g., SUM, AVERAGE) that you can use inside your formulas.","hi":"फॉर्मूला वह समीकरण है जिसे आप खुद लिखते हैं (जैसे =A1+B1)। फंक्शन Excel में पहले से बना हुआ (predefined) एक कमांड होता है (जैसे SUM या IF) जिसका उपयोग आप फॉर्मूले में करते हैं।"},"num":165},{"id":"q166","q":{"en":"What is the difference between using shortcuts (Ctrl+; / Ctrl+Shift+;) and the TODAY()/NOW() functions for dates/times?","hi":"दिनांक/समय के लिए शॉर्टकट (Ctrl+; / Ctrl+Shift+;) का उपयोग करने और TODAY()/NOW() फंक्शन का उपयोग करने में क्या अंतर है?"},"a":{"en":"Shortcuts insert a fixed, static current date/time value; TODAY/NOW are dynamic formulas that recalculate and update","hi":"शॉर्टकट एक निश्चित (fixed), स्थिर वर्तमान दिनांक/समय मान डालते हैं; TODAY/NOW गतिशील (dynamic) फॉर्मूले हैं जो फिर से गणना (recalculate) और अपडेट होते हैं"},"o":[{"en":"Shortcuts insert a fixed, static current date/time value; TODAY/NOW are dynamic formulas that recalculate and update","hi":"शॉर्टकट एक निश्चित (fixed), स्थिर वर्तमान दिनांक/समय मान डालते हैं; TODAY/NOW गतिशील (dynamic) फॉर्मूले हैं जो फिर से गणना (recalculate) और अपडेट होते हैं"},{"en":"Shortcuts only work on Macs; functions only work on Windows","hi":"शॉर्टकट केवल Mac पर काम करते हैं; फंक्शन केवल Windows पर काम करते हैं"},{"en":"Shortcuts insert tomorrow's date; functions insert yesterday's date","hi":"शॉर्टकट कल की तारीख डालते हैं; फंक्शन कल (बीते हुए) की तारीख डालते हैं"},{"en":"There is no difference; both update automatically every minute","hi":"कोई अंतर नहीं है; दोनों हर मिनट स्वतः अपडेट होते हैं"}],"exp":{"en":"Pressing Ctrl+; inserts a 'static' timestamp of the current date that will never change. Using the =TODAY() function inserts a 'dynamic' date that updates every time you open or calculate the workbook.","hi":"शॉर्टकट (Ctrl+;) से डाली गई तारीख स्थिर (static) होती है और बदलती नहीं है। जबकि TODAY() या NOW() फंक्शन से डाली गई तारीख/समय वर्कबुक खुलने या रीकैलकुलेट होने पर अपने आप अपडेट हो जाती है।"},"num":166}]},{"title":{"en":"8. Excel Shortcuts — File, Ribbon, Formatting & Entry","hi":"8. एक्सेल शॉर्टकट — फाइल, रिबन, फॉर्मेटिंग और एंट्री"},"questions":[{"id":"q167","q":{"en":"Which keyboard shortcuts are used in Excel to create a New workbook, Open, Save, and Save As?","hi":"Excel में नई वर्कबुक बनाने (New), ओपन (Open), सेव (Save) और सेव ऐज़ (Save As) के शॉर्टकट क्या हैं?"},"a":{"en":"Ctrl+N (New), Ctrl+O (Open), Ctrl+S or Shift+F12 (Save), and F12 or Alt+F2 (Save As)","hi":"Ctrl+N (नया), Ctrl+O (खोलना), Ctrl+S या Shift+F12 (सेव), और F12 या Alt+F2 (सेव ऐज़)"},"o":[{"en":"Ctrl+N (New), Ctrl+O (Open), Ctrl+S or Shift+F12 (Save), and F12 or Alt+F2 (Save As)","hi":"Ctrl+N (नया), Ctrl+O (खोलना), Ctrl+S या Shift+F12 (सेव), और F12 या Alt+F2 (सेव ऐज़)"},{"en":"Ctrl+C (New), Ctrl+V (Open), Ctrl+X (Save), and Ctrl+Z (Save As)","hi":"Ctrl+C, Ctrl+V, Ctrl+X और Ctrl+Z"},{"en":"Alt+N (New), Alt+O (Open), Alt+S (Save), and Alt+A (Save As)","hi":"Alt+N, Alt+O, Alt+S और Alt+A"},{"en":"Shift+N (New), Shift+O (Open), Shift+S (Save), and Shift+A (Save As)","hi":"Shift+N, Shift+O, Shift+S और Shift+A"}],"exp":{"en":"Standard Excel file shortcuts: Ctrl+N creates a new workbook, Ctrl+O opens one, Ctrl+S (and Shift+F12) saves the current workbook, while F12 (and the classic Alt+F2) opens the Save As dialog.","hi":"Excel में New के लिए Ctrl+N, Open के लिए Ctrl+O, Save के लिए Ctrl+S (या Shift+F12) और Save As के लिए F12 (या क्लासिक Alt+F2) का उपयोग होता है।"},"num":167},{"id":"q168","q":{"en":"What are the keyboard shortcuts to close an Excel workbook, exit the Excel application, and print?","hi":"Excel वर्कबुक को बंद करने (Close), Excel एप्लिकेशन से बाहर निकलने (Exit) और प्रिंट (Print) करने के शॉर्टकट क्या हैं?"},"a":{"en":"Ctrl+W or Ctrl+F4 (close workbook); Alt+F4 (close app); Ctrl+P (Print)","hi":"Ctrl+W या Ctrl+F4 (वर्कबुक बंद करना); Alt+F4 (ऐप बंद करना); Ctrl+P (प्रिंट)"},"o":[{"en":"Ctrl+W or Ctrl+F4 (close workbook); Alt+F4 (close app); Ctrl+P (Print)","hi":"Ctrl+W या Ctrl+F4 (वर्कबुक बंद करना); Alt+F4 (ऐप बंद करना); Ctrl+P (प्रिंट)"},{"en":"Ctrl+X (close workbook); Alt+X (close app); Ctrl+R (Print)","hi":"Ctrl+X, Alt+X और Ctrl+R"},{"en":"Shift+C (close workbook); Shift+E (close app); Shift+P (Print)","hi":"Shift+C, Shift+E और Shift+P"},{"en":"Alt+W (close workbook); Ctrl+Alt+W (close app); Alt+P (Print)","hi":"Alt+W, Ctrl+Alt+W और Alt+P"}],"exp":{"en":"Ctrl+W or Ctrl+F4 closes the active workbook window only. Alt+F4 closes the entire Excel application. Ctrl+P opens the Print pane.","hi":"केवल सक्रिय वर्कबुक को बंद करने के लिए Ctrl+W या Ctrl+F4 का उपयोग होता है। पूरे Excel एप्लिकेशन को बंद करने के लिए Alt+F4 और प्रिंट करने के लिए Ctrl+P का उपयोग होता है।"},"num":168},{"id":"q169","q":{"en":"What are the standard and legacy Excel keyboard shortcuts for Cut, Copy, Paste, Undo, and Redo?","hi":"Excel में Cut, Copy, Paste, Undo और Redo के मानक (standard) और लीगेसी (legacy) कीबोर्ड शॉर्टकट क्या हैं?"},"a":{"en":"Standard: Ctrl+X, Ctrl+C, Ctrl+V, Ctrl+Z, Ctrl+Y; Legacy equivalents: Shift+Delete (cut), Ctrl+Insert (copy), and Shift+Insert (paste)","hi":"मानक: Ctrl+X, Ctrl+C, Ctrl+V, Ctrl+Z, Ctrl+Y; लीगेसी समतुल्य: Shift+Delete (कट), Ctrl+Insert (कॉपी), और Shift+Insert (पेस्ट)"},"o":[{"en":"Standard: Ctrl+X, Ctrl+C, Ctrl+V, Ctrl+Z, Ctrl+Y; Legacy equivalents: Shift+Delete (cut), Ctrl+Insert (copy), and Shift+Insert (paste)","hi":"मानक: Ctrl+X, Ctrl+C, Ctrl+V, Ctrl+Z, Ctrl+Y; लीगेसी समतुल्य: Shift+Delete (कट), Ctrl+Insert (कॉपी), और Shift+Insert (पेस्ट)"},{"en":"Standard: Alt+X, Alt+C, Alt+V, Alt+Z, Alt+Y; Legacy: F1, F2, F3","hi":"मानक: Alt+X, Alt+C, Alt+V, Alt+Z, Alt+Y; लीगेसी: F1, F2, F3"},{"en":"Standard: Ctrl+1, Ctrl+2, Ctrl+3, Ctrl+4, Ctrl+5; Legacy: Alt+1, Alt+2, Alt+3","hi":"मानक: Ctrl+1, Ctrl+2, Ctrl+3, Ctrl+4, Ctrl+5; लीगेसी: Alt+1, Alt+2, Alt+3"},{"en":"Standard: Shift+X, Shift+C, Shift+V, Shift+Z, Shift+Y; Legacy: Ctrl+Backspace","hi":"मानक: Shift+X, Shift+C, Shift+V, Shift+Z, Shift+Y; लीगेसी: Ctrl+Backspace"}],"exp":{"en":"While Ctrl+X, C, V, Z, and Y are the standard Windows shortcuts, Excel still supports the legacy IBM CUA shortcuts: Shift+Delete (Cut), Ctrl+Insert (Copy), and Shift+Insert (Paste).","hi":"मानक शॉर्टकट्स के अलावा, Excel पुराने शॉर्टकट्स को भी सपोर्ट करता है: कट के लिए Shift+Delete, कॉपी के लिए Ctrl+Insert, और पेस्ट के लिए Shift+Insert।"},"num":169},{"id":"q170","q":{"en":"What are the Excel keyboard shortcuts for Find, Replace, Go To, and inserting a Hyperlink?","hi":"Excel में Find, Replace, Go To और Hyperlink डालने के कीबोर्ड शॉर्टकट क्या हैं?"},"a":{"en":"Ctrl+F (Find), Ctrl+H (Replace), Ctrl+G (Go To), and Ctrl+K (Hyperlink)","hi":"Ctrl+F (फाइंड), Ctrl+H (रिप्लेस), Ctrl+G (गो टू), और Ctrl+K (हाइपरलिंक)"},"o":[{"en":"Ctrl+F (Find), Ctrl+H (Replace), Ctrl+G (Go To), and Ctrl+K (Hyperlink)","hi":"Ctrl+F (फाइंड), Ctrl+H (रिप्लेस), Ctrl+G (गो टू), और Ctrl+K (हाइपरलिंक)"},{"en":"Ctrl+S (Find), Ctrl+R (Replace), Ctrl+J (Go To), and Ctrl+L (Hyperlink)","hi":"Ctrl+S (फाइंड), Ctrl+R (रिप्लेस), Ctrl+J (गो टू), और Ctrl+L (हाइपरलिंक)"},{"en":"Alt+F (Find), Alt+H (Replace), Alt+G (Go To), and Alt+K (Hyperlink)","hi":"Alt+F, Alt+H, Alt+G और Alt+K"},{"en":"Shift+F (Find), Shift+H (Replace), Shift+G (Go To), and Shift+K (Hyperlink)","hi":"Shift+F, Shift+H, Shift+G और Shift+K"}],"exp":{"en":"In MS Excel, Ctrl+F opens the Find dialog, Ctrl+H opens the Replace dialog, Ctrl+G (or F5) opens the Go To dialog, and Ctrl+K opens the Insert Hyperlink dialog.","hi":"Excel में खोजने (Find) के लिए Ctrl+F, बदलने (Replace) के लिए Ctrl+H, किसी विशेष सेल पर जाने (Go To) के लिए Ctrl+G और हाइपरलिंक के लिए Ctrl+K का उपयोग होता है।"},"num":170},{"id":"q171","q":{"en":"Which Ribbon tabs or boxes do the 'Alt+Q', 'Alt+F', and 'Alt+H' access keys open in Excel?","hi":"Excel में 'Alt+Q', 'Alt+F' और 'Alt+H' एक्सेस कुंजियाँ कौन-से रिबन टैब या बॉक्स खोलती हैं?"},"a":{"en":"Alt+Q opens Search/Tell Me, Alt+F opens File, and Alt+H opens Home","hi":"Alt+Q 'Search/Tell Me' खोलता है, Alt+F 'File' खोलता है, और Alt+H 'Home' खोलता है"},"o":[{"en":"Alt+Q opens Search/Tell Me, Alt+F opens File, and Alt+H opens Home","hi":"Alt+Q 'Search/Tell Me' खोलता है, Alt+F 'File' खोलता है, और Alt+H 'Home' खोलता है"},{"en":"Alt+Q opens Query, Alt+F opens Formulas, and Alt+H opens Header","hi":"Alt+Q क्वेरी खोलता है, Alt+F फॉर्मूला खोलता है, और Alt+H हेडर खोलता है"},{"en":"Alt+Q opens Quick Access, Alt+F opens Format, and Alt+H opens Help","hi":"Alt+Q क्विक एक्सेस खोलता है, Alt+F फॉर्मेट खोलता है, और Alt+H हेल्प खोलता है"},{"en":"Alt+Q closes Excel, Alt+F finds text, and Alt+H highlights text","hi":"Alt+Q एक्सेल बंद करता है, Alt+F टेक्स्ट खोजता है, और Alt+H टेक्स्ट हाईलाइट करता है"}],"exp":{"en":"Pressing Alt in Excel activates KeyTips: Alt+Q highlights the 'Tell me what you want to do / Search' box, Alt+F opens the File menu (Backstage), and Alt+H activates the Home tab.","hi":"Excel रिबन पर Alt+Q 'Search/Tell Me' बॉक्स को हाईलाइट करता है, Alt+F से File मेनू (बैकस्टेज) खुलता है, और Alt+H से Home टैब सक्रिय होता है।"},"num":171},{"id":"q172","q":{"en":"What are the Alt-key access shortcuts for the Insert, Page Layout, Formulas, and Data tabs in Excel?","hi":"Excel में Insert, Page Layout, Formulas और Data टैब के लिए Alt-key एक्सेस शॉर्टकट क्या हैं?"},"a":{"en":"Alt+N (Insert), Alt+P (Page Layout), Alt+M (Formulas), and Alt+A (Data)","hi":"Alt+N (इंसर्ट), Alt+P (पेज लेआउट), Alt+M (फॉर्मूला), और Alt+A (डेटा)"},"o":[{"en":"Alt+N (Insert), Alt+P (Page Layout), Alt+M (Formulas), and Alt+A (Data)","hi":"Alt+N (इंसर्ट), Alt+P (पेज लेआउट), Alt+M (फॉर्मूला), और Alt+A (डेटा)"},{"en":"Alt+I (Insert), Alt+L (Page Layout), Alt+F (Formulas), and Alt+D (Data)","hi":"Alt+I, Alt+L, Alt+F और Alt+D"},{"en":"Ctrl+N (Insert), Ctrl+P (Page Layout), Ctrl+M (Formulas), and Ctrl+A (Data)","hi":"Ctrl+N, Ctrl+P, Ctrl+M और Ctrl+A"},{"en":"Shift+I (Insert), Shift+P (Page Layout), Shift+F (Formulas), and Shift+D (Data)","hi":"Shift+I, Shift+P, Shift+F और Shift+D"}],"exp":{"en":"In Excel's KeyTip system: Alt+N = Insert tab, Alt+P = Page Layout tab, Alt+M = Formulas tab (M for Math/Macros context), and Alt+A = Data tab.","hi":"Excel रिबन में Insert टैब के लिए Alt+N, Page Layout के लिए Alt+P, Formulas के लिए Alt+M और Data टैब के लिए Alt+A का उपयोग किया जाता है।"},"num":172},{"id":"q173","q":{"en":"Which keys access the Review and View tabs, and how do you collapse/expand the Ribbon in Excel?","hi":"Excel में Review और View टैब तक पहुँचने की कुंजियाँ क्या हैं, और रिबन को कोलैप्स/एक्सपैंड कैसे करते हैं?"},"a":{"en":"Alt+R (Review), Alt+W (View); Ctrl+F1 collapses or expands the Ribbon","hi":"Alt+R (रिव्यू), Alt+W (व्यू); Ctrl+F1 रिबन को सिकोड़ता (collapse) या फैलाता (expand) है"},"o":[{"en":"Alt+R (Review), Alt+W (View); Ctrl+F1 collapses or expands the Ribbon","hi":"Alt+R (रिव्यू), Alt+W (व्यू); Ctrl+F1 रिबन को सिकोड़ता (collapse) या फैलाता (expand) है"},{"en":"Alt+V (Review), Alt+E (View); Ctrl+R collapses the Ribbon","hi":"Alt+V, Alt+E; Ctrl+R रिबन सिकोड़ता है"},{"en":"Ctrl+R (Review), Ctrl+V (View); Alt+F1 collapses the Ribbon","hi":"Ctrl+R, Ctrl+V; Alt+F1 रिबन सिकोड़ता है"},{"en":"Shift+R (Review), Shift+W (View); F12 collapses the Ribbon","hi":"Shift+R, Shift+W; F12 रिबन सिकोड़ता है"}],"exp":{"en":"Alt+R opens the Review tab, and Alt+W opens the View tab. To quickly show or hide the Ribbon (to gain screen space), you press Ctrl+F1.","hi":"Review टैब के लिए Alt+R और View टैब के लिए Alt+W का उपयोग होता है। रिबन को शो या हाइड (दिखाने या छिपाने) के लिए Ctrl+F1 दबाया जाता है।"},"num":173},{"id":"q174","q":{"en":"What are the KeyTip sequences in Excel for Fill Color, Borders, Center Alignment, and Delete Column?","hi":"Excel में फिल कलर (Fill color), बॉर्डर (Borders), सेंटर अलाइनमेंट (Center alignment) और डिलीट कॉलम (Delete column) के लिए KeyTip सीक्वेंस क्या हैं?"},"a":{"en":"Alt+H, H (fill color); Alt+H, B (borders); Alt+H, A, C (center); Alt+H, D, C (delete columns)","hi":"Alt+H, H (फिल कलर); Alt+H, B (बॉर्डर); Alt+H, A, C (सेंटर); Alt+H, D, C (कॉलम डिलीट)"},"o":[{"en":"Alt+H, H (fill color); Alt+H, B (borders); Alt+H, A, C (center); Alt+H, D, C (delete columns)","hi":"Alt+H, H (फिल कलर); Alt+H, B (बॉर्डर); Alt+H, A, C (सेंटर); Alt+H, D, C (कॉलम डिलीट)"},{"en":"Alt+F (fill color); Alt+B (borders); Alt+C (center); Alt+D (delete columns)","hi":"Alt+F, Alt+B, Alt+C और Alt+D"},{"en":"Ctrl+H (fill color); Ctrl+B (borders); Ctrl+E (center); Ctrl+D (delete columns)","hi":"Ctrl+H, Ctrl+B, Ctrl+E और Ctrl+D"},{"en":"Shift+H (fill color); Shift+B (borders); Shift+C (center); Shift+D (delete columns)","hi":"Shift+H, Shift+B, Shift+C और Shift+D"}],"exp":{"en":"Sequential Ribbon shortcuts (KeyTips): Alt+H accesses Home. Then pressing H opens Fill Color, B opens Borders, A then C centers text, and D then C deletes the current column.","hi":"KeyTips का उपयोग करते हुए: Alt+H, H से Fill Color; Alt+H, B से Borders; Alt+H, A, C से Center alignment; और Alt+H, D, C से कॉलम डिलीट होता है।"},"num":174},{"id":"q175","q":{"en":"How do you open the context menu and the active window's system menu using the keyboard in Excel?","hi":"Excel में कीबोर्ड का उपयोग करके कॉन्टेक्स्ट मेनू (Context menu) और सक्रिय विंडो का सिस्टम मेनू (System menu) कैसे खोलते हैं?"},"a":{"en":"Shift+F10 or the Menu key opens the context (right-click) menu; Alt+Space opens the active window's system menu","hi":"Shift+F10 या Menu कुंजी कॉन्टेक्स्ट (राइट-क्लिक) मेनू खोलती है; Alt+Space सक्रिय विंडो का सिस्टम मेनू खोलता है"},"o":[{"en":"Shift+F10 or the Menu key opens the context (right-click) menu; Alt+Space opens the active window's system menu","hi":"Shift+F10 या Menu कुंजी कॉन्टेक्स्ट (राइट-क्लिक) मेनू खोलती है; Alt+Space सक्रिय विंडो का सिस्टम मेनू खोलता है"},{"en":"Ctrl+Space opens the context menu; Shift+Space opens the system menu","hi":"Ctrl+Space कॉन्टेक्स्ट मेनू खोलता है; Shift+Space सिस्टम मेनू खोलता है"},{"en":"Alt+C opens the context menu; Alt+S opens the system menu","hi":"Alt+C कॉन्टेक्स्ट मेनू खोलता है; Alt+S सिस्टम मेनू खोलता है"},{"en":"F12 opens the context menu; F11 opens the system menu","hi":"F12 कॉन्टेक्स्ट मेनू खोलता है; F11 सिस्टम मेनू खोलता है"}],"exp":{"en":"Shift+F10 acts as a mouse right-click, opening the context menu for the selected cell/object. Alt+Spacebar opens the application window's control menu (Restore, Move, Size, Minimize, Maximize, Close).","hi":"किसी सेल पर राइट-क्लिक करने जैसा कॉन्टेक्स्ट मेनू खोलने के लिए Shift+F10 (या कीबोर्ड की Menu कुंजी) का उपयोग होता है। सक्रिय एप्लिकेशन विंडो का सिस्टम मेनू खोलने के लिए Alt+Space का उपयोग होता है।"},"num":175},{"id":"q176","q":{"en":"What do 'Ctrl+1', 'Ctrl+Shift+F', and 'Ctrl+Shift+P' do in MS Excel?","hi":"MS Excel में 'Ctrl+1', 'Ctrl+Shift+F' और 'Ctrl+Shift+P' क्या करते हैं?"},"a":{"en":"Ctrl+1 opens the Format Cells dialog; Ctrl+Shift+F and Ctrl+Shift+P are shortcuts for Font-related options (opening Format Cells to the Font tab)","hi":"Ctrl+1 'Format Cells' डायलॉग खोलता है; Ctrl+Shift+F और Ctrl+Shift+P फ़ॉन्ट-संबंधित विकल्पों के शॉर्टकट हैं (Format Cells को फ़ॉन्ट टैब पर खोलते हैं)"},"o":[{"en":"Ctrl+1 opens the Format Cells dialog; Ctrl+Shift+F and Ctrl+Shift+P are shortcuts for Font-related options (opening Format Cells to the Font tab)","hi":"Ctrl+1 'Format Cells' डायलॉग खोलता है; Ctrl+Shift+F और Ctrl+Shift+P फ़ॉन्ट-संबंधित विकल्पों के शॉर्टकट हैं (Format Cells को फ़ॉन्ट टैब पर खोलते हैं)"},{"en":"Ctrl+1 saves the file; Ctrl+Shift+F prints it; Ctrl+Shift+P previews it","hi":"Ctrl+1 फाइल सेव करता है; Ctrl+Shift+F प्रिंट करता है; Ctrl+Shift+P प्रीव्यू करता है"},{"en":"Ctrl+1 aligns text left; Ctrl+Shift+F aligns center; Ctrl+Shift+P aligns right","hi":"Ctrl+1 टेक्स्ट बाएँ एलाइन करता है; Ctrl+Shift+F सेंटर करता है; Ctrl+Shift+P दाएँ एलाइन करता है"},{"en":"Ctrl+1 adds a row; Ctrl+Shift+F adds a column; Ctrl+Shift+P adds a page","hi":"Ctrl+1 रो जोड़ता है; Ctrl+Shift+F कॉलम जोड़ता है; Ctrl+Shift+P पेज जोड़ता है"}],"exp":{"en":"Ctrl+1 is the universal shortcut to open the full 'Format Cells' dialog box in Excel. Ctrl+Shift+F and Ctrl+Shift+P also open the Format Cells dialog but switch directly to the Font tab.","hi":"Excel में Ctrl+1 दबाने से 'Format Cells' डायलॉग बॉक्स खुलता है। Ctrl+Shift+F और Ctrl+Shift+P भी इसी डायलॉग बॉक्स को सीधे 'फ़ॉन्ट' (Font) टैब पर खोलते हैं।"},"num":176},{"id":"q177","q":{"en":"What are the Excel keyboard shortcuts for applying Bold, Italic, Underline, and Strikethrough formatting?","hi":"Excel में Bold, Italic, Underline और Strikethrough फॉर्मेटिंग लागू करने के कीबोर्ड शॉर्टकट क्या हैं?"},"a":{"en":"Ctrl+B or Ctrl+2 (Bold), Ctrl+I or Ctrl+3 (Italic), Ctrl+U or Ctrl+4 (Underline), and Ctrl+5 (Strikethrough)","hi":"Ctrl+B या Ctrl+2 (बोल्ड), Ctrl+I या Ctrl+3 (इटैलिक), Ctrl+U या Ctrl+4 (अंडरलाइन), और Ctrl+5 (स्ट्राइकथ्रू)"},"o":[{"en":"Ctrl+B or Ctrl+2 (Bold), Ctrl+I or Ctrl+3 (Italic), Ctrl+U or Ctrl+4 (Underline), and Ctrl+5 (Strikethrough)","hi":"Ctrl+B या Ctrl+2 (बोल्ड), Ctrl+I या Ctrl+3 (इटैलिक), Ctrl+U या Ctrl+4 (अंडरलाइन), और Ctrl+5 (स्ट्राइकथ्रू)"},{"en":"Alt+B, Alt+I, Alt+U, and Alt+S","hi":"Alt+B, Alt+I, Alt+U और Alt+S"},{"en":"Ctrl+6, Ctrl+7, Ctrl+8, and Ctrl+9","hi":"Ctrl+6, Ctrl+7, Ctrl+8 और Ctrl+9"},{"en":"Shift+B, Shift+I, Shift+U, and Shift+S","hi":"Shift+B, Shift+I, Shift+U और Shift+S"}],"exp":{"en":"In addition to the standard letters (Ctrl+B, I, U), Excel uses the number row: Ctrl+2 for Bold, Ctrl+3 for Italic, Ctrl+4 for Underline, and Ctrl+5 for Strikethrough.","hi":"मानक शॉर्टकट्स (Ctrl+B, I, U) के अलावा, Excel में नंबर कुंजियों का भी उपयोग होता है: Ctrl+2 (बोल्ड), Ctrl+3 (इटैलिक), Ctrl+4 (अंडरलाइन) और Ctrl+5 (स्ट्राइकथ्रू/शब्द के बीच में लाइन)।"},"num":177},{"id":"q178","q":{"en":"What are the Excel shortcuts to apply the General, Percentage, Time, and Date number formats?","hi":"Excel में General, Percentage, Time और Date नंबर फॉर्मेट लागू करने के शॉर्टकट क्या हैं?"},"a":{"en":"Ctrl+Shift+~ (General), Ctrl+Shift+% (Percentage), Ctrl+Shift+@ (Time), and Ctrl+Shift+# (Date)","hi":"Ctrl+Shift+~ (जनरल), Ctrl+Shift+% (प्रतिशत), Ctrl+Shift+@ (समय), और Ctrl+Shift+# (दिनांक)"},"o":[{"en":"Ctrl+Shift+~ (General), Ctrl+Shift+% (Percentage), Ctrl+Shift+@ (Time), and Ctrl+Shift+# (Date)","hi":"Ctrl+Shift+~ (जनरल), Ctrl+Shift+% (प्रतिशत), Ctrl+Shift+@ (समय), और Ctrl+Shift+# (दिनांक)"},{"en":"Ctrl+G (General), Ctrl+P (Percentage), Ctrl+T (Time), and Ctrl+D (Date)","hi":"Ctrl+G, Ctrl+P, Ctrl+T और Ctrl+D"},{"en":"Alt+1 (General), Alt+2 (Percentage), Alt+3 (Time), and Alt+4 (Date)","hi":"Alt+1, Alt+2, Alt+3 और Alt+4"},{"en":"Shift+~, Shift+%, Shift+@, and Shift+#","hi":"Shift+~, Shift+%, Shift+@ और Shift+#"}],"exp":{"en":"Excel number formatting shortcuts: Ctrl+Shift+~ applies General format. Ctrl+Shift+% applies Percentage format (with no decimal places). Ctrl+Shift+@ applies Time format. Ctrl+Shift+# applies Date format.","hi":"एक्सेल नंबर फॉर्मेटिंग शॉर्टकट्स: Ctrl+Shift+~ (General), Ctrl+Shift+% (Percentage), Ctrl+Shift+@ (Time - AM/PM के साथ), और Ctrl+Shift+# (Date - दिन, महीना और साल)।"},"num":178},{"id":"q179","q":{"en":"How do you add and remove an outline border around selected cells in Excel?","hi":"Excel में चयनित सेल्स (selected cells) के चारों ओर एक आउटलाइन बॉर्डर कैसे जोड़ते और हटाते हैं?"},"a":{"en":"Ctrl+Shift+& adds an outline border; Ctrl+Shift+_ (underscore) removes the outline border","hi":"Ctrl+Shift+& आउटलाइन बॉर्डर जोड़ता है; Ctrl+Shift+_ (अंडरस्कोर) आउटलाइन बॉर्डर हटाता है"},"o":[{"en":"Ctrl+Shift+& adds an outline border; Ctrl+Shift+_ (underscore) removes the outline border","hi":"Ctrl+Shift+& आउटलाइन बॉर्डर जोड़ता है; Ctrl+Shift+_ (अंडरस्कोर) आउटलाइन बॉर्डर हटाता है"},{"en":"Ctrl+B adds a border; Ctrl+D removes it","hi":"Ctrl+B बॉर्डर जोड़ता है; Ctrl+D इसे हटाता है"},{"en":"Alt+B adds a border; Alt+N removes it","hi":"Alt+B बॉर्डर जोड़ता है; Alt+N इसे हटाता है"},{"en":"F7 adds a border; F8 removes it","hi":"F7 बॉर्डर जोड़ता है; F8 इसे हटाता है"}],"exp":{"en":"Pressing Ctrl+Shift+& applies a solid border around the outer edge of the currently selected range. Pressing Ctrl+Shift+_ (underscore) removes all borders from the selection.","hi":"सेलेक्ट की गई रेंज के बाहरी किनारे पर बॉर्डर लगाने के लिए Ctrl+Shift+& का उपयोग होता है, और सभी बॉर्डर हटाने के लिए Ctrl+Shift+_ (अंडरस्कोर) का उपयोग किया जाता है।"},"num":179},{"id":"q180","q":{"en":"What do 'Ctrl+6' and 'Ctrl+8' toggle in Excel?","hi":"Excel में 'Ctrl+6' और 'Ctrl+8' क्या टॉगल करते (चालू/बंद करते) हैं?"},"a":{"en":"Ctrl+6 toggles the display setting of objects (like charts or shapes); Ctrl+8 toggles the display of outline symbols","hi":"Ctrl+6 ऑब्जेक्ट्स (जैसे चार्ट या शेप्स) की डिस्प्ले सेटिंग को टॉगल करता है; Ctrl+8 आउटलाइन प्रतीकों (outline symbols) के डिस्प्ले को टॉगल करता है"},"o":[{"en":"Ctrl+6 toggles the display setting of objects (like charts or shapes); Ctrl+8 toggles the display of outline symbols","hi":"Ctrl+6 ऑब्जेक्ट्स (जैसे चार्ट या शेप्स) की डिस्प्ले सेटिंग को टॉगल करता है; Ctrl+8 आउटलाइन प्रतीकों (outline symbols) के डिस्प्ले को टॉगल करता है"},{"en":"Ctrl+6 hides columns; Ctrl+8 hides rows","hi":"Ctrl+6 कॉलम छिपाता है; Ctrl+8 पंक्तियाँ छिपाता है"},{"en":"Ctrl+6 zooms in; Ctrl+8 zooms out","hi":"Ctrl+6 ज़ूम इन करता है; Ctrl+8 ज़ूम आउट करता है"},{"en":"Ctrl+6 saves the file; Ctrl+8 prints the file","hi":"Ctrl+6 फाइल सेव करता है; Ctrl+8 फाइल प्रिंट करता है"}],"exp":{"en":"Ctrl+6 alternates between hiding objects, displaying objects, and displaying placeholders for objects. Ctrl+8 displays or hides the outline symbols (if the sheet has grouped data/subtotals).","hi":"Ctrl+6 वर्कशीट में मौजूद ऑब्जेक्ट्स (चार्ट, इमेज आदि) को दिखाने या छिपाने के लिए है। Ctrl+8 आउटलाइन सिंबल्स (ग्रुपिंग/सबटोटल के +/- बटन) को दिखाता या छिपाता है।"},"num":180},{"id":"q181","q":{"en":"What are the shortcuts to hide/unhide rows and columns in Excel, and what is the Windows keyboard setting warning?","hi":"Excel में पंक्तियों (rows) और कॉलम को छिपाने/दिखाने (hide/unhide) के शॉर्टकट क्या हैं, और विंडोज़ कीबोर्ड सेटिंग की चेतावनी क्या है?"},"a":{"en":"Ctrl+9 hides rows, Ctrl+0 hides columns, Ctrl+Shift+( unhides rows, Ctrl+Shift+) unhides columns where available (Windows keyboard settings can intercept the column unhide shortcut)","hi":"Ctrl+9 पंक्तियाँ छिपाता है, Ctrl+0 कॉलम छिपाता है, Ctrl+Shift+( पंक्तियाँ दिखाता है, Ctrl+Shift+) कॉलम दिखाता है जहाँ उपलब्ध हो (विंडोज़ कीबोर्ड सेटिंग्स कॉलम अनहाइड शॉर्टकट को रोक/intercept कर सकती हैं)"},"o":[{"en":"Ctrl+9 hides rows, Ctrl+0 hides columns, Ctrl+Shift+( unhides rows, Ctrl+Shift+) unhides columns where available (Windows keyboard settings can intercept the column unhide shortcut)","hi":"Ctrl+9 पंक्तियाँ छिपाता है, Ctrl+0 कॉलम छिपाता है, Ctrl+Shift+( पंक्तियाँ दिखाता है, Ctrl+Shift+) कॉलम दिखाता है जहाँ उपलब्ध हो (विंडोज़ कीबोर्ड सेटिंग्स कॉलम अनहाइड शॉर्टकट को रोक/intercept कर सकती हैं)"},{"en":"Alt+9 hides rows, Alt+0 hides columns, Alt+Shift+9 unhides rows, Alt+Shift+0 unhides columns","hi":"Alt+9, Alt+0, Alt+Shift+9 और Alt+Shift+0"},{"en":"F9 hides rows, F10 hides columns, Shift+F9 unhides rows, Shift+F10 unhides columns","hi":"F9, F10, Shift+F9 और Shift+F10"},{"en":"Ctrl+R hides rows, Ctrl+C hides columns, Alt+R unhides rows, Alt+C unhides columns","hi":"Ctrl+R, Ctrl+C, Alt+R और Alt+C"}],"exp":{"en":"Ctrl+9 hides the selected rows and Ctrl+0 hides columns. Ctrl+Shift+( unhides rows. Note: In many Windows systems, Ctrl+Shift+) to unhide columns fails because Windows intercepts it to switch keyboard layouts.","hi":"रो (Rows) को छिपाने के लिए Ctrl+9 और दिखाने के लिए Ctrl+Shift+( का उपयोग होता है। कॉलम छिपाने के लिए Ctrl+0 और दिखाने के लिए Ctrl+Shift+) का उपयोग होता है (हालाँकि कुछ विंडोज़ सेटिंग्स इस अंतिम शॉर्टकट को रोक सकती हैं)।"},"num":181},{"id":"q182","q":{"en":"How do you insert the current date, current time, and a line break inside the same cell in Excel?","hi":"Excel में वर्तमान दिनांक (Date), समय (Time) और एक ही सेल के भीतर लाइन ब्रेक (Line break) कैसे डालते हैं?"},"a":{"en":"Ctrl+; inserts date, Ctrl+Shift+; inserts time, and Alt+Enter inserts a line break within the same cell","hi":"Ctrl+; दिनांक डालता है, Ctrl+Shift+; समय डालता है, और Alt+Enter उसी सेल के भीतर लाइन ब्रेक डालता है"},"o":[{"en":"Ctrl+; inserts date, Ctrl+Shift+; inserts time, and Alt+Enter inserts a line break within the same cell","hi":"Ctrl+; दिनांक डालता है, Ctrl+Shift+; समय डालता है, और Alt+Enter उसी सेल के भीतर लाइन ब्रेक डालता है"},{"en":"Ctrl+D inserts date, Ctrl+T inserts time, and Ctrl+Enter inserts a line break","hi":"Ctrl+D दिनांक डालता है, Ctrl+T समय डालता है, और Ctrl+Enter लाइन ब्रेक डालता है"},{"en":"Alt+D inserts date, Alt+T inserts time, and Shift+Enter inserts a line break","hi":"Alt+D दिनांक डालता है, Alt+T समय डालता है, और Shift+Enter लाइन ब्रेक डालता है"},{"en":"F1 inserts date, F2 inserts time, and Esc inserts a line break","hi":"F1 दिनांक डालता है, F2 समय डालता है, और Esc लाइन ब्रेक डालता है"}],"exp":{"en":"Pressing Ctrl+; inserts today's date, and Ctrl+Shift+; (which is Ctrl+:) inserts the current time. When typing in a cell, pressing Alt+Enter starts a new line of text within that same cell.","hi":"सेल में वर्तमान डेट के लिए Ctrl+; और टाइम के लिए Ctrl+Shift+; दबाया जाता है। टाइप करते समय उसी सेल के अंदर नई लाइन (Line break) शुरू करने के लिए Alt+Enter का उपयोग होता है।"},"num":182},{"id":"q183","q":{"en":"Which keys are used to commit a cell entry, cancel an entry, or fill an entry across a selected range in Excel?","hi":"Excel में सेल एंट्री को सबमिट (commit) करने, रद्द (cancel) करने, या चयनित रेंज में एंट्री भरने (fill) के लिए किन कुंजियों का उपयोग किया जाता है?"},"a":{"en":"Enter commits and normally moves down (Shift+Enter moves up, Tab moves right, Shift+Tab moves left); Esc cancels the entry; Ctrl+Enter fills the current entry into the entire selected range","hi":"Enter कमिट करता है और सामान्यतः नीचे जाता है (Shift+Enter ऊपर, Tab दाएँ, Shift+Tab बाएँ जाता है); Esc एंट्री रद्द करता है; Ctrl+Enter वर्तमान एंट्री को पूरी चयनित रेंज में भरता (fill) है"},"o":[{"en":"Enter commits and normally moves down (Shift+Enter moves up, Tab moves right, Shift+Tab moves left); Esc cancels the entry; Ctrl+Enter fills the current entry into the entire selected range","hi":"Enter कमिट करता है और सामान्यतः नीचे जाता है (Shift+Enter ऊपर, Tab दाएँ, Shift+Tab बाएँ जाता है); Esc एंट्री रद्द करता है; Ctrl+Enter वर्तमान एंट्री को पूरी चयनित रेंज में भरता (fill) है"},{"en":"Space commits, Backspace cancels, and Alt+Enter fills the range","hi":"Space कमिट करता है, Backspace रद्द करता है, और Alt+Enter रेंज भरता है"},{"en":"Insert commits, Delete cancels, and Shift+Enter fills the range","hi":"Insert कमिट करता है, Delete रद्द करता है, और Shift+Enter रेंज भरता है"},{"en":"F9 commits, F10 cancels, and F11 fills the range","hi":"F9 कमिट करता है, F10 रद्द करता है, और F11 रेंज भरता है"}],"exp":{"en":"When typing in a cell: Enter saves it and moves the active cell down. Esc discards your typing. If you highlight multiple cells, typing data and pressing Ctrl+Enter populates all highlighted cells with that same data.","hi":"Enter दबाने पर डेटा सेल में सेव हो जाता है और कर्सर नीचे चला जाता है। Esc दबाने से टाइप किया गया डेटा रद्द हो जाता है। यदि कई सेल्स सेलेक्ट की गई हैं, तो Ctrl+Enter दबाने से वह डेटा सभी सेलेक्टेड सेल्स में एक साथ भर (fill) जाता है।"},"num":183},{"id":"q184","q":{"en":"What do the 'Fill Down' and 'Fill Right' shortcuts do in Excel?","hi":"Excel में 'Fill Down' और 'Fill Right' शॉर्टकट्स क्या करते हैं?"},"a":{"en":"Ctrl+D (Fill Down) and Ctrl+R (Fill Right) copy the content and format from the topmost or leftmost cell of a selection into the adjacent cells in that direction","hi":"Ctrl+D (Fill Down) और Ctrl+R (Fill Right) किसी सेलेक्शन के सबसे ऊपरी (top) या सबसे बाएँ (left) सेल के कंटेंट और फॉर्मेट को उसी दिशा में आसन्न (adjacent) सेल्स में कॉपी करते हैं"},"o":[{"en":"Ctrl+D (Fill Down) and Ctrl+R (Fill Right) copy the content and format from the topmost or leftmost cell of a selection into the adjacent cells in that direction","hi":"Ctrl+D (Fill Down) और Ctrl+R (Fill Right) किसी सेलेक्शन के सबसे ऊपरी (top) या सबसे बाएँ (left) सेल के कंटेंट और फॉर्मेट को उसी दिशा में आसन्न (adjacent) सेल्स में कॉपी करते हैं"},{"en":"Ctrl+Down deletes content, Ctrl+Right deletes formatting","hi":"Ctrl+Down कंटेंट हटाता है, Ctrl+Right फॉर्मेटिंग हटाता है"},{"en":"Alt+D adds a row down, Alt+R adds a column right","hi":"Alt+D नीचे एक रो जोड़ता है, Alt+R दाएँ एक कॉलम जोड़ता है"},{"en":"Shift+D sorts data down, Shift+R sorts data right","hi":"Shift+D डेटा को नीचे सॉर्ट करता है, Shift+R डेटा को दाएँ सॉर्ट करता है"}],"exp":{"en":"Ctrl+D copies the contents and formatting of the topmost cell(s) of a selected range down into the cells below it. Ctrl+R copies the leftmost cell(s) to the right.","hi":"Ctrl+D (Fill Down) सेलेक्ट की गई रेंज में सबसे ऊपर वाली सेल का डेटा और फॉर्मेटिंग नीचे की सेल्स में कॉपी कर देता है। Ctrl+R (Fill Right) सबसे बायीं सेल का डेटा दायीं तरफ की सेल्स में कॉपी करता है।"},"num":184},{"id":"q185","q":{"en":"How do you copy just the value or just the formula from the cell directly above the active cell in Excel?","hi":"Excel में सक्रिय सेल (active cell) के ठीक ऊपर वाली सेल से केवल मान (value) या केवल फॉर्मूला (formula) कैसे कॉपी करते हैं?"},"a":{"en":"Ctrl+Shift+\" (quotation mark) copies the value; Ctrl+' (apostrophe) copies the formula","hi":"Ctrl+Shift+\" (उद्धरण चिह्न) मान (value) को कॉपी करता है; Ctrl+' (अपोस्ट्रोफी) फॉर्मूले (formula) को कॉपी करता है"},"o":[{"en":"Ctrl+Shift+\" (quotation mark) copies the value; Ctrl+' (apostrophe) copies the formula","hi":"Ctrl+Shift+\" (उद्धरण चिह्न) मान (value) को कॉपी करता है; Ctrl+' (अपोस्ट्रोफी) फॉर्मूले (formula) को कॉपी करता है"},{"en":"Ctrl+V copies the value; Ctrl+C copies the formula","hi":"Ctrl+V मान कॉपी करता है; Ctrl+C फॉर्मूला कॉपी करता है"},{"en":"Alt+V copies the value; Alt+F copies the formula","hi":"Alt+V मान कॉपी करता है; Alt+F फॉर्मूला कॉपी करता है"},{"en":"Shift+1 copies the value; Shift+2 copies the formula","hi":"Shift+1 मान कॉपी करता है; Shift+2 फॉर्मूला कॉपी करता है"}],"exp":{"en":"Ctrl+Shift+\" copies the value from the cell above the active cell into the cell or the Formula Bar. Ctrl+' copies a formula from the cell above into the active cell or Formula Bar.","hi":"ऊपर वाली सेल से केवल मान (Result/Value) कॉपी करने के लिए Ctrl+Shift+\" (डबल कोट्स) दबाएँ। यदि आप ऊपर वाली सेल का मूल फॉर्मूला (Formula) कॉपी करना चाहते हैं, तो Ctrl+' (सिंगल कोट) दबाएँ।"},"num":185},{"id":"q186","q":{"en":"Which keyboard shortcuts are used to clear, delete, or insert selected cells in Excel?","hi":"Excel में चयनित सेल्स (selected cells) को क्लियर (clear), डिलीट (delete) या इन्सर्ट (insert) करने के लिए किन कीबोर्ड शॉर्टकट्स का उपयोग किया जाता है?"},"a":{"en":"Delete clears cell contents; Ctrl+− opens the Delete Cells dialog; Ctrl+Shift++ opens the Insert Cells dialog","hi":"Delete सेल के कंटेंट को क्लियर करता है; Ctrl+− (माइनस) 'Delete Cells' डायलॉग खोलता है; Ctrl+Shift++ (प्लस) 'Insert Cells' डायलॉग खोलता है"},"o":[{"en":"Delete clears cell contents; Ctrl+− opens the Delete Cells dialog; Ctrl+Shift++ opens the Insert Cells dialog","hi":"Delete सेल के कंटेंट को क्लियर करता है; Ctrl+− (माइनस) 'Delete Cells' डायलॉग खोलता है; Ctrl+Shift++ (प्लस) 'Insert Cells' डायलॉग खोलता है"},{"en":"Backspace clears cell contents; Alt+− deletes cells; Alt++ inserts cells","hi":"Backspace सेल के कंटेंट को क्लियर करता है; Alt+− सेल्स डिलीट करता है; Alt++ सेल्स इन्सर्ट करता है"},{"en":"Esc clears cell contents; Ctrl+D deletes cells; Ctrl+I inserts cells","hi":"Esc सेल के कंटेंट को क्लियर करता है; Ctrl+D सेल्स डिलीट करता है; Ctrl+I सेल्स इन्सर्ट करता है"},{"en":"Space clears cell contents; Shift+D deletes cells; Shift+I inserts cells","hi":"Space सेल के कंटेंट को क्लियर करता है; Shift+D सेल्स डिलीट करता है; Shift+I सेल्स इन्सर्ट करता है"}],"exp":{"en":"Pressing the Delete key erases the contents of selected cells (leaving formatting). Ctrl + Minus (-) deletes the actual cells (shifting surrounding cells). Ctrl + Shift + Plus (+) inserts new cells.","hi":"Delete कुंजी केवल सेल का डेटा हटाती है (सेल वहीं रहती है)। Ctrl+− (माइनस) पूरी सेल/रो/कॉलम को डिलीट करने का डायलॉग खोलता है, और Ctrl+Shift++ (प्लस) नई सेल/रो/कॉलम जोड़ने का डायलॉग खोलता है।"},"num":186},{"id":"q187","q":{"en":"What do Backspace, Delete, and Ctrl+Delete do when you are in cell edit mode in Excel?","hi":"जब आप Excel में सेल एडिट मोड (cell edit mode) में होते हैं तो Backspace, Delete और Ctrl+Delete क्या करते हैं?"},"a":{"en":"Backspace deletes the left character, Delete deletes the right character, and Ctrl+Delete deletes text from the insertion point to the end of the line","hi":"Backspace बाएँ अक्षर को डिलीट करता है, Delete दाएँ अक्षर को डिलीट करता है, और Ctrl+Delete इंसर्शन पॉइंट (कर्सर) से लाइन के अंत तक का टेक्स्ट डिलीट करता है"},"o":[{"en":"Backspace deletes the left character, Delete deletes the right character, and Ctrl+Delete deletes text from the insertion point to the end of the line","hi":"Backspace बाएँ अक्षर को डिलीट करता है, Delete दाएँ अक्षर को डिलीट करता है, और Ctrl+Delete इंसर्शन पॉइंट (कर्सर) से लाइन के अंत तक का टेक्स्ट डिलीट करता है"},{"en":"Backspace undoes typing, Delete clears the cell entirely, and Ctrl+Delete deletes the row","hi":"Backspace टाइपिंग को अनडू करता है, Delete सेल को पूरी तरह से क्लियर करता है, और Ctrl+Delete रो को डिलीट करता है"},{"en":"Backspace moves left, Delete moves right, and Ctrl+Delete jumps to the next cell","hi":"Backspace बाएँ जाता है, Delete दाएँ जाता है, और Ctrl+Delete अगली सेल पर जंप करता है"},{"en":"Backspace adds a space, Delete removes a space, and Ctrl+Delete removes all spaces","hi":"Backspace स्पेस जोड़ता है, Delete स्पेस हटाता है, और Ctrl+Delete सभी स्पेस हटाता है"}],"exp":{"en":"While editing a cell's text in the formula bar or directly in the cell: Backspace removes characters to the left of the cursor, Delete removes characters to the right, and Ctrl+Delete erases everything from the cursor to the end of the text.","hi":"सेल एडिट करते समय: Backspace कर्सर के बायीं ओर का अक्षर मिटाता है, Delete दायीं ओर का अक्षर मिटाता है, और Ctrl+Delete कर्सर से लेकर लाइन के अंत तक का सारा टेक्स्ट एक साथ मिटा देता है।"},"num":187},{"id":"q188","q":{"en":"What was the legacy shortcut for entering an array formula in Excel (and how has it changed with dynamic arrays)?","hi":"Excel में एरे फॉर्मूला (array formula) दर्ज करने का लीगेसी शॉर्टकट क्या था (और डायनामिक एरे के साथ यह कैसे बदल गया है)?"},"a":{"en":"Ctrl+Shift+Enter (CSE) was required for legacy array formulas; with modern dynamic arrays, a normal 'Enter' may be sufficient","hi":"लीगेसी एरे फॉर्मूले के लिए Ctrl+Shift+Enter (CSE) आवश्यक था; आधुनिक डायनामिक एरे के साथ, एक सामान्य 'Enter' ही पर्याप्त हो सकता है"},"o":[{"en":"Ctrl+Shift+Enter (CSE) was required for legacy array formulas; with modern dynamic arrays, a normal 'Enter' may be sufficient","hi":"लीगेसी एरे फॉर्मूले के लिए Ctrl+Shift+Enter (CSE) आवश्यक था; आधुनिक डायनामिक एरे के साथ, एक सामान्य 'Enter' ही पर्याप्त हो सकता है"},{"en":"Alt+Shift+Enter was required; now you use Ctrl+Enter","hi":"Alt+Shift+Enter आवश्यक था; अब आप Ctrl+Enter का उपयोग करते हैं"},{"en":"F4 was required; now you use F5","hi":"F4 आवश्यक था; अब आप F5 का उपयोग करते हैं"},{"en":"Ctrl+A was required; now you use Alt+A","hi":"Ctrl+A आवश्यक था; अब आप Alt+A का उपयोग करते हैं"}],"exp":{"en":"Historically, users had to press Ctrl+Shift+Enter (CSE) to calculate an array formula, wrapping it in { }. Modern Excel (Microsoft 365) supports dynamic arrays that spill automatically using just the Enter key.","hi":"पुराने Excel में एरे फॉर्मूला (Array formula) को लागू करने के लिए Ctrl+Shift+Enter दबाना पड़ता था (जिससे फॉर्मूले के दोनों तरफ { } लग जाते थे)। नए Excel में डायनामिक एरे के कारण अक्सर केवल Enter दबाना ही काफी होता है।"},"num":188},{"id":"q189","q":{"en":"How do you toggle between displaying formulas and their calculated values in an Excel worksheet?","hi":"Excel वर्कशीट में फॉर्मूले (formulas) और उनके गणना किए गए मानों (calculated values) को दिखाने के बीच टॉगल (toggle) कैसे करते हैं?"},"a":{"en":"Press Ctrl+grave accent (`) (Note: A formula normally starts with an '=' sign)","hi":"Ctrl+grave accent (`) दबाएँ (ध्यान दें: एक फॉर्मूला सामान्यतः '=' चिह्न से शुरू होता है)"},"o":[{"en":"Press Ctrl+grave accent (`) (Note: A formula normally starts with an '=' sign)","hi":"Ctrl+grave accent (`) दबाएँ (ध्यान दें: एक फॉर्मूला सामान्यतः '=' चिह्न से शुरू होता है)"},{"en":"Press Alt+F","hi":"Alt+F दबाएँ"},{"en":"Press Shift+Enter","hi":"Shift+Enter दबाएँ"},{"en":"Press Ctrl+T","hi":"Ctrl+T दबाएँ"}],"exp":{"en":"Pressing Ctrl+` (the grave accent/tilde key usually located below Esc) toggles the worksheet view to show all underlying formulas instead of their resulting values.","hi":"वर्कशीट में नंबरों के बजाय उनके पीछे छिपे फॉर्मूले देखने के लिए Ctrl+` (Esc के नीचे वाली कुंजी) दबाई जाती है। (याद रखें: Excel में हर फॉर्मूला '=' से शुरू होता है)।"},"num":189},{"id":"q190","q":{"en":"Which shortcuts are used in Excel to Paste a Name, open the Name Manager, and Create Names from Selection?","hi":"Excel में नेम पेस्ट करने (Paste Name), नेम मैनेजर (Name Manager) खोलने और सेलेक्शन से नाम बनाने (Create Names from Selection) के लिए किन शॉर्टकट्स का उपयोग किया जाता है?"},"a":{"en":"F3 pastes a defined name; Ctrl+F3 opens the Name Manager (in newer desktop versions); Ctrl+Shift+F3 creates names from selected cells","hi":"जब नाम परिभाषित (defined) हों तो F3 नाम पेस्ट करता है; Ctrl+F3 (नए डेस्कटॉप संस्करणों में) नेम मैनेजर खोलता है; Ctrl+Shift+F3 सेलेक्ट किए गए सेल्स से नाम बनाता है"},"o":[{"en":"F3 pastes a defined name; Ctrl+F3 opens the Name Manager (in newer desktop versions); Ctrl+Shift+F3 creates names from selected cells","hi":"जब नाम परिभाषित (defined) हों तो F3 नाम पेस्ट करता है; Ctrl+F3 (नए डेस्कटॉप संस्करणों में) नेम मैनेजर खोलता है; Ctrl+Shift+F3 सेलेक्ट किए गए सेल्स से नाम बनाता है"},{"en":"F1 pastes a name; F2 opens Name Manager; F4 creates names","hi":"F1 नाम पेस्ट करता है; F2 नेम मैनेजर खोलता है; F4 नाम बनाता है"},{"en":"Alt+P pastes a name; Alt+N opens Name Manager; Alt+C creates names","hi":"Alt+P नाम पेस्ट करता है; Alt+N नेम मैनेजर खोलता है; Alt+C नाम बनाता है"},{"en":"Ctrl+V pastes a name; Ctrl+M opens Name Manager; Ctrl+S creates names","hi":"Ctrl+V नाम पेस्ट करता है; Ctrl+M नेम मैनेजर खोलता है; Ctrl+S नाम बनाता है"}],"exp":{"en":"If you have defined names in your workbook, F3 displays the Paste Name dialog. Ctrl+F3 opens the Name Manager. Ctrl+Shift+F3 automatically generates names based on row/column labels in the selection.","hi":"डिफाइंड नेम्स (Defined names) का उपयोग करते समय: F3 नाम पेस्ट करने का डायलॉग खोलता है, Ctrl+F3 'नेम मैनेजर' खोलता है, और Ctrl+Shift+F3 चयनित रेंज के शीर्षकों (labels) के आधार पर नाम बनाता है।"},"num":190},{"id":"q191","q":{"en":"What are the source legacy shortcuts for the Styles dialog, Save As, and Smart Tag action menus in Excel?","hi":"Excel में Styles डायलॉग, Save As और स्मार्ट टैग (Smart Tag) एक्शन मेनू के लिए सोर्स लीगेसी शॉर्टकट क्या हैं?"},"a":{"en":"Alt+' (apostrophe) for Style dialog (legacy); Alt+F2 for Save As; Alt+Shift+F10 for available error/action menu","hi":"Alt+' (अपोस्ट्रोफी) स्टाइल डायलॉग (लीगेसी) के लिए; Alt+F2 सेव ऐज़ के लिए; Alt+Shift+F10 उपलब्ध एरर/एक्शन मेनू के लिए"},"o":[{"en":"Alt+' (apostrophe) for Style dialog (legacy); Alt+F2 for Save As; Alt+Shift+F10 for available error/action menu","hi":"Alt+' (अपोस्ट्रोफी) स्टाइल डायलॉग (लीगेसी) के लिए; Alt+F2 सेव ऐज़ के लिए; Alt+Shift+F10 उपलब्ध एरर/एक्शन मेनू के लिए"},{"en":"Ctrl+S for Styles, Ctrl+A for Save As, Ctrl+M for Smart Tag","hi":"Ctrl+S स्टाइल्स के लिए, Ctrl+A सेव ऐज़ के लिए, Ctrl+M स्मार्ट टैग के लिए"},{"en":"F5 for Styles, F6 for Save As, F7 for Smart Tag","hi":"F5 स्टाइल्स के लिए, F6 सेव ऐज़ के लिए, F7 स्मार्ट टैग के लिए"},{"en":"Shift+1 for Styles, Shift+2 for Save As, Shift+3 for Smart Tag","hi":"Shift+1 स्टाइल्स के लिए, Shift+2 सेव ऐज़ के लिए, Shift+3 स्मार्ट टैग के लिए"}],"exp":{"en":"Classic shortcuts still supported: Alt+' opens the old Style dialog, Alt+F2 opens the Save As dialog, and Alt+Shift+F10 displays the menu for an active smart tag, error checking, or Paste Options button.","hi":"ये कुछ पुराने लेकिन अभी भी काम करने वाले शॉर्टकट हैं: Alt+' (अपोस्ट्रोफी) से स्टाइल डायलॉग खुलता है, Alt+F2 से Save As खुलता है, और Alt+Shift+F10 किसी स्मार्ट टैग या एरर अलर्ट का मेनू खोलता है।"},"num":191},{"id":"q192","q":{"en":"How do you group or ungroup data outlines using the keyboard in Excel?","hi":"Excel में कीबोर्ड का उपयोग करके डेटा आउटलाइन (data outlines) को ग्रुप (group) या अनग्रुप (ungroup) कैसे करते हैं?"},"a":{"en":"Alt+Shift+Right Arrow to group, and Alt+Shift+Left Arrow to ungroup (applicable to the current selection)","hi":"ग्रुप करने के लिए Alt+Shift+Right Arrow, और अनग्रुप करने के लिए Alt+Shift+Left Arrow (चयनित डेटा पर लागू होता है)"},"o":[{"en":"Alt+Shift+Right Arrow to group, and Alt+Shift+Left Arrow to ungroup (applicable to the current selection)","hi":"ग्रुप करने के लिए Alt+Shift+Right Arrow, और अनग्रुप करने के लिए Alt+Shift+Left Arrow (चयनित डेटा पर लागू होता है)"},{"en":"Ctrl+G to group, and Ctrl+U to ungroup","hi":"ग्रुप करने के लिए Ctrl+G, और अनग्रुप करने के लिए Ctrl+U"},{"en":"Shift+Up Arrow to group, and Shift+Down Arrow to ungroup","hi":"ग्रुप करने के लिए Shift+Up Arrow, और अनग्रुप करने के लिए Shift+Down Arrow"},{"en":"F9 to group, and F10 to ungroup","hi":"ग्रुप करने के लिए F9, और अनग्रुप करने के लिए F10"}],"exp":{"en":"To create an outline grouping of selected rows or columns, press Alt+Shift+Right Arrow. To remove the grouping (ungroup), press Alt+Shift+Left Arrow.","hi":"चयनित (selected) पंक्तियों या कॉलम का ग्रुप (Group) बनाने के लिए Alt+Shift+Right Arrow (दायाँ तीर) और उन्हें अनग्रुप (Ungroup) करने के लिए Alt+Shift+Left Arrow (बायाँ तीर) का उपयोग होता है।"},"num":192},{"id":"q193","q":{"en":"What are the legacy shortcuts for cell notes/comments in Excel?","hi":"Excel में सेल नोट्स/कमेंट्स (notes/comments) के लिए लीगेसी शॉर्टकट क्या हैं?"},"a":{"en":"Shift+F2 adds/edits a cell note; Ctrl+Shift+O selects all cells with notes/comments (in supported desktop versions)","hi":"Shift+F2 सेल नोट (note) जोड़ता/एडिट करता है; Ctrl+Shift+O नोट्स/कमेंट्स वाली सभी सेल्स को सेलेक्ट करता है (समर्थित डेस्कटॉप संस्करणों में)"},"o":[{"en":"Shift+F2 adds/edits a cell note; Ctrl+Shift+O selects all cells with notes/comments (in supported desktop versions)","hi":"Shift+F2 सेल नोट (note) जोड़ता/एडिट करता है; Ctrl+Shift+O नोट्स/कमेंट्स वाली सभी सेल्स को सेलेक्ट करता है (समर्थित डेस्कटॉप संस्करणों में)"},{"en":"Ctrl+N adds a note; Ctrl+C selects them","hi":"Ctrl+N नोट जोड़ता है; Ctrl+C उन्हें सेलेक्ट करता है"},{"en":"Alt+C adds a comment; Alt+A selects them","hi":"Alt+C कमेंट जोड़ता है; Alt+A उन्हें सेलेक्ट करता है"},{"en":"F1 adds a comment; F2 selects them","hi":"F1 कमेंट जोड़ता है; F2 उन्हें सेलेक्ट करता है"}],"exp":{"en":"Shift+F2 historically inserts a cell comment (now called a 'Note' in modern Excel). Ctrl+Shift+O highlights every cell in the active worksheet that contains a note/comment.","hi":"किसी सेल में नोट (जिसे पहले कमेंट कहा जाता था) डालने या एडिट करने के लिए Shift+F2 का उपयोग होता है। वर्कशीट में नोट्स वाली सभी सेल्स को एक साथ सेलेक्ट करने के लिए Ctrl+Shift+O का उपयोग किया जाता है।"},"num":193}]},{"title":{"en":"9. Excel Shortcuts — Navigation, Selection & Special Cells","hi":"9. एक्सेल शॉर्टकट — नेविगेशन, सिलेक्शन और स्पेशल सेल्स"},"questions":[{"id":"q194","q":{"en":"How do you move by a single cell versus moving to the edge of a data region in Excel?","hi":"Excel में एक सेल मूव करने और डेटा रीजन के किनारे (edge of a data region) तक जाने के लिए किन कुंजियों का उपयोग होता है?"},"a":{"en":"An Arrow key moves one cell; Ctrl+Arrow key jumps to the edge of the current data region or to the next data boundary","hi":"एक एरो (Arrow) कुंजी एक सेल मूव करती है; Ctrl+Arrow कुंजी वर्तमान डेटा क्षेत्र के किनारे या अगली डेटा सीमा (boundary) तक जंप करती है"},"o":[{"en":"An Arrow key moves one cell; Ctrl+Arrow key jumps to the edge of the current data region or to the next data boundary","hi":"एक एरो (Arrow) कुंजी एक सेल मूव करती है; Ctrl+Arrow कुंजी वर्तमान डेटा क्षेत्र के किनारे या अगली डेटा सीमा (boundary) तक जंप करती है"},{"en":"Tab moves one cell; Alt+Tab jumps to the edge","hi":"Tab एक सेल मूव करता है; Alt+Tab किनारे तक जंप करता है"},{"en":"Spacebar moves one cell; Enter jumps to the edge","hi":"Spacebar एक सेल मूव करता है; Enter किनारे तक जंप करता है"},{"en":"Shift moves one cell; Ctrl+Shift jumps to the edge","hi":"Shift एक सेल मूव करता है; Ctrl+Shift किनारे तक जंप करता है"}],"exp":{"en":"Standard Arrow keys navigate one cell at a time. Holding Ctrl while pressing an Arrow key rapidly jumps the cursor across empty cells to the next populated cell, or across populated cells to the end of the data block.","hi":"साधारण एरो (तीर) कुंजियाँ एक बार में एक सेल आगे बढ़ती हैं। Ctrl के साथ एरो कुंजियाँ दबाने से कर्सर सीधे डेटा ब्लॉक के अंतिम किनारे (edge) पर या खाली जगह पार करके अगले डेटा तक पहुँच जाता है।"},"num":194},{"id":"q195","q":{"en":"What do 'Ctrl+Home' and 'Ctrl+End' do in an Excel worksheet?","hi":"Excel वर्कशीट में 'Ctrl+Home' और 'Ctrl+End' क्या करते हैं?"},"a":{"en":"Ctrl+Home moves to the beginning of the worksheet (normally A1); Ctrl+End moves to the lower-right cell of the used range","hi":"Ctrl+Home वर्कशीट की शुरुआत (सामान्यतः A1) पर ले जाता है; Ctrl+End उपयोग की गई रेंज (used range) की सबसे निचली-दाहिनी (lower-right) सेल पर ले जाता है"},"o":[{"en":"Ctrl+Home moves to the beginning of the worksheet (normally A1); Ctrl+End moves to the lower-right cell of the used range","hi":"Ctrl+Home वर्कशीट की शुरुआत (सामान्यतः A1) पर ले जाता है; Ctrl+End उपयोग की गई रेंज (used range) की सबसे निचली-दाहिनी (lower-right) सेल पर ले जाता है"},{"en":"Ctrl+Home scrolls left; Ctrl+End scrolls right","hi":"Ctrl+Home बाएँ स्क्रॉल करता है; Ctrl+End दाएँ स्क्रॉल करता है"},{"en":"Ctrl+Home opens the Home tab; Ctrl+End closes Excel","hi":"Ctrl+Home होम टैब खोलता है; Ctrl+End एक्सेल बंद करता है"},{"en":"Ctrl+Home goes to the first sheet; Ctrl+End goes to the last sheet","hi":"Ctrl+Home पहली शीट पर जाता है; Ctrl+End आखिरी शीट पर जाता है"}],"exp":{"en":"Ctrl+Home always returns you to cell A1 (or the first cell below frozen panes). Ctrl+End jumps to the intersection of the lowest row and rightmost column that have ever contained data or formatting (the used range).","hi":"Ctrl+Home हमेशा वर्कशीट की पहली सेल (आमतौर पर A1) पर ले जाता है। Ctrl+End उस सबसे निचली और सबसे दायीं सेल पर ले जाता है जहाँ तक शीट में कभी डेटा या फॉर्मेटिंग का उपयोग किया गया है (used range)।"},"num":195},{"id":"q196","q":{"en":"What is the action of pressing 'End' followed by an 'Arrow key' in Excel?","hi":"Excel में 'End' दबाने के बाद 'Arrow key' (तीर कुंजी) दबाने का क्या प्रभाव होता है?"},"a":{"en":"It turns on End mode and moves to the next nonblank cell or to the edge in the same row/column, depending on the data layout (similar to Ctrl+Arrow)","hi":"यह 'एंड मोड' (End mode) चालू करता है और डेटा लेआउट के आधार पर उसी रो/कॉलम में अगली गैर-खाली (nonblank) सेल या किनारे तक जाता है (Ctrl+Arrow के समान)"},"o":[{"en":"It turns on End mode and moves to the next nonblank cell or to the edge in the same row/column, depending on the data layout (similar to Ctrl+Arrow)","hi":"यह 'एंड मोड' (End mode) चालू करता है और डेटा लेआउट के आधार पर उसी रो/कॉलम में अगली गैर-खाली (nonblank) सेल या किनारे तक जाता है (Ctrl+Arrow के समान)"},{"en":"It deletes the entire row or column","hi":"यह पूरी रो या कॉलम को डिलीट कर देता है"},{"en":"It highlights the active cell in yellow","hi":"यह सक्रिय सेल को पीले रंग में हाईलाइट करता है"},{"en":"It saves the file and closes the window","hi":"यह फाइल को सेव करता है और विंडो बंद करता है"}],"exp":{"en":"Pressing the End key toggles 'End Mode' (indicated in the status bar). Then pressing an Arrow key mimics the behavior of Ctrl+Arrow, jumping to the edge of a data block.","hi":"End कुंजी दबाने से स्टेटस बार पर 'End Mode' चालू हो जाता है। इसके बाद कोई एरो (तीर) कुंजी दबाने से कर्सर उसी दिशा में डेटा ब्लॉक के अंत तक जंप करता है (यह बिल्कुल Ctrl+Arrow जैसा ही काम करता है)।"},"num":196},{"id":"q197","q":{"en":"What do 'Page Up', 'Page Down', 'Alt+Page Up', and 'Alt+Page Down' do in an Excel worksheet?","hi":"Excel वर्कशीट में 'Page Up', 'Page Down', 'Alt+Page Up' और 'Alt+Page Down' क्या करते हैं?"},"a":{"en":"Move the screen up, down, left, and right respectively by one full screen","hi":"क्रमशः स्क्रीन को एक फुल स्क्रीन ऊपर (up), नीचे (down), बाएँ (left) और दाएँ (right) मूव करते हैं"},"o":[{"en":"Move the screen up, down, left, and right respectively by one full screen","hi":"क्रमशः स्क्रीन को एक फुल स्क्रीन ऊपर (up), नीचे (down), बाएँ (left) और दाएँ (right) मूव करते हैं"},{"en":"Change zoom level to 50%, 100%, 150%, and 200%","hi":"ज़ूम लेवल को 50%, 100%, 150% और 200% में बदलते हैं"},{"en":"Switch between sheets 1, 2, 3, and 4","hi":"शीट 1, 2, 3 और 4 के बीच स्विच करते हैं"},{"en":"Format text as bold, italic, underline, and strikethrough","hi":"टेक्स्ट को बोल्ड, इटैलिक, अंडरलाइन और स्ट्राइकथ्रू फॉर्मेट करते हैं"}],"exp":{"en":"Page Up/Page Down scroll the view vertically by one screen's worth of rows. Holding Alt while pressing Page Up/Page Down scrolls the view horizontally by one screen's worth of columns.","hi":"Page Up और Page Down स्क्रीन को लंबवत (ऊपर-नीचे) एक पूरे पेज जितना स्क्रॉल करते हैं। Alt के साथ इन्हें दबाने (Alt+Page Up / Alt+Page Down) से स्क्रीन क्षैतिज रूप से (बाएँ-दाएँ) स्क्रॉल होती है।"},"num":197},{"id":"q198","q":{"en":"Which keys switch to the next or previous worksheet, and how do you extend the sheet selection?","hi":"कौन-सी कुंजियाँ अगली (next) या पिछली (previous) वर्कशीट पर स्विच करती हैं, और आप शीट सेलेक्शन को कैसे बढ़ा (extend) सकते हैं?"},"a":{"en":"Ctrl+Page Down moves to the next sheet, Ctrl+Page Up moves to the previous sheet; adding Shift (Ctrl+Shift+Page Down/Up) extends the sheet selection","hi":"Ctrl+Page Down अगली शीट पर जाता है, Ctrl+Page Up पिछली शीट पर जाता है; Shift जोड़ने से (Ctrl+Shift+Page Down/Up) शीट सेलेक्शन बढ़ता (extend) है"},"o":[{"en":"Ctrl+Page Down moves to the next sheet, Ctrl+Page Up moves to the previous sheet; adding Shift (Ctrl+Shift+Page Down/Up) extends the sheet selection","hi":"Ctrl+Page Down अगली शीट पर जाता है, Ctrl+Page Up पिछली शीट पर जाता है; Shift जोड़ने से (Ctrl+Shift+Page Down/Up) शीट सेलेक्शन बढ़ता (extend) है"},{"en":"Alt+N moves to next sheet, Alt+P moves to previous sheet; Shift+N extends selection","hi":"Alt+N अगली शीट पर, Alt+P पिछली शीट पर; Shift+N सेलेक्शन बढ़ाता है"},{"en":"F1 moves to next sheet, F2 moves to previous sheet; F3 extends selection","hi":"F1 अगली शीट पर, F2 पिछली शीट पर; F3 सेलेक्शन बढ़ाता है"},{"en":"Tab moves to next sheet, Shift+Tab moves to previous sheet; Enter extends selection","hi":"Tab अगली शीट पर, Shift+Tab पिछली शीट पर; Enter सेलेक्शन बढ़ाता है"}],"exp":{"en":"Ctrl+Page Down cycles to the worksheet tab to the right, and Ctrl+Page Up cycles left. Adding the Shift key selects multiple adjacent worksheets for grouping operations.","hi":"एक वर्कशीट से अगली (दाहिनी) वर्कशीट पर जाने के लिए Ctrl+Page Down और पिछली (बायीं) पर जाने के लिए Ctrl+Page Up का उपयोग होता है। इनके साथ Shift दबाने से कई शीट्स एक साथ सेलेक्ट हो जाती हैं।"},"num":198},{"id":"q199","q":{"en":"How do you switch between open Excel workbooks/windows versus switching between OS apps?","hi":"खुले हुए Excel वर्कबुक्स/विंडोज़ के बीच स्विच करने और OS ऐप्स के बीच स्विच करने के शॉर्टकट्स में क्या अंतर है?"},"a":{"en":"Ctrl+Tab switches to the next workbook/window (Ctrl+Shift+Tab reverses) in supported Excel desktop contexts; Alt+Tab switches between Windows OS apps/windows","hi":"समर्थित Excel डेस्कटॉप संदर्भों में Ctrl+Tab अगले वर्कबुक/विंडो पर स्विच करता है (Ctrl+Shift+Tab रिवर्स करता है); Alt+Tab Windows OS ऐप्स/विंडोज़ के बीच स्विच करता है"},"o":[{"en":"Ctrl+Tab switches to the next workbook/window (Ctrl+Shift+Tab reverses) in supported Excel desktop contexts; Alt+Tab switches between Windows OS apps/windows","hi":"समर्थित Excel डेस्कटॉप संदर्भों में Ctrl+Tab अगले वर्कबुक/विंडो पर स्विच करता है (Ctrl+Shift+Tab रिवर्स करता है); Alt+Tab Windows OS ऐप्स/विंडोज़ के बीच स्विच करता है"},{"en":"Alt+Tab switches workbooks; Ctrl+Tab switches OS apps","hi":"Alt+Tab वर्कबुक स्विच करता है; Ctrl+Tab OS ऐप्स स्विच करता है"},{"en":"F6 switches workbooks; F7 switches OS apps","hi":"F6 वर्कबुक स्विच करता है; F7 OS ऐप्स स्विच करता है"},{"en":"Shift+Tab switches workbooks; Esc switches OS apps","hi":"Shift+Tab वर्कबुक स्विच करता है; Esc OS ऐप्स स्विच करता है"}],"exp":{"en":"In older Multi-Document Interface (MDI) Excel or modern unified windows, Ctrl+Tab cycles through open Excel workbook windows. Alt+Tab is the Windows system shortcut to cycle through all open applications.","hi":"खुली हुई विभिन्न Excel फाइलों (वर्कबुक्स) के बीच जाने के लिए Ctrl+Tab का उपयोग होता है (Ctrl+Shift+Tab से उलटी दिशा में)। कंप्यूटर में खुले सभी अलग-अलग ऐप्स के बीच स्विच करने के लिए Alt+Tab (विंडोज़ शॉर्टकट) का उपयोग होता है।"},"num":199},{"id":"q200","q":{"en":"What do the Excel arrow keys do if 'Scroll Lock' is turned on?","hi":"यदि 'Scroll Lock' चालू (on) हो, तो Excel की एरो कुंजियाँ (arrow keys) क्या करती हैं?"},"a":{"en":"They scroll the worksheet view without changing the active cell selection (and Home/End scroll to the first/last cell of the visible area)","hi":"वे सक्रिय सेल सेलेक्शन को बदले बिना वर्कशीट व्यू को स्क्रॉल करती हैं (और Home/End दृश्य क्षेत्र/visible area की पहली/आखिरी सेल तक स्क्रॉल करते हैं)"},"o":[{"en":"They scroll the worksheet view without changing the active cell selection (and Home/End scroll to the first/last cell of the visible area)","hi":"वे सक्रिय सेल सेलेक्शन को बदले बिना वर्कशीट व्यू को स्क्रॉल करती हैं (और Home/End दृश्य क्षेत्र/visible area की पहली/आखिरी सेल तक स्क्रॉल करते हैं)"},{"en":"They delete the current cell and move to the next","hi":"वे वर्तमान सेल को डिलीट कर देती हैं और अगली पर चली जाती हैं"},{"en":"They highlight all cells in red","hi":"वे सभी सेल्स को लाल रंग में हाईलाइट कर देती हैं"},{"en":"They insert new rows and columns","hi":"वे नई पंक्तियाँ और कॉलम डालती हैं"}],"exp":{"en":"Normally, arrow keys move the active cell cursor. If the Scroll Lock key on your keyboard is toggled on, the arrow keys scroll the entire spreadsheet canvas up/down/left/right while leaving the active cell locked in its original position.","hi":"सामान्यतः एरो कीज़ सेल-दर-सेल कर्सर ले जाती हैं, लेकिन यदि कीबोर्ड पर 'Scroll Lock' चालू हो, तो कर्सर (एक्टिव सेल) अपनी जगह पर टिका रहता है और पूरी वर्कशीट स्क्रीन खिसकने (स्क्रॉल होने) लगती है।"},"num":200},{"id":"q201","q":{"en":"How do you select the entire current row or column of the active cell in Excel?","hi":"Excel में सक्रिय सेल (active cell) की पूरी पंक्ति (row) या कॉलम को कैसे सेलेक्ट करते हैं?"},"a":{"en":"Shift+Spacebar selects the row, and Ctrl+Spacebar selects the column","hi":"Shift+Spacebar पंक्ति (row) सेलेक्ट करता है, और Ctrl+Spacebar कॉलम सेलेक्ट करता है"},"o":[{"en":"Shift+Spacebar selects the row, and Ctrl+Spacebar selects the column","hi":"Shift+Spacebar पंक्ति (row) सेलेक्ट करता है, और Ctrl+Spacebar कॉलम सेलेक्ट करता है"},{"en":"Ctrl+R selects the row, and Ctrl+C selects the column","hi":"Ctrl+R पंक्ति सेलेक्ट करता है, और Ctrl+C कॉलम सेलेक्ट करता है"},{"en":"Alt+Spacebar selects the row, and Tab selects the column","hi":"Alt+Spacebar पंक्ति सेलेक्ट करता है, और Tab कॉलम सेलेक्ट करता है"},{"en":"Shift+R selects the row, and Shift+C selects the column","hi":"Shift+R पंक्ति सेलेक्ट करता है, और Shift+C कॉलम सेलेक्ट करता है"}],"exp":{"en":"In MS Excel, pressing Shift+Spacebar highlights the entire row of the active cell. Pressing Ctrl+Spacebar highlights the entire column.","hi":"एक्सेल में पूरी रो (Row) को सेलेक्ट करने के लिए Shift+Spacebar और पूरे कॉलम (Column) को सेलेक्ट करने के लिए Ctrl+Spacebar का उपयोग किया जाता है।"},"num":201},{"id":"q202","q":{"en":"How do you select the current data region or the entire worksheet in Excel?","hi":"Excel में वर्तमान डेटा रीजन (current data region) या पूरी वर्कशीट को कैसे सेलेक्ट करते हैं?"},"a":{"en":"Ctrl+A (first selects the current data region, and pressing it again selects the whole sheet); Ctrl+Shift+* also selects the current region","hi":"Ctrl+A (संदर्भ में पहले वर्तमान डेटा क्षेत्र को सेलेक्ट करता है, और फिर से दबाने पर पूरी शीट सेलेक्ट करता है); Ctrl+Shift+* भी वर्तमान क्षेत्र को सेलेक्ट करता है"},"o":[{"en":"Ctrl+A (first selects the current data region, and pressing it again selects the whole sheet); Ctrl+Shift+* also selects the current region","hi":"Ctrl+A (संदर्भ में पहले वर्तमान डेटा क्षेत्र को सेलेक्ट करता है, और फिर से दबाने पर पूरी शीट सेलेक्ट करता है); Ctrl+Shift+* भी वर्तमान क्षेत्र को सेलेक्ट करता है"},{"en":"Ctrl+S selects the region; Ctrl+P selects the sheet","hi":"Ctrl+S रीजन सेलेक्ट करता है; Ctrl+P शीट सेलेक्ट करता है"},{"en":"Alt+A selects the region; Shift+A selects the sheet","hi":"Alt+A रीजन सेलेक्ट करता है; Shift+A शीट सेलेक्ट करता है"},{"en":"F5 selects the region; F6 selects the sheet","hi":"F5 रीजन सेलेक्ट करता है; F6 शीट सेलेक्ट करता है"}],"exp":{"en":"If the active cell is in a block of data, Ctrl+A selects that block (current region); pressing it again selects the whole worksheet. Alternatively, Ctrl+Shift+* explicitly selects the current data region.","hi":"डेटा के अंदर Ctrl+A दबाने पर पहले वह डेटा ब्लॉक (current region) सेलेक्ट होता है, और दोबारा दबाने पर पूरी शीट सेलेक्ट हो जाती है। Ctrl+Shift+* भी सीधे current region को सेलेक्ट करता है।"},"num":202},{"id":"q203","q":{"en":"How do you extend a selection by a single cell or to the data boundary in Excel?","hi":"Excel में सेलेक्शन को एक सेल से या डेटा बाउंड्री (data boundary) तक कैसे बढ़ाते (extend करते) हैं?"},"a":{"en":"Shift+Arrow extends by one cell; Ctrl+Shift+Arrow extends to the data boundary or next nonblank cell","hi":"Shift+Arrow एक सेल से सेलेक्शन बढ़ाता है; Ctrl+Shift+Arrow डेटा बाउंड्री या अगली गैर-खाली (nonblank) सेल तक बढ़ाता है"},"o":[{"en":"Shift+Arrow extends by one cell; Ctrl+Shift+Arrow extends to the data boundary or next nonblank cell","hi":"Shift+Arrow एक सेल से सेलेक्शन बढ़ाता है; Ctrl+Shift+Arrow डेटा बाउंड्री या अगली गैर-खाली (nonblank) सेल तक बढ़ाता है"},{"en":"Ctrl+Arrow extends by one cell; Alt+Arrow extends to the boundary","hi":"Ctrl+Arrow एक सेल बढ़ाता है; Alt+Arrow बाउंड्री तक बढ़ाता है"},{"en":"Space extends by one cell; Enter extends to the boundary","hi":"Space एक सेल बढ़ाता है; Enter बाउंड्री तक बढ़ाता है"},{"en":"Tab extends by one cell; Esc extends to the boundary","hi":"Tab एक सेल बढ़ाता है; Esc बाउंड्री तक बढ़ाता है"}],"exp":{"en":"Holding Shift and using the Arrow keys extends the highlight one cell at a time. Holding Ctrl+Shift and pressing an Arrow key extends the selection all the way to the edge of the current data block.","hi":"Shift के साथ एरो (Arrow) कुंजी दबाने से सेलेक्शन एक सेल आगे बढ़ता है। Ctrl+Shift के साथ एरो कुंजी दबाने से सेलेक्शन सीधे उस दिशा के आखिरी डेटा सेल (बाउंड्री) तक पहुँच जाता है।"},"num":203},{"id":"q204","q":{"en":"What do 'Ctrl+Shift+Home' and 'Ctrl+Shift+End' select in an Excel worksheet?","hi":"Excel वर्कशीट में 'Ctrl+Shift+Home' और 'Ctrl+Shift+End' क्या सेलेक्ट करते हैं?"},"a":{"en":"They extend the selection from the active cell to the beginning (normally A1) or to the last used cell of the worksheet respectively","hi":"वे सेलेक्शन को सक्रिय सेल से वर्कशीट की शुरुआत (सामान्यतः A1) या उपयोग की गई अंतिम सेल (last used cell) तक बढ़ाते (extend करते) हैं"},"o":[{"en":"They extend the selection from the active cell to the beginning (normally A1) or to the last used cell of the worksheet respectively","hi":"वे सेलेक्शन को सक्रिय सेल से वर्कशीट की शुरुआत (सामान्यतः A1) या उपयोग की गई अंतिम सेल (last used cell) तक बढ़ाते (extend करते) हैं"},{"en":"They select the first and last columns only","hi":"वे केवल पहले और अंतिम कॉलम को सेलेक्ट करते हैं"},{"en":"They select the first and last rows only","hi":"वे केवल पहली और अंतिम पंक्तियों को सेलेक्ट करते हैं"},{"en":"They select the active cell and delete all other cells","hi":"वे सक्रिय सेल को सेलेक्ट करते हैं और अन्य सभी सेल्स को हटा देते हैं"}],"exp":{"en":"Ctrl+Shift+Home highlights everything from your current cell back up to A1. Ctrl+Shift+End highlights everything from your current cell down to the bottom-right corner of the used range.","hi":"Ctrl+Shift+Home आपके वर्तमान सेल से लेकर A1 तक का हिस्सा सेलेक्ट कर लेता है, जबकि Ctrl+Shift+End वर्तमान सेल से लेकर उपयोग किए गए एरिया (used range) की अंतिम सेल तक सब सेलेक्ट कर लेता है।"},"num":204},{"id":"q205","q":{"en":"What do 'Shift+Home' and 'Shift+Page Up/Down' do in Excel?","hi":"Excel में 'Shift+Home' और 'Shift+Page Up/Down' क्या करते हैं?"},"a":{"en":"Shift+Home extends the selection to the beginning of the row; Shift+Page Up/Down extends the selection by one screen up or down","hi":"Shift+Home सेलेक्शन को पंक्ति की शुरुआत तक बढ़ाता है; Shift+Page Up/Down सेलेक्शन को एक स्क्रीन ऊपर या नीचे बढ़ाता है"},"o":[{"en":"Shift+Home extends the selection to the beginning of the row; Shift+Page Up/Down extends the selection by one screen up or down","hi":"Shift+Home सेलेक्शन को पंक्ति की शुरुआत तक बढ़ाता है; Shift+Page Up/Down सेलेक्शन को एक स्क्रीन ऊपर या नीचे बढ़ाता है"},{"en":"Shift+Home selects the first column; Shift+Page Up/Down changes sheet views","hi":"Shift+Home पहला कॉलम सेलेक्ट करता है; Shift+Page Up/Down शीट व्यू बदलते हैं"},{"en":"Shift+Home deletes the row; Shift+Page Up/Down deletes pages","hi":"Shift+Home पंक्ति हटाता है; Shift+Page Up/Down पेज हटाते हैं"},{"en":"Shift+Home aligns text to the left; Shift+Page Up/Down aligns text up or down","hi":"Shift+Home टेक्स्ट को बाएँ एलाइन करता है; Shift+Page Up/Down टेक्स्ट को ऊपर या नीचे एलाइन करते हैं"}],"exp":{"en":"Shift+Home highlights cells from the current column back to column A in the same row. Shift+Page Up or Down extends the selection vertically by an entire screen view.","hi":"Shift+Home आपकी वर्तमान सेल से लेकर उसी रो (Row) के पहले सेल (कॉलम A) तक सब सेलेक्ट कर लेता है। Shift+Page Up/Down से सेलेक्शन एक बार में एक पूरे स्क्रीन जितना ऊपर या नीचे बढ़ जाता है।"},"num":205},{"id":"q206","q":{"en":"How do you extend a selection using 'End mode' in Excel?","hi":"Excel में 'एंड मोड' (End mode) का उपयोग करके सेलेक्शन को कैसे बढ़ाते (extend करते) हैं?"},"a":{"en":"Press End, then Shift+Arrow to select to the next data boundary; (Legacy: End, then Shift+End selects to the last applicable cell in the row)","hi":"End दबाएँ, फिर Shift+Arrow से अगली डेटा बाउंड्री की तरफ सेलेक्ट करें; (लीगेसी: End, फिर Shift+End दबाने से रो में लागू अंतिम सेल तक सेलेक्ट होता है)"},"o":[{"en":"Press End, then Shift+Arrow to select to the next data boundary; (Legacy: End, then Shift+End selects to the last applicable cell in the row)","hi":"End दबाएँ, फिर Shift+Arrow से अगली डेटा बाउंड्री की तरफ सेलेक्ट करें; (लीगेसी: End, फिर Shift+End दबाने से रो में लागू अंतिम सेल तक सेलेक्ट होता है)"},{"en":"Press End, then Delete to select the whole row","hi":"End दबाएँ, फिर Delete दबाने से पूरी रो सेलेक्ट होती है"},{"en":"Press End, then Tab to select the next cell","hi":"End दबाएँ, फिर Tab दबाने से अगली सेल सेलेक्ट होती है"},{"en":"Press End, then Esc to select the document","hi":"End दबाएँ, फिर Esc दबाने से डॉक्यूमेंट सेलेक्ट होता है"}],"exp":{"en":"Activating End mode and then pressing Shift+Arrow mimics Ctrl+Shift+Arrow, selecting blocks of data. End followed by Shift+Home or Shift+End are classic shortcuts for expanding selection to the edges of rows.","hi":"End मोड चालू करके Shift+Arrow दबाने से सेलेक्शन उसी दिशा में डेटा ब्लॉक के अंत तक बढ़ जाता है (Ctrl+Shift+Arrow की तरह)। पुराने वर्ज़न में End के बाद Shift+End दबाने से रो के अंत तक सेलेक्शन हो जाता था।"},"num":206},{"id":"q207","q":{"en":"What are the selection functions of 'F8' and 'Shift+F8' in Excel?","hi":"Excel में 'F8' और 'Shift+F8' का सेलेक्शन उपयोग क्या है?"},"a":{"en":"F8 turns on Extend Selection mode (use arrows to expand selection); Shift+F8 allows adding a non-adjacent cell/range to the current selection","hi":"F8 'एक्सटेंड सेलेक्शन' (Extend Selection) मोड चालू करता है (तीर कुंजियों से सेलेक्शन बढ़ाएँ); Shift+F8 वर्तमान सेलेक्शन में एक गैर-आसन्न (non-adjacent) सेल/रेंज जोड़ने की अनुमति देता है"},"o":[{"en":"F8 turns on Extend Selection mode (use arrows to expand selection); Shift+F8 allows adding a non-adjacent cell/range to the current selection","hi":"F8 'एक्सटेंड सेलेक्शन' (Extend Selection) मोड चालू करता है (तीर कुंजियों से सेलेक्शन बढ़ाएँ); Shift+F8 वर्तमान सेलेक्शन में एक गैर-आसन्न (non-adjacent) सेल/रेंज जोड़ने की अनुमति देता है"},{"en":"F8 selects the whole row; Shift+F8 selects the whole column","hi":"F8 पूरी रो सेलेक्ट करता है; Shift+F8 पूरा कॉलम सेलेक्ट करता है"},{"en":"F8 selects the first sheet; Shift+F8 selects the last sheet","hi":"F8 पहली शीट सेलेक्ट करता है; Shift+F8 आखिरी शीट सेलेक्ट करता है"},{"en":"F8 saves the file; Shift+F8 prints the file","hi":"F8 फाइल सेव करता है; Shift+F8 फाइल प्रिंट करता है"}],"exp":{"en":"F8 toggles 'Extend Selection' so arrow keys highlight cells without holding Shift. Shift+F8 toggles 'Add to Selection' so you can use arrow keys to pick another cell/range to add to the existing highlight (acting like holding Ctrl).","hi":"F8 'Extend Selection' मोड चालू करता है जिससे आप केवल एरो कीज़ से सेलेक्शन बढ़ा सकते हैं। Shift+F8 से आप अलग-अलग (non-adjacent) सेल्स को एक साथ सेलेक्ट कर सकते हैं (जैसे माउस के साथ Ctrl दबाकर करते हैं)।"},"num":207},{"id":"q208","q":{"en":"What do 'Ctrl+Shift+Spacebar' and 'Shift+Backspace' do in the context of Excel selections?","hi":"Excel सेलेक्शन के संदर्भ में 'Ctrl+Shift+Spacebar' और 'Shift+Backspace' क्या करते हैं?"},"a":{"en":"In a sheet, Ctrl+Shift+Spacebar selects the current region (or whole sheet); if an object is selected, it selects all objects. Shift+Backspace reduces a multi-cell selection to just the active cell","hi":"शीट में, Ctrl+Shift+Spacebar वर्तमान क्षेत्र (या पूरी शीट) सेलेक्ट करता है; यदि कोई ऑब्जेक्ट सेलेक्टेड है, तो यह सभी ऑब्जेक्ट्स सेलेक्ट करता है। Shift+Backspace एक मल्टी-सेल सेलेक्शन को कम करके केवल सक्रिय सेल (active cell) तक सीमित कर सकता है"},"o":[{"en":"In a sheet, Ctrl+Shift+Spacebar selects the current region (or whole sheet); if an object is selected, it selects all objects. Shift+Backspace reduces a multi-cell selection to just the active cell","hi":"शीट में, Ctrl+Shift+Spacebar वर्तमान क्षेत्र (या पूरी शीट) सेलेक्ट करता है; यदि कोई ऑब्जेक्ट सेलेक्टेड है, तो यह सभी ऑब्जेक्ट्स सेलेक्ट करता है। Shift+Backspace एक मल्टी-सेल सेलेक्शन को कम करके केवल सक्रिय सेल (active cell) तक सीमित कर सकता है"},{"en":"Ctrl+Shift+Spacebar deletes spaces; Shift+Backspace undoes the last action","hi":"Ctrl+Shift+Spacebar स्पेस हटाता है; Shift+Backspace अंतिम क्रिया को अनडू करता है"},{"en":"Ctrl+Shift+Spacebar inserts a blank row; Shift+Backspace inserts a column","hi":"Ctrl+Shift+Spacebar एक खाली रो डालता है; Shift+Backspace एक कॉलम डालता है"},{"en":"Ctrl+Shift+Spacebar opens the Font dialog; Shift+Backspace opens Print Preview","hi":"Ctrl+Shift+Spacebar फ़ॉन्ट डायलॉग खोलता है; Shift+Backspace प्रिंट प्रीव्यू खोलता है"}],"exp":{"en":"Ctrl+Shift+Spacebar functions like Ctrl+A (selecting the data block, then the sheet, or all graphical objects if one is selected). Shift+Backspace collapses an extended highlight so only the active cell remains selected.","hi":"Ctrl+Shift+Spacebar (Ctrl+A की तरह) वर्तमान डेटा ब्लॉक या पूरी शीट को सेलेक्ट करता है, और ऑब्जेक्ट सेलेक्ट होने पर सभी ऑब्जेक्ट्स को सेलेक्ट करता है। यदि आपने बहुत सी सेल्स सेलेक्ट की हैं, तो Shift+Backspace सेलेक्शन को हटाकर केवल एक्टिव सेल पर ले आता है।"},"num":208},{"id":"q209","q":{"en":"How do you move between the corners of a selected range, and how do you move between non-adjacent selected areas in Excel?","hi":"Excel में किसी चयनित रेंज के कोनों (corners) के बीच, और गैर-आसन्न (non-adjacent) चयनित क्षेत्रों के बीच कैसे मूव करते हैं?"},"a":{"en":"Ctrl+. (period) moves clockwise to the next corner of the selection; Ctrl+Alt+Left/Right Arrow moves to the previous/next non-adjacent selected area (in supported desktop contexts)","hi":"Ctrl+. (period) सेलेक्शन के अगले कोने पर दक्षिणावर्त (clockwise) ले जाता है; Ctrl+Alt+Left/Right Arrow पिछले/अगले गैर-आसन्न (non-adjacent) चयनित क्षेत्र पर ले जाता है (समर्थित डेस्कटॉप संदर्भों में)"},"o":[{"en":"Ctrl+. (period) moves clockwise to the next corner of the selection; Ctrl+Alt+Left/Right Arrow moves to the previous/next non-adjacent selected area (in supported desktop contexts)","hi":"Ctrl+. (period) सेलेक्शन के अगले कोने पर दक्षिणावर्त (clockwise) ले जाता है; Ctrl+Alt+Left/Right Arrow पिछले/अगले गैर-आसन्न (non-adjacent) चयनित क्षेत्र पर ले जाता है (समर्थित डेस्कटॉप संदर्भों में)"},{"en":"Ctrl+C moves to corners; Ctrl+V moves to areas","hi":"Ctrl+C कोनों पर ले जाता है; Ctrl+V क्षेत्रों पर ले जाता है"},{"en":"Alt+Home moves to corners; Alt+End moves to areas","hi":"Alt+Home कोनों पर ले जाता है; Alt+End क्षेत्रों पर ले जाता है"},{"en":"Shift+Arrow moves to corners; Ctrl+Arrow moves to areas","hi":"Shift+Arrow कोनों पर ले जाता है; Ctrl+Arrow क्षेत्रों पर ले जाता है"}],"exp":{"en":"Within a highlighted range, pressing Ctrl+. moves the active cell to the next corner (clockwise). If you have multiple separate ranges selected (e.g., via Ctrl+Click), Ctrl+Alt+Right/Left Arrow switches the active cell between those separate areas.","hi":"सेलेक्ट की गई रेंज में Ctrl+. (डॉट) कर्सर (एक्टिव सेल) को रेंज के चारों कोनों (corners) पर घुमाता है। यदि कई अलग-अलग रेंज सेलेक्टेड हैं, तो Ctrl+Alt+Left/Right से कर्सर उन अलग-अलग क्षेत्रों के बीच जंप करता है।"},"num":209},{"id":"q210","q":{"en":"What is the Excel shortcut to open a data validation dropdown list or the 'Pick From Drop-down List' menu?","hi":"Excel में डेटा वैलिडेशन ड्रॉपडाउन (data validation dropdown) या 'Pick From Drop-down List' मेनू खोलने का शॉर्टकट क्या है?"},"a":{"en":"Alt+Down Arrow (opens the dropdown based on the context of the active cell)","hi":"Alt+Down Arrow (एक्टिव सेल के संदर्भ के अनुसार ड्रॉपडाउन खोलता है)"},"o":[{"en":"Alt+Down Arrow (opens the dropdown based on the context of the active cell)","hi":"Alt+Down Arrow (एक्टिव सेल के संदर्भ के अनुसार ड्रॉपडाउन खोलता है)"},{"en":"Ctrl+Down Arrow","hi":"Ctrl+Down Arrow"},{"en":"Shift+Down Arrow","hi":"Shift+Down Arrow"},{"en":"F5","hi":"F5"}],"exp":{"en":"Pressing Alt+Down Arrow in a cell that has an AutoFilter, a Data Validation list, or just typed text above it, opens the corresponding dropdown menu.","hi":"यदि किसी सेल में डेटा वैलिडेशन लिस्ट (dropdown) लगी है या आप ऊपर टाइप किए गए शब्दों की लिस्ट (Pick From Drop-down List) देखना चाहते हैं, तो Alt+Down Arrow दबाएँ।"},"num":210},{"id":"q211","q":{"en":"How do you cycle through floating objects (like charts or shapes) using the keyboard in Excel?","hi":"Excel में कीबोर्ड का उपयोग करके फ्लोटिंग ऑब्जेक्ट्स (जैसे चार्ट या शेप्स) के बीच कैसे साइकिल (साइकिल/घूमना) करते हैं?"},"a":{"en":"Press Ctrl+Alt+5, then press Tab repeatedly to cycle through objects (press Esc to return to normal navigation)","hi":"Ctrl+Alt+5 दबाएँ, फिर ऑब्जेक्ट्स के बीच साइकिल करने के लिए Tab बार-बार दबाएँ (सामान्य नेविगेशन पर लौटने के लिए Esc दबाएँ)"},"o":[{"en":"Press Ctrl+Alt+5, then press Tab repeatedly to cycle through objects (press Esc to return to normal navigation)","hi":"Ctrl+Alt+5 दबाएँ, फिर ऑब्जेक्ट्स के बीच साइकिल करने के लिए Tab बार-बार दबाएँ (सामान्य नेविगेशन पर लौटने के लिए Esc दबाएँ)"},{"en":"Press Ctrl+O, then press Spacebar","hi":"Ctrl+O दबाएँ, फिर Spacebar दबाएँ"},{"en":"Press Shift+F5, then press Enter","hi":"Shift+F5 दबाएँ, फिर Enter दबाएँ"},{"en":"Press Alt+O, then press Arrow keys","hi":"Alt+O दबाएँ, फिर एरो कुंजियाँ दबाएँ"}],"exp":{"en":"Ctrl+Alt+5 shifts focus to floating objects on the sheet. You can then use Tab (or Shift+Tab) to select different objects, and press Esc to return focus to the spreadsheet cells.","hi":"वर्कशीट में मौजूद ऑब्जेक्ट्स (चार्ट, शेप्स) को कीबोर्ड से सेलेक्ट करने के लिए Ctrl+Alt+5 दबाएँ। फिर अलग-अलग ऑब्जेक्ट्स पर जाने के लिए Tab दबाएँ, और वापस सेल्स पर आने के लिए Esc दबाएँ।"},"num":211},{"id":"q212","q":{"en":"How do you horizontally scroll and zoom in/out in an Excel worksheet using shortcuts?","hi":"Excel वर्कशीट में शॉर्टकट्स का उपयोग करके क्षैतिज स्क्रॉल (horizontal scroll) और ज़ूम इन/आउट कैसे करते हैं?"},"a":{"en":"Ctrl+Shift with the mouse wheel scrolls horizontally; Ctrl+Alt+= zooms in and Ctrl+Alt+− zooms out (in supported Windows desktop versions)","hi":"माउस व्हील के साथ Ctrl+Shift क्षैतिज रूप से स्क्रॉल करता है; समर्थित विंडोज़ डेस्कटॉप वर्ज़न में Ctrl+Alt+= ज़ूम इन करता है और Ctrl+Alt+− ज़ूम आउट करता है"},"o":[{"en":"Ctrl+Shift with the mouse wheel scrolls horizontally; Ctrl+Alt+= zooms in and Ctrl+Alt+− zooms out (in supported Windows desktop versions)","hi":"माउस व्हील के साथ Ctrl+Shift क्षैतिज रूप से स्क्रॉल करता है; समर्थित विंडोज़ डेस्कटॉप वर्ज़न में Ctrl+Alt+= ज़ूम इन करता है और Ctrl+Alt+− ज़ूम आउट करता है"},{"en":"Alt+Shift scrolls horizontally; Ctrl+Z zooms in","hi":"Alt+Shift क्षैतिज रूप से स्क्रॉल करता है; Ctrl+Z ज़ूम इन करता है"},{"en":"Shift+Spacebar scrolls horizontally; Ctrl+Plus zooms out","hi":"Shift+Spacebar क्षैतिज रूप से स्क्रॉल करता है; Ctrl+Plus ज़ूम आउट करता है"},{"en":"Ctrl+Tab scrolls horizontally; Alt+Plus zooms in","hi":"Ctrl+Tab क्षैतिज रूप से स्क्रॉल करता है; Alt+Plus ज़ूम इन करता है"}],"exp":{"en":"Holding Ctrl+Shift while scrolling the mouse wheel pans the sheet left/right. The keyboard shortcuts Ctrl+Alt+Plus and Ctrl+Alt+Minus zoom the worksheet in and out.","hi":"माउस व्हील के साथ Ctrl+Shift दबाने से शीट बाएँ-दाएँ (क्षैतिज) स्क्रॉल होती है। कीबोर्ड से ज़ूम इन करने के लिए Ctrl+Alt+= और ज़ूम आउट करने के लिए Ctrl+Alt+− (माइनस) का उपयोग होता है।"},"num":212},{"id":"q213","q":{"en":"Which shortcuts select 'Visible cells only' and the 'Current array' in Excel?","hi":"Excel में 'Visible cells only' (केवल दृश्य सेल्स) और 'Current array' को सेलेक्ट करने की कुंजियाँ क्या हैं?"},"a":{"en":"Alt+; selects visible cells only; Ctrl+/ selects the current array","hi":"Alt+; केवल दृश्य सेल्स (visible cells) को सेलेक्ट करता है; Ctrl+/ वर्तमान एरे (current array) को सेलेक्ट करता है"},"o":[{"en":"Alt+; selects visible cells only; Ctrl+/ selects the current array","hi":"Alt+; केवल दृश्य सेल्स (visible cells) को सेलेक्ट करता है; Ctrl+/ वर्तमान एरे (current array) को सेलेक्ट करता है"},{"en":"Ctrl+; selects visible cells only; Alt+/ selects the current array","hi":"Ctrl+; केवल दृश्य सेल्स को सेलेक्ट करता है; Alt+/ वर्तमान एरे को सेलेक्ट करता है"},{"en":"Shift+; selects visible cells only; Shift+/ selects the current array","hi":"Shift+; केवल दृश्य सेल्स को सेलेक्ट करता है; Shift+/ वर्तमान एरे को सेलेक्ट करता है"},{"en":"Alt+V selects visible cells only; Alt+A selects the current array","hi":"Alt+V केवल दृश्य सेल्स को सेलेक्ट करता है; Alt+A वर्तमान एरे को सेलेक्ट करता है"}],"exp":{"en":"If rows/columns are hidden within a selection, pressing Alt+; highlights only the visible cells (useful for copying without hidden data). If you click an array formula, Ctrl+/ highlights the entire block belonging to that array.","hi":"यदि आपने कुछ रो या कॉलम छिपा (hide) रखे हैं, तो Alt+; (सेमीकोलन) दबाने से केवल वही सेल्स सेलेक्ट होती हैं जो दिखाई दे रही हैं। Ctrl+/ दबाने से वह पूरा एरे सेलेक्ट हो जाता है जिसका एक्टिव सेल एक हिस्सा है।"},"num":213},{"id":"q214","q":{"en":"What are the Excel keyboard shortcuts for selecting direct/all precedents and dependents of a formula?","hi":"Excel में किसी फॉर्मूले के 'डायरेक्ट/सभी प्रिसिडेंट्स' (precedents) और 'डिपेंडेंट्स' (dependents) सेलेक्ट करने के कीबोर्ड शॉर्टकट क्या हैं?"},"a":{"en":"Ctrl+[ (direct precedents), Ctrl+Shift+[ (all precedents); Ctrl+] (direct dependents), Ctrl+Shift+] (all dependents)","hi":"Ctrl+[ डायरेक्ट प्रिसिडेंट्स, Ctrl+Shift+[ सभी प्रिसिडेंट्स; Ctrl+] डायरेक्ट डिपेंडेंट्स, Ctrl+Shift+] सभी डिपेंडेंट्स"},"o":[{"en":"Ctrl+[ (direct precedents), Ctrl+Shift+[ (all precedents); Ctrl+] (direct dependents), Ctrl+Shift+] (all dependents)","hi":"Ctrl+[ डायरेक्ट प्रिसिडेंट्स, Ctrl+Shift+[ सभी प्रिसिडेंट्स; Ctrl+] डायरेक्ट डिपेंडेंट्स, Ctrl+Shift+] सभी डिपेंडेंट्स"},{"en":"Alt+[ (precedents); Alt+] (dependents)","hi":"Alt+[ (प्रिसिडेंट्स); Alt+] (डिपेंडेंट्स)"},{"en":"Shift+[ (precedents); Shift+] (dependents)","hi":"Shift+[ (प्रिसिडेंट्स); Shift+] (डिपेंडेंट्स)"},{"en":"F1 (precedents); F2 (dependents)","hi":"F1 (प्रिसिडेंट्स); F2 (डिपेंडेंट्स)"}],"exp":{"en":"Precedents are cells that feed into a formula (Ctrl+[ for direct, add Shift for all). Dependents are formulas that rely on the active cell (Ctrl+] for direct, add Shift for all).","hi":"Ctrl+[ उन सेल्स को सेलेक्ट करता है जो एक्टिव सेल के फॉर्मूले में इस्तेमाल हुई हैं (Precedents)। Ctrl+] उन सेल्स को सेलेक्ट करता है जिनके फॉर्मूले एक्टिव सेल पर निर्भर हैं (Dependents)। Shift जोड़ने से सभी स्तरों (all levels) के सेल सेलेक्ट हो जाते हैं।"},"num":214},{"id":"q215","q":{"en":"How do you find row differences and column differences in a selected range in Excel?","hi":"Excel में चयनित रेंज में रो डिफरेंसेस (row differences) और कॉलम डिफरेंसेस (column differences) कैसे ज्ञात करते हैं?"},"a":{"en":"Ctrl+\\ finds row differences; Ctrl+Shift+\\ finds column differences (based on comparison with the active cell)","hi":"Ctrl+\\ रो डिफरेंसेस ज्ञात करता है; Ctrl+Shift+\\ कॉलम डिफरेंसेस ज्ञात करता है (एक्टिव सेल के साथ तुलना के आधार पर)"},"o":[{"en":"Ctrl+\\ finds row differences; Ctrl+Shift+\\ finds column differences (based on comparison with the active cell)","hi":"Ctrl+\\ रो डिफरेंसेस ज्ञात करता है; Ctrl+Shift+\\ कॉलम डिफरेंसेस ज्ञात करता है (एक्टिव सेल के साथ तुलना के आधार पर)"},{"en":"Alt+\\ finds row differences; Alt+Shift+\\ finds column differences","hi":"Alt+\\ रो डिफरेंसेस ज्ञात करता है; Alt+Shift+\\ कॉलम डिफरेंसेस ज्ञात करता है"},{"en":"Ctrl+D finds row differences; Ctrl+R finds column differences","hi":"Ctrl+D रो डिफरेंसेस ज्ञात करता है; Ctrl+R कॉलम डिफरेंसेस ज्ञात करता है"},{"en":"Shift+R finds row differences; Shift+C finds column differences","hi":"Shift+R रो डिफरेंसेस ज्ञात करता है; Shift+C कॉलम डिफरेंसेस ज्ञात करता है"}],"exp":{"en":"Ctrl+\\ highlights cells in a selected row that do not match the value of the active cell in that row. Ctrl+Shift+\\| (pipe/backslash key) does the same for column differences.","hi":"सेलेक्ट की गई रेंज में, Ctrl+\\ उन सेल्स को हाईलाइट करता है जिनका मान उसी रो की एक्टिव सेल से अलग है (Row differences)। Ctrl+Shift+\\ यही काम कॉलम के लिए करता है (Column differences)।"},"num":215},{"id":"q216","q":{"en":"What does the 'Home' key do when an Excel menu or submenu is open?","hi":"जब Excel मेनू या सबमेनू खुला हो, तो 'Home' कुंजी क्या करती है?"},"a":{"en":"It selects the first command in the menu","hi":"यह मेनू में पहला कमांड (first command) सेलेक्ट करती है"},"o":[{"en":"It selects the first command in the menu","hi":"यह मेनू में पहला कमांड (first command) सेलेक्ट करती है"},{"en":"It closes the menu and returns to cell A1","hi":"यह मेनू को बंद कर देती है और सेल A1 पर लौट आती है"},{"en":"It opens the Home tab on the Ribbon","hi":"यह रिबन पर होम टैब खोलती है"},{"en":"It saves the document","hi":"यह डॉक्यूमेंट को सेव करती है"}],"exp":{"en":"When navigating a context menu or Ribbon drop-down with the keyboard, pressing the Home key jumps selection to the first item on that menu (and End jumps to the last item).","hi":"जब आप कीबोर्ड से कोई ड्रॉपडाउन मेनू (या राइट-क्लिक मेनू) खोलते हैं, तो 'Home' कुंजी दबाने से मेनू का सबसे पहला विकल्प सेलेक्ट हो जाता है (और 'End' कुंजी से सबसे आखिरी विकल्प)।"},"num":216}]},{"title":{"en":"10. Excel Function Keys F1–F12","hi":"10. एक्सेल फंक्शन कीज़ F1–F12"},"questions":[{"id":"q217","q":{"en":"What do 'F1' and 'Ctrl+F1' do in MS Excel?","hi":"MS Excel में 'F1' और 'Ctrl+F1' क्या करते हैं?"},"a":{"en":"F1 opens Excel Help; Ctrl+F1 shows/hides the Ribbon","hi":"F1 एक्सेल हेल्प (Help) खोलता है; Ctrl+F1 रिबन को शो/हाइड (दिखाता/छिपाता) करता है"},"o":[{"en":"F1 opens Excel Help; Ctrl+F1 shows/hides the Ribbon","hi":"F1 एक्सेल हेल्प (Help) खोलता है; Ctrl+F1 रिबन को शो/हाइड (दिखाता/छिपाता) करता है"},{"en":"F1 saves the file; Ctrl+F1 prints the file","hi":"F1 फाइल सेव करता है; Ctrl+F1 फाइल प्रिंट करता है"},{"en":"F1 creates a chart; Ctrl+F1 deletes a chart","hi":"F1 चार्ट बनाता है; Ctrl+F1 चार्ट डिलीट करता है"},{"en":"F1 opens a new window; Ctrl+F1 closes the window","hi":"F1 नई विंडो खोलता है; Ctrl+F1 विंडो बंद करता है"}],"exp":{"en":"F1 opens the Help task pane. Ctrl+F1 toggles the Ribbon's visibility (expanding or collapsing it to save screen space).","hi":"F1 कुंजी से Excel Help खुलती है। Ctrl+F1 रिबन को सिकोड़ता या फैलाता (Show/Hide) है ताकि स्क्रीन पर अधिक जगह मिल सके।"},"num":217},{"id":"q218","q":{"en":"What are the actions of 'Alt+F1', 'Alt+Shift+F1', and 'Ctrl+Shift+F1' in MS Excel?","hi":"MS Excel में 'Alt+F1', 'Alt+Shift+F1' और 'Ctrl+Shift+F1' के क्या कार्य हैं?"},"a":{"en":"Alt+F1 creates an embedded chart of the current range; Alt+Shift+F1 inserts a new worksheet; Ctrl+Shift+F1 toggles full-screen mode (in supported Excel desktop versions)","hi":"Alt+F1 वर्तमान रेंज का एम्बेडेड चार्ट बनाता है; Alt+Shift+F1 नई वर्कशीट डालता है; Ctrl+Shift+F1 फुल-स्क्रीन मोड टॉगल करता है (समर्थित डेस्कटॉप वर्ज़न में)"},"o":[{"en":"Alt+F1 creates an embedded chart of the current range; Alt+Shift+F1 inserts a new worksheet; Ctrl+Shift+F1 toggles full-screen mode (in supported Excel desktop versions)","hi":"Alt+F1 वर्तमान रेंज का एम्बेडेड चार्ट बनाता है; Alt+Shift+F1 नई वर्कशीट डालता है; Ctrl+Shift+F1 फुल-स्क्रीन मोड टॉगल करता है (समर्थित डेस्कटॉप वर्ज़न में)"},{"en":"Alt+F1 closes Excel; Alt+Shift+F1 saves as PDF; Ctrl+Shift+F1 prints","hi":"Alt+F1 एक्सेल बंद करता है; Alt+Shift+F1 PDF सेव करता है; Ctrl+Shift+F1 प्रिंट करता है"},{"en":"Alt+F1 changes font; Alt+Shift+F1 changes color; Ctrl+Shift+F1 changes alignment","hi":"Alt+F1 फ़ॉन्ट बदलता है; Alt+Shift+F1 रंग बदलता है; Ctrl+Shift+F1 अलाइनमेंट बदलता है"},{"en":"Alt+F1 hides rows; Alt+Shift+F1 hides columns; Ctrl+Shift+F1 unhides them","hi":"Alt+F1 रो छिपाता है; Alt+Shift+F1 कॉलम छिपाता है; Ctrl+Shift+F1 उन्हें दिखाता है"}],"exp":{"en":"Alt+F1 quickly creates a default chart on the current worksheet. Alt+Shift+F1 is a classic shortcut to insert a new sheet. Ctrl+Shift+F1 hides the Ribbon and UI elements to display the sheet in full screen.","hi":"Alt+F1 सेलेक्ट किए गए डेटा का उसी शीट पर एक एम्बेडेड चार्ट बना देता है। Alt+Shift+F1 (Shift+F11 की तरह) नई वर्कशीट जोड़ता है। Ctrl+Shift+F1 एक्सेल को फुल-स्क्रीन मोड में टॉगल करता है।"},"num":218},{"id":"q219","q":{"en":"What do 'F2', 'Shift+F2', and 'Ctrl+F2' do in MS Excel?","hi":"MS Excel में 'F2', 'Shift+F2' और 'Ctrl+F2' का एक्शन क्या है?"},"a":{"en":"F2 edits the active cell; Shift+F2 adds/edits a cell note; Ctrl+F2 opens Print Preview","hi":"F2 एक्टिव सेल को एडिट (edit) करता है; Shift+F2 सेल नोट (note) जोड़ता/एडिट करता है; Ctrl+F2 प्रिंट प्रीव्यू (Print Preview) खोलता है"},"o":[{"en":"F2 edits the active cell; Shift+F2 adds/edits a cell note; Ctrl+F2 opens Print Preview","hi":"F2 एक्टिव सेल को एडिट (edit) करता है; Shift+F2 सेल नोट (note) जोड़ता/एडिट करता है; Ctrl+F2 प्रिंट प्रीव्यू (Print Preview) खोलता है"},{"en":"F2 saves the file; Shift+F2 renames the file; Ctrl+F2 deletes the file","hi":"F2 फाइल सेव करता है; Shift+F2 फाइल का नाम बदलता है; Ctrl+F2 फाइल डिलीट करता है"},{"en":"F2 inserts a row; Shift+F2 inserts a column; Ctrl+F2 deletes a row","hi":"F2 रो डालता है; Shift+F2 कॉलम डालता है; Ctrl+F2 रो डिलीट करता है"},{"en":"F2 finds text; Shift+F2 replaces text; Ctrl+F2 goes to a cell","hi":"F2 टेक्स्ट खोजता है; Shift+F2 टेक्स्ट बदलता है; Ctrl+F2 सेल पर जाता है"}],"exp":{"en":"F2 puts the active cell into Edit mode. Shift+F2 inserts or edits a cell note (comment). Ctrl+F2 opens the Backstage Print screen (Print Preview).","hi":"F2 दबाने से आप एक्टिव सेल के अंदर डेटा/फॉर्मूला एडिट कर सकते हैं। Shift+F2 से सेल में नोट (कमेंट) जुड़ता है। Ctrl+F2 से प्रिंट प्रीव्यू (Backstage Print) खुलता है।"},"num":219},{"id":"q220","q":{"en":"How does the 'F2' key function while in formula edit mode in Excel?","hi":"Excel में फॉर्मूला एडिट मोड (formula edit mode) में 'F2' कुंजी कैसे काम करती है?"},"a":{"en":"It toggles Point mode, allowing arrow keys to be used for creating cell references or moving the text cursor","hi":"यह पॉइंट मोड (Point mode) टॉगल कर सकता है, जिससे तीर कुंजियों (arrow keys) का उपयोग सेल रिफरेन्स बनाने या टेक्स्ट कर्सर को मूव करने के लिए किया जा सके"},"o":[{"en":"It toggles Point mode, allowing arrow keys to be used for creating cell references or moving the text cursor","hi":"यह पॉइंट मोड (Point mode) टॉगल कर सकता है, जिससे तीर कुंजियों (arrow keys) का उपयोग सेल रिफरेन्स बनाने या टेक्स्ट कर्सर को मूव करने के लिए किया जा सके"},{"en":"It deletes the entire formula","hi":"यह पूरे फॉर्मूले को डिलीट कर देता है"},{"en":"It evaluates the formula immediately","hi":"यह तुरंत फॉर्मूले का मूल्यांकन (evaluate) करता है"},{"en":"It changes the formula into a comment","hi":"यह फॉर्मूले को कमेंट में बदल देता है"}],"exp":{"en":"When you are editing a formula, pressing F2 toggles the behavior of the Arrow keys: either they move the cursor within the text of the formula (Edit mode) or they select other cells to add references (Point/Enter mode).","hi":"फॉर्मूला टाइप करते समय F2 दबाने से 'पॉइंट मोड' और 'एडिट मोड' के बीच टॉगल होता है। यानी, आप एरो कीज़ से या तो टेक्स्ट कर्सर को आगे-पीछे कर सकते हैं, या अन्य सेल्स को सेलेक्ट करके उनका रिफरेन्स फॉर्मूले में जोड़ सकते हैं।"},"num":220},{"id":"q221","q":{"en":"What do 'F3' and 'Shift+F3' open in MS Excel?","hi":"MS Excel में 'F3' और 'Shift+F3' क्या खोलते हैं?"},"a":{"en":"F3 opens the Paste Name dialog (if defined names exist); Shift+F3 opens the Insert Function dialog","hi":"यदि डिफाइंड नेम्स (defined names) मौजूद हों तो F3 'Paste Name' डायलॉग खोलता है; Shift+F3 'Insert Function' डायलॉग खोलता है"},"o":[{"en":"F3 opens the Paste Name dialog (if defined names exist); Shift+F3 opens the Insert Function dialog","hi":"यदि डिफाइंड नेम्स (defined names) मौजूद हों तो F3 'Paste Name' डायलॉग खोलता है; Shift+F3 'Insert Function' डायलॉग खोलता है"},{"en":"F3 opens the Format Cells dialog; Shift+F3 opens the Font dialog","hi":"F3 फॉर्मेट सेल्स डायलॉग खोलता है; Shift+F3 फ़ॉन्ट डायलॉग खोलता है"},{"en":"F3 opens the Print dialog; Shift+F3 opens the Save As dialog","hi":"F3 प्रिंट डायलॉग खोलता है; Shift+F3 सेव ऐज़ डायलॉग खोलता है"},{"en":"F3 opens the Macro dialog; Shift+F3 opens the VBA editor","hi":"F3 मैक्रो डायलॉग खोलता है; Shift+F3 VBA एडिटर खोलता है"}],"exp":{"en":"If there are named ranges in the workbook, F3 displays the Paste Name dialog to use them in a formula. Shift+F3 opens the Insert Function dialog (the 'fx' button) to search for and insert Excel formulas.","hi":"यदि आपने शीट में नाम (Named ranges) बनाए हैं, तो F3 उन्हें फॉर्मूले में पेस्ट करने का डायलॉग खोलता है। Shift+F3 से 'Insert Function' (fx) डायलॉग बॉक्स खुलता है।"},"num":221},{"id":"q222","q":{"en":"What are the actions of 'F4', 'Ctrl+F4', and 'Alt+F4' in MS Excel?","hi":"MS Excel में 'F4', 'Ctrl+F4' और 'Alt+F4' का एक्शन क्या है?"},"a":{"en":"F4 repeats the last applicable action or cycles selected formula references; Ctrl+F4 closes the workbook window; Alt+F4 closes Excel","hi":"F4 लागू होने वाला अंतिम एक्शन (last action) रिपीट करता है या चयनित फॉर्मूला रिफरेन्स (reference) को साइकिल करता है; Ctrl+F4 वर्कबुक विंडो बंद करता है; Alt+F4 एक्सेल बंद करता है"},"o":[{"en":"F4 repeats the last applicable action or cycles selected formula references; Ctrl+F4 closes the workbook window; Alt+F4 closes Excel","hi":"F4 लागू होने वाला अंतिम एक्शन (last action) रिपीट करता है या चयनित फॉर्मूला रिफरेन्स (reference) को साइकिल करता है; Ctrl+F4 वर्कबुक विंडो बंद करता है; Alt+F4 एक्सेल बंद करता है"},{"en":"F4 saves the file; Ctrl+F4 prints it; Alt+F4 shares it","hi":"F4 फाइल सेव करता है; Ctrl+F4 प्रिंट करता है; Alt+F4 शेयर करता है"},{"en":"F4 inserts a sheet; Ctrl+F4 deletes a sheet; Alt+F4 renames a sheet","hi":"F4 शीट डालता है; Ctrl+F4 शीट डिलीट करता है; Alt+F4 शीट का नाम बदलता है"},{"en":"F4 hides rows; Ctrl+F4 hides columns; Alt+F4 unhides them","hi":"F4 रो छिपाता है; Ctrl+F4 कॉलम छिपाता है; Alt+F4 उन्हें दिखाता है"}],"exp":{"en":"F4 has dual roles: repeating a recent action or toggling absolute/relative cell references ($). Ctrl+F4 closes the active workbook, and Alt+F4 closes the Excel application completely.","hi":"F4 पिछला एक्शन रिपीट करता है या फॉर्मूले में $ (एब्सोल्यूट/रिलेटिव रिफरेन्स) लगाता है। Ctrl+F4 वर्तमान फाइल (वर्कबुक) को बंद करता है, और Alt+F4 पूरे एक्सेल को बंद कर देता है।"},"num":222},{"id":"q223","q":{"en":"What are the classic actions of 'Shift+F4' and 'Shift+F5' in MS Excel?","hi":"MS Excel में 'Shift+F4' और 'Shift+F5' के क्लासिक एक्शन क्या हैं?"},"a":{"en":"Shift+F4 repeats the last Find action; Shift+F5 opens the Find dialog (depending on desktop version/context)","hi":"डेस्कटॉप वर्ज़न/संदर्भ के अनुसार: Shift+F4 अंतिम खोज (find) रिपीट करता है; Shift+F5 'Find' डायलॉग खोलता है"},"o":[{"en":"Shift+F4 repeats the last Find action; Shift+F5 opens the Find dialog (depending on desktop version/context)","hi":"डेस्कटॉप वर्ज़न/संदर्भ के अनुसार: Shift+F4 अंतिम खोज (find) रिपीट करता है; Shift+F5 'Find' डायलॉग खोलता है"},{"en":"Shift+F4 inserts a chart; Shift+F5 inserts a picture","hi":"Shift+F4 चार्ट डालता है; Shift+F5 पिक्चर डालता है"},{"en":"Shift+F4 aligns left; Shift+F5 aligns right","hi":"Shift+F4 बाएँ एलाइन करता है; Shift+F5 दाएँ एलाइन करता है"},{"en":"Shift+F4 copies format; Shift+F5 pastes format","hi":"Shift+F4 फॉर्मेट कॉपी करता है; Shift+F5 फॉर्मेट पेस्ट करता है"}],"exp":{"en":"In classic Windows Excel, Shift+F5 opens the Find dialog (like Ctrl+F), and Shift+F4 repeats the last Find action (Find Next).","hi":"क्लासिक डेस्कटॉप एक्सेल में, Shift+F5 से 'Find' डायलॉग (खोजें) खुलता है, और Shift+F4 पिछली खोज (Find Next) को रिपीट करता है।"},"num":223},{"id":"q224","q":{"en":"What do 'F5' and 'Ctrl+F5' do in MS Excel?","hi":"MS Excel में 'F5' और 'Ctrl+F5' क्या करते हैं?"},"a":{"en":"F5 opens the Go To dialog; Ctrl+F5 restores the workbook window size","hi":"F5 'Go To' डायलॉग खोलता है; Ctrl+F5 वर्कबुक विंडो के आकार को रिस्टोर (restore) करता है"},"o":[{"en":"F5 opens the Go To dialog; Ctrl+F5 restores the workbook window size","hi":"F5 'Go To' डायलॉग खोलता है; Ctrl+F5 वर्कबुक विंडो के आकार को रिस्टोर (restore) करता है"},{"en":"F5 refreshes data; Ctrl+F5 saves data","hi":"F5 डेटा रिफ्रेश करता है; Ctrl+F5 डेटा सेव करता है"},{"en":"F5 sorts A-Z; Ctrl+F5 sorts Z-A","hi":"F5 A-Z सॉर्ट करता है; Ctrl+F5 Z-A सॉर्ट करता है"},{"en":"F5 adds a filter; Ctrl+F5 removes a filter","hi":"F5 फ़िल्टर जोड़ता है; Ctrl+F5 फ़िल्टर हटाता है"}],"exp":{"en":"F5 (like Ctrl+G) opens the Go To dialog to jump to specific cells or named ranges. Ctrl+F5 restores a maximized workbook window to its previous size (not full screen).","hi":"F5 दबाने से 'Go To' डायलॉग खुलता है (किसी सेल या रेंज पर जाने के लिए)। Ctrl+F5 मैक्सिमाइज़ की गई वर्कबुक विंडो को उसके पिछले (छोटे) आकार में रिस्टोर करता है।"},"num":224},{"id":"q225","q":{"en":"What is the function of 'F6' and 'Shift+F6' in Excel?","hi":"Excel में 'F6' और 'Shift+F6' का क्या काम है?"},"a":{"en":"They switch focus forward/reverse between the worksheet, ribbon, task pane, and zoom controls (split panes can also be in the cycle)","hi":"वे वर्कशीट, रिबन, टास्क पेन और ज़ूम कंट्रोल्स के बीच फोकस को फॉरवर्ड/रिवर्स (आगे/पीछे) स्विच करते हैं (स्प्लिट पेन भी साइकिल में हो सकते हैं)"},"o":[{"en":"They switch focus forward/reverse between the worksheet, ribbon, task pane, and zoom controls (split panes can also be in the cycle)","hi":"वे वर्कशीट, रिबन, टास्क पेन और ज़ूम कंट्रोल्स के बीच फोकस को फॉरवर्ड/रिवर्स (आगे/पीछे) स्विच करते हैं (स्प्लिट पेन भी साइकिल में हो सकते हैं)"},{"en":"They change the font color","hi":"वे फ़ॉन्ट का रंग बदलते हैं"},{"en":"They insert and delete comments","hi":"वे कमेंट्स डालते और हटाते हैं"},{"en":"They apply and remove conditional formatting","hi":"वे कंडीशनल फॉर्मेटिंग लागू करते और हटाते हैं"}],"exp":{"en":"F6 moves keyboard focus between the different panes of the Excel UI (Sheet, Ribbon, Task Pane, Status Bar/Zoom). Shift+F6 cycles backward. If the sheet is split, it cycles between the split panes.","hi":"F6 कुंजी कीबोर्ड फोकस को वर्कशीट, रिबन, खुले हुए टास्क पेन और ज़ूम कंट्रोल्स के बीच आगे (forward) घुमाती है। Shift+F6 यही काम उल्टी दिशा (reverse) में करता है।"},"num":225},{"id":"q226","q":{"en":"What do 'Ctrl+F6' and 'Ctrl+Shift+F6' do in MS Excel?","hi":"MS Excel में 'Ctrl+F6' और 'Ctrl+Shift+F6' क्या करते हैं?"},"a":{"en":"They switch between open Excel windows (the exact cycling depends on the current version and open-window state)","hi":"वे खुली हुई Excel विंडोज़ (windows) के बीच स्विच करते हैं (सटीक साइकिलिंग वर्तमान वर्ज़न और ओपन-विंडो की स्थिति पर निर्भर करती है)"},"o":[{"en":"They switch between open Excel windows (the exact cycling depends on the current version and open-window state)","hi":"वे खुली हुई Excel विंडोज़ (windows) के बीच स्विच करते हैं (सटीक साइकिलिंग वर्तमान वर्ज़न और ओपन-विंडो की स्थिति पर निर्भर करती है)"},{"en":"They merge and unmerge cells","hi":"वे सेल्स को मर्ज और अनमर्ज करते हैं"},{"en":"They wrap and unwrap text","hi":"वे टेक्स्ट को रैप और अनरैप करते हैं"},{"en":"They open the Format Cells and Name Manager dialogs","hi":"वे फॉर्मेट सेल्स और नेम मैनेजर डायलॉग खोलते हैं"}],"exp":{"en":"If you have multiple workbooks open, Ctrl+F6 switches focus to the next workbook window, and Ctrl+Shift+F6 switches to the previous one (similar to Ctrl+Tab).","hi":"यदि कई Excel फाइलें (वर्कबुक) खुली हैं, तो Ctrl+F6 अगली (next) और Ctrl+Shift+F6 पिछली (previous) वर्कबुक विंडो पर स्विच करता है।"},"num":226},{"id":"q227","q":{"en":"What do 'F7' and 'Ctrl+F7' do in MS Excel?","hi":"MS Excel में 'F7' और 'Ctrl+F7' क्या करते हैं?"},"a":{"en":"F7 runs Spelling check; Ctrl+F7 moves a non-maximized workbook window","hi":"F7 स्पेलिंग (Spelling) चेक करता है; Ctrl+F7 गैर-मैक्सिमाइज़्ड (non-maximized) वर्कबुक विंडो को मूव (move) करता है"},"o":[{"en":"F7 runs Spelling check; Ctrl+F7 moves a non-maximized workbook window","hi":"F7 स्पेलिंग (Spelling) चेक करता है; Ctrl+F7 गैर-मैक्सिमाइज़्ड (non-maximized) वर्कबुक विंडो को मूव (move) करता है"},{"en":"F7 opens the Thesaurus; Ctrl+F7 opens the Translator","hi":"F7 थिसॉरस खोलता है; Ctrl+F7 ट्रांसलेटर खोलता है"},{"en":"F7 calculates formulas; Ctrl+F7 deletes formulas","hi":"F7 फॉर्मूले कैलकुलेट करता है; Ctrl+F7 फॉर्मूले डिलीट करता है"},{"en":"F7 saves the file; Ctrl+F7 prints the file","hi":"F7 फाइल सेव करता है; Ctrl+F7 फाइल प्रिंट करता है"}],"exp":{"en":"F7 displays the Spelling dialog to check the active worksheet. Ctrl+F7 activates the 'Move' command on a window that is not maximized, letting you use arrow keys to move it.","hi":"F7 कुंजी से स्पेलिंग चेक (Spelling) शुरू होता है। यदि वर्कबुक विंडो मैक्सिमाइज़ नहीं है (छोटी है), तो Ctrl+F7 दबाने से आप उसे एरो कीज़ (तीर कुंजियों) की मदद से मूव कर सकते हैं।"},"num":227},{"id":"q228","q":{"en":"What are the actions of 'F8', 'Shift+F8', 'Ctrl+F8', and 'Alt+F8' in MS Excel?","hi":"MS Excel में 'F8', 'Shift+F8', 'Ctrl+F8' और 'Alt+F8' के एक्शन क्या हैं?"},"a":{"en":"Extend selection (F8), add non-adjacent selection (Shift+F8), resize non-maximized workbook window (Ctrl+F8), and open Macro dialog (Alt+F8)","hi":"F8 सेलेक्शन बढ़ाता है, Shift+F8 गैर-आसन्न (non-adjacent) सेलेक्शन जोड़ता है, Ctrl+F8 गैर-मैक्सिमाइज़्ड विंडो का आकार (resize) बदलता है, और Alt+F8 मैक्रो (Macro) डायलॉग खोलता है"},"o":[{"en":"Extend selection (F8), add non-adjacent selection (Shift+F8), resize non-maximized workbook window (Ctrl+F8), and open Macro dialog (Alt+F8)","hi":"F8 सेलेक्शन बढ़ाता है, Shift+F8 गैर-आसन्न (non-adjacent) सेलेक्शन जोड़ता है, Ctrl+F8 गैर-मैक्सिमाइज़्ड विंडो का आकार (resize) बदलता है, और Alt+F8 मैक्रो (Macro) डायलॉग खोलता है"},{"en":"Save, Save As, Print, and Share","hi":"सेव, सेव ऐज़, प्रिंट और शेयर"},{"en":"Bold, Italic, Underline, and Strikethrough","hi":"बोल्ड, इटैलिक, अंडरलाइन और स्ट्राइकथ्रू"},{"en":"Insert row, Delete row, Insert column, and Delete column","hi":"रो डालना, रो डिलीट करना, कॉलम डालना, और कॉलम डिलीट करना"}],"exp":{"en":"F8 toggles Extend Selection mode. Shift+F8 toggles Add to Selection mode. Ctrl+F8 allows resizing a window with arrow keys. Alt+F8 opens the Macro dialog.","hi":"F8 'एक्सटेंड सेलेक्शन' चालू करता है। Shift+F8 अलग-अलग सेल्स को सेलेक्ट करने (Add to Selection) की अनुमति देता है। Ctrl+F8 विंडो को रीसाइज़ करता है। Alt+F8 'मैक्रो' डायलॉग खोलता है।"},"num":228},{"id":"q229","q":{"en":"What is the difference between 'F9' and 'Shift+F9' in Excel?","hi":"Excel में 'F9' और 'Shift+F9' में क्या अंतर है?"},"a":{"en":"F9 calculates the worksheets in all open workbooks; Shift+F9 calculates only the active worksheet","hi":"F9 सभी खुली हुई वर्कबुक्स की वर्कशीट कैलकुलेट करता है; Shift+F9 केवल सक्रिय (active) वर्कशीट कैलकुलेट करता है"},"o":[{"en":"F9 calculates the worksheets in all open workbooks; Shift+F9 calculates only the active worksheet","hi":"F9 सभी खुली हुई वर्कबुक्स की वर्कशीट कैलकुलेट करता है; Shift+F9 केवल सक्रिय (active) वर्कशीट कैलकुलेट करता है"},{"en":"F9 saves the file; Shift+F9 saves as PDF","hi":"F9 फाइल सेव करता है; Shift+F9 PDF के रूप में सेव करता है"},{"en":"F9 opens the Help menu; Shift+F9 opens the Options menu","hi":"F9 हेल्प मेनू खोलता है; Shift+F9 ऑप्शंस मेनू खोलता है"},{"en":"F9 changes font size; Shift+F9 changes font color","hi":"F9 फ़ॉन्ट साइज़ बदलता है; Shift+F9 फ़ॉन्ट का रंग बदलता है"}],"exp":{"en":"F9 triggers a manual recalculation of all formulas in all open workbooks. Shift+F9 recalculates only the formulas on the currently active worksheet.","hi":"F9 दबाने से खुले हुए सभी एक्सेल फाइलों के सभी फॉर्मूले फिर से कैलकुलेट होते हैं। Shift+F9 दबाने से केवल सामने खुली (एक्टिव) वर्कशीट के फॉर्मूले कैलकुलेट होते हैं।"},"num":229},{"id":"q230","q":{"en":"What do 'Ctrl+Alt+F9' and 'Ctrl+Alt+Shift+F9' do in MS Excel?","hi":"MS Excel में 'Ctrl+Alt+F9' और 'Ctrl+Alt+Shift+F9' क्या करते हैं?"},"a":{"en":"Ctrl+Alt+F9 recalculates all open workbook cells (even unchanged formulas); Ctrl+Alt+Shift+F9 rechecks dependencies and then recalculates all open workbook cells","hi":"Ctrl+Alt+F9 अपरिवर्तित (unchanged) फॉर्मूलों सहित सभी खुली वर्कबुक सेल्स की फिर से गणना करता है; Ctrl+Alt+Shift+F9 निर्भरता (dependencies) की फिर से जाँच करता है और फिर सभी खुली वर्कबुक सेल्स की गणना करता है"},"o":[{"en":"Ctrl+Alt+F9 recalculates all open workbook cells (even unchanged formulas); Ctrl+Alt+Shift+F9 rechecks dependencies and then recalculates all open workbook cells","hi":"Ctrl+Alt+F9 अपरिवर्तित (unchanged) फॉर्मूलों सहित सभी खुली वर्कबुक सेल्स की फिर से गणना करता है; Ctrl+Alt+Shift+F9 निर्भरता (dependencies) की फिर से जाँच करता है और फिर सभी खुली वर्कबुक सेल्स की गणना करता है"},{"en":"Ctrl+Alt+F9 closes Excel; Ctrl+Alt+Shift+F9 shuts down the computer","hi":"Ctrl+Alt+F9 एक्सेल बंद करता है; Ctrl+Alt+Shift+F9 कंप्यूटर शट डाउन करता है"},{"en":"Ctrl+Alt+F9 creates a chart; Ctrl+Alt+Shift+F9 deletes all charts","hi":"Ctrl+Alt+F9 चार्ट बनाता है; Ctrl+Alt+Shift+F9 सभी चार्ट डिलीट करता है"},{"en":"Ctrl+Alt+F9 merges cells; Ctrl+Alt+Shift+F9 unmerges all cells","hi":"Ctrl+Alt+F9 सेल्स मर्ज करता है; Ctrl+Alt+Shift+F9 सभी सेल्स अनमर्ज करता है"}],"exp":{"en":"These are deep recalculation shortcuts. Ctrl+Alt+F9 forces a full recalculation of all open formulas. Adding Shift (Ctrl+Alt+Shift+F9) rebuilds the dependency tree before calculating (used if formulas seem stuck).","hi":"ये डीप रीकैलकुलेशन शॉर्टकट हैं। Ctrl+Alt+F9 हर फॉर्मूले को ज़बरदस्ती दोबारा कैलकुलेट करता है (भले ही डेटा न बदला हो)। Shift जोड़ने से वह पहले डिपेंडेंसी ट्री को रिचेक (recheck) करता है और फिर कैलकुलेट करता है।"},"num":230},{"id":"q231","q":{"en":"What does 'Ctrl+F9' do in MS Excel?","hi":"MS Excel में 'Ctrl+F9' क्या करता है?"},"a":{"en":"It minimizes the workbook window","hi":"यह वर्कबुक विंडो को मिनिमाइज़ (minimize) करता है"},"o":[{"en":"It minimizes the workbook window","hi":"यह वर्कबुक विंडो को मिनिमाइज़ (minimize) करता है"},{"en":"It opens a new workbook","hi":"यह एक नई वर्कबुक खोलता है"},{"en":"It prints the active worksheet","hi":"यह सक्रिय वर्कशीट को प्रिंट करता है"},{"en":"It inserts a column","hi":"यह एक कॉलम डालता है"}],"exp":{"en":"Pressing Ctrl+F9 minimizes the current workbook window to an icon (inside the Excel application workspace).","hi":"Ctrl+F9 वर्तमान वर्कबुक विंडो को मिनिमाइज़ करके छोटा कर देता है। (जबकि Word में Ctrl+F9 ब्लैंक फील्ड { } इंसर्ट करता है, इसलिए दोनों में अंतर याद रखें)।"},"num":231},{"id":"q232","q":{"en":"What are the uses of 'F10', 'Shift+F10', and 'Alt+Shift+F10' in MS Excel?","hi":"MS Excel में 'F10', 'Shift+F10' और 'Alt+Shift+F10' का क्या उपयोग है?"},"a":{"en":"F10 toggles KeyTips; Shift+F10 opens the context menu; Alt+Shift+F10 opens the action menu for the Error Checking button or smart tags","hi":"F10 'की-टिप्स' (KeyTips) टॉगल करता है; Shift+F10 कॉन्टेक्स्ट मेनू खोलता है; Alt+Shift+F10 'एरर चेकिंग' (Error Checking) बटन या स्मार्ट टैग के लिए एक्शन मेनू खोलता है"},"o":[{"en":"F10 toggles KeyTips; Shift+F10 opens the context menu; Alt+Shift+F10 opens the action menu for the Error Checking button or smart tags","hi":"F10 'की-टिप्स' (KeyTips) टॉगल करता है; Shift+F10 कॉन्टेक्स्ट मेनू खोलता है; Alt+Shift+F10 'एरर चेकिंग' (Error Checking) बटन या स्मार्ट टैग के लिए एक्शन मेनू खोलता है"},{"en":"F10 saves the file; Shift+F10 saves as PDF; Alt+Shift+F10 prints the file","hi":"F10 फाइल सेव करता है; Shift+F10 PDF के रूप में सेव करता है; Alt+Shift+F10 फाइल प्रिंट करता है"},{"en":"F10 adds a border; Shift+F10 removes a border; Alt+Shift+F10 changes border color","hi":"F10 बॉर्डर जोड़ता है; Shift+F10 बॉर्डर हटाता है; Alt+Shift+F10 बॉर्डर का रंग बदलता है"},{"en":"F10 aligns text left; Shift+F10 aligns center; Alt+Shift+F10 aligns right","hi":"F10 टेक्स्ट बाएँ एलाइन करता है; Shift+F10 सेंटर करता है; Alt+Shift+F10 दाएँ एलाइन करता है"}],"exp":{"en":"F10 activates the Ribbon shortcuts. Shift+F10 simulates a right-click. Alt+Shift+F10 opens the dropdown menu for an active smart tag, such as the Error Checking or Paste Options button.","hi":"F10 रिबन पर की-टिप्स दिखाता है। Shift+F10 राइट-क्लिक जैसा कॉन्टेक्स्ट मेनू खोलता है। Alt+Shift+F10 किसी स्मार्ट टैग (जैसे एरर अलर्ट या पेस्ट ऑप्शन्स) का मेनू खोलता है।"},"num":232},{"id":"q233","q":{"en":"What does 'Ctrl+F10' do in MS Excel?","hi":"MS Excel में 'Ctrl+F10' क्या करता है?"},"a":{"en":"It maximizes or restores the selected workbook window","hi":"यह चयनित वर्कबुक विंडो को मैक्सिमाइज़ (maximize) या रिस्टोर (restore) करता है"},"o":[{"en":"It maximizes or restores the selected workbook window","hi":"यह चयनित वर्कबुक विंडो को मैक्सिमाइज़ (maximize) या रिस्टोर (restore) करता है"},{"en":"It deletes the active worksheet","hi":"यह सक्रिय वर्कशीट को डिलीट करता है"},{"en":"It opens the Format Cells dialog","hi":"यह फॉर्मेट सेल्स डायलॉग खोलता है"},{"en":"It applies conditional formatting","hi":"यह कंडीशनल फॉर्मेटिंग लागू करता है"}],"exp":{"en":"Ctrl+F10 toggles the state of the active workbook window between maximized (filling the workspace) and restored (floating, resizable window).","hi":"Ctrl+F10 वर्तमान वर्कबुक विंडो को मैक्सिमाइज़ (पूरी स्क्रीन पर फैलाना) करता है, या वापस छोटे (रिस्टोर) आकार में लाता है।"},"num":233},{"id":"q234","q":{"en":"What is the exam difference between pressing 'F11' and 'Alt+F1' in Excel?","hi":"Excel में 'F11' और 'Alt+F1' दबाने के बीच परीक्षा का मुख्य अंतर क्या है?"},"a":{"en":"F11 creates a chart on a separate chart sheet; Alt+F1 creates an embedded chart on the current sheet","hi":"F11 एक अलग चार्ट शीट (separate chart sheet) पर चार्ट बनाता है; Alt+F1 वर्तमान शीट पर एक एम्बेडेड (embedded) चार्ट बनाता है"},"o":[{"en":"F11 creates a chart on a separate chart sheet; Alt+F1 creates an embedded chart on the current sheet","hi":"F11 एक अलग चार्ट शीट (separate chart sheet) पर चार्ट बनाता है; Alt+F1 वर्तमान शीट पर एक एम्बेडेड (embedded) चार्ट बनाता है"},{"en":"F11 creates a line chart; Alt+F1 creates a pie chart","hi":"F11 एक लाइन चार्ट बनाता है; Alt+F1 एक पाई चार्ट बनाता है"},{"en":"F11 opens the macro editor; Alt+F1 saves the file","hi":"F11 मैक्रो एडिटर खोलता है; Alt+F1 फाइल सेव करता है"},{"en":"F11 prints the active sheet; Alt+F1 prints the entire workbook","hi":"F11 सक्रिय शीट प्रिंट करता है; Alt+F1 पूरी वर्कबुक प्रिंट करता है"}],"exp":{"en":"Both create a chart from selected data. F11 places the chart on its own dedicated 'Chart' tab. Alt+F1 inserts the chart as a floating object directly on the current worksheet.","hi":"दोनों ही सेलेक्टेड डेटा का चार्ट बनाते हैं। लेकिन F11 चार्ट को एक बिल्कुल नई और अलग 'चार्ट शीट' पर बनाता है, जबकि Alt+F1 चार्ट को उसी (वर्तमान) शीट पर एम्बेडेड ऑब्जेक्ट के रूप में बनाता है।"},"num":234},{"id":"q235","q":{"en":"What is the difference between 'Shift+F11' and 'Alt+F11' in Excel?","hi":"Excel में 'Shift+F11' और 'Alt+F11' में क्या अंतर है?"},"a":{"en":"Shift+F11 inserts a new worksheet; Alt+F11 opens the VBA editor","hi":"Shift+F11 एक नई वर्कशीट (new worksheet) डालता है; Alt+F11 VBA एडिटर खोलता है"},"o":[{"en":"Shift+F11 inserts a new worksheet; Alt+F11 opens the VBA editor","hi":"Shift+F11 एक नई वर्कशीट (new worksheet) डालता है; Alt+F11 VBA एडिटर खोलता है"},{"en":"Shift+F11 deletes a worksheet; Alt+F11 renames a worksheet","hi":"Shift+F11 एक वर्कशीट डिलीट करता है; Alt+F11 वर्कशीट का नाम बदलता है"},{"en":"Shift+F11 saves the file; Alt+F11 prints the file","hi":"Shift+F11 फाइल सेव करता है; Alt+F11 फाइल प्रिंट करता है"},{"en":"Shift+F11 hides rows; Alt+F11 unhides rows","hi":"Shift+F11 रो छिपाता है; Alt+F11 रो दिखाता है"}],"exp":{"en":"Shift+F11 (or Alt+Shift+F1) adds a new blank sheet to the workbook. Alt+F11 opens the Visual Basic for Applications (VBA) editor window to write macros.","hi":"Shift+F11 वर्कबुक में एक नई खाली वर्कशीट (Sheet) जोड़ता है। Alt+F11 मैक्रो कोड लिखने के लिए VBA (Visual Basic for Applications) एडिटर खोलता है।"},"num":235},{"id":"q236","q":{"en":"What are the common actions of 'F12', 'Ctrl+F12', and 'Ctrl+Shift+F12' in MS Excel?","hi":"MS Excel में 'F12', 'Ctrl+F12' और 'Ctrl+Shift+F12' के सामान्य एक्शन क्या हैं?"},"a":{"en":"F12 is Save As, Ctrl+F12 is Open, and Ctrl+Shift+F12 is Print (the exact look of the dialog depends on the version)","hi":"F12 'सेव ऐज़' (Save As) है, Ctrl+F12 'ओपन' (Open) है, और Ctrl+Shift+F12 'प्रिंट' (Print) है (डायलॉग का सटीक रूप वर्ज़न पर निर्भर करता है)"},"o":[{"en":"F12 is Save As, Ctrl+F12 is Open, and Ctrl+Shift+F12 is Print (the exact look of the dialog depends on the version)","hi":"F12 'सेव ऐज़' (Save As) है, Ctrl+F12 'ओपन' (Open) है, और Ctrl+Shift+F12 'प्रिंट' (Print) है (डायलॉग का सटीक रूप वर्ज़न पर निर्भर करता है)"},{"en":"F12 is Save, Ctrl+F12 is Delete, and Ctrl+Shift+F12 is Rename","hi":"F12 'सेव' है, Ctrl+F12 'डिलीट' है, और Ctrl+Shift+F12 'रीनेम' है"},{"en":"F12 is Cut, Ctrl+F12 is Copy, and Ctrl+Shift+F12 is Paste","hi":"F12 'कट' है, Ctrl+F12 'कॉपी' है, और Ctrl+Shift+F12 'पेस्ट' है"},{"en":"F12 is Undo, Ctrl+F12 is Redo, and Ctrl+Shift+F12 is Cancel","hi":"F12 'अनडू' है, Ctrl+F12 'रीडू' है, और Ctrl+Shift+F12 'कैंसल' है"}],"exp":{"en":"In MS Excel, F12 triggers the Save As dialog, Ctrl+F12 triggers the Open dialog/Backstage view, and Ctrl+Shift+F12 goes to the Print preview/settings pane.","hi":"F12 से 'Save As' डायलॉग खुलता है, Ctrl+F12 से 'Open' (पुरानी फाइल खोलने के लिए) और Ctrl+Shift+F12 से 'Print' (प्रिंट प्रीव्यू) खुलता है।"},"num":236},{"id":"q237","q":{"en":"In Excel, the 'Alt+Shift+F11' shortcut is associated with which older legacy feature in the source notes?","hi":"Excel में 'Alt+Shift+F11' शॉर्टकट को सोर्स नोट्स में किस पुराने (legacy) फीचर से जोड़ा गया है?"},"a":{"en":"Microsoft Script Editor (This was a legacy Office feature)","hi":"माइक्रोसॉफ्ट स्क्रिप्ट एडिटर (Microsoft Script Editor) (यह एक लीगेसी ऑफिस फीचर था)"},"o":[{"en":"Microsoft Script Editor (This was a legacy Office feature)","hi":"माइक्रोसॉफ्ट स्क्रिप्ट एडिटर (Microsoft Script Editor) (यह एक लीगेसी ऑफिस फीचर था)"},{"en":"Clippy the Assistant","hi":"क्लिपी द असिस्टेंट"},{"en":"WordArt 3D Text","hi":"वर्डआर्ट 3D टेक्स्ट"},{"en":"Lotus 1-2-3 Compatibility Mode","hi":"लोटस 1-2-3 कम्पैटिबिलिटी मोड"}],"exp":{"en":"Historically, Alt+Shift+F11 opened the Microsoft Script Editor to edit HTML/XML scripts behind an Office document. This is considered a legacy shortcut in modern versions.","hi":"ऐतिहासिक रूप से, Alt+Shift+F11 माइक्रोसॉफ्ट स्क्रिप्ट एडिटर (Microsoft Script Editor) खोलता था। आधुनिक संस्करणों में यह एक लीगेसी (पुराना) शॉर्टकट है।"},"num":237}]},{"title":{"en":"11. PowerPoint & Access","hi":"11. पावरपॉइंट और एक्सेस"},"questions":[{"id":"q238","q":{"en":"What is the primary use of Microsoft PowerPoint?","hi":"माइक्रोसॉफ्ट पावरपॉइंट (PowerPoint) का मुख्य उपयोग क्या है?"},"a":{"en":"Creating and delivering presentations with text, images, charts, audio/video, and animations on slides","hi":"स्लाइड में टेक्स्ट, चित्र (images), चार्ट, ऑडियो/वीडियो और एनीमेशन के साथ प्रेजेंटेशन बनाना और प्रस्तुत (deliver) करना"},"o":[{"en":"Creating and delivering presentations with text, images, charts, audio/video, and animations on slides","hi":"स्लाइड में टेक्स्ट, चित्र (images), चार्ट, ऑडियो/वीडियो और एनीमेशन के साथ प्रेजेंटेशन बनाना और प्रस्तुत (deliver) करना"},{"en":"Writing complex software code and debugging it","hi":"जटिल सॉफ्टवेयर कोड लिखना और उसे डिबग करना"},{"en":"Managing large relational databases and SQL queries","hi":"बड़े रिलेशनल डेटाबेस और SQL क्वेरी का प्रबंधन करना"},{"en":"Browsing the internet and downloading files","hi":"इंटरनेट ब्राउज़ करना और फाइलें डाउनलोड करना"}],"exp":{"en":"Microsoft PowerPoint is a presentation program used to create slideshows containing text, multimedia (images, audio, video), charts, and animations for professional delivery.","hi":"PowerPoint एक प्रेजेंटेशन सॉफ्टवेयर है, जिसका उपयोग स्लाइडों में टेक्स्ट, इमेज, चार्ट, ऑडियो/वीडियो और एनीमेशन जोड़कर आकर्षक प्रेजेंटेशन बनाने और प्रस्तुत करने के लिए किया जाता है।"},"num":238},{"id":"q239","q":{"en":"What are the roles of the slides pane, slide canvas, and notes pane on the PowerPoint screen?","hi":"PowerPoint स्क्रीन में 'स्लाइड्स पेन', 'स्लाइड कैनवस' और 'नोट्स पेन' का क्या काम है?"},"a":{"en":"Slides pane is for thumbnails/reordering; slide canvas is for editing the slide; notes pane is for speaker notes","hi":"स्लाइड्स पेन थंबनेल/रीऑर्डर (thumbnails/reorder) के लिए है; कैनवस स्लाइड को एडिट (edit) करने के लिए है; नोट्स पेन स्पीकर नोट्स (speaker notes) के लिए है"},"o":[{"en":"Slides pane is for thumbnails/reordering; slide canvas is for editing the slide; notes pane is for speaker notes","hi":"स्लाइड्स पेन थंबनेल/रीऑर्डर (thumbnails/reorder) के लिए है; कैनवस स्लाइड को एडिट (edit) करने के लिए है; नोट्स पेन स्पीकर नोट्स (speaker notes) के लिए है"},{"en":"Slides pane is for animations; slide canvas is for transitions; notes pane is for saving files","hi":"स्लाइड्स पेन एनीमेशन के लिए है; कैनवस ट्रांज़िशन के लिए है; नोट्स पेन फाइल सेव करने के लिए है"},{"en":"Slides pane plays videos; slide canvas plays audio; notes pane prints the slide","hi":"स्लाइड्स पेन वीडियो चलाता है; कैनवस ऑडियो चलाता है; नोट्स पेन स्लाइड प्रिंट करता है"},{"en":"Slides pane shows formulas; slide canvas shows data; notes pane shows charts","hi":"स्लाइड्स पेन फॉर्मूले दिखाता है; कैनवस डेटा दिखाता है; नोट्स पेन चार्ट दिखाता है"}],"exp":{"en":"In Normal view, the left Slides pane shows thumbnails for navigation and reordering. The large central Slide Canvas is where you edit content. The bottom Notes pane holds private speaker notes.","hi":"बाईं ओर का Slides pane थंबनेल दिखाता है (स्लाइड्स को आगे-पीछे करने के लिए)। बीच का बड़ा Slide Canvas स्लाइड को डिजाइन (एडिट) करने के लिए होता है। नीचे का Notes pane वक्ता (speaker) के लिए निजी नोट्स लिखने के काम आता है।"},"num":239},{"id":"q240","q":{"en":"Which of the following are the main Ribbon tabs in Microsoft PowerPoint?","hi":"माइक्रोसॉफ्ट पावरपॉइंट के मुख्य रिबन टैब (Main Ribbon tabs) कौन-से हैं?"},"a":{"en":"File, Home, Insert, Design, Transitions, Animations, Slide Show, Review, and View","hi":"File, Home, Insert, Design, Transitions, Animations, Slide Show, Review और View"},"o":[{"en":"File, Home, Insert, Design, Transitions, Animations, Slide Show, Review, and View","hi":"File, Home, Insert, Design, Transitions, Animations, Slide Show, Review और View"},{"en":"File, Home, Insert, Page Layout, Formulas, Data, and Review","hi":"File, Home, Insert, Page Layout, Formulas, Data और Review"},{"en":"File, Home, Insert, Mailings, References, and Layout","hi":"File, Home, Insert, Mailings, References और Layout"},{"en":"File, Home, Queries, Database Tools, and Macros","hi":"File, Home, Queries, Database Tools और Macros"}],"exp":{"en":"The standard PowerPoint Ribbon features tabs specific to presentations, notably Transitions, Animations, and Slide Show, replacing Word's Mailings/References or Excel's Formulas/Data.","hi":"PowerPoint के मुख्य रिबन टैब्स File, Home, Insert, Design, Transitions, Animations, Slide Show, Review और View हैं। (Transitions और Animations टैब इसे Word/Excel से अलग बनाते हैं)।"},"num":240},{"id":"q241","q":{"en":"What functions are found under the 'File' and 'Home' tabs in PowerPoint?","hi":"PowerPoint के 'File' और 'Home' टैब्स में क्या मिलता है?"},"a":{"en":"File manages open/save/share/export/print; Home contains Clipboard, Slides, Font, Paragraph, Drawing, and Editing groups","hi":"File ओपन/सेव/शेयर/एक्सपोर्ट/प्रिंट मैनेज करता है; Home में Clipboard, Slides, Font, Paragraph, Drawing और Editing ग्रुप्स होते हैं"},"o":[{"en":"File manages open/save/share/export/print; Home contains Clipboard, Slides, Font, Paragraph, Drawing, and Editing groups","hi":"File ओपन/सेव/शेयर/एक्सपोर्ट/प्रिंट मैनेज करता है; Home में Clipboard, Slides, Font, Paragraph, Drawing और Editing ग्रुप्स होते हैं"},{"en":"File adds transitions; Home adds animations","hi":"File ट्रांज़िशन जोड़ता है; Home एनीमेशन जोड़ता है"},{"en":"File changes colors; Home prints slides","hi":"File रंग बदलता है; Home स्लाइड प्रिंट करता है"},{"en":"File checks spelling; Home creates macros","hi":"File स्पेलिंग चेक करता है; Home मैक्रो बनाता है"}],"exp":{"en":"The File tab opens the Backstage view for document management. The Home tab provides essential tools for formatting and includes the 'Slides' group and 'Drawing' group (unlike Word/Excel).","hi":"File टैब बैकस्टेज व्यू (Backstage view) खोलता है। Home टैब में Clipboard, Font, Paragraph के अलावा 'Slides' और 'Drawing' ग्रुप होते हैं (जो इसे Word/Excel से अलग बनाते हैं)।"},"num":241},{"id":"q242","q":{"en":"What commands are available in the 'Slides' group on the PowerPoint Home tab?","hi":"PowerPoint के Home टैब के 'Slides' ग्रुप में कौन-से कमांड्स (कााम) होते हैं?"},"a":{"en":"Commands to insert a new slide, choose a slide layout, reset formatting/positions, and related slide commands","hi":"नई स्लाइड (New slide) डालना, लेआउट चुनना, फॉर्मेटिंग/पोज़िशन्स रीसेट (reset) करना और संबंधित स्लाइड कमांड्स"},"o":[{"en":"Commands to insert a new slide, choose a slide layout, reset formatting/positions, and related slide commands","hi":"नई स्लाइड (New slide) डालना, लेआउट चुनना, फॉर्मेटिंग/पोज़िशन्स रीसेट (reset) करना और संबंधित स्लाइड कमांड्स"},{"en":"Commands to set slide transitions and animations","hi":"स्लाइड ट्रांज़िशन और एनीमेशन सेट करना"},{"en":"Commands to print the slideshow","hi":"स्लाइड शो प्रिंट करना"},{"en":"Commands to create 3D charts and SmartArt","hi":"3D चार्ट और स्मार्टआर्ट (SmartArt) बनाना"}],"exp":{"en":"The 'Slides' group on the Home tab allows you to quickly add a New Slide, change the Layout of an existing slide, Reset a slide to its default formatting, or organize slides into Sections.","hi":"Home टैब के 'Slides' ग्रुप में New Slide जोड़ने, Layout बदलने, और स्लाइड की फॉर्मेटिंग को Reset करने के विकल्प होते हैं।"},"num":242},{"id":"q243","q":{"en":"What elements can be added using the 'Insert' tab in PowerPoint?","hi":"PowerPoint में 'Insert' टैब से क्या जोड़ा जा सकता है?"},"a":{"en":"Pictures, shapes, charts, hyperlinks, text boxes, video, and WordArt","hi":"चित्र (Pictures), शेप्स (shapes), चार्ट, हाइपरलिंक्स, टेक्स्ट बॉक्स, वीडियो और वर्डआर्ट (WordArt)"},"o":[{"en":"Pictures, shapes, charts, hyperlinks, text boxes, video, and WordArt","hi":"चित्र (Pictures), शेप्स (shapes), चार्ट, हाइपरलिंक्स, टेक्स्ट बॉक्स, वीडियो और वर्डआर्ट (WordArt)"},{"en":"Only slide transitions and background colors","hi":"केवल स्लाइड ट्रांज़िशन और बैकग्राउंड रंग"},{"en":"Only Excel spreadsheets and pivot tables","hi":"केवल एक्सेल स्प्रेडशीट और पाइवट टेबल"},{"en":"Only page numbers and paragraph borders","hi":"केवल पेज नंबर और पैराग्राफ बॉर्डर"}],"exp":{"en":"The Insert tab is used to embed visual and interactive elements like Pictures, Shapes, SmartArt, Charts, Text Boxes, WordArt, Equations, Video, and Audio into a slide.","hi":"Insert टैब का उपयोग स्लाइड में पिक्चर, शेप्स, चार्ट, टेक्स्ट बॉक्स, वीडियो/ऑडियो, हाइपरलिंक और वर्डआर्ट जैसी चीज़ें जोड़ने के लिए किया जाता है।"},"num":243},{"id":"q244","q":{"en":"What is the primary use of the 'Design' tab in PowerPoint?","hi":"PowerPoint में 'Design' टैब का मुख्य उपयोग क्या है?"},"a":{"en":"Setting the presentation theme, colors, and slide background","hi":"प्रेजेंटेशन की थीम (Theme), रंग (colors) और स्लाइड बैकग्राउंड सेट करना"},"o":[{"en":"Setting the presentation theme, colors, and slide background","hi":"प्रेजेंटेशन की थीम (Theme), रंग (colors) और स्लाइड बैकग्राउंड सेट करना"},{"en":"Setting the timings for animations","hi":"एनीमेशन के लिए समय (timings) सेट करना"},{"en":"Connecting to an external database","hi":"बाहरी डेटाबेस (external database) से कनेक्ट करना"},{"en":"Checking grammar and spelling","hi":"व्याकरण और स्पेलिंग चेक करना"}],"exp":{"en":"The Design tab allows you to apply professional Themes (which include predefined colors, fonts, and effects) and to format the Slide Background or adjust Slide Size.","hi":"Design टैब का उपयोग पूरी प्रेजेंटेशन की थीम, कलर स्कीम (रंग), फ़ॉन्ट स्टाइल और स्लाइड का बैकग्राउंड सेट करने के लिए किया जाता है।"},"num":244},{"id":"q245","q":{"en":"What is the difference between a 'Transition' and an 'Animation' in PowerPoint?","hi":"PowerPoint में 'ट्रांज़िशन' (Transition) और 'एनीमेशन' (Animation) में क्या अंतर है?"},"a":{"en":"A transition is the effect between slides; an animation is the movement/appearance effect applied to objects inside a single slide","hi":"ट्रांज़िशन स्लाइडों के बीच का प्रभाव (effect) है; एनीमेशन एक ही स्लाइड के अंदर ऑब्जेक्ट्स (objects) के मूवमेंट/दिखने का प्रभाव है"},"o":[{"en":"A transition is the effect between slides; an animation is the movement/appearance effect applied to objects inside a single slide","hi":"ट्रांज़िशन स्लाइडों के बीच का प्रभाव (effect) है; एनीमेशन एक ही स्लाइड के अंदर ऑब्जेक्ट्स (objects) के मूवमेंट/दिखने का प्रभाव है"},{"en":"A transition changes the font color; an animation prints the slide","hi":"ट्रांज़िशन फ़ॉन्ट का रंग बदलता है; एनीमेशन स्लाइड प्रिंट करता है"},{"en":"A transition is used for videos; an animation is used for text only","hi":"ट्रांज़िशन वीडियो के लिए उपयोग होता है; एनीमेशन केवल टेक्स्ट के लिए उपयोग होता है"},{"en":"There is no difference; both mean changing the slide background","hi":"कोई अंतर नहीं है; दोनों का अर्थ स्लाइड का बैकग्राउंड बदलना है"}],"exp":{"en":"Transitions govern how one slide visually moves to the next slide during a slideshow (e.g., Fade, Wipe). Animations govern how individual elements (text, images) move or appear on a specific slide.","hi":"ट्रांज़िशन (Transitions) वह विज़ुअल इफ़ेक्ट है जो एक स्लाइड से दूसरी स्लाइड पर जाते समय दिखता है। एनीमेशन (Animations) स्लाइड के अंदर मौजूद किसी टेक्स्ट या इमेज (ऑब्जेक्ट) के हिलने या प्रकट होने का इफ़ेक्ट है।"},"num":245},{"id":"q246","q":{"en":"What are the primary uses of the 'Slide Show', 'Review', and 'View' tabs in PowerPoint?","hi":"PowerPoint में 'Slide Show', 'Review' और 'View' टैब का उपयोग क्या है?"},"a":{"en":"Slide Show for presentation setup/run; Review for spelling, comments, compare, and translation; View for modes like Normal, Outline, Slide Sorter, and Notes Page","hi":"'Slide Show' प्रेजेंटेशन सेटअप/रन करने के लिए; 'Review' स्पेलिंग, कमेंट्स, तुलना (compare) और अनुवाद (translation) के लिए; 'View' नॉर्मल (Normal), आउटलाइन (Outline), स्लाइड सॉर्टर (Slide Sorter) और नोट्स पेज (Notes Page) जैसे मोड के लिए"},"o":[{"en":"Slide Show for presentation setup/run; Review for spelling, comments, compare, and translation; View for modes like Normal, Outline, Slide Sorter, and Notes Page","hi":"'Slide Show' प्रेजेंटेशन सेटअप/रन करने के लिए; 'Review' स्पेलिंग, कमेंट्स, तुलना (compare) और अनुवाद (translation) के लिए; 'View' नॉर्मल (Normal), आउटलाइन (Outline), स्लाइड सॉर्टर (Slide Sorter) और नोट्स पेज (Notes Page) जैसे मोड के लिए"},{"en":"Slide Show to delete slides; Review to change colors; View to print","hi":"'Slide Show' स्लाइड हटाने के लिए; 'Review' रंग बदलने के लिए; 'View' प्रिंट करने के लिए"},{"en":"Slide Show adds animations; Review adds transitions; View adds charts","hi":"'Slide Show' एनीमेशन जोड़ता है; 'Review' ट्रांज़िशन जोड़ता है; 'View' चार्ट जोड़ता है"},{"en":"All three tabs are used exclusively for recording macros","hi":"तीनों टैब का उपयोग विशेष रूप से मैक्रोज़ रिकॉर्ड करने के लिए किया जाता है"}],"exp":{"en":"The Slide Show tab has tools to start and configure the presentation. Review handles proofing, translation, and comments. View allows switching between different layout/authoring modes.","hi":"Slide Show टैब से आप प्रेजेंटेशन शुरू और सेट कर सकते हैं। Review टैब स्पेलिंग चेक, कमेंट्स और ट्रांसलेशन के लिए है। View टैब से आप नॉर्मल, स्लाइड सॉर्टर या नोट्स पेज जैसे अलग-अलग व्यू (दृश्य) चुन सकते हैं।"},"num":246},{"id":"q247","q":{"en":"What do the 'Slide Sorter' and 'Notes Page' views display in PowerPoint?","hi":"PowerPoint में 'स्लाइड सॉर्टर' (Slide Sorter) और 'नोट्स पेज' (Notes Page) व्यू क्या दिखाते हैं?"},"a":{"en":"Slide Sorter shows slide ordering in a thumbnail grid; Notes Page shows a slide and its associated speaker notes","hi":"स्लाइड सॉर्टर थंबनेल ग्रिड (thumbnail grid) में स्लाइड का क्रम दिखाता है; नोट्स पेज एक स्लाइड और उससे जुड़े स्पीकर नोट्स (speaker notes) दिखाता है"},"o":[{"en":"Slide Sorter shows slide ordering in a thumbnail grid; Notes Page shows a slide and its associated speaker notes","hi":"स्लाइड सॉर्टर थंबनेल ग्रिड (thumbnail grid) में स्लाइड का क्रम दिखाता है; नोट्स पेज एक स्लाइड और उससे जुड़े स्पीकर नोट्स (speaker notes) दिखाता है"},{"en":"Slide Sorter deletes slides automatically; Notes Page plays audio","hi":"स्लाइड सॉर्टर स्लाइड को स्वतः हटा देता है; नोट्स पेज ऑडियो चलाता है"},{"en":"Slide Sorter sorts words alphabetically; Notes Page prints a calendar","hi":"स्लाइड सॉर्टर शब्दों को वर्णानुक्रम में सॉर्ट करता है; नोट्स पेज कैलेंडर प्रिंट करता है"},{"en":"Slide Sorter is for 3D graphics; Notes Page is for spreadsheets","hi":"स्लाइड सॉर्टर 3D ग्राफिक्स के लिए है; नोट्स पेज स्प्रेडशीट के लिए है"}],"exp":{"en":"Slide Sorter view displays all slides as a grid of thumbnails, making it easy to rearrange or delete slides. Notes Page view displays one slide per page with its corresponding speaker notes printed below it.","hi":"स्लाइड सॉर्टर (Slide Sorter) में सभी स्लाइड्स छोटे-छोटे बॉक्स (थंबनेल) के रूप में दिखती हैं, जिससे उनका क्रम बदलना आसान होता है। नोट्स पेज (Notes Page) में एक स्लाइड और उसके नीचे लिखे हुए स्पीकर नोट्स दिखते हैं।"},"num":247},{"id":"q248","q":{"en":"What is the difference between pressing 'Alt+S' and 'F5' in PowerPoint?","hi":"PowerPoint में 'Alt+S' और 'F5' दबाने में क्या अंतर है?"},"a":{"en":"Alt+S selects the Slide Show Ribbon tab; F5 runs the slide show from the beginning","hi":"Alt+S रिबन में 'स्लाइड शो' (Slide Show) टैब सेलेक्ट करता है; F5 शुरुआत (beginning) से स्लाइड शो रन करता है (चलाता है)"},"o":[{"en":"Alt+S selects the Slide Show Ribbon tab; F5 runs the slide show from the beginning","hi":"Alt+S रिबन में 'स्लाइड शो' (Slide Show) टैब सेलेक्ट करता है; F5 शुरुआत (beginning) से स्लाइड शो रन करता है (चलाता है)"},{"en":"Alt+S saves the file; F5 opens it","hi":"Alt+S फाइल सेव करता है; F5 उसे खोलता है"},{"en":"Alt+S sorts slides; F5 deletes a slide","hi":"Alt+S स्लाइड सॉर्ट करता है; F5 स्लाइड डिलीट करता है"},{"en":"Alt+S spells checks; F5 prints","hi":"Alt+S स्पेलिंग चेक करता है; F5 प्रिंट करता है"}],"exp":{"en":"In PowerPoint's KeyTip system, Alt+S opens the 'Slide Show' tab. Pressing the F5 function key launches the presentation in full screen, starting from Slide 1.","hi":"Alt+S से रिबन पर मौजूद 'Slide Show' टैब खुलता है। जबकि F5 कुंजी दबाने से पूरी स्क्रीन पर पहली स्लाइड (शुरुआत) से प्रेजेंटेशन (स्लाइड शो) शुरू हो जाता है।"},"num":248},{"id":"q249","q":{"en":"How do you start a PowerPoint slide show from the beginning, from the current slide, and how do you exit it?","hi":"PowerPoint स्लाइड शो को शुरुआत से, वर्तमान स्लाइड (current slide) से कैसे शुरू करते हैं, और उससे बाहर (exit) कैसे आते हैं?"},"a":{"en":"F5 (from beginning), Shift+F5 (from current slide), and Esc (to exit)","hi":"F5 (शुरुआत से), Shift+F5 (वर्तमान स्लाइड से), और Esc (बाहर निकलने के लिए)"},"o":[{"en":"F5 (from beginning), Shift+F5 (from current slide), and Esc (to exit)","hi":"F5 (शुरुआत से), Shift+F5 (वर्तमान स्लाइड से), और Esc (बाहर निकलने के लिए)"},{"en":"Ctrl+S (from beginning), Ctrl+C (from current), and Alt+F4 (to exit)","hi":"Ctrl+S, Ctrl+C, और Alt+F4"},{"en":"Shift+B (from beginning), Shift+C (from current), and End (to exit)","hi":"Shift+B, Shift+C, और End"},{"en":"F1 (from beginning), F2 (from current), and Delete (to exit)","hi":"F1, F2, और Delete"}],"exp":{"en":"F5 starts the presentation from Slide 1. Shift+F5 starts the presentation from the currently selected slide (useful for rehearsing). The Esc key ends the active slideshow.","hi":"F5 स्लाइड शो को पहली स्लाइड (शुरुआत) से चलाता है, Shift+F5 स्लाइड शो को उस स्लाइड से चलाता है जिस पर आप वर्तमान में हैं, और Esc कुंजी स्लाइड शो को रोककर (exit) नॉर्मल व्यू में ले आती है।"},"num":249},{"id":"q250","q":{"en":"What are the standard keyboard shortcuts for New, Open, Save, and Close presentation in PowerPoint?","hi":"PowerPoint में नई प्रेजेंटेशन (New), ओपन (Open), सेव (Save) और प्रेजेंटेशन बंद (Close) करने के मानक कीबोर्ड शॉर्टकट क्या हैं?"},"a":{"en":"Ctrl+N (New), Ctrl+O (Open), Ctrl+S (Save), and Ctrl+W or Ctrl+F4 (Close)","hi":"Ctrl+N (नया), Ctrl+O (ओपन), Ctrl+S (सेव), और Ctrl+W या Ctrl+F4 (बंद करना)"},"o":[{"en":"Ctrl+N (New), Ctrl+O (Open), Ctrl+S (Save), and Ctrl+W or Ctrl+F4 (Close)","hi":"Ctrl+N (नया), Ctrl+O (ओपन), Ctrl+S (सेव), और Ctrl+W या Ctrl+F4 (बंद करना)"},{"en":"Alt+N (New), Alt+O (Open), Alt+S (Save), and Alt+C (Close)","hi":"Alt+N, Alt+O, Alt+S और Alt+C"},{"en":"F1 (New), F2 (Open), F3 (Save), and F4 (Close)","hi":"F1, F2, F3 और F4"},{"en":"Shift+N (New), Shift+O (Open), Shift+S (Save), and Shift+W (Close)","hi":"Shift+N, Shift+O, Shift+S और Shift+W"}],"exp":{"en":"Like other Office apps, PowerPoint uses the universal shortcuts: Ctrl+N (New), Ctrl+O (Open), Ctrl+S (Save), and Ctrl+W or Ctrl+F4 (Close Window).","hi":"अन्य ऑफिस ऐप्स की तरह PowerPoint में भी New के लिए Ctrl+N, Open के लिए Ctrl+O, Save के लिए Ctrl+S, और वर्तमान फाइल को बंद (Close) करने के लिए Ctrl+W (या Ctrl+F4) का उपयोग होता है।"},"num":250},{"id":"q251","q":{"en":"What are the PowerPoint shortcuts for Undo, Redo, Print Preview, and Spelling check?","hi":"PowerPoint में Undo, Redo, प्रिंट प्रीव्यू (Print Preview) और स्पेलिंग चेक के शॉर्टकट क्या हैं?"},"a":{"en":"Ctrl+Z (Undo), Ctrl+Y (Redo), Ctrl+F2 (Print Preview), and F7 (Spelling)","hi":"Ctrl+Z (अनडू), Ctrl+Y (रीडू), Ctrl+F2 (प्रिंट प्रीव्यू), और F7 (स्पेलिंग)"},"o":[{"en":"Ctrl+Z (Undo), Ctrl+Y (Redo), Ctrl+F2 (Print Preview), and F7 (Spelling)","hi":"Ctrl+Z (अनडू), Ctrl+Y (रीडू), Ctrl+F2 (प्रिंट प्रीव्यू), और F7 (स्पेलिंग)"},{"en":"Ctrl+U (Undo), Ctrl+R (Redo), Ctrl+P (Print Preview), and F8 (Spelling)","hi":"Ctrl+U, Ctrl+R, Ctrl+P और F8"},{"en":"Alt+Z (Undo), Alt+Y (Redo), Alt+F2 (Print Preview), and F1 (Spelling)","hi":"Alt+Z, Alt+Y, Alt+F2 और F1"},{"en":"Shift+Z (Undo), Shift+Y (Redo), Shift+P (Print Preview), and F5 (Spelling)","hi":"Shift+Z, Shift+Y, Shift+P और F5"}],"exp":{"en":"Ctrl+Z reverses an action (Undo) and Ctrl+Y repeats/redoes it. Ctrl+F2 opens the Backstage Print preview pane. F7 starts the Spelling and Grammar check.","hi":"Undo के लिए Ctrl+Z, Redo के लिए Ctrl+Y, प्रिंट प्रीव्यू देखने के लिए Ctrl+F2, और स्पेलिंग/ग्रामर चेक करने के लिए F7 कुंजी का उपयोग किया जाता है।"},"num":251},{"id":"q252","q":{"en":"What are the actual actions of Ctrl+F, Ctrl+H, and Ctrl+Q in PowerPoint?","hi":"PowerPoint में Ctrl+F, Ctrl+H और Ctrl+Q के वास्तविक एक्शन क्या हैं?"},"a":{"en":"Ctrl+F is Find and Ctrl+H is Replace (in editing view); in current Windows lists, Ctrl+Q closes PowerPoint (Ctrl+S is used for Save)","hi":"Ctrl+F 'फाइंड' (Find) है और Ctrl+H 'रिप्लेस' (Replace) है (एडिटिंग व्यू में); वर्तमान विंडोज़ सूची में, Ctrl+Q पावरपॉइंट बंद (close) करता है (सेव/Save के लिए Ctrl+S का उपयोग होता है)"},"o":[{"en":"Ctrl+F is Find and Ctrl+H is Replace (in editing view); in current Windows lists, Ctrl+Q closes PowerPoint (Ctrl+S is used for Save)","hi":"Ctrl+F 'फाइंड' (Find) है और Ctrl+H 'रिप्लेस' (Replace) है (एडिटिंग व्यू में); वर्तमान विंडोज़ सूची में, Ctrl+Q पावरपॉइंट बंद (close) करता है (सेव/Save के लिए Ctrl+S का उपयोग होता है)"},{"en":"Ctrl+F formats text, Ctrl+H adds a hyperlink, and Ctrl+Q adds a quote","hi":"Ctrl+F टेक्स्ट फॉर्मेट करता है, Ctrl+H हाइपरलिंक जोड़ता है, और Ctrl+Q कोटेशन जोड़ता है"},{"en":"Ctrl+F folds a slide, Ctrl+H hides a slide, and Ctrl+Q quits a slide","hi":"Ctrl+F स्लाइड फोल्ड करता है, Ctrl+H स्लाइड छिपाता है, और Ctrl+Q स्लाइड से बाहर निकलता है"},{"en":"Ctrl+F opens fonts, Ctrl+H opens help, and Ctrl+Q opens queries","hi":"Ctrl+F फ़ॉन्ट खोलता है, Ctrl+H हेल्प खोलता है, और Ctrl+Q क्वेरीज़ खोलता है"}],"exp":{"en":"In Normal view, Ctrl+F opens the Find dialog and Ctrl+H opens the Replace dialog. In Microsoft's official current shortcut list, Ctrl+Q completely quits/closes PowerPoint.","hi":"एडिटिंग व्यू में Ctrl+F (Find) और Ctrl+H (Replace) के लिए होता है। Microsoft की वर्तमान शॉर्टकट सूची के अनुसार Ctrl+Q पूरे PowerPoint एप्लिकेशन को बंद (quit/close) कर देता है।"},"num":252},{"id":"q253","q":{"en":"What is the standard keyboard shortcut to insert a New Slide while editing in PowerPoint?","hi":"PowerPoint में एडिटिंग के दौरान नई स्लाइड (New slide) डालने का मानक कीबोर्ड शॉर्टकट क्या है?"},"a":{"en":"Ctrl+M","hi":"Ctrl+M"},"o":[{"en":"Ctrl+M","hi":"Ctrl+M"},{"en":"Ctrl+N","hi":"Ctrl+N"},{"en":"Alt+N","hi":"Alt+N"},{"en":"Shift+S","hi":"Shift+S"}],"exp":{"en":"In MS PowerPoint, pressing Ctrl+M inserts a new slide immediately after the currently selected slide. (Note: Ctrl+N creates a completely new presentation file).","hi":"PowerPoint में वर्तमान प्रेजेंटेशन के अंदर एक नई स्लाइड (New slide) जोड़ने के लिए Ctrl+M दबाया जाता है। (Ctrl+N से एक पूरी नई प्रेजेंटेशन फाइल खुल जाती है)।"},"num":253},{"id":"q254","q":{"en":"What category of software is Microsoft Access and what does it manage?","hi":"माइक्रोसॉफ्ट एक्सेस (Access) किस श्रेणी का सॉफ्टवेयर है और यह क्या मैनेज (प्रबंधित) करता है?"},"a":{"en":"It is a Relational Database Management System (RDBMS) that manages related tables, queries, forms, and reports","hi":"यह एक रिलेशनल डेटाबेस मैनेजमेंट सिस्टम (RDBMS) है, जो संबंधित तालिकाओं (tables), क्वेरीज़ (queries), फ़ॉर्म (forms) और रिपोर्ट (reports) को मैनेज करता है"},"o":[{"en":"It is a Relational Database Management System (RDBMS) that manages related tables, queries, forms, and reports","hi":"यह एक रिलेशनल डेटाबेस मैनेजमेंट सिस्टम (RDBMS) है, जो संबंधित तालिकाओं (tables), क्वेरीज़ (queries), फ़ॉर्म (forms) और रिपोर्ट (reports) को मैनेज करता है"},{"en":"It is a word processor that manages documents and letters","hi":"यह एक वर्ड प्रोसेसर है जो दस्तावेज़ों और पत्रों को मैनेज करता है"},{"en":"It is a spreadsheet program that manages formulas and charts","hi":"यह एक स्प्रेडशीट प्रोग्राम है जो फॉर्मूले और चार्ट मैनेज करता है"},{"en":"It is a video editor that manages media files and transitions","hi":"यह एक वीडियो एडिटर है जो मीडिया फाइलों और ट्रांज़िशन को मैनेज करता है"}],"exp":{"en":"Microsoft Access is an RDBMS tool designed for information management. It organizes data into tables, uses queries to extract info, forms for user data entry, and reports to format and print data.","hi":"Microsoft Access एक RDBMS (Relational Database Management System) है। यह बड़े डेटा को Tables में स्टोर करता है और Queries, Forms तथा Reports के ज़रिए उन्हें मैनेज करता है।"},"num":254},{"id":"q255","q":{"en":"What do a Table, Query, and Form do in an Access database?","hi":"एक्सेस (Access) डेटाबेस में टेबल (Table), क्वेरी (Query) और फॉर्म (Form) क्या करते हैं?"},"a":{"en":"A table stores records; a query retrieves or processes requested data; a form provides an interface to enter/edit records","hi":"टेबल रिकॉर्ड्स (records) स्टोर करती है; क्वेरी (query) अनुरोध किए गए डेटा को प्राप्त (retrieve) या प्रोसेस करती है; फॉर्म (form) रिकॉर्ड्स को एंटर/एडिट करने के लिए एक इंटरफ़ेस देता है"},"o":[{"en":"A table stores records; a query retrieves or processes requested data; a form provides an interface to enter/edit records","hi":"टेबल रिकॉर्ड्स (records) स्टोर करती है; क्वेरी (query) अनुरोध किए गए डेटा को प्राप्त (retrieve) या प्रोसेस करती है; फॉर्म (form) रिकॉर्ड्स को एंटर/एडिट करने के लिए एक इंटरफ़ेस देता है"},{"en":"A table creates charts; a query sends emails; a form prints the document","hi":"टेबल चार्ट बनाती है; क्वेरी ईमेल भेजती है; फॉर्म डॉक्यूमेंट प्रिंट करता है"},{"en":"A table checks spelling; a query creates macros; a form aligns text","hi":"टेबल स्पेलिंग चेक करती है; क्वेरी मैक्रो बनाती है; फॉर्म टेक्स्ट एलाइन करता है"},{"en":"There is no difference; all three just change font styles","hi":"कोई अंतर नहीं है; तीनों केवल फ़ॉन्ट स्टाइल बदलते हैं"}],"exp":{"en":"In Access: Tables hold the raw data rows/records. Queries ask questions to filter, sort, or join that data. Forms provide a user-friendly graphical screen for data entry and editing.","hi":"Access में: Table में सारा डेटा (रिकॉर्ड) सेव होता है। Query से आप अपनी ज़रूरत का खास डेटा खोज (फ़िल्टर) सकते हैं। Form से डेटा (रिकॉर्ड) को आसानी से देखने और टाइप करने (enter/edit) का डिज़ाइन मिलता है।"},"num":255},{"id":"q256","q":{"en":"Why are relationships created between tables in Microsoft Access?","hi":"Microsoft Access में तालिकाओं (tables) के बीच संबंध (relation) क्यों बनाए जाते हैं?"},"a":{"en":"To connect related data across different tables using common keys (e.g., linking a StudentID from a Student table to a Marks table)","hi":"कॉमन कीज़ (common keys) के माध्यम से अलग-अलग तालिकाओं में संबंधित डेटा को जोड़ने (connect) के लिए (जैसे Student टेबल से StudentID को Marks टेबल से लिंक करना)"},"o":[{"en":"To connect related data across different tables using common keys (e.g., linking a StudentID from a Student table to a Marks table)","hi":"कॉमन कीज़ (common keys) के माध्यम से अलग-अलग तालिकाओं में संबंधित डेटा को जोड़ने (connect) के लिए (जैसे Student टेबल से StudentID को Marks टेबल से लिंक करना)"},{"en":"To compress the database file size automatically","hi":"डेटाबेस फ़ाइल के आकार को स्वतः कम (compress) करने के लिए"},{"en":"To change the background color of the database","hi":"डेटाबेस का बैकग्राउंड रंग बदलने के लिए"},{"en":"To enable spelling and grammar checks on the data","hi":"डेटा पर स्पेलिंग और ग्रामर चेक को सक्षम करने के लिए"}],"exp":{"en":"Relational databases like Access use Relationships (Primary Keys linked to Foreign Keys) to connect normalized tables so that data doesn't have to be duplicated (e.g., connecting customer details to order history).","hi":"रिलेशनल डेटाबेस (Access) में अलग-अलग तालिकाओं (Tables) के बीच संबंध (Relationships) इसलिए बनाए जाते हैं ताकि एक कॉमन की (Common key/ID) के ज़रिए उनका डेटा आपस में जोड़ा जा सके।"},"num":256},{"id":"q257","q":{"en":"What is the database engine of Microsoft Access and what is its external data feature?","hi":"Microsoft Access का डेटाबेस इंजन क्या है और इसका 'बाहरी डेटा' (external data) फीचर क्या है?"},"a":{"en":"Access Database Engine (historically related to the Jet line); Access can import or link to external data","hi":"एक्सेस डेटाबेस इंजन (ऐतिहासिक रूप से 'Jet' लाइन से संबंधित); Access बाहरी डेटा को आयात (import) या लिंक (link) कर सकता है"},"o":[{"en":"Access Database Engine (historically related to the Jet line); Access can import or link to external data","hi":"एक्सेस डेटाबेस इंजन (ऐतिहासिक रूप से 'Jet' लाइन से संबंधित); Access बाहरी डेटा को आयात (import) या लिंक (link) कर सकता है"},{"en":"Oracle SQL Engine; it blocks all external data","hi":"ऑरेकल SQL इंजन; यह सभी बाहरी डेटा को ब्लॉक करता है"},{"en":"MySQL Engine; it only exports data to PDF","hi":"MySQL इंजन; यह केवल पीडीएफ (PDF) में डेटा निर्यात करता है"},{"en":"NoSQL Engine; it cannot connect to any external files","hi":"NoSQL इंजन; यह किसी बाहरी फाइल से कनेक्ट नहीं हो सकता"}],"exp":{"en":"Access runs on the Access Database Engine (formerly Microsoft Jet Database Engine) and has strong features to import from, or link directly to, external data sources like Excel, SQL Server, or text files.","hi":"Access में 'Access Database Engine' (पुराना नाम Microsoft Jet) का उपयोग होता है। इसका एक प्रमुख फीचर यह है कि यह बाहरी डेटा (जैसे Excel या SQL) को इम्पोर्ट (import) कर सकता है या सीधे लिंक कर सकता है।"},"num":257}]},{"title":{"en":"12. Exam Trap Reverse-Questions","hi":"12. परीक्षा के महत्वपूर्ण उल्टे प्रश्न"},"questions":[{"id":"q258","q":{"en":"If you need to personalize a similar letter for 200 different recipients, which Word feature should you use?","hi":"यदि आपको 200 अलग-अलग प्राप्तकर्ताओं के लिए एक जैसे पत्र को वैयक्तिकृत (personalize) करना है, तो आप किस Word फीचर का उपयोग करेंगे?"},"a":{"en":"Mail Merge","hi":"मेल मर्ज (Mail Merge)"},"o":[{"en":"Mail Merge","hi":"मेल मर्ज (Mail Merge)"},{"en":"Drop Cap","hi":"ड्रॉप कैप (Drop Cap)"},{"en":"Thesaurus","hi":"थिसॉरस (Thesaurus)"},{"en":"Watermark","hi":"वॉटरमार्क (Watermark)"}],"exp":{"en":"Mail Merge is specifically designed for generating mass mailings (letters, emails, labels) customized for multiple recipients using a single template and a data source.","hi":"एक ही पत्र (Letter) को कई अलग-अलग लोगों के नाम और पते के साथ एक साथ तैयार करने के लिए 'मेल मर्ज' (Mail Merge) का उपयोग किया जाता है।"},"num":258},{"id":"q259","q":{"en":"Which feature makes the first letter of a paragraph display significantly larger, dropping down across multiple lines?","hi":"कौन-सा फीचर किसी पैराग्राफ के पहले अक्षर को काफी बड़ा दिखाता है, जो कई लाइनों तक नीचे फैला होता है?"},"a":{"en":"Drop Cap","hi":"ड्रॉप कैप (Drop Cap)"},"o":[{"en":"Drop Cap","hi":"ड्रॉप कैप (Drop Cap)"},{"en":"Subscript","hi":"सबस्क्रिप्ट (Subscript)"},{"en":"Strikethrough","hi":"स्ट्राइकथ्रू (Strikethrough)"},{"en":"Page Margin","hi":"पेज मार्जिन (Page Margin)"}],"exp":{"en":"A Drop Cap is a large initial capital letter at the start of a block of text that spans the depth of two or more lines of regular text.","hi":"पैराग्राफ के पहले अक्षर को बड़ा (enlarged) करके कई लाइनों तक विस्तारित करने वाले फीचर को 'ड्रॉप कैप' (Drop Cap) कहते हैं।"},"num":259},{"id":"q260","q":{"en":"If you want a page to be wider than it is tall and require extra space on one side for binding, which settings will you apply?","hi":"यदि आप चाहते हैं कि पेज अपनी लंबाई से अधिक चौड़ा (wide) हो और बाइंडिंग (binding) के लिए एक तरफ अतिरिक्त जगह चाहिए, तो आप कौन-सी सेटिंग्स लागू करेंगे?"},"a":{"en":"Landscape orientation and a Gutter margin","hi":"लैंडस्केप ओरिएंटेशन (Landscape orientation) और गटर मार्जिन (Gutter margin)"},"o":[{"en":"Landscape orientation and a Gutter margin","hi":"लैंडस्केप ओरिएंटेशन (Landscape orientation) और गटर मार्जिन (Gutter margin)"},{"en":"Portrait orientation and a Page border","hi":"पोर्ट्रेट ओरिएंटेशन और एक पेज बॉर्डर"},{"en":"Double line spacing and a Center alignment","hi":"डबल लाइन स्पेसिंग और सेंटर अलाइनमेंट"},{"en":"Draft view and a Watermark","hi":"ड्राफ्ट व्यू और वॉटरमार्क"}],"exp":{"en":"Landscape orientation makes the page horizontal (wider), and a Gutter margin adds extra whitespace to the edge to accommodate physical binding/stapling.","hi":"पेज को चौड़ा (क्षैतिज) बनाने के लिए 'Landscape' ओरिएंटेशन और किताब की बाइंडिंग के लिए छोड़े गए अतिरिक्त स्थान के लिए 'Gutter margin' (गटर मार्जिन) का उपयोग होता है।"},"num":260},{"id":"q261","q":{"en":"Which two tools respectively suggest synonyms for a word and record edits made by a collaborator?","hi":"कौन-से दो टूल क्रमशः किसी शब्द के लिए पर्यायवाची (synonyms) सुझाते हैं और किसी सहयोगी द्वारा किए गए संपादनों (edits) को रिकॉर्ड करते हैं?"},"a":{"en":"Thesaurus and Track Changes","hi":"थिसॉरस (Thesaurus) और ट्रैक चेंजेस (Track Changes)"},"o":[{"en":"Thesaurus and Track Changes","hi":"थिसॉरस (Thesaurus) और ट्रैक चेंजेस (Track Changes)"},{"en":"Grammar Check and Mail Merge","hi":"ग्रामर चेक और मेल मर्ज"},{"en":"Word Count and Macro","hi":"वर्ड काउंट और मैक्रो"},{"en":"Format Painter and Undo","hi":"फॉर्मेट पेंटर और अनडू"}],"exp":{"en":"The Thesaurus provides synonyms. Track Changes is the collaborative tool that logs all document insertions, deletions, and formatting changes.","hi":"पर्यायवाची शब्द (Synonyms) खोजने के लिए 'थिसॉरस' (Thesaurus) और डॉक्यूमेंट में किए गए बदलावों (Edits) का रिकॉर्ड रखने के लिए 'ट्रैक चेंजेस' (Track Changes) का उपयोग होता है।"},"num":261},{"id":"q262","q":{"en":"What does the 'F2' key do in Word, Excel, and File Explorer respectively?","hi":"Word, Excel और File Explorer में 'F2' कुंजी क्रमशः क्या करती है?"},"a":{"en":"Word: moves selected content; Excel: edits the active cell; File Explorer: renames the selected item","hi":"Word: सेलेक्ट किए गए कंटेंट को मूव (Cut/Move) करता है; Excel: एक्टिव सेल को एडिट करता है; फाइल एक्सप्लोरर: सेलेक्ट किए गए आइटम का नाम बदलता (rename) है"},"o":[{"en":"Word: moves selected content; Excel: edits the active cell; File Explorer: renames the selected item","hi":"Word: सेलेक्ट किए गए कंटेंट को मूव (Cut/Move) करता है; Excel: एक्टिव सेल को एडिट करता है; फाइल एक्सप्लोरर: सेलेक्ट किए गए आइटम का नाम बदलता (rename) है"},{"en":"Word: saves the file; Excel: deletes the cell; File Explorer: creates a folder","hi":"Word: फाइल सेव करता है; Excel: सेल डिलीट करता है; फाइल एक्सप्लोरर: फोल्डर बनाता है"},{"en":"Word: prints the file; Excel: adds a chart; File Explorer: opens Help","hi":"Word: प्रिंट करता है; Excel: चार्ट जोड़ता है; फाइल एक्सप्लोरर: हेल्प खोलता है"},{"en":"Word: opens the font dialog; Excel: sorts data; File Explorer: copies the file","hi":"Word: फ़ॉन्ट डायलॉग खोलता है; Excel: डेटा सॉर्ट करता है; फाइल एक्सप्लोरर: फाइल कॉपी करता है"}],"exp":{"en":"The F2 key is highly context-dependent. In Word, it cuts text for moving. In Excel, it enters cell edit mode. In Windows Explorer, it initiates file renaming.","hi":"F2 कुंजी के कार्य: Word में यह सेलेक्ट किए गए टेक्स्ट को मूव (Move) करने के लिए है। Excel में यह सेल के अंदर डेटा को एडिट (Edit) करने के लिए है। विंडोज़/फाइल एक्सप्लोरर में यह फाइल का नाम (Rename) बदलने के लिए है।"},"num":262},{"id":"q263","q":{"en":"What does 'Ctrl+D' do in Word, Excel, and a web browser respectively?","hi":"Word, Excel और वेब ब्राउज़र में 'Ctrl+D' क्रमशः क्या करता है?"},"a":{"en":"Word: opens Font dialog; Excel: executes Fill Down; Browser: bookmarks the current page","hi":"Word: फ़ॉन्ट डायलॉग खोलता है; Excel: 'फ़िल डाउन' (Fill Down) करता है; ब्राउज़र: वर्तमान पेज को बुकमार्क करता है"},"o":[{"en":"Word: opens Font dialog; Excel: executes Fill Down; Browser: bookmarks the current page","hi":"Word: फ़ॉन्ट डायलॉग खोलता है; Excel: 'फ़िल डाउन' (Fill Down) करता है; ब्राउज़र: वर्तमान पेज को बुकमार्क करता है"},{"en":"Word: deletes a paragraph; Excel: deletes a cell; Browser: deletes history","hi":"Word: पैराग्राफ डिलीट करता है; Excel: सेल डिलीट करता है; ब्राउज़र: हिस्ट्री डिलीट करता है"},{"en":"Word: opens the Design tab; Excel: opens the Data tab; Browser: opens Downloads","hi":"Word: डिज़ाइन टैब खोलता है; Excel: डेटा टैब खोलता है; ब्राउज़र: डाउनलोड्स खोलता है"},{"en":"Word: doubles the spacing; Excel: divides numbers; Browser: refreshes the page","hi":"Word: स्पेसिंग डबल करता है; Excel: संख्याएँ विभाजित करता है; ब्राउज़र: पेज रिफ्रेश करता है"}],"exp":{"en":"Ctrl+D opens Font properties in Word, copies the top cell downwards in Excel (Fill Down), and adds the active tab to favorites/bookmarks in web browsers.","hi":"Ctrl+D के कार्य: Word में यह फ़ॉन्ट डायलॉग बॉक्स खोलता है। Excel में यह ऊपर वाली सेल का डेटा नीचे कॉपी (Fill Down) करता है। क्रोम जैसे ब्राउज़र में यह वर्तमान पेज को बुकमार्क करता है।"},"num":263},{"id":"q264","q":{"en":"How does 'Ctrl+R' differ in Word and Excel?","hi":"Word और Excel में 'Ctrl+R' कैसे अलग है?"},"a":{"en":"Word: aligns text to the Right; Excel: executes Fill Right","hi":"Word: टेक्स्ट को दाएँ (Right) एलाइन करता है; Excel: 'फ़िल राइट' (Fill Right) करता है"},"o":[{"en":"Word: aligns text to the Right; Excel: executes Fill Right","hi":"Word: टेक्स्ट को दाएँ (Right) एलाइन करता है; Excel: 'फ़िल राइट' (Fill Right) करता है"},{"en":"Word: opens the Review tab; Excel: recalculates formulas","hi":"Word: रिव्यू टैब खोलता है; Excel: फॉर्मूले रीकैलकुलेट करता है"},{"en":"Word: removes text; Excel: removes cells","hi":"Word: टेक्स्ट हटाता है; Excel: सेल्स हटाता है"},{"en":"Word: reads aloud; Excel: rounds numbers","hi":"Word: ज़ोर से पढ़ता है (read aloud); Excel: संख्याओं को राउंड (round) करता है"}],"exp":{"en":"In Word, Ctrl+R applies Right Alignment to a paragraph. In Excel, Ctrl+R copies the leftmost cell in a selection to the cells to its right (Fill Right).","hi":"Word में Ctrl+R का उपयोग पैराग्राफ को दायीं ओर (Right Align) खिसकाने के लिए होता है, जबकि Excel में यह सबसे बायीं सेल का डेटा दायीं ओर की सेल्स में कॉपी (Fill Right) करता है।"},"num":264},{"id":"q265","q":{"en":"What is the exam cue for 'F5' in Word, Excel, PowerPoint, and web browsers?","hi":"Word, Excel, PowerPoint और वेब ब्राउज़र्स में 'F5' कुंजी का क्या कार्य है?"},"a":{"en":"Word/Excel: Go To dialog; PowerPoint: start slide show; Browser: refresh the page","hi":"Word/Excel: 'गो टू' (Go To) डायलॉग; PowerPoint: स्लाइड शो शुरू करता है; ब्राउज़र: पेज को रिफ्रेश करता है"},"o":[{"en":"Word/Excel: Go To dialog; PowerPoint: start slide show; Browser: refresh the page","hi":"Word/Excel: 'गो टू' (Go To) डायलॉग; PowerPoint: स्लाइड शो शुरू करता है; ब्राउज़र: पेज को रिफ्रेश करता है"},{"en":"Word/Excel: Find dialog; PowerPoint: End show; Browser: back button","hi":"Word/Excel: फाइंड डायलॉग; PowerPoint: शो समाप्त करता है; ब्राउज़र: बैक बटन"},{"en":"Word/Excel: Save file; PowerPoint: Insert chart; Browser: open new tab","hi":"Word/Excel: फाइल सेव करता है; PowerPoint: चार्ट डालता है; ब्राउज़र: नया टैब खोलता है"},{"en":"Word/Excel: Print preview; PowerPoint: Next slide; Browser: bookmark","hi":"Word/Excel: प्रिंट प्रीव्यू; PowerPoint: अगली स्लाइड; ब्राउज़र: बुकमार्क"}],"exp":{"en":"F5 launches the 'Go To' dialog in Word and Excel. In PowerPoint, it starts the slideshow from Slide 1. In standard web browsers, it reloads/refreshes the active page.","hi":"F5 कुंजी के कार्य: Word और Excel में इससे 'Go To' डायलॉग खुलता है। PowerPoint में यह पहली स्लाइड से स्लाइड शो शुरू करता है। वेब ब्राउज़र में यह पेज को रिफ्रेश (रीलोड) करता है।"},"num":265},{"id":"q266","q":{"en":"What is the difference between 'F9' in Word and 'F9' in Excel?","hi":"Word के 'F9' और Excel के 'F9' में क्या अंतर है?"},"a":{"en":"Word: updates selected fields; Excel: recalculates all open workbooks","hi":"Word: चयनित फील्ड्स (selected fields) को अपडेट करता है; Excel: सभी खुली वर्कबुक्स की फिर से गणना (recalculate) करता है"},"o":[{"en":"Word: updates selected fields; Excel: recalculates all open workbooks","hi":"Word: चयनित फील्ड्स (selected fields) को अपडेट करता है; Excel: सभी खुली वर्कबुक्स की फिर से गणना (recalculate) करता है"},{"en":"Word: saves the file; Excel: sorts data","hi":"Word: फाइल सेव करता है; Excel: डेटा सॉर्ट करता है"},{"en":"Word: inserts a table; Excel: inserts a chart","hi":"Word: टेबल डालता है; Excel: चार्ट डालता है"},{"en":"Word: checks spelling; Excel: formats cells","hi":"Word: स्पेलिंग चेक करता है; Excel: सेल फॉर्मेट करता है"}],"exp":{"en":"In Word, F9 updates dynamic field codes (like TOCs or formula fields). In Excel, F9 triggers a manual calculation of all formulas in the application.","hi":"Word में F9 कुंजी चयनित डायनामिक फील्ड्स (जैसे इंडेक्स या डेट) को अपडेट (Update) करती है। Excel में F9 कुंजी सभी खुली हुई फाइलों के फॉर्मूलों की फिर से गणना (Recalculate) करती है।"},"num":266},{"id":"q267","q":{"en":"What is the syntax for a mixed reference locking only the column, a mixed reference locking only the row, and an absolute reference locking both in Excel?","hi":"Excel में केवल कॉलम लॉक करने वाले मिक्स्ड रिफरेन्स, केवल रो लॉक करने वाले मिक्स्ड रिफरेन्स, और दोनों को लॉक करने वाले एब्सोल्यूट रिफरेन्स का सिंटैक्स (syntax) क्या है?"},"a":{"en":"$A1 (column lock), A$1 (row lock), and $A$1 (both locked)","hi":"$A1 (कॉलम लॉक), A$1 (रो लॉक), और $A$1 (दोनों लॉक)"},"o":[{"en":"$A1 (column lock), A$1 (row lock), and $A$1 (both locked)","hi":"$A1 (कॉलम लॉक), A$1 (रो लॉक), और $A$1 (दोनों लॉक)"},{"en":"A1 (column lock), $A$1 (row lock), and A$1 (both locked)","hi":"A1 (कॉलम लॉक), $A$1 (रो लॉक), और A$1 (दोनों लॉक)"},{"en":"A$1 (column lock), $A1 (row lock), and A1 (both locked)","hi":"A$1 (कॉलम लॉक), $A1 (रो लॉक), और A1 (दोनों लॉक)"},{"en":"$A$1 (column lock), A1 (row lock), and $A1 (both locked)","hi":"$A$1 (कॉलम लॉक), A1 (रो लॉक), और $A1 (दोनों लॉक)"}],"exp":{"en":"The dollar sign ($) fixes the coordinate that immediately follows it. $A1 locks column A. A$1 locks row 1. $A$1 locks both, making it an absolute reference.","hi":"डॉलर ($) का चिह्न जिसे पहले लगाया जाता है, वह लॉक हो जाता है। $A1 में कॉलम A लॉक है। A$1 में रो 1 लॉक है। $A$1 (Absolute reference) में कॉलम और रो दोनों लॉक हैं।"},"num":267},{"id":"q268","q":{"en":"Which of the following correctly pairs the method for a fixed date entry and a recalculating current date in Excel?","hi":"Excel में फिक्स्ड (fixed) डेट एंट्री और रीकैलकुलेट (recalculate) होने वाली वर्तमान डेट का सही मिलान कौन-सा है?"},"a":{"en":"Ctrl+; inputs a fixed date; TODAY() inputs a recalculating current date","hi":"Ctrl+; एक फिक्स्ड (स्थिर) डेट डालता है; TODAY() एक रीकैलकुलेट होने वाली (बदलने वाली) वर्तमान डेट डालता है"},"o":[{"en":"Ctrl+; inputs a fixed date; TODAY() inputs a recalculating current date","hi":"Ctrl+; एक फिक्स्ड (स्थिर) डेट डालता है; TODAY() एक रीकैलकुलेट होने वाली (बदलने वाली) वर्तमान डेट डालता है"},{"en":"Ctrl+T inputs a fixed date; DATE() inputs a recalculating date","hi":"Ctrl+T फिक्स्ड डेट डालता है; DATE() रीकैलकुलेट होने वाली डेट डालता है"},{"en":"Alt+D inputs a fixed date; NOW() inputs a fixed time","hi":"Alt+D फिक्स्ड डेट डालता है; NOW() फिक्स्ड टाइम डालता है"},{"en":"Shift+; inputs a fixed date; MONTH() inputs a recalculating date","hi":"Shift+; फिक्स्ड डेट डालता है; MONTH() रीकैलकुलेट होने वाली डेट डालता है"}],"exp":{"en":"Ctrl+; inserts a static time-stamp text of today's date. =TODAY() inserts a volatile function that updates to the current system date whenever the sheet calculates.","hi":"शॉर्टकट Ctrl+; दबाने से आज की तारीख टाइप हो जाती है जो फिक्स्ड (स्थिर) रहती है। जबकि =TODAY() फॉर्मूला लगाने से तारीख अपने आप सिस्टम के अनुसार बदलती (अपडेट होती) रहती है।"},"num":268},{"id":"q269","q":{"en":"Which Excel functions count cells matching a criterion and sum values matching a criterion respectively?","hi":"Excel में कौन-से फंक्शन क्रमशः किसी मानदंड (criterion) से मेल खाने वाली सेल्स को गिनते (count) हैं और मेल खाने वाले मानों को जोड़ते (sum) हैं?"},"a":{"en":"COUNTIF counts matching cells; SUMIF sums matching values","hi":"COUNTIF मेल खाने वाली सेल्स को गिनता है; SUMIF मेल खाने वाले मानों को जोड़ता है"},"o":[{"en":"COUNTIF counts matching cells; SUMIF sums matching values","hi":"COUNTIF मेल खाने वाली सेल्स को गिनता है; SUMIF मेल खाने वाले मानों को जोड़ता है"},{"en":"COUNT sums matching values; SUM counts matching cells","hi":"COUNT मेल खाने वाले मानों को जोड़ता है; SUM मेल खाने वाली सेल्स को गिनता है"},{"en":"MATCH counts matching cells; ADD sums matching values","hi":"MATCH मेल खाने वाली सेल्स को गिनता है; ADD मेल खाने वाले मानों को जोड़ता है"},{"en":"FIND counts matching cells; TOTAL sums matching values","hi":"FIND मेल खाने वाली सेल्स को गिनता है; TOTAL मेल खाने वाले मानों को जोड़ता है"}],"exp":{"en":"COUNTIF evaluates a range and tallies how many cells meet a specific condition. SUMIF evaluates a range and adds the numbers in cells that meet a specific condition.","hi":"शर्त (criteria) के आधार पर केवल कुछ विशेष सेल्स की गिनती करने के लिए COUNTIF का उपयोग होता है, और शर्त के आधार पर उनका योग (Total) निकालने के लिए SUMIF का उपयोग होता है।"},"num":269},{"id":"q270","q":{"en":"Which Excel functions perform an exact case-sensitive text check and find the relative position of a lookup value respectively?","hi":"Excel में कौन-से फंक्शन क्रमशः एक सटीक केस-सेंसिटिव (case-sensitive) टेक्स्ट चेक करते हैं और खोजी गई वैल्यू (lookup value) की सापेक्ष स्थिति (relative position) ज्ञात करते हैं?"},"a":{"en":"EXACT for case-sensitive text check; MATCH for lookup position","hi":"केस-सेंसिटिव टेक्स्ट चेक के लिए EXACT; लुकअप पोज़िशन (स्थिति) के लिए MATCH"},"o":[{"en":"EXACT for case-sensitive text check; MATCH for lookup position","hi":"केस-सेंसिटिव टेक्स्ट चेक के लिए EXACT; लुकअप पोज़िशन (स्थिति) के लिए MATCH"},{"en":"CHECK for case-sensitive text check; FIND for lookup position","hi":"केस-सेंसिटिव टेक्स्ट चेक के लिए CHECK; लुकअप पोज़िशन के लिए FIND"},{"en":"EQUAL for case-sensitive text check; SEARCH for lookup position","hi":"केस-सेंसिटिव टेक्स्ट चेक के लिए EQUAL; लुकअप पोज़िशन के लिए SEARCH"},{"en":"PROPER for case-sensitive text check; INDEX for lookup position","hi":"केस-सेंसिटिव टेक्स्ट चेक के लिए PROPER; लुकअप पोज़िशन के लिए INDEX"}],"exp":{"en":"EXACT compares two text strings strictly (including uppercase/lowercase differences). MATCH looks for an item in a range and returns its numerical position.","hi":"दो टेक्स्ट (शब्दों) के बीच केस-सेंसिटिव (छोटे-बड़े अक्षरों का ध्यान रखते हुए) तुलना करने के लिए EXACT का उपयोग होता है। किसी रेंज में कोई वैल्यू किस नंबर (Position) पर है, यह जानने के लिए MATCH का उपयोग होता है।"},"num":270},{"id":"q271","q":{"en":"What are the keyboard shortcuts for inserting an embedded chart on the current sheet and a chart on a separate chart sheet respectively?","hi":"क्रमशः वर्तमान शीट पर एक एम्बेडेड (embedded) चार्ट डालने और एक अलग चार्ट शीट (separate chart sheet) पर चार्ट डालने के कीबोर्ड शॉर्टकट क्या हैं?"},"a":{"en":"Alt+F1 creates an embedded chart; F11 creates a separate chart sheet","hi":"Alt+F1 एम्बेडेड चार्ट बनाता है; F11 अलग चार्ट शीट बनाता है"},"o":[{"en":"Alt+F1 creates an embedded chart; F11 creates a separate chart sheet","hi":"Alt+F1 एम्बेडेड चार्ट बनाता है; F11 अलग चार्ट शीट बनाता है"},{"en":"F11 creates an embedded chart; Alt+F1 creates a separate chart sheet","hi":"F11 एम्बेडेड चार्ट बनाता है; Alt+F1 अलग चार्ट शीट बनाता है"},{"en":"Ctrl+F1 creates an embedded chart; Shift+F11 creates a separate chart sheet","hi":"Ctrl+F1 एम्बेडेड चार्ट बनाता है; Shift+F11 अलग चार्ट शीट बनाता है"},{"en":"Alt+C creates an embedded chart; Ctrl+C creates a separate chart sheet","hi":"Alt+C एम्बेडेड चार्ट बनाता है; Ctrl+C अलग चार्ट शीट बनाता है"}],"exp":{"en":"Alt+F1 builds a default chart as a floating object on the active worksheet. F11 takes the same data and builds a default chart on a brand-new, dedicated Chart tab.","hi":"उसी वर्कशीट (एक्टिव शीट) पर डेटा का चार्ट (एम्बेडेड चार्ट) बनाने के लिए Alt+F1 का उपयोग होता है। जबकि पूरी तरह से एक नई अलग 'चार्ट शीट' बनाने के लिए F11 का उपयोग किया जाता है।"},"num":271},{"id":"q272","q":{"en":"What is the difference between an effect that occurs 'between slides' and one that occurs 'within a slide' in PowerPoint?","hi":"PowerPoint में 'स्लाइडों के बीच' (between slides) होने वाले इफ़ेक्ट और 'एक स्लाइड के भीतर' (within a slide) होने वाले इफ़ेक्ट में क्या अंतर है?"},"a":{"en":"A transition occurs between slides; an animation occurs within a slide (on specific objects)","hi":"एक ट्रांज़िशन (transition) स्लाइडों के बीच होता है; एक एनीमेशन (animation) एक स्लाइड के भीतर (विशिष्ट ऑब्जेक्ट्स पर) होता है"},"o":[{"en":"A transition occurs between slides; an animation occurs within a slide (on specific objects)","hi":"एक ट्रांज़िशन (transition) स्लाइडों के बीच होता है; एक एनीमेशन (animation) एक स्लाइड के भीतर (विशिष्ट ऑब्जेक्ट्स पर) होता है"},{"en":"An animation occurs between slides; a transition occurs within a slide","hi":"एक एनीमेशन स्लाइडों के बीच होता है; एक ट्रांज़िशन एक स्लाइड के भीतर होता है"},{"en":"A transition changes the slide layout; an animation changes the text font","hi":"एक ट्रांज़िशन स्लाइड लेआउट बदलता है; एक एनीमेशन टेक्स्ट फ़ॉन्ट बदलता है"},{"en":"There is no difference; both terms refer to inserting videos","hi":"कोई अंतर नहीं है; दोनों शब्दों का अर्थ वीडियो डालना है"}],"exp":{"en":"Transitions are the visual movements applied when moving from one slide to the next. Animations are applied to individual text boxes, shapes, or pictures on a single slide.","hi":"स्लाइड शो के दौरान एक स्लाइड से दूसरी स्लाइड पर जाने के विज़ुअल इफ़ेक्ट को 'ट्रांज़िशन' (Transition) कहते हैं। जबकि किसी एक स्लाइड के अंदर के टेक्स्ट या पिक्चर के हिलने-डुलने के इफ़ेक्ट को 'एनीमेशन' (Animation) कहते हैं।"},"num":272},{"id":"q273","q":{"en":"What are the modern (XML-based, non-macro) counterparts of the legacy file extensions XLS, DOC, and PPT?","hi":"लीगेसी फाइल एक्सटेंशन XLS, DOC और PPT के आधुनिक (XML-आधारित, गैर-मैक्रो) समकक्ष (counterparts) क्या हैं?"},"a":{"en":"XLSX, DOCX, and PPTX","hi":"XLSX, DOCX और PPTX"},"o":[{"en":"XLSX, DOCX, and PPTX","hi":"XLSX, DOCX और PPTX"},{"en":"XLSB, DOCM, and PPTM","hi":"XLSB, DOCM और PPTM"},{"en":"XLSM, DOCX, and PPTS","hi":"XLSM, DOCX और PPTS"},{"en":"XLST, DOCT, and PPTT","hi":"XLST, DOCT और PPTT"}],"exp":{"en":"Starting with Office 2007, Microsoft switched to the Office Open XML formats. The standard non-macro extensions append an 'X': .docx for Word, .xlsx for Excel, and .pptx for PowerPoint.","hi":"Office 2007 के बाद से Microsoft ने 'X' (XML-आधारित) एक्सटेंशन का उपयोग शुरू किया। इसलिए पुराने .xls, .doc और .ppt अब मानक रूप से क्रमशः .xlsx, .docx और .pptx हो गए हैं।"},"num":273},{"id":"q274","q":{"en":"How do Access and Excel differ regarding structured records and grid-based calculations?","hi":"संरचित रिकॉर्ड्स (structured records) और ग्रिड-आधारित गणनाओं (grid-based calculations) के संबंध में Access और Excel में क्या अंतर है?"},"a":{"en":"Access is used for structured relational databases (records); Excel is used for grid-based spreadsheet calculations","hi":"एक्सेस (Access) का उपयोग संरचित रिलेशनल डेटाबेस (रिकॉर्ड्स) के लिए किया जाता है; एक्सेल (Excel) का उपयोग ग्रिड-आधारित स्प्रेडशीट गणनाओं (calculations) के लिए किया जाता है"},"o":[{"en":"Access is used for structured relational databases (records); Excel is used for grid-based spreadsheet calculations","hi":"एक्सेस (Access) का उपयोग संरचित रिलेशनल डेटाबेस (रिकॉर्ड्स) के लिए किया जाता है; एक्सेल (Excel) का उपयोग ग्रिड-आधारित स्प्रेडशीट गणनाओं (calculations) के लिए किया जाता है"},{"en":"Access is for grid-based calculations; Excel is for relational databases","hi":"एक्सेस ग्रिड-आधारित गणनाओं के लिए है; एक्सेल रिलेशनल डेटाबेस के लिए है"},{"en":"Access creates slide shows; Excel writes documents","hi":"एक्सेस स्लाइड शो बनाता है; एक्सेल दस्तावेज़ लिखता है"},{"en":"There is no difference; both are primarily word processors","hi":"कोई अंतर नहीं है; दोनों मुख्य रूप से वर्ड प्रोसेसर हैं"}],"exp":{"en":"Excel is a spreadsheet designed for freeform data analysis, number crunching, and charting on a grid. Access is a Relational Database Management System (RDBMS) for storing rigid, structured tables of records and querying them.","hi":"Access एक रिलेशनल डेटाबेस (RDBMS) है जहाँ डेटा (रिकॉर्ड्स) को अलग-अलग टेबल्स में स्ट्रक्चर्ड (व्यवस्थित) तरीके से रखा जाता है। Excel एक स्प्रेडशीट है जो मुख्य रूप से ग्रिड (रो/कॉलम) पर गणितीय गणनाओं (calculations) और डेटा एनालिसिस के काम आता है।"},"num":274}]},{"title":{"en":"13. Rapid-Fire Final Revision","hi":"13. त्वरित अंतिम पुनरावृत्ति"},"questions":[{"id":"q275","q":{"en":"What is the release cue for the introduction of the Office Ribbon?","hi":"ऑफिस रिबन (Office Ribbon) के परिचय (introduction) का रिलीज़ संकेत क्या है?"},"a":{"en":"Office 2007","hi":"ऑफिस 2007"},"o":[{"en":"Office 2007","hi":"ऑफिस 2007"},{"en":"Office 2003","hi":"ऑफिस 2003"},{"en":"Office 2010","hi":"ऑफिस 2010"},{"en":"Office 2016","hi":"ऑफिस 2016"}],"exp":{"en":"The Ribbon user interface debuted in Microsoft Office 2007.","hi":"Microsoft Office में रिबन (Ribbon) इंटरफ़ेस पहली बार Office 2007 में पेश किया गया था।"},"num":275},{"id":"q276","q":{"en":"What was the default font and size in Word 2010?","hi":"Word 2010 में डिफ़ॉल्ट फ़ॉन्ट और साइज़ क्या था?"},"a":{"en":"Calibri 11 pt","hi":"Calibri 11 pt"},"o":[{"en":"Calibri 11 pt","hi":"Calibri 11 pt"},{"en":"Times New Roman 12 pt","hi":"Times New Roman 12 pt"},{"en":"Arial 10 pt","hi":"Arial 10 pt"},{"en":"Aptos 11 pt","hi":"Aptos 11 pt"}],"exp":{"en":"The default font in Word 2010 was Calibri at 11 points.","hi":"Word 2010 का डिफ़ॉल्ट फ़ॉन्ट Calibri और साइज़ 11 pt था।"},"num":276},{"id":"q277","q":{"en":"Under which Word tabs do you find Margins, Watermark, and Mail Merge respectively?","hi":"Word में Margins, Watermark और Mail Merge क्रमशः किन टैब्स के अंतर्गत मिलते हैं?"},"a":{"en":"Layout, Design, and Mailings","hi":"लेआउट (Layout), डिज़ाइन (Design) और मेलिंग्स (Mailings)"},"o":[{"en":"Layout, Design, and Mailings","hi":"लेआउट (Layout), डिज़ाइन (Design) और मेलिंग्स (Mailings)"},{"en":"Insert, Home, and Review","hi":"इंसर्ट, होम और रिव्यू"},{"en":"View, Insert, and References","hi":"व्यू, इंसर्ट और रेफरेंसेस"},{"en":"Design, Layout, and View","hi":"डिज़ाइन, लेआउट और व्यू"}],"exp":{"en":"Margins are in Layout, Watermark is in Design, and Mail Merge is in Mailings.","hi":"मार्जिन सेटिंग्स Layout टैब में, वॉटरमार्क Design टैब में, और मेल मर्ज Mailings टैब में मिलते हैं।"},"num":277},{"id":"q278","q":{"en":"What is the keyboard shortcut to insert a hyperlink in Word?","hi":"Word में हाइपरलिंक (hyperlink) डालने का कीबोर्ड शॉर्टकट क्या है?"},"a":{"en":"Ctrl+K","hi":"Ctrl+K"},"o":[{"en":"Ctrl+K","hi":"Ctrl+K"},{"en":"Ctrl+H","hi":"Ctrl+H"},{"en":"Ctrl+L","hi":"Ctrl+L"},{"en":"Alt+K","hi":"Alt+K"}],"exp":{"en":"Ctrl+K opens the Insert Hyperlink dialog box.","hi":"किसी भी टेक्स्ट पर हाइपरलिंक (Hyperlink) लगाने के लिए Ctrl+K का उपयोग किया जाता है।"},"num":278},{"id":"q279","q":{"en":"What do Ctrl+1, Ctrl+2, and Ctrl+5 do in MS Word?","hi":"MS Word में Ctrl+1, Ctrl+2 और Ctrl+5 क्या करते हैं?"},"a":{"en":"Apply single, double, and 1.5 line spacing respectively","hi":"क्रमशः सिंगल (single), डबल (double) और 1.5 लाइन स्पेसिंग लागू करते हैं"},"o":[{"en":"Apply single, double, and 1.5 line spacing respectively","hi":"क्रमशः सिंगल (single), डबल (double) और 1.5 लाइन स्पेसिंग लागू करते हैं"},{"en":"Apply Heading 1, 2, and 3","hi":"Heading 1, 2 और 3 लागू करते हैं"},{"en":"Open file, Save file, Print file","hi":"फाइल खोलते हैं, सेव करते हैं, प्रिंट करते हैं"},{"en":"Zoom to 100%, 200%, 500%","hi":"100%, 200%, 500% तक ज़ूम करते हैं"}],"exp":{"en":"Ctrl+1 = Single space; Ctrl+2 = Double space; Ctrl+5 = 1.5 space.","hi":"Word में लाइन स्पेसिंग के लिए: Ctrl+1 (Single), Ctrl+2 (Double), और Ctrl+5 (1.5 लाइन) शॉर्टकट हैं।"},"num":279},{"id":"q280","q":{"en":"What are the shortcuts for a line break, page break, and column break in Word?","hi":"Word में लाइन ब्रेक, पेज ब्रेक और कॉलम ब्रेक के शॉर्टकट क्या हैं?"},"a":{"en":"Shift+Enter, Ctrl+Enter, and Ctrl+Shift+Enter","hi":"Shift+Enter, Ctrl+Enter और Ctrl+Shift+Enter"},"o":[{"en":"Shift+Enter, Ctrl+Enter, and Ctrl+Shift+Enter","hi":"Shift+Enter, Ctrl+Enter और Ctrl+Shift+Enter"},{"en":"Alt+Enter, Ctrl+Enter, and Shift+Enter","hi":"Alt+Enter, Ctrl+Enter और Shift+Enter"},{"en":"Enter, Alt+Enter, and Ctrl+Enter","hi":"Enter, Alt+Enter और Ctrl+Enter"},{"en":"Ctrl+L, Ctrl+P, and Ctrl+C","hi":"Ctrl+L, Ctrl+P और Ctrl+C"}],"exp":{"en":"Line Break: Shift+Enter; Page Break: Ctrl+Enter; Column Break: Ctrl+Shift+Enter.","hi":"लाइन ब्रेक के लिए Shift+Enter, पेज ब्रेक के लिए Ctrl+Enter और कॉलम ब्रेक के लिए Ctrl+Shift+Enter का उपयोग होता है।"},"num":280},{"id":"q281","q":{"en":"What do F7 and Shift+F7 do in Word?","hi":"Word में F7 और Shift+F7 क्या करते हैं?"},"a":{"en":"F7 runs Editor/spelling check; Shift+F7 opens the Thesaurus","hi":"F7 एडिटर/स्पेलिंग चेक करता है; Shift+F7 थिसॉरस खोलता है"},"o":[{"en":"F7 runs Editor/spelling check; Shift+F7 opens the Thesaurus","hi":"F7 एडिटर/स्पेलिंग चेक करता है; Shift+F7 थिसॉरस खोलता है"},{"en":"F7 saves; Shift+F7 prints","hi":"F7 सेव करता है; Shift+F7 प्रिंट करता है"},{"en":"F7 cuts; Shift+F7 pastes","hi":"F7 कट करता है; Shift+F7 पेस्ट करता है"},{"en":"F7 zooms in; Shift+F7 zooms out","hi":"F7 ज़ूम इन करता है; Shift+F7 ज़ूम आउट करता है"}],"exp":{"en":"F7 is the shortcut for spelling/grammar checking, and Shift+F7 is the shortcut for the Thesaurus.","hi":"F7 स्पेलिंग और ग्रामर चेक के लिए है, और Shift+F7 थिसॉरस (Thesaurus) के लिए है।"},"num":281},{"id":"q282","q":{"en":"What does Ctrl+Q do in Word?","hi":"Word में Ctrl+Q क्या करता है?"},"a":{"en":"Clears paragraph formatting","hi":"पैराग्राफ फॉर्मेटिंग हटाता (क्लियर करता) है"},"o":[{"en":"Clears paragraph formatting","hi":"पैराग्राफ फॉर्मेटिंग हटाता (क्लियर करता) है"},{"en":"Quits Word","hi":"Word बंद (quit) करता है"},{"en":"Adds a quote","hi":"कोट (quote) जोड़ता है"},{"en":"Aligns text right","hi":"टेक्स्ट को दाएँ अलाइन करता है"}],"exp":{"en":"Ctrl+Q removes manual paragraph formatting.","hi":"Word में Ctrl+Q का उपयोग पैराग्राफ पर लगी फॉर्मेटिंग को हटाने (Clear) के लिए होता है।"},"num":282},{"id":"q283","q":{"en":"What do Ctrl+Alt+F and Ctrl+Alt+D do in Word?","hi":"Word में Ctrl+Alt+F और Ctrl+Alt+D क्या करते हैं?"},"a":{"en":"Insert a Footnote and an Endnote respectively","hi":"क्रमशः फुटनोट (Footnote) और एंडनोट (Endnote) इन्सर्ट करते हैं"},"o":[{"en":"Insert a Footnote and an Endnote respectively","hi":"क्रमशः फुटनोट (Footnote) और एंडनोट (Endnote) इन्सर्ट करते हैं"},{"en":"Open Font and Design tabs","hi":"फ़ॉन्ट और डिज़ाइन टैब खोलते हैं"},{"en":"Find and Delete text","hi":"टेक्स्ट खोजते और डिलीट करते हैं"},{"en":"Format and Draft mode","hi":"फॉर्मेट और ड्राफ्ट मोड"}],"exp":{"en":"Ctrl+Alt+F inserts a Footnote; Ctrl+Alt+D inserts an Endnote.","hi":"Ctrl+Alt+F से फुटनोट और Ctrl+Alt+D से एंडनोट डाला जाता है।"},"num":283},{"id":"q284","q":{"en":"What is the zoom range of Word 2010?","hi":"Word 2010 की ज़ूम रेंज क्या है?"},"a":{"en":"10% to 500%","hi":"10% से 500%"},"o":[{"en":"10% to 500%","hi":"10% से 500%"},{"en":"10% to 400%","hi":"10% से 400%"},{"en":"20% to 1000%","hi":"20% से 1000%"},{"en":"50% to 200%","hi":"50% से 200%"}],"exp":{"en":"MS Word supports zooming from 10% up to 500%.","hi":"Word में न्यूनतम 10% से अधिकतम 500% तक ज़ूम किया जा सकता है।"},"num":284},{"id":"q285","q":{"en":"What is the address of the first cell and the name of the last column in modern Excel?","hi":"आधुनिक Excel में पहली सेल का पता (address) और अंतिम कॉलम का नाम क्या है?"},"a":{"en":"First cell is A1; last column is XFD","hi":"पहली सेल A1 है; अंतिम कॉलम XFD है"},"o":[{"en":"First cell is A1; last column is XFD","hi":"पहली सेल A1 है; अंतिम कॉलम XFD है"},{"en":"First cell is 1A; last column is IV","hi":"पहली सेल 1A है; अंतिम कॉलम IV है"},{"en":"First cell is X1; last column is ZZZ","hi":"पहली सेल X1 है; अंतिम कॉलम ZZZ है"},{"en":"First cell is 00; last column is 16384","hi":"पहली सेल 00 है; अंतिम कॉलम 16384 है"}],"exp":{"en":"The first cell is A1, and the 16,384th (last) column is XFD.","hi":"Excel में पहली सेल A1 होती है और आधुनिक संस्करणों में अंतिम (16,384वाँ) कॉलम XFD होता है।"},"num":285},{"id":"q286","q":{"en":"What is the grid size (rows and columns) of an Excel 2010 worksheet?","hi":"Excel 2010 वर्कशीट का ग्रिड आकार (पंक्तियाँ और कॉलम) क्या है?"},"a":{"en":"1,048,576 rows × 16,384 columns","hi":"1,048,576 पंक्तियाँ × 16,384 कॉलम"},"o":[{"en":"1,048,576 rows × 16,384 columns","hi":"1,048,576 पंक्तियाँ × 16,384 कॉलम"},{"en":"65,536 rows × 256 columns","hi":"65,536 पंक्तियाँ × 256 कॉलम"},{"en":"1,000,000 rows × 10,000 columns","hi":"1,000,000 पंक्तियाँ × 10,000 कॉलम"},{"en":"Unlimited rows × Unlimited columns","hi":"असीमित पंक्तियाँ × असीमित कॉलम"}],"exp":{"en":"Excel 2007+ (including 2010) has a limit of 1,048,576 rows and 16,384 columns.","hi":"Excel 2010 में अधिकतम 1,048,576 रोज़ और 16,384 कॉलम होते हैं।"},"num":286},{"id":"q287","q":{"en":"What was the grid size of an older Excel 2003 worksheet?","hi":"पुरानी Excel 2003 वर्कशीट का ग्रिड आकार क्या था?"},"a":{"en":"65,536 rows × 256 columns","hi":"65,536 पंक्तियाँ × 256 कॉलम"},"o":[{"en":"65,536 rows × 256 columns","hi":"65,536 पंक्तियाँ × 256 कॉलम"},{"en":"1,048,576 rows × 16,384 columns","hi":"1,048,576 पंक्तियाँ × 16,384 कॉलम"},{"en":"10,000 rows × 100 columns","hi":"10,000 पंक्तियाँ × 100 कॉलम"},{"en":"32,767 rows × 128 columns","hi":"32,767 पंक्तियाँ × 128 कॉलम"}],"exp":{"en":"Excel 2003 was strictly limited to 65,536 rows and 256 columns.","hi":"Excel 2003 में 65,536 रोज़ और 256 कॉलम होते थे।"},"num":287},{"id":"q288","q":{"en":"What is the maximum number of characters allowed in a single Excel cell?","hi":"एक Excel सेल में अधिकतम कितने कैरेक्टर (अक्षर) आ सकते हैं?"},"a":{"en":"32,767 characters","hi":"32,767 कैरेक्टर"},"o":[{"en":"32,767 characters","hi":"32,767 कैरेक्टर"},{"en":"255 characters","hi":"255 कैरेक्टर"},{"en":"1,024 characters","hi":"1,024 कैरेक्टर"},{"en":"1,048,576 characters","hi":"1,048,576 कैरेक्टर"}],"exp":{"en":"A single Excel cell can hold up to 32,767 characters of text.","hi":"Excel की एक सेल में अधिकतम 32,767 कैरेक्टर लिखे जा सकते हैं।"},"num":288},{"id":"q289","q":{"en":"What is the zoom range of Excel 2010?","hi":"Excel 2010 की ज़ूम रेंज क्या है?"},"a":{"en":"10% to 400%","hi":"10% से 400%"},"o":[{"en":"10% to 400%","hi":"10% से 400%"},{"en":"10% to 500%","hi":"10% से 500%"},{"en":"5% to 200%","hi":"5% से 200%"},{"en":"100% to 1000%","hi":"100% से 1000%"}],"exp":{"en":"Excel's zoom ranges from 10% to 400% (unlike Word's 500%).","hi":"Excel में ज़ूम 10% से 400% तक होता है।"},"num":289},{"id":"q290","q":{"en":"What does F2 do in Excel?","hi":"Excel में F2 क्या करता है?"},"a":{"en":"Edits the active cell","hi":"एक्टिव सेल को एडिट करता है"},"o":[{"en":"Edits the active cell","hi":"एक्टिव सेल को एडिट करता है"},{"en":"Saves the file","hi":"फाइल सेव करता है"},{"en":"Renames the file","hi":"फाइल का नाम बदलता है"},{"en":"Prints the file","hi":"फाइल प्रिंट करता है"}],"exp":{"en":"In Excel, F2 puts the active cell into edit mode.","hi":"F2 दबाने से एक्टिव सेल एडिट (Edit) मोड में आ जाती है।"},"num":290},{"id":"q291","q":{"en":"What does F4 do while editing a formula reference in Excel?","hi":"Excel में फॉर्मूला रिफरेन्स एडिट करते समय F4 क्या करता है?"},"a":{"en":"Cycles through reference lock types (A1, $A$1, A$1, $A1)","hi":"रिफरेन्स लॉक प्रकारों (A1, $A$1, A$1, $A1) के बीच साइकिल (टॉगल) करता है"},"o":[{"en":"Cycles through reference lock types (A1, $A$1, A$1, $A1)","hi":"रिफरेन्स लॉक प्रकारों (A1, $A$1, A$1, $A1) के बीच साइकिल (टॉगल) करता है"},{"en":"Deletes the reference","hi":"रिफरेन्स डिलीट करता है"},{"en":"Adds the SUM function","hi":"SUM फंक्शन जोड़ता है"},{"en":"Highlights the cell","hi":"सेल हाईलाइट करता है"}],"exp":{"en":"F4 toggles between relative, absolute, and mixed cell references.","hi":"F4 कुंजी रिलेटिव, एब्सोल्यूट और मिक्स्ड रिफरेन्स (जैसे A1 से $A$1) के बीच टॉगल करती है।"},"num":291},{"id":"q292","q":{"en":"What do Ctrl+9 and Ctrl+0 do in Excel?","hi":"Excel में Ctrl+9 और Ctrl+0 क्या करते हैं?"},"a":{"en":"Hide rows and hide columns respectively","hi":"क्रमशः पंक्तियाँ (rows) और कॉलम छिपाते (hide) हैं"},"o":[{"en":"Hide rows and hide columns respectively","hi":"क्रमशः पंक्तियाँ (rows) और कॉलम छिपाते (hide) हैं"},{"en":"Delete rows and delete columns","hi":"पंक्तियाँ और कॉलम डिलीट करते हैं"},{"en":"Format text and format numbers","hi":"टेक्स्ट और नंबर फॉर्मेट करते हैं"},{"en":"Zoom in and Zoom out","hi":"ज़ूम इन और ज़ूम आउट करते हैं"}],"exp":{"en":"Ctrl+9 hides rows; Ctrl+0 hides columns.","hi":"Ctrl+9 से रोज़ (Rows) छिप जाती हैं, और Ctrl+0 से कॉलम (Columns) छिप जाते हैं।"},"num":292},{"id":"q293","q":{"en":"What do Shift+Spacebar and Ctrl+Spacebar do in Excel?","hi":"Excel में Shift+Spacebar और Ctrl+Spacebar क्या करते हैं?"},"a":{"en":"Select the entire row and select the entire column respectively","hi":"क्रमशः पूरी पंक्ति (row) और पूरा कॉलम सेलेक्ट करते हैं"},"o":[{"en":"Select the entire row and select the entire column respectively","hi":"क्रमशः पूरी पंक्ति (row) और पूरा कॉलम सेलेक्ट करते हैं"},{"en":"Insert a row and insert a column","hi":"रो और कॉलम इन्सर्ट करते हैं"},{"en":"Delete a row and delete a column","hi":"रो और कॉलम डिलीट करते हैं"},{"en":"Format a row and format a column","hi":"रो और कॉलम फॉर्मेट करते हैं"}],"exp":{"en":"Shift+Spacebar selects the active row; Ctrl+Spacebar selects the active column.","hi":"Shift+Spacebar से पूरी रो और Ctrl+Spacebar से पूरा कॉलम सेलेक्ट होता है।"},"num":293},{"id":"q294","q":{"en":"What does Alt+Enter do while typing in an Excel cell?","hi":"Excel सेल में टाइप करते समय Alt+Enter क्या करता है?"},"a":{"en":"Inserts a new line (line break) within the same cell","hi":"उसी सेल के भीतर एक नई लाइन (लाइन ब्रेक) डालता है"},"o":[{"en":"Inserts a new line (line break) within the same cell","hi":"उसी सेल के भीतर एक नई लाइन (लाइन ब्रेक) डालता है"},{"en":"Moves to the cell above","hi":"ऊपर वाली सेल में जाता है"},{"en":"Deletes the cell contents","hi":"सेल का कंटेंट डिलीट करता है"},{"en":"Saves the workbook","hi":"वर्कबुक सेव करता है"}],"exp":{"en":"Alt+Enter forces a line break inside a single Excel cell.","hi":"Alt+Enter दबाने से उसी सेल के अंदर नई लाइन (Line break) शुरू होती है।"},"num":294},{"id":"q295","q":{"en":"What is the shortcut to insert a new worksheet in Excel?","hi":"Excel में नई वर्कशीट डालने (insert) का शॉर्टकट क्या है?"},"a":{"en":"Shift+F11","hi":"Shift+F11"},"o":[{"en":"Shift+F11","hi":"Shift+F11"},{"en":"Ctrl+N","hi":"Ctrl+N"},{"en":"Alt+W","hi":"Alt+W"},{"en":"F2","hi":"F2"}],"exp":{"en":"Shift+F11 (or Alt+Shift+F1) inserts a new worksheet.","hi":"नई वर्कशीट जोड़ने के लिए Shift+F11 शॉर्टकट का उपयोग होता है।"},"num":295},{"id":"q296","q":{"en":"What does the Alt+= shortcut do in Excel?","hi":"Excel में Alt+= शॉर्टकट क्या करता है?"},"a":{"en":"Applies the AutoSum function","hi":"AutoSum (ऑटोसैम) फंक्शन लागू करता है"},"o":[{"en":"Applies the AutoSum function","hi":"AutoSum (ऑटोसैम) फंक्शन लागू करता है"},{"en":"Zooms in the worksheet","hi":"वर्कशीट ज़ूम इन करता है"},{"en":"Formats the cell as currency","hi":"सेल को करेंसी में फॉर्मेट करता है"},{"en":"Adds a border","hi":"बॉर्डर जोड़ता है"}],"exp":{"en":"Alt+= automatically inserts the SUM function for adjacent numbers.","hi":"Alt+= दबाने से एक्सेल स्वतः SUM (AutoSum) फॉर्मूला लगा देता है।"},"num":296},{"id":"q297","q":{"en":"What is the difference between the NOW() and TODAY() functions?","hi":"NOW() और TODAY() फंक्शन में क्या अंतर है?"},"a":{"en":"NOW() returns the current date and time; TODAY() returns only the current date","hi":"NOW() वर्तमान दिनांक और समय देता है; TODAY() केवल वर्तमान दिनांक देता है"},"o":[{"en":"NOW() returns the current date and time; TODAY() returns only the current date","hi":"NOW() वर्तमान दिनांक और समय देता है; TODAY() केवल वर्तमान दिनांक देता है"},{"en":"NOW() returns the time only; TODAY() returns the date only","hi":"NOW() केवल समय देता है; TODAY() केवल दिनांक देता है"},{"en":"NOW() returns a static time; TODAY() returns a static date","hi":"NOW() स्थिर (static) समय देता है; TODAY() स्थिर दिनांक देता है"},{"en":"There is no difference","hi":"कोई अंतर नहीं है"}],"exp":{"en":"NOW() includes both date and time, whereas TODAY() includes only the date.","hi":"NOW() फंक्शन डेट और टाइम दोनों दिखाता है, जबकि TODAY() फंक्शन केवल डेट दिखाता है।"},"num":297},{"id":"q298","q":{"en":"On which Excel Ribbon tab are the SORT and FILTER commands commonly found?","hi":"Excel रिबन के किस टैब पर आमतौर पर SORT और FILTER कमांड मिलते हैं?"},"a":{"en":"Data tab","hi":"Data टैब"},"o":[{"en":"Data tab","hi":"Data टैब"},{"en":"Insert tab","hi":"Insert टैब"},{"en":"Review tab","hi":"Review टैब"},{"en":"View tab","hi":"View टैब"}],"exp":{"en":"Sort & Filter tools are prominently located on the Data tab (though basic versions exist on the Home tab).","hi":"डेटा को सॉर्ट और फ़िल्टर करने के मुख्य टूल्स Data टैब में होते हैं।"},"num":298},{"id":"q299","q":{"en":"What do F5, Shift+F5, and Esc do during a PowerPoint presentation?","hi":"PowerPoint प्रेजेंटेशन के दौरान F5, Shift+F5 और Esc क्या करते हैं?"},"a":{"en":"F5 starts from the beginning, Shift+F5 starts from the current slide, and Esc exits the slide show","hi":"F5 शुरुआत से शुरू करता है, Shift+F5 वर्तमान स्लाइड से शुरू करता है, और Esc स्लाइड शो से बाहर निकलता (exit) है"},"o":[{"en":"F5 starts from the beginning, Shift+F5 starts from the current slide, and Esc exits the slide show","hi":"F5 शुरुआत से शुरू करता है, Shift+F5 वर्तमान स्लाइड से शुरू करता है, और Esc स्लाइड शो से बाहर निकलता (exit) है"},{"en":"F5 prints, Shift+F5 saves, and Esc deletes","hi":"F5 प्रिंट करता है, Shift+F5 सेव करता है, और Esc डिलीट करता है"},{"en":"F5 goes to the next slide, Shift+F5 goes to the previous slide, and Esc pauses","hi":"F5 अगली स्लाइड पर जाता है, Shift+F5 पिछली पर, और Esc रोकता है"},{"en":"F5 adds animation, Shift+F5 adds transition, and Esc removes them","hi":"F5 एनीमेशन जोड़ता है, Shift+F5 ट्रांज़िशन जोड़ता है, और Esc उन्हें हटाता है"}],"exp":{"en":"F5 launches the show from Slide 1; Shift+F5 launches from the active slide; Esc ends the show.","hi":"F5 से प्रेजेंटेशन पहली स्लाइड से शुरू होती है, Shift+F5 से वर्तमान स्लाइड से, और Esc दबाकर प्रेजेंटेशन (स्लाइड शो) बंद हो जाती है।"},"num":299},{"id":"q300","q":{"en":"What are the common file extensions for a Microsoft Access database?","hi":"माइक्रोसॉफ्ट एक्सेस डेटाबेस के लिए सामान्य फाइल एक्सटेंशन क्या हैं?"},"a":{"en":".mdb (legacy) and .accdb (current)","hi":".mdb (लीगेसी/पुराना) और .accdb (वर्तमान)"},"o":[{"en":".mdb (legacy) and .accdb (current)","hi":".mdb (लीगेसी/पुराना) और .accdb (वर्तमान)"},{"en":".doc and .docx","hi":".doc और .docx"},{"en":".xls and .xlsx","hi":".xls और .xlsx"},{"en":".ppt and .pptx","hi":".ppt और .pptx"}],"exp":{"en":"MS Access uses .mdb for older versions and .accdb for Access 2007 and later.","hi":"एक्सेस के पुराने डेटाबेस का एक्सटेंशन .mdb था और नए (वर्तमान) डेटाबेस का .accdb है।"},"num":300},{"id":"q301","q":{"en":"What are the primary uses of Microsoft Outlook and OneNote?","hi":"माइक्रोसॉफ्ट आउटलुक और वननोट का मुख्य उपयोग क्या है?"},"a":{"en":"Outlook for email/calendar management; OneNote for note-taking","hi":"आउटलुक (Outlook) ईमेल/कैलेंडर प्रबंधन के लिए; वननोट (OneNote) नोट लेने (note-taking) के लिए"},"o":[{"en":"Outlook for email/calendar management; OneNote for note-taking","hi":"आउटलुक (Outlook) ईमेल/कैलेंडर प्रबंधन के लिए; वननोट (OneNote) नोट लेने (note-taking) के लिए"},{"en":"Outlook for spreadsheets; OneNote for databases","hi":"आउटलुक स्प्रेडशीट के लिए; वननोट डेटाबेस के लिए"},{"en":"Outlook for video editing; OneNote for audio recording","hi":"आउटलुक वीडियो एडिटिंग के लिए; वननोट ऑडियो रिकॉर्डिंग के लिए"},{"en":"Outlook for presentations; OneNote for publishing","hi":"आउटलुक प्रेजेंटेशन के लिए; वननोट पब्लिशिंग के लिए"}],"exp":{"en":"Outlook is a PIM (Personal Information Manager) handling emails and calendars. OneNote is a digital notebook.","hi":"Outlook मुख्य रूप से ईमेल और कैलेंडर मैनेज करता है। OneNote एक डिजिटल नोटबुक है।"},"num":301},{"id":"q302","q":{"en":"What category of software is Microsoft Publisher?","hi":"माइक्रोसॉफ्ट पब्लिशर (Publisher) किस श्रेणी का सॉफ्टवेयर है?"},"a":{"en":"Desktop publishing","hi":"डेस्कटॉप पब्लिशिंग (Desktop publishing)"},"o":[{"en":"Desktop publishing","hi":"डेस्कटॉप पब्लिशिंग (Desktop publishing)"},{"en":"Antivirus","hi":"एंटीवायरस"},{"en":"Web browser","hi":"वेब ब्राउज़र"},{"en":"Spreadsheet","hi":"स्प्रेडशीट"}],"exp":{"en":"Publisher is a desktop publishing program used to create brochures, newsletters, and cards.","hi":"Publisher एक डेस्कटॉप पब्लिशिंग (DTP) प्रोग्राम है जिसका उपयोग ब्रोशर, कार्ड आदि डिजाइन करने में होता है।"},"num":302}]}],"5. Internet, Email & E-Banking — Web Browsers, Search, Protocols & Online Payments":[{"title":{"en":"1. Internet Basics & History","hi":"1. इंटरनेट के मूल सिद्धांत और इतिहास"},"questions":[{"id":"q1","q":{"en":"What is the 'Internet', and why is it called a 'Network of Networks'?","hi":"'इंटरनेट' (Internet) क्या है और इसे 'नेटवर्क ऑफ नेटवर्क्स' (Network of Networks) क्यों कहते हैं?"},"a":{"en":"A global system of interconnected computer networks around the world, which is why it is called a 'network of networks'","hi":"दुनिया भर के आपस में जुड़े कंप्यूटर नेटवर्क्स का वैश्विक तंत्र (global system), इसीलिए इसे 'नेटवर्कों का नेटवर्क' भी कहते हैं"},"o":[{"en":"A single standalone desktop computer kept inside a school lab","hi":"स्कूल लैब के अंदर रखा गया एक अकेला स्टैंडअलोन डेस्कटॉप कंप्यूटर"},{"en":"A global system of interconnected computer networks around the world, which is why it is called a 'network of networks'","hi":"दुनिया भर के आपस में जुड़े कंप्यूटर नेटवर्क्स का वैश्विक तंत्र (global system), इसीलिए इसे 'नेटवर्कों का नेटवर्क' भी कहते हैं"},{"en":"A local printer cable connecting a keyboard to a monitor","hi":"कीबोर्ड को मॉनिटर से जोड़ने वाली एक लोकल प्रिंटर केबल"},{"en":"An offline spreadsheet software used for accounting","hi":"अकाउंटिंग के लिए उपयोग किया जाने वाला एक ऑफ़लाइन स्प्रेडशीट सॉफ्टवेयर"}],"exp":{"en":"The Internet is the global system of interconnected computer networks (private, public, academic, business, and government networks) linked together worldwide, earning it the title 'network of networks'.","hi":"इंटरनेट दुनिया भर के आपस में जुड़े (interconnected) कंप्यूटर नेटवर्क्स का एक वैश्विक सिस्टम है; इसीलिए इसे 'नेटवर्क ऑफ नेटवर्क्स' (नेटवर्कों का नेटवर्क) भी कहा जाता है।"},"num":1},{"id":"q2","q":{"en":"What is the common protocol suite used by the Internet?","hi":"इंटरनेट का सामान्य प्रोटोकॉल सुइट (Common Protocol Suite) क्या है?"},"a":{"en":"TCP/IP — the suite based on Transmission Control Protocol and Internet Protocol (which also includes other networking protocols in its family)","hi":"TCP/IP — अर्थात् Transmission Control Protocol और Internet Protocol पर आधारित सुइट (इस परिवार में अन्य नेटवर्किंग प्रोटोकॉल भी शामिल हैं)"},"o":[{"en":"TCP/IP — the suite based on Transmission Control Protocol and Internet Protocol (which also includes other networking protocols in its family)","hi":"TCP/IP — अर्थात् Transmission Control Protocol और Internet Protocol पर आधारित सुइट (इस परिवार में अन्य नेटवर्किंग प्रोटोकॉल भी शामिल हैं)"},{"en":"BIOS/CMOS — Basic Input Output System and Complementary Metal Oxide Semiconductor","hi":"BIOS/CMOS — बेसिक इनपुट आउटपुट सिस्टम"},{"en":"CAD/CAM — Computer-Aided Design and Computer-Aided Manufacturing","hi":"CAD/CAM — कंप्यूटर-एडेड डिज़ाइन और मैन्युफैक्चरिंग"},{"en":"OMR/MICR — Optical Mark Recognition and Magnetic Ink Character Recognition","hi":"OMR/MICR — ऑप्टिकल मार्क और मैग्नेटिक इंक रिकग्निशन"}],"exp":{"en":"The foundational communication protocol suite of the Internet is TCP/IP, named after its two core protocols: Transmission Control Protocol (TCP) and Internet Protocol (IP), alongside many other protocols in the suite.","hi":"इंटरनेट का मानक और सामान्य प्रोटोकॉल सुइट TCP/IP है, जो Transmission Control Protocol (TCP) और Internet Protocol (IP) पर आधारित है (इस प्रोटोकॉल परिवार में अन्य नेटवर्किंग प्रोटोकॉल भी आते हैं)।"},"num":2},{"id":"q3","q":{"en":"What is the primary function of an 'IP Address'?","hi":"'आईपी एड्रेस' (IP Address) का मुख्य काम क्या है?"},"a":{"en":"It assigns a logical numerical address to a network interface so that data packets can be routed to the correct destination","hi":"यह नेटवर्क इंटरफेस को एक लॉजिकल एड्रेस (logical address) देता है, जिससे डेटा पैकेट्स सही गंतव्य (destination) तक रूट हो सकें"},"o":[{"en":"It assigns a logical numerical address to a network interface so that data packets can be routed to the correct destination","hi":"यह नेटवर्क इंटरफेस को एक लॉजिकल एड्रेस (logical address) देता है, जिससे डेटा पैकेट्स सही गंतव्य (destination) तक रूट हो सकें"},{"en":"It measures the physical weight of a laptop battery in grams","hi":"यह ग्राम में लैपटॉप बैटरी के भौतिक वजन को मापता है"},{"en":"It checks spelling and grammar mistakes in MS Word documents","hi":"यह MS Word दस्तावेज़ों में वर्तनी और व्याकरण की गलतियों की जाँच करता है"},{"en":"It cools down the CPU heatsink fan","hi":"यह CPU हीटसिंक फैन को ठंडा करता है"}],"exp":{"en":"An IP (Internet Protocol) address provides a logical address to a device's network interface, enabling routers across networks to identify the host and route data packets to the right destination.","hi":"IP एड्रेस किसी नेटवर्क इंटरफेस को एक तार्किक पता (logical address) प्रदान करता है, जिसकी मदद से डेटा पैकेट्स को नेटवर्क पर सही गंतव्य (destination) तक पहुँचाया (route किया) जा सकता है।"},"num":3},{"id":"q4","q":{"en":"Does every computer always have a permanent, globally unique IP address?","hi":"क्या हर कंप्यूटर का हमेशा एक स्थायी (Permanent) और विश्व स्तर पर अद्वितीय (Globally Unique) IP एड्रेस होता है?"},"a":{"en":"No — IP addresses can be dynamic, private IP addresses can be reused across different local networks, and multiple devices can share a single public IP through NAT","hi":"नहीं — IP डायनेमिक हो सकता है, प्राइवेट IP अलग-अलग लोकल नेटवर्क्स में दोबारा उपयोग हो सकते हैं, और NAT के माध्यम से कई डिवाइसेस एक पब्लिक IP साझा कर सकते हैं"},"o":[{"en":"Yes — an IP address is permanently etched into the monitor glass at the factory and can never change","hi":"हाँ — IP एड्रेस फैक्ट्री में मॉनिटर के कांच पर स्थायी रूप से उकेरा जाता है और कभी बदल नहीं सकता"},{"en":"No — IP addresses can be dynamic, private IP addresses can be reused across different local networks, and multiple devices can share a single public IP through NAT","hi":"नहीं — IP डायनेमिक हो सकता है, प्राइवेट IP अलग-अलग लोकल नेटवर्क्स में दोबारा उपयोग हो सकते हैं, और NAT के माध्यम से कई डिवाइसेस एक पब्लिक IP साझा कर सकते हैं"},{"en":"Yes — private IP addresses cannot be used on more than one router in the world","hi":"हाँ — दुनिया में एक से अधिक राउटर पर प्राइवेट IP का उपयोग नहीं किया जा सकता"},{"en":"No — computers do not use IP addresses to access the Internet","hi":"नहीं — कंप्यूटर इंटरनेट एक्सेस करने के लिए IP एड्रेस का उपयोग नहीं करते"}],"exp":{"en":"No. An IP address can be assigned dynamically (via DHCP) and change over time; private IP ranges (like 192.168.x.x) are reused across millions of separate local LANs; and through NAT (Network Address Translation), multiple home/office devices share a single public IP address.","hi":"नहीं। IP एड्रेस डायनेमिक (परिवर्तनशील) हो सकता है; प्राइवेट IP एड्रेस अलग-अलग लोकल नेटवर्क्स (LANs) में बार-बार उपयोग किए जा सकते हैं; और NAT (Network Address Translation) के ज़रिए कई उपकरण एक ही पब्लिक IP साझा कर सकते हैं।"},"num":4},{"id":"q5","q":{"en":"What is the full form and function of an 'ISP', and what are its Indian examples?","hi":"'ISP' का पूर्ण रूप और काम क्या है, तथा इसके भारतीय उदाहरण कौन-से हैं?"},"a":{"en":"Internet Service Provider — organizations like BSNL, Airtel, and Jio that provide internet connectivity to users","hi":"इंटरनेट सर्विस प्रोवाइडर — BSNL, Airtel और Jio जैसी संस्थाएँ जो यूज़र्स को इंटरनेट कनेक्टिविटी प्रदान करती हैं"},"o":[{"en":"Internet Service Provider — organizations like BSNL, Airtel, and Jio that provide internet connectivity to users","hi":"इंटरनेट सर्विस प्रोवाइडर — BSNL, Airtel और Jio जैसी संस्थाएँ जो यूज़र्स को इंटरनेट कनेक्टिविटी प्रदान करती हैं"},{"en":"Internal Storage Partition — a hard disk utility used to format drives","hi":"इंटरनल स्टोरेज पार्टीशन — ड्राइव फ़ॉर्मेट करने वाली हार्ड डिस्क यूटिलिटी"},{"en":"Integrated Sound Processor — an audio chip inside speakers","hi":"इंटीग्रेटेड साउंड प्रोसेसर — स्पीकर के अंदर लगी ऑडियो चिप"},{"en":"Instruction Set Pointer — a register inside the ALU","hi":"इंस्ट्रक्शन सेट पॉइंटर — ALU के अंदर का एक रजिस्टर"}],"exp":{"en":"ISP stands for Internet Service Provider. Companies such as BSNL, Airtel, and Jio act as ISPs that provide Internet access and connectivity to home and business users.","hi":"ISP का पूर्ण रूप Internet Service Provider है। BSNL, Airtel और Jio जैसे प्रदाता उपयोगकर्ताओं को इंटरनेट कनेक्टिविटी उपलब्ध कराते हैं।"},"num":5},{"id":"q6","q":{"en":"What is the full form of 'ARPANET', which important year is associated with its early node connections, and what was its historical significance?","hi":"'ARPANET' का पूर्ण रूप और महत्वपूर्ण वर्ष क्या है, तथा इसका ऐतिहासिक महत्व क्या था?"},"a":{"en":"Advanced Research Projects Agency Network; its early nodes connected in 1969, and it served as the major precursor to the modern Internet","hi":"एडवांस्ड रिसर्च प्रोजेक्ट्स एजेंसी नेटवर्क (Advanced Research Projects Agency Network); 1969 में इसके शुरुआती नोड्स जुड़े और यह आधुनिक इंटरनेट का प्रमुख पूर्ववर्ती (precursor) था"},"o":[{"en":"Advanced Research Projects Agency Network; its early nodes connected in 1969, and it served as the major precursor to the modern Internet","hi":"एडवांस्ड रिसर्च प्रोजेक्ट्स एजेंसी नेटवर्क (Advanced Research Projects Agency Network); 1969 में इसके शुरुआती नोड्स जुड़े और यह आधुनिक इंटरनेट का प्रमुख पूर्ववर्ती (precursor) था"},{"en":"Automated Regional Postal And Network; launched in 1999 as an e-banking app","hi":"ऑटोमेटेड रीजनल पोस्टल एंड नेटवर्क; 1999 में ई-बैंकिंग ऐप के रूप में लॉन्च हुआ"},{"en":"American Radio Protocol And Network; created in 1945 for FM radio broadcasting","hi":"अमेरिकन रेडियो प्रोटोकॉल एंड नेटवर्क; 1945 में एफएम रेडियो प्रसारण के लिए बनाया गया"},{"en":"Application Routing Packet Access Network; established in 2008 for smartphones","hi":"एप्लिकेशन रूटिंग पैकेट एक्सेस नेटवर्क; 2008 में स्मार्टफोन के लिए स्थापित"}],"exp":{"en":"ARPANET stands for Advanced Research Projects Agency Network (funded by the U.S. Department of Defense's ARPA). Its first four packet-switching nodes were connected in 1969, making it the primary technical precursor to the modern Internet.","hi":"ARPANET का पूर्ण रूप Advanced Research Projects Agency Network है। वर्ष 1969 में इसके शुरुआती नोड्स आपस में जुड़े थे, और यह आधुनिक इंटरनेट का सबसे प्रमुख पूर्ववर्ती (major precursor) था।"},"num":6},{"id":"q7","q":{"en":"Who developed network email on ARPANET, in which year, and which symbol did he introduce for addressing?","hi":"ARPANET पर नेटवर्क ईमेल (Network Email) किसने और कब विकसित की, तथा उन्होंने एड्रेस में किस चिह्न का उपयोग किया?"},"a":{"en":"Ray Tomlinson in 1971; he used the '@' symbol to separate the username and the host computer name","hi":"रे टॉमलिनसन (Ray Tomlinson) ने 1971 में; उन्होंने यूज़रनेम और होस्ट को अलग करने के लिए '@' चिह्न का उपयोग किया"},"o":[{"en":"Ray Tomlinson in 1971; he used the '@' symbol to separate the username and the host computer name","hi":"रे टॉमलिनसन (Ray Tomlinson) ने 1971 में; उन्होंने यूज़रनेम और होस्ट को अलग करने के लिए '@' चिह्न का उपयोग किया"},{"en":"Charles Babbage in 1837; he used the '#' symbol","hi":"चार्ल्स बैबेज ने 1837 में; उन्होंने '#' चिह्न का उपयोग किया"},{"en":"Blaise Pascal in 1642; he used the '$' symbol","hi":"ब्लेज़ पास्कल ने 1642 में; उन्होंने '$' चिह्न का उपयोग किया"},{"en":"Alan Emtage in 1995; he used the '&' symbol","hi":"एलन एमटेज ने 1995 में; उन्होंने '&' चिह्न का उपयोग किया"}],"exp":{"en":"Computer engineer Ray Tomlinson developed the first networked email system on ARPANET in 1971 and selected the '@' (at) symbol to separate the local user's login name from the destination host/domain name.","hi":"रे टॉमलिनसन (Ray Tomlinson) ने वर्ष 1971 में ARPANET पर नेटवर्क ईमेल विकसित की थी। उन्होंने यूज़रनेम और होस्ट मशीन के नाम को अलग करने के लिए '@' चिह्न का चयन किया।"},"num":7},{"id":"q8","q":{"en":"When did ARPANET officially adopt TCP/IP as its standard protocol suite?","hi":"ARPANET ने आधिकारिक तौर पर TCP/IP प्रोटोकॉल को कब अपनाया?"},"a":{"en":"1 January 1983 (the standard transition milestone, often called Flag Day)","hi":"1 जनवरी 1983 (यह ट्रांज़िशन का मानक ऐतिहासिक माइलस्टोन है)"},"o":[{"en":"1 January 1983 (the standard transition milestone, often called Flag Day)","hi":"1 जनवरी 1983 (यह ट्रांज़िशन का मानक ऐतिहासिक माइलस्टोन है)"},{"en":"15 August 1995","hi":"15 अगस्त 1995"},{"en":"1 January 1951","hi":"1 जनवरी 1951"},{"en":"31 December 2001","hi":"31 दिसंबर 2001"}],"exp":{"en":"ARPANET officially transitioned from the older NCP protocol to TCP/IP on 1 January 1983—a historic milestone marking the birth of the modern operational Internet.","hi":"ARPANET द्वारा 1 जनवरी 1983 को TCP/IP अपनाया जाना इंटरनेट इतिहास का मानक ट्रांज़िशन माइलस्टोन है।"},"num":8},{"id":"q9","q":{"en":"Who proposed the World Wide Web (WWW), in which year, and at which institution?","hi":"वर्ल्ड वाइड वेब (World Wide Web - WWW) का प्रस्ताव कब, कहाँ और किसके द्वारा दिया गया?"},"a":{"en":"Tim Berners-Lee in 1989 at CERN","hi":"टिम बर्नर्स-ली (Tim Berners-Lee) ने 1989 में CERN में प्रस्ताव दिया"},"o":[{"en":"Tim Berners-Lee in 1989 at CERN","hi":"टिम बर्नर्स-ली (Tim Berners-Lee) ने 1989 में CERN में प्रस्ताव दिया"},{"en":"Ray Tomlinson in 1971 at Bell Labs","hi":"रे टॉमलिनसन ने 1971 में बेल लैब्स में"},{"en":"Bill Gates in 1985 at Microsoft","hi":"बिल गेट्स ने 1985 में माइक्रोसॉफ्ट में"},{"en":"Ken Thompson in 1969 at MIT","hi":"केन थॉम्पसन ने 1969 में एमआईटी में"}],"exp":{"en":"British computer scientist Sir Tim Berners-Lee wrote the initial proposal for the World Wide Web in March 1989 while working at CERN (European Organization for Nuclear Research).","hi":"टिम बर्नर्स-ली (Tim Berners-Lee) ने वर्ष 1989 में CERN में वर्ल्ड वाइड वेब (WWW) का प्रस्ताव प्रस्तुत किया था।"},"num":9},{"id":"q10","q":{"en":"What was the name of the world's first web browser, who created it, when, and what was it later renamed?","hi":"दुनिया के पहले वेब ब्राउज़र का नाम क्या था, इसे किसने व कब बनाया, और बाद में इसे क्या नाम दिया गया?"},"a":{"en":"'WorldWideWeb' (no spaces), created by Tim Berners-Lee at CERN in 1990 as a browser/editor, and later renamed 'Nexus'","hi":"'WorldWideWeb', जिसे टिम बर्नर्स-ली ने 1990 में CERN में बनाया और बाद में इसे 'Nexus' कहा गया"},"o":[{"en":"'WorldWideWeb' (no spaces), created by Tim Berners-Lee at CERN in 1990 as a browser/editor, and later renamed 'Nexus'","hi":"'WorldWideWeb', जिसे टिम बर्नर्स-ली ने 1990 में CERN में बनाया और बाद में इसे 'Nexus' कहा गया"},{"en":"'Google Chrome', created by Alan Emtage in 2008","hi":"'Google Chrome', जिसे एलन एमटेज ने 2008 में बनाया"},{"en":"'Internet Explorer', created by VSNL in 1995","hi":"'Internet Explorer', जिसे VSNL ने 1995 में बनाया"},{"en":"'Opera Mini', created by NCSA in 1969","hi":"'Opera Mini', जिसे NCSA ने 1969 में बनाया"}],"exp":{"en":"Tim Berners-Lee wrote the first web browser (which also functioned as a web page editor) in 1990 at CERN on a NeXT computer. It was originally named 'WorldWideWeb' and was later renamed 'Nexus' to avoid confusion with the abstract World Wide Web space.","hi":"पहले वेब ब्राउज़र/एडिटर का नाम 'WorldWideWeb' था, जिसे टिम बर्नर्स-ली ने वर्ष 1990 में CERN में बनाया था। वर्ल्ड वाइड वेब से भ्रम की स्थिति से बचने के लिए इसे बाद में 'Nexus' नाम दिया गया।"},"num":10},{"id":"q11","q":{"en":"What is the significance of the year 1991 in World Wide Web history?","hi":"वेब इतिहास (Web History) में वर्ष 1991 किस घटना से जुड़ा है?"},"a":{"en":"Web software and information were announced and made available outside CERN to the wider public Internet community","hi":"वेब सॉफ्टवेयर और जानकारी को CERN के बाहर व्यापक इंटरनेट समुदाय (wider Internet community) के लिए घोषित और उपलब्ध कराया गया"},"o":[{"en":"Web software and information were announced and made available outside CERN to the wider public Internet community","hi":"वेब सॉफ्टवेयर और जानकारी को CERN के बाहर व्यापक इंटरनेट समुदाय (wider Internet community) के लिए घोषित और उपलब्ध कराया गया"},{"en":"The first ARPANET node was installed in California","hi":"कैलिफ़ोर्निया में पहला ARPANET नोड स्थापित किया गया"},{"en":"RBI launched the 24x7 NEFT payment system","hi":"RBI ने 24x7 NEFT भुगतान प्रणाली शुरू की"},{"en":"Microsoft Windows 10 introduced the Edge browser","hi":"माइक्रोसॉफ्ट विंडोज़ 10 ने एज ब्राउज़र पेश किया"}],"exp":{"en":"In August 1991, Tim Berners-Lee announced the World Wide Web project and released the WWW software to the wider public Internet community outside CERN.","hi":"वर्ष 1991 में वेब सॉफ्टवेयर और सूचना को CERN प्रयोगशाला के बाहर आम इंटरनेट समुदाय (wider Internet community) के लिए सार्वजनिक रूप से घोषित किया गया था।"},"num":11},{"id":"q12","q":{"en":"What is the full form of 'W3C', who founded it, in which year, and what does it do?","hi":"'W3C' का पूर्ण रूप और स्थापना वर्ष क्या है, तथा यह क्या कार्य करता है?"},"a":{"en":"World Wide Web Consortium — established by Tim Berners-Lee in 1994 to develop open web standards","hi":"वर्ल्ड वाइड वेब कंसोर्टियम (World Wide Web Consortium) — टिम बर्नर्स-ली ने 1994 में स्थापित किया; यह वेब मानक (web standards) विकसित करता है"},"o":[{"en":"World Wide Web Consortium — established by Tim Berners-Lee in 1994 to develop open web standards","hi":"वर्ल्ड वाइड वेब कंसोर्टियम (World Wide Web Consortium) — टिम बर्नर्स-ली ने 1994 में स्थापित किया; यह वेब मानक (web standards) विकसित करता है"},{"en":"Wireless World Wide Computer — founded in 1969 to sell routers","hi":"वायरलेस वर्ल्ड वाइड कंप्यूटर — राउटर बेचने के लिए 1969 में स्थापित"},{"en":"Web Window Workstation Center — founded in 2001 to manufacture monitors","hi":"वेब विंडो वर्कस्टेशन सेंटर — मॉनिटर बनाने के लिए 2001 में स्थापित"},{"en":"World Wide Banking Clearinghouse — founded in 1995 for cheque clearing","hi":"वर्ल्ड वाइड बैंकिंग क्लियरिंगहाउस — चेक क्लियरिंग के लिए 1995 में स्थापित"}],"exp":{"en":"W3C stands for World Wide Web Consortium. Founded by Tim Berners-Lee in October 1994, W3C is the main international standards organization that develops open web standards (such as HTML and CSS specifications).","hi":"W3C का पूर्ण रूप World Wide Web Consortium है। टिम बर्नर्स-ली ने वर्ष 1994 में इसकी स्थापना की थी, और यह संस्था वेब मानक (web standards) विकसित करने का कार्य करती है।"},"num":12},{"id":"q13","q":{"en":"With which organization and year is the launch of public Internet service in India associated?","hi":"भारत में सार्वजनिक इंटरनेट सेवा (Public Internet Service) की शुरुआत किस संस्था और किस वर्ष से जुड़ी है?"},"a":{"en":"VSNL (Videsh Sanchar Nigam Limited) in 1995 (15 August 1995, marking the milestone of public commercial Internet access in India)","hi":"VSNL (विदेश संचार निगम लिमिटेड), वर्ष 1995"},"o":[{"en":"VSNL (Videsh Sanchar Nigam Limited) in 1995 (15 August 1995, marking the milestone of public commercial Internet access in India)","hi":"VSNL (विदेश संचार निगम लिमिटेड), वर्ष 1995"},{"en":"NPCI in 2010","hi":"NPCI, वर्ष 2010"},{"en":"CERN in 1989","hi":"CERN, वर्ष 1989"},{"en":"ARPA in 1969","hi":"ARPA, वर्ष 1969"}],"exp":{"en":"Public commercial Internet service in India was launched by VSNL (Videsh Sanchar Nigam Limited) on 15 August 1995 (via its Gateway Internet Access Service - GIAS).","hi":"भारत में आम जनता के लिए सार्वजनिक व्यावसायिक इंटरनेट सेवा की शुरुआत वर्ष 1995 (15 अगस्त 1995) में VSNL (Videsh Sanchar Nigam Limited) द्वारा की गई थी।"},"num":13},{"id":"q14","q":{"en":"What is the fundamental difference between the 'Internet' and the 'World Wide Web' (WWW)?","hi":"'इंटरनेट' (Internet) और 'वर्ल्ड वाइड वेब' (WWW) में मुख्य अंतर क्या है?"},"a":{"en":"The Internet is the underlying global network infrastructure, whereas the WWW is a service of interconnected webpages and resources running on top of the Internet","hi":"इंटरनेट अंतर्निहित नेटवर्क इन्फ्रास्ट्रक्चर है, जबकि WWW उस पर चलने वाली आपस में जुड़े वेबपेजों/संसाधनों की एक सेवा (service) है"},"o":[{"en":"The Internet is the underlying global network infrastructure, whereas the WWW is a service of interconnected webpages and resources running on top of the Internet","hi":"इंटरनेट अंतर्निहित नेटवर्क इन्फ्रास्ट्रक्चर है, जबकि WWW उस पर चलने वाली आपस में जुड़े वेबपेजों/संसाधनों की एक सेवा (service) है"},{"en":"The WWW is a physical copper cable, whereas the Internet is a web page written in HTML","hi":"WWW एक भौतिक तांबे की केबल है, जबकि इंटरनेट HTML में लिखा गया एक वेब पेज है"},{"en":"There is no difference; both were invented in 1995 by VSNL","hi":"कोई अंतर नहीं है; दोनों का आविष्कार 1995 में VSNL द्वारा किया गया था"},{"en":"The Internet only carries emails, whereas the WWW works without any network","hi":"इंटरनेट केवल ईमेल ले जाता है, जबकि WWW बिना किसी नेटवर्क के काम करता है"}],"exp":{"en":"The Internet is the global hardware and networking infrastructure (routers, cables, TCP/IP links connecting computers), whereas the World Wide Web (WWW) is an information service/application layer of hyperlinked documents and resources accessed over the Internet.","hi":"इंटरनेट अंतर्निहित भौतिक और तार्किक नेटवर्क ढाँचा (underlying network infrastructure) है, जबकि वर्ल्ड वाइड वेब (WWW) उस नेटवर्क के ऊपर चलने वाली आपस में जुड़े वेबपेजों और संसाधनों की एक सूचना सेवा (service) है।"},"num":14},{"id":"q15","q":{"en":"What types of content are available on the World Wide Web (WWW)?","hi":"वर्ल्ड वाइड वेब (WWW) पर किस प्रकार का कंटेंट मिलता है?"},"a":{"en":"Hyperlinked text, graphics/images, audio, video, and other interactive multimedia resources","hi":"हाइपरलिंक्ड टेक्स्ट, ग्राफिक्स, ऑडियो, वीडियो और अन्य मल्टीमीडिया संसाधन"},"o":[{"en":"Hyperlinked text, graphics/images, audio, video, and other interactive multimedia resources","hi":"हाइपरलिंक्ड टेक्स्ट, ग्राफिक्स, ऑडियो, वीडियो और अन्य मल्टीमीडिया संसाधन"},{"en":"Only unformatted 7-bit ASCII plain text without links or images","hi":"बिना किसी लिंक या चित्र के केवल अनफ़ॉर्मेटेड सादा टेक्स्ट"},{"en":"Only physical paper books delivered by post","hi":"केवल डाक द्वारा वितरित भौतिक कागजी किताबें"},{"en":"Only binary punched cards","hi":"केवल बाइनरी पंच कार्ड"}],"exp":{"en":"The World Wide Web supports rich hypermedia content, including hyperlinked text documents, graphics, animations, audio streams, video, and interactive web applications.","hi":"WWW पर हाइपरलिंक्ड टेक्स्ट (hyperlinked text), ग्राफिक्स, ऑडियो, वीडियो और अन्य सभी प्रकार के मल्टीमीडिया संसाधन उपलब्ध होते हैं।"},"num":15},{"id":"q16","q":{"en":"What was the role of 'CERN' in the history of the World Wide Web, and what is its full name?","hi":"वेब इतिहास में 'CERN' की क्या भूमिका थी और इसका पूरा नाम क्या है?"},"a":{"en":"CERN (European Organization for Nuclear Research) was the research institution where Tim Berners-Lee invented the World Wide Web","hi":"CERN (European Organization for Nuclear Research) वह संस्थान था जहाँ टिम बर्नर्स-ली द्वारा वेब (Web) का आविष्कार हुआ"},"o":[{"en":"CERN (European Organization for Nuclear Research) was the research institution where Tim Berners-Lee invented the World Wide Web","hi":"CERN (European Organization for Nuclear Research) वह संस्थान था जहाँ टिम बर्नर्स-ली द्वारा वेब (Web) का आविष्कार हुआ"},{"en":"CERN was the Indian bank that launched NEFT and RTGS","hi":"CERN वह भारतीय बैंक था जिसने NEFT और RTGS लॉन्च किया"},{"en":"CERN was a commercial ISP in New York that invented dial-up modems","hi":"CERN न्यूयॉर्क में एक व्यावसायिक ISP था जिसने डायल-अप मॉडेम का आविष्कार किया"},{"en":"CERN was the company that manufactured the first iPhone in 2007","hi":"CERN वह कंपनी थी जिसने 2007 में पहला iPhone बनाया"}],"exp":{"en":"CERN (Conseil Européen pour la Recherche Nucléaire / European Organization for Nuclear Research, based in Geneva) is the institution where Tim Berners-Lee invented the World Wide Web in 1989–1990.","hi":"CERN (European Organization for Nuclear Research) वह वैज्ञानिक अनुसंधान संस्थान था जहाँ टिम बर्नर्स-ली ने वर्ल्ड वाइड वेब (Web) का आविष्कार किया था।"},"num":16}]},{"title":{"en":"2. Domains, Web Pages & URLs","hi":"2. डोमेन नाम, वेब पेज और URL"},"questions":[{"id":"q17","q":{"en":"What is a 'Domain Name'?","hi":"'डोमेन नाम' (Domain Name) क्या है?"},"a":{"en":"A human-readable network name (such as example.com) used to identify websites, servers, and email services on the Internet","hi":"एक मानव-पठनीय नेटवर्क नाम (जैसे example.com), जिसका उपयोग वेबसाइटों और ईमेल सेवाओं की पहचान करने में होता है"},"o":[{"en":"A human-readable network name (such as example.com) used to identify websites, servers, and email services on the Internet","hi":"एक मानव-पठनीय नेटवर्क नाम (जैसे example.com), जिसका उपयोग वेबसाइटों और ईमेल सेवाओं की पहचान करने में होता है"},{"en":"The 48-bit physical MAC address burned into an Ethernet card","hi":"ईथरनेट कार्ड में स्थायी रूप से लिखा गया 48-बिट भौतिक MAC पता"},{"en":"The serial number printed on a computer monitor's cardboard box","hi":"कंप्यूटर मॉनिटर के बॉक्स पर छपा सीरियल नंबर"},{"en":"A programming language translator that compiles C++ code","hi":"C++ कोड को कंपाइल करने वाला एक प्रोग्रामिंग लैंग्वेज ट्रांसलेटर"}],"exp":{"en":"A domain name is a memorable, human-readable text label (such as `example.com` or `india.gov.in`) used in place of numeric IP addresses to identify websites and mail domains on the Internet.","hi":"डोमेन नाम एक मानव-पठनीय नेटवर्क नाम (जैसे `example.com`) है, जिसका उपयोग इंटरनेट पर वेबसाइटों और ईमेल सेवाओं को आसानी से पहचानने के लिए किया जाता है।"},"num":17},{"id":"q18","q":{"en":"How do you identify the Top-Level Domain (TLD) in a domain name like 'example.com' or 'example.co.in'?","hi":"किसी डोमेन नाम (जैसे `example.com` या `example.co.in`) में टॉप-लेवल डोमेन (TLD) की पहचान कैसे करते हैं?"},"a":{"en":"From the rightmost label after the final dot — in 'example.com' the TLD is '.com', and in 'example.co.in' the TLD is '.in'","hi":"डोमेन के सबसे दाएँ (rightmost) लेबल से — `example.com` में `.com` TLD है और `example.co.in` में `.in` TLD है"},"o":[{"en":"From the rightmost label after the final dot — in 'example.com' the TLD is '.com', and in 'example.co.in' the TLD is '.in'","hi":"डोमेन के सबसे दाएँ (rightmost) लेबल से — `example.com` में `.com` TLD है और `example.co.in` में `.in` TLD है"},{"en":"From the leftmost word before the first dot","hi":"पहले डॉट से ठीक पहले के सबसे बाएँ शब्द से"},{"en":"From the 'http://' prefix at the start of a URL","hi":"URL की शुरुआत में लगे 'http://' प्रीफ़िक्स से"},{"en":"From the filename after the last forward slash","hi":"अंतिम फॉरवर्ड स्लैश के बाद लिखे फ़ाइल नाम से"}],"exp":{"en":"In the Domain Name System hierarchy, the Top-Level Domain (TLD) is always the rightmost label (after the last dot): `.com` is a generic TLD in `example.com`, and `.in` is the country-code TLD in `example.co.in`.","hi":"टॉप-लेवल डोमेन (TLD) की पहचान डोमेन नाम के सबसे दाएँ (rightmost) हिस्से से की जाती है; उदाहरण के लिए `example.com` में `.com` एक TLD है और `example.co.in` में `.in` (देश-कोड) TLD है।"},"num":18},{"id":"q19","q":{"en":"What is a 'Subdomain', and what is the subdomain in 'support.example.com'?","hi":"'सबडोमेन' (Subdomain) क्या है, और `support.example.com` में सबडोमेन कौन-सा है?"},"a":{"en":"A label added to the left of a parent domain to organize sections/services; in 'support.example.com', 'support' is a subdomain of 'example.com'","hi":"पैरेंट डोमेन के बाईं ओर जोड़ा गया लेबल; `support.example.com` में `support`, `example.com` का सबडोमेन है"},"o":[{"en":"A label added to the left of a parent domain to organize sections/services; in 'support.example.com', 'support' is a subdomain of 'example.com'","hi":"पैरेंट डोमेन के बाईं ओर जोड़ा गया लेबल; `support.example.com` में `support`, `example.com` का सबडोमेन है"},{"en":"The '.com' suffix at the far right of the domain","hi":"डोमेन के सबसे दाईं ओर लगा '.com' प्रत्यय"},{"en":"The '#' fragment identifier at the end of a URL","hi":"URL के अंत में लगा '#' फ्रैगमेंट पहचानकर्ता"},{"en":"An offline folder stored inside the Windows Recycle Bin","hi":"विंडोज़ रीसायकल बिन के अंदर रखा एक ऑफ़लाइन फ़ोल्डर"}],"exp":{"en":"A subdomain is a domain prefix placed to the left of the registered parent domain (separated by a dot) to organize distinct sections or servers of a site. In `support.example.com`, `support` is a subdomain of `example.com`.","hi":"पैरेंट डोमेन के बाईं ओर (left में) जोड़े गए लेबल को 'सबडोमेन' कहते हैं। उदाहरण के लिए, `support.example.com` में `support`, मुख्य डोमेन `example.com` का एक सबडोमेन है।"},"num":19},{"id":"q20","q":{"en":"What does the domain extension '.co.in' indicate?","hi":"डोमेन एक्सटेंशन '.co.in' क्या दर्शाता है?"},"a":{"en":"A second-level registration category under India's '.in' country-code namespace, traditionally associated with commercial entities","hi":"भारत के `.in` नेमस्पेस के अंतर्गत एक पंजीकरण श्रेणी, जो पारंपरिक रूप से व्यावसायिक (commercial) उपयोग से जुड़ी है"},"o":[{"en":"A second-level registration category under India's '.in' country-code namespace, traditionally associated with commercial entities","hi":"भारत के `.in` नेमस्पेस के अंतर्गत एक पंजीकरण श्रेणी, जो पारंपरिक रूप से व्यावसायिक (commercial) उपयोग से जुड़ी है"},{"en":"A military network belonging to Colombia and Indonesia","hi":"कोलंबिया और इंडोनेशिया से संबंधित एक सैन्य नेटवर्क"},{"en":"An educational university located in Colorado, USA","hi":"कोलोराडो, अमेरिका में स्थित एक शैक्षणिक विश्वविद्यालय"},{"en":"A local offline file extension for C++ object code","hi":"C++ ऑब्जेक्ट कोड के लिए एक लोकल ऑफ़लाइन फ़ाइल एक्सटेंशन"}],"exp":{"en":"In `.co.in`, `.in` is the country-code Top-Level Domain (ccTLD) for India, and `.co.in` is a structured second-level domain category under `.in` traditionally intended for commercial companies/organizations.","hi":"`.co.in` भारत के कंट्री-कोड डोमेन `.in` नेमस्पेस के अंतर्गत एक पंजीकरण श्रेणी है, जो पारंपरिक रूप से व्यावसायिक (commercial) कंपनियों व संस्थाओं से जुड़ी है।"},"num":20},{"id":"q21","q":{"en":"What are the traditional textbook associations for the generic domain extensions '.com', '.org', '.info', and '.net'?","hi":"डोमेन एक्सटेंशन `.com`, `.org`, `.info` और `.net` के पारंपरिक पाठ्यपुस्तक अर्थ (Associations) क्या हैं?"},"a":{"en":".com → Commercial; .org → Organization/nonprofit; .info → Informational; .net → Network (though in practice these general-purpose extensions do not strictly verify the owner's category)","hi":".com → कमर्शियल; .org → ऑर्गेनाइजेशन/नॉन-प्रॉफिट; .info → इन्फॉर्मेशनल; .net → नेटवर्क"},"o":[{"en":".com → Commercial; .org → Organization/nonprofit; .info → Informational; .net → Network (though in practice these general-purpose extensions do not strictly verify the owner's category)","hi":".com → कमर्शियल; .org → ऑर्गेनाइजेशन/नॉन-प्रॉफिट; .info → इन्फॉर्मेशनल; .net → नेटवर्क"},{"en":".com → Computer; .org → Original; .info → Infrared; .net → Netbanking","hi":".com → कंप्यूटर; .org → ओरिजिनल; .info → इन्फ्रारेड; .net → नेटबैंकिंग"},{"en":".com → Comedy; .org → Organic farming; .info → Infantry military; .net → Netflix only","hi":".com → कॉमेडी; .org → ऑर्गेनिक; .info → इन्फैंट्री; .net → केवल नेटफ्लिक्स"},{"en":"All four are restricted exclusively to U.S. government defence agencies","hi":"चारों केवल अमेरिकी सरकारी रक्षा एजेंसियों के लिए आरक्षित हैं"}],"exp":{"en":"In standard textbook classifications: `.com` stands for Commercial, `.org` for Organization (traditionally non-profit), `.info` for Informational sites, and `.net` for Network providers/infrastructure (note that as open generic TLDs today, anyone can register them regardless of category).","hi":"पाठ्यपुस्तकों के अनुसार: `.com` = Commercial (व्यावसायिक), `.org` = Organization/Non-profit (संगठन), `.info` = Informational (सूचनात्मक), और `.net` = Network (नेटवर्क) से जुड़े हैं (हालाँकि सामान्य उपयोग में इनसे मालिक की वास्तविक श्रेणी की पुष्टि अनिवार्य नहीं होती)।"},"num":21},{"id":"q22","q":{"en":"With which types of institutions are the restricted Top-Level Domains '.edu', '.gov', and '.mil' associated?","hi":"`.edu`, `.gov` और `.mil` टॉप-लेवल डोमेन किन संस्थाओं के उपयोग से जुड़े हैं?"},"a":{"en":".edu → Educational institutions; .gov → Government organizations; .mil → Military/defence organizations (specifically sponsored for eligible US entities, with country-specific equivalents like .ac.in / .gov.in elsewhere)","hi":".edu → शैक्षणिक संस्थान; .gov → सरकारी संगठन; .mil → सैन्य (military) संगठन"},"o":[{"en":".edu → Educational institutions; .gov → Government organizations; .mil → Military/defence organizations (specifically sponsored for eligible US entities, with country-specific equivalents like .ac.in / .gov.in elsewhere)","hi":".edu → शैक्षणिक संस्थान; .gov → सरकारी संगठन; .mil → सैन्य (military) संगठन"},{"en":".edu → E-commerce; .gov → Gaming; .mil → Millionaire clubs","hi":".edu → ई-कॉमर्स; .gov → गेमिंग; .mil → मिलियनेयर क्लब"},{"en":".edu → Editing software; .gov → Graphics video; .mil → Milling machines","hi":".edu → एडिटिंग सॉफ्टवेयर; .gov → ग्राफिक्स वीडियो; .mil → मिलिंग मशीन"},{"en":"All three are used for personal blogs and freeware downloads","hi":"तीनों का उपयोग व्यक्तिगत ब्लॉग और फ्रीवेयर डाउनलोड के लिए किया जाता है"}],"exp":{"en":"The sponsored TLDs `.edu`, `.gov`, and `.mil` are restricted to eligible educational institutions, government bodies, and military organizations respectively (originally U.S. institutions, while other countries also use country-specific variants like `.edu.in`/`ac.in` and `.gov.in`).","hi":"`.edu` शैक्षणिक संस्थानों (Educational institutions), `.gov` सरकारी संगठनों (Government organizations), और `.mil` सैन्य संगठनों (Military) से संबंधित हैं।"},"num":22},{"id":"q23","q":{"en":"Is '.def' (mentioned in some coaching notes for defence) a standard delegated public TLD in the IANA root zone?","hi":"नोट्स में रक्षा (Defence) के लिए लिखा मिलने वाला '.def' क्या वास्तव में एक मानक पब्लिक TLD है?"},"a":{"en":"No — '.def' is NOT a delegated TLD in the IANA public root zone; the standard textbook TLD for military/defence is '.mil'","hi":"नहीं — IANA पब्लिक रूट ज़ोन में `.def` कोई मान्यता प्राप्त TLD नहीं है; सैन्य (military) श्रेणी का मानक उदाहरण `.mil` है"},"o":[{"en":"No — '.def' is NOT a delegated TLD in the IANA public root zone; the standard textbook TLD for military/defence is '.mil'","hi":"नहीं — IANA पब्लिक रूट ज़ोन में `.def` कोई मान्यता प्राप्त TLD नहीं है; सैन्य (military) श्रेणी का मानक उदाहरण `.mil` है"},{"en":"Yes — '.def' is the most popular TLD in the world, bigger than '.com'","hi":"हाँ — '.def' दुनिया का सबसे लोकप्रिय TLD है"},{"en":"Yes — '.def' is used by all commercial banks for NEFT transfers","hi":"हाँ — '.def' का उपयोग सभी बैंकों द्वारा NEFT के लिए किया जाता है"},{"en":"No — '.def' is the file extension for JPEG photographs","hi":"नहीं — '.def' JPEG तस्वीरों का फ़ाइल एक्सटेंशन है"}],"exp":{"en":"Fact-Check Note: Some coaching slides mistakenly write `.def` for defence, but `.def` does not exist as a delegated Top-Level Domain in the IANA public root zone. The official standard TLD for military/defence is `.mil`.","hi":"तथ्य-जाँच नोट: IANA के पब्लिक रूट ज़ोन में `.def` नाम का कोई भी डेलिगेटेड TLD नहीं है। सैन्य/रक्षा (military) श्रेणी के लिए मानक टॉप-लेवल डोमेन `.mil` होता है।"},"num":23},{"id":"q24","q":{"en":"What is the full form and primary function of 'DNS'?","hi":"'DNS' का पूर्ण रूप (Full Form) और मुख्य कार्य क्या है?"},"a":{"en":"Domain Name System — It resolves human-readable domain names into IP addresses and other routing records (like mail MX records)","hi":"डोमेन नेम सिस्टम (Domain Name System) — यह डोमेन नामों को IP एड्रेस या मेल रूटिंग रिकॉर्ड्स में रिज़ॉल्व (अनुवादित) करता है"},"o":[{"en":"Domain Name System — It resolves human-readable domain names into IP addresses and other routing records (like mail MX records)","hi":"डोमेन नेम सिस्टम (Domain Name System) — यह डोमेन नामों को IP एड्रेस या मेल रूटिंग रिकॉर्ड्स में रिज़ॉल्व (अनुवादित) करता है"},{"en":"Digital Network Switch — It converts AC power into DC power for routers","hi":"डिजिटल नेटवर्क स्विच — यह राउटर के लिए एसी पावर को डीसी में बदलता है"},{"en":"Direct Number Storage — It stores ATM PIN numbers on magnetic tape","hi":"डायरेक्ट नंबर स्टोरेज — यह मैग्नेटिक टेप पर एटीएम पिन स्टोर करता है"},{"en":"Data Navigation Software — It is a photo editing tool like Photoshop","hi":"डेटा नेविगेशन सॉफ्टवेयर — यह फोटोशॉप जैसा एक फोटो एडिटिंग टूल है"}],"exp":{"en":"DNS stands for Domain Name System (often called the phonebook of the Internet). It translates/resolves human-friendly domain names (like `www.example.com`) into numerical IP addresses (and mail-exchange MX records) that computers use to route traffic.","hi":"DNS का पूर्ण रूप Domain Name System है। यह मानव-पठनीय डोमेन नामों को संबंधित IP एड्रेस (या ईमेल रूटिंग रिकॉर्ड्स) में रिज़ॉल्व (resolve/अनुवादित) करता है, और DNS सर्वर इस प्रणाली का एक घटक है।"},"num":24},{"id":"q25","q":{"en":"What is a 'Webpage'?","hi":"'वेबपेज' (Webpage) क्या होता है?"},"a":{"en":"A Web document or resource page (typically written in HTML) that can be viewed and rendered inside a web browser","hi":"एक वेब दस्तावेज़ या रिसोर्स पेज जिसे वेब ब्राउज़र में देखा (view किया) जा सकता है"},"o":[{"en":"A Web document or resource page (typically written in HTML) that can be viewed and rendered inside a web browser","hi":"एक वेब दस्तावेज़ या रिसोर्स पेज जिसे वेब ब्राउज़र में देखा (view किया) जा सकता है"},{"en":"A physical sheet of A4 paper inside a laser printer tray","hi":"लेजर प्रिंटर ट्रे के अंदर रखा A4 कागज का एक भौतिक पन्ना"},{"en":"A hardware network cable used to connect a modem to a wall jack","hi":"मॉडेम को दीवार के जैक से जोड़ने वाली एक हार्डवेयर नेटवर्क केबल"},{"en":"The silicon wafer inside a dual-core microprocessor","hi":"डुअल-कोर माइक्रोप्रोसेसर के अंदर का सिलिकॉन वेफर"}],"exp":{"en":"A webpage is an individual hypertext document or resource on the World Wide Web—formatted with HTML, CSS, and scripts—that is retrieved from a web server and displayed by a web browser.","hi":"वेबपेज वर्ल्ड वाइड वेब पर मौजूद एक ऐसा डिजिटल दस्तावेज़ या रिसोर्स पेज है जिसे वेब ब्राउज़र में खोलकर देखा जा सकता है।"},"num":25},{"id":"q26","q":{"en":"What is the difference between a 'Website' and a 'Webpage'?","hi":"'वेबसाइट' (Website) और 'वेबपेज' (Webpage) में क्या फर्क है?"},"a":{"en":"A website is a collection of related webpages and resources under a common domain, whereas a webpage is an individual page within that collection","hi":"वेबसाइट संबंधित वेबपेजों और संसाधनों का एक संग्रह (collection) है, जबकि वेबपेज उसका एक एकल पेज (individual page) होता है"},"o":[{"en":"A website is a collection of related webpages and resources under a common domain, whereas a webpage is an individual page within that collection","hi":"वेबसाइट संबंधित वेबपेजों और संसाधनों का एक संग्रह (collection) है, जबकि वेबपेज उसका एक एकल पेज (individual page) होता है"},{"en":"A webpage is a collection of 1,000 websites, whereas a website is a single line of text","hi":"वेबपेज 1,000 वेबसाइटों का संग्रह है, जबकि वेबसाइट टेक्स्ट की एक लाइन है"},{"en":"A website is hardware, whereas a webpage is an operating system kernel","hi":"वेबसाइट हार्डवेयर है, जबकि वेबपेज एक ऑपरेटिंग सिस्टम कर्नेल है"},{"en":"There is no difference; both mean an email inbox","hi":"कोई अंतर नहीं है; दोनों का अर्थ ईमेल इनबॉक्स है"}],"exp":{"en":"Analogy: A Website is like a complete book (an interconnected collection of related pages and media published under a domain), whereas a Webpage is a single page within that website.","hi":"वेबसाइट आपस में जुड़े संबंधित वेबपेजों और संसाधनों का एक संग्रह (collection) होती है, जबकि वेबपेज उस वेबसाइट का एक एकल पृष्ठ (individual page) होता है।"},"num":26},{"id":"q27","q":{"en":"What is the full form and primary role of 'HTML'?","hi":"'HTML' का पूर्ण रूप (Full Form) और मुख्य भूमिका क्या है?"},"a":{"en":"HyperText Markup Language — It defines and marks up the structure and content of a webpage","hi":"हाइपरटेक्स्ट मार्कअप लैंग्वेज (HyperText Markup Language) — यह किसी वेबपेज की संरचना (structure) और कंटेंट को मार्क-अप करती है"},"o":[{"en":"HyperText Markup Language — It defines and marks up the structure and content of a webpage","hi":"हाइपरटेक्स्ट मार्कअप लैंग्वेज (HyperText Markup Language) — यह किसी वेबपेज की संरचना (structure) और कंटेंट को मार्क-अप करती है"},{"en":"High Transmission Mail Link — It routes emails between SMTP servers","hi":"हाई ट्रांसमिशन मेल लिंक — यह SMTP सर्वरों के बीच ईमेल रूट करता है"},{"en":"Hardware Terminal Memory Logic — It manages CPU cache memory","hi":"हार्डवेयर टर्मिनल मेमोरी लॉजिक — यह CPU कैश मेमोरी का प्रबंधन करता है"},{"en":"Hyperlink Transfer Modem Line — It modulates analog telephone signals","hi":"हाइपरलिंक ट्रांसफर मॉडेम लाइन — यह एनालॉग टेलीफोन सिग्नल को मॉड्यूलेट करता है"}],"exp":{"en":"HTML stands for HyperText Markup Language. It uses tags and elements to structure and mark up the headings, paragraphs, links, images, tables, and forms of a webpage.","hi":"HTML का पूर्ण रूप HyperText Markup Language है। इसका मुख्य कार्य किसी वेबपेज की संरचना (structure) और सामग्री (content) को तैयार व मार्क-अप करना है।"},"num":27},{"id":"q28","q":{"en":"What is the full form and use of a 'URL'?","hi":"'URL' का पूर्ण रूप (Full Form) और उपयोग क्या है?"},"a":{"en":"Uniform Resource Locator — It specifies the unique web address of a resource and the protocol/scheme used to access it","hi":"यूनिफॉर्म रिसोर्स लोकेटर (Uniform Resource Locator) — यह इंटरनेट पर किसी संसाधन का पता (address) और उसे एक्सेस करने का स्कीम/प्रोटोकॉल बताता है"},"o":[{"en":"Uniform Resource Locator — It specifies the unique web address of a resource and the protocol/scheme used to access it","hi":"यूनिफॉर्म रिसोर्स लोकेटर (Uniform Resource Locator) — यह इंटरनेट पर किसी संसाधन का पता (address) और उसे एक्सेस करने का स्कीम/प्रोटोकॉल बताता है"},{"en":"Universal Router Link — A physical port on the back of a switch","hi":"यूनिवर्सल राउटर लिंक — स्विच के पीछे लगा एक भौतिक पोर्ट"},{"en":"Unified Register Logic — An arithmetic unit inside the microprocessor","hi":"यूनिफाइड रजिस्टर लॉजिक — माइक्रोप्रोसेसर के अंदर की एक अंकगणितीय इकाई"},{"en":"Uninterruptible Radio Line — A backup battery for mobile towers","hi":"अनइंटरप्टिबल रेडियो लाइन — मोबाइल टावरों के लिए एक बैकअप बैटरी"}],"exp":{"en":"URL stands for Uniform Resource Locator (colloquially called a web address). It specifies both the location of a resource on a network and the protocol scheme (like `http` or `https`) used to retrieve it.","hi":"URL का पूर्ण रूप Uniform Resource Locator है। यह इंटरनेट पर किसी वेब पेज या संसाधन का सटीक पता (address) और उसे एक्सेस करने का माध्यम/स्कीम (जैसे `http` या `https`) बताता है।"},"num":28},{"id":"q29","q":{"en":"In the URL 'http://in.rediff.com/news/index.html', what are the respective parts?","hi":"URL `http://in.rediff.com/news/index.html` के विभिन्न भाग कौन-से हैं?"},"a":{"en":"Scheme/protocol: 'http'; Hostname: 'in.rediff.com'; Path: '/news/index.html' (where 'news' is a directory-like segment and 'index.html' is the file segment)","hi":"स्कीम/प्रोटोकॉल: `http`, होस्टनेम: `in.rediff.com`, पाथ: `/news/index.html` (जिसमें `news` डायरेक्टरी जैसा हिस्सा और `index.html` फ़ाइल है)"},"o":[{"en":"Scheme/protocol: 'http'; Hostname: 'in.rediff.com'; Path: '/news/index.html' (where 'news' is a directory-like segment and 'index.html' is the file segment)","hi":"स्कीम/प्रोटोकॉल: `http`, होस्टनेम: `in.rediff.com`, पाथ: `/news/index.html` (जिसमें `news` डायरेक्टरी जैसा हिस्सा और `index.html` फ़ाइल है)"},{"en":"Scheme: 'index.html'; Hostname: 'http'; Path: '.com'","hi":"स्कीम: `index.html`, होस्टनेम: `http`, पाथ: `.com`"},{"en":"TLD: 'http'; Subdomain: 'index.html'; Protocol: 'rediff'","hi":"TLD: `http`, सबडोमेन: `index.html`, प्रोटोकॉल: `rediff`"},{"en":"Email local part: 'http'; Mail server: 'news'","hi":"ईमेल लोकल पार्ट: `http`, मेल सर्वर: `news`"}],"exp":{"en":"Breaking down `http://in.rediff.com/news/index.html`: `http` is the URL scheme/protocol (labeled 'server type' in the source diagram), `in.rediff.com` is the hostname/domain name, and `/news/index.html` is the resource path (with `news` as the directory path segment and `index.html` as the target HTML file).","hi":"इस URL में: `http` स्कीम या प्रोटोकॉल है, `in.rediff.com` होस्टनेम (डोमेन नाम) है, और `/news/index.html` पाथ (path) है—जिसमें `news` डायरेक्टरी/फ़ोल्डर जैसा भाग है और `index.html` वेबपेज फ़ाइल का नाम है।"},"num":29},{"id":"q30","q":{"en":"In the URL 'https://example.com/search?q=exam#results', which part is the Query and which part is the Fragment?","hi":"URL `https://example.com/search?q=exam#results` में कौन-सा भाग 'क्वेरी' (Query) है और कौन-सा 'फ्रैगमेंट' (Fragment) है?"},"a":{"en":"'?q=exam' is the query component (starting with '?'), and '#results' is the fragment identifier (starting with '#')","hi":"`?q=exam` क्वेरी (query) है और `#results` फ्रैगमेंट (fragment) है"},"o":[{"en":"'?q=exam' is the query component (starting with '?'), and '#results' is the fragment identifier (starting with '#')","hi":"`?q=exam` क्वेरी (query) है और `#results` फ्रैगमेंट (fragment) है"},{"en":"'https' is the query, and 'example.com' is the fragment","hi":"`https` क्वेरी है, और `example.com` फ्रैगमेंट है"},{"en":"'#results' is the top-level domain, and '?q=exam' is the protocol","hi":"`#results` टॉप-लेवल डोमेन है, और `?q=exam` प्रोटोकॉल है"},{"en":"Both are hardware IP addresses","hi":"दोनों हार्डवेयर IP एड्रेस हैं"}],"exp":{"en":"According to URL syntax (RFC 3986), the Query string begins with a question mark (`?q=exam`) to pass parameters to the server, and the Fragment identifier begins with a hash symbol (`#results`) to point to a specific section/anchor within the page.","hi":"URL सिंटैक्स के अनुसार, प्रश्नवाचक चिह्न से शुरू होने वाला `?q=exam` भाग 'क्वेरी' (query) कहलाता है, और हैश चिह्न से शुरू होने वाला `#results` भाग 'फ्रैगमेंट' (fragment — पेज के किसी विशेष हिस्से का लिंक) कहलाता है।"},"num":30},{"id":"q31","q":{"en":"What is the difference between a 'Domain Name' and a 'Full URL'?","hi":"'डोमेन नाम' (Domain Name) और एक 'पूर्ण URL' (Full URL) में क्या अंतर है?"},"a":{"en":"A domain name is just the host identification part (e.g., example.com), whereas a full URL includes the scheme (https://), host, and optional port, path, query, or fragment","hi":"डोमेन नाम केवल होस्टनेम का हिस्सा होता है, जबकि पूर्ण URL में स्कीम, होस्ट और ज़रूरत के अनुसार पाथ, क्वेरी, फ्रैगमेंट या पोर्ट भी शामिल होते हैं"},"o":[{"en":"A domain name is just the host identification part (e.g., example.com), whereas a full URL includes the scheme (https://), host, and optional port, path, query, or fragment","hi":"डोमेन नाम केवल होस्टनेम का हिस्सा होता है, जबकि पूर्ण URL में स्कीम, होस्ट और ज़रूरत के अनुसार पाथ, क्वेरी, फ्रैगमेंट या पोर्ट भी शामिल होते हैं"},{"en":"A domain name is always longer than a full URL","hi":"डोमेन नाम हमेशा पूर्ण URL से लंबा होता है"},{"en":"A full URL cannot contain a domain name","hi":"पूर्ण URL में डोमेन नाम नहीं हो सकता"},{"en":"A domain name is used only for printers, while a URL is used only for keyboards","hi":"डोमेन नाम केवल प्रिंटर के लिए और URL केवल कीबोर्ड के लिए होता है"}],"exp":{"en":"A domain name (e.g., `example.com`) identifies the host/domain, whereas a full URL (e.g., `https://www.example.com:443/docs/page.html?id=1#top`) is a complete resource locator containing the protocol scheme, hostname, and optional port, file path, query parameters, and fragment.","hi":"डोमेन नाम केवल वेबसाइट के होस्टनेम का हिस्सा होता है (जैसे `example.com`), जबकि एक पूर्ण URL में प्रोटोकॉल स्कीम (`https://`), होस्टनेम, और आवश्यकतानुसार पाथ, क्वेरी पैरामीटर, फ्रैगमेंट या पोर्ट सभी शामिल हो सकते हैं।"},"num":31}]},{"title":{"en":"3. Internet Protocols","hi":"3. इंटरनेट प्रोटोकॉल"},"questions":[{"id":"q32","q":{"en":"What is the full form and primary use of 'HTTP'?","hi":"'HTTP' का पूर्ण रूप (Full Form) और मुख्य उपयोग क्या है?"},"a":{"en":"Hypertext Transfer Protocol — It exchanges web requests and responses between web clients (browsers) and web servers","hi":"हाइपरटेक्स्ट ट्रांसफर प्रोटोकॉल (Hypertext Transfer Protocol) — यह वेब क्लाइंट्स (ब्राउज़र) और वेब सर्वरों के बीच रिक्वेस्ट और रिस्पॉन्स का आदान-प्रदान करता है"},"o":[{"en":"Hypertext Transfer Protocol — It exchanges web requests and responses between web clients (browsers) and web servers","hi":"हाइपरटेक्स्ट ट्रांसफर प्रोटोकॉल (Hypertext Transfer Protocol) — यह वेब क्लाइंट्स (ब्राउज़र) और वेब सर्वरों के बीच रिक्वेस्ट और रिस्पॉन्स का आदान-प्रदान करता है"},{"en":"High Text Terminal Program — It formats hard disks in MS-DOS","hi":"हाई टेक्स्ट टर्मिनल प्रोग्राम — यह MS-DOS में हार्ड डिस्क फ़ॉर्मेट करता है"},{"en":"Hybrid Telematics Transfer Port — A physical 25-pin printer port","hi":"हाइब्रिड टेलीमैटिक्स ट्रांसफर पोर्ट — एक भौतिक 25-पिन प्रिंटर पोर्ट"},{"en":"Home Telephone Transmission Protocol — Used only for analog landline bells","hi":"होम टेलीफोन ट्रांसमिशन प्रोटोकॉल — केवल लैंडलाइन घंटी के लिए"}],"exp":{"en":"HTTP stands for Hypertext Transfer Protocol. It is the application-layer request/response protocol used by web browsers and web servers to communicate and transfer web pages over the World Wide Web.","hi":"HTTP का पूर्ण रूप Hypertext Transfer Protocol है। इसका उपयोग वेब क्लाइंट्स (जैसे ब्राउज़र) और वेब सर्वरों के बीच वेब रिक्वेस्ट और रिस्पॉन्स के आदान-प्रदान के लिए किया जाता है।"},"num":32},{"id":"q33","q":{"en":"What security features does 'HTTPS' add to standard HTTP?","hi":"'HTTPS' सामान्य HTTP में क्या सुरक्षा (Security) जोड़ता है?"},"a":{"en":"It protects HTTP traffic using TLS (or historically SSL), providing encryption and server authentication at the connection level","hi":"यह HTTP ट्रैफ़िक को TLS (या SSL) से सुरक्षित करता है, जिससे कनेक्शन स्तर पर एन्क्रिप्शन (encryption) और सर्वर प्रमाणीकरण (authentication) मिलता है"},"o":[{"en":"It protects HTTP traffic using TLS (or historically SSL), providing encryption and server authentication at the connection level","hi":"यह HTTP ट्रैफ़िक को TLS (या SSL) से सुरक्षित करता है, जिससे कनेक्शन स्तर पर एन्क्रिप्शन (encryption) और सर्वर प्रमाणीकरण (authentication) मिलता है"},{"en":"It doubles the physical screen size of the computer monitor","hi":"यह कंप्यूटर मॉनिटर के भौतिक स्क्रीन आकार को दोगुना कर देता है"},{"en":"It replaces the web browser with a command-line assembler","hi":"यह वेब ब्राउज़र को कमांड-लाइन असेंबलर से बदल देता है"},{"en":"It makes all paid websites free of charge","hi":"यह सभी सशुल्क वेबसाइटों को निःशुल्क बना देता है"}],"exp":{"en":"HTTPS (Hypertext Transfer Protocol Secure) layers HTTP over TLS (Transport Layer Security, formerly SSL), encrypting the communication channel against eavesdropping/tampering and authenticating the web server via digital certificates.","hi":"HTTPS सामान्य HTTP ट्रैफ़िक को TLS (Transport Layer Security / SSL) की मदद से सुरक्षित करता है, जिससे कनेक्शन के स्तर पर डेटा एन्क्रिप्शन (गोपनीयता) और सर्वर ऑथेंटिकेशन (प्रमाणीकरण) प्राप्त होता है।"},"num":33},{"id":"q34","q":{"en":"What is the full form and primary role of 'FTP'?","hi":"'FTP' का पूर्ण रूप (Full Form) और मुख्य भूमिका क्या है?"},"a":{"en":"File Transfer Protocol — The traditional standard network protocol used for transferring files between a client and a server over a network","hi":"फ़ाइल ट्रांसफर प्रोटोकॉल (File Transfer Protocol) — नेटवर्क पर कंप्यूटरों/सर्वरों के बीच फ़ाइलें ट्रांसफर करने का पारंपरिक प्रोटोकॉल"},"o":[{"en":"File Transfer Protocol — The traditional standard network protocol used for transferring files between a client and a server over a network","hi":"फ़ाइल ट्रांसफर प्रोटोकॉल (File Transfer Protocol) — नेटवर्क पर कंप्यूटरों/सर्वरों के बीच फ़ाइलें ट्रांसफर करने का पारंपरिक प्रोटोकॉल"},{"en":"Fast Text Processor — A word processing app like WordPad","hi":"फास्ट टेक्स्ट प्रोसेसर — वर्डपैड जैसा एक वर्ड प्रोसेसिंग ऐप"},{"en":"Folder Tracking Program — An antivirus scanner for floppy disks","hi":"फ़ोल्डर ट्रैकिंग प्रोग्राम — फ्लॉपी डिस्क के लिए एक एंटीवायरस स्कैनर"},{"en":"Floppy Tape Partition — A magnetic backup cassette","hi":"फ्लॉपी टेप पार्टीशन — एक चुंबकीय बैकअप कैसेट"}],"exp":{"en":"FTP stands for File Transfer Protocol. It is a standard network protocol used to upload, download, and transfer files between a client and a server over a TCP/IP network.","hi":"FTP का पूर्ण रूप File Transfer Protocol है। यह नेटवर्क पर एक कंप्यूटर से दूसरे कंप्यूटर या सर्वर के बीच फ़ाइलों को ट्रांसफर (अपलोड/डाउनलोड) करने का पारंपरिक प्रोटोकॉल है।"},"num":34},{"id":"q35","q":{"en":"What was the primary use of 'Telnet', and which protocol is used instead for secure encrypted remote login today?","hi":"'Telnet' का मुख्य उपयोग क्या था, और आज सुरक्षित (Encrypted) रिमोट लॉगिन के लिए किसका उपयोग होता है?"},"a":{"en":"Telnet was used for remote terminal login over a TCP connection; because Telnet traffic is typically unencrypted (plaintext), SSH (Secure Shell) is used for secure remote login","hi":"Telnet का उपयोग TCP कनेक्शन पर रिमोट टर्मिनल लॉगिन के लिए होता था; चूँकि इसका ट्रैफ़िक अनएन्क्रिप्टेड होता है, इसलिए सुरक्षित रिमोट लॉगिन के लिए SSH का उपयोग होता है"},"o":[{"en":"Telnet was used for remote terminal login over a TCP connection; because Telnet traffic is typically unencrypted (plaintext), SSH (Secure Shell) is used for secure remote login","hi":"Telnet का उपयोग TCP कनेक्शन पर रिमोट टर्मिनल लॉगिन के लिए होता था; चूँकि इसका ट्रैफ़िक अनएन्क्रिप्टेड होता है, इसलिए सुरक्षित रिमोट लॉगिन के लिए SSH का उपयोग होता है"},{"en":"Telnet was used for printing colour banners, and Plotter is used today","hi":"Telnet का उपयोग रंगीन बैनर प्रिंट करने के लिए होता था, और आज प्लॉटर का उपयोग होता है"},{"en":"Telnet was used for offline spreadsheets, and Excel is used today","hi":"Telnet का उपयोग ऑफ़लाइन स्प्रेडशीट के लिए होता था, और आज एक्सेल का उपयोग होता है"},{"en":"Telnet was an audio player, and VLC is used today","hi":"Telnet एक ऑडियो प्लेयर था, और आज VLC का उपयोग होता है"}],"exp":{"en":"Telnet provides interactive text-oriented remote terminal login to a host over TCP. Because Telnet transmits usernames, passwords, and commands in unencrypted plaintext, modern systems use SSH (Secure Shell) for encrypted remote administration.","hi":"Telnet का उपयोग TCP कनेक्शन पर रिमोट टर्मिनल लॉगिन (दूरस्थ कंप्यूटर को कमांड लाइन से चलाने) के लिए होता था। चूँकि Telnet ट्रैफ़िक आमतौर पर अनएन्क्रिप्टेड (सादे टेक्स्ट में) होता है, इसलिए सुरक्षित रिमोट लॉगिन के लिए अब SSH (Secure Shell) का उपयोग किया जाता है।"},"num":35},{"id":"q36","q":{"en":"What is the full form and key function of 'TCP'?","hi":"'TCP' का पूर्ण रूप (Full Form) और मुख्य कार्य क्या है?"},"a":{"en":"Transmission Control Protocol — It provides a reliable, connection-oriented, ordered byte stream, including error recovery/retransmission and flow control","hi":"ट्रांसमिशन कंट्रोल प्रोटोकॉल (Transmission Control Protocol) — यह रीट्रांसमिशन और फ्लो कंट्रोल के साथ विश्वसनीय (reliable) और क्रमबद्ध (ordered) डेटा ट्रांसपोर्ट देता है"},"o":[{"en":"Transmission Control Protocol — It provides a reliable, connection-oriented, ordered byte stream, including error recovery/retransmission and flow control","hi":"ट्रांसमिशन कंट्रोल प्रोटोकॉल (Transmission Control Protocol) — यह रीट्रांसमिशन और फ्लो कंट्रोल के साथ विश्वसनीय (reliable) और क्रमबद्ध (ordered) डेटा ट्रांसपोर्ट देता है"},{"en":"Terminal Command Prompt — It interprets batch files in MS-DOS","hi":"टर्मिनल कमांड प्रॉम्प्ट — यह MS-DOS में बैच फ़ाइलों की व्याख्या करता है"},{"en":"Total Cache Processor — It refreshes DRAM capacitors","hi":"टोटल कैश प्रोसेसर — यह DRAM कैपेसिटर को रिफ्रेश करता है"},{"en":"Telecom Cable Plug — A physical RJ-11 telephone jack","hi":"टेलीकॉम केबल प्लग — एक भौतिक RJ-11 टेलीफोन जैक"}],"exp":{"en":"TCP stands for Transmission Control Protocol. Operating at the transport layer, it establishes a connection and guarantees reliable, in-order delivery of data using sequence numbers, acknowledgements, retransmissions, and flow/congestion control.","hi":"TCP का पूर्ण रूप Transmission Control Protocol है। यह डेटा का विश्वसनीय (reliable) और क्रमबद्ध (ordered) ट्रांसमिशन सुनिश्चित करता है, जिसमें खोए हुए पैकेट्स का रीट्रांसमिशन और फ्लो कंट्रोल शामिल होता है।"},"num":36},{"id":"q37","q":{"en":"What is the full form and primary role of 'IP' in the TCP/IP suite?","hi":"TCP/IP सुइट में 'IP' का पूर्ण रूप और मुख्य कार्य क्या है?"},"a":{"en":"Internet Protocol — It handles logical addressing and routing of packets across networks (while end-to-end delivery guarantees depend on the transport/application layer like TCP)","hi":"इंटरनेट प्रोटोकॉल (Internet Protocol) — यह पैकेट्स को एड्रेस और रूट (route) करता है (जबकि एंड-टू-एंड डिलीवरी गारंटी ट्रांसपोर्ट/एप्लिकेशन लेयर पर निर्भर करती है)"},"o":[{"en":"Internet Protocol — It handles logical addressing and routing of packets across networks (while end-to-end delivery guarantees depend on the transport/application layer like TCP)","hi":"इंटरनेट प्रोटोकॉल (Internet Protocol) — यह पैकेट्स को एड्रेस और रूट (route) करता है (जबकि एंड-टू-एंड डिलीवरी गारंटी ट्रांसपोर्ट/एप्लिकेशन लेयर पर निर्भर करती है)"},{"en":"Internal Printer — It prints hard copies on thermal paper","hi":"इंटरनल प्रिंटर — यह थर्मल पेपर पर हार्ड कॉपी प्रिंट करता है"},{"en":"Image Processor — It compresses BMP files into JPEG","hi":"इमेज प्रोसेसर — यह BMP फ़ाइलों को JPEG में संपीड़ित करता है"},{"en":"Instruction Pointer — It stores BIOS passwords in ROM","hi":"इंस्ट्रक्शन पॉइंटर — यह ROM में BIOS पासवर्ड स्टोर करता है"}],"exp":{"en":"IP stands for Internet Protocol. Operating at the network/internet layer, its job is logical addressing and routing datagram packets from source to destination across interconnected networks on a best-effort basis.","hi":"IP का पूर्ण रूप Internet Protocol है। इसका मुख्य कार्य डेटा पैकेट्स को लॉजिकल एड्रेस देना और उन्हें विभिन्न नेटवर्क्स के बीच सही मार्ग से रूट (route) करना है।"},"num":37},{"id":"q38","q":{"en":"What is the correct full form and behavior of 'UDP'?","hi":"'UDP' का सही पूर्ण रूप (Full Form) और व्यवहार (Behavior) क्या है?"},"a":{"en":"User Datagram Protocol — It sends connectionless datagrams with low overhead, without built-in delivery, retransmission, or ordering guarantees","hi":"यूज़र डेटाग्राम प्रोटोकॉल (User Datagram Protocol) — यह बिना किसी बिल्ट-इन डिलीवरी या क्रम (ordering) की गारंटी के कनेक्शनलेस डेटाग्राम भेजता है"},"o":[{"en":"User Datagram Protocol — It sends connectionless datagrams with low overhead, without built-in delivery, retransmission, or ordering guarantees","hi":"यूज़र डेटाग्राम प्रोटोकॉल (User Datagram Protocol) — यह बिना किसी बिल्ट-इन डिलीवरी या क्रम (ordering) की गारंटी के कनेक्शनलेस डेटाग्राम भेजता है"},{"en":"Universal Data Packet — It guarantees 100% ordered delivery with three-way handshakes","hi":"यूनिवर्सल डेटा पैकेट — यह थ्री-वे हैंडशेक के साथ 100% क्रमबद्ध डिलीवरी की गारंटी देता है"},{"en":"Unified Disk Partition — It formats solid-state drives","hi":"यूनिफाइड डिस्क पार्टीशन — यह सॉलिड-स्टेट ड्राइव को फ़ॉर्मेट करता है"},{"en":"User Display Port — A video cable for gaming monitors","hi":"यूज़र डिस्प्ले पोर्ट — गेमिंग मॉनिटर के लिए एक वीडियो केबल"}],"exp":{"en":"UDP stands for User Datagram Protocol (RFC 768 — beware of the common exam trap 'User Datagram Packet'). It is a lightweight, connectionless transport protocol that sends independent datagrams without handshakes or built-in retransmission/ordering guarantees.","hi":"UDP का सही पूर्ण रूप User Datagram Protocol है (ध्यान दें: 'Packet' नहीं)। यह एक कनेक्शनलेस (connectionless) प्रोटोकॉल है जो बिना किसी बिल्ट-इन डिलीवरी या क्रम (ordering) की गारंटी के तेज़ी से डेटाग्राम भेजता है।"},"num":38},{"id":"q39","q":{"en":"What are the quick exam cues to distinguish between 'TCP' and 'UDP'?","hi":"परीक्षा में 'TCP' और 'UDP' के बीच अंतर करने के मुख्य संकेत (Exam Cues) क्या हैं?"},"a":{"en":"TCP → connection-oriented, reliable, ordered transport; UDP → connectionless, lightweight datagrams with no built-in delivery or order guarantee","hi":"TCP → विश्वसनीय और क्रमबद्ध ट्रांसपोर्ट; UDP → हल्के कनेक्शनलेस डेटाग्राम जिनमें बिल्ट-इन डिलीवरी या क्रम की गारंटी नहीं होती"},"o":[{"en":"TCP → connection-oriented, reliable, ordered transport; UDP → connectionless, lightweight datagrams with no built-in delivery or order guarantee","hi":"TCP → विश्वसनीय और क्रमबद्ध ट्रांसपोर्ट; UDP → हल्के कनेक्शनलेस डेटाग्राम जिनमें बिल्ट-इन डिलीवरी या क्रम की गारंटी नहीं होती"},{"en":"TCP → connectionless and unreliable; UDP → connection-oriented and guaranteed","hi":"TCP → कनेक्शनलेस और अविश्वसनीय; UDP → कनेक्शन-ओरिएंटेड और गारंटीशुदा"},{"en":"TCP is an email folder, whereas UDP is a web browser","hi":"TCP एक ईमेल फ़ोल्डर है, जबकि UDP एक वेब ब्राउज़र है"},{"en":"Both are hardware power supply units","hi":"दोनों हार्डवेयर पावर सप्लाई यूनिट हैं"}],"exp":{"en":"Exam cue: Choose TCP when the question asks for reliable, acknowledged, ordered, connection-oriented data transfer (e.g., web pages, file transfer, email). Choose UDP when it asks for fast, low-overhead, connectionless datagram transmission without built-in recovery (e.g., live streaming, DNS queries, online gaming).","hi":"परीक्षा संकेत: TCP का अर्थ है कनेक्शन-आधारित, विश्वसनीय (reliable) और क्रमबद्ध ट्रांसपोर्ट; जबकि UDP का अर्थ है कम ओवरहेड वाले कनेक्शनलेस डेटाग्राम, जिनमें बिल्ट-इन डिलीवरी या क्रम की गारंटी नहीं होती।"},"num":39},{"id":"q40","q":{"en":"What are the full forms of the historical point-to-point networking protocols 'SLIP' and 'PPP'?","hi":"पॉइंट-टू-पॉइंट लिंक के ऐतिहासिक नेटवर्किंग प्रोटोकॉल 'SLIP' और 'PPP' के पूर्ण रूप क्या हैं?"},"a":{"en":"Serial Line Internet Protocol (SLIP) and Point-to-Point Protocol (PPP)","hi":"सीरियल लाइन इंटरनेट प्रोटोकॉल (Serial Line Internet Protocol) और पॉइंट-टू-पॉइंट प्रोटोकॉल (Point-to-Point Protocol)"},"o":[{"en":"Serial Line Internet Protocol (SLIP) and Point-to-Point Protocol (PPP)","hi":"सीरियल लाइन इंटरनेट प्रोटोकॉल (Serial Line Internet Protocol) और पॉइंट-टू-पॉइंट प्रोटोकॉल (Point-to-Point Protocol)"},{"en":"System Link Internal Port and Parallel Printer Port","hi":"सिस्टम लिंक इंटरनल पोर्ट और पैरेलल प्रिंटर पोर्ट"},{"en":"Single Layer Internet Packet and Public Packet Protocol","hi":"सिंगल लेयर इंटरनेट पैकेट और पब्लिक पैकेट प्रोटोकॉल"},{"en":"Software Licence Installation Package and Personal Privacy Protocol","hi":"सॉफ्टवेयर लाइसेंस इंस्टॉलेशन पैकेज और पर्सनल प्राइवेसी प्रोटोकॉल"}],"exp":{"en":"SLIP stands for Serial Line Internet Protocol, and PPP stands for Point-to-Point Protocol. Both are data-link/networking protocols historically used to establish direct dial-up and point-to-point serial internet connections.","hi":"SLIP का पूर्ण रूप Serial Line Internet Protocol है और PPP का पूर्ण रूप Point-to-Point Protocol है। ये दोनों पॉइंट-टू-पॉइंट लिंक्स (जैसे पुराने डायल-अप कनेक्शन) के ऐतिहासिक नेटवर्किंग प्रोटोकॉल हैं।"},"num":40},{"id":"q41","q":{"en":"What is the full form and primary use of 'SNMP'?","hi":"'SNMP' का पूर्ण रूप (Full Form) और मुख्य उपयोग क्या है?"},"a":{"en":"Simple Network Management Protocol — Used for monitoring and managing network devices such as routers, switches, and servers","hi":"सिंपल नेटवर्क मैनेजमेंट प्रोटोकॉल (Simple Network Management Protocol) — नेटवर्क डिवाइसेस को मॉनिटर और मैनेज करने के लिए"},"o":[{"en":"Simple Network Management Protocol — Used for monitoring and managing network devices such as routers, switches, and servers","hi":"सिंपल नेटवर्क मैनेजमेंट प्रोटोकॉल (Simple Network Management Protocol) — नेटवर्क डिवाइसेस को मॉनिटर और मैनेज करने के लिए"},{"en":"Simple New Mail Protocol — Used exclusively for sending spam emails","hi":"सिंपल न्यू मेल प्रोटोकॉल — केवल स्पैम ईमेल भेजने के लिए"},{"en":"Serial Node Memory Port — A hardware slot for RAM sticks","hi":"सीरियल नोड मेमोरी पोर्ट — RAM स्टिक के लिए एक हार्डवेयर स्लॉट"},{"en":"System Number Modulation Program — An audio player utility","hi":"सिस्टम नंबर मॉड्यूलेशन प्रोग्राम — एक ऑडियो प्लेयर यूटिलिटी"}],"exp":{"en":"SNMP stands for Simple Network Management Protocol. It is an application-layer protocol used to monitor, configure, and manage network devices (routers, switches, servers, printers) on an IP network.","hi":"SNMP का पूर्ण रूप Simple Network Management Protocol है। इसका उपयोग नेटवर्क पर जुड़े उपकरणों (जैसे राउटर, स्विच और सर्वर) को मॉनिटर और मैनेज करने के लिए किया जाता है।"},"num":41},{"id":"q42","q":{"en":"What is the full form of 'WAP', and what was its historical use?","hi":"'WAP' का पूर्ण रूप (Full Form) और इसका ऐतिहासिक उपयोग क्या था?"},"a":{"en":"Wireless Application Protocol — Used on early mobile phones to access wireless web-style services","hi":"वायरलेस एप्लिकेशन प्रोटोकॉल (Wireless Application Protocol) — शुरुआती मोबाइल डिवाइसेस पर वायरलेस वेब-शैली की सेवाओं के लिए"},"o":[{"en":"Wireless Application Protocol — Used on early mobile phones to access wireless web-style services","hi":"वायरलेस एप्लिकेशन प्रोटोकॉल (Wireless Application Protocol) — शुरुआती मोबाइल डिवाइसेस पर वायरलेस वेब-शैली की सेवाओं के लिए"},{"en":"Wide Area Printer — Used to print banners across cities","hi":"वाइड एरिया प्रिंटर — शहरों के बीच बैनर प्रिंट करने के लिए"},{"en":"Windows Antivirus Protection — Used to clean hard disk boot sectors","hi":"विंडोज़ एंटीवायरस प्रोटेक्शन — हार्ड डिस्क बूट सेक्टर साफ करने के लिए"},{"en":"Wired Analog Port — Used to connect CRT monitors","hi":"वायर्ड एनालॉग पोर्ट — CRT मॉनिटर जोड़ने के लिए"}],"exp":{"en":"WAP stands for Wireless Application Protocol, a technical standard used on early feature phones and mobile devices to access lightweight wireless web-style information services.","hi":"WAP का पूर्ण रूप Wireless Application Protocol है। इसका उपयोग शुरुआती मोबाइल फ़ोनों पर वायरलेस वेब-शैली की सेवाओं को एक्सेस करने के लिए होता था।"},"num":42},{"id":"q43","q":{"en":"In the chapter notes, what is the 'news' protocol associated with, and what is the full form of 'NNTP'?","hi":"नोट्स में 'news' प्रोटोकॉल किस उपयोग से जुड़ा है, और 'NNTP' का पूर्ण रूप क्या है?"},"a":{"en":"Associated with Usenet newsgroups and news articles; NNTP stands for Network News Transfer Protocol, used to exchange those articles","hi":"Usenet न्यूज़ग्रुप्स और न्यूज़ आर्टिकल्स से जुड़ा है; NNTP का पूर्ण रूप Network News Transfer Protocol है"},"o":[{"en":"Associated with Usenet newsgroups and news articles; NNTP stands for Network News Transfer Protocol, used to exchange those articles","hi":"Usenet न्यूज़ग्रुप्स और न्यूज़ आर्टिकल्स से जुड़ा है; NNTP का पूर्ण रूप Network News Transfer Protocol है"},{"en":"Associated with television weather broadcasts; NNTP stands for National News Television Port","hi":"टेलीविजन मौसम प्रसारण से जुड़ा है; NNTP का अर्थ नेशनल न्यूज़ टेलीविजन पोर्ट है"},{"en":"Associated with printing daily newspapers on plotters; NNTP stands for Newspaper Thermal Printer","hi":"प्लॉटर पर अखबार छापने से जुड़ा है"},{"en":"Associated with banking cheque clearance; NNTP stands for National NEFT Transfer Protocol","hi":"बैंकिंग चेक क्लियरेंस से जुड़ा है"}],"exp":{"en":"In internet protocols, the `news` URL scheme and NNTP (Network News Transfer Protocol) are used for distributing, querying, retrieving, and posting Usenet newsgroup discussion articles.","hi":"नोट्स में 'news' प्रोटोकॉल Usenet न्यूज़ग्रुप्स (newsgroups) और न्यूज़ आर्टिकल्स से जुड़ा है। इन लेखों के आदान-प्रदान के लिए प्रयुक्त प्रोटोकॉल NNTP का पूर्ण रूप Network News Transfer Protocol है।"},"num":43},{"id":"q44","q":{"en":"How should 'WWW', 'DNS', and 'HTTP' be accurately classified?","hi":"'WWW', 'DNS' और 'HTTP' को सही रूप में कैसे वर्गीकृत किया जाता है?"},"a":{"en":"WWW is a Web service/ecosystem, DNS is a naming/resolution system, and HTTP is a Web communication protocol","hi":"WWW एक वेब सर्विस/इकोसिस्टम है, DNS एक नेमिंग सिस्टम है, और HTTP एक वेब संचार प्रोटोकॉल है"},"o":[{"en":"WWW is a Web service/ecosystem, DNS is a naming/resolution system, and HTTP is a Web communication protocol","hi":"WWW एक वेब सर्विस/इकोसिस्टम है, DNS एक नेमिंग सिस्टम है, और HTTP एक वेब संचार प्रोटोकॉल है"},{"en":"All three are web browsers like Google Chrome","hi":"तीनों गूगल क्रोम जैसे वेब ब्राउज़र हैं"},{"en":"WWW is a hardware cable, DNS is a monitor, and HTTP is a printer","hi":"WWW एक हार्डवेयर केबल है, DNS एक मॉनिटर है, और HTTP एक प्रिंटर है"},{"en":"All three are e-banking payment systems operated by RBI","hi":"तीनों RBI द्वारा संचालित ई-बैंकिंग भुगतान प्रणालियाँ हैं"}],"exp":{"en":"Conceptual classification: WWW (World Wide Web) is the hypermedia information service/ecosystem; DNS (Domain Name System) is the hierarchical naming and address-resolution system; and HTTP (Hypertext Transfer Protocol) is the application-layer communication protocol.","hi":"सही वर्गीकरण: WWW एक वेब सूचना सेवा/इकोसिस्टम (Web service/ecosystem) है, DNS एक नामकरण प्रणाली (naming system) है, और HTTP एक वेब संचार प्रोटोकॉल (Web communication protocol) है।"},"num":44},{"id":"q45","q":{"en":"What are the respective roles of the email protocols 'SMTP', 'POP3', and 'IMAP'?","hi":"ईमेल प्रोटोकॉल 'SMTP', 'POP3' और 'IMAP' की क्रमशः क्या भूमिकाएँ हैं?"},"a":{"en":"SMTP submits and relays outgoing mail; POP3 retrieves/downloads messages to a client; IMAP accesses and synchronizes the server mailbox across clients","hi":"SMTP आउटगोइंग मेल सबमिट/रिले करता है; POP3 मैसेज रिट्रीव (डाउनलोड) करता है; और IMAP सर्वर मेलबॉक्स को एक्सेस व सिंक करता है"},"o":[{"en":"SMTP submits and relays outgoing mail; POP3 retrieves/downloads messages to a client; IMAP accesses and synchronizes the server mailbox across clients","hi":"SMTP आउटगोइंग मेल सबमिट/रिले करता है; POP3 मैसेज रिट्रीव (डाउनलोड) करता है; और IMAP सर्वर मेलबॉक्स को एक्सेस व सिंक करता है"},{"en":"POP3 sends outgoing mail; SMTP deletes emails; IMAP formats the hard drive","hi":"POP3 आउटगोइंग मेल भेजता है; SMTP ईमेल डिलीट करता है; IMAP हार्ड ड्राइव फ़ॉर्मेट करता है"},{"en":"All three are used only for downloading MP3 songs from FTP servers","hi":"तीनों का उपयोग केवल FTP सर्वर से MP3 गाने डाउनलोड करने के लिए होता है"},{"en":"IMAP sends outgoing mail between servers, whereas SMTP only reads offline drafts","hi":"IMAP सर्वरों के बीच मेल भेजता है, जबकि SMTP केवल ऑफ़लाइन ड्राफ्ट पढ़ता है"}],"exp":{"en":"In email architecture: SMTP is the push protocol used to send/submit outgoing mail from the sender's client to the mail server and relay it between mail servers; POP3 and IMAP are pull/access protocols used by the receiver's client to retrieve or synchronize messages from the receiving mail server.","hi":"ईमेल प्रोटोकॉल की भूमिकाएँ: SMTP आउटगोइंग ईमेल को भेजने (submit/relay करने) का काम करता है, जबकि प्राप्तकर्ता के इनबॉक्स से ईमेल प्राप्त करने के लिए POP3 (मैसेज डाउनलोड/रिट्रीव करने) और IMAP (सर्वर मेलबॉक्स को एक्सेस व सिंक करने) का उपयोग होता है।"},"num":45},{"id":"q46","q":{"en":"What are the full forms of 'SMTP', 'POP3', and 'IMAP'?","hi":"'SMTP', 'POP3' और 'IMAP' के पूर्ण रूप (Full Forms) क्या हैं?"},"a":{"en":"Simple Mail Transfer Protocol (SMTP), Post Office Protocol version 3 (POP3), and Internet Message Access Protocol (IMAP)","hi":"सिंपल मेल ट्रांसफर प्रोटोकॉल, पोस्ट ऑफिस प्रोटोकॉल वर्शन 3, और इंटरनेट मैसेज एक्सेस प्रोटोकॉल"},"o":[{"en":"Simple Mail Transfer Protocol (SMTP), Post Office Protocol version 3 (POP3), and Internet Message Access Protocol (IMAP)","hi":"सिंपल मेल ट्रांसफर प्रोटोकॉल, पोस्ट ऑफिस प्रोटोकॉल वर्शन 3, और इंटरनेट मैसेज एक्सेस प्रोटोकॉल"},{"en":"System Memory Transfer Port, Private Office Port 3, and Internal Mail Application Program","hi":"सिस्टम मेमोरी ट्रांसफर पोर्ट, प्राइवेट ऑफिस पोर्ट 3, और इंटरनल मेल एप्लिकेशन प्रोग्राम"},{"en":"Secure Modem Transmission Protocol, Packet Output Protocol 3, and Integrated Media Access Port","hi":"सिक्योर मॉडेम ट्रांसमिशन प्रोटोकॉल, पैकेट आउटपुट प्रोटोकॉल 3, और इंटीग्रेटेड मीडिया एक्सेस पोर्ट"},{"en":"Standard Markup Text Protocol, Public Online Protocol 3, and Internet Modem Array Protocol","hi":"स्टैंडर्ड मार्कअप टेक्स्ट प्रोटोकॉल, पब्लिक ऑनलाइन प्रोटोकॉल 3, और इंटरनेट मॉडेम ऐरे प्रोटोकॉल"}],"exp":{"en":"Full forms: SMTP = Simple Mail Transfer Protocol; POP3 = Post Office Protocol version 3; and IMAP = Internet Message Access Protocol.","hi":"पूर्ण रूप: SMTP = Simple Mail Transfer Protocol, POP3 = Post Office Protocol version 3, और IMAP = Internet Message Access Protocol हैं।"},"num":46},{"id":"q47","q":{"en":"What is the practical difference between 'POP3' and 'IMAP' when checking email?","hi":"ईमेल एक्सेस करने में 'POP3' और 'IMAP' के बीच व्यावहारिक अंतर क्या है?"},"a":{"en":"POP3 primarily downloads messages to a local device (with optional settings to leave copies on the server), whereas IMAP keeps mail on the server and synchronizes folders and message states across multiple client devices","hi":"POP3 मुख्यतः मैसेज को डिवाइस पर डाउनलोड करता है, जबकि IMAP सर्वर फ़ोल्डर्स और मैसेज स्टेट को कई डिवाइसेस (clients) के साथ सिंक (sync) करता है"},"o":[{"en":"POP3 primarily downloads messages to a local device (with optional settings to leave copies on the server), whereas IMAP keeps mail on the server and synchronizes folders and message states across multiple client devices","hi":"POP3 मुख्यतः मैसेज को डिवाइस पर डाउनलोड करता है, जबकि IMAP सर्वर फ़ोल्डर्स और मैसेज स्टेट को कई डिवाइसेस (clients) के साथ सिंक (sync) करता है"},{"en":"POP3 is used for sending emails, whereas IMAP is used for printing web pages","hi":"POP3 ईमेल भेजने के लिए और IMAP वेब पेज प्रिंट करने के लिए होता है"},{"en":"IMAP works without an internet server, whereas POP3 cannot download attachments","hi":"IMAP बिना सर्वर के काम करता है, जबकि POP3 अटैचमेंट डाउनलोड नहीं कर सकता"},{"en":"There is no difference; both are hardware router cables","hi":"कोई अंतर नहीं है; दोनों हार्डवेयर राउटर केबल हैं"}],"exp":{"en":"POP3 is designed primarily for single-device offline access by downloading messages from the server to local storage (though it can be configured to leave a copy on the server). IMAP manages messages directly on the mail server, keeping folders, read/unread flags, and sent items synchronized across multiple devices (phone, laptop, tablet).","hi":"POP3 मुख्य रूप से सर्वर से संदेशों को लोकल डिवाइस पर डाउनलोड करता है (हालाँकि सर्वर पर कॉपी छोड़ने का विकल्प भी होता है)। इसके विपरीत, IMAP संदेशों को सर्वर पर ही रखता है और फ़ोल्डर्स व मैसेज की स्थिति को एक साथ कई डिवाइसेस (फ़ोन, लैपटॉप आदि) पर सिंक (sync) करने की सुविधा देता है।"},"num":47}]},{"title":{"en":"4. Browsers, Search Engines & Internet Access","hi":"4. ब्राउज़र, सर्च इंजन और इंटरनेट एक्सेस"},"questions":[{"id":"q48","q":{"en":"What is a 'Web Browser'?","hi":"'वेब ब्राउज़र' (Web Browser) क्या होता है?"},"a":{"en":"An application software used to retrieve, display/render, and navigate webpages on the World Wide Web","hi":"वेबपेजों को रिट्रीव (प्राप्त) करने, डिस्प्ले (प्रदर्शित) करने और नेविगेट करने वाला एप्लिकेशन सॉफ्टवेयर"},"o":[{"en":"An application software used to retrieve, display/render, and navigate webpages on the World Wide Web","hi":"वेबपेजों को रिट्रीव (प्राप्त) करने, डिस्प्ले (प्रदर्शित) करने और नेविगेट करने वाला एप्लिकेशन सॉफ्टवेयर"},{"en":"A hardware router that boosts Wi-Fi radio signals","hi":"वाई-फाई रेडियो सिग्नल बढ़ाने वाला एक हार्डवेयर राउटर"},{"en":"An operating system kernel that schedules CPU threads","hi":"CPU थ्रेड्स को शेड्यूल करने वाला एक ऑपरेटिंग सिस्टम कर्नेल"},{"en":"A database table stored inside Microsoft Access","hi":"माइक्रोसॉफ्ट एक्सेस के अंदर संग्रहीत एक डेटाबेस तालिका"}],"exp":{"en":"A web browser is client application software that sends HTTP/HTTPS requests to web servers, retrieves web resources, and renders HTML/CSS/JavaScript webpages for the user to view and navigate.","hi":"वेब ब्राउज़र वह एप्लिकेशन सॉफ्टवेयर है जिसका उपयोग वर्ल्ड वाइड वेब पर वेबपेजों को प्राप्त करने (retrieve), स्क्रीन पर दिखाने (display) और नेविगेट करने के लिए किया जाता है।"},"num":48},{"id":"q49","q":{"en":"Which of the following sets lists the web browser examples given in the chapter?","hi":"अध्याय में दिए गए वेब ब्राउज़र (Web Browser) के उदाहरण कौन-से हैं?"},"a":{"en":"Chrome, Firefox, Safari, Edge, Opera, and historical Internet Explorer","hi":"Chrome, Firefox, Safari, Edge, Opera और ऐतिहासिक Internet Explorer"},"o":[{"en":"Chrome, Firefox, Safari, Edge, Opera, and historical Internet Explorer","hi":"Chrome, Firefox, Safari, Edge, Opera और ऐतिहासिक Internet Explorer"},{"en":"Google, Yahoo, Bing, and Archie","hi":"Google, Yahoo, Bing और Archie"},{"en":"NEFT, RTGS, ECS, and IMPS","hi":"NEFT, RTGS, ECS और IMPS"},{"en":"SMTP, POP3, IMAP, and SNMP","hi":"SMTP, POP3, IMAP और SNMP"}],"exp":{"en":"The web browsers illustrated and listed in the chapter are Google Chrome, Mozilla Firefox, Apple Safari, Microsoft Edge, Opera, and Microsoft's historical Internet Explorer.","hi":"अध्याय में दिए गए प्रमुख वेब ब्राउज़र उदाहरण Chrome, Firefox, Safari, Edge, Opera और पुराना Internet Explorer हैं।"},"num":49},{"id":"q50","q":{"en":"What type of web browser is 'Mozilla Firefox' in terms of licensing?","hi":"लाइसेंसिंग के संदर्भ में 'Mozilla Firefox' किस प्रकार का वेब ब्राउज़र है?"},"a":{"en":"A free and open-source web browser developed by Mozilla","hi":"मोज़िला (Mozilla) का एक फ्री और ओपन-सोर्स (Free and Open-Source / FOSS) वेब ब्राउज़र"},"o":[{"en":"A free and open-source web browser developed by Mozilla","hi":"मोज़िला (Mozilla) का एक फ्री और ओपन-सोर्स (Free and Open-Source / FOSS) वेब ब्राउज़र"},{"en":"A paid, closed-source proprietary browser exclusively for Apple iPhones","hi":"केवल एप्पल आईफोन के लिए एक सशुल्क प्रोप्राइटरी ब्राउज़र"},{"en":"A hardware firewall appliance built by Cisco","hi":"सिस्को द्वारा निर्मित एक हार्डवेयर फ़ायरवॉल उपकरण"},{"en":"A command-line assembler for 1GL binary code","hi":"1GL बाइनरी कोड के लिए एक कमांड-लाइन असेंबलर"}],"exp":{"en":"Mozilla Firefox is a prominent Free and Open-Source Software (FOSS) web browser developed by the Mozilla Foundation and its contributors.","hi":"Mozilla Firefox मोज़िला द्वारा विकसित एक निःशुल्क और ओपन-सोर्स (Free and Open-Source / FOSS) वेब ब्राउज़र है।"},"num":50},{"id":"q51","q":{"en":"Which organization developed the 'Mosaic' web browser, and why was it historically important?","hi":"'मोज़ेक' (Mosaic) वेब ब्राउज़र किस संस्था ने विकसित किया था और यह ऐतिहासिक रूप से क्यों महत्वपूर्ण था?"},"a":{"en":"Developed at the National Center for Supercomputing Applications (NCSA), University of Illinois; released in 1993, it became the first widely popular graphical browser that accelerated global Web adoption","hi":"इलिनोइस विश्वविद्यालय के NCSA (National Center for Supercomputing Applications) ने; 1993 में यह एक लोकप्रिय ग्राफिकल ब्राउज़र बना जिसने वेब के प्रसार को तेज़ी से बढ़ाया"},"o":[{"en":"Developed at the National Center for Supercomputing Applications (NCSA), University of Illinois; released in 1993, it became the first widely popular graphical browser that accelerated global Web adoption","hi":"इलिनोइस विश्वविद्यालय के NCSA (National Center for Supercomputing Applications) ने; 1993 में यह एक लोकप्रिय ग्राफिकल ब्राउज़र बना जिसने वेब के प्रसार को तेज़ी से बढ़ाया"},{"en":"Developed by RBI in 2005 for mobile banking","hi":"2005 में मोबाइल बैंकिंग के लिए RBI द्वारा विकसित किया गया"},{"en":"Developed by VSNL in 1995 as an email protocol","hi":"1995 में ईमेल प्रोटोकॉल के रूप में VSNL द्वारा विकसित किया गया"},{"en":"Developed by Bell Labs in 1969 as the Unix kernel","hi":"1969 में यूनिक्स कर्नेल के रूप में बेल लैब्स द्वारा विकसित किया गया"}],"exp":{"en":"NCSA Mosaic (developed by Marc Andreessen and Eric Bina at the National Center for Supercomputing Applications, University of Illinois at Urbana–Champaign, and released in 1993) was the first widely popular graphical web browser that displayed images inline with text and popularized the World Wide Web.","hi":"Mosaic ब्राउज़र का विकास इलिनोइस विश्वविद्यालय के NCSA (National Center for Supercomputing Applications) द्वारा किया गया था। वर्ष 1993 में यह अत्यंत लोकप्रिय ग्राफिकल ब्राउज़र बना और इसने आम लोगों के बीच वर्ल्ड वाइड वेब के उपयोग को तेज़ी से बढ़ाया।"},"num":51},{"id":"q52","q":{"en":"What does a 'Search Engine' do, and what are the examples given in the chapter?","hi":"'सर्च इंजन' (Search Engine) क्या करता है और अध्याय में इसके कौन-से उदाहरण दिए गए हैं?"},"a":{"en":"It searches and ranks indexed web information based on user queries or keywords; Google and Yahoo are the chapter's examples","hi":"यह यूज़र की क्वेरी या कीवर्ड्स के आधार पर इंडेक्स की गई जानकारी को खोजता और रैंक करता है; Google और Yahoo इसके उदाहरण हैं"},"o":[{"en":"It searches and ranks indexed web information based on user queries or keywords; Google and Yahoo are the chapter's examples","hi":"यह यूज़र की क्वेरी या कीवर्ड्स के आधार पर इंडेक्स की गई जानकारी को खोजता और रैंक करता है; Google और Yahoo इसके उदाहरण हैं"},{"en":"It physically manufactures copper network cables","hi":"यह भौतिक रूप से तांबे की नेटवर्क केबल बनाता है"},{"en":"It converts AC mains power into DC power inside the cabinet","hi":"यह कैबिनेट के अंदर एसी बिजली को डीसी में बदलता है"},{"en":"It only edits offline MP4 videos without internet","hi":"यह बिना इंटरनेट के केवल ऑफ़लाइन MP4 वीडियो एडिट करता है"}],"exp":{"en":"A web search engine is an online service that crawls, indexes, searches, and ranks web pages and online resources based on the user's search query or keywords. The chapter highlights Google and Yahoo as examples (alongside Bing, DuckDuckGo, etc.).","hi":"सर्च इंजन उपयोगकर्ता द्वारा डाले गए शब्दों (query या keywords) के आधार पर इंडेक्स की गई वेब जानकारियों को खोजता (search) और प्रासंगिकता के अनुसार रैंक (rank) करता है। अध्याय में Google और Yahoo इसके उदाहरण दिए गए हैं।"},"num":52},{"id":"q53","q":{"en":"What is the full form and meaning of 'SERP'?","hi":"'SERP' का पूर्ण रूप (Full Form) और अर्थ क्या है?"},"a":{"en":"Search Engine Results Page — The page/screen of ranked results displayed by a search engine in response to a user's query","hi":"सर्च इंजन रिज़ल्ट्स पेज (Search Engine Results Page) — किसी सर्च क्वेरी के जवाब में सर्च इंजन द्वारा दिखाई जाने वाली रैंक किए गए परिणामों की स्क्रीन"},"o":[{"en":"Search Engine Results Page — The page/screen of ranked results displayed by a search engine in response to a user's query","hi":"सर्च इंजन रिज़ल्ट्स पेज (Search Engine Results Page) — किसी सर्च क्वेरी के जवाब में सर्च इंजन द्वारा दिखाई जाने वाली रैंक किए गए परिणामों की स्क्रीन"},{"en":"Serial Ethernet Routing Protocol — A hardware cable for routers","hi":"सीरियल ईथरनेट रूटिंग प्रोटोकॉल — राउटर के लिए एक केबल"},{"en":"System Error Recovery Process — A BIOS troubleshooting tool","hi":"सिस्टम एरर रिकवरी प्रोसेस — एक BIOS ट्रबलशूटिंग टूल"},{"en":"Standard Electronic Retail Payment — A debit card swipe machine","hi":"स्टैंडर्ड इलेक्ट्रॉनिक रिटेल पेमेंट — एक डेबिट कार्ड मशीन"}],"exp":{"en":"SERP stands for Search Engine Results Page—the web page returned by a search engine (such as Google or Bing) listing ranked organic results and relevant snippets after a user submits a search query.","hi":"SERP का पूर्ण रूप Search Engine Results Page है। जब यूज़र सर्च इंजन में कोई क्वेरी खोजता है, तो परिणामस्वरूप दिखाई देने वाली रैंक किए गए लिंक्स की स्क्रीन को SERP कहते हैं।"},"num":53},{"id":"q54","q":{"en":"Who created 'Archie', where was it developed, and what type of search tool was it?","hi":"'आर्ची' (Archie) किसने व कहाँ बनाया था, और यह किस प्रकार का सर्च टूल था?"},"a":{"en":"Created by Alan Emtage at McGill University (1990); it indexed file listings of public anonymous FTP archives and is regarded as the first Internet search engine","hi":"एलन एमटेज (Alan Emtage) ने मैकगिल विश्वविद्यालय (McGill University) में बनाया; यह पब्लिक FTP आर्काइव्स की फ़ाइल सूचियों को इंडेक्स करता था (इसे पहला इंटरनेट सर्च इंजन माना जाता है)"},"o":[{"en":"Created by Alan Emtage at McGill University (1990); it indexed file listings of public anonymous FTP archives and is regarded as the first Internet search engine","hi":"एलन एमटेज (Alan Emtage) ने मैकगिल विश्वविद्यालय (McGill University) में बनाया; यह पब्लिक FTP आर्काइव्स की फ़ाइल सूचियों को इंडेक्स करता था (इसे पहला इंटरनेट सर्च इंजन माना जाता है)"},{"en":"Created by Tim Berners-Lee at CERN as a 3D animation tool","hi":"टिम बर्नर्स-ली ने CERN में 3D एनीमेशन टूल के रूप में बनाया"},{"en":"Created by Ray Tomlinson in 1971 as an antivirus program","hi":"रे टॉमलिनसन ने 1971 में एंटीवायरस प्रोग्राम के रूप में बनाया"},{"en":"Created by NPCI in 2010 for instant bank transfers","hi":"2010 में तत्काल बैंक ट्रांसफर के लिए NPCI द्वारा बनाया गया"}],"exp":{"en":"Archie was created in 1990 by Alan Emtage (a postgraduate student at McGill University in Montreal, Canada). It automatically downloaded and indexed directory/filename listings from public anonymous FTP servers, making it the world's first Internet search engine.","hi":"Archie का निर्माण एलन एमटेज (Alan Emtage) ने कनाडा के मैकगिल विश्वविद्यालय (McGill University) में (1990 में) किया था। यह पब्लिक FTP आर्काइव्स की फ़ाइल सूचियों को इंडेक्स करता था और इसे दुनिया का पहला इंटरनेट सर्च इंजन माना जाता है।"},"num":54},{"id":"q55","q":{"en":"What is the fundamental difference between a 'Web Browser' and a 'Search Engine'?","hi":"'वेब ब्राउज़र' (Browser) और 'सर्च इंजन' (Search Engine) में बुनियादी अंतर क्या है?"},"a":{"en":"A browser is client application software installed on a device to open and render webpages (e.g., Chrome, Firefox), whereas a search engine is an online service used to find information on the web (e.g., Google, Bing) that is accessed through a browser","hi":"ब्राउज़र वेबपेज खोलने का सॉफ्टवेयर है, जबकि सर्च इंजन जानकारी ढूँढने की एक ऑनलाइन सर्विस है जिसे ब्राउज़र में भी एक्सेस किया जाता है"},"o":[{"en":"A browser is client application software installed on a device to open and render webpages (e.g., Chrome, Firefox), whereas a search engine is an online service used to find information on the web (e.g., Google, Bing) that is accessed through a browser","hi":"ब्राउज़र वेबपेज खोलने का सॉफ्टवेयर है, जबकि सर्च इंजन जानकारी ढूँढने की एक ऑनलाइन सर्विस है जिसे ब्राउज़र में भी एक्सेस किया जाता है"},{"en":"Google is a web browser, whereas Mozilla Firefox is a search engine","hi":"Google एक वेब ब्राउज़र है, जबकि Mozilla Firefox एक सर्च इंजन है"},{"en":"A browser works only on servers, whereas a search engine is a hardware mouse","hi":"ब्राउज़र केवल सर्वर पर काम करता है, जबकि सर्च इंजन एक हार्डवेयर माउस है"},{"en":"There is no difference; both terms mean an ISP modem","hi":"कोई अंतर नहीं है; दोनों शब्दों का अर्थ एक ISP मॉडेम है"}],"exp":{"en":"Exam Trap Distinction: A Web Browser (Chrome, Firefox, Safari, Edge) is the local software application used to view webpages. A Search Engine (Google, Yahoo, Bing, DuckDuckGo) is a web-based search service/website that helps users find other websites using keywords.","hi":"परीक्षा के लिए मुख्य अंतर: वेब ब्राउज़र (जैसे Chrome, Firefox, Safari) कंप्यूटर या फ़ोन पर इंस्टॉल किया गया वह सॉफ्टवेयर है जिससे वेबपेज खोले जाते हैं; जबकि सर्च इंजन (जैसे Google, Yahoo, Bing) इंटरनेट पर जानकारी खोजने की एक ऑनलाइन सेवा है, जिसे ब्राउज़र के भीतर ही खोला जाता है।"},"num":55},{"id":"q56","q":{"en":"In a computer networking context, what does 'Bandwidth' measure, and how does it differ from 'Throughput'?","hi":"कंप्यूटर नेटवर्किंग के संदर्भ में 'बैंडविड्थ' (Bandwidth) क्या मापती है, और 'थ्रूपुट' (Throughput) क्या है?"},"a":{"en":"Bandwidth measures the maximum data-carrying capacity of a communication channel (commonly in bits per second, e.g., Mbps/Gbps), whereas the actual achieved data transfer rate is called throughput","hi":"बैंडविड्थ किसी संचार चैनल की डेटा ले जाने की अधिकतम क्षमता (सामान्यतः बिट्स प्रति सेकंड में) मापती है, जबकि वास्तव में प्राप्त होने वाली ट्रांसफर दर को 'थ्रूपुट' कहते हैं"},"o":[{"en":"Bandwidth measures the maximum data-carrying capacity of a communication channel (commonly in bits per second, e.g., Mbps/Gbps), whereas the actual achieved data transfer rate is called throughput","hi":"बैंडविड्थ किसी संचार चैनल की डेटा ले जाने की अधिकतम क्षमता (सामान्यतः बिट्स प्रति सेकंड में) मापती है, जबकि वास्तव में प्राप्त होने वाली ट्रांसफर दर को 'थ्रूपुट' कहते हैं"},{"en":"Bandwidth measures the physical width of a copper Ethernet cable in millimetres","hi":"बैंडविड्थ मिलीमीटर में तांबे की ईथरनेट केबल की भौतिक चौड़ाई मापती है"},{"en":"Bandwidth measures the storage capacity of a DVD in gigabytes","hi":"बैंडविड्थ गीगाबाइट्स में डीवीडी की स्टोरेज क्षमता मापती है"},{"en":"Bandwidth is the number of keys on a keyboard","hi":"बैंडविड्थ कीबोर्ड पर कुंजियों की संख्या है"}],"exp":{"en":"In digital networking, Bandwidth is the theoretical maximum data transfer capacity of a network link per unit of time (measured in bps, kbps, Mbps, or Gbps), whereas Throughput is the actual measured rate of successful data delivery over that link.","hi":"नेटवर्किंग में 'बैंडविड्थ' किसी संचार चैनल की प्रति सेकंड डेटा ले जाने की अधिकतम क्षमता (सामान्यतः बिट्स प्रति सेकंड — bps/Mbps/Gbps में) मापती है, जबकि वास्तव में प्राप्त होने वाली डेटा ट्रांसफर गति को 'थ्रूपुट' (Throughput) कहा जाता है।"},"num":56},{"id":"q57","q":{"en":"What is the difference between 'Mbps' and 'MB/s', and what is the theoretical conversion of an 80 Mbps connection in MB/s?","hi":"'Mbps' और 'MB/s' में क्या अंतर है, और 80 Mbps कनेक्शन की सैद्धांतिक गति MB/s में कितनी होगी?"},"a":{"en":"Mbps = megabits per second (lowercase 'b') and MB/s = megabytes per second (uppercase 'B'); since 8 bits = 1 byte, 80 Mbps theoretically equals 10 MB/s (80 ÷ 8 = 10)","hi":"Mbps = मेगाबिट्स प्रति सेकंड और MB/s = मेगाबाइट्स प्रति सेकंड; चूँकि 8 बिट्स = 1 बाइट, इसलिए 80 Mbps का सैद्धांतिक मान 10 MB/s है"},"o":[{"en":"Mbps = megabits per second (lowercase 'b') and MB/s = megabytes per second (uppercase 'B'); since 8 bits = 1 byte, 80 Mbps theoretically equals 10 MB/s (80 ÷ 8 = 10)","hi":"Mbps = मेगाबिट्स प्रति सेकंड और MB/s = मेगाबाइट्स प्रति सेकंड; चूँकि 8 बिट्स = 1 बाइट, इसलिए 80 Mbps का सैद्धांतिक मान 10 MB/s है"},{"en":"Both mean megabytes per second, so 80 Mbps equals 80 MB/s","hi":"दोनों का अर्थ मेगाबाइट्स प्रति सेकंड है, इसलिए 80 Mbps = 80 MB/s"},{"en":"1 byte = 10 bits, so 80 Mbps equals 800 MB/s","hi":"1 बाइट = 10 बिट्स, इसलिए 80 Mbps = 800 MB/s"},{"en":"Mbps is for hard disks and MB/s is for monitors; 80 Mbps equals 1 MB/s","hi":"80 Mbps = 1 MB/s"}],"exp":{"en":"Notation rule: Lowercase `b` stands for bits and uppercase `B` stands for Bytes. Thus, `Mbps` = Megabits per second (used for ISP link speeds) and `MB/s` = Megabytes per second (used for file download speeds). Since 8 bits = 1 Byte, 80 Mbps ÷ 8 = 10 MB/s theoretical maximum.","hi":"`Mbps` (छोटा 'b') का अर्थ Megabits per second है और `MB/s` (बड़ा 'B') का अर्थ Megabytes per second है। चूँकि 8 bits = 1 Byte होता है, इसलिए 80 Mbps का सैद्धांतिक मान 80 ÷ 8 = 10 MB/s होता है।"},"num":57},{"id":"q58","q":{"en":"From which words is the term 'Modem' derived, and what was the traditional function of a dial-up modem?","hi":"'Modem' शब्द किससे बना है और पारंपरिक डायल-अप मॉडेम का मुख्य कार्य क्या था?"},"a":{"en":"Modulator–Demodulator; a dial-up modem converted a computer's digital data into analog signals suitable for transmission over telephone lines (modulation) and converted received signals back into digital data (demodulation)","hi":"मॉड्यूलेटर-डीमॉड्यूलेटर (Modulator–Demodulator); यह कंप्यूटर के डिजिटल डेटा को टेलीफोन लाइन पर भेजने योग्य एनालॉग सिग्नल में बदलता था और प्राप्त सिग्नल को वापस डिजिटल में बदलता था"},"o":[{"en":"Modulator–Demodulator; a dial-up modem converted a computer's digital data into analog signals suitable for transmission over telephone lines (modulation) and converted received signals back into digital data (demodulation)","hi":"मॉड्यूलेटर-डीमॉड्यूलेटर (Modulator–Demodulator); यह कंप्यूटर के डिजिटल डेटा को टेलीफोन लाइन पर भेजने योग्य एनालॉग सिग्नल में बदलता था और प्राप्त सिग्नल को वापस डिजिटल में बदलता था"},{"en":"Monitor–Desktop Module; it projected 3D graphics onto a screen","hi":"मॉनिटर-डेस्कटॉप मॉड्यूल; यह स्क्रीन पर 3D ग्राफिक्स दिखाता था"},{"en":"Mobile–Disk Memory; it stored 500 GB of offline movies","hi":"मोबाइल-डिस्क मेमोरी; यह 500 GB ऑफ़लाइन फिल्में स्टोर करता था"},{"en":"Modern–Email Manager; it sorted spam emails into the trash folder","hi":"मॉडर्न-ईमेल मैनेजर; यह स्पैम ईमेल को ट्रैश फ़ोल्डर में छाँटता था"}],"exp":{"en":"Modem is short for Modulator–Demodulator. A traditional dial-up modem modulated digital binary data from a computer into analog audio-frequency signals to travel over standard telephone lines (PSTN), and demodulated incoming analog signals back into digital bits.","hi":"Modem शब्द 'Modulator–Demodulator' से बना है। पारंपरिक डायल-अप मॉडेम कंप्यूटर के डिजिटल डेटा को टेलीफोन लाइन पर भेजने योग्य सिग्नल में बदलता (modulate करता) था और प्राप्त सिग्नल को वापस डिजिटल डेटा में बदलता (demodulate करता) था।"},"num":58},{"id":"q59","q":{"en":"What is the primary function of a 'Router'?","hi":"'राउटर' (Router) का मुख्य काम क्या है?"},"a":{"en":"It forwards data packets between different computer networks (and a home router allows multiple local devices to share an internet connection)","hi":"यह अलग-अलग नेटवर्क्स के बीच डेटा पैकेट्स को फॉरवर्ड (रूट) करता है, और होम राउटर स्थानीय उपकरणों को इंटरनेट कनेक्शन साझा करने देता है"},"o":[{"en":"It forwards data packets between different computer networks (and a home router allows multiple local devices to share an internet connection)","hi":"यह अलग-अलग नेटवर्क्स के बीच डेटा पैकेट्स को फॉरवर्ड (रूट) करता है, और होम राउटर स्थानीय उपकरणों को इंटरनेट कनेक्शन साझा करने देता है"},{"en":"It prints hard-copy documents onto A4 paper","hi":"यह A4 कागज पर हार्ड-कॉपी दस्तावेज़ प्रिंट करता है"},{"en":"It compiles high-level Java code into bytecode","hi":"यह उच्च-स्तरीय जावा कोड को बाइटकोड में कंपाइल करता है"},{"en":"It scans bank cheques using magnetic ink","hi":"यह चुंबकीय स्याही का उपयोग करके बैंक चेक स्कैन करता है"}],"exp":{"en":"A router is a networking device that directs/forwards data packets between different networks based on IP addresses. In a home or office setup, a router connects the local area network (LAN/Wi-Fi devices) to the ISP's wide area network (WAN), allowing multiple devices to share the internet connection.","hi":"राउटर अलग-अलग कंप्यूटर नेटवर्क्स के बीच डेटा पैकेट्स को फॉरवर्ड (दिशा-निर्देशित) करता है। एक होम राउटर घर के कई स्थानीय उपकरणों (मोबाइल, लैपटॉप आदि) को आपस में जुड़ने और एक ही इंटरनेट कनेक्शन साझा करने की सुविधा देता है।"},"num":59},{"id":"q60","q":{"en":"How should you remember the respective roles of a 'Modem/ONT' and a 'Router' in home internet access?","hi":"होम इंटरनेट कनेक्शन में 'मॉडेम' (Modem/ONT) और 'राउटर' (Router) की भूमिकाओं को कैसे याद रखें?"},"a":{"en":"The modem/access equipment terminates and handles the physical ISP link, while the router directs traffic between the home local network and the outside network (both can also be combined in a single gateway box)","hi":"मॉडेम/एक्सेस उपकरण ISP लिंक को संभालता है, जबकि राउटर होम नेटवर्क और बाहरी नेटवर्क के बीच ट्रैफ़िक निर्देशित करता है (दोनों एक ही बॉक्स में भी हो सकते हैं)"},"o":[{"en":"The modem/access equipment terminates and handles the physical ISP link, while the router directs traffic between the home local network and the outside network (both can also be combined in a single gateway box)","hi":"मॉडेम/एक्सेस उपकरण ISP लिंक को संभालता है, जबकि राउटर होम नेटवर्क और बाहरी नेटवर्क के बीच ट्रैफ़िक निर्देशित करता है (दोनों एक ही बॉक्स में भी हो सकते हैं)"},{"en":"The router converts analog telephone signals, while the modem only provides Wi-Fi to smartphones","hi":"राउटर एनालॉग टेलीफोन सिग्नल बदलता है, जबकि मॉडेम केवल स्मार्टफोन को वाई-फाई देता है"},{"en":"Both are software web browsers installed inside Windows","hi":"दोनों विंडोज़ के अंदर इंस्टॉल किए गए सॉफ्टवेयर वेब ब्राउज़र हैं"},{"en":"A modem is used only for printing, and a router is used only for scanning","hi":"मॉडेम केवल प्रिंटिंग के लिए और राउटर केवल स्कैनिंग के लिए होता है"}],"exp":{"en":"Diagram flow (PDF p. 142): `Home devices → Router → Modem / ONT → ISP / Internet`. The modem (or fiber ONT) bridges the physical transmission medium to the ISP, while the router manages local IP traffic and routes packets between home devices and the internet (modern ISP 'gateways' often combine both in one unit).","hi":"आसान नियम: मॉडेम या एक्सेस उपकरण (जैसे फाइबर ONT) सीधे ISP के बाहरी लिंक को संभालता है (`Home devices → Router → Modem/ONT → ISP`), जबकि राउटर घर के लोकल नेटवर्क और बाहरी इंटरनेट के बीच ट्रैफ़िक को निर्देशित करता है (आजकल दोनों एक ही कंबाइंड बॉक्स/राउटर-मॉडेम में भी आते हैं)।"},"num":60},{"id":"q61","q":{"en":"What is the direction of data transfer in 'Download' versus 'Upload'?","hi":"'डाउनलोड' (Download) और 'अपलोड' (Upload) में डेटा ट्रांसफर की दिशा क्या होती है?"},"a":{"en":"Download transfers data from a remote server/system to the user's local device; Upload transfers data from the user's local device to a remote server/system","hi":"डाउनलोड: रिमोट सिस्टम/सर्वर से यूज़र के डिवाइस की तरफ; अपलोड: यूज़र के डिवाइस से रिमोट सिस्टम/सर्वर की तरफ"},"o":[{"en":"Download transfers data from a remote server/system to the user's local device; Upload transfers data from the user's local device to a remote server/system","hi":"डाउनलोड: रिमोट सिस्टम/सर्वर से यूज़र के डिवाइस की तरफ; अपलोड: यूज़र के डिवाइस से रिमोट सिस्टम/सर्वर की तरफ"},{"en":"Download sends files from your phone to a server; Upload saves files from a server to your phone","hi":"डाउनलोड फ़ोन से सर्वर पर फ़ाइल भेजता है; अपलोड सर्वर से फ़ोन पर फ़ाइल सेव करता है"},{"en":"Both transfer data only between two USB ports on the same laptop","hi":"दोनों एक ही लैपटॉप के दो USB पोर्ट के बीच डेटा ट्रांसफर करते हैं"},{"en":"Download means deleting a file, and Upload means printing a file","hi":"डाउनलोड का अर्थ फ़ाइल डिलीट करना है, और अपलोड का अर्थ प्रिंट करना है"}],"exp":{"en":"Direction of data flow: Downloading means receiving/copying data from a remote server or internet system onto your local computer/phone. Uploading means sending data from your local computer/phone to a remote server.","hi":"डेटा की दिशा: 'डाउनलोड' (Download) में डेटा रिमोट सर्वर या इंटरनेट सिस्टम से आपके लोकल डिवाइस (कंप्यूटर/फ़ोन) की तरफ आता है; जबकि 'अपलोड' (Upload) में डेटा आपके लोकल डिवाइस से रिमोट सर्वर की तरफ भेजा जाता है।"},"num":61},{"id":"q62","q":{"en":"What does a 'Download Manager' do?","hi":"'डाउनलोड मैनेजर' (Download Manager) क्या करता है?"},"a":{"en":"It manages the download queue, tracks transfer progress, and supports pausing, resuming, or retrying downloads (it can be built into a browser or a standalone app)","hi":"यह डाउनलोड कतार (queue), प्रोग्रेस, पॉज़ (pause) और समर्थित रिज़्यूम/रीट्राई (resume/retry) को मैनेज करता है (यह ब्राउज़र में बिल्ट-इन या अलग ऐप हो सकता है)"},"o":[{"en":"It manages the download queue, tracks transfer progress, and supports pausing, resuming, or retrying downloads (it can be built into a browser or a standalone app)","hi":"यह डाउनलोड कतार (queue), प्रोग्रेस, पॉज़ (pause) और समर्थित रिज़्यूम/रीट्राई (resume/retry) को मैनेज करता है (यह ब्राउज़र में बिल्ट-इन या अलग ऐप हो सकता है)"},{"en":"It physically installs fiber-optic cables under the street","hi":"यह सड़क के नीचे भौतिक रूप से फाइबर-ऑप्टिक केबल बिछाता है"},{"en":"It deletes all downloaded files automatically every 5 minutes","hi":"यह हर 5 मिनट में सभी डाउनलोड की गई फ़ाइलों को स्वतः हटा देता है"},{"en":"It only composes and sends outgoing SMTP emails","hi":"यह केवल आउटगोइंग SMTP ईमेल लिखता और भेजता है"}],"exp":{"en":"A download manager (either built into a web browser or installed as a standalone utility) organizes queued file downloads, displays transfer speed/progress, and allows pausing and resuming interrupted downloads where supported by the server.","hi":"डाउनलोड मैनेजर फ़ाइलों की डाउनलोड कतार (queue), डाउनलोड प्रोग्रेस, तथा डाउनलोड को बीच में रोकने (pause) और वापस शुरू करने (resume/retry) की प्रक्रिया को प्रबंधित करता है। यह वेब ब्राउज़र के भीतर इन-बिल्ट हो सकता है या अलग से एक स्टैंडअलोन सॉफ्टवेयर भी हो सकता है।"},"num":62},{"id":"q63","q":{"en":"How should 'Posting a photo online', 'Sending an email attachment', and 'Opening a web link' be classified in terms of upload and download?","hi":"'ऑनलाइन फोटो पोस्ट करना', 'ईमेल अटैचमेंट भेजना' और 'वेब लिंक खोलना' को अपलोड और डाउनलोड के संदर्भ में कैसे वर्गीकृत करेंगे?"},"a":{"en":"Posting a photo and sending an attachment upload file data from your device to the server; opening a web link sends a small request outward and downloads/receives the webpage content","hi":"फोटो पोस्ट करने और अटैचमेंट भेजने में डेटा सर्वर पर 'अपलोड' होता है; जबकि लिंक खोलने पर रिक्वेस्ट बाहर जाती है और पेज का कंटेंट 'डाउनलोड/प्राप्त' होता है"},"o":[{"en":"Posting a photo and sending an attachment upload file data from your device to the server; opening a web link sends a small request outward and downloads/receives the webpage content","hi":"फोटो पोस्ट करने और अटैचमेंट भेजने में डेटा सर्वर पर 'अपलोड' होता है; जबकि लिंक खोलने पर रिक्वेस्ट बाहर जाती है और पेज का कंटेंट 'डाउनलोड/प्राप्त' होता है"},{"en":"Posting a photo is purely downloading, while reading a webpage is purely uploading","hi":"फोटो पोस्ट करना केवल डाउनलोडिंग है, जबकि वेबपेज पढ़ना केवल अपलोडिंग है"},{"en":"All three actions involve zero data transfer over the network","hi":"तीनों कार्यों में नेटवर्क पर शून्य डेटा ट्रांसफर होता है"},{"en":"Sending an email attachment downloads the file from the recipient's printer","hi":"ईमेल अटैचमेंट भेजने से प्राप्तकर्ता के प्रिंटर से फ़ाइल डाउनलोड होती है"}],"exp":{"en":"When you post a photo to social media or attach a file to an email, your device transmits that file data to the remote server (Upload). When you click/open a web link, your browser sends a brief HTTP request outward and receives/downloads the webpage content from the server.","hi":"सोशल मीडिया पर फोटो पोस्ट करने और ईमेल में अटैचमेंट भेजने के दौरान आपके डिवाइस से फ़ाइल डेटा सर्वर पर 'अपलोड' (upload) होता है। वहीं, किसी वेब लिंक को खोलने पर एक छोटी रिक्वेस्ट सर्वर को भेजी जाती है और बदले में वेबपेज का कंटेंट आपके डिवाइस पर 'डाउनलोड/प्राप्त' होता है।"},"num":63}]},{"title":{"en":"5. Email Address, Compose & Mailbox","hi":"5. ईमेल एड्रेस, कंपोज और मेलबॉक्स"},"questions":[{"id":"q64","q":{"en":"What is the full form and basic use of 'Email'?","hi":"'ईमेल' (Email) का पूर्ण रूप और बुनियादी उपयोग क्या है?"},"a":{"en":"Electronic Mail — Used for sending and receiving digital messages and file attachments across a computer network","hi":"इलेक्ट्रॉनिक मेल (Electronic Mail) — नेटवर्क पर डिजिटल संदेश और फ़ाइलें भेजने व प्राप्त करने के लिए"},"o":[{"en":"Electronic Mail — Used for sending and receiving digital messages and file attachments across a computer network","hi":"इलेक्ट्रॉनिक मेल (Electronic Mail) — नेटवर्क पर डिजिटल संदेश और फ़ाइलें भेजने व प्राप्त करने के लिए"},{"en":"Express Mechanical Mail — Sending physical paper letters via pneumatic tubes","hi":"एक्सप्रेस मैकेनिकल मेल — ट्यूबों के माध्यम से कागजी पत्र भेजना"},{"en":"Encrypted Memory Array List — A table inside CPU cache","hi":"एन्क्रिप्टेड मेमोरी ऐरे लिस्ट — CPU कैश के अंदर की एक तालिका"},{"en":"External Modem Access Line — A telephone wire for fax machines","hi":"एक्सटर्नल मॉडेम एक्सेस लाइन — फैक्स मशीनों के लिए टेलीफोन तार"}],"exp":{"en":"Email stands for Electronic Mail, a network communication service used to exchange digital text messages and attached files between users over the Internet or an intranet.","hi":"Email का पूर्ण रूप Electronic Mail है। इसका उपयोग कंप्यूटर नेटवर्क या इंटरनेट के माध्यम से डिजिटल संदेश (messages) और फ़ाइलें भेजने व प्राप्त करने के लिए किया जाता है।"},"num":64},{"id":"q65","q":{"en":"What are the two main parts of an Email Address such as 'student@example.com'?","hi":"`student@example.com` जैसे ईमेल एड्रेस के दो मुख्य भाग कौन-से होते हैं?"},"a":{"en":"The local part (username) and the domain, separated by the '@' symbol — here 'student' is the local part, '@' is the separator, and 'example.com' is the domain","hi":"लोकल पार्ट (यूज़रनेम) और डोमेन — `student@example.com` में `student` लोकल पार्ट है, `@` सेपरेटर है और `example.com` डोमेन है"},"o":[{"en":"The local part (username) and the domain, separated by the '@' symbol — here 'student' is the local part, '@' is the separator, and 'example.com' is the domain","hi":"लोकल पार्ट (यूज़रनेम) और डोमेन — `student@example.com` में `student` लोकल पार्ट है, `@` सेपरेटर है और `example.com` डोमेन है"},{"en":"The protocol scheme and the file extension","hi":"प्रोटोकॉल स्कीम और फ़ाइल एक्सटेंशन"},{"en":"The IP address and the subnet mask","hi":"आईपी एड्रेस और सबनेट मास्क"},{"en":"The subject line and the signature","hi":"सब्जेक्ट लाइन और सिग्नेचर"}],"exp":{"en":"An email address consists of two primary parts separated by the `@` sign: the local part (mailbox username, e.g., `student`) on the left, and the domain name (e.g., `example.com`) on the right.","hi":"किसी ईमेल एड्रेस के दो मुख्य भाग होते हैं: 'लोकल पार्ट' (यूज़रनेम) और 'डोमेन नाम', जिन्हें `@` चिह्न द्वारा अलग किया जाता है। `student@example.com` में `student` लोकल पार्ट है, `@` सेपरेटर है, और `example.com` डोमेन है।"},"num":65},{"id":"q66","q":{"en":"Is the domain part of an email address always the direct hostname of the receiving mail server?","hi":"क्या ईमेल एड्रेस का डोमेन भाग सीधे प्राप्तकर्ता मेल सर्वर का होस्टनेम ही होता है?"},"a":{"en":"Not necessarily — the domain identifies the destination organization/service, while DNS MX (Mail Exchanger) records specify the actual receiving mail server(s) for that domain","hi":"ज़रूरी नहीं — डोमेन गंतव्य संस्था या सर्विस की पहचान कराता है, जबकि वास्तविक प्राप्तकर्ता मेल सर्वर की पहचान DNS के MX (Mail Exchanger) रिकॉर्ड्स से होती है"},"o":[{"en":"Not necessarily — the domain identifies the destination organization/service, while DNS MX (Mail Exchanger) records specify the actual receiving mail server(s) for that domain","hi":"ज़रूरी नहीं — डोमेन गंतव्य संस्था या सर्विस की पहचान कराता है, जबकि वास्तविक प्राप्तकर्ता मेल सर्वर की पहचान DNS के MX (Mail Exchanger) रिकॉर्ड्स से होती है"},{"en":"Yes — DNS has no role in email routing","hi":"हाँ — ईमेल रूटिंग में DNS की कोई भूमिका नहीं होती"},{"en":"No — the domain part only indicates the sender's home street address","hi":"नहीं — डोमेन भाग केवल भेजने वाले के घर का पता बताता है"},{"en":"Yes — every email domain must be an IPv4 number","hi":"हाँ — प्रत्येक ईमेल डोमेन एक IPv4 नंबर होना चाहिए"}],"exp":{"en":"In an email address like `user@example.com`, `example.com` identifies the mail domain/organization. When sending mail, the SMTP server queries DNS for `example.com`'s MX (Mail Exchanger) records, which point to the actual hostnames of the servers that accept incoming mail for that domain.","hi":"ईमेल एड्रेस का डोमेन भाग गंतव्य संस्था या ईमेल सर्विस की पहचान कराता है; उस डोमेन के लिए वास्तव में ईमेल स्वीकार करने वाले मेल सर्वर की पहचान DNS के MX (Mail Exchanger) रिकॉर्ड्स के माध्यम से की जाती है।"},"num":66},{"id":"q67","q":{"en":"What is meant by 'Email Management'?","hi":"'ईमेल मैनेजमेंट' (Email Management) का क्या अर्थ है?"},"a":{"en":"Organizing, searching, filtering, storing, and handling incoming and outgoing email messages (along with organizational policies for volume and retention)","hi":"इनकमिंग और आउटगोइंग ईमेल संदेशों को व्यवस्थित (organize), सर्च, फ़िल्टर, स्टोर और हैंडल करना (संस्थाओं में रिटेंशन पॉलिसी भी इसके अंतर्गत आती है)"},"o":[{"en":"Organizing, searching, filtering, storing, and handling incoming and outgoing email messages (along with organizational policies for volume and retention)","hi":"इनकमिंग और आउटगोइंग ईमेल संदेशों को व्यवस्थित (organize), सर्च, फ़िल्टर, स्टोर और हैंडल करना (संस्थाओं में रिटेंशन पॉलिसी भी इसके अंतर्गत आती है)"},{"en":"Manufacturing physical postboxes for the postal department","hi":"डाक विभाग के लिए भौतिक लेटरबॉक्स का निर्माण करना"},{"en":"Writing device drivers for laser printers","hi":"लेजर प्रिंटर के लिए डिवाइस ड्राइवर लिखना"},{"en":"soldering Ethernet jacks onto a motherboard","hi":"मदरबोर्ड पर ईथरनेट जैक सोल्डर करना"}],"exp":{"en":"Email management encompasses the practices, tools, labels, filters, folders, and organizational retention/archiving policies used to efficiently organize, search, prioritize, store, and secure high volumes of incoming and outgoing electronic mail.","hi":"इनकमिंग और आउटगोइंग ईमेल संदेशों को व्यवस्थित करने (organize), खोजने (search), फ़िल्टर करने, सुरक्षित रखने (store) और संभालने की प्रक्रिया को 'ईमेल मैनेजमेंट' कहते हैं।"},"num":67},{"id":"q68","q":{"en":"What is the difference between the 'Email Body' and an 'Email Attachment'?","hi":"ईमेल की 'बॉडी' (Email Body) और 'अटैचमेंट' (Attachment) में क्या फर्क है?"},"a":{"en":"The body is the main text/content of the message itself, whereas an attachment is a separate file (such as a document, spreadsheet, image, or video) sent along with the email","hi":"बॉडी ईमेल का मुख्य संदेश (main message) है, जबकि अटैचमेंट उसके साथ भेजी गई कोई अलग फ़ाइल (जैसे डॉक्यूमेंट, इमेज या वीडियो) है"},"o":[{"en":"The body is the main text/content of the message itself, whereas an attachment is a separate file (such as a document, spreadsheet, image, or video) sent along with the email","hi":"बॉडी ईमेल का मुख्य संदेश (main message) है, जबकि अटैचमेंट उसके साथ भेजी गई कोई अलग फ़ाइल (जैसे डॉक्यूमेंट, इमेज या वीडियो) है"},{"en":"The attachment is the recipient's email address, and the body is the password","hi":"अटैचमेंट प्राप्तकर्ता का ईमेल पता है, और बॉडी पासवर्ड है"},{"en":"The body can only be a PDF file, while an attachment is the subject line","hi":"बॉडी केवल एक PDF फ़ाइल हो सकती है, जबकि अटैचमेंट सब्जेक्ट लाइन है"},{"en":"There is no difference; both refer to the BCC field","hi":"कोई अंतर नहीं है; दोनों BCC फ़ील्ड को संदर्भित करते हैं"}],"exp":{"en":"The email body is the main written text or formatted message content composed directly in the email editor, while an attachment is an external computer file (PDF, Word doc, photo, archive, etc.) enclosed and transmitted alongside the email message.","hi":"ईमेल बॉडी (Body) ईमेल के भीतर लिखा गया मुख्य संदेश होता है, जबकि अटैचमेंट (Attachment) उस ईमेल के साथ संलग्न करके भेजी गई कोई बाहरी फ़ाइल (जैसे डॉक्यूमेंट, फोटो, पीडीएफ या वीडियो) होती है।"},"num":68},{"id":"q69","q":{"en":"What is the standard step-by-step sequence for composing and sending an email in a webmail service like Gmail?","hi":"Gmail जैसी सेवा में नया ईमेल लिखने और भेजने (Compose & Send) का सामान्य क्रम क्या है?"},"a":{"en":"Click Compose → Enter recipient(s) in To (and CC/BCC if needed) → Enter Subject → Write message body → Add attachment if needed → Click Send","hi":"Compose पर क्लिक करें → To में प्राप्तकर्ता का पता भरें → Subject लिखें → मैसेज बॉडी लिखें → ज़रूरत हो तो अटैचमेंट जोड़ें → Send पर क्लिक करें"},"o":[{"en":"Click Compose → Enter recipient(s) in To (and CC/BCC if needed) → Enter Subject → Write message body → Add attachment if needed → Click Send","hi":"Compose पर क्लिक करें → To में प्राप्तकर्ता का पता भरें → Subject लिखें → मैसेज बॉडी लिखें → ज़रूरत हो तो अटैचमेंट जोड़ें → Send पर क्लिक करें"},{"en":"Click Trash → Click Spam → Type password in Subject → Unplug router","hi":"Trash पर क्लिक करें → Spam पर क्लिक करें → राउटर अनप्लग करें"},{"en":"Click Send first → Then click Compose → Then type the recipient address","hi":"पहले Send दबाएँ → फिर Compose दबाएँ → फिर पता लिखें"},{"en":"Open BIOS → Format hard disk → Press Alt + F4","hi":"BIOS खोलें → हार्ड डिस्क फ़ॉर्मेट करें → Alt + F4 दबाएँ"}],"exp":{"en":"Standard workflow to send an email (PDF p. 144): 1. Click 'Compose' (New Message) → 2. Enter recipient email address(es) in the 'To' field (plus CC/BCC as appropriate) → 3. Write a concise 'Subject' line → 4. Type the message in the body area → 5. Attach files via the paperclip icon if required → 6. Click 'Send'.","hi":"ईमेल कंपोज़ करने का सही क्रम: `Compose` पर क्लिक करें → `To` फ़ील्ड में प्राप्तकर्ता का ईमेल पता लिखें → `Subject` (विषय) लिखें → मुख्य संदेश (message body) लिखें → आवश्यकता हो तो फ़ाइल अटैच करें → अंत में `Send` बटन पर क्लिक करें।"},"num":69},{"id":"q70","q":{"en":"What are the respective uses of the 'To', 'CC', and 'BCC' fields when composing an email?","hi":"ईमेल लिखते समय 'To', 'CC' और 'BCC' फ़ील्ड्स का क्रमशः क्या उपयोग होता है?"},"a":{"en":"'To' is for primary recipient(s), 'CC' is for visible copy recipient(s), and 'BCC' is for hidden copy recipient(s)","hi":"'To' मुख्य प्राप्तकर्ताओं के लिए, 'CC' दृश्यमान कॉपी (visible copy) प्राप्तकर्ताओं के लिए, और 'BCC' गुप्त कॉपी (hidden copy) प्राप्तकर्ताओं के लिए होता है"},"o":[{"en":"'To' is for primary recipient(s), 'CC' is for visible copy recipient(s), and 'BCC' is for hidden copy recipient(s)","hi":"'To' मुख्य प्राप्तकर्ताओं के लिए, 'CC' दृश्यमान कॉपी (visible copy) प्राप्तकर्ताओं के लिए, और 'BCC' गुप्त कॉपी (hidden copy) प्राप्तकर्ताओं के लिए होता है"},{"en":"'To' is for the sender's own address, 'CC' is for the subject line, and 'BCC' is for attachments","hi":"'To' भेजने वाले के पते के लिए, 'CC' विषय के लिए, और 'BCC' अटैचमेंट के लिए"},{"en":"'To' hides all addresses, while 'BCC' shows all addresses publicly to everyone","hi":"'To' सभी पते छिपाता है, जबकि 'BCC' सभी को पते दिखाता है"},{"en":"All three fields are used only to change the font colour of the email","hi":"तीनों फ़ील्ड का उपयोग केवल ईमेल का फ़ॉन्ट रंग बदलने के लिए होता है"}],"exp":{"en":"In email addressing: `To` specifies the primary addressee(s) directly responsible for acting on the message; `CC` sends a visible informational copy to secondary recipients; and `BCC` sends a blind (hidden) copy to recipients without revealing their addresses to other recipients.","hi":"`To` फ़ील्ड मुख्य प्राप्तकर्ताओं (primary recipients) के लिए होता है, `CC` उन प्राप्तकर्ताओं के लिए जिन्हें ईमेल की सूचनात्मक प्रति (visible copy) भेजनी हो, और `BCC` उन प्राप्तकर्ताओं के लिए जिनका ईमेल पता अन्य प्राप्तकर्ताओं से छिपाकर (hidden copy) रखना हो।"},"num":70},{"id":"q71","q":{"en":"What are the full forms of 'CC' and 'BCC' in email?","hi":"ईमेल में 'CC' और 'BCC' के पूर्ण रूप (Full Forms) क्या हैं?"},"a":{"en":"Carbon Copy (CC) and Blind Carbon Copy (BCC)","hi":"कार्बन कॉपी (Carbon Copy) और ब्लाइंड कार्बन कॉपी (Blind Carbon Copy)"},"o":[{"en":"Carbon Copy (CC) and Blind Carbon Copy (BCC)","hi":"कार्बन कॉपी (Carbon Copy) और ब्लाइंड कार्बन कॉपी (Blind Carbon Copy)"},{"en":"Computer Code and Binary Computer Code","hi":"कंप्यूटर कोड और बाइनरी कंप्यूटर कोड"},{"en":"Client Copy and Backup Client Copy","hi":"क्लाइंट कॉपी और बैकअप क्लाइंट कॉपी"},{"en":"Central Channel and Broadcast Channel","hi":"सेंट्रल चैनल और ब्रॉडकास्ट चैनल"}],"exp":{"en":"CC stands for Carbon Copy, and BCC stands for Blind Carbon Copy.","hi":"CC का पूर्ण रूप Carbon Copy है और BCC का पूर्ण रूप Blind Carbon Copy है।"},"num":71},{"id":"q72","q":{"en":"How does recipient visibility differ between 'CC' and 'BCC'?","hi":"'CC' और 'BCC' में रखे गए प्राप्तकर्ताओं की दृश्यता (Visibility) में क्या अंतर होता है?"},"a":{"en":"All recipients can see the addresses listed in 'To' and 'CC', whereas 'BCC' addresses are ordinarily hidden from other recipients (though the sender can still see them in their Sent copy)","hi":"सभी प्राप्तकर्ता 'To' और 'CC' के पते देख सकते हैं, जबकि 'BCC' के पते सामान्यतः अन्य प्राप्तकर्ताओं को दिखाई नहीं देते (भेजने वाला अपनी Sent कॉपी में उन्हें देख सकता है)"},"o":[{"en":"All recipients can see the addresses listed in 'To' and 'CC', whereas 'BCC' addresses are ordinarily hidden from other recipients (though the sender can still see them in their Sent copy)","hi":"सभी प्राप्तकर्ता 'To' और 'CC' के पते देख सकते हैं, जबकि 'BCC' के पते सामान्यतः अन्य प्राप्तकर्ताओं को दिखाई नहीं देते (भेजने वाला अपनी Sent कॉपी में उन्हें देख सकता है)"},{"en":"BCC addresses are printed in bold red letters at the top of every recipient's screen, whereas CC addresses are hidden","hi":"BCC पते हर किसी की स्क्रीन पर लाल अक्षरों में दिखते हैं, जबकि CC पते छिपे रहते हैं"},{"en":"Neither To, CC, nor BCC addresses are ever visible to anyone","hi":"किसी को भी कोई पता कभी दिखाई नहीं देता"},{"en":"CC recipients do not receive the email body, whereas BCC recipients only receive the subject line","hi":"CC को मुख्य संदेश नहीं मिलता, जबकि BCC को केवल विषय मिलता है"}],"exp":{"en":"Every recipient of an email can see the email addresses placed in the `To` and `CC` fields in the message headers. Addresses placed in the `BCC` field are stripped from the headers delivered to other recipients, so `To` and `CC` recipients cannot see who was BCC'd.","hi":"ईमेल प्राप्त करने वाले सभी लोग `To` और `CC` फ़ील्ड में डाले गए ईमेल पतों को देख सकते हैं। इसके विपरीत, `BCC` फ़ील्ड में डाले गए पते अन्य प्राप्तकर्ताओं से छिपे रहते हैं (हालाँकि भेजने वाला व्यक्ति अपने Sent फ़ोल्डर में उन्हें देख सकता है)।"},"num":72},{"id":"q73","q":{"en":"When emailing a large group of people, which field should be used to hide their email addresses from one another?","hi":"किसी बड़े समूह (Group) को ईमेल भेजते समय उनके ईमेल पते बाकी प्राप्तकर्ताओं से छिपाने के लिए किस फ़ील्ड का उपयोग करना चाहिए?"},"a":{"en":"BCC (Blind Carbon Copy) — because primary 'To' and 'CC' addresses are visible in the message headers","hi":"BCC (ब्लाइंड कार्बन कॉपी) — क्योंकि 'To' और 'CC' के पते मैसेज हेडर में सभी को दिखाई देते हैं"},"o":[{"en":"BCC (Blind Carbon Copy) — because primary 'To' and 'CC' addresses are visible in the message headers","hi":"BCC (ब्लाइंड कार्बन कॉपी) — क्योंकि 'To' और 'CC' के पते मैसेज हेडर में सभी को दिखाई देते हैं"},{"en":"To field","hi":"To फ़ील्ड"},{"en":"CC field","hi":"CC फ़ील्ड"},{"en":"Subject field","hi":"Subject फ़ील्ड"}],"exp":{"en":"To protect privacy and prevent exposing a list of email addresses to every recipient in a mass/group email, the group's addresses should be placed in the `BCC` field.","hi":"किसी समूह को ईमेल भेजते समय सदस्यों के ईमेल पते एक-दूसरे से गोपनीय (hide) रखने के लिए `BCC` फ़ील्ड का उपयोग किया जाता है, क्योंकि `To` और `CC` में लिखे पते सभी को दिखते हैं।"},"num":73},{"id":"q74","q":{"en":"What are the respective roles of the 'Subject Line' and the 'Signature' in an email?","hi":"ईमेल में 'सब्जेक्ट लाइन' (Subject Line) और 'सिग्नेचर' (Signature) की क्या भूमिका होती है?"},"a":{"en":"The Subject line briefly states the topic/purpose of the email, while the Signature automatically appends sender details (such as name, designation, phone, or website) at the end of the message","hi":"सब्जेक्ट लाइन ईमेल का विषय (topic) बताती है, जबकि सिग्नेचर संदेश के अंत में भेजने वाले का नाम, पदनाम, संपर्क जानकारी या वेबसाइट जोड़ सकता है"},"o":[{"en":"The Subject line briefly states the topic/purpose of the email, while the Signature automatically appends sender details (such as name, designation, phone, or website) at the end of the message","hi":"सब्जेक्ट लाइन ईमेल का विषय (topic) बताती है, जबकि सिग्नेचर संदेश के अंत में भेजने वाले का नाम, पदनाम, संपर्क जानकारी या वेबसाइट जोड़ सकता है"},{"en":"The Subject line encrypts the email, and the Signature deletes spam","hi":"सब्जेक्ट लाइन ईमेल को एन्क्रिप्ट करती है, और सिग्नेचर स्पैम को हटाता है"},{"en":"The Subject line holds file attachments, and the Signature holds BCC addresses","hi":"सब्जेक्ट लाइन में फ़ाइल अटैचमेंट होते हैं, और सिग्नेचर में BCC पते"},{"en":"Both are used by the router to calculate bandwidth","hi":"दोनों का उपयोग राउटर द्वारा बैंडविड्थ की गणना करने के लिए किया जाता है"}],"exp":{"en":"The Subject line summarizes the topic of the message so the recipient knows what it is about before opening it. An email Signature is a pre-configured block of text at the bottom of an email containing the sender's name, job title, company, contact details, or website link.","hi":"सब्जेक्ट लाइन (Subject line) संक्षेप में ईमेल का मुख्य विषय या उद्देश्य बताती है। सिग्नेचर (Signature) संदेश के अंत में स्वतः जुड़ने वाला टेक्स्ट ब्लॉक है जिसमें भेजने वाले का नाम, पद, संपर्क नंबर या वेबसाइट की जानकारी दी जा सकती है।"},"num":74},{"id":"q75","q":{"en":"What does the 'Inbox' folder display in an email account?","hi":"ईमेल अकाउंट में 'इनबॉक्स' (Inbox) क्या दिखाता है?"},"a":{"en":"Incoming received messages, typically listed with the sender's name/address, subject line, and received date/time","hi":"प्राप्त हुए संदेश (Received messages), जो आमतौर पर भेजने वाले का नाम (sender), विषय (subject) और प्राप्त होने की तारीख/समय दिखाते हैं"},"o":[{"en":"Incoming received messages, typically listed with the sender's name/address, subject line, and received date/time","hi":"प्राप्त हुए संदेश (Received messages), जो आमतौर पर भेजने वाले का नाम (sender), विषय (subject) और प्राप्त होने की तारीख/समय दिखाते हैं"},{"en":"Only unsent rough drafts that have never been transmitted","hi":"केवल अधूरे लिखे गए ड्राफ्ट जो कभी भेजे नहीं गए"},{"en":"Only outgoing messages sent by the user to others","hi":"केवल यूज़र द्वारा दूसरों को भेजे गए संदेश"},{"en":"Only deleted files from the Windows desktop","hi":"विंडोज़ डेस्कटॉप से हटाई गई केवल फ़ाइलें"}],"exp":{"en":"The Inbox is the default primary folder where newly received incoming emails arrive, displaying a summary row for each message with the sender, subject, snippet, and timestamp.","hi":"इनबॉक्स (Inbox) में प्राप्त हुए ईमेल संदेश (received messages) दिखाई देते हैं, जिनमें सामान्यतः भेजने वाले का नाम (sender), ईमेल का विषय (subject) और प्राप्त होने की तिथि/समय (received date/time) सूचीबद्ध होते हैं।"},"num":75},{"id":"q76","q":{"en":"Which feature does the 'Paperclip Icon' indicate in an email interface?","hi":"ईमेल इंटरफेस में 'पेपरक्लिप आइकन' (Paperclip Icon) किस फ़ीचर को दर्शाता है?"},"a":{"en":"Adding a file attachment (in the compose toolbar) or indicating that a received email contains an attached file","hi":"फ़ाइल अटैच करने का बटन (कंपोज़ टूलबार में) या किसी ईमेल में अटैचमेंट मौजूद होने का संकेत"},"o":[{"en":"Adding a file attachment (in the compose toolbar) or indicating that a received email contains an attached file","hi":"फ़ाइल अटैच करने का बटन (कंपोज़ टूलबार में) या किसी ईमेल में अटैचमेंट मौजूद होने का संकेत"},{"en":"Permanently deleting the email account","hi":"ईमेल अकाउंट को स्थायी रूप से डिलीट करना"},{"en":"Blocking the sender as spam","hi":"भेजने वाले को स्पैम के रूप में ब्लॉक करना"},{"en":"Logging out of the web browser","hi":"वेब ब्राउज़र से लॉग आउट करना"}],"exp":{"en":"Across email clients and webmail interfaces (like Gmail and Outlook), the Paperclip icon universally represents file attachments—clicking it in the compose window lets you attach a file, and seeing it in the inbox indicates an email has an attachment.","hi":"ईमेल इंटरफेस में 'पेपरक्लिप आइकन' (Paperclip icon) फ़ाइल अटैचमेंट (Attachment) को दर्शाता है—कंपोज़ विंडो में इस पर क्लिक करके फ़ाइल जोड़ी जाती है, और इनबॉक्स में यह दर्शाता है कि ईमेल के साथ कोई फ़ाइल जुड़ी हुई है।"},"num":76},{"id":"q77","q":{"en":"Which folders and items are typically found in an email client's left Navigation Menu?","hi":"ईमेल के नेविगेशन मेनू (Navigation Menu) में सामान्यतः कौन-से फ़ोल्डर्स और विकल्प मिलते हैं?"},"a":{"en":"Inbox, Sent, Drafts, Spam (Junk), Trash (Bin), and custom labels/folders (with Contacts and Calendar accessible via app/menu links)","hi":"Inbox, Sent, Drafts, Spam, Trash और लेबल्स (साथ ही अलग ऐप/मेनू लिंक से Contacts और Calendar भी मिल सकते हैं)"},"o":[{"en":"Inbox, Sent, Drafts, Spam (Junk), Trash (Bin), and custom labels/folders (with Contacts and Calendar accessible via app/menu links)","hi":"Inbox, Sent, Drafts, Spam, Trash और लेबल्स (साथ ही अलग ऐप/मेनू लिंक से Contacts और Calendar भी मिल सकते हैं)"},{"en":"ALU, Control Unit, MAR, MBR, and Program Counter","hi":"ALU, कंट्रोल यूनिट, MAR, MBR और प्रोग्राम काउंटर"},{"en":"BIOS, Bootloader, Kernel, and Device Driver","hi":"BIOS, बूटलोडर, कर्नेल और डिवाइस ड्राइवर"},{"en":"NEFT, RTGS, IMPS, and ECS","hi":"NEFT, RTGS, IMPS और ECS"}],"exp":{"en":"The standard navigation sidebar in an email service contains mailbox views/folders such as Inbox, Starred, Sent, Drafts, Spam, Trash, and user-created Labels/Folders, while integrated tools like Contacts and Calendar are available via adjacent menu/app launcher links.","hi":"ईमेल के नेविगेशन मेनू में मुख्य रूप से `Inbox`, `Sent`, `Drafts`, `Spam`, `Trash` और कस्टम लेबल्स/फ़ोल्डर्स मिलते हैं (साथ ही ऐप मेनू के माध्यम से Contacts और Calendar भी एक्सेस किए जा सकते हैं)।"},"num":77},{"id":"q78","q":{"en":"Which messages are stored in the 'Drafts' folder of an email account?","hi":"ईमेल के 'ड्राफ्ट्स' (Drafts) फ़ोल्डर में कौन-से संदेश होते हैं?"},"a":{"en":"Messages that have been composed (started/saved) but not yet sent, which can be edited and sent later","hi":"लिखे हुए लेकिन अभी तक न भेजे गए (unsent) संदेश, जिन्हें बाद में एडिट करके भेजा जा सकता है"},"o":[{"en":"Messages that have been composed (started/saved) but not yet sent, which can be edited and sent later","hi":"लिखे हुए लेकिन अभी तक न भेजे गए (unsent) संदेश, जिन्हें बाद में एडिट करके भेजा जा सकता है"},{"en":"Messages that have already been delivered to the recipient","hi":"वे संदेश जो प्राप्तकर्ता को पहले ही डिलीवर हो चुके हैं"},{"en":"Unsolicited promotional and phishing emails filtered by the server","hi":"सर्वर द्वारा फ़िल्टर किए गए अनचाहे विज्ञापन और फ़िशिंग ईमेल"},{"en":"Only incoming emails with video attachments","hi":"वीडियो अटैचमेंट वाले केवल इनकमिंग ईमेल"}],"exp":{"en":"The Drafts folder automatically holds in-progress or saved messages that the user has started writing but has not yet sent, allowing them to be reopened, edited, and sent later.","hi":"ड्राफ्ट्स (Drafts) फ़ोल्डर में वे ईमेल सुरक्षित रहते हैं जिन्हें यूज़र ने लिखना शुरू किया है परंतु अभी तक भेजा नहीं है (unsent messages)। इन्हें बाद में दोबारा खोलकर एडिट और सेंड किया जा सकता है।"},"num":78},{"id":"q79","q":{"en":"What is stored in the 'Sent' (Sent Mail) folder?","hi":"'सेंट' (Sent) फ़ोल्डर में क्या रखा होता है?"},"a":{"en":"Copies of outgoing messages that have been successfully sent by the user","hi":"यूज़र द्वारा भेजे गए संदेशों (sent messages) की प्रतियाँ (copies)"},"o":[{"en":"Copies of outgoing messages that have been successfully sent by the user","hi":"यूज़र द्वारा भेजे गए संदेशों (sent messages) की प्रतियाँ (copies)"},{"en":"Only incoming emails from unknown senders","hi":"अज्ञात प्रेषकों से आए केवल इनकमिंग ईमेल"},{"en":"Deleted emails waiting to be permanently erased","hi":"स्थायी रूप से मिटाए जाने की प्रतीक्षा कर रहे डिलीट किए गए ईमेल"},{"en":"Web browser bookmarks and browsing history","hi":"वेब ब्राउज़र बुकमार्क और ब्राउज़िंग हिस्ट्री"}],"exp":{"en":"The Sent (or Sent Items / Sent Mail) folder stores copies of all outgoing emails that the user has transmitted.","hi":"सेंट (Sent) फ़ोल्डर में उपयोगकर्ता द्वारा सफलतापूर्वक भेजे जा चुके ईमेल संदेशों की कॉपियाँ (copies) सुरक्षित रहती हैं।"},"num":79},{"id":"q80","q":{"en":"What is 'Spam' in email, and what is the role of the 'Spam' (Junk) folder?","hi":"ईमेल में 'स्पैम' (Spam) क्या होता है और 'Spam' फ़ोल्डर का क्या काम है?"},"a":{"en":"Unsolicited bulk or suspicious emails (which may contain scams, phishing links, or malicious attachments); the mail provider automatically filters suspected junk messages into the Spam folder","hi":"अनचाहे (unsolicited) या संदिग्ध ईमेल, जिनमें स्कैम या दुर्भावनापूर्ण अटैचमेंट हो सकते हैं; मेल प्रदाता संदिग्ध संदेशों को स्वतः ही Spam फ़ोल्डर में फ़िल्टर कर देता है"},"o":[{"en":"Unsolicited bulk or suspicious emails (which may contain scams, phishing links, or malicious attachments); the mail provider automatically filters suspected junk messages into the Spam folder","hi":"अनचाहे (unsolicited) या संदिग्ध ईमेल, जिनमें स्कैम या दुर्भावनापूर्ण अटैचमेंट हो सकते हैं; मेल प्रदाता संदिग्ध संदेशों को स्वतः ही Spam फ़ोल्डर में फ़िल्टर कर देता है"},{"en":"Important official emails from your bank that are pinned to the top of the Inbox","hi":"आपके बैंक से आए महत्वपूर्ण आधिकारिक ईमेल जो इनबॉक्स में सबसे ऊपर पिन किए जाते हैं"},{"en":"A folder used to store high-resolution family photographs","hi":"उच्च-रिज़ॉल्यूशन वाली पारिवारिक तस्वीरें स्टोर करने का फ़ोल्डर"},{"en":"A hardware filter that cleans dust from the computer fan","hi":"कंप्यूटर के पंखे से धूल साफ करने वाला हार्डवेयर फ़िल्टर"}],"exp":{"en":"Spam refers to unsolicited, unwanted bulk emails or suspicious messages (often carrying advertisements, phishing scams, or malware attachments). Email providers use automated spam filters to divert such messages away from the main Inbox into the Spam (or Junk) folder.","hi":"अनचाहे बल्क विज्ञापनों या संदिग्ध ईमेल संदेशों (जिनमें धोखाधड़ी/स्कैम के लिंक या मैलवेयर अटैचमेंट हो सकते हैं) को 'स्पैम' (Spam या Junk mail) कहते हैं। ईमेल सर्विस प्रोवाइडर ऐसे संदिग्ध संदेशों को मुख्य इनबॉक्स से अलग रखकर स्वतः ही Spam फ़ोल्डर में फ़िल्टर कर देता है।"},"num":80},{"id":"q81","q":{"en":"What happens to an email message that is moved to the 'Trash' (Bin) folder?","hi":"'ट्रैश' (Trash / Bin) फ़ोल्डर में मूव किए गए ईमेल का क्या होता है?"},"a":{"en":"It can be recovered during the retention period, after which it may be permanently deleted according to the service's policy (e.g., 30 days in Gmail)","hi":"रिटेंशन अवधि (retention period) के दौरान इसे रिकवर किया जा सकता है; उसके बाद सर्विस पॉलिसी के अनुसार यह स्थायी रूप से डिलीट हो सकता है"},"o":[{"en":"It can be recovered during the retention period, after which it may be permanently deleted according to the service's policy (e.g., 30 days in Gmail)","hi":"रिटेंशन अवधि (retention period) के दौरान इसे रिकवर किया जा सकता है; उसके बाद सर्विस पॉलिसी के अनुसार यह स्थायी रूप से डिलीट हो सकता है"},{"en":"It is immediately forwarded to all contacts in the address book","hi":"इसे तुरंत एड्रेस बुक के सभी संपर्कों को फॉरवर्ड कर दिया जाता है"},{"en":"It is printed on the default office printer automatically","hi":"यह डिफ़ॉल्ट ऑफिस प्रिंटर पर स्वतः प्रिंट हो जाता है"},{"en":"It can never be recovered even 1 second after moving to Trash","hi":"Trash में जाने के 1 सेकंड बाद भी इसे कभी रिकवर नहीं किया जा सकता"}],"exp":{"en":"When an email is deleted/moved to the Trash (or Bin) folder, it remains recoverable during the email provider's retention window (typically 30 days), after which it is permanently purged (unless the user manually empties the Trash earlier).","hi":"जब कोई ईमेल 'Trash' (Bin) फ़ोल्डर में भेजा जाता है, तो निर्धारित रिटेंशन अवधि (retention period — जैसे Gmail में 30 दिन) के दौरान उसे वापस रिकवर किया जा सकता है। इस अवधि के समाप्त होने पर सर्विस पॉलिसी के अनुसार वह स्थायी रूप से डिलीट हो जाता है।"},"num":81}]},{"title":{"en":"6. Archive, Reply, Reply All & Forward","hi":"6. आर्काइव, रिप्लाई, रिप्लाई ऑल और फॉरवर्ड"},"questions":[{"id":"q82","q":{"en":"What does the 'Archive' command do in an email service?","hi":"ईमेल में 'आर्काइव' (Archive) कमांड क्या करती है?"},"a":{"en":"It removes the message from the main Inbox view while keeping it safely stored in the mailbox (accessible via Search or 'All Mail')","hi":"यह संदेश को मुख्य इनबॉक्स (Inbox) से हटा देती है लेकिन उसे मेलबॉक्स में सुरक्षित रखती है (जहाँ से वह Search या 'All Mail' में मिल सकता है)"},"o":[{"en":"It removes the message from the main Inbox view while keeping it safely stored in the mailbox (accessible via Search or 'All Mail')","hi":"यह संदेश को मुख्य इनबॉक्स (Inbox) से हटा देती है लेकिन उसे मेलबॉक्स में सुरक्षित रखती है (जहाँ से वह Search या 'All Mail' में मिल सकता है)"},{"en":"It permanently erases the message from the mail server within 5 seconds","hi":"यह 5 सेकंड के भीतर मेल सर्वर से संदेश को स्थायी रूप से मिटा देती है"},{"en":"It sends the message back to the sender as an undeliverable bounce","hi":"यह संदेश को डिलीवर न हो सकने वाले बाउंस के रूप में प्रेषक को वापस भेज देती है"},{"en":"It converts the email into a ZIP file and deletes the account","hi":"यह ईमेल को ZIP फ़ाइल में बदलती है और अकाउंट डिलीट कर देती है"}],"exp":{"en":"Archiving an email removes it from the clutter of the primary Inbox without deleting it; the message remains preserved in the user's mailbox and can be retrieved anytime via Search or the 'All Mail' / Archive view.","hi":"'Archive' कमांड ईमेल को मुख्य इनबॉक्स (Inbox) से हटाकर मेलबॉक्स में सुरक्षित रखती है, ताकि इनबॉक्स साफ रहे और ज़रूरत पड़ने पर उस ईमेल को 'Search' या 'All Mail' व्यू से कभी भी ढूँढा जा सके।"},"num":82},{"id":"q83","q":{"en":"What is the key exam distinction between 'Archive' and 'Trash' in email?","hi":"ईमेल में 'आर्काइव' (Archive) और 'ट्रैश' (Trash) के बीच मुख्य परीक्षा अंतर क्या है?"},"a":{"en":"Archive cleans up the Inbox while preserving the mail permanently in the mailbox, whereas Trash places the mail in a deletion queue subject to the retention/permanent-deletion policy","hi":"Archive इनबॉक्स को साफ करता है और मेल को सुरक्षित रखता है, जबकि Trash डिलीशन कतार (deletion queue) है जहाँ रिटेंशन पॉलिसी लागू होती है"},"o":[{"en":"Archive cleans up the Inbox while preserving the mail permanently in the mailbox, whereas Trash places the mail in a deletion queue subject to the retention/permanent-deletion policy","hi":"Archive इनबॉक्स को साफ करता है और मेल को सुरक्षित रखता है, जबकि Trash डिलीशन कतार (deletion queue) है जहाँ रिटेंशन पॉलिसी लागू होती है"},{"en":"Archive deletes emails after 30 days, whereas Trash keeps emails forever","hi":"Archive 30 दिनों के बाद ईमेल हटा देता है, जबकि Trash ईमेल को हमेशा के लिए रखता है"},{"en":"Archive sends emails to Spam, whereas Trash forwards emails to BCC","hi":"Archive ईमेल को स्पैम में भेजता है, जबकि Trash ईमेल को BCC को फॉरवर्ड करता है"},{"en":"There is no difference; both immediately wipe the hard drive","hi":"कोई अंतर नहीं है; दोनों तुरंत हार्ड ड्राइव को साफ कर देते हैं"}],"exp":{"en":"Exam cue: Use 'Archive' when you want to hide/remove an email from the Inbox but keep it indefinitely for future reference. Use 'Trash' when you intend to delete the email (where it awaits permanent deletion after the retention period).","hi":"परीक्षा अंतर: 'Archive' का काम इनबॉक्स को व्यवस्थित/साफ करना और ईमेल को भविष्य के लिए सुरक्षित (preserve) रखना है; जबकि 'Trash' डिलीट किए गए ईमेल की कतार (deletion queue) है जहाँ रिटेंशन अवधि के बाद ईमेल स्थायी रूप से मिट जाता है।"},"num":83},{"id":"q84","q":{"en":"When is the 'Reply' command used in email?","hi":"ईमेल में 'रिप्लाई' (Reply) कमांड का उपयोग कब होता है?"},"a":{"en":"To send a response only to the sender (or the configured Reply-To address) of an incoming message","hi":"प्राप्त हुए संदेश के केवल भेजने वाले (sender या कॉन्फ़िगर किए गए Reply-To पते) को जवाब भेजने के लिए"},"o":[{"en":"To send a response only to the sender (or the configured Reply-To address) of an incoming message","hi":"प्राप्त हुए संदेश के केवल भेजने वाले (sender या कॉन्फ़िगर किए गए Reply-To पते) को जवाब भेजने के लिए"},{"en":"To send a response simultaneously to every person in the To and CC fields","hi":"To और CC फ़ील्ड के सभी लोगों को एक साथ जवाब भेजने के लिए"},{"en":"To send the message to a brand-new third party who was not on the original email","hi":"किसी ऐसे नए व्यक्ति को संदेश भेजने के लिए जो मूल ईमेल में शामिल नहीं था"},{"en":"To move an unread message into the Drafts folder","hi":"किसी अपठित संदेश को ड्राफ्ट फ़ोल्डर में ले जाने के लिए"}],"exp":{"en":"Clicking 'Reply' addresses your response strictly to the individual sender of the received message (or to the address specified in the message's `Reply-To` header), excluding other recipients who were on `To` or `CC`.","hi":"'Reply' का उपयोग किसी प्राप्त हुए ईमेल के केवल मूल प्रेषक (sender) या कॉन्फ़िगर किए गए `Reply-To` एड्रेस को ही वापस जवाब (response) भेजने के लिए किया जाता है।"},"num":84},{"id":"q85","q":{"en":"When is the 'Reply All' command used in email?","hi":"ईमेल में 'रिप्लाई ऑल' (Reply All) कमांड का उपयोग कब किया जाता है?"},"a":{"en":"To send a response to the original sender as well as all other original visible recipients (in To and CC) on the thread","hi":"भेजने वाले (sender) और मूल ईमेल के सभी दृश्यमान प्राप्तकर्ताओं (visible recipients — To व CC) को एक साथ जवाब देने के लिए"},"o":[{"en":"To send a response to the original sender as well as all other original visible recipients (in To and CC) on the thread","hi":"भेजने वाले (sender) और मूल ईमेल के सभी दृश्यमान प्राप्तकर्ताओं (visible recipients — To व CC) को एक साथ जवाब देने के लिए"},{"en":"To send an email to every user registered on the Internet","hi":"इंटरनेट पर पंजीकृत प्रत्येक यूज़र को ईमेल भेजने के लिए"},{"en":"To reply only to hidden BCC recipients while excluding the sender","hi":"भेजने वाले को छोड़कर केवल गुप्त BCC प्राप्तकर्ताओं को जवाब देने के लिए"},{"en":"To automatically reply to all spam messages in the Junk folder","hi":"जंक फ़ोल्डर के सभी स्पैम संदेशों का स्वतः जवाब देने के लिए"}],"exp":{"en":"Clicking 'Reply All' sends your response to the original sender AND all other visible recipients listed in the `To` and `CC` headers of that email thread.","hi":"'Reply All' का उपयोग तब किया जाता है जब आप मूल ईमेल भेजने वाले (sender) के साथ-साथ उस ईमेल में शामिल अन्य सभी दृश्यमान प्राप्तकर्ताओं (original visible recipients — To और CC) को भी अपना जवाब भेजना चाहते हैं।"},"num":85},{"id":"q86","q":{"en":"What does the 'Forward' command do in an email client?","hi":"ईमेल में 'फॉरवर्ड' (Forward) कमांड क्या करती है?"},"a":{"en":"It allows you to send a received message (along with its attachments) to a new recipient or recipients, optionally adding your own comments","hi":"यह किसी प्राप्त हुए संदेश को (वैकल्पिक रूप से अपनी टिप्पणी जोड़कर) किसी नए प्राप्तकर्ता (new recipient) को भेजने की सुविधा देती है"},"o":[{"en":"It allows you to send a received message (along with its attachments) to a new recipient or recipients, optionally adding your own comments","hi":"यह किसी प्राप्त हुए संदेश को (वैकल्पिक रूप से अपनी टिप्पणी जोड़कर) किसी नए प्राप्तकर्ता (new recipient) को भेजने की सुविधा देती है"},{"en":"It fast-forwards audio and video files inside VLC Media Player","hi":"यह VLC मीडिया प्लेयर के अंदर ऑडियो और वीडियो फ़ाइलों को फास्ट-फॉरवर्ड करती है"},{"en":"It replies only to the original sender without letting you edit the recipient field","hi":"यह प्राप्तकर्ता फ़ील्ड को बदलने की अनुमति दिए बिना केवल मूल प्रेषक को जवाब देती है"},{"en":"It moves the email from the Sent folder back into the Drafts folder","hi":"यह ईमेल को Sent फ़ोल्डर से वापस Drafts फ़ोल्डर में ले जाती है"}],"exp":{"en":"The 'Forward' action takes a received email message (including its content and attached files) and lets you enter new recipient email addresses (`To`/`CC`/`BCC`) and optional introductory remarks to share it with others.","hi":"'Forward' कमांड किसी प्राप्त हुए ईमेल संदेश को (वैकल्पिक रूप से अपनी टिप्पणी/comments के साथ) किसी नए व्यक्ति या प्राप्तकर्ता को आगे भेजने की सुविधा देती है।"},"num":86},{"id":"q87","q":{"en":"What is the quick exam match for 'Reply', 'Reply All', and 'Forward'?","hi":"'Reply', 'Reply All' और 'Forward' का संक्षिप्त परीक्षा मिलान (Quick Match) क्या है?"},"a":{"en":"Reply → sender / Reply-To only; Reply All → sender and visible group (To/CC); Forward → chosen new recipients","hi":"Reply → केवल प्रेषक (sender/Reply-To); Reply All → प्रेषक और दृश्यमान समूह; Forward → चुने गए नए प्राप्तकर्ता"},"o":[{"en":"Reply → sender / Reply-To only; Reply All → sender and visible group (To/CC); Forward → chosen new recipients","hi":"Reply → केवल प्रेषक (sender/Reply-To); Reply All → प्रेषक और दृश्यमान समूह; Forward → चुने गए नए प्राप्तकर्ता"},{"en":"Reply → new recipients; Reply All →BCC only; Forward → sender only","hi":"Reply → नए प्राप्तकर्ता; Reply All → केवल BCC; Forward → केवल प्रेषक"},{"en":"Reply → Archive; Reply All → Trash; Forward → Spam","hi":"Reply → आर्काइव; Reply All → ट्रैश; Forward → स्पैम"},{"en":"All three send messages only to the Drafts folder","hi":"तीनों केवल ड्राफ्ट फ़ोल्डर में संदेश भेजते हैं"}],"exp":{"en":"Quick revision match: `Reply` = responds to the sender (or Reply-To); `Reply All` = responds to the sender plus all visible group recipients (`To` and `CC`); `Forward` = shares the message with newly chosen recipients.","hi":"त्वरित मिलान: `Reply` → केवल मूल प्रेषक (sender/Reply-To) को जवाब; `Reply All` → प्रेषक और दृश्यमान समूह (To व CC) सभी को जवाब; `Forward` → चुने गए नए प्राप्तकर्ताओं (new recipients) को संदेश भेजना।"},"num":87},{"id":"q88","q":{"en":"Are original 'BCC' recipients automatically included when someone clicks 'Reply All' on an email?","hi":"क्या किसी ईमेल पर 'Reply All' करने पर मूल ईमेल के 'BCC' प्राप्तकर्ता स्वतः ही उसमें शामिल हो जाते हैं?"},"a":{"en":"No — 'Reply All' is based on visible recipient headers (From/Reply-To, To, and CC), so the original BCC list is hidden and is NOT automatically included","hi":"नहीं — 'Reply All' दृश्यमान हेडर (visible headers) पर आधारित होता है, इसलिए मूल BCC सूची स्वतः शामिल नहीं होती"},"o":[{"en":"No — 'Reply All' is based on visible recipient headers (From/Reply-To, To, and CC), so the original BCC list is hidden and is NOT automatically included","hi":"नहीं — 'Reply All' दृश्यमान हेडर (visible headers) पर आधारित होता है, इसलिए मूल BCC सूची स्वतः शामिल नहीं होती"},{"en":"Yes — 'Reply All' exposes and emails every BCC recipient automatically","hi":"हाँ — 'Reply All' सभी BCC प्राप्तकर्ताओं को उजागर कर देता है और स्वतः ईमेल भेजता है"},{"en":"Yes — 'Reply All' sends the reply only to BCC recipients and removes the 'To' recipients","hi":"हाँ — 'Reply All' केवल BCC को जवाब भेजता है और 'To' को हटा देता है"},{"en":"Only if the email contains a PDF attachment","hi":"केवल तभी जब ईमेल में कोई PDF अटैचमेंट हो"}],"exp":{"en":"Because BCC addresses are stripped from the message headers delivered to recipients, a recipient's email client has no knowledge of who was on the original BCC list. Therefore, clicking 'Reply All' only addresses the sender and visible `To`/`CC` recipients, never the original BCC recipients.","hi":"नहीं। चूँकि प्राप्तकर्ताओं के पास आए ईमेल के हेडर में BCC पते छिपे होते हैं, इसलिए 'Reply All' केवल दृश्यमान हेडर (प्रेशक, To और CC) पर ही काम करता है और मूल BCC सूची उसमें स्वतः शामिल नहीं होती।"},"num":88}]},{"title":{"en":"7. E-Banking, NEFT & RTGS","hi":"7. ई-बैंकिंग, NEFT और RTGS"},"questions":[{"id":"q89","q":{"en":"What is 'E-Banking' (Electronic Banking)?","hi":"'ई-बैंकिंग' (E-banking / Electronic Banking) क्या है?"},"a":{"en":"Accessing a bank account and using banking services/transactions through electronic channels without visiting a physical branch for every task","hi":"इलेक्ट्रॉनिक चैनलों (electronic channels) के माध्यम से बैंक खाते को एक्सेस करना और बैंकिंग सेवाओं का उपयोग करना"},"o":[{"en":"Accessing a bank account and using banking services/transactions through electronic channels without visiting a physical branch for every task","hi":"इलेक्ट्रॉनिक चैनलों (electronic channels) के माध्यम से बैंक खाते को एक्सेस करना और बैंकिंग सेवाओं का उपयोग करना"},{"en":"Standing in a physical queue at a bank counter to fill out a paper withdrawal slip","hi":"कागजी निकासी पर्ची भरने के लिए बैंक काउंटर पर भौतिक कतार में खड़ा होना"},{"en":"Sending cash notes inside a paper envelope via postal courier","hi":"डाक कूरियर के माध्यम से कागज के लिफाफे में नकद नोट भेजना"},{"en":"Repairing computer motherboards inside a bank building","hi":"बैंक भवन के अंदर कंप्यूटर मदरबोर्ड की मरम्मत करना"}],"exp":{"en":"E-banking (Electronic Banking / Online Banking / Digital Banking) enables bank customers to access their accounts, check balances, pay bills, and transfer funds electronically via digital channels.","hi":"इलेक्ट्रॉनिक माध्यमों (electronic channels — जैसे इंटरनेट, मोबाइल, एटीएम आदि) की सहायता से बैंक खाते को एक्सेस करना और बैंकिंग सेवाओं व लेन-देन का उपयोग करना 'ई-बैंकिंग' कहलाता है।"},"num":89},{"id":"q90","q":{"en":"Which electronic banking channels are listed in the chapter?","hi":"अध्याय में ई-बैंकिंग (E-banking) के कौन-से प्रमुख चैनल सूचीबद्ध किए गए हैं?"},"a":{"en":"Internet banking, mobile banking, ATM, and debit/credit-card channels","hi":"इंटरनेट बैंकिंग, मोबाइल बैंकिंग, एटीएम (ATM) और डेबिट/क्रेडिट-कार्ड चैनल"},"o":[{"en":"Internet banking, mobile banking, ATM, and debit/credit-card channels","hi":"इंटरनेट बैंकिंग, मोबाइल बैंकिंग, एटीएम (ATM) और डेबिट/क्रेडिट-कार्ड चैनल"},{"en":"Punched cards, magnetic tapes, and vacuum tubes","hi":"पंच कार्ड, मैग्नेटिक टेप और वैक्यूम ट्यूब"},{"en":"Plotters, flatbed scanners, and dot matrix printers","hi":"प्लॉटर, फ्लैटबेड स्कैनर और डॉट मैट्रिक्स प्रिंटर"},{"en":"Assembler, compiler, and interpreter channels","hi":"असेंबलर, कंपाइलर और इंटरप्रेटर चैनल"}],"exp":{"en":"The chapter lists Internet banking (NetBanking), Mobile banking, Automated Teller Machines (ATMs), and Debit/Credit cards as the primary electronic banking channels.","hi":"अध्याय में ई-बैंकिंग के प्रमुख चैनलों के रूप में इंटरनेट बैंकिंग, मोबाइल बैंकिंग, एटीएम (ATM) और डेबिट/क्रेडिट कार्ड का उल्लेख किया गया है।"},"num":90},{"id":"q91","q":{"en":"What is the full form of 'ATM'?","hi":"'ATM' का पूर्ण रूप (Full Form) क्या है?"},"a":{"en":"Automated Teller Machine","hi":"ऑटोमेटेड टेलर मशीन (Automated Teller Machine)"},"o":[{"en":"Automated Teller Machine","hi":"ऑटोमेटेड टेलर मशीन (Automated Teller Machine)"},{"en":"Any Time Money","hi":"एनी टाइम मनी"},{"en":"Automatic Transfer Module","hi":"ऑटोमैटिक ट्रांसफर मॉड्यूल"},{"en":"Account Transaction Machine","hi":"अकाउंट ट्रांजेक्शन मशीन"}],"exp":{"en":"ATM stands for Automated Teller Machine (beware of informal backronyms like 'Any Time Money' in exams).","hi":"ATM का आधिकारिक पूर्ण रूप Automated Teller Machine है।"},"num":91},{"id":"q92","q":{"en":"What is the basic difference between a 'Debit Card' and a 'Credit Card'?","hi":"'डेबिट कार्ड' (Debit Card) और 'क्रेडिट कार्ड' (Credit Card) में बुनियादी अंतर क्या है?"},"a":{"en":"A debit card pays for purchases directly from the cardholder's linked bank account balance, whereas a credit card uses a pre-approved credit limit provided by the card issuer (to be repaid later)","hi":"डेबिट कार्ड खरीदारी का भुगतान सीधे लिंक्ड बैंक खाते के बैलेंस से करता है, जबकि क्रेडिट कार्ड जारीकर्ता (issuer) द्वारा दी गई क्रेडिट लिमिट का उपयोग करता है"},"o":[{"en":"A debit card pays for purchases directly from the cardholder's linked bank account balance, whereas a credit card uses a pre-approved credit limit provided by the card issuer (to be repaid later)","hi":"डेबिट कार्ड खरीदारी का भुगतान सीधे लिंक्ड बैंक खाते के बैलेंस से करता है, जबकि क्रेडिट कार्ड जारीकर्ता (issuer) द्वारा दी गई क्रेडिट लिमिट का उपयोग करता है"},{"en":"A debit card borrows money from the bank on interest, whereas a credit card deducts money instantly from a savings account","hi":"डेबिट कार्ड ब्याज पर उधार लेता है, जबकि क्रेडिट कार्ड बचत खाते से तुरंत पैसा काटता है"},{"en":"A debit card works only online, whereas a credit card works only at ATMs","hi":"डेबिट कार्ड केवल ऑनलाइन काम करता है, जबकि क्रेडिट कार्ड केवल एटीएम पर काम करता है"},{"en":"There is no difference; both deduct money from the shopkeeper's account","hi":"कोई अंतर नहीं है; दोनों दुकानदार के खाते से पैसे काटते हैं"}],"exp":{"en":"When you use a Debit Card, funds are deducted directly from your own linked savings/current bank account balance. When you use a Credit Card, you borrow against a revolving credit limit extended by the issuing bank/institution, which you repay on your billing cycle.","hi":"डेबिट कार्ड से भुगतान करने पर राशि सीधे आपके लिंक्ड बैंक खाते के मौजूदा बैलेंस से कटती है; जबकि क्रेडिट कार्ड में कार्ड जारीकर्ता (बैंक) द्वारा दी गई उधार सीमा (credit limit) का उपयोग होता है, जिसका भुगतान बाद में बिल बनने पर किया जाता है।"},"num":92},{"id":"q93","q":{"en":"What is the full form of 'NEFT', and which institution owns and operates it in India?","hi":"'NEFT' का पूर्ण रूप क्या है, और भारत में इसका स्वामित्व व संचालन कौन करता है?"},"a":{"en":"National Electronic Funds Transfer — owned and operated by the Reserve Bank of India (RBI)","hi":"नेशनल इलेक्ट्रॉनिक फंड्स ट्रांसफर (National Electronic Funds Transfer) — भारतीय रिज़र्व बैंक (RBI) इसे संचालित करता है"},"o":[{"en":"National Electronic Funds Transfer — owned and operated by the Reserve Bank of India (RBI)","hi":"नेशनल इलेक्ट्रॉनिक फंड्स ट्रांसफर (National Electronic Funds Transfer) — भारतीय रिज़र्व बैंक (RBI) इसे संचालित करता है"},{"en":"Network Electronic File Transfer — operated by VSNL","hi":"नेटवर्क इलेक्ट्रॉनिक फ़ाइल ट्रांसफर — VSNL द्वारा संचालित"},{"en":"National Easy Finance Transaction — operated by CERN","hi":"नेशनल इज़ी फाइनेंस ट्रांजेक्शन — CERN द्वारा संचालित"},{"en":"New Electronic Fast Transfer — operated by W3C","hi":"न्यू इलेक्ट्रॉनिक फास्ट ट्रांसफर — W3C द्वारा संचालित"}],"exp":{"en":"NEFT stands for National Electronic Funds Transfer. It is a nationwide retail payment system owned and operated by the Reserve Bank of India (RBI).","hi":"NEFT का पूर्ण रूप National Electronic Funds Transfer है। भारतीय रिज़र्व बैंक (Reserve Bank of India - RBI) इसका स्वामित्व और संचालन करता है।"},"num":93},{"id":"q94","q":{"en":"What is the basic purpose of the NEFT system?","hi":"NEFT प्रणाली का बुनियादी उद्देश्य क्या है?"},"a":{"en":"Facilitating electronic one-to-one funds transfer between accounts at participating banks for individuals, firms, and corporates","hi":"व्यक्तियों, फर्मों और कॉर्पोरेट्स के लिए सहभागी बैंक खातों के बीच इलेक्ट्रॉनिक वन-टू-वन (one-to-one) फंड ट्रांसफर करना"},"o":[{"en":"Facilitating electronic one-to-one funds transfer between accounts at participating banks for individuals, firms, and corporates","hi":"व्यक्तियों, फर्मों और कॉर्पोरेट्स के लिए सहभागी बैंक खातों के बीच इलेक्ट्रॉनिक वन-टू-वन (one-to-one) फंड ट्रांसफर करना"},{"en":"Trading international cryptocurrency tokens without bank accounts","hi":"बिना बैंक खातों के अंतर्राष्ट्रीय क्रिप्टोकरेंसी टोकन का व्यापार करना"},{"en":"Printing physical cheque books at home","hi":"घर पर भौतिक चेक बुक प्रिंट करना"},{"en":"Downloading operating system updates over FTP","hi":"FTP पर ऑपरेटिंग सिस्टम अपडेट डाउनलोड करना"}],"exp":{"en":"NEFT enables individuals, firms, and corporates to electronically transfer funds from any bank branch/account to any individual, firm, or corporate having an account with any other participating bank branch in the country.","hi":"NEFT का मूल उद्देश्य व्यक्तियों, फर्मों और कंपनियों (corporates) को देश के सहभागी बैंकों के खातों के बीच इलेक्ट्रॉनिक रूप से वन-टू-वन फंड ट्रांसफर की सुविधा देना है।"},"num":94},{"id":"q95","q":{"en":"According to the RBI, when is NEFT available, and how are NEFT transactions settled?","hi":"RBI के अनुसार NEFT सेवा कब उपलब्ध रहती है और इसमें सेटलमेंट (निपटान) कैसे होता है?"},"a":{"en":"Available 24×7×365 (round the clock, all days of the year), with transactions settled in half-hourly batches (every 30 minutes)","hi":"24×7×365 उपलब्ध है, और इसका सेटलमेंट आधे-आधे घंटे के बैचों (half-hourly batches) में होता है"},"o":[{"en":"Available 24×7×365 (round the clock, all days of the year), with transactions settled in half-hourly batches (every 30 minutes)","hi":"24×7×365 उपलब्ध है, और इसका सेटलमेंट आधे-आधे घंटे के बैचों (half-hourly batches) में होता है"},{"en":"Available only on Mondays between 10 AM and 12 PM, settled once a month","hi":"केवल सोमवार को सुबह 10 से 12 बजे के बीच उपलब्ध, महीने में एक बार सेटलमेंट"},{"en":"Available only on bank working days, settled in weekly paper batches","hi":"केवल बैंक कार्य दिवसों पर उपलब्ध, साप्ताहिक कागजी बैचों में सेटलमेंट"},{"en":"Available 24×7, but only for transactions above ₹10 crore","hi":"24×7 उपलब्ध, लेकिन केवल ₹10 करोड़ से अधिक के लेन-देन के लिए"}],"exp":{"en":"Since December 2019, RBI made NEFT available on a 24×7×365 basis (including weekends and bank holidays), operating on a Deferred Net Settlement (DNS) basis in 48 half-hourly batches every day.","hi":"RBI के अनुसार NEFT सेवा साल के सभी दिन चौबीसों घंटे (24×7×365) उपलब्ध है, और इसमें लेन-देन का निपटान आधे-आधे घंटे के बैचों (half-hourly batches — हर 30 मिनट) में होता है।"},"num":95},{"id":"q96","q":{"en":"In the context of NEFT timelines, how is the '2 hours' beneficiary credit rule counted according to the RBI FAQ?","hi":"NEFT में लाभार्थी के खाते में पैसे जमा होने की '2 घंटे' (2 hours) की समय-सीमा कब से गिनी जाती है?"},"a":{"en":"According to the RBI FAQ, the expected timeline for crediting the beneficiary's account is within two hours from the completion of the batch settlement (not a fixed two-hour wait before settlement)","hi":"RBI FAQ के अनुसार, बैच सेटलमेंट पूरा होने के बाद दो घंटे के भीतर लाभार्थी को क्रेडिट मिलने की समय-सीमा है"},"o":[{"en":"According to the RBI FAQ, the expected timeline for crediting the beneficiary's account is within two hours from the completion of the batch settlement (not a fixed two-hour wait before settlement)","hi":"RBI FAQ के अनुसार, बैच सेटलमेंट पूरा होने के बाद दो घंटे के भीतर लाभार्थी को क्रेडिट मिलने की समय-सीमा है"},{"en":"Every NEFT transfer is artificially held for exactly 2 days before processing","hi":"प्रत्येक NEFT ट्रांसफर को प्रोसेस करने से पहले ठीक 2 दिनों के लिए रोका जाता है"},{"en":"The user must keep their browser open for 2 hours to complete an NEFT transfer","hi":"NEFT पूरा करने के लिए यूज़र को 2 घंटे तक अपना ब्राउज़र खुला रखना पड़ता है"},{"en":"NEFT works only for 2 hours a day","hi":"NEFT दिन में केवल 2 घंटे काम करता है"}],"exp":{"en":"According to the RBI NEFT FAQ, the destination bank is expected to credit the beneficiary's account (or return the transaction if it cannot be credited) within two hours of the completion of the respective half-hourly batch settlement.","hi":"RBI के नियमों (FAQ) के अनुसार, संबंधित आधे घंटे के बैच का सेटलमेंट पूरा होने के बाद दो घंटे (within 2 hours of batch settlement) के भीतर लाभार्थी के खाते में राशि क्रेडिट हो जानी चाहिए।"},"num":96},{"id":"q97","q":{"en":"Is it possible for a person without a bank account to transfer funds via NEFT?","hi":"क्या बिना बैंक खाते (Without a bank account) के भी NEFT द्वारा पैसे भेजे जा सकते हैं?"},"a":{"en":"Yes — according to RBI, a walk-in customer without an account can deposit cash at an NEFT-enabled branch to transfer funds to a beneficiary account, subject to a cash remittance cap of ₹50,000 per transaction","hi":"हाँ — RBI के अनुसार, वॉक-इन ग्राहक NEFT-सक्षम शाखा में नकद जमा करके लाभार्थी के खाते में पैसे भेज सकता है, जिसकी अधिकतम सीमा ₹50,000 प्रति ट्रांजेक्शन है"},"o":[{"en":"Yes — according to RBI, a walk-in customer without an account can deposit cash at an NEFT-enabled branch to transfer funds to a beneficiary account, subject to a cash remittance cap of ₹50,000 per transaction","hi":"हाँ — RBI के अनुसार, वॉक-इन ग्राहक NEFT-सक्षम शाखा में नकद जमा करके लाभार्थी के खाते में पैसे भेज सकता है, जिसकी अधिकतम सीमा ₹50,000 प्रति ट्रांजेक्शन है"},{"en":"Yes — a walk-in customer can send up to ₹50 crore in cash via NEFT without any limit","hi":"हाँ — बिना किसी सीमा के नकद में ₹50 करोड़ तक भेजे जा सकते हैं"},{"en":"No — walk-in cash remittance is strictly prohibited even for ₹100","hi":"नहीं — ₹100 के लिए भी वॉक-इन नकद प्रेषण सख्त वर्जित है"},{"en":"Yes — by inserting cash notes into a home Wi-Fi router","hi":"हाँ — घर के वाई-फाई राउटर में नकद नोट डालकर"}],"exp":{"en":"Per RBI guidelines, walk-in customers who do not have a bank account can deposit cash at an NEFT-enabled bank branch to remit funds to a beneficiary's bank account via NEFT, up to a maximum limit of ₹50,000 per transaction.","hi":"हाँ, RBI के अनुसार यदि किसी व्यक्ति का बैंक खाता नहीं है, तब भी वह वॉक-इन (walk-in) ग्राहक के रूप में किसी NEFT-सक्षम बैंक शाखा में नकद (cash) जमा करके किसी लाभार्थी के खाते में NEFT से पैसे भेज सकता है; ऐसे नकद प्रेषण की सीमा अधिकतम ₹50,000 प्रति लेन-देन है।"},"num":97},{"id":"q98","q":{"en":"What is the RBI's maximum amount limit on regular account-based NEFT transfers?","hi":"सामान्य खाता-आधारित (Account-based) NEFT पर RBI की अधिकतम राशि सीमा (Maximum Amount Limit) क्या है?"},"a":{"en":"There is no system-level maximum cap imposed by the RBI (no minimum or maximum limit by RBI, though individual member banks may set their own channel/security limits)","hi":"RBI द्वारा कोई अधिकतम सीमा (system-level cap) निर्धारित नहीं है (हालाँकि सदस्य बैंक अपनी सुरक्षा सीमा तय कर सकते हैं)"},"o":[{"en":"There is no system-level maximum cap imposed by the RBI (no minimum or maximum limit by RBI, though individual member banks may set their own channel/security limits)","hi":"RBI द्वारा कोई अधिकतम सीमा (system-level cap) निर्धारित नहीं है (हालाँकि सदस्य बैंक अपनी सुरक्षा सीमा तय कर सकते हैं)"},{"en":"Maximum ₹10,000 per transaction","hi":"अधिकतम ₹10,000 प्रति लेन-देन"},{"en":"Maximum ₹50,000 for account holders","hi":"खाताधारकों के लिए अधिकतम ₹50,000"},{"en":"Maximum ₹2 lakh per year","hi":"प्रति वर्ष अधिकतम ₹2 लाख"}],"exp":{"en":"For regular account-to-account NEFT transactions, the RBI imposes no minimum or maximum amount ceiling at the system level (though individual banks may prescribe per-day/per-transaction limits for internet/mobile banking security).","hi":"खाता-आधारित सामान्य NEFT लेन-देन के लिए RBI की ओर से कोई भी न्यूनतम या अधिकतम राशि सीमा (upper ceiling) नहीं लगाई गई है (हालाँकि अलग-अलग बैंक अपने इंटरनेट बैंकिंग चैनल पर सुरक्षा की दृष्टि से दैनिक सीमा तय कर सकते हैं)।"},"num":98},{"id":"q99","q":{"en":"What is the full form and basic purpose of 'RTGS'?","hi":"'RTGS' का पूर्ण रूप (Full Form) और मुख्य उद्देश्य क्या है?"},"a":{"en":"Real Time Gross Settlement — It settles large-value interbank fund transfers individually (order by order) and continuously in real time","hi":"रियल टाइम ग्रॉस सेटलमेंट (Real Time Gross Settlement) — यह बड़े मूल्य (large-value) के भुगतानों को व्यक्तिगत रूप से और रियल टाइम में सेटल करता है"},"o":[{"en":"Real Time Gross Settlement — It settles large-value interbank fund transfers individually (order by order) and continuously in real time","hi":"रियल टाइम ग्रॉस सेटलमेंट (Real Time Gross Settlement) — यह बड़े मूल्य (large-value) के भुगतानों को व्यक्तिगत रूप से और रियल टाइम में सेटल करता है"},{"en":"Rapid Transfer of Small Savings — Used only for ₹10 mobile recharges","hi":"रैपिड ट्रांसफर ऑफ स्मॉल सेविंग्स — केवल ₹10 के मोबाइल रिचार्ज के लिए"},{"en":"Regional Telephone Gateway System — Used for dial-up internet","hi":"रीजनल टेलीफोन गेटवे सिस्टम — डायल-अप इंटरनेट के लिए"},{"en":"Recurring Tax Generation Software — Used for filing income tax","hi":"रिकरिंग टैक्स जनरेशन सॉफ्टवेयर — आयकर दाखिल करने के लिए"}],"exp":{"en":"RTGS stands for Real Time Gross Settlement. Operated by the RBI, it is designed for high-value/large-value fund transfers that require immediate, continuous, real-time clearing and individual settlement.","hi":"RTGS का पूर्ण रूप Real Time Gross Settlement है। इसका मुख्य उद्देश्य बड़ी राशि (large-value) के भुगतानों को बिना किसी देरी के व्यक्तिगत रूप से और वास्तविक समय (real time) में सेटल करना है।"},"num":99},{"id":"q100","q":{"en":"In 'RTGS', what is the exact meaning of the terms 'Real Time' and 'Gross Settlement'?","hi":"RTGS में 'रियल टाइम' (Real Time) और 'ग्रॉस' (Gross) शब्दों का सटीक अर्थ क्या है?"},"a":{"en":"Real Time → processing of instructions continuously as soon as they are received; Gross → each fund transfer instruction is settled individually on an instruction-by-instruction basis without netting/bundling","hi":"Real time → निर्देश प्राप्त होते ही तुरंत प्रोसेसिंग; Gross → बिना नेटिंग (netting) के प्रत्येक ट्रांसफर का अलग-अलग (individually) निपटान"},"o":[{"en":"Real Time → processing of instructions continuously as soon as they are received; Gross → each fund transfer instruction is settled individually on an instruction-by-instruction basis without netting/bundling","hi":"Real time → निर्देश प्राप्त होते ही तुरंत प्रोसेसिंग; Gross → बिना नेटिंग (netting) के प्रत्येक ट्रांसफर का अलग-अलग (individually) निपटान"},{"en":"Real Time → processing only during daytime hours; Gross → bundling 1,000 transactions into a single monthly batch","hi":"Real time → केवल दिन में प्रोसेसिंग; Gross → 1,000 लेन-देन को मासिक बैच में मिलाना"},{"en":"Real Time → deducting 10% tax; Gross → before tax deduction","hi":"Real time → 10% टैक्स काटना; Gross → टैक्स से पहले की राशि"},{"en":"Both terms mean offline paper cheque clearing","hi":"दोनों शब्दों का अर्थ ऑफ़लाइन पेपर चेक क्लियरिंग है"}],"exp":{"en":"Per RBI definition: 'Real Time' means the processing of payment instructions at the time they are received rather than at some later time; 'Gross Settlement' means the settlement of funds transfer instructions occurs individually (on an instruction-by-instruction basis) without bunching or netting with other transactions.","hi":"'Real Time' का अर्थ है कि भुगतान निर्देश जैसे ही प्राप्त होते हैं, बिना किसी प्रतीक्षा के उसी समय उनकी प्रोसेसिंग होती है; और 'Gross Settlement' का अर्थ है कि प्रत्येक फंड ट्रांसफर निर्देश को अन्य लेन-देन के साथ बंडल या नेटिंग (netting) किए बिना व्यक्तिगत रूप से (individually) सेटल किया जाता है।"},"num":100},{"id":"q101","q":{"en":"Why is an RTGS settlement described as 'final and irrevocable'?","hi":"RTGS सेटलमेंट को 'अंतिम और अपरिवर्तनीय' (Final and Irrevocable) क्यों कहा जाता है?"},"a":{"en":"Because the funds settlement takes place directly in the books of the Reserve Bank of India (RBI), making the payment final and irrevocable","hi":"क्योंकि इसका फंड सेटलमेंट सीधे भारतीय रिज़र्व बैंक (RBI) की पुस्तकों (books) में होता है, इसलिए यह भुगतान अंतिम और अपरिवर्तनीय होता है"},"o":[{"en":"Because the funds settlement takes place directly in the books of the Reserve Bank of India (RBI), making the payment final and irrevocable","hi":"क्योंकि इसका फंड सेटलमेंट सीधे भारतीय रिज़र्व बैंक (RBI) की पुस्तकों (books) में होता है, इसलिए यह भुगतान अंतिम और अपरिवर्तनीय होता है"},{"en":"Because RTGS uses permanent magnetic ink on paper cheques","hi":"क्योंकि RTGS कागजी चेक पर स्थायी चुंबकीय स्याही का उपयोग करता है"},{"en":"Because the user's computer locks up after sending an RTGS transfer","hi":"क्योंकि RTGS भेजने के बाद यूज़र का कंप्यूटर लॉक हो जाता है"},{"en":"Because RTGS transactions can be cancelled anytime within 30 days","hi":"क्योंकि RTGS लेन-देन को 30 दिनों के भीतर कभी भी रद्द किया जा सकता है"}],"exp":{"en":"Considering that the funds settlement in RTGS takes place directly in the books of the Reserve Bank of India (RBI) on an instruction-by-instruction basis, the payments are final and irrevocable once settled.","hi":"चूँकि RTGS में फंड का निपटान (settlement) सीधे भारतीय रिज़र्व बैंक (RBI) की खाता पुस्तकों (books) में होता है, इसलिए एक बार सेटल होने के बाद यह भुगतान अंतिम (final) और अपरिवर्तनीय (irrevocable) होता है।"},"num":101},{"id":"q102","q":{"en":"What are the RBI's minimum and maximum amount limits for RTGS transactions?","hi":"RTGS लेन-देन के लिए RBI की न्यूनतम (Minimum) और अधिकतम (Maximum) राशि सीमाएँ क्या हैं?"},"a":{"en":"Minimum amount is ₹2 lakh (₹2,00,000), and there is no upper ceiling / maximum limit in the RBI RTGS system","hi":"न्यूनतम सीमा ₹2 लाख है, और RBI RTGS सिस्टम में कोई अधिकतम सीमा (upper ceiling) नहीं है"},"o":[{"en":"Minimum amount is ₹2 lakh (₹2,00,000), and there is no upper ceiling / maximum limit in the RBI RTGS system","hi":"न्यूनतम सीमा ₹2 लाख है, और RBI RTGS सिस्टम में कोई अधिकतम सीमा (upper ceiling) नहीं है"},{"en":"Minimum ₹1 and maximum ₹2 lakh","hi":"न्यूनतम ₹1 और अधिकतम ₹2 लाख"},{"en":"Minimum ₹50,000 and maximum ₹5 lakh","hi":"न्यूनतम ₹50,000 और अधिकतम ₹5 लाख"},{"en":"Minimum ₹10 लाख and maximum ₹1 crore","hi":"न्यूनतम ₹10 लाख और अधिकतम ₹1 करोड़"}],"exp":{"en":"RTGS is meant primarily for large-value transactions. The minimum amount to be remitted through RTGS is ₹2,00,000 (₹2 lakh), with no upper or maximum ceiling set by the RBI.","hi":"RBI के अनुसार RTGS के माध्यम से भेजे जाने वाले धन की न्यूनतम सीमा ₹2 लाख (₹2,00,000) है, जबकि इसके लिए कोई अधिकतम सीमा (upper ceiling) निर्धारित नहीं है।"},"num":102},{"id":"q103","q":{"en":"What is the key settlement difference between 'NEFT' and 'RTGS', and what is their availability?","hi":"'NEFT' और 'RTGS' के सेटलमेंट तरीके में मुख्य अंतर क्या है और उनकी उपलब्धता क्या है?"},"a":{"en":"NEFT settles transactions in half-hourly batches (deferred net settlement), whereas RTGS settles each transaction individually in real time (gross settlement); both RBI systems are available 24×7×365","hi":"NEFT आधे घंटे के बैचों में सेटलमेंट करता है, जबकि RTGS प्रत्येक लेन-देन को व्यक्तिगत रूप से रियल टाइम में सेटल करता है; दोनों RBI सिस्टम 24×7 उपलब्ध हैं"},"o":[{"en":"NEFT settles transactions in half-hourly batches (deferred net settlement), whereas RTGS settles each transaction individually in real time (gross settlement); both RBI systems are available 24×7×365","hi":"NEFT आधे घंटे के बैचों में सेटलमेंट करता है, जबकि RTGS प्रत्येक लेन-देन को व्यक्तिगत रूप से रियल टाइम में सेटल करता है; दोनों RBI सिस्टम 24×7 उपलब्ध हैं"},{"en":"NEFT settles individually in real time, whereas RTGS settles in monthly batches","hi":"NEFT रियल टाइम में सेटल होता है, जबकि RTGS मासिक बैचों में"},{"en":"NEFT is only for amounts above ₹2 lakh, whereas RTGS is only for amounts below ₹50,000","hi":"NEFT केवल ₹2 लाख से ऊपर के लिए है, जबकि RTGS ₹50,000 से कम के लिए"},{"en":"Both systems operate only from 9 AM to 5 PM on weekdays","hi":"दोनों सिस्टम केवल कार्य दिवसों में सुबह 9 से शाम 5 बजे तक काम करते हैं"}],"exp":{"en":"Diagram comparison (PDF p. 147): NEFT uses batch settlement (every 30 minutes / half-hourly batches) with no minimum limit, whereas RTGS uses real-time gross settlement (each transfer settled individually as it arrives) for transactions of ₹2 lakh and above. Both systems now operate 24×7×365.","hi":"मुख्य अंतर: NEFT में आधे-आधे घंटे के बैचों (half-hourly batches) में सेटलमेंट होता है, जबकि RTGS में प्रत्येक ट्रांजेक्शन का व्यक्तिगत रूप से तुरंत (real-time gross settlement) निपटान होता है। वर्तमान में RBI की ये दोनों प्रणालियाँ 24×7 उपलब्ध हैं।"},"num":103}]},{"title":{"en":"8. ECS & IMPS","hi":"8. ECS और IMPS"},"questions":[{"id":"q104","q":{"en":"What is the official full form of 'ECS' in banking?","hi":"बैंकिंग में 'ECS' का आधिकारिक पूर्ण रूप (Official Full Form) क्या है?"},"a":{"en":"Electronic Clearing Service","hi":"इलेक्ट्रॉनिक क्लियरिंग सर्विस (Electronic Clearing Service)"},"o":[{"en":"Electronic Clearing Service","hi":"इलेक्ट्रॉनिक क्लियरिंग सर्विस (Electronic Clearing Service)"},{"en":"Easy Cash System","hi":"इज़ी कैश सिस्टम"},{"en":"Electronic Cheque Scanner","hi":"इलेक्ट्रॉनिक चेक स्कैनर"},{"en":"Emergency Credit Scheme","hi":"इमरजेंसी क्रेडिट स्कीम"}],"exp":{"en":"ECS officially stands for Electronic Clearing Service.","hi":"ECS का आधिकारिक पूर्ण रूप Electronic Clearing Service है।"},"num":104},{"id":"q105","q":{"en":"What is the main purpose of 'ECS' (Electronic Clearing Service)?","hi":"'ECS' का मुख्य उद्देश्य क्या है?"},"a":{"en":"Processing repetitive, periodic bulk payments (credits) or collections (debits) electronically, thereby reducing the use of paper instruments like cheques/warrants","hi":"बार-बार होने वाले आवधिक (repetitive, periodic) बल्क भुगतानों या वसूली (collections) को इलेक्ट्रॉनिक रूप से प्रोसेस करना और कागजी चेक आदि को कम करना"},"o":[{"en":"Processing repetitive, periodic bulk payments (credits) or collections (debits) electronically, thereby reducing the use of paper instruments like cheques/warrants","hi":"बार-बार होने वाले आवधिक (repetitive, periodic) बल्क भुगतानों या वसूली (collections) को इलेक्ट्रॉनिक रूप से प्रोसेस करना और कागजी चेक आदि को कम करना"},{"en":"Withdrawing physical currency notes from an ATM without a card","hi":"बिना कार्ड के एटीएम से भौतिक नोट निकालना"},{"en":"Sending a one-time instant transfer of ₹500 to a friend at midnight","hi":"आधी रात को किसी मित्र को ₹500 का एकमुश्त तत्काल ट्रांसफर भेजना"},{"en":"Encrypting HTTP web pages using TLS certificates","hi":"TLS प्रमाणपत्रों का उपयोग करके HTTP वेब पेजों को एन्क्रिप्ट करना"}],"exp":{"en":"ECS is an electronic mode of funds transfer used by institutions for repetitive and periodic bulk transactions (either one-to-many credits or many-to-one debits), eliminating the need to issue and clear millions of physical paper cheques or dividend warrants.","hi":"ECS का मुख्य उद्देश्य बार-बार और निश्चित अंतराल पर होने वाले (repetitive, periodic) बल्क भुगतानों या कलेक्शन्स को इलेक्ट्रॉनिक रूप से प्रोसेस करना और कागजी उपकरणों (जैसे चेक या वारंट) के उपयोग को कम करना है।"},"num":105},{"id":"q106","q":{"en":"Which of the following transactions are standard examples of 'ECS Credit'?","hi":"'ECS Credit' के अंतर्गत कौन-से उदाहरण आते हैं?"},"a":{"en":"Bulk disbursements by an institution to many beneficiaries, such as salary, pension, interest, dividend, commission, or refund payments","hi":"किसी संस्था द्वारा कई लाभार्थियों को किए जाने वाले बल्क भुगतान, जैसे वेतन (salary), पेंशन, ब्याज, लाभांश (dividend), कमीशन या रिफंड"},"o":[{"en":"Bulk disbursements by an institution to many beneficiaries, such as salary, pension, interest, dividend, commission, or refund payments","hi":"किसी संस्था द्वारा कई लाभार्थियों को किए जाने वाले बल्क भुगतान, जैसे वेतन (salary), पेंशन, ब्याज, लाभांश (dividend), कमीशन या रिफंड"},{"en":"Monthly electricity bill and telephone bill deductions from a customer's account","hi":"ग्राहक के खाते से मासिक बिजली बिल और टेलीफोन बिल की कटौती"},{"en":"Home loan EMI deductions from a borrower's account","hi":"उधारकर्ता के खाते से होम लोन ईएमआई की कटौती"},{"en":"Buying groceries with a credit card at a supermarket","hi":"सुपरमार्केट में क्रेडिट कार्ड से किराने का सामान खरीदना"}],"exp":{"en":"ECS Credit (one-to-many) is used by an organization/company to credit funds in bulk to a large number of beneficiary bank accounts—such as monthly employee salaries, pensions, dividend payouts, interest, commissions, or tax/IPO refunds.","hi":"ECS Credit का उपयोग किसी संस्था द्वारा एक साथ अनेक खातों में राशि जमा (bulk credit) करने के लिए किया जाता है—जैसे कर्मचारियों का वेतन (salary), पेंशन, ब्याज (interest), लाभांश (dividend), कमीशन या रिफंड का भुगतान।"},"num":106},{"id":"q107","q":{"en":"Which of the following transactions are standard examples of 'ECS Debit'?","hi":"'ECS Debit' के अंतर्गत कौन-से उदाहरण आते हैं?"},"a":{"en":"Recurring periodic collections from customers' accounts (with a valid mandate), such as utility bills (electricity/water/phone), loan instalments (EMIs), mutual fund SIPs, or insurance premiums","hi":"ग्राहकों के खातों से (मैंडेट के साथ) आवर्ती वसूली, जैसे यूटिलिटी बिल (बिजली/पानी), लोन की किस्तें (EMI) या बीमा प्रीमियम"},"o":[{"en":"Recurring periodic collections from customers' accounts (with a valid mandate), such as utility bills (electricity/water/phone), loan instalments (EMIs), mutual fund SIPs, or insurance premiums","hi":"ग्राहकों के खातों से (मैंडेट के साथ) आवर्ती वसूली, जैसे यूटिलिटी बिल (बिजली/पानी), लोन की किस्तें (EMI) या बीमा प्रीमियम"},{"en":"A company paying annual dividends to 50,000 shareholders","hi":"एक कंपनी द्वारा 50,000 शेयरधारकों को वार्षिक लाभांश का भुगतान करना"},{"en":"The government crediting monthly pensions to retired employees","hi":"सरकार द्वारा सेवानिवृत्त कर्मचारियों को मासिक पेंशन जमा करना"},{"en":"Depositing cash at a bank counter via walk-in NEFT","hi":"वॉक-इन NEFT के माध्यम से बैंक काउंटर पर नकद जमा करना"}],"exp":{"en":"ECS Debit (many-to-one) is used by utility companies and financial institutions to automatically collect recurring payments from customers' bank accounts (based on a standing mandate)—such as telephone/electricity/water bills, loan EMIs, insurance premiums, and mutual fund SIPs.","hi":"ECS Debit का उपयोग ग्राहक के पूर्व-प्राधिकार (mandate) के आधार पर उसके खाते से बार-बार होने वाले भुगतानों की वसूली (recurring collections) के लिए होता है—जैसे बिजली/पानी/टेलीफोन के यूटिलिटी बिल, लोन की किस्तें (loan instalments/EMI) या बीमा प्रीमियम।"},"num":107},{"id":"q108","q":{"en":"At what frequencies can periodic ECS transactions be scheduled?","hi":"ECS लेन-देन किस आवृत्ति (Frequency) पर किए जा सकते हैं?"},"a":{"en":"Monthly, quarterly, half-yearly, or yearly, depending on the requirement","hi":"आवश्यकता के हिसाब से मासिक (monthly), त्रैमासिक (quarterly), अर्धवार्षिक (half-yearly) या वार्षिक (yearly)"},"o":[{"en":"Monthly, quarterly, half-yearly, or yearly, depending on the requirement","hi":"आवश्यकता के हिसाब से मासिक (monthly), त्रैमासिक (quarterly), अर्धवार्षिक (half-yearly) या वार्षिक (yearly)"},{"en":"Only once in a lifetime","hi":"जीवन में केवल एक बार"},{"en":"Only every 10 nanoseconds like a hard real-time OS","hi":"हार्ड रियल-टाइम OS की तरह केवल हर 10 नैनोसेकंड में"},{"en":"Only on 29 February in leap years","hi":"केवल लीप वर्ष में 29 फरवरी को"}],"exp":{"en":"Depending on the nature of the payout or bill collection, ECS/NACH mandates and bulk runs can be scheduled monthly, quarterly, half-yearly, or yearly (or at other periodic intervals).","hi":"आवश्यकता के अनुसार ECS लेन-देन मासिक (monthly), त्रैमासिक (quarterly), अर्धवार्षिक (half-yearly) या वार्षिक (yearly) अंतराल पर किए जा सकते हैं।"},"num":108},{"id":"q109","q":{"en":"What is the full form of 'NACH', and how is it related to ECS?","hi":"'NACH' का पूर्ण रूप क्या है और इसका ECS से क्या संबंध है?"},"a":{"en":"National Automated Clearing House — NPCI's centralized national platform for bulk and recurring electronic clearing, which consolidated legacy regional ECS systems (and is covered alongside ECS in RBI FAQs)","hi":"नेशनल ऑटोमेटेड क्लियरिंग हाउस — NPCI का बल्क/आवर्ती प्रोसेसिंग प्लेटफॉर्म, जिसने पुराने क्षेत्रीय ECS सिस्टम को एकीकृत किया"},"o":[{"en":"National Automated Clearing House — NPCI's centralized national platform for bulk and recurring electronic clearing, which consolidated legacy regional ECS systems (and is covered alongside ECS in RBI FAQs)","hi":"नेशनल ऑटोमेटेड क्लियरिंग हाउस — NPCI का बल्क/आवर्ती प्रोसेसिंग प्लेटफॉर्म, जिसने पुराने क्षेत्रीय ECS सिस्टम को एकीकृत किया"},{"en":"Network Access Control Hub — A hardware firewall used in LANs","hi":"नेटवर्क एक्सेस कंट्रोल हब — LAN में प्रयुक्त एक हार्डवेयर फ़ायरवॉल"},{"en":"National ATM Cash Holder — A vault inside an ATM machine","hi":"नेशनल एटीएम कैश होल्डर — एटीएम मशीन के अंदर की तिजोरी"},{"en":"New Account Creation Helpdesk — A customer care phone number","hi":"न्यू अकाउंट क्रिएशन हेल्पडेस्क — एक कस्टमर केयर नंबर"}],"exp":{"en":"NACH stands for National Automated Clearing House. Implemented by the National Payments Corporation of India (NPCI), NACH consolidated multiple local/regional ECS systems into a single nationwide web-based platform for high-volume bulk credits and recurring mandate debits.","hi":"NACH का पूर्ण रूप National Automated Clearing House है। यह NPCI का राष्ट्रीय बल्क और आवर्ती (recurring) क्लियरिंग प्लेटफॉर्म है, जिसने पुराने क्षेत्रीय ECS केंद्रों को एक राष्ट्रीय प्रणाली में समाहित कर लिया है।"},"num":109},{"id":"q110","q":{"en":"What is the full form of 'IMPS', and which organization operates it?","hi":"'IMPS' का पूर्ण रूप (Full Form) क्या है और इसे कौन-सी संस्था संचालित करती है?"},"a":{"en":"Immediate Payment Service — offered and operated by the National Payments Corporation of India (NPCI)","hi":"इमीडिएट पेमेंट सर्विस (Immediate Payment Service) — NPCI (भारतीय राष्ट्रीय भुगतान निगम) द्वारा संचालित"},"o":[{"en":"Immediate Payment Service — offered and operated by the National Payments Corporation of India (NPCI)","hi":"इमीडिएट पेमेंट सर्विस (Immediate Payment Service) — NPCI (भारतीय राष्ट्रीय भुगतान निगम) द्वारा संचालित"},{"en":"Internet Mail Protocol System — operated by IANA","hi":"इंटरनेट मेल प्रोटोकॉल सिस्टम — IANA द्वारा संचालित"},{"en":"International Money Postal Service — operated by India Post","hi":"इंटरनेशनल मनी पोस्टल सर्विस — इंडिया पोस्ट द्वारा संचालित"},{"en":"Integrated Mobile Phone Software — operated by Google","hi":"इंटीग्रेटेड मोबाइल फ़ोन सॉफ्टवेयर — गूगल द्वारा संचालित"}],"exp":{"en":"IMPS stands for Immediate Payment Service. It is an emphatic, real-time interbank electronic funds transfer system operated by the National Payments Corporation of India (NPCI).","hi":"IMPS का पूर्ण रूप Immediate Payment Service है, और इसका संचालन NPCI (National Payments Corporation of India) द्वारा किया जाता है।"},"num":110},{"id":"q111","q":{"en":"What is the key feature of 'IMPS'?","hi":"'IMPS' की सबसे मुख्य विशेषता (Key Feature) क्या है?"},"a":{"en":"Instant, real-time interbank electronic fund transfer available 24×7 (including Sundays and bank holidays) across mobile, internet banking, and ATM channels","hi":"छुट्टियों सहित 24×7 तत्काल (instant) इंटरबैंक इलेक्ट्रॉनिक फंड ट्रांसफर, जो मोबाइल, इंटरनेट बैंकिंग और एटीएम चैनलों पर उपलब्ध है"},"o":[{"en":"Instant, real-time interbank electronic fund transfer available 24×7 (including Sundays and bank holidays) across mobile, internet banking, and ATM channels","hi":"छुट्टियों सहित 24×7 तत्काल (instant) इंटरबैंक इलेक्ट्रॉनिक फंड ट्रांसफर, जो मोबाइल, इंटरनेट बैंकिंग और एटीएम चैनलों पर उपलब्ध है"},{"en":"Settling transactions only in half-hourly batches on working days","hi":"केवल कार्य दिवसों में आधे-आधे घंटे के बैचों में लेन-देन सेटल करना"},{"en":"Requiring a minimum transfer amount of ₹2 lakh per transaction","hi":"प्रति लेन-देन न्यूनतम ₹2 लाख की राशि होना"},{"en":"Processing only quarterly company dividend warrants","hi":"केवल त्रैमासिक कंपनी लाभांश वारंट को प्रोसेस करना"}],"exp":{"en":"IMPS provides robust, instant (immediate), 24×7×365 real-time interbank fund transfers for retail customers—accessible via mobile phones, internet banking, ATMs, and SMS.","hi":"IMPS की मुख्य विशेषता यह है कि यह रविवार और बैंक छुट्टियों सहित 24×7 तत्काल (instant / real-time) इंटरबैंक इलेक्ट्रॉनिक फंड ट्रांसफर की सुविधा देता है, जिसे मोबाइल, इंटरनेट बैंकिंग या एटीएम चैनलों से उपयोग किया जा सकता है।"},"num":111},{"id":"q112","q":{"en":"What is NPCI's listed per-transaction limit for IMPS on eligible channels (excluding SMS/IVR)?","hi":"NPCI के अनुसार पात्र चैनलों (SMS/IVR को छोड़कर) पर IMPS की प्रति-ट्रांजेक्शन अधिकतम सीमा कितनी है?"},"a":{"en":"Up to ₹5 lakh per transaction for eligible channels (though individual banks or specific channels may set lower limits)","hi":"पात्र चैनलों के लिए ₹5 लाख तक (हालाँकि बैंक या विशेष चैनल अपनी कम सीमा रख सकते हैं)"},"o":[{"en":"Up to ₹5 lakh per transaction for eligible channels (though individual banks or specific channels may set lower limits)","hi":"पात्र चैनलों के लिए ₹5 लाख तक (हालाँकि बैंक या विशेष चैनल अपनी कम सीमा रख सकते हैं)"},{"en":"Maximum ₹2,000 per transaction","hi":"अधिकतम ₹2,000 प्रति लेन-देन"},{"en":"Minimum ₹2 lakh and no upper limit","hi":"न्यूनतम ₹2 लाख और कोई अधिकतम सीमा नहीं"},{"en":"Maximum ₹10,000 per month","hi":"अधिकतम ₹10,000 प्रति माह"}],"exp":{"en":"Per NPCI guidelines, the per-transaction limit for IMPS is up to ₹5 lakh for channels other than SMS and IVR (individual member banks may define their own channel-specific or customer-specific sub-limits).","hi":"NPCI के अनुसार SMS और IVR को छोड़कर अन्य पात्र डिजिटल चैनलों पर IMPS की प्रति-लेन-देन अधिकतम सीमा ₹5 लाख है (हालाँकि व्यक्तिगत बैंक अपनी सुरक्षा नीति के अनुसार कम सीमा भी निर्धारित कर सकते हैं)।"},"num":112},{"id":"q113","q":{"en":"How do you easily distinguish between 'IMPS' and 'ECS' in exams?","hi":"परीक्षा में 'IMPS' और 'ECS' के बीच आसानी से कैसे अंतर करें?"},"a":{"en":"IMPS is for instant individual 24×7 interbank fund transfers, whereas ECS is for recurring/periodic bulk credits (like salary/dividends) or debits (like utility bills/EMIs)","hi":"IMPS तत्काल व्यक्तिगत (instant individual) ट्रांसफर है, जबकि ECS आवर्ती बल्क क्रेडिट या डेबिट (recurring bulk credit/debit) के लिए है"},"o":[{"en":"IMPS is for instant individual 24×7 interbank fund transfers, whereas ECS is for recurring/periodic bulk credits (like salary/dividends) or debits (like utility bills/EMIs)","hi":"IMPS तत्काल व्यक्तिगत (instant individual) ट्रांसफर है, जबकि ECS आवर्ती बल्क क्रेडिट या डेबिट (recurring bulk credit/debit) के लिए है"},{"en":"IMPS is for monthly bulk salary clearing, whereas ECS is for instant peer-to-peer mobile transfers","hi":"IMPS मासिक वेतन क्लियरिंग के लिए है, जबकि ECS तत्काल मोबाइल ट्रांसफर के लिए"},{"en":"Both are email protocols used to download attachments","hi":"दोनों अटैचमेंट डाउनलोड करने के लिए प्रयुक्त ईमेल प्रोटोकॉल हैं"},{"en":"IMPS requires paper cheques, whereas ECS works only at ATMs","hi":"IMPS के लिए कागजी चेक चाहिए, जबकि ECS केवल एटीएम पर काम करता है"}],"exp":{"en":"Exam cue: IMPS (Immediate Payment Service) is for instant, one-to-one customer fund transfers 24×7. ECS (Electronic Clearing Service / NACH) is for scheduled, repetitive, periodic bulk credits (salaries, pensions, dividends) and recurring mandate debits (EMIs, utility bills).","hi":"परीक्षा संकेत: IMPS का उपयोग तत्काल एक-से-एक व्यक्तिगत फंड ट्रांसफर (instant individual transfer) के लिए होता है, जबकि ECS का उपयोग आवधिक और बार-बार होने वाले बल्क क्रेडिट (वेतन, पेंशन) या डेबिट (बिजली बिल, लोन EMI) के लिए होता है।"},"num":113}]},{"title":{"en":"9. Exam Trap Reverse-Questions","hi":"9. परीक्षा के महत्वपूर्ण उल्टे प्रश्न"},"questions":[{"id":"q114","q":{"en":"Place these four Internet & Web milestones in correct chronological order: ARPANET connection, TCP/IP transition, Web proposal at CERN, and W3C foundation:","hi":"1969 ARPANET, 1983 TCP/IP, 1989 Web प्रस्ताव और 1994 W3C स्थापना को सही कालानुक्रमिक क्रम (Timeline) में रखें:"},"a":{"en":"1969 ARPANET node connection → 1983 TCP/IP transition → 1989 Web proposal at CERN → 1994 W3C foundation","hi":"1969 ARPANET कनेक्शन → 1983 TCP/IP ट्रांज़िशन → 1989 Web प्रस्ताव → 1994 W3C स्थापना"},"o":[{"en":"1969 ARPANET node connection → 1983 TCP/IP transition → 1989 Web proposal at CERN → 1994 W3C foundation","hi":"1969 ARPANET कनेक्शन → 1983 TCP/IP ट्रांज़िशन → 1989 Web प्रस्ताव → 1994 W3C स्थापना"},{"en":"1989 Web proposal → 1969 ARPANET → 1994 W3C → 1983 TCP/IP","hi":"1989 Web प्रस्ताव → 1969 ARPANET → 1994 W3C → 1983 TCP/IP"},{"en":"1994 W3C → 1989 Web → 1983 TCP/IP → 1969 ARPANET","hi":"1994 W3C → 1989 Web → 1983 TCP/IP → 1969 ARPANET"},{"en":"1983 TCP/IP → 1969 ARPANET → 1994 W3C → 1989 Web","hi":"1983 TCP/IP → 1969 ARPANET → 1994 W3C → 1989 Web"}],"exp":{"en":"Exam Trap Timeline: 1969 (First ARPANET nodes connected) → 1 January 1983 (ARPANET adopts TCP/IP) → 1989 (Tim Berners-Lee proposes the World Wide Web at CERN) → 1994 (Tim Berners-Lee founds the W3C).","hi":"एग्जाम ट्रैप टाइमलाइन: 1969 (ARPANET कनेक्शन) → 1983 (TCP/IP ट्रांज़िशन) → 1989 (CERN में वर्ल्ड वाइड वेब का प्रस्ताव) → 1994 (W3C की स्थापना)।"},"num":114},{"id":"q115","q":{"en":"Match the 'World's first Web browser' versus the 'Early widely popular graphical Web browser':","hi":"'दुनिया के पहले वेब ब्राउज़र' और 'प्रारंभिक व्यापक लोकप्रिय ग्राफिकल ब्राउज़र' का सही मिलान क्या है?"},"a":{"en":"First Web browser → WorldWideWeb (later renamed Nexus, 1990); Early widely popular graphical browser → NCSA Mosaic (1993)","hi":"पहला वेब ब्राउज़र → WorldWideWeb/Nexus; प्रारंभिक लोकप्रिय ग्राफिकल ब्राउज़र → Mosaic"},"o":[{"en":"First Web browser → WorldWideWeb (later renamed Nexus, 1990); Early widely popular graphical browser → NCSA Mosaic (1993)","hi":"पहला वेब ब्राउज़र → WorldWideWeb/Nexus; प्रारंभिक लोकप्रिय ग्राफिकल ब्राउज़र → Mosaic"},{"en":"First Web browser → Google Chrome; Early graphical browser → Archie","hi":"पहला वेब ब्राउज़र → Google Chrome; प्रारंभिक ग्राफिकल ब्राउज़र → Archie"},{"en":"First Web browser → Mosaic; Early graphical browser → Microsoft Edge","hi":"पहला वेब ब्राउज़र → Mosaic; प्रारंभिक ग्राफिकल ब्राउज़र → Microsoft Edge"},{"en":"Both refer to Yahoo Search","hi":"दोनों Yahoo Search को संदर्भित करते हैं"}],"exp":{"en":"Exam Trap: Tim Berners-Lee's `WorldWideWeb` (renamed `Nexus`, 1990) was the very first web browser, whereas NCSA `Mosaic` (1993) was the early graphical browser that popularized the Web among the general public.","hi":"एग्जाम ट्रैप: दुनिया का सबसे पहला वेब ब्राउज़र टिम बर्नर्स-ली द्वारा बनाया गया `WorldWideWeb` (बाद में `Nexus`, 1990) था, जबकि वेब को आम जनता में लोकप्रिय बनाने वाला शुरुआती ग्राफिकल ब्राउज़र `Mosaic` (1993) था।"},"num":115},{"id":"q116","q":{"en":"Match the pioneers 'Ray Tomlinson', 'Tim Berners-Lee', and 'Alan Emtage' with their respective creations:","hi":"'Ray Tomlinson', 'Tim Berners-Lee' और 'Alan Emtage' को उनके आविष्कारों से सुमेलित कीजिए:"},"a":{"en":"Ray Tomlinson → Network email (@ symbol); Tim Berners-Lee → World Wide Web & first browser; Alan Emtage → Archie (first Internet search engine)","hi":"Ray Tomlinson → नेटवर्क ईमेल; Tim Berners-Lee → World Wide Web/पहला ब्राउज़र; Alan Emtage → Archie"},"o":[{"en":"Ray Tomlinson → Network email (@ symbol); Tim Berners-Lee → World Wide Web & first browser; Alan Emtage → Archie (first Internet search engine)","hi":"Ray Tomlinson → नेटवर्क ईमेल; Tim Berners-Lee → World Wide Web/पहला ब्राउज़र; Alan Emtage → Archie"},{"en":"Ray Tomlinson → Archie; Tim Berners-Lee → Network email; Alan Emtage → World Wide Web","hi":"Ray Tomlinson → Archie; Tim Berners-Lee → नेटवर्क ईमेल; Alan Emtage → World Wide Web"},{"en":"Ray Tomlinson → NEFT; Tim Berners-Lee → RTGS; Alan Emtage → IMPS","hi":"Ray Tomlinson → NEFT; Tim Berners-Lee → RTGS; Alan Emtage → IMPS"},{"en":"All three co-invented the vacuum tube in 1904","hi":"तीनों ने 1904 में वैक्यूम ट्यूब का आविष्कार किया"}],"exp":{"en":"Exam Trap Pioneer Match: Ray Tomlinson developed network email on ARPANET (1971); Tim Berners-Lee invented the World Wide Web (1989) and the first browser (1990); Alan Emtage created Archie, the first Internet search engine (1990).","hi":"एग्जाम ट्रैप मिलान: Ray Tomlinson → नेटवर्क ईमेल (`@` चिह्न, 1971); Tim Berners-Lee → वर्ल्ड वाइड वेब और पहला वेब ब्राउज़र (1989–90); Alan Emtage → Archie (पहला इंटरनेट सर्च इंजन, 1990)।"},"num":116},{"id":"q117","q":{"en":"In a web address containing 'support.example.com', are the Hostname and the Top-Level Domain (TLD) different?","hi":"क्या किसी वेब पते में 'होस्टनेम' (Hostname) और 'टॉप-लेवल डोमेन' (TLD) अलग-अलग चीज़ें हैं (जैसे `support.example.com` में)?"},"a":{"en":"Yes — 'support.example.com' is the full hostname, whereas '.com' (the rightmost label) is the Top-Level Domain (TLD)","hi":"हाँ — `support.example.com` होस्टनेम है और `.com` उसका टॉप-लेवल डोमेन (TLD) है"},"o":[{"en":"Yes — 'support.example.com' is the full hostname, whereas '.com' (the rightmost label) is the Top-Level Domain (TLD)","hi":"हाँ — `support.example.com` होस्टनेम है और `.com` उसका टॉप-लेवल डोमेन (TLD) है"},{"en":"No — '.com' is the subdomain and 'support' is the TLD","hi":"नहीं — `.com` सबडोमेन है और `support` TLD है"},{"en":"No — both mean the HTTP protocol scheme","hi":"नहीं — दोनों का अर्थ HTTP प्रोटोकॉल स्कीम है"},{"en":"Yes — 'support' is the IP address and '.com' is the MAC address","hi":"हाँ — `support` आईपी एड्रेस है और `.com` मैक एड्रेस है"}],"exp":{"en":"Exam Trap: In `support.example.com`, the entire string `support.example.com` is the hostname (where `support` is the subdomain and `example.com` is the registered domain), while only the rightmost label `.com` is the Top-Level Domain (TLD).","hi":"एग्जाम ट्रैप: हाँ, दोनों अलग हैं। `support.example.com` पूरा होस्टनेम (hostname) है (जिसमें `support` सबडोमेन है), जबकि सबसे दाएँ अंत में लगा `.com` टॉप-लेवल डोमेन (TLD) है।"},"num":117},{"id":"q118","q":{"en":"What is the core exam distinction between the 'Internet' and the 'Web' (WWW)?","hi":"परीक्षा की दृष्टि से 'इंटरनेट' (Internet) और 'वेब' (Web / WWW) में मुख्य अंतर क्या है?"},"a":{"en":"The Internet is the global network infrastructure, whereas the Web (WWW) is the service of linked hypertext pages/resources hosted on that network","hi":"इंटरनेट नेटवर्क इन्फ्रास्ट्रक्चर है, जबकि वेब (WWW) उस पर होस्ट किए गए लिंक्ड संसाधनों की एक सर्विस है"},"o":[{"en":"The Internet is the global network infrastructure, whereas the Web (WWW) is the service of linked hypertext pages/resources hosted on that network","hi":"इंटरनेट नेटवर्क इन्फ्रास्ट्रक्चर है, जबकि वेब (WWW) उस पर होस्ट किए गए लिंक्ड संसाधनों की एक सर्विस है"},{"en":"The Web is the physical network of routers, whereas the Internet is a single HTML page","hi":"वेब राउटर्स का भौतिक नेटवर्क है, जबकि इंटरनेट एक HTML पेज है"},{"en":"The Internet was invented in 1989 at CERN, whereas the Web was invented in 1969 by ARPA","hi":"इंटरनेट 1989 में CERN में बना, जबकि वेब 1969 में ARPA द्वारा"},{"en":"They are completely identical terms with zero technical difference","hi":"दोनों बिल्कुल एक ही शब्द हैं जिनमें कोई अंतर नहीं है"}],"exp":{"en":"Exam Trap: The Internet is the global network of interconnected networks (infrastructure), while the World Wide Web (WWW) is one of the information services (hyperlinked pages accessed via HTTP/HTTPS) that runs over the Internet.","hi":"एग्जाम ट्रैप: इंटरनेट वैश्विक नेटवर्क ढाँचा (network infrastructure) है, जबकि वर्ल्ड वाइड वेब (Web) उस नेटवर्क पर चलने वाली आपस में जुड़े वेबपेजों व संसाधनों की एक सेवा (service) है।"},"num":118},{"id":"q119","q":{"en":"Does 'UDP' stand for 'User Datagram Packet' or 'User Datagram Protocol'?","hi":"UDP का सही पूर्ण रूप 'User Datagram Packet' है या 'User Datagram Protocol'?"},"a":{"en":"User Datagram Protocol","hi":"यूज़र डेटाग्राम प्रोटोकॉल (User Datagram Protocol)"},"o":[{"en":"User Datagram Protocol","hi":"यूज़र डेटाग्राम प्रोटोकॉल (User Datagram Protocol)"},{"en":"User Datagram Packet","hi":"यूज़र डेटाग्राम पैकेट"},{"en":"Universal Data Port","hi":"यूनिवर्सल डेटा पोर्ट"},{"en":"Unified Datagram Program","hi":"यूनिफाइड डेटाग्राम प्रोग्राम"}],"exp":{"en":"Exam Trap: In UDP, the 'P' stands for Protocol — User Datagram Protocol (RFC 768), NOT 'Packet'.","hi":"एग्जाम ट्रैप: UDP का सही पूर्ण रूप 'User Datagram Protocol' है ('Packet' नहीं)।"},"num":119},{"id":"q120","q":{"en":"Which three protocols correspond respectively to 'Sending/relaying mail', 'Downloading mail to a local client', and 'Synchronizing a server mailbox across devices'?","hi":"ईमेल भेजने (Send), डाउनलोड करने (Download) और मेलबॉक्स सिंक (Sync) करने के प्रोटोकॉल क्रमशः कौन-से हैं?"},"a":{"en":"SMTP (send/relay), POP3 (download), and IMAP (mailbox sync) respectively","hi":"क्रमशः SMTP, POP3 और IMAP"},"o":[{"en":"SMTP (send/relay), POP3 (download), and IMAP (mailbox sync) respectively","hi":"क्रमशः SMTP, POP3 और IMAP"},{"en":"POP3 (send), IMAP (download), and SMTP (sync) respectively","hi":"क्रमशः POP3, IMAP और SMTP"},{"en":"HTTP, FTP, and SNMP respectively","hi":"क्रमशः HTTP, FTP और SNMP"},{"en":"NEFT, RTGS, and IMPS respectively","hi":"क्रमशः NEFT, RTGS और IMPS"}],"exp":{"en":"Exam Trap: SMTP = sending and relaying outgoing mail; POP3 = downloading messages from server to client; IMAP = accessing and synchronizing server mailbox folders across multiple devices.","hi":"एग्जाम ट्रैप: ईमेल भेजने/रिले करने के लिए `SMTP`, सर्वर से ईमेल डाउनलोड करने के लिए `POP3`, और कई उपकरणों पर सर्वर मेलबॉक्स सिंक करने के लिए `IMAP` का उपयोग होता है।"},"num":120},{"id":"q121","q":{"en":"Which email fields correspond respectively to 'Primary recipient', 'Visible copy recipient', and 'Hidden copy recipient'?","hi":"मुख्य प्राप्तकर्ता (Primary recipient), दृश्यमान कॉपी (Visible copy) और गुप्त कॉपी (Hidden copy) के लिए क्रमशः कौन-से ईमेल फ़ील्ड हैं?"},"a":{"en":"To, CC (Carbon Copy), and BCC (Blind Carbon Copy) respectively","hi":"क्रमशः To, CC और BCC"},"o":[{"en":"To, CC (Carbon Copy), and BCC (Blind Carbon Copy) respectively","hi":"क्रमशः To, CC और BCC"},{"en":"BCC, CC, and To respectively","hi":"क्रमशः BCC, CC और To"},{"en":"Subject, Body, and Signature respectively","hi":"क्रमशः Subject, Body और Signature"},{"en":"Inbox, Sent, and Drafts respectively","hi":"क्रमशः Inbox, Sent और Drafts"}],"exp":{"en":"Exam Trap: `To` is for primary recipients, `CC` (Carbon Copy) is for visible copy recipients, and `BCC` (Blind Carbon Copy) is for hidden copy recipients.","hi":"एग्जाम ट्रैप: मुख्य प्राप्तकर्ता के लिए `To`, दृश्यमान कॉपी के लिए `CC` (Carbon Copy), और गुप्त कॉपी के लिए `BCC` (Blind Carbon Copy) फ़ील्ड का उपयोग होता है।"},"num":121},{"id":"q122","q":{"en":"Which email actions correspond respectively to 'Removing from Inbox while saving in the mailbox' versus 'Placing in the temporary deletion queue'?","hi":"इनबॉक्स से हटाकर मेलबॉक्स में सुरक्षित रखने और अस्थायी डिलीशन कतार (Deletion queue) में डालने की कमांड्स क्रमशः कौन-सी हैं?"},"a":{"en":"Archive and Trash (Bin) respectively","hi":"क्रमशः आर्काइव (Archive) और ट्रैश (Trash)"},"o":[{"en":"Archive and Trash (Bin) respectively","hi":"क्रमशः आर्काइव (Archive) और ट्रैश (Trash)"},{"en":"Trash and Archive respectively","hi":"क्रमशः ट्रैश और आर्काइव"},{"en":"Reply and Forward respectively","hi":"क्रमशः रिप्लाई और फॉरवर्ड"},{"en":"Compose and Send respectively","hi":"क्रमशः कंपोज़ और सेंड"}],"exp":{"en":"Exam Trap: 'Archive' removes a message from the Inbox while keeping it saved in the mailbox, whereas 'Trash' places it in the temporary deletion queue.","hi":"एग्जाम ट्रैप: ईमेल को इनबॉक्स से हटाकर मेलबॉक्स में सुरक्षित रखना 'Archive' है, और अस्थायी डिलीशन कतार में डालना 'Trash' है।"},"num":122},{"id":"q123","q":{"en":"Which email commands correspond respectively to 'Responding to the original sender only', 'Responding to the sender and visible group', and 'Sharing with a new recipient'?","hi":"मूल प्रेषक को जवाब देने, दृश्यमान समूह को जवाब देने, और किसी नए प्राप्तकर्ता को ईमेल साझा करने की कमांड्स क्रमशः कौन-सी हैं?"},"a":{"en":"Reply, Reply All, and Forward respectively","hi":"क्रमशः Reply, Reply All और Forward"},"o":[{"en":"Reply, Reply All, and Forward respectively","hi":"क्रमशः Reply, Reply All और Forward"},{"en":"Forward, Reply, and Reply All respectively","hi":"क्रमशः Forward, Reply और Reply All"},{"en":"CC, BCC, and Archive respectively","hi":"क्रमशः CC, BCC और Archive"},{"en":"Send, Draft, and Spam respectively","hi":"क्रमशः Send, Draft और Spam"}],"exp":{"en":"Exam Trap: `Reply` responds to the original sender/Reply-To; `Reply All` responds to the sender plus all visible `To`/`CC` recipients; `Forward` shares the message with newly chosen recipients.","hi":"एग्जाम ट्रैप: केवल मूल प्रेषक को जवाब देना `Reply` है, प्रेषक सहित पूरे दृश्यमान समूह को जवाब देना `Reply All` है, और किसी नए प्राप्तकर्ता को ईमेल भेजना `Forward` है।"},"num":123},{"id":"q124","q":{"en":"Match 'Immediate 24×7 customer transfer' and 'Half-hourly settlement batches' with their respective payment systems:","hi":"'तत्काल ट्रांसफर' (Immediate transfer) और 'आधे घंटे के सेटलमेंट बैच' (Half-hourly batches) को उनके सही भुगतान सिस्टम से सुमेलित कीजिए:"},"a":{"en":"Immediate customer transfer → IMPS; Half-hourly settlement batches → NEFT","hi":"तत्काल ट्रांसफर → IMPS; आधे घंटे के सेटलमेंट बैच → NEFT"},"o":[{"en":"Immediate customer transfer → IMPS; Half-hourly settlement batches → NEFT","hi":"तत्काल ट्रांसफर → IMPS; आधे घंटे के सेटलमेंट बैच → NEFT"},{"en":"Immediate customer transfer → NEFT; Half-hourly settlement batches → IMPS","hi":"तत्काल ट्रांसफर → NEFT; आधे घंटे के बैच → IMPS"},{"en":"Both use monthly paper cheque clearing","hi":"दोनों मासिक कागजी चेक क्लियरिंग का उपयोग करते हैं"},{"en":"Immediate transfer → ECS Debit; Half-hourly batches → ATM","hi":"तत्काल ट्रांसफर → ECS Debit; आधे घंटे के बैच → ATM"}],"exp":{"en":"Exam Trap: IMPS (Immediate Payment Service) performs instant real-time individual customer transfers, whereas NEFT (National Electronic Funds Transfer) settles transactions in half-hourly (30-minute) batches.","hi":"एग्जाम ट्रैप: तत्काल (instant) ग्राहक ट्रांसफर `IMPS` द्वारा होता है, जबकि आधे-आधे घंटे के सेटलमेंट बैचों (half-hourly batches) में निपटान `NEFT` की पहचान है।"},"num":124},{"id":"q125","q":{"en":"What is the minimum transfer amount in 'RTGS', and what is its settlement method?","hi":"RTGS में न्यूनतम राशि कितनी होती है और इसकी सेटलमेंट विधि क्या है?"},"a":{"en":"Minimum ₹2 lakh; settled via individual real-time gross settlement (instruction by instruction, without netting)","hi":"न्यूनतम ₹2 लाख; व्यक्तिगत रियल-टाइम ग्रॉस सेटलमेंट (Individual real-time gross settlement)"},"o":[{"en":"Minimum ₹2 lakh; settled via individual real-time gross settlement (instruction by instruction, without netting)","hi":"न्यूनतम ₹2 लाख; व्यक्तिगत रियल-टाइम ग्रॉस सेटलमेंट (Individual real-time gross settlement)"},{"en":"Minimum ₹1; settled in half-hourly deferred net batches","hi":"न्यूनतम ₹1; आधे घंटे के बैचों में सेटलमेंट"},{"en":"Minimum ₹50,000; settled once a week","hi":"न्यूनतम ₹50,000; सप्ताह में एक बार सेटलमेंट"},{"en":"Minimum ₹10 lakh; settled via postal money order","hi":"न्यूनतम ₹10 लाख; पोस्टल मनी ऑर्डर द्वारा सेटलमेंट"}],"exp":{"en":"Exam Trap: RTGS has a minimum threshold of ₹2 lakh (with no upper ceiling) and settles each transfer individually in real time (gross settlement).","hi":"एग्जाम ट्रैप: RTGS में न्यूनतम राशि ₹2 लाख है और इसका निपटान व्यक्तिगत रियल-टाइम ग्रॉस सेटलमेंट (individual real-time gross settlement) विधि से होता है।"},"num":125},{"id":"q126","q":{"en":"Match 'Bulk salary/pension credit' and 'Recurring electricity bill collection' with their respective ECS types:","hi":"'बल्क सैलरी क्रेडिट' और 'आवर्ती बिजली बिल कलेक्शन' का सही ECS मिलान क्या है?"},"a":{"en":"Bulk salary credit → ECS Credit; Recurring electricity bill collection → ECS Debit","hi":"बल्क वेतन जमा → ECS Credit; आवर्ती बिजली बिल वसूली → ECS Debit"},"o":[{"en":"Bulk salary credit → ECS Credit; Recurring electricity bill collection → ECS Debit","hi":"बल्क वेतन जमा → ECS Credit; आवर्ती बिजली बिल वसूली → ECS Debit"},{"en":"Bulk salary credit → ECS Debit; Recurring electricity bill collection → ECS Credit","hi":"बल्क वेतन जमा → ECS Debit; आवर्ती बिजली बिल वसूली → ECS Credit"},{"en":"Both are walk-in cash remittances","hi":"दोनों वॉक-इन नकद प्रेषण हैं"},{"en":"Both are email protocols","hi":"दोनों ईमेल प्रोटोकॉल हैं"}],"exp":{"en":"Exam Trap: Bulk payouts from an institution to many accounts (salaries, pensions, dividends) use `ECS Credit`, while recurring collections from customer accounts (utility bills, EMIs) use `ECS Debit`.","hi":"एग्जाम ट्रैप: एक साथ कई खातों में वेतन या पेंशन जमा करना `ECS Credit` है, और ग्राहकों के खातों से आवर्ती बिजली बिल या EMI की वसूली करना `ECS Debit` है।"},"num":126}]},{"title":{"en":"10. Rapid-Fire Final Revision","hi":"10. त्वरित अंतिम पुनरावृत्ति"},"questions":[{"id":"q127","q":{"en":"What is an organization that provides Internet connectivity to users called?","hi":"यूज़र्स को इंटरनेट कनेक्टिविटी देने वाली संस्था को संक्षेप में क्या कहते हैं?"},"a":{"en":"ISP (Internet Service Provider)","hi":"ISP (इंटरनेट सर्विस प्रोवाइडर)"},"o":[{"en":"ISP (Internet Service Provider)","hi":"ISP (इंटरनेट सर्विस प्रोवाइडर)"},{"en":"ALU (Arithmetic Logic Unit)","hi":"ALU"},{"en":"SERP (Search Engine Results Page)","hi":"SERP"},{"en":"ECS (Electronic Clearing Service)","hi":"ECS"}],"exp":{"en":"Rapid-Fire: An Internet connectivity provider is called an ISP (Internet Service Provider).","hi":"रैपिड-फायर: इंटरनेट कनेक्टिविटी देने वाली संस्था को `ISP` (Internet Service Provider) कहते हैं।"},"num":127},{"id":"q128","q":{"en":"What is the common name of the Internet's foundational protocol family?","hi":"इंटरनेट के मुख्य प्रोटोकॉल परिवार का सामान्य नाम क्या है?"},"a":{"en":"TCP/IP","hi":"TCP/IP"},"o":[{"en":"TCP/IP","hi":"TCP/IP"},{"en":"BIOS/CMOS","hi":"BIOS/CMOS"},{"en":"CAD/CAM","hi":"CAD/CAM"},{"en":"HTML/CSS","hi":"HTML/CSS"}],"exp":{"en":"Rapid-Fire: The Internet protocol suite is commonly called TCP/IP.","hi":"रैपिड-फायर: इंटरनेट प्रोटोकॉल परिवार का सामान्य नाम `TCP/IP` है।"},"num":128},{"id":"q129","q":{"en":"Who is the pioneer of networked email on ARPANET (who introduced the '@' symbol in 1971)?","hi":"नेटवर्क ईमेल के अग्रदूत (Pioneer) कौन हैं?"},"a":{"en":"Ray Tomlinson","hi":"रे टॉमलिनसन (Ray Tomlinson)"},"o":[{"en":"Ray Tomlinson","hi":"रे टॉमलिनसन (Ray Tomlinson)"},{"en":"Charles Babbage","hi":"चार्ल्स बैबेज"},{"en":"Herman Hollerith","hi":"हरमन होलेरिथ"},{"en":"Blaise Pascal","hi":"ब्लेज़ पास्कल"}],"exp":{"en":"Rapid-Fire: Ray Tomlinson developed network email in 1971.","hi":"रैपिड-फायर: नेटवर्क ईमेल के अग्रदूत रे टॉमलिनसन (Ray Tomlinson) हैं।"},"num":129},{"id":"q130","q":{"en":"In which year and at which institution was the World Wide Web proposed?","hi":"वर्ल्ड वाइड वेब (Web) का प्रस्ताव किस वर्ष और किस संस्थान में दिया गया?"},"a":{"en":"1989, at CERN","hi":"1989, CERN में"},"o":[{"en":"1989, at CERN","hi":"1989, CERN में"},{"en":"1969, at Bell Labs","hi":"1969, बेल लैब्स में"},{"en":"1995, at VSNL","hi":"1995, VSNL में"},{"en":"2008, at Google","hi":"2008, गूगल में"}],"exp":{"en":"Rapid-Fire: Tim Berners-Lee proposed the World Wide Web in 1989 at CERN.","hi":"रैपिड-फायर: वेब का प्रस्ताव वर्ष 1989 में CERN में दिया गया था।"},"num":130},{"id":"q131","q":{"en":"In which year was the World Wide Web Consortium (W3C) founded?","hi":"W3C (World Wide Web Consortium) की स्थापना किस वर्ष हुई?"},"a":{"en":"1994","hi":"1994"},"o":[{"en":"1994","hi":"1994"},{"en":"1971","hi":"1971"},{"en":"1983","hi":"1983"},{"en":"2001","hi":"2001"}],"exp":{"en":"Rapid-Fire: The W3C was founded by Tim Berners-Lee in 1994.","hi":"रैपिड-फायर: W3C की स्थापना वर्ष 1994 में हुई थी।"},"num":131},{"id":"q132","q":{"en":"Which organization launched public Internet service in India, and in which year?","hi":"भारत में सार्वजनिक इंटरनेट सेवा किस संस्था द्वारा और किस वर्ष शुरू की गई?"},"a":{"en":"VSNL, in 1995","hi":"VSNL, 1995 में"},"o":[{"en":"VSNL, in 1995","hi":"VSNL, 1995 में"},{"en":"NPCI, in 2010","hi":"NPCI, 2010 में"},{"en":"RBI, in 1985","hi":"RBI, 1985 में"},{"en":"NCSA, in 1993","hi":"NCSA, 1993 में"}],"exp":{"en":"Rapid-Fire: Public Internet in India was launched by VSNL in 1995.","hi":"रैपिड-फायर: भारत में सार्वजनिक इंटरनेट की शुरुआत `VSNL` द्वारा वर्ष `1995` में की गई थी।"},"num":132},{"id":"q133","q":{"en":"Which system resolves human-readable domain names into IP addresses?","hi":"मानव-पठनीय डोमेन नामों को रिज़ॉल्व (Resolve) करने वाला सिस्टम कौन-सा है?"},"a":{"en":"DNS (Domain Name System)","hi":"DNS (डोमेन नेम सिस्टम)"},"o":[{"en":"DNS (Domain Name System)","hi":"DNS (डोमेन नेम सिस्टम)"},{"en":"UPS (Uninterruptible Power Supply)","hi":"UPS"},{"en":"SMPS (Switched-Mode Power Supply)","hi":"SMPS"},{"en":"VDU (Visual Display Unit)","hi":"VDU"}],"exp":{"en":"Rapid-Fire: DNS (Domain Name System) resolves human-readable domain names.","hi":"रैपिड-फायर: मानव-पठनीय नामों को रिज़ॉल्व करने वाला सिस्टम `DNS` (Domain Name System) है।"},"num":133},{"id":"q134","q":{"en":"Which markup language is used to structure webpages?","hi":"वेबपेज तैयार करने वाली मार्कअप भाषा कौन-सी है?"},"a":{"en":"HTML (HyperText Markup Language)","hi":"HTML"},"o":[{"en":"HTML (HyperText Markup Language)","hi":"HTML"},{"en":"SMTP (Simple Mail Transfer Protocol)","hi":"SMTP"},{"en":"POP3 (Post Office Protocol 3)","hi":"POP3"},{"en":"SNMP (Simple Network Management Protocol)","hi":"SNMP"}],"exp":{"en":"Rapid-Fire: HTML is the standard markup language for webpages.","hi":"रैपिड-फायर: वेबपेज की मार्कअप भाषा `HTML` है।"},"num":134},{"id":"q135","q":{"en":"Which protocol handles Web request/response communication between browsers and servers?","hi":"वेब रिक्वेस्ट और रिस्पॉन्स का आदान-प्रदान करने वाला प्रोटोकॉल कौन-सा है?"},"a":{"en":"HTTP (or HTTPS)","hi":"HTTP (हाइपरटेक्स्ट ट्रांसफर प्रोटोकॉल)"},"o":[{"en":"HTTP (or HTTPS)","hi":"HTTP (हाइपरटेक्स्ट ट्रांसफर प्रोटोकॉल)"},{"en":"POP3","hi":"POP3"},{"en":"SLIP","hi":"SLIP"},{"en":"ICMP","hi":"ICMP"}],"exp":{"en":"Rapid-Fire: HTTP (Hypertext Transfer Protocol) handles web requests and responses.","hi":"रैपिड-फायर: वेब रिक्वेस्ट/रिस्पॉन्स प्रोटोकॉल `HTTP` है।"},"num":135},{"id":"q136","q":{"en":"Which traditional protocol is dedicated to transferring files over a network?","hi":"नेटवर्क पर फ़ाइलें ट्रांसफर करने वाला प्रोटोकॉल कौन-सा है?"},"a":{"en":"FTP (File Transfer Protocol)","hi":"FTP (फ़ाइल ट्रांसफर प्रोटोकॉल)"},"o":[{"en":"FTP (File Transfer Protocol)","hi":"FTP (फ़ाइल ट्रांसफर प्रोटोकॉल)"},{"en":"NNTP","hi":"NNTP"},{"en":"DHCP","hi":"DHCP"},{"en":"ARP","hi":"ARP"}],"exp":{"en":"Rapid-Fire: FTP stands for File Transfer Protocol.","hi":"रैपिड-फायर: फ़ाइल ट्रांसफर प्रोटोकॉल `FTP` है।"},"num":136},{"id":"q137","q":{"en":"What is the full form of 'URL' (web address)?","hi":"वेब एड्रेस 'URL' का पूर्ण रूप क्या है?"},"a":{"en":"Uniform Resource Locator","hi":"यूनिफॉर्म रिसोर्स लोकेटर (Uniform Resource Locator)"},"o":[{"en":"Uniform Resource Locator","hi":"यूनिफॉर्म रिसोर्स लोकेटर (Uniform Resource Locator)"},{"en":"Universal Radio Link","hi":"यूनिवर्सल रेडियो लिंक"},{"en":"Unified Router List","hi":"यूनिफाइड राउटर लिस्ट"},{"en":"User Remote Login","hi":"यूज़र रिमोट लॉगिन"}],"exp":{"en":"Rapid-Fire: URL stands for Uniform Resource Locator.","hi":"रैपिड-फायर: URL का पूर्ण रूप `Uniform Resource Locator` है।"},"num":137},{"id":"q138","q":{"en":"What is the screen of ranked search results returned by a search engine called?","hi":"सर्च इंजन द्वारा दिखाए जाने वाले परिणामों की स्क्रीन को क्या कहते हैं?"},"a":{"en":"SERP (Search Engine Results Page)","hi":"SERP (सर्च इंजन रिज़ल्ट्स पेज)"},"o":[{"en":"SERP (Search Engine Results Page)","hi":"SERP (सर्च इंजन रिज़ल्ट्स पेज)"},{"en":"BIOS","hi":"BIOS"},{"en":"NACH","hi":"NACH"},{"en":"MODEM","hi":"MODEM"}],"exp":{"en":"Rapid-Fire: The ranked results screen is called SERP (Search Engine Results Page).","hi":"रैपिड-फायर: सर्च परिणामों की स्क्रीन को `SERP` (Search Engine Results Page) कहते हैं।"},"num":138},{"id":"q139","q":{"en":"What is the standard exam answer for the 'First Internet search engine'?","hi":"'पहले इंटरनेट सर्च इंजन' के प्रश्न का मानक परीक्षा उत्तर क्या है?"},"a":{"en":"Archie","hi":"आर्ची (Archie)"},"o":[{"en":"Archie","hi":"आर्ची (Archie)"},{"en":"Mozilla Firefox","hi":"मोज़िला फ़ायरफ़ॉक्स"},{"en":"Opera","hi":"ओपेरा"},{"en":"Safari","hi":"सफारी"}],"exp":{"en":"Rapid-Fire: Archie (created by Alan Emtage in 1990) is the standard exam answer for the first Internet search engine.","hi":"रैपिड-फायर: पहले इंटरनेट सर्च इंजन का मानक उत्तर `Archie` है।"},"num":139},{"id":"q140","q":{"en":"Which networking device forwards data packets between different networks?","hi":"अलग-अलग नेटवर्क्स के बीच डेटा पैकेट्स को कौन फॉरवर्ड करता है?"},"a":{"en":"Router","hi":"राउटर (Router)"},"o":[{"en":"Router","hi":"राउटर (Router)"},{"en":"Plotter","hi":"प्लॉटर"},{"en":"Scanner","hi":"स्कैनर"},{"en":"Microphone","hi":"माइक्रोफोन"}],"exp":{"en":"Rapid-Fire: A Router forwards packets between different computer networks.","hi":"रैपिड-फायर: अलग-अलग नेटवर्क्स के बीच पैकेट्स फॉरवर्ड करने वाला उपकरण `राउटर` (Router) है।"},"num":140},{"id":"q141","q":{"en":"What is transferring data from your local device to a remote server called?","hi":"अपने डिवाइस से सर्वर की तरफ डेटा भेजने को क्या कहते हैं?"},"a":{"en":"Upload","hi":"अपलोड (Upload)"},"o":[{"en":"Upload","hi":"अपलोड (Upload)"},{"en":"Download","hi":"डाउनलोड"},{"en":"Booting","hi":"बूटिंग"},{"en":"Formatting","hi":"फ़ॉर्मेटिंग"}],"exp":{"en":"Rapid-Fire: Sending data from a local device to a remote server is called Upload.","hi":"रैपिड-फायर: डिवाइस से सर्वर की तरफ डेटा ट्रांसफर को `अपलोड` (Upload) कहते हैं।"},"num":141},{"id":"q142","q":{"en":"What is an email message that has been written/saved but not yet sent called?","hi":"लिखे हुए लेकिन अभी तक न भेजे गए (Unsent) ईमेल संदेश को क्या कहते हैं?"},"a":{"en":"Draft (stored in the Drafts folder)","hi":"ड्राफ्ट (Draft)"},"o":[{"en":"Draft (stored in the Drafts folder)","hi":"ड्राफ्ट (Draft)"},{"en":"Spam","hi":"स्पैम"},{"en":"Bounce","hi":"बाउंस"},{"en":"Forward","hi":"फॉरवर्ड"}],"exp":{"en":"Rapid-Fire: An unsent saved message is called a Draft.","hi":"रैपिड-फायर: लिखे हुए परंतु न भेजे गए संदेश को `ड्राफ्ट` (Draft) कहते हैं।"},"num":142},{"id":"q143","q":{"en":"Which icon in an email client represents attaching a file?","hi":"ईमेल में फ़ाइल अटैच करने का आइकन कौन-सा होता है?"},"a":{"en":"Paperclip icon","hi":"पेपरक्लिप (Paperclip) आइकन"},"o":[{"en":"Paperclip icon","hi":"पेपरक्लिप (Paperclip) आइकन"},{"en":"Trash bin icon","hi":"ट्रैश बिन आइकन"},{"en":"Magnifying glass icon","hi":"मैग्निफाइंग ग्लास आइकन"},{"en":"Speaker icon","hi":"स्पीकर आइकन"}],"exp":{"en":"Rapid-Fire: The Paperclip icon represents file attachments.","hi":"रैपिड-फायर: फ़ाइल अटैचमेंट का प्रतीक `पेपरक्लिप` (Paperclip) आइकन है।"},"num":143},{"id":"q144","q":{"en":"Which email field is used to send a hidden copy whose address is not visible to other recipients?","hi":"अन्य प्राप्तकर्ताओं से पता छिपाकर गुप्त कॉपी भेजने वाला ईमेल फ़ील्ड कौन-सा है?"},"a":{"en":"BCC (Blind Carbon Copy)","hi":"BCC (ब्लाइंड कार्बन कॉपी)"},"o":[{"en":"BCC (Blind Carbon Copy)","hi":"BCC (ब्लाइंड कार्बन कॉपी)"},{"en":"CC (Carbon Copy)","hi":"CC"},{"en":"To","hi":"To"},{"en":"Subject","hi":"Subject"}],"exp":{"en":"Rapid-Fire: BCC (Blind Carbon Copy) is the hidden copy field.","hi":"रैपिड-फायर: गुप्त कॉपी भेजने वाला फ़ील्ड `BCC` (Blind Carbon Copy) है।"},"num":144},{"id":"q145","q":{"en":"What are the key identifying cues for NEFT, RTGS, and IMPS respectively?","hi":"NEFT, RTGS और IMPS को पहचानने के मुख्य संकेत (Key cues) क्रमशः क्या हैं?"},"a":{"en":"NEFT → half-hourly batches; RTGS → individual real-time gross settlement (min ₹2 lakh); IMPS → instant 24×7 interbank transfer","hi":"NEFT → आधे घंटे के बैच; RTGS → व्यक्तिगत रियल-टाइम सेटलमेंट; IMPS → तत्काल 24×7 इंटरबैंक ट्रांसफर"},"o":[{"en":"NEFT → half-hourly batches; RTGS → individual real-time gross settlement (min ₹2 lakh); IMPS → instant 24×7 interbank transfer","hi":"NEFT → आधे घंटे के बैच; RTGS → व्यक्तिगत रियल-टाइम सेटलमेंट; IMPS → तत्काल 24×7 इंटरबैंक ट्रांसफर"},{"en":"NEFT → min ₹2 lakh; RTGS → half-hourly batches; IMPS → monthly paper clearing","hi":"NEFT → न्यूनतम ₹2 लाख; RTGS → आधे घंटे के बैच; IMPS → मासिक पेपर क्लियरिंग"},{"en":"All three operate only through physical cheques","hi":"तीनों केवल भौतिक चेक से काम करते हैं"},{"en":"All three are web browsers","hi":"तीनों वेब ब्राउज़र हैं"}],"exp":{"en":"Rapid-Fire: NEFT = half-hourly batches; RTGS = individual real-time gross settlement for large value (min ₹2 lakh); IMPS = instant 24×7 interbank retail transfer.","hi":"रैपिड-फायर: `NEFT` = आधे घंटे के बैच; `RTGS` = व्यक्तिगत रियल-टाइम सेटलमेंट (न्यूनतम ₹2 लाख); `IMPS` = तत्काल 24×7 इंटरबैंक ट्रांसफर।"},"num":145},{"id":"q146","q":{"en":"Which banking service is used for periodic bulk electronic credits (salaries/dividends) and recurring debits (bills/EMIs)?","hi":"आवधिक बल्क इलेक्ट्रॉनिक क्लियरिंग (वेतन, बिल, EMI आदि) के लिए कौन-सी सेवा प्रयुक्त होती है?"},"a":{"en":"ECS (Electronic Clearing Service / NACH)","hi":"ECS (इलेक्ट्रॉनिक क्लियरिंग सर्विस)"},"o":[{"en":"ECS (Electronic Clearing Service / NACH)","hi":"ECS (इलेक्ट्रॉनिक क्लियरिंग सर्विस)"},{"en":"Walk-in Cash NEFT","hi":"वॉक-इन कैश NEFT"},{"en":"ATM PIN change","hi":"एटीएम पिन चेंज"},{"en":"Telnet login","hi":"टेलनेट लॉगिन"}],"exp":{"en":"Rapid-Fire: ECS (Electronic Clearing Service, now consolidated under NACH) handles periodic bulk electronic credits and debits.","hi":"रैपिड-फायर: आवधिक बल्क इलेक्ट्रॉनिक क्लियरिंग सेवा `ECS` (Electronic Clearing Service) है।"},"num":146}]}],"6. Data Communication & Computer Networks — Signals, Topologies, Devices, Addresses & Malware":[{"title":{"en":"1. Data Communication & Signal Basics","hi":"1. डेटा संचार और सिग्नल की मूल बातें"},"questions":[{"id":"q1","q":{"en":"What is 'Data Communication'?","hi":"'डेटा संचार' (Data Communication) क्या है?"},"a":{"en":"Exchange of data between two or more devices over a transmission medium","hi":"किसी ट्रांसमिशन माध्यम पर दो या अधिक उपकरणों (devices) के बीच डेटा का आदान-प्रदान"},"o":[{"en":"Storing paper files manually inside a steel cabinet","hi":"स्टील अलमारी के अंदर कागजी फाइलों को मैन्युअल रूप से रखना"},{"en":"Cooling a standalone processor using a liquid heat sink","hi":"लिक्विड हीट सिंक का उपयोग करके किसी अकेले प्रोसेसर को ठंडा करना"},{"en":"Exchange of data between two or more devices over a transmission medium","hi":"किसी ट्रांसमिशन माध्यम पर दो या अधिक उपकरणों (devices) के बीच डेटा का आदान-प्रदान"},{"en":"Printing offline text documents without any connection","hi":"बिना किसी कनेक्शन के ऑफलाइन टेक्स्ट दस्तावेज़ प्रिंट करना"}],"exp":{"en":"Data communication refers to the exchange of data between two or more connected devices via some form of transmission medium.","hi":"दो या अधिक उपकरणों (devices) के बीच ट्रांसमिशन माध्यम से डेटा के आदान-प्रदान (exchange) को डेटा संचार (Data Communication) कहते हैं।"},"num":1},{"id":"q2","q":{"en":"What is the correct sequence of a basic communication circuit?","hi":"एक बेसिक कम्युनिकेशन सर्किट (Basic Communication Circuit) का सही क्रम क्या है?"},"a":{"en":"Source → Transmitter → Transmission system → Receiver → Destination","hi":"सोर्स → ट्रांसमीटर → ट्रांसमिशन सिस्टम → रिसीवर → डेस्टिनेशन"},"o":[{"en":"Destination → Receiver → Source → Transmitter → Transmission system","hi":"डेस्टिनेशन → रिसीवर → सोर्स → ट्रांसमीटर → ट्रांसमिशन सिस्टम"},{"en":"Source → Transmitter → Transmission system → Receiver → Destination","hi":"सोर्स → ट्रांसमीटर → ट्रांसमिशन सिस्टम → रिसीवर → डेस्टिनेशन"},{"en":"Transmitter → Source → Destination → Receiver → Transmission system","hi":"ट्रांसमीटर → सोर्स → डेस्टिनेशन → रिसीवर → ट्रांसमिशन सिस्टम"},{"en":"Receiver → Transmission system → Source → Destination → Transmitter","hi":"रिसीवर → ट्रांसमिशन सिस्टम → सोर्स → डेस्टिनेशन → ट्रांसमीटर"}],"exp":{"en":"In a basic communication model, data flows in the order: Source → Transmitter → Transmission system → Receiver → Destination.","hi":"बेसिक कम्युनिकेशन सर्किट का सही क्रम है: सोर्स (Source) → ट्रांसमीटर (Transmitter) → ट्रांसमिशन सिस्टम (Transmission system) → रिसीवर (Receiver) → डेस्टिनेशन (Destination)।"},"num":2},{"id":"q3","q":{"en":"In a classic dial-up communication example, how does a signal travel from a workstation to a server?","hi":"डायल-अप (Dial-up) उदाहरण में वर्कस्टेशन से सर्वर तक सिग्नल किस क्रम में जाता है?"},"a":{"en":"Workstation → Sender modem → Public telephone network → Receiver modem → Server","hi":"वर्कस्टेशन → सेंडर मॉडेम → पब्लिक टेलीफोन नेटवर्क → रिसीवर मॉडेम → सर्वर"},"o":[{"en":"Workstation → Sender modem → Public telephone network → Receiver modem → Server","hi":"वर्कस्टेशन → सेंडर मॉडेम → पब्लिक टेलीफोन नेटवर्क → रिसीवर मॉडेम → सर्वर"},{"en":"Server → Workstation → Public telephone network → Sender modem → Receiver modem","hi":"सर्वर → वर्कस्टेशन → पब्लिक टेलीफोन नेटवर्क → सेंडर मॉडेम → रिसीवर मॉडेम"},{"en":"Sender modem → Workstation → Server → Receiver modem → Public telephone network","hi":"सेंडर मॉडेम → वर्कस्टेशन → सर्वर → रिसीवर मॉडेम → पब्लिक टेलीफोन नेटवर्क"},{"en":"Public telephone network → Workstation → Server → Sender modem → Receiver modem","hi":"पब्लिक टेलीफोन नेटवर्क → वर्कस्टेशन → सर्वर → सेंडर मॉडेम → रिसीवर मॉडेम"}],"exp":{"en":"In the dial-up modem-to-modem telephone example, the signal path is: Workstation → Sender modem → Public telephone network → Receiver modem → Server.","hi":"डायल-अप उदाहरण में सिग्नल का प्रवाह क्रम है: वर्कस्टेशन → सेंडर मॉडेम → पब्लिक टेलीफोन नेटवर्क → रिसीवर मॉडेम → सर्वर।"},"num":3},{"id":"q4","q":{"en":"What are the respective roles of a 'Transmitter' and a 'Receiver' in data communication?","hi":"डेटा संचार में 'ट्रांसमीटर' (Transmitter) और 'रिसीवर' (Receiver) की मुख्य भूमिका क्या है?"},"a":{"en":"Transmitter converts the message into a signal suitable for the medium, while Receiver recovers data from the received signal","hi":"ट्रांसमीटर संदेश को माध्यम पर भेजने योग्य सिग्नल बनाता है, और रिसीवर सिग्नल से डेटा प्राप्त (recover) करता है"},"o":[{"en":"Both only supply electrical power to the monitor","hi":"दोनों केवल मॉनिटर को विद्युत शक्ति प्रदान करते हैं"},{"en":"Transmitter deletes the message, while Receiver blocks the medium","hi":"ट्रांसमीटर संदेश को हटाता है, जबकि रिसीवर माध्यम को ब्लॉक करता है"},{"en":"Transmitter converts the message into a signal suitable for the medium, while Receiver recovers data from the received signal","hi":"ट्रांसमीटर संदेश को माध्यम पर भेजने योग्य सिग्नल बनाता है, और रिसीवर सिग्नल से डेटा प्राप्त (recover) करता है"},{"en":"Receiver generates the source message, while Transmitter displays the final printout","hi":"रिसीवर मूल संदेश बनाता है, जबकि ट्रांसमीटर अंतिम प्रिंटआउट दिखाता है"}],"exp":{"en":"The transmitter converts/encodes the source message into a signal suitable for transmission over the medium, while the receiver accepts the signal and recovers the data for the destination.","hi":"ट्रांसमीटर संदेश को माध्यम पर भेजने योग्य सिग्नल में बदलता है, जबकि रिसीवर प्राप्त सिग्नल से डेटा को पुनः प्राप्त (recover) करता है।"},"num":4},{"id":"q5","q":{"en":"What are the four fundamental characteristics of effective data communication?","hi":"प्रभावी डेटा संचार (Effective Data Communication) की चार मुख्य विशेषताएँ कौन-सी हैं?"},"a":{"en":"Delivery, Accuracy, Timeliness, and Jitter","hi":"डिलीवरी (Delivery), एक्यूरेसी (Accuracy), टाइमलीनेस (Timeliness) और जिटर (Jitter)"},"o":[{"en":"Delivery, Accuracy, Timeliness, and Jitter","hi":"डिलीवरी (Delivery), एक्यूरेसी (Accuracy), टाइमलीनेस (Timeliness) और जिटर (Jitter)"},{"en":"Voltage, Current, Resistance, and Friction","hi":"वोल्टेज, करंट, प्रतिरोध और घर्षण"},{"en":"Printing, Scanning, Photocopying, and Binding","hi":"प्रिंटिंग, स्कैनिंग, फोटोकॉपी और बाइंडिंग"},{"en":"Booting, Formatting, Partitioning, and Defragmenting","hi":"बूटिंग, फॉर्मेटिंग, पार्टीशनिंग और डीफ्रैग्मेंटिंग"}],"exp":{"en":"The effectiveness of a data communication system depends on four key characteristics: Delivery, Accuracy, Timeliness, and Jitter.","hi":"प्रभावी डेटा संचार की चार मुख्य विशेषताएँ डिलीवरी (Delivery), एक्यूरेसी (Accuracy), टाइमलीनेस (Timeliness) और जिटर (Jitter) हैं।"},"num":5},{"id":"q6","q":{"en":"What is the difference between 'Delivery' and 'Accuracy' in data communication?","hi":"डेटा संचार में 'डिलीवरी' (Delivery) और 'एक्यूरेसी' (Accuracy) में क्या अंतर है?"},"a":{"en":"Delivery means reaching the correct destination, whereas Accuracy means delivering data correctly and intact without alteration","hi":"डिलीवरी का मतलब सही गंतव्य (destination) तक पहुँचना है, जबकि एक्यूरेसी का मतलब डेटा का सही और बिना त्रुटि (intact) पहुँचना है"},"o":[{"en":"Delivery means deleting data, while Accuracy means delaying packets","hi":"डिलीवरी का अर्थ डेटा हटाना है, जबकि एक्यूरेसी का अर्थ पैकेट में देरी करना है"},{"en":"Delivery means reaching the correct destination, whereas Accuracy means delivering data correctly and intact without alteration","hi":"डिलीवरी का मतलब सही गंतव्य (destination) तक पहुँचना है, जबकि एक्यूरेसी का मतलब डेटा का सही और बिना त्रुटि (intact) पहुँचना है"},{"en":"Both terms mean the physical weight of the network cable","hi":"दोनों शब्दों का अर्थ नेटवर्क केबल का भौतिक वजन है"},{"en":"Delivery refers to audio volume, while Accuracy refers to screen brightness","hi":"डिलीवरी ऑडियो वॉल्यूम को दर्शाती है, जबकि एक्यूरेसी स्क्रीन की चमक को दर्शाती है"}],"exp":{"en":"Delivery ensures that data reaches the intended destination/user, while Accuracy ensures that the data arrives unaltered and free from corruption/errors.","hi":"डिलीवरी का अर्थ डेटा का सही गंतव्य (correct destination) तक पहुँचना है, जबकि एक्यूरेसी का अर्थ डेटा का बिना किसी बदलाव या त्रुटि के सही व सुरक्षित (intact) पहुँचना है।"},"num":6},{"id":"q7","q":{"en":"What does 'Timeliness' mean in the context of data communication?","hi":"डेटा संचार के संदर्भ में 'टाइमलीनेस' (Timeliness) का क्या अर्थ है?"},"a":{"en":"Data must arrive within the required time window, especially in real-time/live audio and video transmission","hi":"डेटा का निर्धारित समय के भीतर पहुँचना, विशेष रूप से लाइव ऑडियो/वीडियो में"},"o":[{"en":"Data must arrive within the required time window, especially in real-time/live audio and video transmission","hi":"डेटा का निर्धारित समय के भीतर पहुँचना, विशेष रूप से लाइव ऑडियो/वीडियो में"},{"en":"Data should be delivered only once a year in batch mode","hi":"डेटा को बैच मोड में साल में केवल एक बार डिलीवर किया जाना चाहिए"},{"en":"Setting the system clock timezone manually in BIOS","hi":"BIOS में सिस्टम घड़ी का टाइमज़ोन मैन्युअल रूप से सेट करना"},{"en":"Counting the total number of copper wires inside a twisted-pair cable","hi":"ट्विस्टेड-पेयर केबल के अंदर तांबे के तारों की कुल संख्या गिनना"}],"exp":{"en":"Timeliness means delivering data within the required time frame (real-time delivery) so it remains useful, which is critical for live audio and video streaming.","hi":"टाइमलीनेस (Timeliness) का अर्थ है कि डेटा आवश्यक समय के भीतर गंतव्य पर पहुँचे, विशेष रूप से लाइव ऑडियो और वीडियो संचार में।"},"num":7},{"id":"q8","q":{"en":"What is 'Jitter' in packet-switched data communication?","hi":"डेटा संचार में 'जिटर' (Jitter) क्या है?"},"a":{"en":"Variation in packet delay or arrival intervals, where uneven packet arrival affects audio/video playback quality","hi":"पैकेट देरी (delay) या आगमन अंतराल का उतार-चढ़ाव (variation), जिससे असमान अंतराल पर पैकेट आने से ऑडियो/वीडियो प्लेबैक प्रभावित होता है"},"o":[{"en":"The physical length of a fiber-optic cable in kilometers","hi":"किलोमीटर में फाइबर-ऑप्टिक केबल की भौतिक लंबाई"},{"en":"A permanent hardware failure of the computer keyboard","hi":"कंप्यूटर कीबोर्ड की स्थायी हार्डवेयर खराबी"},{"en":"Variation in packet delay or arrival intervals, where uneven packet arrival affects audio/video playback quality","hi":"पैकेट देरी (delay) या आगमन अंतराल का उतार-चढ़ाव (variation), जिससे असमान अंतराल पर पैकेट आने से ऑडियो/वीडियो प्लेबैक प्रभावित होता है"},{"en":"A software utility used for compressing text files into ZIP archives","hi":"टेक्स्ट फाइलों को ZIP आर्काइव में कंप्रेस करने के लिए उपयोग की जाने वाली सॉफ्टवेयर यूटिलिटी"}],"exp":{"en":"Jitter is the variation in packet delay (uneven arrival intervals of packets); if packets arrive at irregular intervals, real-time audio or video playback becomes choppy.","hi":"पैकेट देरी (packet delay) या आगमन अंतराल के उतार-चढ़ाव (variation) को जिटर (Jitter) कहते हैं। यदि पैकेट असमान अंतराल पर आते हैं, तो ऑडियो/वीडियो की गुणवत्ता प्रभावित होती है।"},"num":8},{"id":"q9","q":{"en":"What is the key distinction between 'Latency' and 'Jitter'?","hi":"'लेटेंसी' (Latency) और 'जिटर' (Jitter) के बीच मुख्य अंतर क्या है?"},"a":{"en":"Latency is the delay of a packet, whereas Jitter is the variation among packet delays","hi":"लेटेंसी एक पैकेट की देरी (delay) है, जबकि जिटर पैकेट्स की देरी में होने वाला उतार-चढ़ाव (variation) है"},"o":[{"en":"Latency is the delay of a packet, whereas Jitter is the variation among packet delays","hi":"लेटेंसी एक पैकेट की देरी (delay) है, जबकि जिटर पैकेट्स की देरी में होने वाला उतार-चढ़ाव (variation) है"},{"en":"Latency measures hard disk capacity, whereas Jitter measures monitor resolution","hi":"लेटेंसी हार्ड डिस्क क्षमता मापती है, जबकि जिटर मॉनिटर रेजोल्यूशन मापता है"},{"en":"Latency applies only to printers, whereas Jitter applies only to scanners","hi":"लेटेंसी केवल प्रिंटर पर लागू होती है, जबकि जिटर केवल स्कैनर पर लागू होता है"},{"en":"Both are types of antivirus software programs","hi":"दोनों एंटीवायरस सॉफ्टवेयर प्रोग्राम के प्रकार हैं"}],"exp":{"en":"Latency refers to the transit delay experienced by a packet from source to destination, whereas Jitter measures how much that delay varies from packet to packet.","hi":"लेटेंसी (Latency) किसी पैकेट के पहुँचने में लगने वाली देरी (delay) है, जबकि जिटर (Jitter) विभिन्न पैकेट्स की देरी में होने वाला उतार-चढ़ाव (variation) है।"},"num":9},{"id":"q10","q":{"en":"Which of the following are the five core components of a data communication system?","hi":"डेटा कम्युनिकेशन सिस्टम के पाँच मुख्य घटक (Five Components) कौन-से हैं?"},"a":{"en":"Sender, Receiver, Message, Transmission Medium, and Protocol","hi":"सेंडर (Sender), रिसीवर (Receiver), मैसेज (Message), ट्रांसमिशन माध्यम (Transmission Medium) और प्रोटोकॉल (Protocol)"},"o":[{"en":"Monitor, Keyboard, Mouse, Printer, and Scanner","hi":"मॉनिटर, कीबोर्ड, माउस, प्रिंटर और स्कैनर"},{"en":"Sender, Receiver, Message, Transmission Medium, and Protocol","hi":"सेंडर (Sender), रिसीवर (Receiver), मैसेज (Message), ट्रांसमिशन माध्यम (Transmission Medium) और प्रोटोकॉल (Protocol)"},{"en":"RAM, ROM, Cache, Register, and Hard Disk","hi":"रैम, रोम, कैश, रजिस्टर और हार्ड डिस्क"},{"en":"Word, Excel, PowerPoint, Access, and Outlook","hi":"वर्ड, एक्सेल, पावरपॉइंट, एक्सेस और आउटलुक"}],"exp":{"en":"A data communication system consists of five fundamental components: Sender, Receiver, Message, Transmission Medium, and Protocol.","hi":"डेटा संचार के पाँच मुख्य घटक हैं: सेंडर (प्रेषक), रिसीवर (प्राप्तकर्ता), मैसेज (संदेश), ट्रांसमिशन माध्यम (माध्यम) और प्रोटोकॉल (नियम)।"},"num":10},{"id":"q11","q":{"en":"In data communication, what do 'Message', 'Medium', and 'Protocol' respectively represent?","hi":"डेटा संचार में 'मैसेज' (Message), 'मीडियम' (Medium) और 'प्रोटोकॉल' (Protocol) क्रमशः क्या होते हैं?"},"a":{"en":"Message is the exchanged data/information, Medium is the physical/wireless path of the signal, and Protocol is the set of communication rules","hi":"मैसेज आदान-प्रदान किया जाने वाला डेटा है, मीडियम सिग्नल का पथ (path) है, और प्रोटोकॉल संचार के नियम (rules) हैं"},"o":[{"en":"Message is the exchanged data/information, Medium is the physical/wireless path of the signal, and Protocol is the set of communication rules","hi":"मैसेज आदान-प्रदान किया जाने वाला डेटा है, मीडियम सिग्नल का पथ (path) है, और प्रोटोकॉल संचार के नियम (rules) हैं"},{"en":"Message is the cable, Medium is the rulebook, and Protocol is the sender computer","hi":"मैसेज केबल है, मीडियम नियम पुस्तिका है, और प्रोटोकॉल प्रेषक कंप्यूटर है"},{"en":"All three terms refer exclusively to power supply units","hi":"तीनों शब्द केवल पावर सप्लाई यूनिट को दर्शाते हैं"},{"en":"Message is an antivirus, Medium is a firewall, and Protocol is acomputer virus","hi":"मैसेज एंटीवायरस है, मीडियम फ़ायरवॉल है, और प्रोटोकॉल कंप्यूटर वायरस है"}],"exp":{"en":"The Message is the data/information to be communicated, the Transmission Medium is the physical or wireless path over which the signal travels, and the Protocol is the set of rules governing the communication.","hi":"मैसेज आदान-प्रदान किया जाने वाला डेटा है, मीडियम सिग्नल के जाने का पथ (path) है, और प्रोटोकॉल डेटा संचार को नियंत्रित करने वाले नियमों का समूह है।"},"num":11},{"id":"q12","q":{"en":"Why is data converted into a 'Signal' before transmission?","hi":"डेटा को ट्रांसमिट (Transmit) करने के लिए सिग्नल में क्यों बदला जाता है?"},"a":{"en":"Because transmission media carry information in the form of electrical, optical, or radio/electromagnetic signals","hi":"क्योंकि ट्रांसमिशन माध्यम सूचना को इलेक्ट्रिकल, ऑप्टिकल या रेडियो सिग्नल के रूप में ले जाता है"},"o":[{"en":"Because transmission media carry information in the form of electrical, optical, or radio/electromagnetic signals","hi":"क्योंकि ट्रांसमिशन माध्यम सूचना को इलेक्ट्रिकल, ऑप्टिकल या रेडियो सिग्नल के रूप में ले जाता है"},{"en":"Because computers cannot store binary data in RAM","hi":"क्योंकि कंप्यूटर RAM में बाइनरी डेटा स्टोर नहीं कर सकते"},{"en":"To permanently erase the data from the sender's hard drive","hi":"प्रेषक की हार्ड ड्राइव से डेटा को स्थायी रूप से मिटाने के लिए"},{"en":"To reduce the physical weight of the computer monitor","hi":"कंप्यूटर मॉनिटर के भौतिक वजन को कम करने के लिए"}],"exp":{"en":"To travel across a transmission medium, raw data must be converted into electromagnetic signals—such as electrical voltages/currents on copper, light pulses on optical fiber, or radio waves in wireless media.","hi":"ट्रांसमिशन माध्यम सूचना को इलेक्ट्रिकल, ऑप्टिकल (प्रकाश) या रेडियो सिग्नल के रूप में वहन (carry) करता है, इसलिए डेटा को संचारित करने के लिए सिग्नल में बदला जाता है।"},"num":12},{"id":"q13","q":{"en":"What is the fundamental difference between 'Analog Data' and 'Digital Data'?","hi":"'एनालॉग डेटा' (Analog Data) और 'डिजिटल डेटा' (Digital Data) में बुनियादी अंतर क्या है?"},"a":{"en":"Analog data varies continuously (e.g., human voice, analog clock reading), whereas Digital data uses discrete values (e.g., digital clock, computer binary data)","hi":"एनालॉग डेटा निरंतर बदलता है (जैसे मानव आवाज़ या एनालॉग घड़ी), जबकि डिजिटल डेटा असतत मानों (discrete values) का उपयोग करता है (जैसे डिजिटल घड़ी और कंप्यूटर डेटा)"},"o":[{"en":"Analog data varies continuously (e.g., human voice, analog clock reading), whereas Digital data uses discrete values (e.g., digital clock, computer binary data)","hi":"एनालॉग डेटा निरंतर बदलता है (जैसे मानव आवाज़ या एनालॉग घड़ी), जबकि डिजिटल डेटा असतत मानों (discrete values) का उपयोग करता है (जैसे डिजिटल घड़ी और कंप्यूटर डेटा)"},{"en":"Analog data consists only of binary 0s and 1s, whereas Digital data is a continuous sine wave","hi":"एनालॉग डेटा में केवल बाइनरी 0 और 1 होते हैं, जबकि डिजिटल डेटा एक निरंतर साइन वेव है"},{"en":"Analog data can only be stored on SSDs, while Digital data cannot be stored on any medium","hi":"एनालॉग डेटा केवल SSD पर स्टोर हो सकता है, जबकि डिजिटल डेटा किसी माध्यम पर स्टोर नहीं हो सकता"},{"en":"There is no difference between analog and digital data","hi":"एनालॉग और डिजिटल डेटा में कोई अंतर नहीं है"}],"exp":{"en":"Analog data takes on continuous values over an interval (such as human voice or an analog clock with hands), while digital data takes on discrete states/values (such as a digital clock display or binary text/numbers in a computer).","hi":"एनालॉग डेटा निरंतर (continuously) बदलता है (जैसे मानव आवाज़ या एनालॉग घड़ी की सुइयाँ), जबकि डिजिटल डेटा असतत मानों (discrete values) का उपयोग करता है (जैसे डिजिटल घड़ी या कंप्यूटर डेटा)।"},"num":13},{"id":"q14","q":{"en":"How can you distinguish between an 'Analog Signal' and a 'Digital Signal' in a waveform diagram?","hi":"सिग्नल आरेख (Waveform Diagram) में एनालॉग और डिजिटल सिग्नल को कैसे पहचानेंगे?"},"a":{"en":"An analog waveform changes smoothly and continuously over time, whereas a typical digital waveform switches between discrete voltage/signal levels","hi":"एनालॉग वेवफॉर्म निरंतर (continuously) बदलती है, जबकि विशिष्ट डिजिटल वेवफॉर्म निश्चित असतत स्तरों (discrete levels) के बीच स्विच करती है"},"o":[{"en":"An analog waveform changes smoothly and continuously over time, whereas a typical digital waveform switches between discrete voltage/signal levels","hi":"एनालॉग वेवफॉर्म निरंतर (continuously) बदलती है, जबकि विशिष्ट डिजिटल वेवफॉर्म निश्चित असतत स्तरों (discrete levels) के बीच स्विच करती है"},{"en":"An analog waveform is always a flat horizontal zero line, whereas a digital waveform is a circle","hi":"एनालॉग वेवफॉर्म हमेशा एक सीधी क्षैतिज रेखा होती है, जबकि डिजिटल वेवफॉर्म एक वृत्त होता है"},{"en":"An analog waveform has only two fixed square levels, whereas a digital waveform is a smooth sine wave","hi":"एनालॉग वेवफॉर्म में केवल दो निश्चित वर्गाकार स्तर होते हैं, जबकि डिजिटल वेवफॉर्म एक स्मूथ साइन वेव होती है"},{"en":"Waveform diagrams cannot represent digital signals","hi":"वेवफॉर्म आरेख डिजिटल सिग्नल को प्रदर्शित नहीं कर सकते"}],"exp":{"en":"In a signal diagram, an analog signal is represented by a smoothly and continuously varying waveform (like a sine wave), whereas a digital signal is represented by square pulses switching between discrete levels (e.g., high/low representing 1 and 0).","hi":"आरेख (diagram) में एनालॉग वेवफॉर्म निरंतर व सुचारू रूप से बदलती है, जबकि डिजिटल वेवफॉर्म असतत स्तरों (discrete levels, जैसे 0 और 1) के बीच स्विच करती है।"},"num":14},{"id":"q15","q":{"en":"What are a 'Computer Network' and a 'Node'?","hi":"'कंप्यूटर नेटवर्क' (Computer Network) और 'नोड' (Node) क्या होते हैं?"},"a":{"en":"A network is a group of connected devices that share data and resources, and each participating device or connection point is a node","hi":"नेटवर्क जुड़े हुए उपकरणों का समूह है जो डेटा और संसाधन साझा करते हैं, और प्रत्येक सहभागी उपकरण या कनेक्शन बिंदु एक 'नोड' हो सकता है"},"o":[{"en":"A network is a single isolated calculator, and a node is a paper notebook","hi":"नेटवर्क एक अकेला कैलकुलेटर है, और नोड एक कागज़ की नोटबुक है"},{"en":"A network is a group of connected devices that share data and resources, and each participating device or connection point is a node","hi":"नेटवर्क जुड़े हुए उपकरणों का समूह है जो डेटा और संसाधन साझा करते हैं, और प्रत्येक सहभागी उपकरण या कनेक्शन बिंदु एक 'नोड' हो सकता है"},{"en":"A network is a type of computer virus, and a node is anrupted file","hi":"नेटवर्क एक प्रकार का कंप्यूटर वायरस है, और नोड एक खराब फ़ाइल है"},{"en":"A network is a cooling fan, and a node is a power plug","hi":"नेटवर्क एक कूलिंग फैन है, और नोड एक पावर प्लग है"}],"exp":{"en":"A computer network is a collection of interconnected devices capable of exchanging data and sharing resources; any participating device or connection point (computer, printer, switch, router) on the network is called a node.","hi":"नेटवर्क आपस में जुड़े उपकरणों का समूह है जो डेटा और संसाधन (resources) साझा करते हैं, तथा नेटवर्क में भाग लेने वाला प्रत्येक उपकरण या कनेक्शन पॉइंट एक 'नोड' (node) कहलाता है।"},"num":15},{"id":"q16","q":{"en":"Which types of transmission media can network links use to connect nodes?","hi":"नेटवर्क लिंक नोड्स को जोड़ने के लिए किस प्रकार के ट्रांसमिशन मीडिया का उपयोग कर सकते हैं?"},"a":{"en":"Both wired cables (such as copper or optical fibre) and wireless media (such as radio waves)","hi":"वायर्ड केबल (जैसे कॉपर या ऑप्टिकल फाइबर) और वायरलेस मीडिया (जैसे रेडियो तरंगें) दोनों"},"o":[{"en":"Only wooden rods and cotton threads","hi":"केवल लकड़ी की छड़ें और सूती धागे"},{"en":"Both wired cables (such as copper or optical fibre) and wireless media (such as radio waves)","hi":"वायर्ड केबल (जैसे कॉपर या ऑप्टिकल फाइबर) और वायरलेस मीडिया (जैसे रेडियो तरंगें) दोनों"},{"en":"Only water pipes and steam tubes","hi":"केवल पानी के पाइप और भाप की नलियाँ"},{"en":"Neither wired nor wireless media","hi":"न तो वायर्ड और न ही वायरलेस मीडिया"}],"exp":{"en":"Network links can use guided/wired media (such as twisted-pair copper cables, coaxial cables, or optical fibres) as well as unguided/wireless media (such as radio waves, microwaves, or infrared).","hi":"नेटवर्क लिंक डेटा संचारित करने के लिए वायर्ड केबल (जैसे तांबा/कॉपर या ऑप्टिकल फाइबर) और वायरलेस मीडिया (जैसे रेडियो तरंगें) दोनों का उपयोग कर सकते हैं।"},"num":16}]},{"title":{"en":"2. Types of Networks","hi":"2. नेटवर्क के प्रकार"},"questions":[{"id":"q17","q":{"en":"Which seven network types are covered in this chapter based on coverage, purpose, and implementation?","hi":"कवरेज, उद्देश्य और कार्यान्वयन (implementation) के आधार पर इस अध्याय में कौन-से सात नेटवर्क प्रकार शामिल हैं?"},"a":{"en":"LAN, MAN, WAN, PAN, CAN, SAN, and VPN","hi":"LAN, MAN, WAN, PAN, CAN, SAN और VPN"},"o":[{"en":"LAN, MAN, WAN, PAN, CAN, SAN, and VPN","hi":"LAN, MAN, WAN, PAN, CAN, SAN और VPN"},{"en":"RAM, ROM, PROM, EPROM, EEPROM, SRAM, and DRAM","hi":"RAM, ROM, PROM, EPROM, EEPROM, SRAM और DRAM"},{"en":"CPU, ALU, CU, GPU, PSU, UPS, and NIC","hi":"CPU, ALU, CU, GPU, PSU, UPS और NIC"},{"en":"HTTP, FTP, SMTP, POP3, IMAP, DNS, and DHCP","hi":"HTTP, FTP, SMTP, POP3, IMAP, DNS और DHCP"}],"exp":{"en":"The chapter covers seven primary network classifications—LAN, MAN, WAN, PAN, CAN, SAN, and VPN—categorized by geographical scale, specific purpose, or logical implementation.","hi":"इस अध्याय में कवरेज, उद्देश्य और कार्यान्वयन के आधार पर सात प्रकार के नेटवर्क शामिल हैं: LAN, MAN, WAN, PAN, CAN, SAN और VPN।"},"num":17},{"id":"q18","q":{"en":"What is the full form of 'LAN' and what is its typical geographical coverage?","hi":"'LAN' का पूर्ण रूप (Full Form) और इसका सामान्य कवरेज क्षेत्र क्या है?"},"a":{"en":"Local Area Network — covers a limited area such as a home, school lab, or office building","hi":"लोकल एरिया नेटवर्क — घर, स्कूल लैब या ऑफिस बिल्डिंग जैसा सीमित क्षेत्र"},"o":[{"en":"Large Area Network — spans across multiple continents","hi":"लार्ज एरिया नेटवर्क — कई महाद्वीपों में फैला हुआ"},{"en":"Local Area Network — covers a limited area such as a home, school lab, or office building","hi":"लोकल एरिया नेटवर्क — घर, स्कूल लैब या ऑफिस बिल्डिंग जैसा सीमित क्षेत्र"},{"en":"Logical Analog Network — used only for analog radio broadcasting","hi":"लॉजिकल एनालॉग नेटवर्क — केवल एनालॉग रेडियो प्रसारण के लिए प्रयुक्त"},{"en":"Long Antenna Network — used for deep-space satellite communication","hi":"लॉन्ग एंटीना नेटवर्क — गहरे अंतरिक्ष उपग्रह संचार के लिए प्रयुक्त"}],"exp":{"en":"LAN stands for Local Area Network and privately connects devices within a limited local area such as a residence, school computer lab, or single office building.","hi":"LAN का पूर्ण रूप Local Area Network है। यह घर, स्कूल लैब या किसी ऑफिस बिल्डिंग जैसे सीमित भौगोलिक क्षेत्र (limited area) को कवर करता है।"},"num":18},{"id":"q19","q":{"en":"What is the most common technology example of a wired LAN (with Bus being one of its possible topologies)?","hi":"वायर्ड LAN का सबसे सामान्य तकनीकी उदाहरण क्या है (जिसमें Bus एक संभावित टोपोलॉजी है)?"},"a":{"en":"Ethernet","hi":"ईथरनेट (Ethernet)"},"o":[{"en":"Ethernet","hi":"ईथरनेट (Ethernet)"},{"en":"Bluetooth Earbuds","hi":"ब्लूटूथ ईयरबड्स"},{"en":"Geostationary Satellite Link","hi":"भू-स्थिर उपग्रह लिंक"},{"en":"Morse Code Telegraph","hi":"मोर्स कोड टेलीग्राफ"}],"exp":{"en":"Ethernet (IEEE 802.3) is the most widely used wired LAN technology, historically using a bus topology and modernly using star/switched topologies.","hi":"ईथरनेट (Ethernet) वायर्ड LAN का सबसे सामान्य उदाहरण है (और Bus इसकी संभावित टोपोलॉजी में से एक है)।"},"num":19},{"id":"q20","q":{"en":"What is the full form of 'MAN', its typical coverage area, and a standard textbook example?","hi":"'MAN' का पूर्ण रूप, इसका सामान्य कवरेज क्षेत्र और मानक उदाहरण क्या है?"},"a":{"en":"Metropolitan Area Network — covers a city or metro area; example: city cable-TV distribution network","hi":"मेट्रोपॉलिटन एरिया नेटवर्क — एक शहर या मेट्रो क्षेत्र; उदाहरण: शहर का केबल-टीवी वितरण नेटवर्क"},"o":[{"en":"Micro Area Network — covers a single desk; example: USB mouse","hi":"माइक्रो एरिया नेटवर्क — एक डेस्क कवर करता है; उदाहरण: USB माउस"},{"en":"Metropolitan Area Network — covers a city or metro area; example: city cable-TV distribution network","hi":"मेट्रोपॉलिटन एरिया नेटवर्क — एक शहर या मेट्रो क्षेत्र; उदाहरण: शहर का केबल-टीवी वितरण नेटवर्क"},{"en":"Master Analog Network — covers the entire solar system; example: Voyager probe","hi":"मास्टर एनालॉग नेटवर्क — पूरे सौर मंडल को कवर करता है; उदाहरण: वॉयजर प्रोब"},{"en":"Manual Arithmetic Network — covers an abacus frame","hi":"मैनुअल अरिथमेटिक नेटवर्क — अबेकस फ्रेम को कवर करता है"}],"exp":{"en":"MAN stands for Metropolitan Area Network; it spans a city or metropolitan region (larger than a LAN, smaller than a WAN), with a city-wide cable-TV network being a classic textbook example.","hi":"MAN का पूर्ण रूप Metropolitan Area Network है। यह एक पूरे शहर या महानगर (metro area) को कवर करता है; शहर का केबल-टीवी नेटवर्क इसका प्रमुख उदाहरण है।"},"num":20},{"id":"q21","q":{"en":"What is the full form of 'WAN' and what is its typical geographical coverage?","hi":"'WAN' का पूर्ण रूप (Full Form) और इसका सामान्य कवरेज क्षेत्र क्या है?"},"a":{"en":"Wide Area Network — spans a large geographical area such as states, countries, or continents","hi":"वाइड एरिया नेटवर्क — राज्य, देश या महाद्वीप जैसा विशाल भौगोलिक क्षेत्र"},"o":[{"en":"Wide Area Network — spans a large geographical area such as states, countries, or continents","hi":"वाइड एरिया नेटवर्क — राज्य, देश या महाद्वीप जैसा विशाल भौगोलिक क्षेत्र"},{"en":"Wireless Audio Network — covers a 2-meter radius around a speaker","hi":"वायरलेस ऑडियो नेटवर्क — स्पीकर के चारों ओर 2-मीटर का दायरा"},{"en":"Word Application Network — used only inside MS Word","hi":"वर्ड एप्लिकेशन नेटवर्क — केवल MS Word के अंदर उपयोग किया जाता है"},{"en":"Web Antivirus Network — used only for scanning pendrives","hi":"वेब एंटीवायरस नेटवर्क — केवल पेनड्राइव स्कैन करने के लिए"}],"exp":{"en":"WAN stands for Wide Area Network, which provides data transmission across a vast geographical area such as states, countries, or continents.","hi":"WAN का पूर्ण रूप Wide Area Network है। यह राज्यों, देशों या महाद्वीपों जैसे विशाल भौगोलिक क्षेत्र (large geographical area) को कवर करता है।"},"num":21},{"id":"q22","q":{"en":"How is the 'Internet' remembered in the context of WAN in standard textbooks?","hi":"मानक पाठ्यपुस्तकों में WAN के संदर्भ में 'इंटरनेट' (Internet) को किस रूप में याद रखा जाता है?"},"a":{"en":"As a global system of interconnected networks and the largest example of a WAN","hi":"वैश्विक स्तर पर जुड़े नेटवर्कों के उदाहरण और सबसे बड़े WAN (Wide Area Network) के उदाहरण के रूप में"},"o":[{"en":"As the smallest Personal Area Network limited to 1 meter","hi":"1 मीटर तक सीमित सबसे छोटे पर्सनल एरिया नेटवर्क के रूप में"},{"en":"As a global system of interconnected networks and the largest example of a WAN","hi":"वैश्विक स्तर पर जुड़े नेटवर्कों के उदाहरण और सबसे बड़े WAN (Wide Area Network) के उदाहरण के रूप में"},{"en":"As a single offline desktop computer without a network card","hi":"बिना नेटवर्क कार्ड वाले एक अकेले ऑफलाइन डेस्कटॉप कंप्यूटर के रूप में"},{"en":"As a purely mechanical calculating device from the 17th century","hi":"17वीं सदी के एक विशुद्ध यांत्रिक गणना उपकरण के रूप में"}],"exp":{"en":"The Internet is a global network of interconnected networks and is cited in textbooks as the world's largest Wide Area Network (WAN).","hi":"इंटरनेट वैश्विक स्तर पर आपस में जुड़े नेटवर्कों (global interconnected networks) का उदाहरण है, और पाठ्यपुस्तकों में इसे सबसे बड़े WAN के उदाहरण के रूप में माना जाता है।"},"num":22},{"id":"q23","q":{"en":"What is the correct ascending order of geographical coverage for LAN, MAN, and WAN?","hi":"भौगोलिक कवरेज के बढ़ते क्रम (छोटे से बड़े) में LAN, MAN और WAN का सही अनुक्रम क्या है?"},"a":{"en":"LAN → MAN → WAN (from local to city-wide to wide-area)","hi":"LAN → MAN → WAN (लोकल से शहर-व्यापी से विस्तृत क्षेत्र तक)"},"o":[{"en":"WAN → MAN → LAN","hi":"WAN → MAN → LAN"},{"en":"MAN → WAN → LAN","hi":"MAN → WAN → LAN"},{"en":"LAN → MAN → WAN (from local to city-wide to wide-area)","hi":"LAN → MAN → WAN (लोकल से शहर-व्यापी से विस्तृत क्षेत्र तक)"},{"en":"LAN → WAN → MAN","hi":"LAN → WAN → MAN"}],"exp":{"en":"In terms of geographical scale from smallest to largest, the order is: LAN (local building/site) → MAN (city/metro) → WAN (country/global).","hi":"कवरेज क्षेत्र के बढ़ते क्रम में सही अनुक्रम है: LAN (लोकल) → MAN (शहर/मेट्रो) → WAN (विस्तृत भौगोलिक क्षेत्र)।"},"num":23},{"id":"q24","q":{"en":"What is the full form of 'PAN' and what is its typical use and textbook range?","hi":"'PAN' का पूर्ण रूप, इसका सामान्य उपयोग और पाठ्यपुस्तक में दी गई सामान्य रेंज क्या है?"},"a":{"en":"Personal Area Network — short-range network around one user's devices (phone, laptop, earbuds, wearable, printer), typically around 10 m / 30 ft","hi":"पर्सनल एरिया नेटवर्क — एक उपयोगकर्ता के फोन, लैपटॉप, ईयरबड्स, वियरेबल या प्रिंटर के आसपास का शॉर्ट-रेंज नेटवर्क (लगभग 10 मीटर / 30 फीट)"},"o":[{"en":"Public Area Network — connects cities across 500 km","hi":"पब्लिक एरिया नेटवर्क — 500 किमी में शहरों को जोड़ता है"},{"en":"Personal Area Network — short-range network around one user's devices (phone, laptop, earbuds, wearable, printer), typically around 10 m / 30 ft","hi":"पर्सनल एरिया नेटवर्क — एक उपयोगकर्ता के फोन, लैपटॉप, ईयरबड्स, वियरेबल या प्रिंटर के आसपास का शॉर्ट-रेंज नेटवर्क (लगभग 10 मीटर / 30 फीट)"},{"en":"Permanent Analog Network — connects undersea continental cables","hi":"परमानेंट एनालॉग नेटवर्क — समुद्र के नीचे महाद्वीपीय केबलों को जोड़ता है"},{"en":"Parallel Array Network — used only inside nuclear supercomputers","hi":"पैरेलल ऐरे नेटवर्क — केवल परमाणु सुपर कंप्यूटरों के अंदर प्रयुक्त"}],"exp":{"en":"PAN stands for Personal Area Network, a short-range network (typically around 10 meters or 30 feet in textbook examples, depending on technology like Bluetooth/USB) connecting personal devices around an individual.","hi":"PAN का पूर्ण रूप Personal Area Network है। यह एक उपयोगकर्ता के फोन, लैपटॉप, ईयरबड्स, स्मार्टवॉच या प्रिंटर के आसपास का शॉर्ट-रेंज नेटवर्क है (जिसकी सामान्य पाठ्यपुस्तक रेंज लगभग 10 मीटर / 30 फीट होती है)।"},"num":24},{"id":"q25","q":{"en":"What is the full form and primary use of 'CAN' in computer networking?","hi":"कंप्यूटर नेटवर्किंग में 'CAN' का पूर्ण रूप और मुख्य उपयोग क्या है?"},"a":{"en":"Campus Area Network — interconnects multiple LANs within a school, university, or corporate campus","hi":"कैंपस एरिया नेटवर्क — किसी स्कूल, विश्वविद्यालय या कॉर्पोरेट परिसर (campus) के कई LANs को आपस में जोड़ता है"},"o":[{"en":"Campus Area Network — interconnects multiple LANs within a school, university, or corporate campus","hi":"कैंपस एरिया नेटवर्क — किसी स्कूल, विश्वविद्यालय या कॉर्पोरेट परिसर (campus) के कई LANs को आपस में जोड़ता है"},{"en":"Central Abacus Network — used for manual bead counting","hi":"सेंट्रल अबेकस नेटवर्क — मैनुअल मनका गिनती के लिए प्रयुक्त"},{"en":"Continental Air Network — connects airplanes across oceans","hi":"कॉन्टिनेंटल एयर नेटवर्क — महासागरों के पार हवाई जहाजों को जोड़ता है"},{"en":"Compact Audio Network — used only for FM radio stations","hi":"कॉम्पैक्ट ऑडियो नेटवर्क — केवल FM रेडियो स्टेशनों के लिए प्रयुक्त"}],"exp":{"en":"CAN stands for Campus Area Network, which links multiple Local Area Networks (LANs) across buildings within a contiguous school, university, military, or corporate campus.","hi":"CAN का पूर्ण रूप Campus Area Network है। यह किसी स्कूल, यूनिवर्सिटी या कॉर्पोरेट कैंपस के कई LANs को आपस में जोड़ता है।"},"num":25},{"id":"q26","q":{"en":"What is the full form of 'SAN' and what is its defining feature?","hi":"'SAN' का पूर्ण रूप (Full Form) और इसकी मुख्य विशेषता क्या है?"},"a":{"en":"Storage Area Network — a specialized high-speed network that provides servers with block-level access to consolidated storage","hi":"स्टोरेज एरिया नेटवर्क — एक विशेष हाई-स्पीड नेटवर्क जो सर्वरों को ब्लॉक-लेवल स्टोरेज एक्सेस प्रदान करता है"},"o":[{"en":"Simple Analog Network — carries analog voice over copper telephone wires","hi":"सिंपल एनालॉग नेटवर्क — तांबे के टेलीफोन तारों पर एनालॉग आवाज़ ले जाता है"},{"en":"Storage Area Network — a specialized high-speed network that provides servers with block-level access to consolidated storage","hi":"स्टोरेज एरिया नेटवर्क — एक विशेष हाई-स्पीड नेटवर्क जो सर्वरों को ब्लॉक-लेवल स्टोरेज एक्सेस प्रदान करता है"},{"en":"Small Apartment Network — a Wi-Fi router inside a bedroom","hi":"स्मॉल अपार्टमेंट नेटवर्क — बेडरूम के अंदर एक वाई-फाई राउटर"},{"en":"Social Application Network — a website for sharing photos","hi":"सोशल एप्लिकेशन नेटवर्क — फोटो साझा करने की एक वेबसाइट"}],"exp":{"en":"SAN stands for Storage Area Network; it is a dedicated, high-speed network that interconnects pools of storage devices with multiple servers, providing block-level storage access.","hi":"SAN का पूर्ण रूप Storage Area Network है। यह एक विशेष हाई-स्पीड नेटवर्क है जो सर्वरों को ब्लॉक-लेवल स्टोरेज एक्सेस (block-level storage access) प्रदान करता है।"},"num":26},{"id":"q27","q":{"en":"What is the full form of 'VPN' and what role does it perform?","hi":"'VPN' का पूर्ण रूप क्या है और यह क्या कार्य करता है?"},"a":{"en":"Virtual Private Network — establishes private connectivity over a public/shared network (like the Internet) using tunneling and encryption","hi":"वर्चुअल प्राइवेट नेटवर्क — पब्लिक/साझा नेटवर्क के ऊपर सुरक्षित प्राइवेट कनेक्टिविटी स्थापित करता है (जैसे कर्मचारी द्वारा कंपनी नेटवर्क का एक्सेस) और ट्रैफिक को टनल व एन्क्रिप्ट करता है"},"o":[{"en":"Virtual Private Network — establishes private connectivity over a public/shared network (like the Internet) using tunneling and encryption","hi":"वर्चुअल प्राइवेट नेटवर्क — पब्लिक/साझा नेटवर्क के ऊपर सुरक्षित प्राइवेट कनेक्टिविटी स्थापित करता है (जैसे कर्मचारी द्वारा कंपनी नेटवर्क का एक्सेस) और ट्रैफिक को टनल व एन्क्रिप्ट करता है"},{"en":"Visual Printing Network — connects 3D printers without electricity","hi":"विजुअल प्रिंटिंग नेटवर्क — बिना बिजली के 3D प्रिंटर जोड़ता है"},{"en":"Volatile Processor Network — erases RAM data when power is turned off","hi":"वोलेटाइल प्रोसेसर नेटवर्क — बिजली बंद होने पर RAM डेटा मिटा देता है"},{"en":"Voice Paging Network — used only for one-way hospital loudspeaker announcements","hi":"वॉयस पेजिंग नेटवर्क — केवल एकतरफा अस्पताल लाउडस्पीकर घोषणाओं के लिए"}],"exp":{"en":"VPN stands for Virtual Private Network; it extends a private network across a public/shared network (such as an employee remotely accessing a company intranet), typically encrypting and tunneling traffic for security.","hi":"VPN का पूर्ण रूप Virtual Private Network है। यह किसी पब्लिक या साझा नेटवर्क (जैसे इंटरनेट) के ऊपर सुरक्षित प्राइवेट कनेक्टिविटी स्थापित करता है और ट्रैफिक को टनल तथा एन्क्रिप्ट कर सकता है।"},"num":27},{"id":"q28","q":{"en":"On what primary basis are 'SAN' and 'VPN' respectively identified/classified?","hi":"'SAN' और 'VPN' को क्रमशः किस मुख्य आधार पर पहचाना जाता है?"},"a":{"en":"SAN by the purpose of high-speed storage access; VPN by the mechanism of establishing private connectivity over a shared network","hi":"SAN को स्टोरेज एक्सेस के उद्देश्य (purpose) से; और VPN को प्राइवेट कनेक्टिविटी के तंत्र (mechanism) से"},"o":[{"en":"SAN by the purpose of high-speed storage access; VPN by the mechanism of establishing private connectivity over a shared network","hi":"SAN को स्टोरेज एक्सेस के उद्देश्य (purpose) से; और VPN को प्राइवेट कनेक्टिविटी के तंत्र (mechanism) से"},{"en":"Both are classified strictly by continental geographical size","hi":"दोनों को केवल महाद्वीपीय भौगोलिक आकार के आधार पर वर्गीकृत किया जाता है"},{"en":"SAN is a wireless headphone protocol; VPN is a physical copper cable","hi":"SAN एक वायरलेस हेडफ़ोन प्रोटोकॉल है; VPN एक भौतिक तांबे की केबल है"},{"en":"SAN is an operating system; VPN is a web browser","hi":"SAN एक ऑपरेटिंग सिस्टम है; VPN एक वेब ब्राउज़र है"}],"exp":{"en":"Unlike LAN/MAN/WAN (which are classified by geographical area), SAN is identified by its specific purpose (storage access), while VPN is identified by its implementation mechanism (virtualized private connectivity).","hi":"SAN की पहचान स्टोरेज एक्सेस के उद्देश्य (purpose) से होती है, जबकि VPN की पहचान साझा नेटवर्क पर प्राइवेट कनेक्टिविटी स्थापित करने के तंत्र (mechanism) से होती है।"},"num":28}]},{"title":{"en":"3. Connections, Duplex Modes & Voice Services","hi":"3. कनेक्शन, डुप्लेक्स मोड और वॉयस सेवाएँ"},"questions":[{"id":"q29","q":{"en":"What is a 'Point-to-Point Connection' in networking?","hi":"नेटवर्किंग में 'पॉइंट-टू-पॉइंट कनेक्शन' (Point-to-Point Connection) क्या है?"},"a":{"en":"A dedicated communication link between exactly two devices","hi":"दो उपकरणों (devices) के बीच एक समर्पित (dedicated) लिंक"},"o":[{"en":"A single link shared simultaneously by hundreds of computers","hi":"सैकड़ों कंप्यूटरों द्वारा एक साथ साझा किया जाने वाला एकल लिंक"},{"en":"A dedicated communication link between exactly two devices","hi":"दो उपकरणों (devices) के बीच एक समर्पित (dedicated) लिंक"},{"en":"A wireless broadcast tower transmitting TV signals to an entire city","hi":"पूरे शहर में टीवी सिग्नल प्रसारित करने वाला एक वायरलेस ब्रॉडकास्ट टावर"},{"en":"An offline computer not connected to any cable or wireless link","hi":"एक ऑफलाइन कंप्यूटर जो किसी केबल या वायरलेस लिंक से नहीं जुड़ा है"}],"exp":{"en":"A point-to-point connection provides a dedicated link between two endpoints/devices, reserving the entire capacity of the channel for transmission between those two devices.","hi":"दो उपकरणों (devices) के बीच समर्पित संपर्क लिंक (dedicated link) को पॉइंट-टू-पॉइंट कनेक्शन कहा जाता है।"},"num":29},{"id":"q30","q":{"en":"What is a 'Multipoint (Multidrop) Connection'?","hi":"'मल्टीपॉइंट कनेक्शन' (Multipoint Connection) क्या है?"},"a":{"en":"A connection in which more than two devices share a single link","hi":"एक ऐसा कनेक्शन जिसमें एक ही लिंक को दो से अधिक उपकरण (devices) साझा करते हैं"},"o":[{"en":"A connection in which more than two devices share a single link","hi":"एक ऐसा कनेक्शन जिसमें एक ही लिंक को दो से अधिक उपकरण (devices) साझा करते हैं"},{"en":"A private link between just one keyboard and one CPU","hi":"केवल एक कीबोर्ड और एक CPU के बीच का निजी लिंक"},{"en":"Connecting two monitors to the same power socket without a data cable","hi":"बिना डेटा केबल के दो मॉनिटरों को एक ही पावर सॉकेट से जोड़ना"},{"en":"A dedicated fiber-optic cable between two routers only","hi":"केवल दो राउटरों के बीच एक समर्पित फाइबर-ऑप्टिक केबल"}],"exp":{"en":"In a multipoint (also called multidrop) connection, three or more devices share the capacity of a single transmission link.","hi":"मल्टीपॉइंट कनेक्शन में एक ही ट्रांसमिशन लिंक को दो से अधिक उपकरण (more than two devices) आपस में साझा (share) करते हैं।"},"num":30},{"id":"q31","q":{"en":"What is 'Simplex Communication' and what is its classic broadcast example?","hi":"'सिम्प्लेक्स संचार' (Simplex Communication) क्या है और इसका प्रमुख प्रसारण उदाहरण क्या है?"},"a":{"en":"Unidirectional communication where data flows in only one direction, such as TV broadcasting from a transmitter to a viewer","hi":"एकदिशीय संचार जिसमें डेटा केवल एक ही दिशा में जाता है, जैसे ट्रांसमीटर से दर्शक (viewer) तक टीवी प्रसारण"},"o":[{"en":"Unidirectional communication where data flows in only one direction, such as TV broadcasting from a transmitter to a viewer","hi":"एकदिशीय संचार जिसमें डेटा केवल एक ही दिशा में जाता है, जैसे ट्रांसमीटर से दर्शक (viewer) तक टीवी प्रसारण"},{"en":"Bidirectional communication where both parties talk at the exact same instant, like a telephone call","hi":"द्विदिशीय संचार जहाँ दोनों पक्ष एक ही समय में बात करते हैं, जैसे टेलीफोन कॉल"},{"en":"Two-way turn-by-turn communication like a walkie-talkie","hi":"वॉकी-टॉकी की तरह बारी-बारी से होने वाला दोतरफा संचार"},{"en":"High-speed block storage access between servers","hi":"सर्वरों के बीच हाई-स्पीड ब्लॉक स्टोरेज एक्सेस"}],"exp":{"en":"In simplex mode, communication is unidirectional (one-way only); only one device can transmit and the other can only receive, such as traditional TV or FM radio broadcasting.","hi":"सिम्प्लेक्स मोड में डेटा केवल एक ही दिशा (one direction) में प्रवाहित होता है, जैसे टीवी ट्रांसमीटर से दर्शक के टीवी सेट तक प्रसारण।"},"num":31},{"id":"q32","q":{"en":"In what sense are a 'Keyboard' and a 'Speaker' cited as examples of simplex communication?","hi":"'कीबोर्ड' और 'स्पीकर' किस अर्थ में सिम्प्लेक्स (Simplex) संचार के उदाहरण माने जाते हैं?"},"a":{"en":"Because in basic user-data flow, input travels in one direction from keyboard to computer, and audio output travels in one direction from computer to speaker","hi":"क्योंकि बेसिक यूजर-डेटा प्रवाह में कीबोर्ड से कंप्यूटर को इनपुट, और कंप्यूटर से स्पीकर को ऑडियो आउटपुट एक ही दिशा में जाता है"},"o":[{"en":"Because in basic user-data flow, input travels in one direction from keyboard to computer, and audio output travels in one direction from computer to speaker","hi":"क्योंकि बेसिक यूजर-डेटा प्रवाह में कीबोर्ड से कंप्यूटर को इनपुट, और कंप्यूटर से स्पीकर को ऑडियो आउटपुट एक ही दिशा में जाता है"},{"en":"Because a keyboard can print paper and a speaker can scan documents","hi":"क्योंकि कीबोर्ड कागज प्रिंट कर सकता है और स्पीकर दस्तावेज़ स्कैन कर सकता है"},{"en":"Because both devices transmit and receive user voice simultaneously","hi":"क्योंकि दोनों उपकरण एक साथ उपयोगकर्ता की आवाज़ भेजते और प्राप्त करते हैं"},{"en":"Because neither device requires a computer to function","hi":"क्योंकि किसी भी उपकरण को काम करने के लिए कंप्यूटर की आवश्यकता नहीं होती है"}],"exp":{"en":"From the perspective of basic user-data flow, a keyboard only sends inputstrokes to the computer and a speaker only receives audio output from the computer, illustrating one-way (simplex) flow.","hi":"बेसिक यूजर-डेटा प्रवाह के संदर्भ में कीबोर्ड से कंप्यूटर की ओर इनपुट, और कंप्यूटर से स्पीकर की ओर ऑडियो आउटपुट केवल एक दिशा में जाता है, इसलिए इन्हें सिम्प्लेक्स उदाहरण माना जाता है।"},"num":32},{"id":"q33","q":{"en":"What is 'Half-Duplex Communication' and what is its standard example?","hi":"'हाफ-डुप्लेक्स संचार' (Half-Duplex Communication) क्या है और इसका मानक उदाहरण क्या है?"},"a":{"en":"Communication is possible in both directions, but only one direction can be active at a time; example: Walkie-talkie","hi":"दोनों दिशाओं में संचार संभव है, पर एक समय पर केवल एक ही दिशा सक्रिय होती है; उदाहरण: वॉकी-टॉकी (Walkie-talkie)"},"o":[{"en":"Data flows in only one direction forever, like a television broadcast","hi":"डेटा हमेशा केवल एक ही दिशा में बहता है, जैसे टेलीविजन प्रसारण"},{"en":"Communication is possible in both directions, but only one direction can be active at a time; example: Walkie-talkie","hi":"दोनों दिशाओं में संचार संभव है, पर एक समय पर केवल एक ही दिशा सक्रिय होती है; उदाहरण: वॉकी-टॉकी (Walkie-talkie)"},{"en":"Both endpoints transmit and receive simultaneously at the same instant, like a telephone call","hi":"दोनों छोर एक ही समय पर एक साथ डेटा भेजते और प्राप्त करते हैं, जैसे टेलीफोन कॉल"},{"en":"No data can be transmitted in either direction","hi":"किसी भी दिशा में कोई डेटा ट्रांसमिट नहीं किया जा सकता"}],"exp":{"en":"In half-duplex mode, each station can both transmit and receive, but not at the same time; when one device is sending, the other can only receive, as seen in walkie-talkies (push-to-talk radios).","hi":"हाफ-डुप्लेक्स संचार में दोनों दिशाओं में डेटा भेजना संभव है, परंतु एक समय पर केवल एक ही दिशा सक्रिय रहती है (बारी-बारी से)। वॉकी-टॉकी (Walkie-talkie) इसका प्रमुख उदाहरण है।"},"num":33},{"id":"q34","q":{"en":"What is 'Full-Duplex Communication' and what are its standard examples?","hi":"'फुल-डुप्लेक्स संचार' (Full-Duplex Communication) क्या है और इसके मानक उदाहरण क्या हैं?"},"a":{"en":"Both endpoints can send and receive data simultaneously at the same time; examples: Telephone call and full-duplex switched Ethernet","hi":"दोनों छोर एक ही समय पर एक साथ डेटा भेज और प्राप्त कर सकते हैं; उदाहरण: टेलीफोन कॉल या फुल-डुप्लेक्स स्विच्ड ईथरनेट"},"o":[{"en":"Both endpoints can send and receive data simultaneously at the same time; examples: Telephone call and full-duplex switched Ethernet","hi":"दोनों छोर एक ही समय पर एक साथ डेटा भेज और प्राप्त कर सकते हैं; उदाहरण: टेलीफोन कॉल या फुल-डुप्लेक्स स्विच्ड ईथरनेट"},{"en":"Only one station can ever transmit data, like a radio tower","hi":"रेडियो टावर की तरह केवल एक ही स्टेशन डेटा भेज सकता है"},{"en":"Stations must wait for a 10-minute turn before replying","hi":"उत्तर देने से पहले स्टेशनों को 10 मिनट की बारी का इंतजार करना पड़ता है"},{"en":"Data is carried physically by postal mail vans","hi":"डेटा को डाक वैन द्वारा भौतिक रूप से ले जाया जाता है"}],"exp":{"en":"In full-duplex mode, both stations can transmit and receive data simultaneously at the very same time, such as during a telephone conversation or over full-duplex switched Ethernet links.","hi":"फुल-डुप्लेक्स मोड में दोनों छोर (endpoints) एक ही समय पर एक साथ डेटा भेज (send) और प्राप्त (receive) कर सकते हैं। टेलीफोन कॉल और फुल-डुप्लेक्स स्विच्ड ईथरनेट इसके उदाहरण हैं।"},"num":34},{"id":"q35","q":{"en":"How do you distinguish between Simplex, Half-Duplex, and Full-Duplex in schematic diagrams?","hi":"आरेखों (Diagrams) में सिम्प्लेक्स, हाफ-डुप्लेक्स और फुल-डुप्लेक्स को कैसे पहचाना जाता है?"},"a":{"en":"Simplex: single one-way arrow; Half-duplex: two opposite directions active turn-by-turn (different time slots); Full-duplex: two opposite directions active simultaneously","hi":"सिम्प्लेक्स: एकल तीर (single arrow); हाफ-डुप्लेक्स: बारी-बारी से दो दिशाएँ; फुल-डुप्लेक्स: एक ही समय में एक साथ दोनों दिशाएँ"},"o":[{"en":"Simplex: single one-way arrow; Half-duplex: two opposite directions active turn-by-turn (different time slots); Full-duplex: two opposite directions active simultaneously","hi":"सिम्प्लेक्स: एकल तीर (single arrow); हाफ-डुप्लेक्स: बारी-बारी से दो दिशाएँ; फुल-डुप्लेक्स: एक ही समय में एक साथ दोनों दिशाएँ"},{"en":"All three are drawn with a single circular loop without arrows","hi":"तीनों को बिना तीर के एक गोलाकार लूप के साथ बनाया जाता है"},{"en":"Simplex has four arrows, Half-duplex has one arrow, and Full-duplex has no arrows","hi":"सिम्प्लेक्स में चार तीर, हाफ-डुप्लेक्स में एक तीर और फुल-डुप्लेक्स में कोई तीर नहीं होता"},{"en":"Diagrams can only show simplex communication","hi":"आरेख केवल सिम्प्लेक्स संचार दिखा सकते हैं"}],"exp":{"en":"In textbook diagrams, Simplex is shown with a single directional arrow, Half-Duplex with bidirectional arrows operating in separate time slots (turn by turn), and Full-Duplex with bidirectional arrows operating simultaneously.","hi":"आरेख में सिम्प्लेक्स को एकल तीर (एक दिशा), हाफ-डुप्लेक्स को अलग-अलग समय स्लॉट में बारी-बारी से दो दिशाओं, और फुल-डुप्लेक्स को एक ही समय पर एक साथ दोनों दिशाओं के रूप में दर्शाया जाता है।"},"num":35},{"id":"q36","q":{"en":"What is the full form of 'VoLTE' and what is its role in mobile communication?","hi":"'VoLTE' का पूर्ण रूप क्या है और मोबाइल संचार में इसकी क्या भूमिका है?"},"a":{"en":"Voice over Long Term Evolution — provides packet-based voice service over LTE/4G access networks (typically via IMS)","hi":"वॉयस ओवर लॉन्ग टर्म इवोल्यूशन — LTE/4G एक्सेस नेटवर्क पर पैकेट-आधारित वॉयस सेवा (आमतौर पर IMS के माध्यम से)"},"o":[{"en":"Video over Local Television — broadcasts analog cable channels","hi":"वीडियो ओवर लोकल टेलीविजन — एनालॉग केबल चैनल प्रसारित करता है"},{"en":"Voice over Long Term Evolution — provides packet-based voice service over LTE/4G access networks (typically via IMS)","hi":"वॉयस ओवर लॉन्ग टर्म इवोल्यूशन — LTE/4G एक्सेस नेटवर्क पर पैकेट-आधारित वॉयस सेवा (आमतौर पर IMS के माध्यम से)"},{"en":"Voltage over Line Terminal Equipment — regulates AC power in transformers","hi":"वोल्टेज ओवर लाइन टर्मिनल इक्विपमेंट — ट्रांसफार्मर में AC पावर नियंत्रित करता है"},{"en":"Virtual Offline Lan Terminal Emulator — runs DOS games offline","hi":"वर्चुअल ऑफलाइन लैन टर्मिनल एमुलेटर — ऑफलाइन DOS गेम चलाता है"}],"exp":{"en":"VoLTE stands for Voice over Long Term Evolution; it is a standardized high-speed wireless communication standard for delivering packet-based voice calls over 4G LTE networks using the IP Multimedia Subsystem (IMS).","hi":"VoLTE का पूर्ण रूप Voice over Long Term Evolution है। यह LTE/4G एक्सेस नेटवर्क पर (आमतौर पर IMS के माध्यम से) पैकेट-आधारित वॉयस कॉल सेवा प्रदान करता है।"},"num":36},{"id":"q37","q":{"en":"What is the full form and meaning of 'VoIP'?","hi":"'VoIP' का पूर्ण रूप और अर्थ क्या है?"},"a":{"en":"Voice over Internet Protocol — technologies for delivering voice and related multimedia communication over IP networks","hi":"वॉयस ओवर इंटरनेट प्रोटोकॉल — IP नेटवर्क के माध्यम से वॉयस और संबंधित मल्टीमीडिया संचार प्रदान करने की तकनीकें"},"o":[{"en":"Voice over Internet Protocol — technologies for delivering voice and related multimedia communication over IP networks","hi":"वॉयस ओवर इंटरनेट प्रोटोकॉल — IP नेटवर्क के माध्यम से वॉयस और संबंधित मल्टीमीडिया संचार प्रदान करने की तकनीकें"},{"en":"Visual Optical Image Printer — a laser printer for photographs","hi":"विजुअल ऑप्टिकल इमेज प्रिंटर — तस्वीरों के लिए एक लेजर प्रिंटर"},{"en":"Vector Oriented Input Port — a joystick connector on old sound cards","hi":"वेक्टर ओरिएंटेड इनपुट पोर्ट — पुराने साउंड कार्ड पर जॉयस्टिक कनेक्टर"},{"en":"Variable Output Internal Power — a battery backup mode","hi":"वेरिएबल आउटपुट इंटरनल पावर — एक बैटरी बैकअप मोड"}],"exp":{"en":"VoIP stands for Voice over Internet Protocol, encompassing technologies and methodologies that deliver voice calls and multimedia sessions over Internet Protocol (IP) packet-switched networks.","hi":"VoIP का पूर्ण रूप Voice over Internet Protocol है। इसका अर्थ IP नेटवर्क (जैसे इंटरनेट) के माध्यम से वॉयस और संबंधित मल्टीमीडिया संचार प्रदान करने वाली तकनीकों से है।"},"num":37},{"id":"q38","q":{"en":"What is the relationship between 'VoIP' and 'VoLTE'?","hi":"'VoIP' और 'VoLTE' के बीच क्या संबंध है?"},"a":{"en":"VoIP is the broad IP-voice category, while VoLTE is a standardized operator implementation of voice service specifically over LTE/4G access","hi":"VoIP व्यापक IP-वॉयस श्रेणी है, जबकि VoLTE विशेष रूप से LTE एक्सेस पर ऑपरेटर वॉयस सेवा का मानकीकृत कार्यान्वयन (implementation) है"},"o":[{"en":"VoIP is the broad IP-voice category, while VoLTE is a standardized operator implementation of voice service specifically over LTE/4G access","hi":"VoIP व्यापक IP-वॉयस श्रेणी है, जबकि VoLTE विशेष रूप से LTE एक्सेस पर ऑपरेटर वॉयस सेवा का मानकीकृत कार्यान्वयन (implementation) है"},{"en":"VoLTE is an ancient mechanical calculator, while VoIP is a vacuum tube","hi":"VoLTE एक प्राचीन यांत्रिक कैलकुलेटर है, जबकि VoIP एक वैक्यूम ट्यूब है"},{"en":"Neither VoIP nor VoLTE has any relation to voice calls","hi":"न तो VoIP और न ही VoLTE का वॉयस कॉल से कोई संबंध है"},{"en":"VoIP works only on 1G analog radios, while VoLTE works only on coaxial bus LANs","hi":"VoIP केवल 1G एनालॉग रेडियो पर काम करता है, जबकि VoLTE केवल कोएक्सियल बस LAN पर काम करता है"}],"exp":{"en":"VoIP is the general umbrella category for carrying voice over IP networks, whereas VoLTE is a specific, carrier-grade standardized implementation of VoIP designed for 4G LTE mobile networks.","hi":"VoIP एक व्यापक IP-वॉयस श्रेणी (broad category) है, जबकि VoLTE विशेष रूप से LTE/4G नेटवर्क पर मोबाइल ऑपरेटर वॉयस सेवा का एक मानकीकृत रूप (standardized implementation) है।"},"num":38},{"id":"q39","q":{"en":"What does the abbreviation 'IoT' stand for in the chapter, and what does it include?","hi":"इस अध्याय में 'IoT' का पूर्ण रूप क्या है और इसमें क्या शामिल हैं?"},"a":{"en":"Internet of Things — a broad category of network-connected smart devices, sensors, appliances, and wearables that exchange data","hi":"इंटरनेट ऑफ थिंग्स — नेटवर्क से जुड़े स्मार्ट उपकरणों, सेंसर और वियरेबल्स (wearables) की व्यापक श्रेणी"},"o":[{"en":"Internet of Things — a broad category of network-connected smart devices, sensors, appliances, and wearables that exchange data","hi":"इंटरनेट ऑफ थिंग्स — नेटवर्क से जुड़े स्मार्ट उपकरणों, सेंसर और वियरेबल्स (wearables) की व्यापक श्रेणी"},{"en":"Internal Optical Tape — a magnetic backup cassette","hi":"इंटरनल ऑप्टिकल टेप — एक चुंबकीय बैकअप कैसेट"},{"en":"Input Output Typewriter — a mechanical keyboard from 1920","hi":"इनपुट आउटपुट टाइपराइटर — 1920 का एक यांत्रिक कीबोर्ड"},{"en":"Integrated Oscilloscope Terminal — an analog voltage meter","hi":"इंटीग्रेटेड ऑसिलोस्कोप टर्मिनल — एक एनालॉग वोल्टेज मीटर"}],"exp":{"en":"IoT stands for Internet of Things, referring to the network of physical objects—such as smart appliances, industrial sensors, and wearable devices—embedded with electronics, software, and network connectivity.","hi":"IoT का पूर्ण रूप Internet of Things है। नेटवर्क से जुड़े स्मार्ट उपकरण, सेंसर और वियरेबल्स (wearables) इस व्यापक श्रेणी में आते हैं।"},"num":39}]},{"title":{"en":"4. Network Topologies","hi":"4. नेटवर्क टोपोलॉजी"},"questions":[{"id":"q40","q":{"en":"What is 'Network Topology'?","hi":"'नेटवर्क टोपोलॉजी' (Network Topology) क्या है?"},"a":{"en":"The geometric/structural arrangement of nodes and links in a computer network","hi":"किसी कंप्यूटर नेटवर्क के नोड्स (nodes) और लिंक्स (links) की व्यवस्था (arrangement)"},"o":[{"en":"The brand name of the antivirus installed on a server","hi":"सर्वर पर इंस्टॉल किए गए एंटीवायरस का ब्रांड नाम"},{"en":"The geometric/structural arrangement of nodes and links in a computer network","hi":"किसी कंप्यूटर नेटवर्क के नोड्स (nodes) और लिंक्स (links) की व्यवस्था (arrangement)"},{"en":"The monthly electricity bill of a data center","hi":"डेटा सेंटर का मासिक बिजली बिल"},{"en":"The screen saver animation displayed on an idle monitor","hi":"निष्क्रिय मॉनिटर पर प्रदर्शित होने वाला स्क्रीन सेवर एनीमेशन"}],"exp":{"en":"Network topology refers to the physical or logical layout/arrangement of nodes (devices) and communication links (connections) in a network.","hi":"किसी कंप्यूटर नेटवर्क के नोड्स (उपकरणों) और लिंक्स (कनेक्शनों) की संरचनात्मक व्यवस्था (arrangement) को नेटवर्क टोपोलॉजी कहते हैं।"},"num":40},{"id":"q41","q":{"en":"What is the difference between 'Physical Topology' and 'Logical Topology'?","hi":"'फिजिकल टोपोलॉजी' (Physical Topology) और 'लॉजिकल टोपोलॉजी' (Logical Topology) में क्या अंतर है?"},"a":{"en":"Physical topology describes the actual physical layout of devices and cables, whereas Logical topology describes how data actually flows across the network","hi":"फिजिकल टोपोलॉजी उपकरणों/लिंक्स का वास्तविक लेआउट बताती है, जबकि लॉजिकल टोपोलॉजी बताती है कि नेटवर्क में डेटा कैसे प्रवाहित (flow) होता है"},"o":[{"en":"Physical topology describes the actual physical layout of devices and cables, whereas Logical topology describes how data actually flows across the network","hi":"फिजिकल टोपोलॉजी उपकरणों/लिंक्स का वास्तविक लेआउट बताती है, जबकि लॉजिकल टोपोलॉजी बताती है कि नेटवर्क में डेटा कैसे प्रवाहित (flow) होता है"},{"en":"Physical topology applies only to Wi-Fi, whereas Logical topology applies only to coaxial cables","hi":"फिजिकल टोपोलॉजी केवल वाई-फाई पर लागू होती है, जबकि लॉजिकल टोपोलॉजी केवल कोएक्सियल केबल पर लागू होती है"},{"en":"Physical topology refers to software protocols, while Logical topology refers to server racks","hi":"फिजिकल टोपोलॉजी सॉफ्टवेयर प्रोटोकॉल को संदर्भित करती है, जबकि लॉजिकल टोपोलॉजी सर्वर रैक को संदर्भित करती है"},{"en":"Both terms mean the exact same thing with no distinction","hi":"दोनों शब्दों का अर्थ बिना किसी अंतर के बिल्कुल समान है"}],"exp":{"en":"Physical topology defines the geometric arrangement of physical devices and cables, whereas Logical topology defines the path and manner in which data signals actually flow through the network.","hi":"फिजिकल टोपोलॉजी उपकरणों और केबलों के वास्तविक भौतिक लेआउट को दर्शाती है, जबकि लॉजिकल टोपोलॉजी यह बताती है कि नेटवर्क के भीतर डेटा वास्तव में कैसे प्रवाहित होता है।"},"num":41},{"id":"q42","q":{"en":"Which six main network topologies are covered in this chapter?","hi":"इस अध्याय में कौन-सी छह मुख्य नेटवर्क टोपोलॉजी (Six Main Topologies) शामिल की गई हैं?"},"a":{"en":"Bus, Ring, Star, Mesh, Tree, and Hybrid","hi":"बस (Bus), रिंग (Ring), स्टार (Star), मेश (Mesh), ट्री (Tree) और हाइब्रिड (Hybrid)"},"o":[{"en":"LAN, MAN, WAN, PAN, CAN, and SAN","hi":"LAN, MAN, WAN, PAN, CAN और SAN"},{"en":"Bus, Ring, Star, Mesh, Tree, and Hybrid","hi":"बस (Bus), रिंग (Ring), स्टार (Star), मेश (Mesh), ट्री (Tree) और हाइब्रिड (Hybrid)"},{"en":"Simplex, Half-duplex, Full-duplex, Serial, Parallel, and Analog","hi":"सिम्प्लेक्स, हाफ-डुप्लेक्स, फुल-डुप्लेक्स, सीरियल, पैरेलल और एनालॉग"},{"en":"Hub, Switch, Router, Bridge, Repeater, and Gateway","hi":"हब, स्विच, राउटर, ब्रिज, रिपीटर और गेटवे"}],"exp":{"en":"The six principal network topologies studied in this chapter are Bus, Ring, Star, Mesh, Tree, and Hybrid.","hi":"इस अध्याय में शामिल छह मुख्य नेटवर्क टोपोलॉजी हैं: बस (Bus), रिंग (Ring), स्टार (Star), मेश (Mesh), ट्री (Tree) और हाइब्रिड (Hybrid)।"},"num":42},{"id":"q43","q":{"en":"What is the structure of a 'Bus Topology' (also called Linear Bus)?","hi":"'बस टोपोलॉजी' (Bus Topology) की संरचना क्या होती है?"},"a":{"en":"All nodes are connected in a multipoint fashion to a single shared central backbone cable","hi":"सभी नोड्स एक साझा केंद्रीय बैकबोन केबल (shared central backbone cable) से मल्टीपॉइंट रूप में जुड़े होते हैं; इसे लीनियर बस (linear bus) भी कहते हैं"},"o":[{"en":"Every node is connected to every other node via dedicated point-to-point links","hi":"प्रत्येक नोड समर्पित पॉइंट-टू-पॉइंट लिंक के माध्यम से हर दूसरे नोड से जुड़ा होता है"},{"en":"All nodes are connected in a multipoint fashion to a single shared central backbone cable","hi":"सभी नोड्स एक साझा केंद्रीय बैकबोन केबल (shared central backbone cable) से मल्टीपॉइंट रूप में जुड़े होते हैं; इसे लीनियर बस (linear bus) भी कहते हैं"},{"en":"Nodes are arranged strictly in a closed circular loop without any ends","hi":"नोड्स बिना किसी छोर के एक बंद गोलाकार लूप में व्यवस्थित होते हैं"},{"en":"All nodes connect directly to a central wireless satellite","hi":"सभी नोड्स सीधे एक केंद्रीय वायरलेस उपग्रह से जुड़ते हैं"}],"exp":{"en":"In a Bus topology (or linear bus), all network nodes connect via drop lines and taps to a single shared central backbone cable in a multipoint configuration.","hi":"बस टोपोलॉजी (जिसे लीनियर बस भी कहते हैं) में सभी नोड्स एक साझा केंद्रीय बैकबोन केबल (central backbone cable) से मल्टीपॉइंट तरीके से जुड़े होते हैं।"},"num":43},{"id":"q44","q":{"en":"Where and why are 'Terminators' used in a Bus topology?","hi":"बस टोपोलॉजी में 'टर्मिनेटर' (Terminator) कहाँ और क्यों लगाए जाते हैं?"},"a":{"en":"At both ends of a legacy coaxial bus cable to absorb signals and prevent/reduce signal reflection (bounce)","hi":"पुराने कोएक्सियल बस के दोनों सिरों (both ends) पर, ताकि सिग्नल परावर्तन (signal reflection) को रोका या कम किया जा सके"},"o":[{"en":"At the center of a star switch to boost Wi-Fi range","hi":"वाई-फाई रेंज बढ़ाने के लिए स्टार स्विच के केंद्र में"},{"en":"At both ends of a legacy coaxial bus cable to absorb signals and prevent/reduce signal reflection (bounce)","hi":"पुराने कोएक्सियल बस के दोनों सिरों (both ends) पर, ताकि सिग्नल परावर्तन (signal reflection) को रोका या कम किया जा सके"},{"en":"Inside every computer's power supply unit to save electricity","hi":"बिजली बचाने के लिए प्रत्येक कंप्यूटर की पावर सप्लाई यूनिट के अंदर"},{"en":"On optical fiber rings to convert light into sound waves","hi":"प्रकाश को ध्वनि तरंगों में बदलने के लिए ऑप्टिकल फाइबर रिंग पर"}],"exp":{"en":"Terminators are placed at both physical ends of a coaxial bus backbone to absorb electrical signals when they reach the end, preventing signal reflection (bounce) and interference.","hi":"लेगेसी कोएक्सियल बस (coaxial bus) केबल के दोनों सिरों (ends) पर टर्मिनेटर लगाए जाते हैं ताकि सिग्नल परावर्तन (signal reflection/bounce) को कम किया जा सके।"},"num":44},{"id":"q45","q":{"en":"What is the major drawback of a Bus topology?","hi":"बस टोपोलॉजी (Bus Topology) का सबसे बड़ा नुकसान (Major Drawback) क्या है?"},"a":{"en":"A break or fault in the central backbone cable can disrupt the entire network segment, and contention on the shared medium limits performance","hi":"मुख्य बैकबोन केबल टूटने पर पूरा नेटवर्क सेगमेंट बाधित हो सकता है, और साझा माध्यम पर प्रतिस्पर्धा (contention) प्रदर्शन को सीमित कर सकती है"},"o":[{"en":"A break or fault in the central backbone cable can disrupt the entire network segment, and contention on the shared medium limits performance","hi":"मुख्य बैकबोन केबल टूटने पर पूरा नेटवर्क सेगमेंट बाधित हो सकता है, और साझा माध्यम पर प्रतिस्पर्धा (contention) प्रदर्शन को सीमित कर सकती है"},{"en":"It requires n(n-1)/2 separate cables for n computers","hi":"इसमें n कंप्यूटरों के लिए n(n-1)/2 अलग-अलग केबलों की आवश्यकता होती है"},{"en":"It requires an expensive central Layer-3 router for every two nodes","hi":"इसमें प्रत्येक दो नोड्स के लिए एक महंगे केंद्रीय लेयर-3 राउटर की आवश्यकता होती है"},{"en":"It can only connect a maximum of two computers","hi":"यह अधिकतम केवल दो कंप्यूटरों को ही जोड़ सकती है"}],"exp":{"en":"In a bus topology, the central backbone is a single point of failure—a break in the main cable brings down the entire segment—and heavy traffic causes collisions/contention on the shared medium.","hi":"बस टोपोलॉजी का मुख्य दोष यह है कि केंद्रीय बैकबोन केबल में खराबी या टूट-फूट पूरे नेटवर्क सेगमेंट को ठप कर सकती है, और साझा माध्यम होने से ट्रैफिक बढ़ने पर प्रदर्शन (performance) घट जाता है।"},"num":45},{"id":"q46","q":{"en":"What is the basic structure of a 'Ring Topology'?","hi":"'रिंग टोपोलॉजी' (Ring Topology) की मूल संरचना क्या होती है?"},"a":{"en":"Nodes are connected in a closed circular path where each node typically has exactly two adjacent neighbors","hi":"नोड्स एक वृत्ताकार पथ (circular path) में जुड़े होते हैं और प्रत्येक नोड के पास आमतौर पर दो पड़ोसी (neighbors) नोड होते हैं"},"o":[{"en":"Nodes are connected in a closed circular path where each node typically has exactly two adjacent neighbors","hi":"नोड्स एक वृत्ताकार पथ (circular path) में जुड़े होते हैं और प्रत्येक नोड के पास आमतौर पर दो पड़ोसी (neighbors) नोड होते हैं"},{"en":"All nodes plug into a single central hub using independent cables","hi":"सभी नोड्स स्वतंत्र केबलों का उपयोग करके एक केंद्रीय हब में प्लग करते हैं"},{"en":"Nodes are arranged in a parent-child pyramid hierarchy with a root","hi":"नोड्स एक रूट के साथ पेरेंट-चाइल्ड पिरामिड पदानुक्रम में व्यवस्थित होते हैं"},{"en":"Nodes are connected to a straight cable with terminators at both ends","hi":"नोड्स दोनों सिरों पर टर्मिनेटर के साथ एक सीधी केबल से जुड़े होते हैं"}],"exp":{"en":"In a Ring topology, devices are connected in a closed loop/circular path such that each node is connected directly to two neighboring nodes (one on either side).","hi":"रिंग टोपोलॉजी में सभी नोड्स एक बंद वृत्ताकार पथ (circular path) में जुड़े होते हैं और प्रत्येक नोड के ठीक दो पड़ोसी (neighbors) नोड होते हैं।"},"num":46},{"id":"q47","q":{"en":"Is data flow in a Ring topology always strictly one-way (unidirectional)?","hi":"क्या रिंग टोपोलॉजी में डेटा का प्रवाह हमेशा एक ही दिशा (One-way) में होता है?"},"a":{"en":"In a simple single-ring example, data flow is one-way (unidirectional), whereas dual-ring or resilient ring designs can provide bidirectional/alternate paths","hi":"साधारण सिंगल-रिंग में प्रवाह एक-तरफा (one-way) हो सकता है, लेकिन डुअल-रिंग या लचीले (resilient) डिज़ाइनों में वैकल्पिक पथ मिल सकते हैं"},"o":[{"en":"In a simple single-ring example, data flow is one-way (unidirectional), whereas dual-ring or resilient ring designs can provide bidirectional/alternate paths","hi":"साधारण सिंगल-रिंग में प्रवाह एक-तरफा (one-way) हो सकता है, लेकिन डुअल-रिंग या लचीले (resilient) डिज़ाइनों में वैकल्पिक पथ मिल सकते हैं"},{"en":"Data never flows in a ring topology","hi":"रिंग टोपोलॉजी में डेटा कभी प्रवाहित नहीं होता है"},{"en":"Every single ring always broadcasts data in four directions simultaneously","hi":"प्रत्येक सिंगल रिंग हमेशा एक साथ चार दिशाओं में डेटा प्रसारित करती है"},{"en":"Ring topology only works with wireless Bluetooth signals","hi":"रिंग टोपोलॉजी केवल वायरलेस ब्लूटूथ सिग्नल के साथ काम करती है"}],"exp":{"en":"While a basic single ring passes data unidirectionally (clockwise or counterclockwise) from node to node, dual-ring architectures (like FDDI or resilient rings) use a second counter-rotating ring to provide alternate paths.","hi":"साधारण सिंगल-रिंग उदाहरण में डेटा का प्रवाह एक-दिशीय (one-way) होता है, परंतु डुअल-रिंग (dual-ring) या रेजिलिएंट डिज़ाइनों में विपरीत दिशा का वैकल्पिक पथ भी उपलब्ध होता है।"},"num":47},{"id":"q48","q":{"en":"What is the effect of a single node or link failure in a simple (unprotected) Ring topology?","hi":"एक साधारण रिंग टोपोलॉजी (Simple Ring) में किसी नोड या लिंक के फेल होने का क्या प्रभाव पड़ता है?"},"a":{"en":"A break in the single loop can disrupt communication across the entire ring (though bypass relays or redundant dual-ring designs can reduce this impact)","hi":"सिंगल लूप टूटने पर पूरे रिंग का संचार बाधित हो सकता है (हालाँकि बाईपास स्विच या डुअल-रिंग डिज़ाइन इस प्रभाव को कम कर सकते हैं)"},"o":[{"en":"It has zero impact because every node has direct mesh links to all other nodes","hi":"इसका कोई प्रभाव नहीं पड़ता क्योंकि प्रत्येक नोड के पास अन्य सभी नोड्स के लिए सीधे मेश लिंक होते हैं"},{"en":"A break in the single loop can disrupt communication across the entire ring (though bypass relays or redundant dual-ring designs can reduce this impact)","hi":"सिंगल लूप टूटने पर पूरे रिंग का संचार बाधित हो सकता है (हालाँकि बाईपास स्विच या डुअल-रिंग डिज़ाइन इस प्रभाव को कम कर सकते हैं)"},{"en":"It automatically converts the ring into a full mesh network","hi":"यह रिंग को स्वचालित रूप से फुल मेश नेटवर्क में बदल देता है"},{"en":"It increases the data transfer speed by ten times","hi":"यह डेटा ट्रांसफर की गति को दस गुना बढ़ा देता है"}],"exp":{"en":"In a simple unidirectional ring, a single broken link or failed active node breaks the loop and can disable the whole network, unless optical/mechanical bypass switches or dual rings are used.","hi":"साधारण सिंगल-लूप रिंग में एक भी लिंक या नोड के खराब होने पर पूरा लूप टूट जाता है और संचार रुक सकता है (बाईपास या रिडंडेंट रिंग डिज़ाइन से इस समस्या को कम किया जा सकता है)।"},"num":48},{"id":"q49","q":{"en":"What is the structure of a 'Star Topology'?","hi":"'स्टार टोपोलॉजी' (Star Topology) की संरचना क्या है?"},"a":{"en":"Each node connects via its own separate link to a central connecting device such as a hub or a switch","hi":"प्रत्येक नोड एक अलग लिंक (separate link) के माध्यम से किसी केंद्रीय उपकरण (जैसे हब या स्विच) से जुड़ा होता है"},"o":[{"en":"Each node connects via its own separate link to a central connecting device such as a hub or a switch","hi":"प्रत्येक नोड एक अलग लिंक (separate link) के माध्यम से किसी केंद्रीय उपकरण (जैसे हब या स्विच) से जुड़ा होता है"},{"en":"All nodes share a single coaxial cable terminated at both ends","hi":"सभी नोड्स दोनों सिरों पर समाप्त होने वाली एक एकल कोएक्सियल केबल साझा करते हैं"},{"en":"Each node connects only to its left and right neighbors in a circle","hi":"प्रत्येक नोड एक वृत्त में केवल अपने बाएँ और दाएँ पड़ोसियों से जुड़ता है"},{"en":"Nodes are connected without any central device in a daisy chain","hi":"नोड्स बिना किसी केंद्रीय उपकरण के डेज़ी चेन में जुड़े होते हैं"}],"exp":{"en":"In a Star topology, every peripheral node is connected via a dedicated point-to-point link to a central controller/device, typically a switch or a hub.","hi":"स्टार टोपोलॉजी में प्रत्येक नोड एक अलग केबल/लिंक द्वारा सीधे किसी केंद्रीय उपकरण (central device), जैसे हब (Hub) या स्विच (Switch) से जुड़ा होता है।"},"num":49},{"id":"q50","q":{"en":"Why is a Star topology relatively easy to troubleshoot and maintain?","hi":"स्टार टोपोलॉजी में समस्या निवारण (Troubleshooting) और रखरखाव अपेक्षाकृत आसान क्यों होता है?"},"a":{"en":"Because each node has a separate individual link to the central device, making it easy to isolate a faulty node/cable and add or remove devices without disrupting others","hi":"क्योंकि प्रत्येक नोड का लिंक अलग होता है, जिससे खराब नोड/लिंक को अलग (isolate) करना और नए उपकरण जोड़ना या हटाना आसान होता है"},"o":[{"en":"Because it uses no cables or network devices at all","hi":"क्योंकि इसमें किसी भी केबल या नेटवर्क डिवाइस का उपयोग नहीं होता है"},{"en":"Because each node has a separate individual link to the central device, making it easy to isolate a faulty node/cable and add or remove devices without disrupting others","hi":"क्योंकि प्रत्येक नोड का लिंक अलग होता है, जिससे खराब नोड/लिंक को अलग (isolate) करना और नए उपकरण जोड़ना या हटाना आसान होता है"},{"en":"Because a single cable cut shuts down the entire building immediately","hi":"क्योंकि एक केबल कटने से पूरी बिल्डिंग तुरंत बंद हो जाती है"},{"en":"Because it requires no central hub or switch","hi":"क्योंकि इसमें किसी केंद्रीय हब या स्विच की आवश्यकता नहीं होती है"}],"exp":{"en":"Since each device has its own dedicated cable to the central switch/hub, faults are easily isolated to a single port/link, and adding or removing nodes does not interrupt the rest of the network.","hi":"चूँकि स्टार टोपोलॉजी में प्रत्येक नोड का लिंक अलग होता है, इसलिए किसी खराब नोड या केबल की पहचान कर उसे अलग (isolate) करना और नेटवर्क को बाधित किए बिना उपकरण जोड़ना/हटाना आसान होता है।"},"num":50},{"id":"q51","q":{"en":"In a Star topology, what happens if a single endpoint link fails versus if the central device fails?","hi":"स्टार टोपोलॉजी में एक एंडपॉइंट लिंक (Endpoint link) फेल होने बनाम केंद्रीय उपकरण (Central device) फेल होने पर क्या होता है?"},"a":{"en":"If an endpoint link fails, only that specific node is disconnected; but if the central device (hub/switch) fails, communication for all connected nodes in that star stops","hi":"एंडपॉइंट लिंक फेल होने पर केवल वही नोड डिस्कनेक्ट होता है; परंतु केंद्रीय उपकरण फेल होने पर उस स्टार से जुड़े सभी नोड्स का संचार रुक जाता है"},"o":[{"en":"If an endpoint link fails, only that specific node is disconnected; but if the central device (hub/switch) fails, communication for all connected nodes in that star stops","hi":"एंडपॉइंट लिंक फेल होने पर केवल वही नोड डिस्कनेक्ट होता है; परंतु केंद्रीय उपकरण फेल होने पर उस स्टार से जुड़े सभी नोड्स का संचार रुक जाता है"},{"en":"In both cases, only one computer is affected and the rest continue working","hi":"दोनों ही स्थितियों में केवल एक कंप्यूटर प्रभावित होता है और बाकी काम करते रहते हैं"},{"en":"If an endpoint link fails, the entire network crashes, whereas if the central switch fails, nothing happens","hi":"एंडपॉइंट लिंक फेल होने पर पूरा नेटवर्क क्रैश हो जाता है, जबकि केंद्रीय स्विच फेल होने पर कुछ नहीं होता"},{"en":"Star topology is completely immune to central device failures","hi":"स्टार टोपोलॉजी केंद्रीय उपकरण की विफलताओं से पूरी तरह सुरक्षित है"}],"exp":{"en":"Failure of one node's cable only isolates that single node, leaving the rest of the star operational; however, the central hub/switch is a single point of failure whose breakdown disables the entire star segment.","hi":"किसी एक एंडपॉइंट लिंक के खराब होने पर केवल वही नोड नेटवर्क से कटता है, लेकिन यदि केंद्रीय उपकरण (हब/स्विच) खराब हो जाए, तो उस स्टार से जुड़े सभी नोड्स का संचार ठप हो जाता है।"},"num":51},{"id":"q52","q":{"en":"Does the geometric shape of a Star topology alone guarantee high network speed?","hi":"क्या केवल स्टार टोपोलॉजी का आकार (Shape) ही उच्च गति (High Speed) की गारंटी देता है?"},"a":{"en":"No—actual throughput depends on the central device, link speed, and traffic; a switched star offers much better performance than a shared-medium hub star","hi":"नहीं—वास्तविक गति केंद्रीय उपकरण, लिंक स्पीड और ट्रैफिक पर निर्भर करती है; शेयर्ड हब की तुलना में स्विच्ड स्टार (switched star) बेहतर प्रदर्शन देता है"},"o":[{"en":"Yes, any star-shaped layout automatically runs at 100 Gbps regardless of hardware","hi":"हाँ, कोई भी स्टार आकार का लेआउट हार्डवेयर की परवाह किए बिना स्वचालित रूप से 100 Gbps पर चलता है"},{"en":"No—actual throughput depends on the central device, link speed, and traffic; a switched star offers much better performance than a shared-medium hub star","hi":"नहीं—वास्तविक गति केंद्रीय उपकरण, लिंक स्पीड और ट्रैफिक पर निर्भर करती है; शेयर्ड हब की तुलना में स्विच्ड स्टार (switched star) बेहतर प्रदर्शन देता है"},{"en":"No, star topology is always slower than a 1970s dial-up modem","hi":"नहीं, स्टार टोपोलॉजी हमेशा 1970 के दशक के डायल-अप मॉडेम से धीमी होती है"},{"en":"Yes, because star topology eliminates the need for any central device","hi":"हाँ, क्योंकि स्टार टोपोलॉजी किसी भी केंद्रीय उपकरण की आवश्यकता को समाप्त कर देती है"}],"exp":{"en":"Topology shape alone does not guarantee speed; throughput depends on the central device's capability (a Layer-2 switch vs. a legacy shared hub), cable/port ratings, and traffic load.","hi":"केवल स्टार का आकार उच्च गति की गारंटी नहीं देता; वास्तविक थ्रूपुट केंद्रीय उपकरण, लिंक की गति और ट्रैफिक पर निर्भर करता है। एक शेयर्ड हब की तुलना में स्विच्ड स्टार (switched star) कहीं बेहतर प्रदर्शन देता है।"},"num":52},{"id":"q53","q":{"en":"What is a 'Full Mesh Topology', and how does it differ from a 'Partial Mesh'?","hi":"'फुल मेश टोपोलॉजी' (Full Mesh Topology) क्या है, और यह 'पार्शियल मेश' (Partial Mesh) से कैसे भिन्न है?"},"a":{"en":"In a Full Mesh, every node has a direct point-to-point link to every other node; in a Partial Mesh, some nodes are connected to all others while some direct links are absent","hi":"फुल मेश में प्रत्येक नोड हर दूसरे नोड से सीधे लिंक द्वारा जुड़ा होता है; जबकि पार्शियल मेश में कुछ सीधे लिंक अनुपस्थित होते हैं"},"o":[{"en":"In a Full Mesh, every node has a direct point-to-point link to every other node; in a Partial Mesh, some nodes are connected to all others while some direct links are absent","hi":"फुल मेश में प्रत्येक नोड हर दूसरे नोड से सीधे लिंक द्वारा जुड़ा होता है; जबकि पार्शियल मेश में कुछ सीधे लिंक अनुपस्थित होते हैं"},{"en":"Full Mesh uses a single shared coaxial cable, whereas Partial Mesh uses a closed ring","hi":"फुल मेश एक साझा कोएक्सियल केबल का उपयोग करता है, जबकि पार्शियल मेश एक बंद रिंग का उपयोग करता है"},{"en":"Full Mesh has zero redundancy, whereas Partial Mesh has infinite cables","hi":"फुल मेश में शून्य रिडंडेंसी होती है, जबकि पार्शियल मेश में अनंत केबल होते हैं"},{"en":"Full Mesh connects all nodes to a single passive hub","hi":"फुल मेश सभी नोड्स को एक सिंगल पैसिव हब से जोड़ता है"}],"exp":{"en":"In a Full Mesh topology, every node is directly connected to every other node via dedicated point-to-point links; in a Partial Mesh, only critical or selected nodes have redundant direct interconnections.","hi":"फुल मेश टोपोलॉजी में प्रत्येक नोड हर दूसरे नोड से सीधे (direct) पॉइंट-टू-पॉइंट लिंक द्वारा जुड़ा होता है, जबकि पार्शियल मेश में केवल कुछ ही नोड्स के बीच सीधे लिंक होते हैं।"},"num":53},{"id":"q54","q":{"en":"What is the formula for the total number of undirected point-to-point links required in a Full Mesh of 'n' nodes?","hi":"'n' नोड्स वाली फुल मेश टोपोलॉजी (Full Mesh) में कुल अनडायरेक्टेड पॉइंट-टू-पॉइंट लिंक्स का सूत्र क्या है?"},"a":{"en":"n(n − 1) / 2  (counting one bidirectional link per pair of nodes)","hi":"n(n − 1) / 2  (प्रत्येक जोड़े के लिंक को एक बार गिनते हुए)"},"o":[{"en":"n + 1","hi":"n + 1"},{"en":"n(n − 1) / 2  (counting one bidirectional link per pair of nodes)","hi":"n(n − 1) / 2  (प्रत्येक जोड़े के लिंक को एक बार गिनते हुए)"},{"en":"2n","hi":"2n"},{"en":"n − 1","hi":"n − 1"}],"exp":{"en":"In a full mesh of n nodes, each of the n nodes connects to (n − 1) other nodes; since each undirected link connects two nodes, the total number of physical links is n(n − 1) / 2.","hi":"n नोड्स की फुल मेश टोपोलॉजी में कुल पॉइंट-टू-पॉइंट लिंक्स की संख्या n(n − 1) / 2 होती है (जहाँ प्रत्येक युग्म के बीच के लिंक को एक बार गिना जाता है)।"},"num":54},{"id":"q55","q":{"en":"How many point-to-point links are required for a Full Mesh network with 5 nodes and 6 nodes respectively?","hi":"5 नोड्स और 6 नोड्स वाले फुल मेश नेटवर्क में क्रमशः कितने लिंक्स की आवश्यकता होती है?"},"a":{"en":"10 links (5×4/2) and 15 links (6×5/2)","hi":"10 लिंक्स (5×4/2) और 15 लिंक्स (6×5/2)"},"o":[{"en":"5 links and 6 links","hi":"5 लिंक्स और 6 लिंक्स"},{"en":"10 links (5×4/2) and 15 links (6×5/2)","hi":"10 लिंक्स (5×4/2) और 15 लिंक्स (6×5/2)"},{"en":"20 links and 30 links","hi":"20 लिंक्स और 30 लिंक्स"},{"en":"4 links and 5 links","hi":"4 लिंक्स और 5 लिंक्स"}],"exp":{"en":"Using the formula n(n − 1)/2: for n = 5, links = 5 × 4 / 2 = 10; for n = 6, links = 6 × 5 / 2 = 15.","hi":"सूत्र n(n − 1)/2 के अनुसार: 5 नोड्स के लिए 5 × 4 / 2 = 10 लिंक्स, और 6 नोड्स के लिए 6 × 5 / 2 = 15 लिंक्स होते हैं।"},"num":55},{"id":"q56","q":{"en":"Why is a Full Mesh topology both highly resilient (fault-tolerant) and expensive?","hi":"फुल मेश टोपोलॉजी अत्यधिक लचीली/विश्वसनीय (Resilient) होने के साथ-साथ महँगी (Expensive) क्यों होती है?"},"a":{"en":"Because multiple alternate paths exist if a link fails, but the large number of cables and I/O ports increases installation and hardware costs","hi":"क्योंकि लिंक फेल होने पर वैकल्पिक पथ उपलब्ध होते हैं, पर अत्यधिक केबलिंग और I/O पोर्ट्स के कारण लागत बहुत अधिक होती है"},"o":[{"en":"Because multiple alternate paths exist if a link fails, but the large number of cables and I/O ports increases installation and hardware costs","hi":"क्योंकि लिंक फेल होने पर वैकल्पिक पथ उपलब्ध होते हैं, पर अत्यधिक केबलिंग और I/O पोर्ट्स के कारण लागत बहुत अधिक होती है"},{"en":"Because it uses only one short cable that breaks easily","hi":"क्योंकि यह केवल एक छोटी केबल का उपयोग करती है जो आसानी से टूट जाती है"},{"en":"Because it requires human operators to carry floppy disks between nodes","hi":"क्योंकि इसमें नोड्स के बीच फ्लॉपी डिस्क ले जाने के लिए मानव ऑपरेटरों की आवश्यकता होती है"},{"en":"Because it cannot work with more than 3 computers","hi":"क्योंकि यह 3 से अधिक कंप्यूटरों के साथ काम नहीं कर सकती"}],"exp":{"en":"Full mesh provides superior fault tolerance and privacy because dedicated links and multiple alternate routes exist, but requiring n(n−1)/2 cables and (n−1) ports per device makes it costly and complex to wire.","hi":"फुल मेश में कई वैकल्पिक पथ (alternate paths) उपलब्ध होने से यह अत्यधिक विश्वसनीय (resilient) होती है, परंतु अत्यधिक केबलों और हर डिवाइस पर कई पोर्ट्स की आवश्यकता के कारण यह बहुत महँगी होती है।"},"num":56},{"id":"q57","q":{"en":"What is the basic structure of a 'Tree Topology' (also called Expanded Star)?","hi":"'ट्री टोपोलॉजी' (Tree Topology) की मूल संरचना क्या है (जिसे Expanded Star भी कहते हैं)?"},"a":{"en":"A hierarchical structure of branches extending from a root/backbone, often connecting multiple star networks to a central backbone","hi":"रूट या मुख्य बैकबोन से निकलने वाली पदानुक्रमित (hierarchical) शाखाएँ; यह कई स्टार नेटवर्कों को एक बैकबोन से जोड़ती है, इसलिए इसे 'एक्सपेंडेड स्टार' (expanded star) भी कहते हैं"},"o":[{"en":"A hierarchical structure of branches extending from a root/backbone, often connecting multiple star networks to a central backbone","hi":"रूट या मुख्य बैकबोन से निकलने वाली पदानुक्रमित (hierarchical) शाखाएँ; यह कई स्टार नेटवर्कों को एक बैकबोन से जोड़ती है, इसलिए इसे 'एक्सपेंडेड स्टार' (expanded star) भी कहते हैं"},{"en":"A closed circular loop where every node has exactly two neighbors","hi":"एक बंद गोलाकार लूप जहाँ प्रत्येक नोड के ठीक दो पड़ोसी होते हैं"},{"en":"Every node wired directly to every other node","hi":"हर दूसरे नोड से सीधे तार से जुड़ा प्रत्येक नोड"},{"en":"Two computers connected by a single crossover cable","hi":"एक क्रॉसओवर केबल से जुड़े दो कंप्यूटर"}],"exp":{"en":"Tree topology arranges nodes in a parent-child hierarchy branching out from a root node or linear backbone; in standard textbook examples, it connects multiple star-configured hubs/switches to a bus backbone (hence called an expanded star).","hi":"ट्री टोपोलॉजी में रूट (root) या बैकबोन से पदानुक्रमित शाखाएँ (hierarchical branches) निकलती हैं। यह कई स्टार नेटवर्कों को एक मुख्य बैकबोन से जोड़ती है, इसलिए इसे 'एक्सपेंडेड स्टार' (Expanded Star) भी कहा जाता है।"},"num":57},{"id":"q58","q":{"en":"What is the impact of a branch link failure versus a root/backbone failure in a Tree topology?","hi":"ट्री टोपोलॉजी में किसी शाखा (Branch) के फेल होने बनाम रूट/बैकबोन (Root/Backbone) के फेल होने का क्या प्रभाव होता है?"},"a":{"en":"If a branch link fails, only the subtree below it becomes isolated; if the root or main backbone fails, the broader network communication is disrupted","hi":"यदि कोई शाखा लिंक फेल हो जाए तो केवल उसके नीचे का भाग अलग-थलग (isolate) पड़ता है; लेकिन रूट या मुख्य बैकबोन फेल होने पर व्यापक नेटवर्क बाधित हो सकता है"},"o":[{"en":"If a branch link fails, only the subtree below it becomes isolated; if the root or main backbone fails, the broader network communication is disrupted","hi":"यदि कोई शाखा लिंक फेल हो जाए तो केवल उसके नीचे का भाग अलग-थलग (isolate) पड़ता है; लेकिन रूट या मुख्य बैकबोन फेल होने पर व्यापक नेटवर्क बाधित हो सकता है"},{"en":"Neither branch failure nor root failure affects any computer","hi":"न तो शाखा की विफलता और न ही रूट की विफलता किसी कंप्यूटर को प्रभावित करती है"},{"en":"Branch failure shuts down the entire internet, while root failure affects only one mouse","hi":"शाखा की विफलता पूरे इंटरनेट को बंद कर देती है, जबकि रूट की विफलता केवल एक माउस को प्रभावित करती है"},{"en":"Tree topology heals itself automatically without redundant links","hi":"ट्री टोपोलॉजी बिना किसी अतिरिक्त लिंक के अपने आप ठीक हो जाती है"}],"exp":{"en":"In a tree hierarchy, a failure in a secondary branch link only isolates the downstream nodes attached to that branch, whereas a failure in the root node or primary backbone partitions and disrupts the entire network.","hi":"यदि ट्री टोपोलॉजी में कोई शाखा (branch) लिंक खराब हो जाए, तो केवल उसके नीचे का हिस्सा ही अलग (isolate) होता है; परंतु रूट या मुख्य बैकबोन के फेल होने पर पूरा नेटवर्क बाधित हो सकता है।"},"num":58},{"id":"q59","q":{"en":"What is a 'Hybrid Topology'?","hi":"'हाइब्रिड टोपोलॉजी' (Hybrid Topology) क्या होती है?"},"a":{"en":"A network that combines two or more different topology structures (such as a Star-Ring or Star-Bus combination) into a single larger network","hi":"दो या अधिक विभिन्न टोपोलॉजी पैटर्न को मिलाकर बनाया गया संयुक्त नेटवर्क (जैसे एक भाग स्टार और दूसरा भाग रिंग)"},"o":[{"en":"A network that combines two or more different topology structures (such as a Star-Ring or Star-Bus combination) into a single larger network","hi":"दो या अधिक विभिन्न टोपोलॉजी पैटर्न को मिलाकर बनाया गया संयुक्त नेटवर्क (जैसे एक भाग स्टार और दूसरा भाग रिंग)"},{"en":"A network that uses only a single standalone computer with no cables","hi":"एक ऐसा नेटवर्क जो बिना किसी केबल के केवल एक अकेले कंप्यूटर का उपयोग करता है"},{"en":"A purely analog thermometer connected to a wall","hi":"दीवार से लगा एक विशुद्ध एनालॉग थर्मामीटर"},{"en":"A topology where data can never be transmitted","hi":"एक ऐसी टोपोलॉजी जहाँ डेटा कभी भी ट्रांसमिट नहीं किया जा सकता"}],"exp":{"en":"A Hybrid topology is an integration of two or more distinct basic topologies (for example, connecting a star segment and a ring segment together) to meet an organization's scale and layout requirements.","hi":"दो या अधिक अलग-अलग टोपोलॉजी पैटर्न (जैसे एक सेक्शन स्टार और दूसरा रिंग) के संयोजन से बने नेटवर्क को हाइब्रिड टोपोलॉजी (Hybrid Topology) कहते हैं।"},"num":59}]},{"title":{"en":"5. Cloud Computing & Network Devices","hi":"5. क्लाउड कम्प्यूटिंग और नेटवर्क डिवाइस"},"questions":[{"id":"q60","q":{"en":"What is 'Cloud Computing'?","hi":"'क्लाउड कंप्यूटिंग' (Cloud Computing) क्या है?"},"a":{"en":"Accessing on-demand shared computing resources or services (such as storage, applications, and processing power) over a network/Internet","hi":"नेटवर्क (इंटरनेट) के माध्यम से ऑन-डिमांड साझा कंप्यूटिंग संसाधनों या सेवाओं (जैसे स्टोरेज, एप्लिकेशन और प्रोसेसिंग) को एक्सेस करना"},"o":[{"en":"Forecasting rain clouds using an analog barometer","hi":"एनालॉग बैरोमीटर का उपयोग करके वर्षा के बादलों का पूर्वानुमान लगाना"},{"en":"Accessing on-demand shared computing resources or services (such as storage, applications, and processing power) over a network/Internet","hi":"नेटवर्क (इंटरनेट) के माध्यम से ऑन-डिमांड साझा कंप्यूटिंग संसाधनों या सेवाओं (जैसे स्टोरेज, एप्लिकेशन और प्रोसेसिंग) को एक्सेस करना"},{"en":"Storing data exclusively on local floppy disks without internet access","hi":"बिना इंटरनेट एक्सेस के केवल लोकल फ्लॉपी डिस्क पर डेटा स्टोर करना"},{"en":"Repairing broken computer monitors with soldering irons","hi":"सोल्डरिंग आयरन से टूटे हुए कंप्यूटर मॉनिटर की मरम्मत करना"}],"exp":{"en":"Cloud computing is the on-demand delivery and access of shared computing resources—including storage, servers, databases, networking, and software applications—over a network (typically the Internet).","hi":"नेटवर्क या इंटरनेट के माध्यम से ऑन-डिमांड (मांग पर) साझा कंप्यूटिंग संसाधनों या सेवाओं—जैसे स्टोरेज, एप्लिकेशन और प्रोसेसिंग—को एक्सेस करना क्लाउड कंप्यूटिंग कहलाता है।"},"num":60},{"id":"q61","q":{"en":"Which of the following is a practical everyday example of Cloud Storage and Backup?","hi":"क्लाउड स्टोरेज/बैकअप (Cloud Storage/Backup) का व्यावहारिक उदाहरण क्या है?"},"a":{"en":"Backing up photos and files online to a remote cloud server and accessing them from authorized devices anywhere","hi":"फ़ोटो और फ़ाइलों का ऑनलाइन बैकअप लेना और उन्हें अधिकृत उपकरणों (authorised devices) से कहीं से भी एक्सेस करना"},"o":[{"en":"Backing up photos and files online to a remote cloud server and accessing them from authorized devices anywhere","hi":"फ़ोटो और फ़ाइलों का ऑनलाइन बैकअप लेना और उन्हें अधिकृत उपकरणों (authorised devices) से कहीं से भी एक्सेस करना"},{"en":"Writing phone numbers in a physical paper diary","hi":"भौतिक कागज़ की डायरी में फ़ोन नंबर लिखना"},{"en":"Copying files onto a CD-ROM that cannot be read over a network","hi":"फ़ाइलों को CD-ROM पर कॉपी करना जिसे नेटवर्क पर नहीं पढ़ा जा सकता"},{"en":"Deleting all files from the recycle bin permanently","hi":"रीसायकल बिन से सभी फ़ाइलों को स्थायी रूप से हटाना"}],"exp":{"en":"Backing up personal photos, documents, and files to online cloud services (like Google Drive, iCloud, OneDrive) so they can be synced and accessed across authorized devices is a common example of cloud storage.","hi":"फ़ोटो और फ़ाइलों का ऑनलाइन क्लाउड सर्वर पर बैकअप लेना और उन्हें किसी भी अधिकृत डिवाइस (authorised device) से एक्सेस करना क्लाउड स्टोरेज का एक प्रमुख उदाहरण है।"},"num":61},{"id":"q62","q":{"en":"What is the full form of 'Modem' and how does it work in a traditional dial-up telephone connection?","hi":"'मॉडेम' (Modem) का पूर्ण रूप क्या है और पारंपरिक डायल-अप कनेक्शन में यह क्या करता है?"},"a":{"en":"Modulator–Demodulator — it modulates digital computer data into analog signals for telephone lines and demodulates received analog signals back into digital data","hi":"मॉड्यूलेटर-डीमॉड्यूलेटर — यह कंप्यूटर के डिजिटल डेटा को टेलीफोन लाइन सिग्नल में मॉड्यूलेट करता है और प्राप्त सिग्नल को वापस डिजिटल डेटा में डीमॉड्यूलेट करता है"},"o":[{"en":"Modulator–Demodulator — it modulates digital computer data into analog signals for telephone lines and demodulates received analog signals back into digital data","hi":"मॉड्यूलेटर-डीमॉड्यूलेटर — यह कंप्यूटर के डिजिटल डेटा को टेलीफोन लाइन सिग्नल में मॉड्यूलेट करता है और प्राप्त सिग्नल को वापस डिजिटल डेटा में डीमॉड्यूलेट करता है"},{"en":"Modern Memory — it increases the RAM capacity of a CPU","hi":"मॉडर्न मेमोरी — यह CPU की RAM क्षमता को बढ़ाता है"},{"en":"Mobile Desktop Manager — it prints hard copies on thermal paper","hi":"मोबाइल डेस्कटॉप मैनेजर — यह थर्मल पेपर पर हार्ड कॉपी प्रिंट करता है"},{"en":"Mono Digital Multiplexer — it only amplifies sound in speakers","hi":"मोनो डिजिटल मल्टीप्लेक्सर — यह केवल स्पीकर में ध्वनि को बढ़ाता है"}],"exp":{"en":"Modem stands for Modulator–Demodulator; in traditional dial-up networking, it modulates digital bitstreams from a computer into analog voice-band signals for transmission over telephone lines, and demodulates incoming analog signals back into digital data.","hi":"Modem का पूर्ण रूप Modulator–Demodulator है। पारंपरिक डायल-अप में यह कंप्यूटर के डिजिटल डेटा को टेलीफोन लाइन पर भेजने के लिए एनालॉग सिग्नल में मॉड्यूलेट करता है और प्राप्त सिग्नल को वापस डिजिटल डेटा में डीमॉड्यूलेट करता है।"},"num":62},{"id":"q63","q":{"en":"What is the function of an 'Ethernet Card' and what is the full form of 'NIC'?","hi":"'ईथरनेट कार्ड' (Ethernet Card) का क्या काम है और 'NIC' का पूर्ण रूप क्या है?"},"a":{"en":"It provides a hardware network interface for connecting a computer to a wired Ethernet LAN; NIC stands for Network Interface Card (or Network Interface Controller)","hi":"यह वायर्ड ईथरनेट LAN के लिए नेटवर्क इंटरफेस प्रदान करता है; NIC का पूर्ण रूप Network Interface Card (या Network Interface Controller) है"},"o":[{"en":"It provides a hardware network interface for connecting a computer to a wired Ethernet LAN; NIC stands for Network Interface Card (or Network Interface Controller)","hi":"यह वायर्ड ईथरनेट LAN के लिए नेटवर्क इंटरफेस प्रदान करता है; NIC का पूर्ण रूप Network Interface Card (या Network Interface Controller) है"},{"en":"It cools the graphics processor; NIC stands for Numeric Internal Cooler","hi":"यह ग्राफिक्स प्रोसेसर को ठंडा करता है; NIC का अर्थ न्यूमेरिक इंटरनल कूलर है"},{"en":"It stores BIOS settings on a battery; NIC stands for Non-volatile Integrated Chip","hi":"यह बैटरी पर BIOS सेटिंग्स स्टोर करता है; NIC का अर्थ नॉन-वोलेटाइल इंटीग्रेटेड चिप है"},{"en":"It scans barcodes in supermarkets; NIC stands for National Ink Cartridge","hi":"यह सुपरमार्केट में बारकोड स्कैन करता है; NIC का अर्थ नेशनल इंक कार्ट्रिज है"}],"exp":{"en":"An Ethernet card (a type of NIC — Network Interface Card or Network Interface Controller) is a hardware component that enables a computer or device to connect to and communicate over a wired Ethernet LAN.","hi":"ईथरनेट कार्ड कंप्यूटर को वायर्ड ईथरनेट LAN से जोड़ने के लिए नेटवर्क इंटरफेस प्रदान करता है। NIC का पूर्ण रूप Network Interface Card या Network Interface Controller होता है।"},"num":63},{"id":"q64","q":{"en":"How is the operating speed of an Ethernet Card determined, and what are common example rates mentioned in the chapter?","hi":"ईथरनेट कार्ड (Ethernet Card) की गति कैसे तय होती है, और अध्याय में इसके कौन-से उदाहरण दिए गए हैं?"},"a":{"en":"It depends on the card, switch port, and link standard (with 10 Mbps and 1 Gbps given as examples in the source, alongside other Ethernet rates like 100 Mbps, 10 Gbps, etc.)","hi":"कार्ड, पोर्ट और लिंक मानक (standard) के आधार पर (स्रोत में 10 Mbps और 1 Gbps उदाहरण दिए गए हैं, और ईथरनेट की अन्य दरें भी होती हैं)"},"o":[{"en":"It depends on the card, switch port, and link standard (with 10 Mbps and 1 Gbps given as examples in the source, alongside other Ethernet rates like 100 Mbps, 10 Gbps, etc.)","hi":"कार्ड, पोर्ट और लिंक मानक (standard) के आधार पर (स्रोत में 10 Mbps और 1 Gbps उदाहरण दिए गए हैं, और ईथरनेट की अन्य दरें भी होती हैं)"},{"en":"It depends on the size of the computer monitor in inches","hi":"यह इंच में कंप्यूटर मॉनिटर के आकार पर निर्भर करता है"},{"en":"All Ethernet cards ever made operate strictly at 1 Kbps","hi":"अब तक बने सभी ईथरनेट कार्ड केवल 1 Kbps पर काम करते हैं"},{"en":"It depends on the number of keys on the keyboard","hi":"यह कीबोर्ड पर कुंजियों की संख्या पर निर्भर करता है"}],"exp":{"en":"Actual link speed is negotiated based on the capabilities of the Ethernet NIC, the connected port, and the cabling standard—such as 10 Mbps (Ethernet), 100 Mbps (Fast Ethernet), 1 Gbps (Gigabit Ethernet), and higher rates.","hi":"ईथरनेट कार्ड की गति कार्ड, कनेक्टेड पोर्ट और लिंक मानक (standard) पर निर्भर करती है। स्रोत में 10 Mbps और 1 Gbps इसके उदाहरण दिए गए हैं (तथा 100 Mbps, 10 Gbps आदि अन्य दरें भी होती हैं)।"},"num":64},{"id":"q65","q":{"en":"What is the role of a 'Network Repeater' and at which OSI layer does a classic repeater operate?","hi":"'नेटवर्क रिपीटर' (Network Repeater) की क्या भूमिका है और क्लासिक रिपीटर किस OSI लेयर पर काम करता है?"},"a":{"en":"It regenerates weakened/attenuated digital signals to extend a network link over a longer distance; a classic repeater operates at the OSI Physical Layer (Layer 1)","hi":"यह कमजोर डिजिटल सिग्नल को रीजेनरेट (पुनर्जीवित) करके लिंक को अधिक दूरी तक बढ़ाता है; क्लासिक रिपीटर OSI फिजिकल लेयर (Layer 1) पर काम करता है"},"o":[{"en":"It regenerates weakened/attenuated digital signals to extend a network link over a longer distance; a classic repeater operates at the OSI Physical Layer (Layer 1)","hi":"यह कमजोर डिजिटल सिग्नल को रीजेनरेट (पुनर्जीवित) करके लिंक को अधिक दूरी तक बढ़ाता है; क्लासिक रिपीटर OSI फिजिकल लेयर (Layer 1) पर काम करता है"},{"en":"It routes packets between different IP networks at OSI Layer 3","hi":"यह OSI लेयर 3 पर विभिन्न IP नेटवर्कों के बीच पैकेट रूट करता है"},{"en":"It encrypts web pages at the Application Layer (Layer 7)","hi":"यह एप्लिकेशन लेयर (Layer 7) पर वेब पेजों को एन्क्रिप्ट करता है"},{"en":"It filters frames using MAC address tables at Layer 2","hi":"यह लेयर 2 पर MAC एड्रेस टेबल का उपयोग करके फ्रेम को फ़िल्टर करता है"}],"exp":{"en":"A network repeater receives weakened/attenuated signals, cleans and regenerates them bit-by-bit, and retransmits them to extend the physical reach of a medium; it operates at Layer 1 (Physical Layer) of the OSI model.","hi":"रिपीटर कमजोर हो चुके डिजिटल सिग्नल को रीजेनरेट (regenerate) करके नेटवर्क लिंक को लंबी दूरी तक बढ़ाता है। क्लासिक रिपीटर OSI मॉडल की फिजिकल लेयर (Layer 1) पर कार्य करता है।"},"num":65},{"id":"q66","q":{"en":"What does a 'Network Hub' do, and at which OSI layer does a legacy Ethernet hub operate?","hi":"'नेटवर्क हब' (Hub) क्या करता है और लेगेसी ईथरनेट हब किस OSI लेयर पर काम करता है?"},"a":{"en":"It repeats/broadcasts a signal received on one port out to all other connected ports; a legacy Ethernet hub is a Physical Layer (Layer 1) multiport repeater","hi":"यह एक पोर्ट पर प्राप्त सिग्नल को बाकी सभी पोर्ट्स पर रिपीट (प्रसारित) कर देता है; लेगेसी ईथरनेट हब एक फिजिकल लेयर (Layer 1) उपकरण है"},"o":[{"en":"It inspects IP addresses and sends packets only to the fastest internet route at Layer 3","hi":"यह IP पतों की जाँच करता है और लेयर 3 पर केवल सबसे तेज़ इंटरनेट मार्ग पर पैकेट भेजता है"},{"en":"It repeats/broadcasts a signal received on one port out to all other connected ports; a legacy Ethernet hub is a Physical Layer (Layer 1) multiport repeater","hi":"यह एक पोर्ट पर प्राप्त सिग्नल को बाकी सभी पोर्ट्स पर रिपीट (प्रसारित) कर देता है; लेगेसी ईथरनेट हब एक फिजिकल लेयर (Layer 1) उपकरण है"},{"en":"It learns MAC addresses and isolates every port into a separate collision domain","hi":"यह MAC पते सीखता है और प्रत्येक पोर्ट को एक अलग कोलिजन डोमेन में अलग करता है"},{"en":"It blocks malware and viruses at the Application Layer","hi":"यह एप्लिकेशन लेयर पर मैलवेयर और वायरस को ब्लॉक करता है"}],"exp":{"en":"An Ethernet hub acts as a multiport repeater at the Physical Layer (OSI Layer 1): any signal arriving on one port is blindly regenerated and flooded out to all other active ports.","hi":"हब (Hub) किसी एक पोर्ट पर प्राप्त सिग्नल को बाकी सभी जुड़े हुए पोर्ट्स पर रिपीट (भेज) कर देता है। लेगेसी ईथरनेट हब OSI की फिजिकल लेयर (Layer 1) पर काम करने वाला उपकरण है।"},"num":66},{"id":"q67","q":{"en":"Why do packet collisions occur in a network connected via a legacy 'Hub'?","hi":"हब (Hub) से जुड़े नेटवर्क में डेटा टकराव (Collision) क्यों हो सकता है?"},"a":{"en":"Because all devices connected to a hub share a single collision domain, so simultaneous transmissions on the shared half-duplex medium interfere with each other","hi":"क्योंकि हब से जुड़े सभी उपकरण एक ही साझा कोलिजन डोमेन (shared collision domain) का उपयोग करते हैं, जिससे हाफ-डुप्लेक्स माध्यम पर एक साथ भेजे गए सिग्नल आपस में टकरा जाते हैं"},"o":[{"en":"Because all devices connected to a hub share a single collision domain, so simultaneous transmissions on the shared half-duplex medium interfere with each other","hi":"क्योंकि हब से जुड़े सभी उपकरण एक ही साझा कोलिजन डोमेन (shared collision domain) का उपयोग करते हैं, जिससे हाफ-डुप्लेक्स माध्यम पर एक साथ भेजे गए सिग्नल आपस में टकरा जाते हैं"},{"en":"Because a hub has too much RAM and CPU cache","hi":"क्योंकि हब में बहुत अधिक RAM और CPU कैश होती है"},{"en":"Because a hub uses full-duplex fiber routing tables","hi":"क्योंकि हब फुल-डुप्लेक्स फाइबर रूटिंग टेबल का उपयोग करता है"},{"en":"Because a hub only allows one computer to be plugged in","hi":"क्योंकि हब केवल एक कंप्यूटर को प्लग इन करने की अनुमति देता है"}],"exp":{"en":"All ports on a legacy hub belong to a single shared collision domain operating in half-duplex mode; if two nodes transmit frames at the same time, their electrical signals collide on the shared medium.","hi":"हब से जुड़े सभी उपकरण एक साझा कोलिजन डोमेन (shared collision domain) का उपयोग करते हैं। हाफ-डुप्लेक्स माध्यम पर जब दो डिवाइस एक ही समय में डेटा भेजते हैं, तो सिग्नल आपस में टकरा (collide) जाते हैं।"},"num":67},{"id":"q68","q":{"en":"What is the main role of a 'Network Switch' (specifically an ordinary Layer-2 Ethernet Switch)?","hi":"'नेटवर्क स्विच' (Switch) की मुख्य भूमिका क्या है?"},"a":{"en":"It connects LAN devices and selectively forwards frames by looking up the destination MAC address in its MAC address table (operating at OSI Layer 2)","hi":"यह LAN उपकरणों को जोड़ता है और अपनी टेबल में गंतव्य MAC पता (destination MAC address) देखकर फ्रेम्स को आगे भेजता है (Layer 2 स्विच)"},"o":[{"en":"It connects LAN devices and selectively forwards frames by looking up the destination MAC address in its MAC address table (operating at OSI Layer 2)","hi":"यह LAN उपकरणों को जोड़ता है और अपनी टेबल में गंतव्य MAC पता (destination MAC address) देखकर फ्रेम्स को आगे भेजता है (Layer 2 स्विच)"},{"en":"It converts digital data into analog telephone tones for 1980s phone lines","hi":"यह 1980 के दशक की फोन लाइनों के लिए डिजिटल डेटा को एनालॉग टेलीफोन टोन में बदलता है"},{"en":"It blindly broadcasts every electrical bit to all ports without reading frame headers","hi":"यह फ्रेम हेडर पढ़े बिना हर इलेक्ट्रिकल बिट को सभी पोर्ट्स पर अंधाधुंध प्रसारित करता है"},{"en":"It only regenerates analog TV signals over coaxial antennas","hi":"यह केवल कोएक्सियल एंटीना पर एनालॉग टीवी सिग्नल को रीजेनरेट करता है"}],"exp":{"en":"A Layer-2 Ethernet switch connects devices within a LAN and intelligently forwards data frames to the specific target port by inspecting the destination MAC address against its forwarding (MAC) table.","hi":"स्विच (Switch) LAN उपकरणों को आपस में जोड़कर डेटा फ्रेम्स को फॉरवर्ड करता है। एक सामान्य ईथरनेट लेयर-2 स्विच अपनी MAC एड्रेस टेबल में गंतव्य MAC पता (destination MAC address) देखकर सही पोर्ट पर फ्रेम भेजता है।"},"num":68},{"id":"q69","q":{"en":"How does an Ethernet Switch dynamically build (learn) its MAC address table and forward known frames?","hi":"एक स्विच (Switch) अपनी MAC एड्रेस टेबल कैसे सीखता (learn) है और ज्ञात गंतव्य के लिए पोर्ट कैसे चुनता है?"},"a":{"en":"It associates each incoming frame's source MAC address with its ingress (incoming) port, and uses the destination MAC address to select the matching output port","hi":"यह आने वाले फ्रेम के सोर्स MAC पते को उसके इनकमिंग पोर्ट (ingress port) के साथ जोड़कर सीखता है, और ज्ञात गंतव्य MAC के लिए संबंधित आउटपुट पोर्ट चुनता है"},"o":[{"en":"It associates each incoming frame's source MAC address with its ingress (incoming) port, and uses the destination MAC address to select the matching output port","hi":"यह आने वाले फ्रेम के सोर्स MAC पते को उसके इनकमिंग पोर्ट (ingress port) के साथ जोड़कर सीखता है, और ज्ञात गंतव्य MAC के लिए संबंधित आउटपुट पोर्ट चुनता है"},{"en":"Every user must manually type all MAC addresses into the switch using a floppy disk","hi":"प्रत्येक उपयोगकर्ता को फ्लॉपी डिस्क का उपयोग करके स्विच में सभी MAC पते मैन्युअल रूप से टाइप करने पड़ते हैं"},{"en":"It queries Google Search to find the MAC address of every computer","hi":"यह प्रत्येक कंप्यूटर का MAC पता खोजने के लिए गूगल सर्च से पूछता है"},{"en":"It only reads IPv6 addresses and ignores MAC addresses completely","hi":"यह केवल IPv6 पते पढ़ता है और MAC पतों को पूरी तरह से अनदेखा करता है"}],"exp":{"en":"A switch learns MAC addresses dynamically by examining the Source MAC address of each incoming frame and recording the port it arrived on (ingress port); when forwarding, it looks up the frame's Destination MAC address in that table to send it out the specific egress port.","hi":"स्विच आने वाले (incoming) फ्रेम के सोर्स MAC पते (source MAC) और जिस पोर्ट से वह आया है (ingress port) को आपस में जोड़कर अपनी टेबल बनाता है, तथा ज्ञात गंतव्य MAC के लिए टेबल देखकर सही आउटपुट पोर्ट चुनता है।"},"num":69},{"id":"q70","q":{"en":"Does a Switch always send every single frame to only one selected port?","hi":"क्या स्विच (Switch) हर फ्रेम को हमेशा केवल एक ही चुने हुए पोर्ट पर भेजता है?"},"a":{"en":"Known unicast frames are sent only to the single target port, whereas broadcast frames and unknown unicast frames are flooded out to all applicable ports in the same VLAN","hi":"ज्ञात यूनिकास्ट (known unicast) फ्रेम केवल एक गंतव्य पोर्ट पर जाता है, जबकि ब्रॉडकास्ट और अज्ञात यूनिकास्ट (unknown unicast) फ्रेम समान VLAN के सभी संबंधित पोर्ट्स पर फ्लड (flood) किए जाते हैं"},"o":[{"en":"Known unicast frames are sent only to the single target port, whereas broadcast frames and unknown unicast frames are flooded out to all applicable ports in the same VLAN","hi":"ज्ञात यूनिकास्ट (known unicast) फ्रेम केवल एक गंतव्य पोर्ट पर जाता है, जबकि ब्रॉडकास्ट और अज्ञात यूनिकास्ट (unknown unicast) फ्रेम समान VLAN के सभी संबंधित पोर्ट्स पर फ्लड (flood) किए जाते हैं"},{"en":"Yes, even broadcast frames are sent to only one random port","hi":"हाँ, यहाँ तक कि ब्रॉडकास्ट फ्रेम भी केवल एक रैंडम पोर्ट पर भेजे जाते हैं"},{"en":"No, a switch always sends every frame to all ports just like a passive hub","hi":"नहीं, एक स्विच हमेशा पैसिव हब की तरह हर फ्रेम को सभी पोर्ट्स पर भेजता है"},{"en":"A switch drops all broadcast and unknown unicast frames immediately","hi":"एक स्विच सभी ब्रॉडकास्ट और अज्ञात यूनिकास्ट फ्रेम को तुरंत ड्रॉप कर देता है"}],"exp":{"en":"While a switch forwards known unicast frames exclusively to the single destination port, it floods broadcast frames (FF:FF:FF:FF:FF:FF), multicast frames (by default), and unknown unicast frames (whose destination MAC is not yet in the table) to all other ports in the same VLAN.","hi":"ज्ञात यूनिकास्ट (known unicast) फ्रेम आमतौर पर केवल एक निर्धारित गंतव्य पोर्ट पर भेजा जाता है, परंतु ब्रॉडकास्ट (broadcast) और अज्ञात यूनिकास्ट (unknown unicast) फ्रेम उस VLAN के सभी लागू पोर्ट्स पर फ्लड (प्रसारित) किए जाते हैं।"},"num":70},{"id":"q71","q":{"en":"Why is a Switch often called an 'Intelligent Hub' in exam shorthand?","hi":"परीक्षा की भाषा में स्विच (Switch) को अक्सर 'इंटेलिजेंट हब' (Intelligent Hub) क्यों कहा जाता है?"},"a":{"en":"Because a switch uses its MAC address table for selective port forwarding, whereas a hub blindly repeats incoming signals to all other ports","hi":"क्योंकि स्विच MAC टेबल की मदद से चुनिंदा पोर्ट पर ही डेटा फॉरवर्ड करता है, जबकि हब प्राप्त सिग्नल को बिना सोचे-समझे बाकी सभी पोर्ट्स पर रिपीट कर देता है"},"o":[{"en":"Because a switch uses its MAC address table for selective port forwarding, whereas a hub blindly repeats incoming signals to all other ports","hi":"क्योंकि स्विच MAC टेबल की मदद से चुनिंदा पोर्ट पर ही डेटा फॉरवर्ड करता है, जबकि हब प्राप्त सिग्नल को बिना सोचे-समझे बाकी सभी पोर्ट्स पर रिपीट कर देता है"},{"en":"Because a switch can write C++ programs by itself","hi":"क्योंकि एक स्विच अपने आप C++ प्रोग्राम लिख सकता है"},{"en":"Because a hub operates at Layer 7 while a switch operates at Layer 1","hi":"क्योंकि हब लेयर 7 पर काम करता है जबकि स्विच लेयर 1 पर काम करता है"},{"en":"Because a switch does not require electrical power to run","hi":"क्योंकि स्विच को चलने के लिए विद्युत शक्ति की आवश्यकता नहीं होती है"}],"exp":{"en":"In competitive exams, a switch is frequently referred to as an 'intelligent hub' because, unlike a dumb hub that broadcasts signals to every port, a switch inspects frame MAC addresses and forwards traffic selectively.","hi":"परीक्षा शॉर्टहैंड में स्विच को 'इंटेलिजेंट हब' इसलिए कहते हैं क्योंकि हब प्राप्त सिग्नल को सभी पोर्ट्स पर रिपीट करता है, जबकि स्विच MAC टेबल का उपयोग कर केवल सही गंतव्य पोर्ट पर सेलेक्टिव फॉरवर्डिंग करता है।"},"num":71},{"id":"q72","q":{"en":"What is the primary function of a 'Router'?","hi":"'राउटर' (Router) का मुख्य कार्य क्या है?"},"a":{"en":"It routes data packets between different IP networks (such as between a home LAN and the Internet) using destination IP addresses and a routing table","hi":"यह विभिन्न IP नेटवर्कों के बीच (जैसे होम LAN और इंटरनेट के बीच) गंतव्य IP पते और रूटिंग टेबल का उपयोग करके पैकेट्स को रूट (महार्ग निर्देशित) करता है"},"o":[{"en":"It routes data packets between different IP networks (such as between a home LAN and the Internet) using destination IP addresses and a routing table","hi":"यह विभिन्न IP नेटवर्कों के बीच (जैसे होम LAN और इंटरनेट के बीच) गंतव्य IP पते और रूटिंग टेबल का उपयोग करके पैकेट्स को रूट (महार्ग निर्देशित) करता है"},{"en":"It only amplifies weak electrical voltages on a single copper wire without reading addresses","hi":"यह पतों को पढ़े बिना एक तांबे के तार पर केवल कमजोर विद्युत वोल्टेज को बढ़ाता है"},{"en":"It connects a wired mouse to a PS/2 port","hi":"यह एक वायर्ड माउस को PS/2 पोर्ट से जोड़ता है"},{"en":"It acts as a passive terminator at the end of a coaxial bus cable","hi":"यह कोएक्सियल बस केबल के अंत में एक पैसिव टर्मिनेटर के रूप में कार्य करता है"}],"exp":{"en":"A router is a Layer-3 (Network Layer) device that interconnects different IP networks/subnets (e.g., connecting a local LAN to the WAN/Internet) and determines the best path to forward packets based on destination IP addresses and its routing table.","hi":"राउटर (Router) अलग-अलग IP नेटवर्कों (जैसे होम LAN और इंटरनेट) के बीच डेटा पैकेट्स को रूट करता है। इसके लिए यह मुख्य रूप से गंतव्य IP पते (destination IP) और अपनी रूटिंग टेबल का उपयोग करता है।"},"num":72},{"id":"q73","q":{"en":"What is the standard exam distinction between an ordinary Layer-2 Switch and a Router?","hi":"एक सामान्य लेयर-2 स्विच (Switch) और राउटर (Router) के बीच मुख्य परीक्षा अंतर क्या है?"},"a":{"en":"An ordinary Layer-2 switch forwards frames within a LAN based on MAC addresses, whereas a router forwards packets between different networks based on IP addresses","hi":"सामान्य लेयर-2 स्विच LAN के भीतर MAC पतों के आधार पर फ्रेम्स फॉरवर्ड करता है, जबकि राउटर विभिन्न नेटवर्कों के बीच IP पतों के आधार पर पैकेट्स फॉरवर्ड करता है"},"o":[{"en":"An ordinary Layer-2 switch forwards frames within a LAN based on MAC addresses, whereas a router forwards packets between different networks based on IP addresses","hi":"सामान्य लेयर-2 स्विच LAN के भीतर MAC पतों के आधार पर फ्रेम्स फॉरवर्ड करता है, जबकि राउटर विभिन्न नेटवर्कों के बीच IP पतों के आधार पर पैकेट्स फॉरवर्ड करता है"},{"en":"A switch uses IP addresses at Layer 3, whereas a router uses MAC addresses at Layer 1","hi":"स्विच लेयर 3 पर IP पतों का उपयोग करता है, जबकि राउटर लेयर 1 पर MAC पतों का उपयोग करता है"},{"en":"A switch connects continents, whereas a router only connects two keyboards","hi":"स्विच महाद्वीपों को जोड़ता है, जबकि राउटर केवल दो कीबोर्ड को जोड़ता है"},{"en":"There is no difference between a switch and a router","hi":"स्विच और राउटर में कोई अंतर नहीं है"}],"exp":{"en":"Exam key distinction: An ordinary switch is a Data Link Layer (Layer 2) device that forwards frames within the same LAN using MAC addresses; a router is a Network Layer (Layer 3) device that routes packets across different networks using IP addresses.","hi":"परीक्षा के लिए मुख्य अंतर: एक सामान्य लेयर-2 स्विच LAN के अंदर MAC एड्रेस के आधार पर फ्रेम्स (frames) फॉरवर्ड करता है, जबकि राउटर (Layer 3) अलग-अलग नेटवर्कों के बीच IP एड्रेस के आधार पर पैकेट्स (packets) फॉरवर्ड करता है।"},"num":73},{"id":"q74","q":{"en":"What can an IPv4 Router do if the outgoing link's MTU (Maximum Transmission Unit) is smaller than the packet size?","hi":"यदि आगे के लिंक का MTU (Maximum Transmission Unit) पैकेट के आकार से छोटा हो, तो IPv4 राउटर क्या कर सकता है?"},"a":{"en":"If fragmentation is allowed, the router splits the packet into smaller fragments; if the 'Don't Fragment' (DF) flag is set, it drops the oversized packet and sends an ICMP error message","hi":"यदि विखंडन (fragmentation) की अनुमति है, तो राउटर पैकेट के छोटे टुकड़े (fragments) कर सकता है; और यदि 'Don’t Fragment' (DF) सेट है, तो पैकेट ड्रॉप करके त्रुटि संदेश भेज सकता है"},"o":[{"en":"If fragmentation is allowed, the router splits the packet into smaller fragments; if the 'Don't Fragment' (DF) flag is set, it drops the oversized packet and sends an ICMP error message","hi":"यदि विखंडन (fragmentation) की अनुमति है, तो राउटर पैकेट के छोटे टुकड़े (fragments) कर सकता है; और यदि 'Don’t Fragment' (DF) सेट है, तो पैकेट ड्रॉप करके त्रुटि संदेश भेज सकता है"},{"en":"It physically stretches the copper cable to make it wider","hi":"यह तांबे की केबल को चौड़ा करने के लिए उसे भौतिक रूप से खींचता है"},{"en":"It converts the IPv4 packet into an analog audio cassette","hi":"यह IPv4 पैकेट को एनालॉग ऑडियो कैसेट में बदल देता है"},{"en":"It shuts down the entire router permanently","hi":"यह पूरे राउटर को स्थायी रूप से बंद कर देता है"}],"exp":{"en":"In IPv4, if a packet exceeds the next-hop link's MTU and the DF (Don't Fragment) bit is not set, the router fragments the packet into smaller pieces; if the DF bit is set (DF=1), the router discards the packet and returns an ICMP 'Fragmentation Needed' error.","hi":"यदि अगले लिंक का MTU छोटा हो और विखंडन (fragmentation) की अनुमति हो, तो IPv4 राउटर पैकेट को छोटे टुकड़ों (fragments) में बाँट सकता है। यदि 'Don't Fragment' (DF) फ्लैग सेट हो, तो वह बड़े पैकेट को ड्रॉप कर देता है और ICMP एरर सिग्नल भेजता है।"},"num":74},{"id":"q75","q":{"en":"Do IPv6 routers perform packet fragmentation in transit like IPv4 routers?","hi":"क्या IPv6 राउटर भी मार्ग में पैकेट्स को फ्रैग्मेंट (Fragment) करते हैं?"},"a":{"en":"No—in IPv6, routers do not fragment packets; fragmentation is performed only by the source endpoint, and routers send an ICMPv6 'Packet Too Big' message for oversized packets","hi":"नहीं—IPv6 में विखंडन (fragmentation) केवल सोर्स एंडपॉइंट द्वारा किया जाता है; बड़े पैकेट के लिए राउटर ICMPv6 'Packet Too Big' संदेश भेजता है"},"o":[{"en":"No—in IPv6, routers do not fragment packets; fragmentation is performed only by the source endpoint, and routers send an ICMPv6 'Packet Too Big' message for oversized packets","hi":"नहीं—IPv6 में विखंडन (fragmentation) केवल सोर्स एंडपॉइंट द्वारा किया जाता है; बड़े पैकेट के लिए राउटर ICMPv6 'Packet Too Big' संदेश भेजता है"},{"en":"Yes, IPv6 routers fragment every single packet into 1-byte pieces","hi":"हाँ, IPv6 राउटर हर एक पैकेट को 1-बाइट के टुकड़ों में विभाजित करते हैं"},{"en":"IPv6 does not use routers at all","hi":"IPv6 में राउटर का उपयोग बिल्कुल नहीं होता है"},{"en":"IPv6 routers delete the source computer's hard drive when a packet is large","hi":"पैकेट बड़ा होने पर IPv6 राउटर सोर्स कंप्यूटर की हार्ड ड्राइव को डिलीट कर देते हैं"}],"exp":{"en":"Unlike IPv4, intermediate IPv6 routers never fragment packets in transit; if an IPv6 packet is larger than the next-hop MTU, the router drops it and sends an ICMPv6 'Packet Too Big' message back to the source host, which performs fragmentation using Path MTU Discovery.","hi":"नहीं, IPv6 में मध्यवर्ती राउटर पैकेट का विखंडन (fragmentation) नहीं करते; विखंडन केवल मूल प्रेषक (source endpoint) द्वारा किया जाता है। बड़े पैकेट के लिए IPv6 राउटर 'ICMPv6 Packet Too Big' संदेश भेजता है।"},"num":75},{"id":"q76","q":{"en":"What is a 'Default Gateway' in a computer's network configuration?","hi":"कंप्यूटर के नेटवर्क कॉन्फ़िगरेशन में 'डिफ़ॉल्ट गेटवे' (Default Gateway) क्या होता है?"},"a":{"en":"The host's default next-hop router to which packets destined for remote/off-network IP addresses are sent (while local-subnet traffic goes directly)","hi":"बाहरी नेटवर्क (off-network) के गंतव्यों वाले पैकेट्स को भेजने के लिए होस्ट का डिफ़ॉल्ट नेक्स्ट-हॉप राउटर (जबकि लोकल-सबनेट ट्रैफिक सीधे जा सकता है)"},"o":[{"en":"The host's default next-hop router to which packets destined for remote/off-network IP addresses are sent (while local-subnet traffic goes directly)","hi":"बाहरी नेटवर्क (off-network) के गंतव्यों वाले पैकेट्स को भेजने के लिए होस्ट का डिफ़ॉल्ट नेक्स्ट-हॉप राउटर (जबकि लोकल-सबनेट ट्रैफिक सीधे जा सकता है)"},{"en":"The main power switch on the wall socket of the computer lab","hi":"कंप्यूटर लैब के वॉल सॉकेट पर लगा मुख्य पावर स्विच"},{"en":"The default wallpaper image on the Windows desktop","hi":"विंडोज डेस्कटॉप पर डिफ़ॉल्ट वॉलपेपर छवि"},{"en":"A local printer that has no network connection","hi":"एक लोकल प्रिंटर जिसका कोई नेटवर्क कनेक्शन नहीं है"}],"exp":{"en":"A Default Gateway is the IP address of the local router interface to which a host forwards all packets addressed to destinations outside its own local subnet.","hi":"किसी होस्ट कंप्यूटर द्वारा अपने लोकल सबनेट से बाहर (off-network destinations) के पैकेट्स को भेजने के लिए जिस डिफ़ॉल्ट नेक्स्ट-हॉप राउटर का उपयोग किया जाता है, उसे डिफ़ॉल्ट गेटवे (Default Gateway) कहते हैं।"},"num":76},{"id":"q77","q":{"en":"What does a general 'Network Gateway' (or Application/Protocol Gateway) do?","hi":"एक सामान्य 'नेटवर्क गेटवे' (General Network Gateway) क्या कार्य करता है?"},"a":{"en":"It connects two different networks or environments, and an application/protocol gateway can translate between different protocols or data formats (implemented in software, hardware, or both)","hi":"यह विभिन्न नेटवर्कों या वातावरणों को जोड़ता है, और आवश्यकता पड़ने पर प्रोटोकॉल या डेटा फॉर्मेट का अनुवाद (translate) कर सकता है (इसमें सॉफ्टवेयर, हार्डवेयर या दोनों का उपयोग हो सकता है)"},"o":[{"en":"It connects two different networks or environments, and an application/protocol gateway can translate between different protocols or data formats (implemented in software, hardware, or both)","hi":"यह विभिन्न नेटवर्कों या वातावरणों को जोड़ता है, और आवश्यकता पड़ने पर प्रोटोकॉल या डेटा फॉर्मेट का अनुवाद (translate) कर सकता है (इसमें सॉफ्टवेयर, हार्डवेयर या दोनों का उपयोग हो सकता है)"},{"en":"It only connects identical coaxial cables at Layer 1 without any protocol awareness","hi":"यह बिना किसी प्रोटोकॉल जानकारी के लेयर 1 पर केवल समान कोएक्सियल केबलों को जोड़ता है"},{"en":"It is a mechanical gate installed at the entrance of an office building","hi":"यह किसी ऑफिस बिल्डिंग के प्रवेश द्वार पर लगा एक यांत्रिक गेट है"},{"en":"It only stores deleted emails offline","hi":"यह केवल हटाए गए ईमेल को ऑफलाइन स्टोर करता है"}],"exp":{"en":"A network gateway serves as an entry/exit point connecting disparate networks or architectures; protocol/application gateways can also perform protocol conversion and data format translation across OSI layers using hardware, software, or both.","hi":"नेटवर्क गेटवे दो अलग-अलग नेटवर्कों या वातावरणों को जोड़ता है। एप्लिकेशन या प्रोटोकॉल गेटवे आवश्यकतानुसार विभिन्न प्रोटोकॉल या फॉर्मेट्स को ट्रांसलेट (बदल) भी सकता है, और इसे हार्डवेयर, सॉफ्टवेयर या दोनों से बनाया जा सकता है।"},"num":77},{"id":"q78","q":{"en":"At which OSI layer does a 'Network Bridge' operate, and what is its main function?","hi":"'नेटवर्क ब्रिज' (Bridge) किस OSI लेयर पर और क्या काम करता है?"},"a":{"en":"OSI Layer 2 (Data Link Layer) — it connects LAN segments and filters/forwards frames based on MAC addresses","hi":"OSI लेयर 2 (डेटा लिंक लेयर) — यह LAN सेगमेंट्स को जोड़ता है और MAC पतों (MAC addresses) के आधार पर फ्रेम्स को फ़िल्टर/फॉरवर्ड करता है"},"o":[{"en":"OSI Layer 2 (Data Link Layer) — it connects LAN segments and filters/forwards frames based on MAC addresses","hi":"OSI लेयर 2 (डेटा लिंक लेयर) — यह LAN सेगमेंट्स को जोड़ता है और MAC पतों (MAC addresses) के आधार पर फ्रेम्स को फ़िल्टर/फॉरवर्ड करता है"},{"en":"OSI Layer 1 (Physical Layer) — it blindly amplifies analog radio signals","hi":"OSI लेयर 1 (फिजिकल लेयर) — यह एनालॉग रेडियो सिग्नलों को बिना जाँचे बढ़ाता है"},{"en":"OSI Layer 7 (Application Layer) — it renders HTML web pages in a browser","hi":"OSI लेयर 7 (एप्लिकेशन लेयर) — यह ब्राउज़र में HTML वेब पेज रेंडर करता है"},{"en":"OSI Layer 3 (Network Layer) — it assigns public IPv6 addresses globally","hi":"OSI लेयर 3 (नेटवर्क लेयर) — यह वैश्विक स्तर पर पब्लिक IPv6 पते आवंटित करता है"}],"exp":{"en":"A Bridge operates at OSI Layer 2 (Data Link Layer); it interconnects two or more LAN segments and uses MAC addresses to filter traffic, forwarding only frames that need to cross between segments (thereby dividing collision domains).","hi":"ब्रिज (Bridge) OSI मॉडल की लेयर 2 (Data Link Layer) पर काम करता है। यह अलग-अलग LAN सेगमेंट्स को जोड़ता है और MAC एड्रेस के आधार पर डेटा फ्रेम्स को फ़िल्टर व फॉरवर्ड करता है।"},"num":78},{"id":"q79","q":{"en":"Which option correctly matches Repeater/Hub, Bridge/Switch, and IP Router with their primary OSI layers?","hi":"रिपीटर/हब, ब्रिज/स्विच और राउटर का उनकी संबंधित मुख्य OSI लेयर्स के साथ सही मिलान कौन-सा है?"},"a":{"en":"Repeater/Hub → Layer 1 (Physical); Bridge/Ordinary Ethernet Switch → Layer 2 (Data Link); IP Router → Layer 3 (Network)","hi":"रिपीटर/हब → लेयर 1 (फिजिकल); ब्रिज/सामान्य ईथरनेट स्विच → लेयर 2 (डेटा लिंक); IP राउटर → लेयर 3 (नेटवर्क)"},"o":[{"en":"Repeater/Hub → Layer 1 (Physical); Bridge/Ordinary Ethernet Switch → Layer 2 (Data Link); IP Router → Layer 3 (Network)","hi":"रिपीटर/हब → लेयर 1 (फिजिकल); ब्रिज/सामान्य ईथरनेट स्विच → लेयर 2 (डेटा लिंक); IP राउटर → लेयर 3 (नेटवर्क)"},{"en":"Repeater/Hub → Layer 3; Bridge/Switch → Layer 1; IP Router → Layer 2","hi":"रिपीटर/हब → लेयर 3; ब्रिज/स्विच → लेयर 1; IP राउटर → लेयर 2"},{"en":"Repeater/Hub → Layer 7; Bridge/Switch → Layer 5; IP Router → Layer 4","hi":"रिपीटर/हब → लेयर 7; ब्रिज/स्विच → लेयर 5; IP राउटर → लेयर 4"},{"en":"All of them operate exclusively at Layer 1 (Physical Layer)","hi":"ये सभी केवल लेयर 1 (फिजिकल लेयर) पर ही काम करते हैं"}],"exp":{"en":"Standard OSI layer mapping for exams: Repeaters and Hubs operate at Layer 1 (Physical Layer, bits/signals); Bridges and standard Ethernet Switches operate at Layer 2 (Data Link Layer, frames/MAC addresses); IP Routers operate at Layer 3 (Network Layer, packets/IP addresses).","hi":"सही मिलान है: रिपीटर और हब → लेयर 1 (फिजिकल लेयर); ब्रिज और सामान्य ईथरनेट स्विच → लेयर 2 (डेटा लिंक लेयर); तथा IP राउटर → लेयर 3 (नेटवर्क लेयर)।"},"num":79},{"id":"q80","q":{"en":"What is the key difference between a 'Bridge' and a 'Router'?","hi":"'ब्रिज' (Bridge) और 'राउटर' (Router) में मुख्य अंतर क्या है?"},"a":{"en":"A Bridge handles frames between LAN segments at Layer 2 using MAC addresses, whereas a Router routes packets between different IP networks at Layer 3 using IP addresses","hi":"ब्रिज लेयर 2 पर MAC पतों की मदद से LAN सेगमेंट्स के बीच फ्रेम्स (frames) संभालता है, जबकि राउटर लेयर 3 पर IP पतों की मदद से विभिन्न IP नेटवर्कों के बीच पैकेट्स (packets) रूट करता है"},"o":[{"en":"A Bridge handles frames between LAN segments at Layer 2 using MAC addresses, whereas a Router routes packets between different IP networks at Layer 3 using IP addresses","hi":"ब्रिज लेयर 2 पर MAC पतों की मदद से LAN सेगमेंट्स के बीच फ्रेम्स (frames) संभालता है, जबकि राउटर लेयर 3 पर IP पतों की मदद से विभिन्न IP नेटवर्कों के बीच पैकेट्स (packets) रूट करता है"},{"en":"A Bridge uses IP addresses across continents, while a Router uses coaxial terminators","hi":"ब्रिज महाद्वीपों के पार IP पतों का उपयोग करता है, जबकि राउटर कोएक्सियल टर्मिनेटर का उपयोग करता है"},{"en":"A Bridge is a software virus, while a Router is an antivirus program","hi":"ब्रिज एक सॉफ्टवेयर वायरस है, जबकि राउटर एक एंटीवायरस प्रोग्राम है"},{"en":"A Bridge works at Layer 3, while a Router works at Layer 1","hi":"ब्रिज लेयर 3 पर काम करता है, जबकि राउटर लेयर 1 पर काम करता है"}],"exp":{"en":"A Bridge connects segments belonging to the same logical network/LAN at Layer 2 by examining MAC addresses in frames, whereas a Router connects distinct networks at Layer 3 by examining logical IP addresses in packets.","hi":"ब्रिज (Bridge) एक ही नेटवर्क के LAN सेगमेंट्स के बीच MAC पतों के आधार पर फ्रेम्स (frames) को फॉरवर्ड करता है, जबकि राउटर (Router) अलग-अलग IP नेटवर्कों के बीच IP पतों के आधार पर पैकेट्स (packets) को रूट करता है।"},"num":80}]},{"title":{"en":"6. Protocols, MAC Address & IP Address","hi":"6. प्रोटोकॉल, MAC और IP एड्रेस"},"questions":[{"id":"q81","q":{"en":"What is a 'Network Protocol'?","hi":"'नेटवर्क प्रोटोकॉल' (Network Protocol) क्या होता है?"},"a":{"en":"A set of agreed communication rules governing message structure, addressing, timing, and delivery behavior","hi":"डेटा संचार के नियम (rules), जैसे संदेश की संरचना (message structure), एड्रेसिंग या डिलीवरी व्यवहार"},"o":[{"en":"A set of agreed communication rules governing message structure, addressing, timing, and delivery behavior","hi":"डेटा संचार के नियम (rules), जैसे संदेश की संरचना (message structure), एड्रेसिंग या डिलीवरी व्यवहार"},{"en":"A physical copper cable with RJ-45 connectors at both ends","hi":"दोनों सिरों पर RJ-45 कनेक्टर वाली एक भौतिक तांबे की केबल"},{"en":"An uninterrupted power supply battery for servers","hi":"सर्वरों के लिए एक निर्बाध पावर सप्लाई बैटरी"},{"en":"A hardware cooling fan inside a laptop","hi":"लैपटॉप के अंदर लगा एक हार्डवेयर कूलिंग फैन"}],"exp":{"en":"A network protocol is a formal set of rules and conventions that govern how devices format, address, transmit, receive, and acknowledge data across a network.","hi":"नेटवर्क प्रोटोकॉल डेटा संचार के लिए निर्धारित नियमों (rules) का समूह है, जो संदेश की संरचना (message structure), एड्रेसिंग और डिलीवरी व्यवहार को तय करता है।"},"num":81},{"id":"q82","q":{"en":"What are the primary uses of 'TCP/IP', 'HTTP', and 'HTTPS'?","hi":"'TCP/IP', 'HTTP' और 'HTTPS' का मुख्य उपयोग क्या है?"},"a":{"en":"TCP/IP is the foundational Internet protocol suite; HTTP is used for Web request-response communication; HTTPS is TLS-protected (encrypted) HTTP","hi":"TCP/IP इंटरनेट प्रोटोकॉल सूट है; HTTP वेब रिक्वेस्ट-रिस्पॉन्स के लिए है; और HTTPS सुरक्षित (TLS-protected) HTTP है"},"o":[{"en":"TCP/IP is the foundational Internet protocol suite; HTTP is used for Web request-response communication; HTTPS is TLS-protected (encrypted) HTTP","hi":"TCP/IP इंटरनेट प्रोटोकॉल सूट है; HTTP वेब रिक्वेस्ट-रिस्पॉन्स के लिए है; और HTTPS सुरक्षित (TLS-protected) HTTP है"},{"en":"All three are hardware cables used in coaxial bus topology","hi":"तीनों कोएक्सियल बस टोपोलॉजी में प्रयुक्त हार्डवेयर केबल हैं"},{"en":"TCP/IP is an antivirus, HTTP is a spreadsheet, and HTTPS is a printer driver","hi":"TCP/IP एक एंटीवायरस है, HTTP एक स्प्रेडशीट है, और HTTPS एक प्रिंटर ड्राइवर है"},{"en":"They are used exclusively for offline disk formatting","hi":"इनका उपयोग केवल ऑफलाइन डिस्क फॉर्मेटिंग के लिए किया जाता है"}],"exp":{"en":"TCP/IP (Transmission Control Protocol/Internet Protocol) is the core protocol suite of the Internet; HTTP (Hypertext Transfer Protocol) handles client-server web request-response traffic; HTTPS (HTTP Secure) secures HTTP communications using TLS/SSL encryption.","hi":"TCP/IP इंटरनेट का मुख्य प्रोटोकॉल सूट है, HTTP का उपयोग वर्ल्ड वाइड वेब (Web) पर रिक्वेस्ट-रिस्पॉन्स संचार के लिए होता है, और HTTPS एन्क्रिप्शन (TLS-protected) द्वारा सुरक्षित HTTP है।"},"num":82},{"id":"q83","q":{"en":"Which option correctly matches the protocols 'FTP', 'SMTP', 'POP3', and 'IMAP' with their respective roles?","hi":"'FTP', 'SMTP', 'POP3' और 'IMAP' प्रोटोकॉल का उनके कार्यों (Roles) के साथ सही मिलान कौन-सा है?"},"a":{"en":"FTP → File transfer; SMTP → Mail submission/relay (sending); POP3 → Mail retrieval (downloading); IMAP → Server mailbox access and synchronization","hi":"FTP → फ़ाइल ट्रांसफर; SMTP → ईमेल भेजना/रिले; POP3 → ईमेल प्राप्त/डाउनलोड करना; IMAP → सर्वर मेलबॉक्स एक्सेस और सिंक करना"},"o":[{"en":"FTP → File transfer; SMTP → Mail submission/relay (sending); POP3 → Mail retrieval (downloading); IMAP → Server mailbox access and synchronization","hi":"FTP → फ़ाइल ट्रांसफर; SMTP → ईमेल भेजना/रिले; POP3 → ईमेल प्राप्त/डाउनलोड करना; IMAP → सर्वर मेलबॉक्स एक्सेस और सिंक करना"},{"en":"FTP → Sending email; SMTP → File transfer; POP3 → Video streaming; IMAP → Disk partitioning","hi":"FTP → ईमेल भेजना; SMTP → फ़ाइल ट्रांसफर; POP3 → वीडियो स्ट्रीमिंग; IMAP → डिस्क पार्टीशनिंग"},{"en":"All four protocols are used exclusively for assigning MAC addresses","hi":"चारों प्रोटोकॉल केवल MAC एड्रेस आवंटित करने के लिए उपयोग किए जाते हैं"},{"en":"FTP → Voice calling; SMTP → Web browsing; POP3 → Cable TV; IMAP → Bluetooth pairing","hi":"FTP → वॉयस कॉलिंग; SMTP → वेब ब्राउज़िंग; POP3 → केबल टीवी; IMAP → ब्लूटूथ पेयरिंग"}],"exp":{"en":"FTP (File Transfer Protocol) transfers files between hosts; SMTP (Simple Mail Transfer Protocol) sends/relays outgoing emails; POP3 (Post Office Protocol v3) downloads emails from a mail server; IMAP (Internet Message Access Protocol) accesses and synchronizes emails directly on the mail server.","hi":"सही मिलान है: FTP → फ़ाइल ट्रांसफर; SMTP → ईमेल सबमिट/रिले (भेजना); POP3 → सर्वर से ईमेल प्राप्त (retrieve) करना; तथा IMAP → सर्वर मेलबॉक्स को सीधे एक्सेस और सिंक (sync) करना।"},"num":83},{"id":"q84","q":{"en":"What is the full form of 'MAC' in networking?","hi":"नेटवर्किंग में 'MAC' का पूर्ण रूप (Full Form) क्या है?"},"a":{"en":"Media Access Control","hi":"मीडिया एक्सेस कंट्रोल (Media Access Control)"},"o":[{"en":"Media Access Control","hi":"मीडिया एक्सेस कंट्रोल (Media Access Control)"},{"en":"Master Analog Computer","hi":"मास्टर एनालॉग कंप्यूटर"},{"en":"Memory Address Counter","hi":"मेमोरी एड्रेस काउंटर"},{"en":"Multiple Application Channel","hi":"मल्टीपल एप्लिकेशन चैनल"}],"exp":{"en":"In computer networking, MAC stands for Media Access Control (a sublayer of the OSI Data Link Layer).","hi":"नेटवर्किंग में MAC का पूर्ण रूप Media Access Control (मीडिया एक्सेस कंट्रोल) है।"},"num":84},{"id":"q85","q":{"en":"What does a 'MAC Address' identify, and by what other names is it commonly known?","hi":"'MAC एड्रेस' (MAC Address) क्या पहचानता है और इसे अन्य किन नामों से जाना जाता है?"},"a":{"en":"It identifies a network interface (NIC) at the data-link/local network level; it is also called a physical address or hardware address","hi":"यह डेटा-लिंक या लोकल नेटवर्क स्तर पर किसी नेटवर्क इंटरफेस (NIC) की पहचान करता है; इसे फिजिकल एड्रेस या हार्डवेयर एड्रेस भी कहते हैं"},"o":[{"en":"It identifies a network interface (NIC) at the data-link/local network level; it is also called a physical address or hardware address","hi":"यह डेटा-लिंक या लोकल नेटवर्क स्तर पर किसी नेटवर्क इंटरफेस (NIC) की पहचान करता है; इसे फिजिकल एड्रेस या हार्डवेयर एड्रेस भी कहते हैं"},{"en":"It identifies the postal pin code of an internet user's city","hi":"यह इंटरनेट उपयोगकर्ता के शहर के डाक पिन कोड की पहचान करता है"},{"en":"It is a temporary password used for opening PDF files","hi":"यह PDF फ़ाइलों को खोलने के लिए प्रयुक्त एक अस्थायी पासवर्ड है"},{"en":"It identifies the clock speed of the ALU in gigahertz","hi":"यह गीगाहर्ट्ज़ में ALU की क्लॉक स्पीड की पहचान करता है"}],"exp":{"en":"A MAC address uniquely identifies a specific Network Interface Card/Controller (NIC) for communication on the local network segment (Data Link Layer) and is also referred to as a physical, hardware, or burned-in address.","hi":"MAC एड्रेस डेटा-लिंक (लेयर 2) या लोकल नेटवर्क स्तर पर किसी नेटवर्क इंटरफेस (NIC) की पहचान करने वाला पता है। इसे फिजिकल एड्रेस (Physical Address) या हार्डवेयर एड्रेस (Hardware Address) भी कहा जाता है।"},"num":85},{"id":"q86","q":{"en":"How many bits, bytes, and hexadecimal digits make up a standard Ethernet MAC address (e.g., 00:1A:2B:3C:4D:5E)?","hi":"एक सामान्य ईथरनेट MAC एड्रेस (उदा. 00:1A:2B:3C:4D:5E) कितने बिट्स, बाइट्स और हेक्साडेसिमल अंकों का होता है?"},"a":{"en":"48 bits, 6 bytes, or 12 hexadecimal digits (Example: 00:1A:2B:3C:4D:5E)","hi":"48 बिट्स, 6 बाइट्स, या 12 हेक्साडेसिमल अंक (उदाहरण: 00:1A:2B:3C:4D:5E)"},"o":[{"en":"32 bits, 4 bytes, or 8 hexadecimal digits","hi":"32 बिट्स, 4 बाइट्स, या 8 हेक्साडेसिमल अंक"},{"en":"48 bits, 6 bytes, or 12 hexadecimal digits (Example: 00:1A:2B:3C:4D:5E)","hi":"48 बिट्स, 6 बाइट्स, या 12 हेक्साडेसिमल अंक (उदाहरण: 00:1A:2B:3C:4D:5E)"},{"en":"128 bits, 16 bytes, or 32 hexadecimal digits","hi":"128 बिट्स, 16 बाइट्स, या 32 हेक्साडेसिमल अंक"},{"en":"64 bits, 8 bytes, or 16 decimal digits","hi":"64 बिट्स, 8 बाइट्स, या 16 दशमलव अंक"}],"exp":{"en":"A standard IEEE 802 Ethernet MAC address (EUI-48) is 48 bits (6 bytes/octets) long, represented as 12 hexadecimal digits (typically grouped into six pairs separated by colons or hyphens, such as 00:1A:2B:3C:4D:5E).","hi":"एक सामान्य ईथरनेट MAC एड्रेस 48 बिट्स (6 बाइट्स या 12 हेक्साडेसिमल अंकों) का होता है, जैसे— 00:1A:2B:3C:4D:5E।"},"num":86},{"id":"q87","q":{"en":"In the classic 24-bit OUI format of a 48-bit MAC address, what do the two 24-bit halves represent?","hi":"क्लासिक 24-बिट OUI फॉर्मेट में 48-बिट MAC एड्रेस के दो मुख्य भाग क्या होते हैं?"},"a":{"en":"First 24 bits represent the Organizationally Unique Identifier (OUI / manufacturer prefix), and the remaining 24 bits represent the organization-assigned NIC specific value","hi":"पहले 24 बिट्स ऑर्गनाइजेशन प्रीफिक्स (OUI) होते हैं, और शेष 24 बिट्स संस्था द्वारा आवंटित (organization-assigned) मान होते हैं"},"o":[{"en":"First 24 bits represent the Organizationally Unique Identifier (OUI / manufacturer prefix), and the remaining 24 bits represent the organization-assigned NIC specific value","hi":"पहले 24 बिट्स ऑर्गनाइजेशन प्रीफिक्स (OUI) होते हैं, और शेष 24 बिट्स संस्था द्वारा आवंटित (organization-assigned) मान होते हैं"},{"en":"First 24 bits are the user's phone number, and last 24 bits are the zip code","hi":"पहले 24 बिट्स उपयोगकर्ता का फोन नंबर होते हैं, और अंतिम 24 बिट्स पिन कोड होते हैं"},{"en":"Both 24-bit halves are identical random decimal numbers","hi":"दोनों 24-बिट हिस्से समान रैंडम दशमलव संख्याएँ हैं"},{"en":"First 24 bits store the IPv4 address, and last 24 bits store the subnet mask","hi":"पहले 24 बिट्स IPv4 पता स्टोर करते हैं, और अंतिम 24 बिट्स सबनेट मास्क स्टोर करते हैं"}],"exp":{"en":"In the classic 48-bit MAC structure, the first 24 bits (3 bytes) form the IEEE-assigned Organizationally Unique Identifier (OUI) identifying the vendor/manufacturer, and the last 24 bits (3 bytes) are the vendor-assigned interface identifier (note: other IEEE block sizes also exist).","hi":"क्लासिक 24-बिट OUI फॉर्मेट में MAC एड्रेस के पहले 24 बिट्स निर्माता/संस्था का प्रीफिक्स (OUI - Organizationally Unique Identifier) होते हैं, और शेष 24 बिट्स उस संस्था द्वारा इंटरफेस को दिया गया विशिष्ट मान होते हैं।"},"num":87},{"id":"q88","q":{"en":"Is a MAC address always strictly fixed/permanent in practice?","hi":"क्या व्यवहार में MAC एड्रेस हमेशा स्थायी या अपरिवर्तनीय (Fixed/Permanent) ही रहता है?"},"a":{"en":"While a factory-assigned hardware MAC address exists on the NIC, device software/OS can also use locally administered or randomized MAC addresses (e.g., for Wi-Fi privacy)","hi":"हार्डवेयर में फैक्ट्री-आवंटित पता हो सकता है, परंतु डिवाइस सॉफ्टवेयर या ऑपरेटिंग सिस्टम स्थानीय रूप से प्रशासित (locally administered) या रैंडमाइज्ड (randomized) MAC का भी उपयोग कर सकता है"},"o":[{"en":"While a factory-assigned hardware MAC address exists on the NIC, device software/OS can also use locally administered or randomized MAC addresses (e.g., for Wi-Fi privacy)","hi":"हार्डवेयर में फैक्ट्री-आवंटित पता हो सकता है, परंतु डिवाइस सॉफ्टवेयर या ऑपरेटिंग सिस्टम स्थानीय रूप से प्रशासित (locally administered) या रैंडमाइज्ड (randomized) MAC का भी उपयोग कर सकता है"},{"en":"No, NIC manufacturers never assign any MAC address at the factory","hi":"नहीं, NIC निर्माता फैक्ट्री में कभी कोई MAC पता आवंटित नहीं करते हैं"},{"en":"Yes, it is physically impossible for any operating system to use a randomized MAC address","hi":"हाँ, किसी भी ऑपरेटिंग सिस्टम के लिए रैंडमाइज्ड MAC पते का उपयोग करना असंभव है"},{"en":"MAC addresses change automatically every millisecond during a phone call","hi":"फोन कॉल के दौरान हर मिलीसेकंड में MAC पते अपने आप बदल जाते हैं"}],"exp":{"en":"Although network adapters come with a factory-burned universally administered MAC address (BIA), modern operating systems and software can override it with a locally administered address (LAA) or randomized MAC address for privacy on Wi-Fi networks.","hi":"यद्यपि नेटवर्क कार्ड में फैक्ट्री-आवंटित (factory-assigned) MAC पता होता है, फिर भी आधुनिक डिवाइस सॉफ्टवेयर या ऑपरेटिंग सिस्टम गोपनीयता (privacy) व प्रशासन के लिए लोकली एडमिनिस्टर्ड या रैंडमाइज्ड (randomized) MAC पते का भी उपयोग कर सकते हैं।"},"num":88},{"id":"q89","q":{"en":"What is an 'IP Address'?","hi":"'IP एड्रेस' (IP Address) क्या है?"},"a":{"en":"Internet Protocol address — a Network-Layer (Layer 3) logical address that identifies a host/interface on an IP network and supports packet routing across networks","hi":"इंटरनेट प्रोटोकॉल एड्रेस — नेटवर्क-लेयर का लॉजिकल पता जो इंटरफेस की पहचान करता है और नेटवर्कों के बीच पैकेट रूटिंग में सहायता करता है"},"o":[{"en":"Internet Protocol address — a Network-Layer (Layer 3) logical address that identifies a host/interface on an IP network and supports packet routing across networks","hi":"इंटरनेट प्रोटोकॉल एड्रेस — नेटवर्क-लेयर का लॉजिकल पता जो इंटरफेस की पहचान करता है और नेटवर्कों के बीच पैकेट रूटिंग में सहायता करता है"},{"en":"Internal Printer address — a mechanical switch inside a dot-matrix printer","hi":"इंटरनल प्रिंटर एड्रेस — डॉट-मैट्रिक्स प्रिंटर के अंदर एक यांत्रिक स्विच"},{"en":"A 48-bit physical address used only by Layer-1 repeaters","hi":"केवल लेयर-1 रिपीटर्स द्वारा उपयोग किया जाने वाला 48-बिट भौतिक पता"},{"en":"An audio file format used for recording voice memos","hi":"वॉयस मेमो रिकॉर्ड करने के लिए प्रयुक्त एक ऑडियो फ़ाइल फॉर्मेट"}],"exp":{"en":"An IP (Internet Protocol) address is a logical Network-Layer (OSI Layer 3) address assigned to a network interface that identifies its network and host location, enabling routers to deliver packets across interconnected networks.","hi":"IP एड्रेस (Internet Protocol address) एक नेटवर्क-लेयर (Layer 3) लॉजिकल पता (logical address) है, जो नेटवर्क पर किसी इंटरफेस की पहचान करता है और विभिन्न नेटवर्कों के बीच पैकेट रूटिंग (packet routing) को संभव बनाता है।"},"num":89},{"id":"q90","q":{"en":"What is the bit size, octet structure, and standard notation of an 'IPv4 Address'?","hi":"'IPv4 एड्रेस' (IPv4 Address) का आकार (Size) और मानक नोटेशन (Notation) क्या है?"},"a":{"en":"32 bits (4 octets/bytes) written in dotted-decimal notation, where each octet ranges from 0 to 255 (e.g., 192.168.0.178)","hi":"32 बिट्स (अर्थात 4 ऑक्टेट), डॉटेड डेसिमल (dotted decimal) रूप में, जहाँ प्रत्येक ऑक्टेट 0 से 255 के बीच होता है (उदाहरण: 192.168.0.178)"},"o":[{"en":"32 bits (4 octets/bytes) written in dotted-decimal notation, where each octet ranges from 0 to 255 (e.g., 192.168.0.178)","hi":"32 बिट्स (अर्थात 4 ऑक्टेट), डॉटेड डेसिमल (dotted decimal) रूप में, जहाँ प्रत्येक ऑक्टेट 0 से 255 के बीच होता है (उदाहरण: 192.168.0.178)"},{"en":"128 bits (16 bytes) written in colon-separated hexadecimal notation","hi":"128 बिट्स (16 बाइट्स), कोलन-पृथक हेक्साडेसिमल नोटेशन में"},{"en":"48 bits (6 bytes) written as 12 hexadecimal digits","hi":"48 बिट्स (6 बाइट्स), 12 हेक्साडेसिमल अंकों के रूप में"},{"en":"16 bits (2 bytes) written in binary 0s and 1s only","hi":"16 बिट्स (2 बाइट्स), केवल बाइनरी 0 और 1 में"}],"exp":{"en":"An IPv4 address is 32 bits long, divided into 4 octets (8 bits each) separated by dots (periods) in decimal format, with each octet having a value from 0 to 255 (for example, 192.168.0.178).","hi":"IPv4 एड्रेस 32 बिट्स (अर्थात 4 ऑक्टेट या 4 बाइट्स) का होता है और इसे डॉटेड डेसिमल (dotted decimal) नोटेशन में लिखा जाता है। प्रत्येक ऑक्टेट का मान 0 से 255 तक होता है (उदाहरण: 192.168.0.178)।"},"num":90},{"id":"q91","q":{"en":"How does each octet in an IPv4 address have 256 possible values (from 0 to 255)?","hi":"IPv4 एड्रेस के प्रत्येक ऑक्टेट (Octet) में 256 संभावित मान (0 से 255 तक) कैसे बनते हैं?"},"a":{"en":"Because each octet has 8 binary bits, giving 2⁸ = 256 possible combinations from 0 (00000000) to 255 (11111111) inclusive","hi":"क्योंकि 8 बिट्स से 2⁸ = 256 संभावित मान बनते हैं, जो शून्य (0) से लेकर 255 तक (दोनों सहित) होते हैं"},"o":[{"en":"Because each octet has 8 binary bits, giving 2⁸ = 256 possible combinations from 0 (00000000) to 255 (11111111) inclusive","hi":"क्योंकि 8 बिट्स से 2⁸ = 256 संभावित मान बनते हैं, जो शून्य (0) से लेकर 255 तक (दोनों सहित) होते हैं"},{"en":"Because 4 octets multiplied by 64 equals 256 in decimal","hi":"क्योंकि दशमलव में 4 ऑक्टेट गुणा 64 बराबर 256 होता है"},{"en":"Because each octet contains 256 separate copper wires","hi":"क्योंकि प्रत्येक ऑक्टेट में 256 अलग-अलग तांबे के तार होते हैं"},{"en":"Because IPv4 uses base-16 hexadecimal numbers in every octet","hi":"क्योंकि IPv4 प्रत्येक ऑक्टेट में बेस-16 हेक्साडेसिमल संख्याओं का उपयोग करता है"}],"exp":{"en":"Each IPv4 octet consists of 8 bits; in binary, 8 bits can represent 2⁸ = 256 distinct numbers, starting from 0 (all 0s: 00000000) up to 255 (all 1s: 11111111).","hi":"एक ऑक्टेट में 8 बिट्स होते हैं, और 8 बिट्स से कुल 2⁸ = 256 संभावित मान बनते हैं, जो 0 से लेकर 255 तक (inclusive) होते हैं।"},"num":91},{"id":"q92","q":{"en":"What is the bit size, byte length, and standard notation of an 'IPv6 Address'?","hi":"'IPv6 एड्रेस' (IPv6 Address) का आकार (Size) और मानक नोटेशन क्या है?"},"a":{"en":"128 bits (16 bytes), typically written as colon-separated hexadecimal groups (e.g., 2001:db8::1)","hi":"128 बिट्स (अर्थात 16 बाइट्स), जिसे आमतौर पर कोलन (:) से अलग किए गए हेक्साडेसिमल समूहों में लिखा जाता है (जैसे 2001:db8::1)"},"o":[{"en":"32 bits (4 bytes) in dotted-decimal format","hi":"32 बिट्स (4 बाइट्स), डॉटेड-डेसिमल फॉर्मेट में"},{"en":"48 bits (6 bytes) in hyphen-separated octal format","hi":"48 बिट्स (6 बाइट्स), हाइफ़न-पृथक ऑक्टल फॉर्मेट में"},{"en":"128 bits (16 bytes), typically written as colon-separated hexadecimal groups (e.g., 2001:db8::1)","hi":"128 बिट्स (अर्थात 16 बाइट्स), जिसे आमतौर पर कोलन (:) से अलग किए गए हेक्साडेसिमल समूहों में लिखा जाता है (जैसे 2001:db8::1)"},{"en":"64 bits (8 bytes) written as English words","hi":"64 बिट्स (8 बाइट्स), अंग्रेजी शब्दों के रूप में"}],"exp":{"en":"An IPv6 address is 128 bits (16 bytes) long and is represented as eight 16-bit hexadecimal groups separated by colons (e.g., 2001:0db8:0000:0000:0000:0000:0000:0001, compressed as 2001:db8::1).","hi":"IPv6 एड्रेस 128 बिट्स (अर्थात 16 बाइट्स) का होता है और इसे सामान्यतः कोलन (:) से अलग किए गए हेक्साडेसिमल समूहों के रूप में लिखा जाता है (जैसे 2001:db8::1)।"},"num":92},{"id":"q93","q":{"en":"What is the role of the double colon (::) in IPv6 address notation, and how many times can it appear in a single address?","hi":"IPv6 एड्रेस नोटेशन में डबल कोलन (::) क्या करता है और एक पते में इसका उपयोग अधिकतम कितनी बार हो सकता है?"},"a":{"en":"It compresses a single contiguous run of all-zero hexadecimal groups, and can be used at most once in a given IPv6 address","hi":"यह शून्य (zero) समूहों की एक लगातार श्रृंखला को संक्षिप्त (compress) करता है, और एक पते में '::' का उपयोग अधिकतम केवल एक बार किया जा सकता है"},"o":[{"en":"It compresses a single contiguous run of all-zero hexadecimal groups, and can be used at most once in a given IPv6 address","hi":"यह शून्य (zero) समूहों की एक लगातार श्रृंखला को संक्षिप्त (compress) करता है, और एक पते में '::' का उपयोग अधिकतम केवल एक बार किया जा सकता है"},{"en":"It separates every single hexadecimal digit and can be used 16 times","hi":"यह प्रत्येक हेक्साडेसिमल अंक को अलग करता है और इसका उपयोग 16 बार किया जा सकता है"},{"en":"It converts an IPv6 address into a 48-bit MAC address","hi":"यह IPv6 पते को 48-बिट MAC पते में बदल देता है"},{"en":"It indicates that the computer is disconnected from the internet","hi":"यह दर्शाता है कि कंप्यूटर इंटरनेट से डिस्कनेक्ट है"}],"exp":{"en":"In IPv6 representation, the double colon (::) compresses one contiguous sequence of 16-bit groups that are all zeros; to prevent ambiguity in reconstructing the 128-bit address, '::' may appear at most once per address.","hi":"IPv6 में डबल कोलन (::) लगातार आने वाले शून्य समूहों (contiguous run of zero groups) को संक्षिप्त (compress) करता है। अस्पष्टता से बचने के लिए किसी एक IPv6 पते में '::' का प्रयोग अधिकतम एक ही बार किया जा सकता है।"},"num":93},{"id":"q94","q":{"en":"What is the correct bit-size comparison for MAC Address, IPv4 Address, and IPv6 Address?","hi":"MAC एड्रेस, IPv4 एड्रेस और IPv6 एड्रेस के बिट-आकार (Bit Sizes) का सही मिलान क्या है?"},"a":{"en":"MAC: 48-bit, IPv4: 32-bit, IPv6: 128-bit","hi":"MAC: 48-बिट, IPv4: 32-बिट, IPv6: 128-बिट"},"o":[{"en":"MAC: 48-bit, IPv4: 32-bit, IPv6: 128-bit","hi":"MAC: 48-बिट, IPv4: 32-बिट, IPv6: 128-बिट"},{"en":"MAC: 32-bit, IPv4: 48-bit, IPv6: 64-bit","hi":"MAC: 32-बिट, IPv4: 48-बिट, IPv6: 64-बिट"},{"en":"MAC: 128-bit, IPv4: 64-bit, IPv6: 32-bit","hi":"MAC: 128-बिट, IPv4: 64-बिट, IPv6: 32-बिट"},{"en":"MAC: 16-bit, IPv4: 32-bit, IPv6: 48-bit","hi":"MAC: 16-बिट, IPv4: 32-बिट, IPv6: 48-बिट"}],"exp":{"en":"Quick exam comparison of address lengths: Standard Ethernet MAC address = 48 bits (6 bytes); IPv4 address = 32 bits (4 bytes); IPv6 address = 128 bits (16 bytes).","hi":"तीनों पतों के आकार का सटीक मिलान है: MAC एड्रेस = 48-बिट (6 बाइट), IPv4 एड्रेस = 32-बिट (4 बाइट), और IPv6 एड्रेस = 128-बिट (16 बाइट)।"},"num":94},{"id":"q95","q":{"en":"From an exam perspective, what is the functional distinction between a 'MAC Address' and an 'IP Address'?","hi":"परीक्षा की दृष्टि से 'MAC एड्रेस' और 'IP एड्रेस' के कार्य में मुख्य अंतर क्या है?"},"a":{"en":"MAC address is the Data-Link (Layer 2) cue for forwarding frames on a local link/LAN, whereas IP address is the Network-Layer (Layer 3) cue for routing packets across interconnected networks","hi":"MAC पता लोकल लिंक पर फ्रेम फॉरवर्डिंग का संकेत (cue) है, जबकि IP पता विभिन्न राउटेड नेटवर्कों के बीच पैकेट डिलीवरी का संकेत है"},"o":[{"en":"MAC address is the Data-Link (Layer 2) cue for forwarding frames on a local link/LAN, whereas IP address is the Network-Layer (Layer 3) cue for routing packets across interconnected networks","hi":"MAC पता लोकल लिंक पर फ्रेम फॉरवर्डिंग का संकेत (cue) है, जबकि IP पता विभिन्न राउटेड नेटवर्कों के बीच पैकेट डिलीवरी का संकेत है"},{"en":"MAC address routes packets across the global Internet, while IP address works only inside a single hub","hi":"MAC पता वैश्विक इंटरनेट पर पैकेट रूट करता है, जबकि IP पता केवल एक सिंगल हब के अंदर काम करता है"},{"en":"MAC address is a 32-bit logical address, while IP address is a 48-bit burned-in hardware address","hi":"MAC पता एक 32-बिट लॉजिकल पता है, जबकि IP पता एक 48-बिट हार्डवेयर पता है"},{"en":"Both addresses are identical and interchangeable at Layer 1","hi":"दोनों पते लेयर 1 पर बिल्कुल समान और एक-दूसरे के स्थान पर प्रयुक्त होने योग्य हैं"}],"exp":{"en":"In packet delivery, Layer-2 switches use the MAC address to deliver frames hop-by-hop within the same local network link, whereas Layer-3 routers use the logical IP address to route packets end-to-end across different networks.","hi":"परीक्षा के लिए मुख्य अंतर: MAC एड्रेस लोकल लिंक (LAN) पर फ्रेम फॉरवर्डिंग (frame forwarding) के लिए उपयोग होता है, जबकि IP एड्रेस विभिन्न राउटेड नेटवर्कों के बीच पैकेट डिलीवरी (packet delivery/routing) के लिए उपयोग होता है।"},"num":95}]},{"title":{"en":"7. Malware & Common Types","hi":"7. मैलवेयर और इसके प्रमुख प्रकार"},"questions":[{"id":"q96","q":{"en":"What does the term 'Malware' mean?","hi":"'मैलवेयर' (Malware) शब्द का क्या अर्थ है?"},"a":{"en":"Malicious Software — any software or code intentionally designed to harm, disrupt, spy on, or gain unauthorized access to computer systems, data, or users","hi":"मैलिशियस सॉफ्टवेयर (दुर्भावनापूर्ण सॉफ्टवेयर) — ऐसा सॉफ्टवेयर या कोड जो सिस्टम, डेटा या उपयोगकर्ताओं को नुकसान पहुँचाने, बाधित करने, जासूसी करने या दुरुपयोग करने के लिए बनाया गया हो"},"o":[{"en":"Malicious Software — any software or code intentionally designed to harm, disrupt, spy on, or gain unauthorized access to computer systems, data, or users","hi":"मैलिशियस सॉफ्टवेयर (दुर्भावनापूर्ण सॉफ्टवेयर) — ऐसा सॉफ्टवेयर या कोड जो सिस्टम, डेटा या उपयोगकर्ताओं को नुकसान पहुँचाने, बाधित करने, जासूसी करने या दुरुपयोग करने के लिए बनाया गया हो"},{"en":"Mailing Hardware — physical envelopes and stamps used in post offices","hi":"मेलिंग हार्डवेयर — डाकघरों में प्रयुक्त भौतिक लिफाफे और टिकट"},{"en":"Mainframe Warehouse — a storage room for old vacuum tubes","hi":"मेनफ्रेम वेयरहाउस — पुराने वैक्यूम ट्यूबों के लिए एक भंडारण कक्ष"},{"en":"Manual Firmware — official driver updates released by motherboard manufacturers","hi":"मैनुअल फर्मवेयर — मदरबोर्ड निर्माताओं द्वारा जारी आधिकारिक ड्राइवर अपडेट"}],"exp":{"en":"Malware is a portmanteau of 'malicious software' and refers to any program or code created to damage, disrupt, steal data from, spy on, or compromise the security of computer systems and networks.","hi":"मैलवेयर (Malware) का अर्थ 'मैलिशियस सॉफ्टवेयर' (Malicious Software) है। यह ऐसा दुर्भावनापूर्ण सॉफ्टवेयर या कोड है जिसे कंप्यूटर सिस्टम, डेटा या उपयोगकर्ताओं को नुकसान पहुँचाने, बाधित करने या जासूसी करने के लिए बनाया जाता है।"},"num":96},{"id":"q97","q":{"en":"What is the fundamental difference between a 'Computer Virus' and a 'Worm'?","hi":"'कंप्यूटर वायरस' (Virus) और 'वर्म' (Worm) में मुख्य अंतर क्या है?"},"a":{"en":"A Virus typically attaches itself to a host file/program and requires host execution to spread, whereas a Worm is standalone malware that can self-replicate and spread independently across networks","hi":"वायरस आमतौर पर किसी होस्ट फ़ाइल/प्रोग्राम से जुड़ता है, जबकि वर्म (Worm) स्वतंत्र रूप से अपनी प्रतियाँ बनाकर (self-replicate) नेटवर्क पर फैल सकता है"},"o":[{"en":"A Virus typically attaches itself to a host file/program and requires host execution to spread, whereas a Worm is standalone malware that can self-replicate and spread independently across networks","hi":"वायरस आमतौर पर किसी होस्ट फ़ाइल/प्रोग्राम से जुड़ता है, जबकि वर्म (Worm) स्वतंत्र रूप से अपनी प्रतियाँ बनाकर (self-replicate) नेटवर्क पर फैल सकता है"},{"en":"A Worm requires a human to open a Word macro, whereas a Virus spreads without any host file","hi":"वर्म को चलाने के लिए मनुष्य द्वारा वर्ड मैक्रो खोलने की आवश्यकता होती है, जबकि वायरस बिना किसी होस्ट फ़ाइल के फैलता है"},{"en":"A Virus is a hardware chip, whereas a Worm is a fiber-optic cable","hi":"वायरस एक हार्डवेयर चिप है, जबकि वर्म एक फाइबर-ऑप्टिक केबल है"},{"en":"Both are beneficial system utilities pre-installed in Windows","hi":"दोनों विंडोज में पहले से इंस्टॉल आने वाली लाभकारी सिस्टम यूटिलिटीज हैं"}],"exp":{"en":"A computer virus requires a host program or file to attach to and spreads when that infected host file is executed/shared, whereas a worm is self-contained and propagates autonomously across networks by exploiting vulnerabilities.","hi":"वायरस (Virus) आमतौर पर किसी होस्ट फ़ाइल या प्रोग्राम से जुड़ता है और उसके चलने पर फैलता है, जबकि वर्म (Worm) बिना किसी होस्ट फ़ाइल के स्वतंत्र रूप से अपनी प्रतिलिपियाँ बनाकर (self-replicate) नेटवर्क पर फैल सकता है।"},"num":97},{"id":"q98","q":{"en":"What is a 'Trojan Horse' (Trojan) in cybersecurity?","hi":"साइबर सुरक्षा में 'ट्रोजन हॉर्स' (Trojan Horse) क्या होता है?"},"a":{"en":"Malicious software disguised as a legitimate or useful program that tricks the user into installing or executing it","hi":"उपयोगी या वैध प्रोग्राम जैसा दिखने वाला दुर्भावनापूर्ण सॉफ्टवेयर, जो उपयोगकर्ता को धोखे से उसे चलाने या इंस्टॉल करने के लिए प्रेरित करता है"},"o":[{"en":"Malicious software disguised as a legitimate or useful program that tricks the user into installing or executing it","hi":"उपयोगी या वैध प्रोग्राम जैसा दिखने वाला दुर्भावनापूर्ण सॉफ्टवेयर, जो उपयोगकर्ता को धोखे से उसे चलाने या इंस्टॉल करने के लिए प्रेरित करता है"},{"en":"A self-replicating worm that spreads without any user interaction","hi":"एक स्व-प्रतिकृति वर्म जो बिना किसी उपयोगकर्ता हस्तक्षेप के फैलता है"},{"en":"A hardware firewall device that blocks unauthorized packets","hi":"एक हार्डवेयर फ़ायरवॉल डिवाइस जो अनधिकृत पैकेट्स को ब्लॉक करता है"},{"en":"An official antivirus signature database","hi":"एक आधिकारिक एंटीवायरस सिग्नेचर डेटाबेस"}],"exp":{"en":"A Trojan horse is deceptive malware that masquerades as a benign, useful, or legitimate application to trick users into downloading and running it, thereby granting unauthorized access or executing hidden malicious payloads.","hi":"ट्रोजन हॉर्स (Trojan Horse) एक ऐसा दुर्भावनापूर्ण सॉफ्टवेयर है जो दिखने में किसी उपयोगी या वैध (legitimate) प्रोग्राम जैसा लगता है और उपयोगकर्ता को धोखे में रखकर खुद को इंस्टॉल या रन करवाता है।"},"num":98},{"id":"q99","q":{"en":"What do 'Spyware' and a malicious 'Keylogger' respectively do?","hi":"'स्पाईवेयर' (Spyware) और दुर्भावनापूर्ण 'कीलॉगर' (Keylogger) क्रमशः क्या करते हैं?"},"a":{"en":"Spyware secretly monitors and collects user activity/data, while a malicious Keylogger specifically records keystrokes to capture sensitive information like passwords and credentials","hi":"स्पाईवेयर गुप्त रूप से गतिविधि/डेटा एकत्र करता है, और कीलॉगर पासवर्ड व क्रेडेंशियल जैसे डेटा को चुराने के लिए कीबोर्ड के कीस्ट्रोक्स (keystrokes) रिकॉर्ड करता है"},"o":[{"en":"Spyware secretly monitors and collects user activity/data, while a malicious Keylogger specifically records keystrokes to capture sensitive information like passwords and credentials","hi":"स्पाईवेयर गुप्त रूप से गतिविधि/डेटा एकत्र करता है, और कीलॉगर पासवर्ड व क्रेडेंशियल जैसे डेटा को चुराने के लिए कीबोर्ड के कीस्ट्रोक्स (keystrokes) रिकॉर्ड करता है"},{"en":"Spyware speeds up internet browsing, while a Keylogger cleans the computer keyboard physically","hi":"स्पाईवेयर इंटरनेट ब्राउज़िंग को तेज़ करता है, जबकि कीलॉगर कंप्यूटर कीबोर्ड को भौतिक रूप से साफ़ करता है"},{"en":"Spyware encrypts hard drives for ransom, while a Keylogger routes IP packets","hi":"स्पाईवेयर फिरौती के लिए हार्ड ड्राइव को एन्क्रिप्ट करता है, जबकि कीलॉगर IP पैकेट को रूट करता है"},{"en":"Both are types of network topologies used in LANs","hi":"दोनों LAN में उपयोग की जाने वाली नेटवर्क टोपोलॉजी के प्रकार हैं"}],"exp":{"en":"Spyware covertly gathers information about a user's browsing habits or system activity and transmits it to third parties; a keylogger is a specialized form of spyware/tool that logs every key pressed on the keyboard to steal passwords, PINs, and messages.","hi":"स्पाईवेयर (Spyware) उपयोगकर्ता की जानकारी के बिना गुप्त रूप से उसकी गतिविधि और डेटा एकत्र करता है, जबकि कीलॉगर (Keylogger) पासवर्ड या बैंकिंग क्रेडेंशियल चुराने के लिए कीबोर्ड पर दबाए गए प्रत्येक बटन (keystrokes) को रिकॉर्ड करता है।"},"num":99},{"id":"q100","q":{"en":"What is 'Adware' and how can unwanted/intrusive variants behave?","hi":"'एडवेयर' (Adware) क्या होता है और इसके अवांछित (Intrusive) रूप क्या कर सकते हैं?"},"a":{"en":"Software that automatically displays or downloads advertisements; unwanted or intrusive variants may track user data or hijack browser settings","hi":"विज्ञापन (Ads) दिखाने वाला सॉफ्टवेयर; इसके अवांछित या आक्रामक रूप उपयोगकर्ता का डेटा एकत्र कर सकते हैं या ब्राउज़र के व्यवहार को बदल सकते हैं"},"o":[{"en":"Software that automatically displays or downloads advertisements; unwanted or intrusive variants may track user data or hijack browser settings","hi":"विज्ञापन (Ads) दिखाने वाला सॉफ्टवेयर; इसके अवांछित या आक्रामक रूप उपयोगकर्ता का डेटा एकत्र कर सकते हैं या ब्राउज़र के व्यवहार को बदल सकते हैं"},{"en":"Hardware adapters used for connecting two monitors to a PC","hi":"एक पीसी से दो मॉनिटर जोड़ने के लिए प्रयुक्त हार्डवेयर एडेप्टर"},{"en":"A secure protocol for transferring medical records","hi":"मेडिकल रिकॉर्ड ट्रांसफर करने के लिए एक सुरक्षित प्रोटोकॉल"},{"en":"A backup utility built into Linux servers","hi":"लिनक्स सर्वरों में निर्मित एक बैकअप यूटिलिटी"}],"exp":{"en":"Adware (advertising-supported software) generates revenue by displaying pop-up or banner advertisements; potentially unwanted or malicious adware often tracks user browsing data without consent and modifies browser homepages or search engines.","hi":"एडवेयर (Adware) उपयोगकर्ता की स्क्रीन पर स्वतः विज्ञापन (advertisements) दिखाने वाला सॉफ्टवेयर है। इसके अवांछित या दुर्भावनापूर्ण रूप गुप्त रूप से डेटा एकत्र कर सकते हैं या वेब ब्राउज़र की सेटिंग्स को बदल सकते हैं।"},"num":100},{"id":"q101","q":{"en":"What is the primary function of a 'Rootkit'?","hi":"'रूटकिट' (Rootkit) का मुख्य कार्य क्या है?"},"a":{"en":"It uses stealth tools and techniques to hide unauthorized presence, privileged access, or other malicious activity from the operating system and security software","hi":"यह सिस्टम में अनधिकृत उपस्थिति, एक्सेस या दुर्भावनापूर्ण गतिविधि को छुपाने (hide करने) के लिए टूल्स और तकनीकों का उपयोग करता है"},"o":[{"en":"It uses stealth tools and techniques to hide unauthorized presence, privileged access, or other malicious activity from the operating system and security software","hi":"यह सिस्टम में अनधिकृत उपस्थिति, एक्सेस या दुर्भावनापूर्ण गतिविधि को छुपाने (hide करने) के लिए टूल्स और तकनीकों का उपयोग करता है"},{"en":"It calculates square roots in a scientific calculator","hi":"यह एक वैज्ञानिक कैलकुलेटर में वर्गमूल की गणना करता है"},{"en":"It connects the root node of a tree topology to a hub","hi":"यह ट्री टोपोलॉजी के रूट नोड को हब से जोड़ता है"},{"en":"It displays harmless pop-up coupons while shopping online","hi":"यह ऑनलाइन खरीदारी करते समय हानिरहित पॉप-अप कूपन प्रदर्शित करता है"}],"exp":{"en":"A rootkit is a stealthy collection of software tools designed to conceal the existence of malware, unauthorized processes, or privileged ('root'/administrator) backdoor access from users and antivirus scanners.","hi":"रूटकिट (Rootkit) एक ऐसा गुप्त मैलवेयर टूलसेट है जो सिस्टम में हमलावर की अनधिकृत उपस्थिति (unauthorized presence), एडमिन एक्सेस और अन्य दुर्भावनापूर्ण गतिविधियों को ऑपरेटिंग सिस्टम व एंटीवायरस से छुपाकर रखता है।"},"num":101},{"id":"q102","q":{"en":"How is a 'Logic Bomb' activated?","hi":"'लॉजिक बम' (Logic Bomb) कैसे सक्रिय (Activate) होता है?"},"a":{"en":"Malicious code lies dormant until it is triggered when a specific event, date/time, or logical condition is met","hi":"जब कोई विशिष्ट घटना (event), तारीख (date) या शर्त (condition) पूरी होती है, तब इसका दुर्भावनापूर्ण कोड सक्रिय (trigger) होता है"},"o":[{"en":"Malicious code lies dormant until it is triggered when a specific event, date/time, or logical condition is met","hi":"जब कोई विशिष्ट घटना (event), तारीख (date) या शर्त (condition) पूरी होती है, तब इसका दुर्भावनापूर्ण कोड सक्रिय (trigger) होता है"},{"en":"It explodes physically inside the power supply when voltage exceeds 240V","hi":"वोल्टेज 240V से अधिक होने पर यह पावर सप्लाई के अंदर भौतिक रूप से फट जाता है"},{"en":"It activates only when a user connects a coaxial terminator","hi":"यह केवल तभी सक्रिय होता है जब कोई उपयोगकर्ता कोएक्सियल टर्मिनेटर जोड़ता है"},{"en":"It runs continuously from the moment the computer is manufactured","hi":"यह कंप्यूटर के निर्माण के क्षण से ही लगातार चलता रहता है"}],"exp":{"en":"A logic bomb is a piece of malicious code intentionally inserted into a program that remains dormant until a predefined logical condition, specific date/time (time bomb), or system event occurs.","hi":"लॉजिक बम (Logic Bomb) किसी प्रोग्राम में छुपाया गया वह कोड है जो सामान्यतः निष्क्रिय रहता है और किसी विशिष्ट घटना (event), निश्चित तारीख/समय या विशेष शर्त (condition) के पूरा होने पर ही सक्रिय (trigger) होकर नुकसान पहुँचाता है।"},"num":102},{"id":"q103","q":{"en":"What does 'Ransomware' do to a victim's computer system?","hi":"'रैनसमवेयर' (Ransomware) किसी पीड़ित के कंप्यूटर सिस्टम के साथ क्या करता है?"},"a":{"en":"It encrypts the victim's files or locks/blocks access to the system and demands a ransom payment for restoration/decryption","hi":"यह उपयोगकर्ता की फ़ाइलों को एन्क्रिप्ट (लॉक) कर देता है या सिस्टम एक्सेस को ब्लॉक करके फिरौती (ransom) की माँग करता है"},"o":[{"en":"It encrypts the victim's files or locks/blocks access to the system and demands a ransom payment for restoration/decryption","hi":"यह उपयोगकर्ता की फ़ाइलों को एन्क्रिप्ट (लॉक) कर देता है या सिस्टम एक्सेस को ब्लॉक करके फिरौती (ransom) की माँग करता है"},{"en":"It upgrades the operating system to a newer version for free","hi":"यह ऑपरेटिंग सिस्टम को मुफ्त में नए संस्करण में अपग्रेड करता है"},{"en":"It increases the RAM speed and cleans temporary cache files","hi":"यह RAM की गति बढ़ाता है और अस्थायी कैश फ़ाइलों को साफ़ करता है"},{"en":"It converts a wired LAN into a wireless PAN","hi":"यह वायर्ड LAN को वायरलेस PAN में बदल देता है"}],"exp":{"en":"Ransomware is extortion malware that encrypts a victim's critical files or locks them out of their operating system, demanding a monetary ransom (often in cryptocurrency) in exchange for the decryption key.","hi":"रैनसमवेयर (Ransomware) कंप्यूटर की फ़ाइलों को एन्क्रिप्ट कर देता है या पूरे सिस्टम के एक्सेस को लॉक/ब्लॉक कर देता है, और डेटा वापस खोलने के बदले फिरौती (ransom) की माँग करता है।"},"num":103},{"id":"q104","q":{"en":"Which set of common malware types is listed on the chapter's source slide?","hi":"अध्याय की स्रोत स्लाइड (Source Slide) में सामान्य मैलवेयर प्रकारों का कौन-सा समूह सूचीबद्ध किया गया है?"},"a":{"en":"Virus, Worm, Trojan, Spyware, Adware, Rootkit, Keylogger, Logic Bomb, and Ransomware","hi":"वायरस, वर्म, ट्रोजन, स्पाईवेयर, एडवेयर, रूटकिट, कीलॉगर, लॉजिक बम और रैनसमवेयर"},"o":[{"en":"Virus, Worm, Trojan, Spyware, Adware, Rootkit, Keylogger, Logic Bomb, and Ransomware","hi":"वायरस, वर्म, ट्रोजन, स्पाईवेयर, एडवेयर, रूटकिट, कीलॉगर, लॉजिक बम और रैनसमवेयर"},{"en":"Hub, Switch, Router, Bridge, Repeater, Gateway, Modem, NIC, and RJ-45","hi":"हब, स्विच, राउटर, ब्रिज, रिपीटर, गेटवे, मॉडेम, NIC और RJ-45"},{"en":"LAN, MAN, WAN, PAN, CAN, SAN, VPN, VoLTE, and VoIP","hi":"LAN, MAN, WAN, PAN, CAN, SAN, VPN, VoLTE और VoIP"},{"en":"HTTP, HTTPS, FTP, SMTP, POP3, IMAP, TCP, UDP, and IP","hi":"HTTP, HTTPS, FTP, SMTP, POP3, IMAP, TCP, UDP और IP"}],"exp":{"en":"The chapter's malware overview slide lists nine key categories/examples of malicious software: Virus, Worm, Trojan, Spyware, Adware, Rootkit, Keylogger, Logic Bomb, and Ransomware.","hi":"स्रोत स्लाइड में दिए गए मैलवेयर के प्रमुख उदाहरण हैं: वायरस (Virus), वर्म (Worm), ट्रोजन (Trojan), स्पाईवेयर (Spyware), एडवेयर (Adware), रूटकिट (Rootkit), कीलॉगर (Keylogger), लॉजिक बम (Logic Bomb) और रैनसमवेयर (Ransomware)।"},"num":104},{"id":"q105","q":{"en":"In the context of malware and network security, what is a 'Botnet'?","hi":"मैलवेयर और नेटवर्क सुरक्षा के संदर्भ में 'बॉटनेट' (Botnet) का क्या अर्थ है?"},"a":{"en":"A network of compromised/infected devices ('bots' or 'zombies') that are remotely controlled by an attacker (bot herder)","hi":"संक्रमित या समझौता किए गए (compromised) उपकरणों का एक नेटवर्क, जिसे किसी हमलावर द्वारा दूर से (remotely) नियंत्रित किया जाता है"},"o":[{"en":"A network of compromised/infected devices ('bots' or 'zombies') that are remotely controlled by an attacker (bot herder)","hi":"संक्रमित या समझौता किए गए (compromised) उपकरणों का एक नेटवर्क, जिसे किसी हमलावर द्वारा दूर से (remotely) नियंत्रित किया जाता है"},{"en":"An official robotics laboratory network inside a university campus","hi":"विश्वविद्यालय परिसर के अंदर एक आधिकारिक रोबोटिक्स प्रयोगशाला नेटवर्क"},{"en":"A high-speed fiber-optic cable connecting two storage servers","hi":"दो स्टोरेज सर्वरों को जोड़ने वाली एक हाई-स्पीड फाइबर-ऑप्टिक केबल"},{"en":"A search engine indexing tool used only for spell-checking","hi":"केवल स्पेलिंग जाँचने के लिए उपयोग किया जाने वाला एक सर्च इंजन टूल"}],"exp":{"en":"A botnet ('robot network') is a collection of internet-connected devices infected with 'bot' malware that allows a cybercriminal to control them remotely as a group—often used for DDoS attacks, spam campaigns, or credential stuffing.","hi":"बॉटनेट (Botnet) मैलवेयर से संक्रमित (compromised) कंप्यूटरों या स्मार्ट उपकरणों का एक ऐसा नेटवर्क है जिसे हमलावर दूर से (remotely) नियंत्रित करता है; बॉट सॉफ्टवेयर किसी डिवाइस को बॉटनेट का हिस्सा बना देता है।"},"num":105}]},{"title":{"en":"8. Exam Trap Reverse-Questions","hi":"8. परीक्षा के महत्वपूर्ण उल्टे प्रश्न"},"questions":[{"id":"q106","q":{"en":"Match the four descriptions—(1) Reaching the correct destination, (2) Unaltered/intact data, (3) On-time delivery, and (4) Packet delay variation—with their respective data communication characteristics:","hi":"(1) सही गंतव्य पर पहुँचना, (2) डेटा का सही/अक्षुण्ण होना, (3) समय पर डिलीवरी और (4) पैकेट देरी में उतार-चढ़ाव—इन चारों का सही मिलान क्या है?"},"a":{"en":"(1) Delivery, (2) Accuracy, (3) Timeliness, and (4) Jitter","hi":"(1) डिलीवरी (Delivery), (2) एक्यूरेसी (Accuracy), (3) टाइमलीनेस (Timeliness) और (4) जिटर (Jitter)"},"o":[{"en":"(1) Delivery, (2) Accuracy, (3) Timeliness, and (4) Jitter","hi":"(1) डिलीवरी (Delivery), (2) एक्यूरेसी (Accuracy), (3) टाइमलीनेस (Timeliness) और (4) जिटर (Jitter)"},{"en":"(1) Jitter, (2) Timeliness, (3) Accuracy, and (4) Delivery","hi":"(1) जिटर, (2) टाइमलीनेस, (3) एक्यूरेसी और (4) डिलीवरी"},{"en":"(1) Protocol, (2) Medium, (3) Sender, and (4) Receiver","hi":"(1) प्रोटोकॉल, (2) मीडियम, (3) सेंडर और (4) रिसीवर"},{"en":"(1) Simplex, (2) Half-duplex, (3) Full-duplex, and (4) Multiplex","hi":"(1) सिम्प्लेक्स, (2) हाफ-डुप्लेक्स, (3) फुल-डुप्लेक्स और (4) मल्टीप्लेक्स"}],"exp":{"en":"Reaching the right destination = Delivery; arriving intact without errors = Accuracy; arriving within the required time window = Timeliness; variation in packet arrival delay = Jitter.","hi":"सही मिलान है: सही गंतव्य तक पहुँचना → डिलीवरी (Delivery); डेटा का बिना त्रुटि सही पहुँचना → एक्यूरेसी (Accuracy); समय पर पहुँचना → टाइमलीनेस (Timeliness); और पैकेट देरी का उतार-चढ़ाव → जिटर (Jitter)।"},"num":106},{"id":"q107","q":{"en":"Match the following scenarios with their network types: (1) Pairing a phone and a smartwatch, (2) Connecting multiple buildings of a university, and (3) A city-wide cable TV distribution network.","hi":"(1) फ़ोन और स्मार्टवॉच को पेयर करना, (2) यूनिवर्सिटी की कई इमारतों को जोड़ना और (3) पूरे शहर का केबल टीवी नेटवर्क—इनका सही नेटवर्क मिलान क्या है?"},"a":{"en":"(1) PAN, (2) CAN, and (3) MAN","hi":"(1) PAN, (2) CAN और (3) MAN"},"o":[{"en":"(1) WAN, (2) PAN, and (3) SAN","hi":"(1) WAN, (2) PAN और (3) SAN"},{"en":"(1) PAN, (2) CAN, and (3) MAN","hi":"(1) PAN, (2) CAN और (3) MAN"},{"en":"(1) MAN, (2) WAN, and (3) LAN","hi":"(1) MAN, (2) WAN और (3) LAN"},{"en":"(1) SAN, (2) VPN, and (3) PAN","hi":"(1) SAN, (2) VPN और (3) PAN"}],"exp":{"en":"Pairing a phone with a smartwatch around one person = PAN (Personal Area Network); connecting multiple LANs across university buildings = CAN (Campus Area Network); a city-wide cable network = MAN (Metropolitan Area Network).","hi":"सही मिलान है: फ़ोन और स्मार्टवॉच को जोड़ना → PAN; यूनिवर्सिटी कैंपस की इमारतों को जोड़ना → CAN; और शहर भर का केबल नेटवर्क → MAN।"},"num":107},{"id":"q108","q":{"en":"Which network types correspond respectively to: (1) High-speed block-level shared storage for servers, and (2) Secure remote access to a private corporate network over the public Internet?","hi":"(1) सर्वरों के लिए ब्लॉक-लेवल शेयर्ड स्टोरेज, और (2) पब्लिक इंटरनेट के माध्यम से रिमोट प्राइवेट नेटवर्क एक्सेस—ये क्रमशः किससे संबंधित हैं?"},"a":{"en":"(1) SAN (Storage Area Network) and (2) VPN (Virtual Private Network)","hi":"(1) SAN (स्टोरेज एरिया नेटवर्क) और (2) VPN (वर्चुअल प्राइवेट नेटवर्क)"},"o":[{"en":"(1) SAN (Storage Area Network) and (2) VPN (Virtual Private Network)","hi":"(1) SAN (स्टोरेज एरिया नेटवर्क) और (2) VPN (वर्चुअल प्राइवेट नेटवर्क)"},{"en":"(1) PAN and (2) MAN","hi":"(1) PAN और (2) MAN"},{"en":"(1) Bus and (2) Ring","hi":"(1) बस और (2) रिंग"},{"en":"(1) HTTP and (2) POP3","hi":"(1) HTTP और (2) POP3"}],"exp":{"en":"Block-level shared storage access for servers is provided by a SAN (Storage Area Network), while encrypted remote access to a private network over a public medium is provided by a VPN (Virtual Private Network).","hi":"ब्लॉक-लेवल साझा स्टोरेज एक्सेस के लिए SAN (Storage Area Network) और सार्वजनिक नेटवर्क पर सुरक्षित रिमोट प्राइवेट नेटवर्क एक्सेस के लिए VPN (Virtual Private Network) का उपयोग होता है।"},"num":108},{"id":"q109","q":{"en":"Match the following real-world examples with their transmission modes: (1) Television broadcast, (2) Walkie-talkie, and (3) Telephone conversation.","hi":"(1) टीवी प्रसारण, (2) वॉकी-टॉकी और (3) टेलीफोन कॉल—इन्हें उनके सही ट्रांसमिशन मोड से सुमेलित कीजिए:"},"a":{"en":"(1) Simplex, (2) Half-duplex, and (3) Full-duplex","hi":"(1) सिम्प्लेक्स (Simplex), (2) हाफ-डुप्लेक्स (Half-duplex) और (3) फुल-डुप्लेक्स (Full-duplex)"},"o":[{"en":"(1) Simplex, (2) Half-duplex, and (3) Full-duplex","hi":"(1) सिम्प्लेक्स (Simplex), (2) हाफ-डुप्लेक्स (Half-duplex) और (3) फुल-डुप्लेक्स (Full-duplex)"},{"en":"(1) Full-duplex, (2) Simplex, and (3) Half-duplex","hi":"(1) फुल-डुप्लेक्स, (2) सिम्प्लेक्स और (3) हाफ-डुप्लेक्स"},{"en":"(1) Half-duplex, (2) Full-duplex, and (3) Simplex","hi":"(1) हाफ-डुप्लेक्स, (2) फुल-डुप्लेक्स और (3) सिम्प्लेक्स"},{"en":"(1) Point-to-point, (2) Mesh, and (3) Ring","hi":"(1) पॉइंट-टू-पॉइंट, (2) मेश और (3) रिंग"}],"exp":{"en":"TV broadcast is one-way (Simplex); a walkie-talkie is two-way turn-by-turn (Half-duplex); a telephone call is two-way simultaneous (Full-duplex).","hi":"टीवी प्रसारण → सिम्प्लेक्स (एकतरफा); वॉकी-टॉकी → हाफ-डुप्लेक्स (बारी-बारी से दोनों दिशाओं में); और टेलीफोन कॉल → फुल-डुप्लेक्स (एक साथ दोनों दिशाओं में)।"},"num":109},{"id":"q110","q":{"en":"In which network topology are 'Terminators' placed at both ends of a shared central backbone cable?","hi":"किस नेटवर्क टोपोलॉजी में एक साझा बैकबोन केबल के दोनों सिरों (Ends) पर 'टर्मिनेटर' (Terminators) लगाए जाते हैं?"},"a":{"en":"Classic Coaxial Bus topology","hi":"क्लासिक कोएक्सियल बस टोपोलॉजी (Bus Topology)"},"o":[{"en":"Star topology","hi":"स्टार टोपोलॉजी"},{"en":"Classic Coaxial Bus topology","hi":"क्लासिक कोएक्सियल बस टोपोलॉजी (Bus Topology)"},{"en":"Full Mesh topology","hi":"फुल मेश टोपोलॉजी"},{"en":"Dual Ring topology","hi":"डुअल रिंग टोपोलॉजी"}],"exp":{"en":"In a classic coaxial Bus topology, impedance-matching terminators are attached to both ends of the shared backbone cable to absorb signals and prevent signal bounce/reflection.","hi":"क्लासिक कोएक्सियल बस (Bus) टोपोलॉजी में सिग्नल परावर्तन (reflection) को रोकने के लिए साझा बैकबोन केबल के दोनों सिरों पर टर्मिनेटर लगाए जाते हैं।"},"num":110},{"id":"q111","q":{"en":"In which topology is the contrast between 'central switch failure' (affecting the whole segment) and 'single endpoint link failure' (affecting only one device) most clearly seen?","hi":"केंद्रीय स्विच के फेल होने (पूरा सेगमेंट प्रभावित) और एकल एंडपॉइंट लिंक के फेल होने (केवल एक डिवाइस प्रभावित) का अंतर किस टोपोलॉजी में सबसे स्पष्ट दिखता है?"},"a":{"en":"Star topology","hi":"स्टार टोपोलॉजी (Star Topology)"},"o":[{"en":"Star topology","hi":"स्टार टोपोलॉजी (Star Topology)"},{"en":"Linear Bus topology","hi":"लीनियर बस टोपोलॉजी"},{"en":"Single Ring topology","hi":"सिंगल रिंग टोपोलॉजी"},{"en":"Point-to-point serial link","hi":"पॉइंट-टू-पॉइंट सीरियल लिंक"}],"exp":{"en":"In a Star topology, if a single drop cable (endpoint link) fails, only that one workstation is disconnected; if the central switch/hub fails, the entire star network loses connectivity.","hi":"स्टार (Star) टोपोलॉजी में यह अंतर बिल्कुल स्पष्ट होता है: केंद्रीय स्विच/हब फेल होने पर पूरा स्टार नेटवर्क ठप हो जाता है, जबकि किसी एक एंडपॉइंट केबल के खराब होने पर केवल वही एक उपकरण प्रभावित होता है।"},"num":111},{"id":"q112","q":{"en":"If a Full Mesh (Complete Mesh) network uses exactly 10 physical point-to-point links, how many nodes are connected in that network?","hi":"यदि किसी फुल मेश (Complete Mesh) नेटवर्क में कुल 10 भौतिक पॉइंट-टू-पॉइंट लिंक्स हैं, तो उस नेटवर्क में कितने नोड्स (Nodes) जुड़े हैं?"},"a":{"en":"5 nodes (since 5 × 4 / 2 = 10)","hi":"5 नोड्स (क्योंकि 5 × 4 / 2 = 10)"},"o":[{"en":"4 nodes","hi":"4 नोड्स"},{"en":"5 nodes (since 5 × 4 / 2 = 10)","hi":"5 नोड्स (क्योंकि 5 × 4 / 2 = 10)"},{"en":"10 nodes","hi":"10 नोड्स"},{"en":"20 nodes","hi":"20 नोड्स"}],"exp":{"en":"Setting n(n − 1) / 2 = 10 gives n(n − 1) = 20, which solves to n = 5 nodes (5 × 4 / 2 = 10 links).","hi":"फुल मेश के सूत्र n(n − 1) / 2 = 10 के अनुसार, n = 5 रखने पर 5 × 4 / 2 = 10 प्राप्त होता है; अतः नेटवर्क में कुल 5 नोड्स हैं।"},"num":112},{"id":"q113","q":{"en":"Which topologies correspond respectively to: (1) Hierarchical branching from a root/backbone, and (2) Combining two or more different topologies together?","hi":"(1) रूट/बैकबोन से पदानुक्रमित शाखाएँ (Hierarchical branching), और (2) दो या अधिक विभिन्न टोपोलॉजी का संयोजन—ये क्रमशः कौन-सी टोपोलॉजी हैं?"},"a":{"en":"(1) Tree topology and (2) Hybrid topology","hi":"(1) ट्री (Tree) टोपोलॉजी और (2) हाइब्रिड (Hybrid) टोपोलॉजी"},"o":[{"en":"(1) Tree topology and (2) Hybrid topology","hi":"(1) ट्री (Tree) टोपोलॉजी और (2) हाइब्रिड (Hybrid) टोपोलॉजी"},{"en":"(1) Bus topology and (2) Ring topology","hi":"(1) बस टोपोलॉजी और (2) रिंग टोपोलॉजी"},{"en":"(1) Ring topology and (2) Star topology","hi":"(1) रिंग टोपोलॉजी और (2) स्टार टोपोलॉजी"},{"en":"(1) Point-to-point and (2) Simplex","hi":"(1) पॉइंट-टू-पॉइंट और (2) सिम्प्लेक्स"}],"exp":{"en":"Hierarchical branching from a root or backbone (expanded star) defines a Tree topology, whereas combining two or more different topology structures forms a Hybrid topology.","hi":"पदानुक्रमित शाखाओं (hierarchical branching) वाली संरचना को ट्री (Tree) टोपोलॉजी कहते हैं, और दो या अधिक टोपोलॉजी के संयोजन को हाइब्रिड (Hybrid) टोपोलॉजी कहते हैं।"},"num":113},{"id":"q114","q":{"en":"Which network devices respectively perform: (1) Regenerating weakened digital signals, (2) Filtering/forwarding frames using MAC addresses, and (3) Routing packets across IP networks?","hi":"(1) कमजोर सिग्नल को रीजेनरेट करना, (2) MAC पतों से फ्रेम्स को फ़िल्टर/फॉरवर्ड करना, और (3) IP पैकेट्स को रूट करना—ये कार्य क्रमशः कौन-से उपकरण करते हैं?"},"a":{"en":"(1) Repeater, (2) Bridge / Layer-2 Switch, and (3) Router","hi":"(1) रिपीटर (Repeater), (2) ब्रिज/स्विच (Bridge/Switch) और (3) राउटर (Router)"},"o":[{"en":"(1) Repeater, (2) Bridge / Layer-2 Switch, and (3) Router","hi":"(1) रिपीटर (Repeater), (2) ब्रिज/स्विच (Bridge/Switch) और (3) राउटर (Router)"},{"en":"(1) Router, (2) Repeater, and (3) Hub","hi":"(1) राउटर, (2) रिपीटर और (3) हब"},{"en":"(1) Switch, (2) Hub, and (3) Repeater","hi":"(1) स्विच, (2) हब और (3) रिपीटर"},{"en":"(1) Modem, (2) Terminator, and (3) Coaxial cable","hi":"(1) मॉडेम, (2) टर्मिनेटर और (3) कोएक्सियल केबल"}],"exp":{"en":"A Repeater regenerates attenuated signals at Layer 1; a Bridge or Layer-2 Switch filters and forwards frames based on MAC addresses at Layer 2; a Router routes packets across IP networks at Layer 3.","hi":"कमजोर सिग्नल को रीजेनरेट करने का काम रिपीटर (Repeater) करता है, MAC पतों के आधार पर फ्रेम्स को फ़िल्टर/फॉरवर्ड करने का काम ब्रिज या स्विच (Bridge/Switch) करता है, और IP नेटवर्कों के बीच पैकेट्स को रूट करने का काम राउटर (Router) करता है।"},"num":114},{"id":"q115","q":{"en":"Inspecting the 'Destination MAC Address' versus inspecting the 'Destination IP Address' is the primary forwarding cue for which pair of devices respectively?","hi":"'गंतव्य MAC पता' (Destination MAC) बनाम 'गंतव्य IP पता' (Destination IP) क्रमशः किन उपकरणों द्वारा डेटा आगे भेजने का मुख्य आधार (Cue) है?"},"a":{"en":"Layer-2 Switch (or Bridge) versus Layer-3 Router","hi":"लेयर-2 स्विच (या ब्रिज) बनाम लेयर-3 राउटर (Router)"},"o":[{"en":"Layer-2 Switch (or Bridge) versus Layer-3 Router","hi":"लेयर-2 स्विच (या ब्रिज) बनाम लेयर-3 राउटर (Router)"},{"en":"Layer-1 Hub versus Layer-1 Repeater","hi":"लेयर-1 हब बनाम लेयर-1 रिपीटर"},{"en":"Analog Modem versus Coaxial Terminator","hi":"एनालॉग मॉडेम बनाम कोएक्सियल टर्मिनेटर"},{"en":"Keyboard versus Speaker","hi":"कीबोर्ड बनाम स्पीकर"}],"exp":{"en":"A Layer-2 Switch (or Bridge) examines the frame's destination MAC address to switch frames locally, while a Router examines the packet's destination IP address to route packets between networks.","hi":"गंतव्य MAC एड्रेस के आधार पर लेयर-2 स्विच (या ब्रिज) फ्रेम फॉरवर्ड करता है, जबकि गंतव्य IP एड्रेस के आधार पर राउटर (Router) पैकेट रूट करता है।"},"num":115},{"id":"q116","q":{"en":"Between communicating with a host on the 'Same LAN/Subnet' and communicating with a host on a 'Foreign/Remote Network', when is the 'Default Gateway' used?","hi":"'उसी LAN (Same LAN)' और 'बाहरी नेटवर्क (Foreign Network)' में से किसके साथ संचार करते समय 'डिफ़ॉल्ट गेटवे' (Default Gateway) का उपयोग होता है?"},"a":{"en":"For foreign/off-subnet destinations (whereas local traffic on the same subnet/link can be delivered directly without going through the default gateway)","hi":"बाहरी या ऑफ-सबनेट (foreign/off-subnet) गंतव्यों के लिए (जबकि समान LAN/लिंक का लोकल ट्रैफिक सीधे जा सकता है)"},"o":[{"en":"For foreign/off-subnet destinations (whereas local traffic on the same subnet/link can be delivered directly without going through the default gateway)","hi":"बाहरी या ऑफ-सबनेट (foreign/off-subnet) गंतव्यों के लिए (जबकि समान LAN/लिंक का लोकल ट्रैफिक सीधे जा सकता है)"},{"en":"Only for communicating with the mouse and keyboard plugged into the same PC","hi":"केवल उसी पीसी में लगे माउस और कीबोर्ड के साथ संचार करने के लिए"},{"en":"Only for traffic between two ports of the same Layer-2 switch in the same subnet","hi":"केवल समान सबनेट में एक ही लेयर-2 स्विच के दो पोर्ट्स के बीच ट्रैफिक के लिए"},{"en":"Default gateway is never used for internet traffic","hi":"इंटरनेट ट्रैफिक के लिए डिफ़ॉल्ट गेटवे का उपयोग कभी नहीं किया जाता है"}],"exp":{"en":"When a host sends data to another device on the same local subnet, it sends frames directly via Layer 2; when the destination IP is on a foreign/remote network (off-subnet), the host sends the packet to its Default Gateway (local router).","hi":"डिफ़ॉल्ट गेटवे (Default Gateway) का उपयोग बाहरी या दूसरे सबनेट (foreign/off-subnet) के गंतव्य तक पैकेट भेजने के लिए किया जाता है, जबकि समान LAN/सबनेट का लोकल ट्रैफिक सीधे भेजा जा सकता है।"},"num":116},{"id":"q117","q":{"en":"Between '192:168:0:178' and '192.168.0.178', which one is the valid standard IPv4 notation and why?","hi":"'192:168:0:178' और '192.168.0.178' में से मानक IPv4 नोटेशन कौन-सी है और क्यों?"},"a":{"en":"192.168.0.178 — because standard IPv4 notation uses dotted-decimal format (four decimal octets separated by periods/dots)","hi":"192.168.0.178 — क्योंकि IPv4 मानक रूप से डॉटेड-डेसिमल (dotted-decimal) नोटेशन का उपयोग करता है"},"o":[{"en":"192.168.0.178 — because standard IPv4 notation uses dotted-decimal format (four decimal octets separated by periods/dots)","hi":"192.168.0.178 — क्योंकि IPv4 मानक रूप से डॉटेड-डेसिमल (dotted-decimal) नोटेशन का उपयोग करता है"},{"en":"192:168:0:178 — because IPv4 always uses colons between octets","hi":"192:168:0:178 — क्योंकि IPv4 हमेशा ऑक्टेट्स के बीच कोलन का उपयोग करता है"},{"en":"Both are invalid because IPv4 only uses letters A to Z","hi":"दोनों अमान्य हैं क्योंकि IPv4 केवल A से Z अक्षरों का उपयोग करता है"},{"en":"Neither—IPv4 requires 12 octets separated by slashes","hi":"कोई नहीं—IPv4 में स्लैश द्वारा अलग किए गए 12 ऑक्टेट्स की आवश्यकता होती है"}],"exp":{"en":"Standard IPv4 notation is dotted-decimal (e.g., 192.168.0.178), using dots/periods to separate the four decimal octets; colons are used in hexadecimal IPv6 notation or MAC addresses.","hi":"सही मानक IPv4 नोटेशन '192.168.0.178' है, क्योंकि IPv4 में चारों दशमलव ऑक्टेट्स को अलग करने के लिए बिंदु (dots) अर्थात डॉटेड-डेसिमल (dotted decimal) पद्धति का उपयोग किया जाता है।"},"num":117},{"id":"q118","q":{"en":"How many hexadecimal digits are required to represent a 48-bit MAC address, and why?","hi":"48-बिट (48-bit) MAC एड्रेस को दर्शाने के लिए कितने हेक्साडेसिमल अंकों (Hex digits) की आवश्यकता होती है और क्यों?"},"a":{"en":"12 hexadecimal digits, because each hexadecimal digit represents exactly 4 binary bits (48 ÷ 4 = 12)","hi":"12 हेक्साडेसिमल अंक, क्योंकि 1 हेक्साडेसिमल अंक = 4 बिट्स होता है (48 ÷ 4 = 12)"},"o":[{"en":"12 hexadecimal digits, because each hexadecimal digit represents exactly 4 binary bits (48 ÷ 4 = 12)","hi":"12 हेक्साडेसिमल अंक, क्योंकि 1 हेक्साडेसिमल अंक = 4 बिट्स होता है (48 ÷ 4 = 12)"},{"en":"48 hexadecimal digits, because 1 hex digit equals 1 bit","hi":"48 हेक्साडेसिमल अंक, क्योंकि 1 हेक्स अंक 1 बिट के बराबर होता है"},{"en":"6 hexadecimal digits, because 1 hex digit equals 8 bits","hi":"6 हेक्साडेसिमल अंक, क्योंकि 1 हेक्स अंक 8 बिट्स के बराबर होता है"},{"en":"24 hexadecimal digits, because 1 hex digit equals 2 bits","hi":"24 हेक्साडेसिमल अंक, क्योंकि 1 हेक्स अंक 2 बिट्स के बराबर होता है"}],"exp":{"en":"Since base-16 (hexadecimal) has 16 = 2⁴ symbols (0–9, A–F), each hexadecimal digit represents 4 binary bits (one nibble); thus, a 48-bit MAC address requires 48 / 4 = 12 hexadecimal digits.","hi":"एक 48-बिट पते के लिए 12 हेक्साडेसिमल अंकों की आवश्यकता होती है, क्योंकि प्रत्येक 1 हेक्साडेसिमल अंक ठीक 4 बाइनरी बिट्स (48 ÷ 4 = 12) को दर्शाता है।"},"num":118},{"id":"q119","q":{"en":"Which two malware types correspond respectively to: (1) Self-spreading independently across networks/Internet, and (2) Disguising itself as a useful/legitimate program?","hi":"(1) इंटरनेट/नेटवर्क पर स्वतंत्र रूप से स्वयं फैलना (Self-spread), और (2) किसी उपयोगी प्रोग्राम का भेष धरना (Disguise)—ये क्रमशः कौन-से दो मैलवेयर हैं?"},"a":{"en":"(1) Worm and (2) Trojan Horse","hi":"(1) वर्म (Worm) और (2) ट्रोजन हॉर्स (Trojan)"},"o":[{"en":"(1) Worm and (2) Trojan Horse","hi":"(1) वर्म (Worm) और (2) ट्रोजन हॉर्स (Trojan)"},{"en":"(1) Adware and (2) Logic Bomb","hi":"(1) एडवेयर और (2) लॉजिक बम"},{"en":"(1) Keylogger and (2) BIOS","hi":"(1) कीलॉगर और (2) BIOS"},{"en":"(1) Firewall and (2) Antivirus","hi":"(1) फ़ायरवॉल और (2) एंटीवायरस"}],"exp":{"en":"A Worm self-replicates and propagates independently across networks without needing a host file, while a Trojan Horse disguises itself as a legitimate or useful program to trick users into running it.","hi":"नेटवर्क या इंटरनेट पर स्वतंत्र रूप से स्वयं फैलने वाला मैलवेयर 'वर्म' (Worm) है, और किसी उपयोगी प्रोग्राम का छद्म भेष (disguise) बनाकर धोखा देने वाला मैलवेयर 'ट्रोजन' (Trojan) है।"},"num":119}]},{"title":{"en":"9. Rapid-Fire Final Revision","hi":"9. त्वरित अंतिम पुनरावृत्ति"},"questions":[{"id":"q120","q":{"en":"What is the single-word networking term for 'variation in packet delay'?","hi":"'पैकेट देरी में उतार-चढ़ाव' (Packet delay variation) के लिए एक शब्द क्या है?"},"a":{"en":"Jitter","hi":"जिटर (Jitter)"},"o":[{"en":"Jitter","hi":"जिटर (Jitter)"},{"en":"Topology","hi":"टोपोलॉजी"},{"en":"Bandwidth","hi":"बैंडविड्थ"},{"en":"Modulation","hi":"मॉड्यूलेशन"}],"exp":{"en":"Jitter is the variation in the time delay (latency) between data packets arriving over a network.","hi":"नेटवर्क में डेटा पैकेट्स के पहुँचने की देरी में होने वाले उतार-चढ़ाव (packet delay variation) को 'जिटर' (Jitter) कहते हैं।"},"num":120},{"id":"q121","q":{"en":"What is the term for the agreed rules governing data transfer?","hi":"डेटा ट्रांसफर को नियंत्रित करने वाले निर्धारित नियमों को क्या कहते हैं?"},"a":{"en":"Protocol","hi":"प्रोटोकॉल (Protocol)"},"o":[{"en":"Protocol","hi":"प्रोटोकॉल (Protocol)"},{"en":"Browser","hi":"ब्राउज़र"},{"en":"Hardware","hi":"हार्डवेयर"},{"en":"Firewall","hi":"फ़ायरवॉल"}],"exp":{"en":"A protocol is a standardized set of rules for formatting and processing data across a network.","hi":"डेटा संचार के लिए निर्धारित नियमों के समूह को प्रोटोकॉल (Protocol) कहा जाता है।"},"num":121},{"id":"q122","q":{"en":"What type of data or signal varies continuously?","hi":"किस प्रकार का डेटा या सिग्नल निरंतर (continuously) बदलता रहता है?"},"a":{"en":"Analog","hi":"एनालॉग (Analog)"},"o":[{"en":"Analog","hi":"एनालॉग (Analog)"},{"en":"Digital","hi":"डिजिटल"},{"en":"Binary","hi":"बाइनरी"},{"en":"Discrete","hi":"असतत"}],"exp":{"en":"Analog data/signals change smoothly and continuously over time, as opposed to discrete digital steps.","hi":"एनालॉग (Analog) डेटा या सिग्नल निरंतर (continuously) और सुचारू रूप से बदलता है।"},"num":122},{"id":"q123","q":{"en":"What type of data is represented by discrete values (like 0s and 1s)?","hi":"असतत मानों (Discrete values, जैसे 0 और 1) द्वारा किस प्रकार का डेटा दर्शाया जाता है?"},"a":{"en":"Digital","hi":"डिजिटल (Digital)"},"o":[{"en":"Digital","hi":"डिजिटल (Digital)"},{"en":"Analog","hi":"एनालॉग"},{"en":"Continuous","hi":"निरंतर"},{"en":"Fluid","hi":"फ्लूइड"}],"exp":{"en":"Digital data consists of discrete, discontinuous values, typically represented in computers as binary 0s and 1s.","hi":"डिजिटल (Digital) डेटा असतत (discrete) मानों का उपयोग करता है, जिन्हें आमतौर पर बाइनरी 0 और 1 से दर्शाया जाता है।"},"num":123},{"id":"q124","q":{"en":"Which network type typically covers a single office building or home?","hi":"कौन-सा नेटवर्क प्रकार आमतौर पर किसी एक कार्यालय भवन या घर को कवर करता है?"},"a":{"en":"LAN (Local Area Network)","hi":"लैन (LAN - Local Area Network)"},"o":[{"en":"LAN (Local Area Network)","hi":"लैन (LAN - Local Area Network)"},{"en":"WAN (Wide Area Network)","hi":"वैन (WAN)"},{"en":"MAN (Metropolitan Area Network)","hi":"मैन (MAN)"},{"en":"SAN (Storage Area Network)","hi":"सैन (SAN)"}],"exp":{"en":"A Local Area Network (LAN) provides connectivity within a limited geographical area, like a home or office.","hi":"लोकल एरिया नेटवर्क (LAN) घर या कार्यालय भवन जैसे सीमित भौगोलिक क्षेत्र को कवर करता है।"},"num":124},{"id":"q125","q":{"en":"Which network type connects multiple LANs within a university or corporate campus?","hi":"किसी विश्वविद्यालय या कॉर्पोरेट परिसर के भीतर कई LANs को कौन-सा नेटवर्क जोड़ता है?"},"a":{"en":"CAN (Campus Area Network)","hi":"कैन (CAN - Campus Area Network)"},"o":[{"en":"CAN (Campus Area Network)","hi":"कैन (CAN - Campus Area Network)"},{"en":"PAN (Personal Area Network)","hi":"पैन (PAN)"},{"en":"WAN (Wide Area Network)","hi":"वैन (WAN)"},{"en":"VPN (Virtual Private Network)","hi":"वीपीएन (VPN)"}],"exp":{"en":"A Campus Area Network (CAN) interconnects several LANs within a specific geographical campus area.","hi":"कैंपस एरिया नेटवर्क (CAN) किसी स्कूल या कॉर्पोरेट परिसर के कई LANs को आपस में जोड़ता है।"},"num":125},{"id":"q126","q":{"en":"Which network type spans a large geographical coverage like a state, country, or the globe?","hi":"राज्य, देश या विश्व जैसे बड़े भौगोलिक क्षेत्र में फैले नेटवर्क को क्या कहते हैं?"},"a":{"en":"WAN (Wide Area Network)","hi":"वैन (WAN - Wide Area Network)"},"o":[{"en":"WAN (Wide Area Network)","hi":"वैन (WAN - Wide Area Network)"},{"en":"LAN (Local Area Network)","hi":"लैन (LAN)"},{"en":"PAN (Personal Area Network)","hi":"पैन (PAN)"},{"en":"MAN (Metropolitan Area Network)","hi":"मैन (MAN)"}],"exp":{"en":"A Wide Area Network (WAN) connects devices across vast distances, with the Internet being the largest example.","hi":"विस्तृत भौगोलिक क्षेत्र (जैसे देश या महाद्वीप) को कवर करने वाले नेटवर्क को वाइड एरिया नेटवर्क (WAN) कहते हैं।"},"num":126},{"id":"q127","q":{"en":"What do we call a dedicated communication link between exactly two devices?","hi":"ठीक दो उपकरणों के बीच समर्पित संचार लिंक (dedicated link) को क्या कहते हैं?"},"a":{"en":"Point-to-point","hi":"पॉइंट-टू-पॉइंट (Point-to-point)"},"o":[{"en":"Point-to-point","hi":"पॉइंट-टू-पॉइंट (Point-to-point)"},{"en":"Multipoint","hi":"मल्टीपॉइंट"},{"en":"Broadcast","hi":"ब्रॉडकास्ट"},{"en":"Multicast","hi":"मल्टीकास्ट"}],"exp":{"en":"A point-to-point connection is a dedicated link reserved entirely for communication between just two devices.","hi":"केवल दो उपकरणों के बीच के समर्पित लिंक को पॉइंट-टू-पॉइंट (Point-to-point) कनेक्शन कहते हैं।"},"num":127},{"id":"q128","q":{"en":"What is a connection called where more than two devices share a single link?","hi":"उस कनेक्शन को क्या कहते हैं जहाँ दो से अधिक उपकरण एक ही लिंक को साझा करते हैं?"},"a":{"en":"Multipoint (or Multidrop)","hi":"मल्टीपॉइंट या मल्टीड्रॉप (Multipoint/Multidrop)"},"o":[{"en":"Multipoint (or Multidrop)","hi":"मल्टीपॉइंट या मल्टीड्रॉप (Multipoint/Multidrop)"},{"en":"Point-to-point","hi":"पॉइंट-टू-पॉइंट"},{"en":"Simplex","hi":"सिम्प्लेक्स"},{"en":"Unicast","hi":"यूनिकास्ट"}],"exp":{"en":"In a multipoint or multidrop connection, the capacity of the channel is shared by three or more devices.","hi":"जहाँ एक ही लिंक को कई उपकरण साझा करते हैं, उसे मल्टीपॉइंट (Multipoint) कनेक्शन कहते हैं।"},"num":128},{"id":"q129","q":{"en":"Which transmission mode allows simultaneous two-way communication (like a phone call)?","hi":"कौन-सा ट्रांसमिशन मोड एक ही समय में दोनों दिशाओं (Two-way) में संचार की अनुमति देता है (जैसे फोन कॉल)?"},"a":{"en":"Full Duplex","hi":"फुल डुप्लेक्स (Full Duplex)"},"o":[{"en":"Full Duplex","hi":"फुल डुप्लेक्स (Full Duplex)"},{"en":"Half Duplex","hi":"हाफ डुप्लेक्स"},{"en":"Simplex","hi":"सिम्प्लेक्स"},{"en":"Multiplex","hi":"मल्टीप्लेक्स"}],"exp":{"en":"Full-duplex allows both endpoints to transmit and receive data simultaneously at the exact same time.","hi":"फुल डुप्लेक्स (Full Duplex) मोड में दोनों छोर एक ही समय पर एक साथ डेटा भेज और प्राप्त कर सकते हैं।"},"num":129},{"id":"q130","q":{"en":"What provides packet-based voice service over an LTE/4G network?","hi":"LTE/4G नेटवर्क पर पैकेट-आधारित वॉयस (voice) सेवा कौन प्रदान करता है?"},"a":{"en":"VoLTE (Voice over Long Term Evolution)","hi":"VoLTE (वॉयस ओवर लॉन्ग टर्म इवोल्यूशन)"},"o":[{"en":"VoLTE (Voice over Long Term Evolution)","hi":"VoLTE (वॉयस ओवर लॉन्ग टर्म इवोल्यूशन)"},{"en":"VoIP (Voice over IP)","hi":"VoIP (वॉयस ओवर IP)"},{"en":"HTTP (Hypertext Transfer Protocol)","hi":"HTTP"},{"en":"SMTP (Simple Mail Transfer Protocol)","hi":"SMTP"}],"exp":{"en":"VoLTE (Voice over Long Term Evolution) is the standard for delivering high-quality voice calls over 4G LTE packet networks.","hi":"LTE/4G नेटवर्क पर पैकेट-आधारित वॉयस सेवा प्रदान करने वाली तकनीक को VoLTE कहते हैं।"},"num":130},{"id":"q131","q":{"en":"Which terms distinguish the actual cable layout from how data flows in a network?","hi":"किन शब्दों से केबल के वास्तविक लेआउट और नेटवर्क में डेटा प्रवाह (data flow) के लेआउट में अंतर किया जाता है?"},"a":{"en":"Physical topology vs Logical topology","hi":"फिजिकल टोपोलॉजी बनाम लॉजिकल टोपोलॉजी"},"o":[{"en":"Physical topology vs Logical topology","hi":"फिजिकल टोपोलॉजी बनाम लॉजिकल टोपोलॉजी"},{"en":"LAN vs WAN","hi":"LAN बनाम WAN"},{"en":"Client vs Server","hi":"क्लाइंट बनाम सर्वर"},{"en":"Analog vs Digital","hi":"एनालॉग बनाम डिजिटल"}],"exp":{"en":"Physical topology is the geometric arrangement of cables and devices; Logical topology is how data actually travels through them.","hi":"केबलों/उपकरणों की भौतिक व्यवस्था को 'फिजिकल टोपोलॉजी' और डेटा के बहने के तरीके को 'लॉजिकल टोपोलॉजी' कहते हैं।"},"num":131},{"id":"q132","q":{"en":"Which topology arranges nodes in a closed circular path?","hi":"कौन-सी टोपोलॉजी नोड्स को एक बंद गोलाकार पथ (circular path) में व्यवस्थित करती है?"},"a":{"en":"Ring topology","hi":"रिंग टोपोलॉजी (Ring topology)"},"o":[{"en":"Ring topology","hi":"रिंग टोपोलॉजी (Ring topology)"},{"en":"Star topology","hi":"स्टार टोपोलॉजी"},{"en":"Bus topology","hi":"बस टोपोलॉजी"},{"en":"Mesh topology","hi":"मेश टोपोलॉजी"}],"exp":{"en":"In a ring topology, each node connects to exactly two other nodes, forming a continuous circular pathway.","hi":"रिंग टोपोलॉजी (Ring topology) में सभी नोड्स एक बंद गोलाकार लूप में जुड़े होते हैं।"},"num":132},{"id":"q133","q":{"en":"Which topology connects all nodes to a single shared central backbone cable?","hi":"कौन-सी टोपोलॉजी सभी नोड्स को एक साझा केंद्रीय बैकबोन केबल (shared backbone) से जोड़ती है?"},"a":{"en":"Bus topology","hi":"बस टोपोलॉजी (Bus topology)"},"o":[{"en":"Bus topology","hi":"बस टोपोलॉजी (Bus topology)"},{"en":"Ring topology","hi":"रिंग टोपोलॉजी"},{"en":"Star topology","hi":"स्टार टोपोलॉजी"},{"en":"Mesh topology","hi":"मेश टोपोलॉजी"}],"exp":{"en":"A bus topology (linear bus) uses a single main cable (backbone) to which all peripheral nodes are attached.","hi":"बस टोपोलॉजी (Bus topology) में सभी नोड्स एक मुख्य केंद्रीय बैकबोन केबल से जुड़े होते हैं।"},"num":133},{"id":"q134","q":{"en":"Which topology connects all endpoints to a central node (like a hub or switch)?","hi":"कौन-सी टोपोलॉजी सभी एंडपॉइंट्स को एक केंद्रीय नोड (जैसे हब या स्विच) से जोड़ती है?"},"a":{"en":"Star topology","hi":"स्टार टोपोलॉजी (Star topology)"},"o":[{"en":"Star topology","hi":"स्टार टोपोलॉजी (Star topology)"},{"en":"Bus topology","hi":"बस टोपोलॉजी"},{"en":"Ring topology","hi":"रिंग टोपोलॉजी"},{"en":"Tree topology","hi":"ट्री टोपोलॉजी"}],"exp":{"en":"In a star topology, every device connects individually to a central hub, switch, or controller.","hi":"स्टार टोपोलॉजी (Star topology) में प्रत्येक उपकरण एक अलग केबल के माध्यम से केंद्रीय हब या स्विच से जुड़ता है।"},"num":134},{"id":"q135","q":{"en":"In which topology is every pair of nodes directly linked to each other?","hi":"किस टोपोलॉजी में नोड्स का हर जोड़ा एक-दूसरे से सीधे जुड़ा होता है?"},"a":{"en":"Full mesh topology","hi":"फुल मेश टोपोलॉजी (Full mesh topology)"},"o":[{"en":"Full mesh topology","hi":"फुल मेश टोपोलॉजी (Full mesh topology)"},{"en":"Partial mesh topology","hi":"पार्शियल मेश टोपोलॉजी"},{"en":"Star topology","hi":"स्टार टोपोलॉजी"},{"en":"Tree topology","hi":"ट्री टोपोलॉजी"}],"exp":{"en":"A full mesh topology provides maximum reliability because there is a dedicated point-to-point link between every single pair of nodes.","hi":"फुल मेश टोपोलॉजी (Full mesh topology) में प्रत्येक नोड नेटवर्क के हर दूसरे नोड से सीधे पॉइंट-टू-पॉइंट लिंक द्वारा जुड़ा होता है।"},"num":135},{"id":"q136","q":{"en":"What is the formula for the number of links in a full mesh topology with n nodes?","hi":"'n' नोड्स वाली फुल मेश टोपोलॉजी में लिंक्स की संख्या का सूत्र क्या है?"},"a":{"en":"n(n−1)/2","hi":"n(n−1)/2"},"o":[{"en":"n(n−1)/2","hi":"n(n−1)/2"},{"en":"n+1","hi":"n+1"},{"en":"2n","hi":"2n"},{"en":"n-1","hi":"n-1"}],"exp":{"en":"Because each undirected link connects two nodes, the total number of point-to-point physical links required is n(n−1)/2.","hi":"फुल मेश में कुल अनडायरेक्टेड लिंक्स की संख्या का सूत्र n(n−1)/2 है।"},"num":136},{"id":"q137","q":{"en":"Which Layer 1 device regenerates digital signals to extend a link's distance?","hi":"कौन-सा लेयर 1 उपकरण दूरी बढ़ाने के लिए डिजिटल सिग्नल को रीजेनरेट (पुनर्जीवित) करता है?"},"a":{"en":"Repeater","hi":"रिपीटर (Repeater)"},"o":[{"en":"Repeater","hi":"रिपीटर (Repeater)"},{"en":"Router","hi":"राउटर"},{"en":"Bridge","hi":"ब्रिज"},{"en":"Gateway","hi":"गेटवे"}],"exp":{"en":"A repeater operates at the physical layer, cleaning and amplifying weakened digital signals so they can travel further.","hi":"रिपीटर (Repeater) कमजोर हो चुके सिग्नल को रीजेनरेट करके नेटवर्क लिंक की भौतिक दूरी को बढ़ाता है।"},"num":137},{"id":"q138","q":{"en":"What is the common name for a wired network adapter (NIC) in a LAN?","hi":"LAN में वायर्ड नेटवर्क एडाप्टर (NIC) का सामान्य नाम क्या है?"},"a":{"en":"Ethernet Card (Ethernet NIC)","hi":"ईथरनेट कार्ड (Ethernet NIC)"},"o":[{"en":"Ethernet Card (Ethernet NIC)","hi":"ईथरनेट कार्ड (Ethernet NIC)"},{"en":"Modem","hi":"मॉडेम"},{"en":"Bluetooth dongle","hi":"ब्लूटूथ डोंगल"},{"en":"VGA Card","hi":"VGA कार्ड"}],"exp":{"en":"An Ethernet card (or Ethernet NIC) is the hardware component used to connect a computer to a wired Local Area Network.","hi":"कंप्यूटर को वायर्ड LAN से जोड़ने वाले नेटवर्क इंटरफेस कार्ड (NIC) को ईथरनेट कार्ड (Ethernet Card) कहा जाता है।"},"num":138},{"id":"q139","q":{"en":"How does a Layer-2 switch handle a broadcast or unknown unicast frame?","hi":"एक लेयर-2 स्विच ब्रॉडकास्ट या अज्ञात यूनिकास्ट (unknown unicast) फ्रेम को कैसे संभालता है?"},"a":{"en":"It floods the frame out to all applicable ports in the same VLAN","hi":"यह फ्रेम को समान VLAN के सभी लागू पोर्ट्स पर फ्लड (प्रसारित) कर देता है"},"o":[{"en":"It floods the frame out to all applicable ports in the same VLAN","hi":"यह फ्रेम को समान VLAN के सभी लागू पोर्ट्स पर फ्लड (प्रसारित) कर देता है"},{"en":"It drops the frame immediately","hi":"यह फ्रेम को तुरंत ड्रॉप कर देता है"},{"en":"It sends it back to the sender","hi":"यह उसे वापस प्रेषक को भेज देता है"},{"en":"It converts it into an IP packet","hi":"यह उसे IP पैकेट में बदल देता है"}],"exp":{"en":"If a switch receives a broadcast frame (or a unicast frame whose destination MAC is not in its table), it floods the frame out all ports except the incoming one.","hi":"ब्रॉडकास्ट फ्रेम या अज्ञात गंतव्य वाले फ्रेम को स्विच अपने VLAN के अन्य सभी सक्रिय पोर्ट्स पर फ्लड (flood/प्रसारित) कर देता है।"},"num":139},{"id":"q140","q":{"en":"What is the Layer-3 logical address used for routing across networks?","hi":"नेटवर्कों के पार रूटिंग (routing) के लिए उपयोग किए जाने वाले लेयर-3 लॉजिकल एड्रेस को क्या कहते हैं?"},"a":{"en":"IP address","hi":"IP एड्रेस (IP address)"},"o":[{"en":"IP address","hi":"IP एड्रेस (IP address)"},{"en":"MAC address","hi":"MAC एड्रेस"},{"en":"Port number","hi":"पोर्ट नंबर"},{"en":"URL","hi":"URL"}],"exp":{"en":"The Internet Protocol (IP) address is a logical Layer-3 address that uniquely identifies a host's connection on a network and is used by routers to deliver packets.","hi":"राउटर द्वारा नेटवर्कों के बीच पैकेट रूट करने के लिए जिस लेयर-3 लॉजिकल पते का उपयोग होता है, उसे IP एड्रेस कहते हैं।"},"num":140},{"id":"q141","q":{"en":"How many bits are in an IPv4 address and an IPv6 address, respectively?","hi":"IPv4 एड्रेस और IPv6 एड्रेस में क्रमशः कितने बिट्स (bits) होते हैं?"},"a":{"en":"32 bits and 128 bits","hi":"32 बिट्स और 128 बिट्स"},"o":[{"en":"32 bits and 128 bits","hi":"32 बिट्स और 128 बिट्स"},{"en":"16 bits and 64 bits","hi":"16 बिट्स और 64 बिट्स"},{"en":"48 bits and 128 bits","hi":"48 बिट्स और 128 बिट्स"},{"en":"32 bits and 64 bits","hi":"32 बिट्स और 64 बिट्स"}],"exp":{"en":"An IPv4 address is 32 bits (4 bytes) long, whereas an IPv6 address is 128 bits (16 bytes) long to accommodate a vastly larger address space.","hi":"IPv4 एड्रेस 32 बिट्स का होता है, जबकि IPv6 एड्रेस 128 बिट्स का होता है।"},"num":141},{"id":"q142","q":{"en":"Which type of malware encrypts files and demands payment?","hi":"कौन-सा मैलवेयर फ़ाइलों को एन्क्रिप्ट (लॉक) करता है और भुगतान (payment) की माँग करता है?"},"a":{"en":"Ransomware","hi":"रैनसमवेयर (Ransomware)"},"o":[{"en":"Ransomware","hi":"रैनसमवेयर (Ransomware)"},{"en":"Adware","hi":"एडवेयर"},{"en":"Spyware","hi":"स्पाईवेयर"},{"en":"Rootkit","hi":"रूटकिट"}],"exp":{"en":"Ransomware is extortion software that locks users out of their data or devices by encrypting files, demanding a ransom payment for the decryption key.","hi":"रैनसमवेयर (Ransomware) उपयोगकर्ता की फ़ाइलों को एन्क्रिप्ट कर देता है और उन्हें वापस खोलने के लिए फिरौती (ransom) की माँग करता है।"},"num":142},{"id":"q143","q":{"en":"Which malware activates only when a specific time or event condition is met?","hi":"कौन-सा मैलवेयर केवल किसी विशिष्ट समय या घटना (event) के पूरा होने पर सक्रिय (activate) होता है?"},"a":{"en":"Logic Bomb","hi":"लॉजिक बम (Logic Bomb)"},"o":[{"en":"Logic Bomb","hi":"लॉजिक बम (Logic Bomb)"},{"en":"Trojan Horse","hi":"ट्रोजन हॉर्स"},{"en":"Keylogger","hi":"कीलॉगर"},{"en":"Worm","hi":"वर्म"}],"exp":{"en":"A logic bomb is a piece of code intentionally inserted into software that executes a malicious function only when predefined logical conditions (like a specific date/time or event) are met.","hi":"लॉजिक बम (Logic Bomb) वह दुर्भावनापूर्ण कोड है जो किसी विशिष्ट घटना, तारीख या शर्त के पूरा होने पर ही सक्रिय (trigger) होता है।"},"num":143}]}],"7. Cybersecurity — CIA Triad, Malware, Hacking, Network Attacks & Controls":[{"title":{"en":"1. Cybersecurity Basics & CIA Triad","hi":"1. साइबर सुरक्षा के मूल सिद्धांत और CIA ट्रायड"},"questions":[{"id":"q1","q":{"en":"What is Cybersecurity?","hi":"साइबर सुरक्षा (Cybersecurity) क्या है?"},"a":{"en":"Protecting computer systems, networks, and data from unauthorized access, theft, damage, and disruption","hi":"कंप्यूटर सिस्टम, नेटवर्क और डेटा को अनधिकृत एक्सेस, चोरी, क्षति और व्यवधान से बचाना"},"o":[{"en":"The study of ancient communication methods","hi":"प्राचीन संचार विधियों का अध्ययन"},{"en":"Protecting computer systems, networks, and data from unauthorized access, theft, damage, and disruption","hi":"कंप्यूटर सिस्टम, नेटवर्क और डेटा को अनधिकृत एक्सेस, चोरी, क्षति और व्यवधान से बचाना"},{"en":"A physical lock for a server room","hi":"सर्वर रूम के लिए एक भौतिक ताला"},{"en":"A tool for recovering deleted emails","hi":"डिलीट किए गए ईमेल को पुनर्प्राप्त करने का एक टूल"}],"exp":{"en":"Cybersecurity refers to the practices, technologies, and processes designed to protect systems, networks, programs, and data from digital attacks, damage, or unauthorized access.","hi":"साइबर सुरक्षा का अर्थ है कंप्यूटर, सर्वर, मोबाइल डिवाइस, इलेक्ट्रॉनिक सिस्टम, नेटवर्क और डेटा को डिजिटल हमलों, चोरी या अनधिकृत एक्सेस से सुरक्षित रखना।"},"num":1},{"id":"q2","q":{"en":"What does the CIA triad stand for?","hi":"CIA ट्रायड (CIA triad) का फुल फॉर्म क्या है?"},"a":{"en":"Confidentiality, Integrity, and Availability","hi":"कॉन्फिडेंशियलिटी, इंटीग्रिटी और अवेलेबिलिटी"},"o":[{"en":"Computer, Internet, and Architecture","hi":"कंप्यूटर, इंटरनेट और आर्किटेक्चर"},{"en":"Central Intelligence Agency","hi":"सेंट्रल इंटेलिजेंस एजेंसी"},{"en":"Confidentiality, Integrity, and Availability","hi":"कॉन्फिडेंशियलिटी, इंटीग्रिटी और अवेलेबिलिटी"},{"en":"Cyber, Information, and Access","hi":"साइबर, इन्फॉर्मेशन और एक्सेस"}],"exp":{"en":"The CIA triad is a foundational concept in information security consisting of three core goals: Confidentiality, Integrity, and Availability.","hi":"सूचना सुरक्षा (Information Security) में CIA ट्रायड एक मूल मॉडल है जिसके तीन मुख्य लक्ष्य हैं: कॉन्फिडेंशियलिटी (गोपनीयता), इंटीग्रिटी (अखंडता) और अवेलेबिलिटी (उपलब्धता)।"},"num":2},{"id":"q3","q":{"en":"What is the meaning of 'Confidentiality' in the CIA triad?","hi":"CIA ट्रायड में 'कॉन्फिडेंशियलिटी' (Confidentiality) का क्या अर्थ है?"},"a":{"en":"Ensuring that sensitive data is accessible only to authorized users or systems","hi":"यह सुनिश्चित करना कि संवेदनशील डेटा केवल अधिकृत उपयोगकर्ताओं (authorized users) या सिस्टम तक ही सुलभ हो"},"o":[{"en":"Ensuring that sensitive data is accessible only to authorized users or systems","hi":"यह सुनिश्चित करना कि संवेदनशील डेटा केवल अधिकृत उपयोगकर्ताओं (authorized users) या सिस्टम तक ही सुलभ हो"},{"en":"Ensuring that the network is always online","hi":"यह सुनिश्चित करना कि नेटवर्क हमेशा ऑनलाइन रहे"},{"en":"Ensuring that data is backed up daily","hi":"यह सुनिश्चित करना कि डेटा का दैनिक बैकअप लिया जाए"},{"en":"Ensuring that passwords are easy to remember","hi":"यह सुनिश्चित करना कि पासवर्ड याद रखना आसान हो"}],"exp":{"en":"Confidentiality ensures that data is kept private and is not disclosed to unauthorized individuals, programs, or processes. Encryption and access controls support this goal.","hi":"कॉन्फिडेंशियलिटी (गोपनीयता) यह सुनिश्चित करती है कि संवेदनशील जानकारी केवल उन्हीं लोगों या सिस्टम को मिले जिन्हें इसकी अनुमति (authorized) है।"},"num":3},{"id":"q4","q":{"en":"What is the meaning of 'Integrity' in the CIA triad?","hi":"CIA ट्रायड में 'इंटीग्रिटी' (Integrity) का क्या अर्थ है?"},"a":{"en":"Ensuring that data remains accurate and complete, and preventing or detecting unauthorized changes","hi":"यह सुनिश्चित करना कि डेटा सटीक और पूर्ण बना रहे, और अनधिकृत बदलावों को रोकना या उनका पता लगाना"},"o":[{"en":"Making sure the hardware is not physically broken","hi":"यह सुनिश्चित करना कि हार्डवेयर भौतिक रूप से टूटा हुआ न हो"},{"en":"Ensuring that data remains accurate and complete, and preventing or detecting unauthorized changes","hi":"यह सुनिश्चित करना कि डेटा सटीक और पूर्ण बना रहे, और अनधिकृत बदलावों को रोकना या उनका पता लगाना"},{"en":"Keeping the network speed high","hi":"नेटवर्क की गति को उच्च बनाए रखना"},{"en":"Connecting multiple servers together","hi":"कई सर्वरों को एक साथ जोड़ना"}],"exp":{"en":"Integrity guarantees that data has not been tampered with or altered by unauthorized users or errors, maintaining its trustworthiness.","hi":"इंटीग्रिटी (अखंडता) का अर्थ है कि डेटा सटीक, पूर्ण और भरोसेमंद रहे, और बिना अनुमति के उसमें कोई भी बदलाव या छेड़छाड़ (tampering) न हो सके।"},"num":4},{"id":"q5","q":{"en":"What is the meaning of 'Availability' in the CIA triad?","hi":"CIA ट्रायड में 'अवेलेबिलिटी' (Availability) का क्या अर्थ है?"},"a":{"en":"Ensuring that authorized users have access to systems and data whenever they need it","hi":"यह सुनिश्चित करना कि अधिकृत उपयोगकर्ताओं को जब भी आवश्यकता हो, सिस्टम और डेटा तक उनकी पहुंच (access) हो"},"o":[{"en":"Storing data on multiple cloud providers","hi":"कई क्लाउड प्रदाताओं पर डेटा स्टोर करना"},{"en":"Making sure the system is free for anyone to use","hi":"यह सुनिश्चित करना कि सिस्टम किसी के भी उपयोग के लिए मुफ्त हो"},{"en":"Ensuring that authorized users have access to systems and data whenever they need it","hi":"यह सुनिश्चित करना कि अधिकृत उपयोगकर्ताओं को जब भी आवश्यकता हो, सिस्टम और डेटा तक उनकी पहुंच (access) हो"},{"en":"Hiding the data from everyone","hi":"डेटा को सभी से छिपाना"}],"exp":{"en":"Availability ensures that systems, applications, and data are functioning and accessible to authorized users when required, protecting against outages or denial-of-service.","hi":"अवेलेबिलिटी (उपलब्धता) यह सुनिश्चित करती है कि अधिकृत उपयोगकर्ताओं (authorized users) को सिस्टम और डेटा की आवश्यकता होने पर वे हमेशा उपलब्ध रहें और काम करें।"},"num":5},{"id":"q6","q":{"en":"Which CIA goals are affected by a patient records leak, changing marks unethically, and a server outage, respectively?","hi":"रोगी के रिकॉर्ड लीक होना, अनैतिक रूप से अंक (marks) बदलना, और सर्वर आउटेज (server outage) क्रमशः CIA के किन लक्ष्यों को प्रभावित करते हैं?"},"a":{"en":"Confidentiality, Integrity, and Availability (Leak → confidentiality, unauthorized marks edit → integrity, outage → availability)","hi":"कॉन्फिडेंशियलिटी, इंटीग्रिटी और अवेलेबिलिटी (लीक → कॉन्फिडेंशियलिटी, अनधिकृत अंक संपादन → इंटीग्रिटी, आउटेज → अवेलेबिलिटी)"},"o":[{"en":"Availability, Integrity, and Confidentiality","hi":"अवेलेबिलिटी, इंटीग्रिटी और कॉन्फिडेंशियलिटी"},{"en":"Confidentiality, Integrity, and Availability (Leak → confidentiality, unauthorized marks edit → integrity, outage → availability)","hi":"कॉन्फिडेंशियलिटी, इंटीग्रिटी और अवेलेबिलिटी (लीक → कॉन्फिडेंशियलिटी, अनधिकृत अंक संपादन → इंटीग्रिटी, आउटेज → अवेलेबिलिटी)"},{"en":"Integrity, Availability, and Confidentiality","hi":"इंटीग्रिटी, अवेलेबिलिटी और कॉन्फिडेंशियलिटी"},{"en":"All three affect Confidentiality","hi":"तीनों कॉन्फिडेंशियलिटी को प्रभावित करते हैं"}],"exp":{"en":"A data leak compromises confidentiality. Changing records compromises integrity. A server crash or DDoS attack compromises availability.","hi":"रोगी का डेटा लीक होना 'गोपनीयता' (Confidentiality) का उल्लंघन है; अंक बदलना 'अखंडता' (Integrity) का उल्लंघन है; और सर्वर डाउन होना 'उपलब्धता' (Availability) को प्रभावित करता है।"},"num":6},{"id":"q7","q":{"en":"What is a 'threat' in cybersecurity?","hi":"साइबर सुरक्षा में 'थ्रेट' (Threat) क्या है?"},"a":{"en":"Any potential event, actor, or circumstance that could harm a system or information","hi":"कोई भी संभावित घटना, कर्ता (actor) या परिस्थिति जो सिस्टम या जानकारी को नुकसान पहुंचा सकती है"},"o":[{"en":"A strong password","hi":"एक मजबूत पासवर्ड"},{"en":"A type of antivirus software","hi":"एक प्रकार का एंटीवायरस सॉफ्टवेयर"},{"en":"Any potential event, actor, or circumstance that could harm a system or information","hi":"कोई भी संभावित घटना, कर्ता (actor) या परिस्थिति जो सिस्टम या जानकारी को नुकसान पहुंचा सकती है"},{"en":"A backup hard drive","hi":"एक बैकअप हार्ड ड्राइव"}],"exp":{"en":"A threat is any potential danger (like a hacker, malware, or natural disaster) that might exploit a vulnerability to breach security and cause harm.","hi":"थ्रेट (खतरा) कोई भी संभावित घटना या हमलावर है जो किसी सिस्टम को नुकसान पहुँचाने, डेटा चुराने या सेवा को बाधित करने की कोशिश कर सकता है।"},"num":7},{"id":"q8","q":{"en":"What is a 'vulnerability'?","hi":"'वल्नरेबिलिटी' (Vulnerability) क्या होती है?"},"a":{"en":"A weakness, such as unpatched software, insecure configuration, or weak access control, that can be exploited","hi":"एक कमजोरी, जैसे अनपैच्ड सॉफ्टवेयर, असुरक्षित कॉन्फ़िगरेशन या कमजोर एक्सेस कंट्रोल, जिसका शोषण (exploit) किया जा सकता है"},"o":[{"en":"A weakness, such as unpatched software, insecure configuration, or weak access control, that can be exploited","hi":"एक कमजोरी, जैसे अनपैच्ड सॉफ्टवेयर, असुरक्षित कॉन्फ़िगरेशन या कमजोर एक्सेस कंट्रोल, जिसका शोषण (exploit) किया जा सकता है"},{"en":"A new computer processor","hi":"एक नया कंप्यूटर प्रोसेसर"},{"en":"A fully secure network","hi":"एक पूरी तरह से सुरक्षित नेटवर्क"},{"en":"A successful cybersecurity defense","hi":"एक सफल साइबर सुरक्षा बचाव"}],"exp":{"en":"A vulnerability is a flaw or weakness in a system's design, implementation, or operation that could be accidentally triggered or intentionally exploited.","hi":"वल्नरेबिलिटी (कमजोरी या खामी) सिस्टम, नेटवर्क या सॉफ़्टवेयर में मौजूद वह दोष है जिसका फ़ायदा उठाकर हमलावर (Threat) सिस्टम में सेंध लगा सकते हैं।"},"num":8},{"id":"q9","q":{"en":"What is the exam distinction between a threat and a vulnerability?","hi":"थ्रेट (Threat) और वल्नरेबिलिटी (Vulnerability) के बीच परीक्षा का मुख्य अंतर क्या है?"},"a":{"en":"Threat is a potential danger; vulnerability is a weakness that the threat can take advantage of","hi":"थ्रेट एक संभावित खतरा है; वल्नरेबिलिटी एक कमजोरी है जिसका थ्रेट फायदा उठा सकता है"},"o":[{"en":"Threat is a weakness; vulnerability is the danger","hi":"थ्रेट एक कमजोरी है; वल्नरेबिलिटी खतरा है"},{"en":"Threat is a potential danger; vulnerability is a weakness that the threat can take advantage of","hi":"थ्रेट एक संभावित खतरा है; वल्नरेबिलिटी एक कमजोरी है जिसका थ्रेट फायदा उठा सकता है"},{"en":"Both mean the exact same thing","hi":"दोनों का मतलब बिल्कुल एक ही है"},{"en":"Threats only happen offline, vulnerabilities only happen online","hi":"थ्रेट केवल ऑफलाइन होते हैं, वल्नरेबिलिटी केवल ऑनलाइन होती हैं"}],"exp":{"en":"A vulnerability is a gap in protection (the unlocked door). A threat is what might exploit that gap (the burglar).","hi":"सरल शब्दों में: वल्नरेबिलिटी आपके सिस्टम की 'कमजोरी' (जैसे खुला हुआ दरवाज़ा) है, और थ्रेट वह 'खतरा' या 'हमलावर' है जो उस दरवाज़े से अंदर आ सकता है।"},"num":9},{"id":"q10","q":{"en":"What is the meaning of malware?","hi":"मैलवेयर (Malware) का क्या अर्थ है?"},"a":{"en":"Malicious software or code designed to harm, spy on, disrupt, or misuse systems, data, or users","hi":"दुर्भावनापूर्ण सॉफ्टवेयर (Malicious software) या कोड जिसे सिस्टम, डेटा या उपयोगकर्ताओं को नुकसान पहुंचाने, जासूसी करने, बाधित करने या दुरुपयोग करने के लिए डिज़ाइन किया गया है"},"o":[{"en":"Malicious software or code designed to harm, spy on, disrupt, or misuse systems, data, or users","hi":"दुर्भावनापूर्ण सॉफ्टवेयर (Malicious software) या कोड जिसे सिस्टम, डेटा या उपयोगकर्ताओं को नुकसान पहुंचाने, जासूसी करने, बाधित करने या दुरुपयोग करने के लिए डिज़ाइन किया गया है"},{"en":"Software used for managing hardware","hi":"हार्डवेयर के प्रबंधन के लिए उपयोग किया जाने वाला सॉफ्टवेयर"},{"en":"A secure network protocol","hi":"एक सुरक्षित नेटवर्क प्रोटोकॉल"},{"en":"A high-speed internet connection","hi":"एक हाई-स्पीड इंटरनेट कनेक्शन"}],"exp":{"en":"Malware is a broad portmanteau term for 'malicious software'. It encompasses viruses, worms, trojans, ransomware, spyware, and other harmful programs.","hi":"मैलवेयर (Malicious Software) कोई भी ऐसा सॉफ़्टवेयर या कोड है जो कंप्यूटर, नेटवर्क या मोबाइल डिवाइस को नुकसान पहुँचाने, डेटा चुराने या उसकी कार्यप्रणाली को खराब करने के इरादे से बनाया गया हो।"},"num":10},{"id":"q11","q":{"en":"Which of the following correctly lists the major types of malware covered in the chapter?","hi":"इस अध्याय में शामिल मैलवेयर के प्रमुख प्रकारों की सही सूची कौन-सी है?"},"o":[{"en":"Firewall, router, switch, modem, and antivirus","hi":"फ़ायरवॉल, राउटर, स्विच, मॉडेम और एंटीवायरस"},{"en":"Virus, worm, Trojan, spyware, adware, rootkit, keylogger, logic bomb, and ransomware","hi":"वायरस, वर्म, ट्रोजन, स्पाइवेयर, एडवेयर, रूटकिट, कीलॉगर, लॉजिक बम और रैनसमवेयर"},{"en":"CPU, ALU, registers, RAM, and ROM","hi":"सीपीयू, एएलयू, रजिस्टर, रैम और रोम"},{"en":"HTML, CSS, SQL, Python, and Java","hi":"HTML, CSS, SQL, Python और Java"}],"a":{"en":"Virus, worm, Trojan, spyware, adware, rootkit, keylogger, logic bomb, and ransomware","hi":"वायरस, वर्म, ट्रोजन, स्पाइवेयर, एडवेयर, रूटकिट, कीलॉगर, लॉजिक बम और रैनसमवेयर"},"exp":{"en":"The source HTML lists virus, worm, Trojan, spyware, adware, rootkit, keylogger, logic bomb, and ransomware as major malware categories.","hi":"स्रोत HTML में वायरस, वर्म, ट्रोजन, स्पाइवेयर, एडवेयर, रूटकिट, कीलॉगर, लॉजिक बम तथा रैनसमवेयर को मैलवेयर के प्रमुख प्रकारों में शामिल किया गया है।"},"num":11},{"id":"q12","q":{"en":"What is a botnet in cybersecurity?","hi":"साइबर सुरक्षा में बॉटनेट (Botnet) क्या होता है?"},"o":[{"en":"A secure group of backup storage devices","hi":"बैकअप स्टोरेज डिवाइसेज़ का एक सुरक्षित समूह"},{"en":"A list of approved antivirus applications","hi":"स्वीकृत एंटीवायरस एप्लिकेशनों की सूची"},{"en":"A network of compromised devices controlled remotely, often through malware","hi":"मैलवेयर के माध्यम से संक्रमित/कम्प्रोमाइज़ हुए और दूर से नियंत्रित किए जाने वाले डिवाइसेज़ का नेटवर्क"},{"en":"A private website for software documentation","hi":"सॉफ्टवेयर डॉक्यूमेंटेशन की एक निजी वेबसाइट"}],"a":{"en":"A network of compromised devices controlled remotely, often through malware","hi":"मैलवेयर के माध्यम से संक्रमित/कम्प्रोमाइज़ हुए और दूर से नियंत्रित किए जाने वाले डिवाइसेज़ का नेटवर्क"},"exp":{"en":"A botnet is a network of compromised devices that can be controlled remotely. Malware can enroll devices in such a network.","hi":"बॉटनेट ऐसे कम्प्रोमाइज़ किए गए उपकरणों का नेटवर्क है जिन्हें दूर से नियंत्रित किया जा सकता है। मैलवेयर किसी डिवाइस को बॉटनेट का हिस्सा बना सकता है।"},"num":12},{"id":"q13","q":{"en":"Which statement about IP addresses matches the chapter source recap?","hi":"अध्याय के स्रोत में IP एड्रेस के पुनरावलोकन के अनुसार कौन-सा कथन सही है?"},"o":[{"en":"An IP address is only a physical cable identifier; IPv4 uses 128 bits and IPv6 uses 32 bits","hi":"IP केवल केबल की भौतिक पहचान है; IPv4 128-बिट तथा IPv6 32-बिट होता है"},{"en":"IPv4 and IPv6 both use 16-bit addresses","hi":"IPv4 और IPv6 दोनों 16-बिट एड्रेस का उपयोग करते हैं"},{"en":"An IP address is always a permanent, globally unique identifier","hi":"IP एड्रेस हमेशा स्थायी तथा विश्वभर में अद्वितीय पहचान होता है"},{"en":"An IP address is a logical network address; IPv4 uses 32 bits and IPv6 uses 128 bits","hi":"IP एड्रेस एक लॉजिकल नेटवर्क एड्रेस है; IPv4 32-बिट तथा IPv6 128-बिट का होता है"}],"a":{"en":"An IP address is a logical network address; IPv4 uses 32 bits and IPv6 uses 128 bits","hi":"IP एड्रेस एक लॉजिकल नेटवर्क एड्रेस है; IPv4 32-बिट तथा IPv6 128-बिट का होता है"},"exp":{"en":"The source HTML describes IP as a logical network address: IPv4 is 32 bits (for example, 192.168.0.178) and IPv6 is 128 bits (for example, 2001:db8::1). Its source-page recap overlaps Chapter 06.","hi":"स्रोत HTML के अनुसार IP एक तार्किक नेटवर्क एड्रेस है। IPv4 32-बिट (जैसे 192.168.0.178) और IPv6 128-बिट (जैसे 2001:db8::1) का होता है। यह पुनरावलोकन पिछले अध्याय से आंशिक रूप से जुड़ा है।"},"num":13}]},{"title":{"en":"2. Indian Cybersecurity Bodies & Policy","hi":"2. भारतीय साइबर सुरक्षा निकाय और नीतियाँ"},"questions":[{"id":"q14","q":{"en":"What is the full form and role of CERT-In?","hi":"CERT-In का फुल फॉर्म और इसकी भूमिका क्या है?"},"a":{"en":"Indian Computer Emergency Response Team; it coordinates responses to computer-security incidents and issues national alerts/advisories","hi":"इंडियन कंप्यूटर इमरजेंसी रिस्पॉन्स टीम; यह कंप्यूटर-सुरक्षा घटनाओं (incidents) पर प्रतिक्रिया समन्वय (response coordination) और राष्ट्रीय अलर्ट/एडवाइजरी जारी करने का कार्य करता है"},"o":[{"en":"Central Electronic Routing Team; it manages internet speed","hi":"सेंट्रल इलेक्ट्रॉनिक राउटिंग टीम; यह इंटरनेट स्पीड प्रबंधित करता है"},{"en":"Computer Engineering Research Team; it develops new hardware","hi":"कंप्यूटर इंजीनियरिंग रिसर्च टीम; यह नए हार्डवेयर विकसित करता है"},{"en":"Indian Computer Emergency Response Team; it coordinates responses to computer-security incidents and issues national alerts/advisories","hi":"इंडियन कंप्यूटर इमरजेंसी रिस्पॉन्स टीम; यह कंप्यूटर-सुरक्षा घटनाओं (incidents) पर प्रतिक्रिया समन्वय (response coordination) और राष्ट्रीय अलर्ट/एडवाइजरी जारी करने का कार्य करता है"},{"en":"Cyber Extortion Resolution Team; it catches hackers physically","hi":"साइबर एक्सटॉर्शन रिज़ॉल्यूशन टीम; यह हैकर्स को भौतिक रूप से पकड़ता है"}],"exp":{"en":"CERT-In is the national nodal agency under the Ministry of Electronics and Information Technology (MeitY) for responding to computer security incidents as they occur.","hi":"CERT-In (इंडियन कंप्यूटर इमरजेंसी रिस्पॉन्स टीम) भारत सरकार की नोडल एजेंसी है, जो साइबर हमलों और सुरक्षा खतरों से निपटने और उनसे बचाव के लिए अलर्ट जारी करती है।"},"num":14},{"id":"q15","q":{"en":"With which section of the IT Act is CERT-In associated?","hi":"CERT-In को IT अधिनियम (IT Act) की किस धारा से जोड़ा गया है?"},"a":{"en":"Section 70B, Information Technology Act, 2000","hi":"धारा 70B, सूचना प्रौद्योगिकी अधिनियम (IT Act), 2000"},"o":[{"en":"Section 66A","hi":"धारा 66A"},{"en":"Section 43","hi":"धारा 43"},{"en":"Section 70B, Information Technology Act, 2000","hi":"धारा 70B, सूचना प्रौद्योगिकी अधिनियम (IT Act), 2000"},{"en":"Section 69","hi":"धारा 69"}],"exp":{"en":"Section 70B of the Information Technology Act, 2000, explicitly designates CERT-In as the national agency for incident response and related cyber security functions.","hi":"सूचना प्रौद्योगिकी अधिनियम, 2000 की धारा 70B के तहत CERT-In को साइबर सुरक्षा घटनाओं से निपटने के लिए राष्ट्रीय एजेंसी के रूप में नामित किया गया है।"},"num":15},{"id":"q16","q":{"en":"What is the abbreviation for National Cyber Security Coordinator?","hi":"नेशनल साइबर सिक्योरिटी कोऑर्डिनेटर (National Cyber Security Coordinator) का संक्षिप्त रूप क्या है?"},"a":{"en":"NCSC. This role falls under the National Security Council Secretariat (NSCS) and involves coordinating cybersecurity among agencies","hi":"NCSC. यह नेशनल सिक्योरिटी काउंसिल सेक्रेटेरियट (NSCS) के अधीन एजेंसियों के बीच साइबर सुरक्षा समन्वय से जुड़ा रोल है"},"o":[{"en":"NCSC. This role falls under the National Security Council Secretariat (NSCS) and involves coordinating cybersecurity among agencies","hi":"NCSC. यह नेशनल सिक्योरिटी काउंसिल सेक्रेटेरियट (NSCS) के अधीन एजेंसियों के बीच साइबर सुरक्षा समन्वय से जुड़ा रोल है"},{"en":"NCCC","hi":"NCCC"},{"en":"NSCS","hi":"NSCS"},{"en":"CERT","hi":"CERT"}],"exp":{"en":"The NCSC (National Cyber Security Coordinator) functions under the Prime Minister's Office (specifically NSCS) to coordinate cyber security efforts across various government bodies.","hi":"NCSC (National Cyber Security Coordinator) भारत में विभिन्न एजेंसियों के बीच साइबर सुरक्षा प्रयासों का समन्वय (coordination) करता है और यह NSCS के अधीन कार्य करता है।"},"num":16},{"id":"q17","q":{"en":"In what year was the National Cyber Security Policy introduced?","hi":"राष्ट्रीय साइबर सुरक्षा नीति (National Cyber Security Policy) किस वर्ष लागू की गई थी?"},"a":{"en":"2013. This policy provided a framework for the national cybersecurity ecosystem and capability development","hi":"2013. इस नीति ने राष्ट्रीय साइबर सुरक्षा पारिस्थितिकी तंत्र (ecosystem) और क्षमता विकास (capability development) के लिए एक रूपरेखा प्रदान की"},"o":[{"en":"2000","hi":"2000"},{"en":"2013. This policy provided a framework for the national cybersecurity ecosystem and capability development","hi":"2013. इस नीति ने राष्ट्रीय साइबर सुरक्षा पारिस्थितिकी तंत्र (ecosystem) और क्षमता विकास (capability development) के लिए एक रूपरेखा प्रदान की"},{"en":"2018","hi":"2018"},{"en":"2021","hi":"2021"}],"exp":{"en":"The National Cyber Security Policy of 2013 was released to build a secure and resilient cyberspace for citizens, businesses, and the government in India.","hi":"भारत सरकार ने 2013 में राष्ट्रीय साइबर सुरक्षा नीति जारी की थी, जिसका उद्देश्य देश के साइबर स्पेस को सुरक्षित और लचीला (resilient) बनाना था।"},"num":17},{"id":"q18","q":{"en":"What is the official expansion of CCPWC?","hi":"CCPWC का आधिकारिक विस्तार (Full form) क्या है?"},"a":{"en":"Cyber Crime Prevention against Women and Children. It is a scheme of the Ministry of Home Affairs","hi":"महिलाओं और बच्चों के खिलाफ साइबर अपराध रोकथाम (Cyber Crime Prevention against Women and Children)। यह गृह मंत्रालय (Ministry of Home Affairs) की एक योजना है"},"o":[{"en":"Cyber Crime Police and Women Center","hi":"साइबर क्राइम पुलिस और महिला केंद्र"},{"en":"Cyber Crime Protection for Wireless Computers","hi":"वायरलेस कंप्यूटरों के लिए साइबर अपराध संरक्षण"},{"en":"Cyber Crime Prevention against Women and Children. It is a scheme of the Ministry of Home Affairs","hi":"महिलाओं और बच्चों के खिलाफ साइबर अपराध रोकथाम (Cyber Crime Prevention against Women and Children)। यह गृह मंत्रालय (Ministry of Home Affairs) की एक योजना है"},{"en":"Central Cyber Protection Web Committee","hi":"केंद्रीय साइबर संरक्षण वेब समिति"}],"exp":{"en":"CCPWC is an Indian government scheme managed by the Ministry of Home Affairs aimed at preventing cyber crimes specifically targeting women and children, including the launch of a national reporting portal.","hi":"CCPWC (Cyber Crime Prevention against Women and Children) गृह मंत्रालय की एक योजना है, जिसका उद्देश्य महिलाओं और बच्चों को साइबर अपराधों से बचाना है।"},"num":18},{"id":"q19","q":{"en":"What is the Cyber Swachhta Kendra?","hi":"साइबर स्वच्छता केंद्र (Cyber Swachhta Kendra) क्या है?"},"a":{"en":"CERT-In's Botnet Cleaning and Malware Analysis Centre initiative, providing alerts and cleanup resources for botnet and malware infections","hi":"CERT-In की 'बॉटनेट क्लीनिंग एंड मैलवेयर एनालिसिस सेंटर' पहल, जो बॉटनेट और मैलवेयर संक्रमणों के लिए अलर्ट और क्लीनअप संसाधन (cleanup resources) प्रदान करती है"},"o":[{"en":"A physical cleaning service for server rooms","hi":"सर्वर रूम के लिए एक भौतिक सफाई सेवा"},{"en":"CERT-In's Botnet Cleaning and Malware Analysis Centre initiative, providing alerts and cleanup resources for botnet and malware infections","hi":"CERT-In की 'बॉटनेट क्लीनिंग एंड मैलवेयर एनालिसिस सेंटर' पहल, जो बॉटनेट और मैलवेयर संक्रमणों के लिए अलर्ट और क्लीनअप संसाधन (cleanup resources) प्रदान करती है"},{"en":"A government office where you recycle old computers","hi":"एक सरकारी कार्यालय जहां आप पुराने कंप्यूटर रीसायकल करते हैं"},{"en":"An email filtering software","hi":"एक ईमेल फ़िल्टरिंग सॉफ्टवेयर"}],"exp":{"en":"The Cyber Swachhta Kendra is a Botnet Cleaning and Malware Analysis Centre operated by CERT-In to detect malicious software on citizens' devices and provide free removal tools.","hi":"साइबर स्वच्छता केंद्र (Cyber Swachhta Kendra) CERT-In द्वारा संचालित एक पहल है जो यूजर्स के कंप्यूटर और मोबाइल में बॉटनेट और मैलवेयर का पता लगाकर उन्हें हटाने (clean) के लिए मुफ्त टूल प्रदान करती है।"},"num":19},{"id":"q20","q":{"en":"What is the exam match for CERT-In and Cyber Swachhta Kendra?","hi":"CERT-In और साइबर स्वच्छता केंद्र (Cyber Swachhta Kendra) के लिए परीक्षा मिलान (Exam match) क्या है?"},"a":{"en":"CERT-In → incident response coordination; Cyber Swachhta Kendra → botnet cleaning and malware analysis","hi":"CERT-In → घटना प्रतिक्रिया समन्वय (incident response coordination); साइबर स्वच्छता केंद्र → बॉटनेट क्लीनिंग और मैलवेयर विश्लेषण"},"o":[{"en":"CERT-In → malware creation; Cyber Swachhta Kendra → antivirus sales","hi":"CERT-In → मैलवेयर निर्माण; साइबर स्वच्छता केंद्र → एंटीवायरस बिक्री"},{"en":"CERT-In → incident response coordination; Cyber Swachhta Kendra → botnet cleaning and malware analysis","hi":"CERT-In → घटना प्रतिक्रिया समन्वय (incident response coordination); साइबर स्वच्छता केंद्र → बॉटनेट क्लीनिंग और मैलवेयर विश्लेषण"},{"en":"CERT-In → hardware repair; Cyber Swachhta Kendra → software updates","hi":"CERT-In → हार्डवेयर मरम्मत; साइबर स्वच्छता केंद्र → सॉफ्टवेयर अपडेट"},{"en":"Both perform exactly the same function","hi":"दोनों बिल्कुल एक ही कार्य करते हैं"}],"exp":{"en":"For exams, remember the distinct keywords: CERT-In is the broader 'Incident Response' authority, while Cyber Swachhta Kendra specifically handles 'Botnet Cleaning and Malware Analysis'.","hi":"परीक्षा के लिए याद रखें: CERT-In का मुख्य कार्य 'साइबर घटनाओं पर प्रतिक्रिया और समन्वय' (Incident Response) है, जबकि साइबर स्वच्छता केंद्र का फोकस 'बॉटनेट क्लीनिंग और मैलवेयर विश्लेषण' पर है।"},"num":20}]},{"title":{"en":"3. Computer Virus, Virus Types & Worm","hi":"3. कम्प्यूटर वायरस, वायरस के प्रकार और वर्म"},"questions":[{"id":"q21","q":{"en":"What is a computer virus?","hi":"कंप्यूटर वायरस (Computer virus) क्या होता है?"},"a":{"en":"A self-replicating malicious code that can infect a host file, program, macro, or boot area","hi":"एक सेल्फ-रेप्लिकेटिंग (स्वयं की प्रतिलिपि बनाने वाला) दुर्भावनापूर्ण कोड जो किसी होस्ट फाइल, प्रोग्राम, मैक्रो या बूट एरिया को संक्रमित कर सकता है"},"o":[{"en":"A bug in the hardware","hi":"हार्डवेयर में एक बग"},{"en":"A harmless file used for testing","hi":"परीक्षण के लिए इस्तेमाल की जाने वाली एक हानिरहित फाइल"},{"en":"A self-replicating malicious code that can infect a host file, program, macro, or boot area","hi":"एक सेल्फ-रेप्लिकेटिंग (स्वयं की प्रतिलिपि बनाने वाला) दुर्भावनापूर्ण कोड जो किसी होस्ट फाइल, प्रोग्राम, मैक्रो या बूट एरिया को संक्रमित कर सकता है"},{"en":"An official update from an operating system vendor","hi":"ऑपरेटिंग सिस्टम विक्रेता की ओर से एक आधिकारिक अपडेट"}],"exp":{"en":"A computer virus is a specific type of malware that attaches itself to legitimate code or files (the host) and spreads when that host is executed or accessed.","hi":"कंप्यूटर वायरस एक दुर्भावनापूर्ण प्रोग्राम है जो किसी अन्य साफ फाइल या प्रोग्राम (Host) के साथ जुड़ जाता है और उसके रन होने पर कंप्यूटर में फैल जाता है।"},"num":21},{"id":"q22","q":{"en":"When can the virus code activate from an infected host?","hi":"एक संक्रमित होस्ट (Infected host) से वायरस का कोड कब सक्रिय (activate) हो सकता है?"},"a":{"en":"When the relevant infected file/program, macro, or boot code is executed","hi":"जब संबंधित संक्रमित फाइल/प्रोग्राम, मैक्रो या बूट कोड को निष्पादित (execute) किया जाता है"},"o":[{"en":"When the computer is turned off","hi":"जब कंप्यूटर बंद हो"},{"en":"When the relevant infected file/program, macro, or boot code is executed","hi":"जब संबंधित संक्रमित फाइल/प्रोग्राम, मैक्रो या बूट कोड को निष्पादित (execute) किया जाता है"},{"en":"Only on specific holidays","hi":"केवल विशिष्ट छुट्टियों पर"},{"en":"It runs continuously in the background without any trigger","hi":"यह बिना किसी ट्रिगर के बैकग्राउंड में लगातार चलता रहता है"}],"exp":{"en":"A traditional virus remains dormant until the user intentionally or unintentionally runs the infected host program or opens the infected document.","hi":"वायरस तब तक निष्क्रिय (dormant) रहता है जब तक कि यूज़र उस संक्रमित फाइल (infected file) या प्रोग्राम को खोलता या रन नहीं करता।"},"num":22},{"id":"q23","q":{"en":"What is the expansion of VIRUS on the slide and what is the exam caveat?","hi":"स्लाइड पर VIRUS का विस्तार (Expansion) क्या है और इसका परीक्षा से जुड़ा बिंदु क्या है?"},"a":{"en":"'Vital Information Resource Under Siege' is a popular backronym. In computer security, 'virus' is just the standard term","hi":"'Vital Information Resource Under Siege' एक लोकप्रिय बैक्रोनिम (backronym) है। कंप्यूटर सुरक्षा में 'वायरस' केवल मानक (standard) शब्द है"},"o":[{"en":"'Vital Information Resource Under Siege' is a popular backronym. In computer security, 'virus' is just the standard term","hi":"'Vital Information Resource Under Siege' एक लोकप्रिय बैक्रोनिम (backronym) है। कंप्यूटर सुरक्षा में 'वायरस' केवल मानक (standard) शब्द है"},{"en":"'Virtual Internet Routing User System' is the official name","hi":"'Virtual Internet Routing User System' आधिकारिक नाम है"},{"en":"'Various Intrusions Ruining User Systems'","hi":"'Various Intrusions Ruining User Systems'"},{"en":"There is no expansion; it's a made-up word","hi":"इसका कोई विस्तार नहीं है; यह एक बनावटी शब्द है"}],"exp":{"en":"The term 'virus' was originally borrowed from biology. 'Vital Information Resource Under Siege' was invented later as a backronym, but is often asked in basic computer awareness exams.","hi":"असल में 'वायरस' शब्द जीव विज्ञान (Biology) से लिया गया है। 'Vital Information Resources Under Siege' बाद में बनाया गया एक फुल फॉर्म (Backronym) है, जो अक्सर परीक्षाओं में पूछा जाता है।"},"num":23},{"id":"q24","q":{"en":"What does a file virus infect?","hi":"फाइल वायरस (File virus) किसे संक्रमित करता है?"},"a":{"en":"Commonly executable program files (.exe, .com). If the infected program is run, the virus code can execute","hi":"आमतौर पर निष्पादन योग्य प्रोग्राम फाइलें (executable program files)। यदि संक्रमित प्रोग्राम को चलाया जाता है, तो वायरस कोड निष्पादित हो सकता है"},"o":[{"en":"Only text documents (.txt)","hi":"केवल टेक्स्ट दस्तावेज़ (.txt)"},{"en":"Only image files (.jpg)","hi":"केवल इमेज फाइलें (.jpg)"},{"en":"Commonly executable program files (.exe, .com). If the infected program is run, the virus code can execute","hi":"आमतौर पर निष्पादन योग्य प्रोग्राम फाइलें (executable program files)। यदि संक्रमित प्रोग्राम को चलाया जाता है, तो वायरस कोड निष्पादित हो सकता है"},{"en":"Only network routers","hi":"केवल नेटवर्क राउटर"}],"exp":{"en":"A file infector virus (or parasitic virus) attaches itself to executable files, such as .exe, .com, or .bat files, running its payload whenever the application is launched.","hi":"फाइल वायरस उन फाइलों को संक्रमित करता है जिन्हें कंप्यूटर रन करता है (जैसे .exe या .com फाइलें)। जब आप उस प्रोग्राम को खोलते हैं, तो वायरस भी रन हो जाता है।"},"num":24},{"id":"q25","q":{"en":"What does a macro virus make use of?","hi":"मैक्रो वायरस (Macro virus) किस चीज़ का उपयोग करता है?"},"a":{"en":"The macro code of a document or template, such as a macro-enabled Office file","hi":"किसी दस्तावेज़ (document) या टेम्पलेट के मैक्रो कोड का, जैसे मैक्रो-सक्षम Office फाइल (macro-enabled Office file)"},"o":[{"en":"The computer's BIOS","hi":"कंप्यूटर का BIOS"},{"en":"The macro code of a document or template, such as a macro-enabled Office file","hi":"किसी दस्तावेज़ (document) या टेम्पलेट के मैक्रो कोड का, जैसे मैक्रो-सक्षम Office फाइल (macro-enabled Office file)"},{"en":"The hardware drivers","hi":"हार्डवेयर ड्राइवर्स का"},{"en":"The router's firmware","hi":"राउटर के फर्मवेयर का"}],"exp":{"en":"Macro viruses are written in the same macro language used for software programs (like Microsoft Word or Excel). They infect documents and templates rather than executable applications.","hi":"मैक्रो वायरस MS Word या Excel जैसी फाइलों में लिखे गए मैक्रो कोड (ऑटोमेशन स्क्रिप्ट) का फायदा उठाते हैं। जब आप संक्रमित डॉक्यूमेंट खोलते हैं, तो वायरस सक्रिय हो जाता है।"},"num":25},{"id":"q26","q":{"en":"Where does a boot-sector or MBR virus infect?","hi":"बूट-सेक्टर (Boot-sector) या MBR वायरस कहाँ संक्रमित करता है?"},"a":{"en":"The boot-related code of the storage, such as the legacy Master Boot Record. It can activate from the boot process","hi":"स्टोरेज के बूट-संबंधित कोड को, जैसे कि लीगेसी मास्टर बूट रिकॉर्ड (MBR)। यह बूट प्रक्रिया से सक्रिय हो सकता है"},"o":[{"en":"The boot-related code of the storage, such as the legacy Master Boot Record. It can activate from the boot process","hi":"स्टोरेज के बूट-संबंधित कोड को, जैसे कि लीगेसी मास्टर बूट रिकॉर्ड (MBR)। यह बूट प्रक्रिया से सक्रिय हो सकता है"},{"en":"The cloud storage","hi":"क्लाउड स्टोरेज को"},{"en":"The monitor's display memory","hi":"मॉनिटर की डिस्प्ले मेमोरी को"},{"en":"The RAM only","hi":"केवल RAM को"}],"exp":{"en":"Boot sector viruses target the Master Boot Record (MBR) or the boot sector of a storage drive, ensuring they are loaded into memory as soon as the computer starts.","hi":"बूट सेक्टर वायरस हार्ड डिस्क के उस हिस्से (MBR) में बैठता है जो कंप्यूटर को स्टार्ट (बूट) करने का काम करता है। कंप्यूटर के चालू होते ही यह वायरस भी मेमोरी में लोड हो जाता है।"},"num":26},{"id":"q27","q":{"en":"What is a multipartite virus?","hi":"मल्टीपार्टाइट (Multipartite) वायरस क्या होता है?"},"a":{"en":"A virus that infects more than one area, such as both executable files and the boot sector","hi":"एक वायरस जो एक से अधिक क्षेत्रों को संक्रमित करता है, जैसे निष्पादन योग्य (executable) फाइलें और बूट सेक्टर दोनों"},"o":[{"en":"A virus that only infects Apple computers","hi":"एक वायरस जो केवल एप्पल कंप्यूटरों को संक्रमित करता है"},{"en":"A virus that infects more than one area, such as both executable files and the boot sector","hi":"एक वायरस जो एक से अधिक क्षेत्रों को संक्रमित करता है, जैसे निष्पादन योग्य (executable) फाइलें और बूट सेक्टर दोनों"},{"en":"A harmless virus","hi":"एक हानिरहित वायरस"},{"en":"A virus that splits files into multiple parts","hi":"एक वायरस जो फाइलों को कई हिस्सों में बांटता है"}],"exp":{"en":"Multipartite viruses are hybrid threats that spread through multiple ways—often infecting both the boot sector and executable files simultaneously to increase their persistence.","hi":"मल्टीपार्टाइट वायरस एक साथ कई तरीकों से हमला करता है। यह प्रोग्राम फाइलों (.exe) के साथ-साथ बूट सेक्टर को भी संक्रमित कर सकता है, जिससे इसे हटाना मुश्किल हो जाता है।"},"num":27},{"id":"q28","q":{"en":"How does a stealth virus evade detection?","hi":"स्टेल्थ (Stealth) वायरस डिटेक्शन (पहचान) से कैसे बचता है?"},"a":{"en":"By giving the system an impression of a clean state, hiding modified files or its activity","hi":"सिस्टम को मॉडिफाइड फाइलों या अपनी गतिविधि को छिपाकर स्वच्छ स्थिति (clean state) का आभास देकर"},"o":[{"en":"By deleting the antivirus software entirely","hi":"एंटीवायरस सॉफ़्टवेयर को पूरी तरह से हटाकर"},{"en":"By giving the system an impression of a clean state, hiding modified files or its activity","hi":"सिस्टम को मॉडिफाइड फाइलों या अपनी गतिविधि को छिपाकर स्वच्छ स्थिति (clean state) का आभास देकर"},{"en":"By changing its name every minute","hi":"हर मिनट अपना नाम बदलकर"},{"en":"By never running its code","hi":"कभी भी अपना कोड नहीं चलाकर"}],"exp":{"en":"Stealth viruses use techniques to hide their presence, such as intercepting antivirus requests and returning the original, uninfected file data instead of the infected code.","hi":"स्टेल्थ वायरस एंटीवायरस प्रोग्राम को धोखा देने के लिए सिस्टम में हुए बदलावों को छिपाता है, ताकि एंटीवायरस को लगे कि सब कुछ सामान्य (clean) है।"},"num":28},{"id":"q29","q":{"en":"What does a cavity or space-filler virus do?","hi":"कैविटी (Cavity) या स्पेस-फिलर (space-filler) वायरस क्या करता है?"},"a":{"en":"It places its code in the unused space of the host file, so the file size may remain the same","hi":"यह अपने कोड को होस्ट फाइल के अप्रयुक्त स्थान (unused space) में रखता है। इससे फाइल का आकार (size) समान रह सकता है"},"o":[{"en":"It deletes the entire hard drive","hi":"यह पूरी हार्ड ड्राइव को डिलीट कर देता है"},{"en":"It places its code in the unused space of the host file, so the file size may remain the same","hi":"यह अपने कोड को होस्ट फाइल के अप्रयुक्त स्थान (unused space) में रखता है। इससे फाइल का आकार (size) समान रह सकता है"},{"en":"It fills the screen with advertisements","hi":"यह स्क्रीन को विज्ञापनों से भर देता है"},{"en":"It creates empty folders on the desktop","hi":"यह डेस्कटॉप पर खाली फोल्डर बनाता है"}],"exp":{"en":"Cavity viruses attempt to infect a file without increasing its length by squeezing their code into empty or unused sections of the target executable.","hi":"कैविटी वायरस चालाकी से प्रोग्राम फाइल के अंदर मौजूद खाली जगह (unused space) में अपना कोड छिपा देता है। इससे फाइल का साइज़ नहीं बढ़ता, जिससे इसे पकड़ना मुश्किल होता है।"},"num":29},{"id":"q30","q":{"en":"What is the exam cue for a tunnelling virus?","hi":"टनलिंग (Tunnelling) वायरस के लिए परीक्षा संकेत (Exam cue) क्या है?"},"a":{"en":"It attempts to bypass monitoring hooks by reaching lower-level system calls (a label from historical taxonomy)","hi":"यह लोअर-लेवल सिस्टम कॉल्स (lower-level system calls) तक पहुंचकर मॉनिटरिंग हुक को बायपास करने का प्रयास करता है (यह ऐतिहासिक टैक्सोनॉमी का एक लेबल है)"},"o":[{"en":"It physically digs holes in the hard drive","hi":"यह भौतिक रूप से हार्ड ड्राइव में छेद खोदता है"},{"en":"It attempts to bypass monitoring hooks by reaching lower-level system calls (a label from historical taxonomy)","hi":"यह लोअर-लेवल सिस्टम कॉल्स (lower-level system calls) तक पहुंचकर मॉनिटरिंग हुक को बायपास करने का प्रयास करता है (यह ऐतिहासिक टैक्सोनॉमी का एक लेबल है)"},{"en":"It creates a VPN tunnel for anonymous browsing","hi":"यह गुमनाम ब्राउज़िंग के लिए एक वीपीएन टनल बनाता है"},{"en":"It only attacks network tunnels","hi":"यह केवल नेटवर्क टनल पर हमला करता है"}],"exp":{"en":"A tunneling virus attempts to bypass antivirus interceptors (hooks) by jumping directly into the lower levels of the operating system's kernel or interrupt handlers.","hi":"टनलिंग वायरस एंटीवायरस प्रोग्राम को चकमा देने के लिए ऑपरेटिंग सिस्टम की गहराई (lower-level) में जाकर सीधे सिस्टम कॉल्स का उपयोग करता है।"},"num":30},{"id":"q31","q":{"en":"What feature identifies a polymorphic virus?","hi":"पॉलीमॉर्फिक (Polymorphic) वायरस किस विशेषता से पहचाना जाता है?"},"a":{"en":"It can change its code appearance or decryptor with replication, making fixed signature detection difficult","hi":"रेप्लिकेशन (प्रतिलिपि बनाने) के साथ इसका कोड अपीयरेंस (appearance) या डिक्रिप्टर बदल सकता है, जिससे फिक्स्ड सिग्नेचर डिटेक्शन (fixed signature detection) मुश्किल हो जाता है"},"o":[{"en":"It infects only Microsoft Word documents","hi":"यह केवल माइक्रोसॉफ्ट वर्ड दस्तावेज़ों को संक्रमित करता है"},{"en":"It can change its code appearance or decryptor with replication, making fixed signature detection difficult","hi":"रेप्लिकेशन (प्रतिलिपि बनाने) के साथ इसका कोड अपीयरेंस (appearance) या डिक्रिप्टर बदल सकता है, जिससे फिक्स्ड सिग्नेचर डिटेक्शन (fixed signature detection) मुश्किल हो जाता है"},{"en":"It steals passwords from web browsers","hi":"यह वेब ब्राउज़र से पासवर्ड चुराता है"},{"en":"It physically changes the shape of the computer","hi":"यह भौतिक रूप से कंप्यूटर का आकार बदल देता है"}],"exp":{"en":"Polymorphic viruses encrypt their payload differently every time they infect a new file, changing their 'signature' to evade standard pattern-matching antivirus scanners.","hi":"पॉलीमॉर्फिक वायरस हर बार जब नई फाइल को संक्रमित करता है, तो अपना कोड या रूप (signature) बदल लेता है, ताकि एंटीवायरस उसे पहचान न सके।"},"num":31},{"id":"q32","q":{"en":"What is the exam cue for a cluster virus?","hi":"क्लस्टर (Cluster) वायरस के लिए परीक्षा संकेत (Exam cue) क्या है?"},"a":{"en":"It involves historical directory/cluster infection, where it manipulates file metadata or pointers to redirect execution to its malicious code","hi":"इसमें ऐतिहासिक डायरेक्टरी/क्लस्टर संक्रमण शामिल है। यह फाइल मेटाडेटा या पॉइंटर्स में हेरफेर करके दुर्भावनापूर्ण कोड की ओर निष्पादन (execution) को रीडायरेक्ट कर सकता है"},"o":[{"en":"It groups all your files into one folder","hi":"यह आपकी सभी फाइलों को एक फोल्डर में समूहित करता है"},{"en":"It involves historical directory/cluster infection, where it manipulates file metadata or pointers to redirect execution to its malicious code","hi":"इसमें ऐतिहासिक डायरेक्टरी/क्लस्टर संक्रमण शामिल है। यह फाइल मेटाडेटा या पॉइंटर्स में हेरफेर करके दुर्भावनापूर्ण कोड की ओर निष्पादन (execution) को रीडायरेक्ट कर सकता है"},{"en":"It only attacks computer clusters","hi":"यह केवल कंप्यूटर क्लस्टर पर हमला करता है"},{"en":"It creates a cluster of icons on the desktop","hi":"यह डेस्कटॉप पर आइकनों का एक क्लस्टर बनाता है"}],"exp":{"en":"A cluster virus (or file system virus) modifies directory table entries so that executing any file first directs the OS to run the virus code before loading the intended program.","hi":"क्लस्टर वायरस फाइलों को नहीं बदलता, बल्कि हार्ड डिस्क की डायरेक्टरी (इंडेक्स) में बदलाव कर देता है। जब भी आप कोई फाइल खोलते हैं, तो पहले वायरस रन हो जाता है।"},"num":32},{"id":"q33","q":{"en":"What is a computer worm?","hi":"कंप्यूटर वर्म (Computer worm) क्या होता है?"},"a":{"en":"A standalone self-replicating malware that can use network connectivity to spread copies to other systems","hi":"एक स्टैंडअलोन सेल्फ-रेप्लिकेटिंग (स्वयं की प्रतिलिपि बनाने वाला) मैलवेयर जो नेटवर्क कनेक्टिविटी का उपयोग करके अन्य सिस्टम तक अपनी कॉपी (copies) फैला सकता है"},"o":[{"en":"A physical bug inside the computer case","hi":"कंप्यूटर केस के अंदर एक भौतिक कीड़ा"},{"en":"A standalone self-replicating malware that can use network connectivity to spread copies to other systems","hi":"एक स्टैंडअलोन सेल्फ-रेप्लिकेटिंग (स्वयं की प्रतिलिपि बनाने वाला) मैलवेयर जो नेटवर्क कनेक्टिविटी का उपयोग करके अन्य सिस्टम तक अपनी कॉपी (copies) फैला सकता है"},{"en":"A helpful program that cleans the registry","hi":"एक सहायक प्रोग्राम जो रजिस्ट्री को साफ करता है"},{"en":"An old operating system","hi":"एक पुराना ऑपरेटिंग सिस्टम"}],"exp":{"en":"Unlike viruses, worms do not need to attach themselves to a host program or require human interaction to spread; they exploit network vulnerabilities to replicate autonomously.","hi":"वर्म (Worm) एक ऐसा मैलवेयर है जो बिना किसी होस्ट फाइल के, नेटवर्क के ज़रिए अपने आप एक कंप्यूटर से दूसरे कंप्यूटर में फैलता (replicate) रहता है।"},"num":33},{"id":"q34","q":{"en":"What is the main difference in the spread of a virus and a worm?","hi":"वायरस और वर्म के फैलने (spread) में मुख्य अंतर क्या है?"},"a":{"en":"A virus relies on host code or a file to run, whereas a worm can replicate and propagate independently","hi":"वायरस होस्ट कोड या फाइल पर निर्भर करता है। वर्म अपने आप (independently) रेप्लिकेट और प्रोपेगेट (प्रसारित) कर सकता है"},"o":[{"en":"A virus spreads over the network, a worm uses a USB drive","hi":"वायरस नेटवर्क पर फैलता है, वर्म यूएसबी ड्राइव का उपयोग करता है"},{"en":"A virus relies on host code or a file to run, whereas a worm can replicate and propagate independently","hi":"वायरस होस्ट कोड या फाइल पर निर्भर करता है। वर्म अपने आप (independently) रेप्लिकेट और प्रोपेगेट (प्रसारित) कर सकता है"},{"en":"A virus is harmless, a worm is destructive","hi":"वायरस हानिरहित है, वर्म विनाशकारी है"},{"en":"There is no difference","hi":"कोई अंतर नहीं है"}],"exp":{"en":"A virus is parasitic and needs a user to execute its host file to spread. A worm is standalone software that actively seeks out and infects other machines over a network.","hi":"वायरस को फैलने के लिए किसी होस्ट फाइल और यूज़र (जैसे फाइल को क्लिक करना) की ज़रूरत होती है। जबकि वर्म बिना किसी की मदद के, नेटवर्क के ज़रिए अपने आप फैलता है।"},"num":34},{"id":"q35","q":{"en":"What is Write Once, Read Many (WORM)?","hi":"राइट वन्स, रीड मेनी (Write Once, Read Many - WORM) क्या होता है?"},"a":{"en":"A storage concept where data can be written once and read multiple times. A network malware worm is a completely separate term","hi":"एक स्टोरेज कॉन्सेप्ट जहाँ डेटा एक बार लिखा जा सकता है और कई बार पढ़ा जा सकता है। नेटवर्क मैलवेयर 'वर्म' (worm) एक बिल्कुल अलग शब्द है"},"o":[{"en":"A type of destructive malware","hi":"एक प्रकार का विनाशकारी मैलवेयर"},{"en":"A storage concept where data can be written once and read multiple times. A network malware worm is a completely separate term","hi":"एक स्टोरेज कॉन्सेप्ट जहाँ डेटा एक बार लिखा जा सकता है और कई बार पढ़ा जा सकता है। नेटवर्क मैलवेयर 'वर्म' (worm) एक बिल्कुल अलग शब्द है"},{"en":"A protocol for sending emails","hi":"ईमेल भेजने के लिए एक प्रोटोकॉल"},{"en":"A method for increasing internet speed","hi":"इंटरनेट की गति बढ़ाने की एक विधि"}],"exp":{"en":"WORM in data storage refers to media (like CD-Rs) that cannot be rewritten once data is burned onto them. This acronym has no relation to the malicious 'worm' software.","hi":"WORM एक स्टोरेज तकनीक है (जैसे CD-R) जिसमें डेटा केवल एक बार लिखा (Write) जाता है और उसे बदला नहीं जा सकता। यह मैलवेयर वाले 'वर्म' से बिल्कुल अलग है।"},"num":35}]},{"title":{"en":"4. Trojan, Spyware, Rootkit & Adware","hi":"4. ट्रोजन, स्पाइवेयर, रूटकिट और एडवेयर"},"questions":[{"id":"q36","q":{"en":"What is a Trojan horse malware?","hi":"ट्रोजन हॉर्स (Trojan horse) मैलवेयर क्या होता है?"},"a":{"en":"Malware that tricks the user into running/installing it by appearing as a useful or legitimate program","hi":"ऐसा मैलवेयर जो उपयोगी या वैध (legitimate) प्रोग्राम जैसा दिखकर यूज़र को उसे रन/इंस्टॉल करने के लिए धोखा (trick) देता है"},"o":[{"en":"A virus that encrypts files","hi":"एक वायरस जो फाइलों को एन्क्रिप्ट करता है"},{"en":"Malware that tricks the user into running/installing it by appearing as a useful or legitimate program","hi":"ऐसा मैलवेयर जो उपयोगी या वैध (legitimate) प्रोग्राम जैसा दिखकर यूज़र को उसे रन/इंस्टॉल करने के लिए धोखा (trick) देता है"},{"en":"A network tool used by administrators","hi":"प्रशासकों द्वारा उपयोग किया जाने वाला एक नेटवर्क टूल"},{"en":"A self-replicating worm","hi":"एक सेल्फ-रेप्लिकेटिंग वर्म"}],"exp":{"en":"Named after the mythological wooden horse, a Trojan disguises itself as desirable software (like a game or utility) to trick users into installing malicious code.","hi":"ट्रोजन हॉर्स एक ऐसा मैलवेयर है जो दिखने में एक असली और उपयोगी सॉफ़्टवेयर (जैसे कोई गेम या टूल) लगता है, ताकि यूज़र उसे डाउनलोड और रन करे।"},"num":36},{"id":"q37","q":{"en":"Does a Trojan generally self-replicate?","hi":"क्या ट्रोजन आमतौर पर स्वयं की प्रतिलिपि (self-replicate) बनाता है?"},"a":{"en":"No, its usual mechanism is disguise and user interaction. Self-replication is a characteristic of a virus or a worm","hi":"नहीं, इसका सामान्य तंत्र (mechanism) भेष बदलना (disguise) और उपयोगकर्ता की अंतःक्रिया (user interaction) है। सेल्फ-रेप्लिकेशन वायरस या वर्म की विशेषता है"},"o":[{"en":"Yes, it replicates faster than a worm","hi":"हां, यह वर्म की तुलना में तेजी से प्रतिकृति बनाता है"},{"en":"Yes, it infects all files on the hard drive","hi":"हां, यह हार्ड ड्राइव की सभी फाइलों को संक्रमित करता है"},{"en":"No, its usual mechanism is disguise and user interaction. Self-replication is a characteristic of a virus or a worm","hi":"नहीं, इसका सामान्य तंत्र (mechanism) भेष बदलना (disguise) और उपयोगकर्ता की अंतःक्रिया (user interaction) है। सेल्फ-रेप्लिकेशन वायरस या वर्म की विशेषता है"},{"en":"It only replicates when connected to the internet","hi":"यह केवल इंटरनेट से जुड़े होने पर प्रतिकृति बनाता है"}],"exp":{"en":"Unlike viruses and worms, classic Trojans do not attempt to inject themselves into other files or spread automatically across networks; they rely on social engineering.","hi":"ट्रोजन खुद अपनी कॉपी (self-replicate) नहीं बनाता है। यह यूज़र को धोखा देकर खुद को इंस्टॉल करवाता है, जबकि वायरस और वर्म खुद फैलने की क्षमता रखते हैं।"},"num":37},{"id":"q38","q":{"en":"What could be a possible payload of a Trojan?","hi":"ट्रोजन का संभावित पेलोड (Payload) क्या हो सकता है?"},"a":{"en":"Backdoor access, data theft, downloading other malware, or performing unauthorized actions","hi":"बैकडोर एक्सेस, डेटा चोरी, अन्य मैलवेयर डाउनलोड करना, या अनधिकृत कार्रवाई (unauthorized actions) करना"},"o":[{"en":"Improving system performance","hi":"सिस्टम के प्रदर्शन में सुधार करना"},{"en":"Backdoor access, data theft, downloading other malware, or performing unauthorized actions","hi":"बैकडोर एक्सेस, डेटा चोरी, अन्य मैलवेयर डाउनलोड करना, या अनधिकृत कार्रवाई (unauthorized actions) करना"},{"en":"Updating the operating system automatically","hi":"ऑपरेटिंग सिस्टम को स्वचालित रूप से अपडेट करना"},{"en":"Fixing network connectivity issues","hi":"नेटवर्क कनेक्टिविटी समस्याओं को ठीक करना"}],"exp":{"en":"Once executed, a Trojan's payload can range from establishing a Remote Access Trojan (RAT) backdoor to stealing banking credentials or installing ransomware.","hi":"एक बार इंस्टॉल होने के बाद, ट्रोजन आपके सिस्टम में बैकडोर (चोर दरवाज़ा) बना सकता है, डेटा चुरा सकता है, या अन्य खतरनाक मैलवेयर डाउनलोड कर सकता है।"},"num":38},{"id":"q39","q":{"en":"What is a backdoor?","hi":"बैकडोर (Backdoor) क्या होता है?"},"a":{"en":"A hidden access route that allows bypassing normal authentication or access checks","hi":"एक छिपा हुआ एक्सेस मार्ग (hidden access route) जो सामान्य प्रमाणीकरण (authentication) या एक्सेस चेक्स को बायपास (bypass) करने देता है"},"o":[{"en":"A physical door in a server room","hi":"सर्वर रूम में एक भौतिक दरवाजा"},{"en":"A secure encryption protocol","hi":"एक सुरक्षित एन्क्रिप्शन प्रोटोकॉल"},{"en":"A hidden access route that allows bypassing normal authentication or access checks","hi":"एक छिपा हुआ एक्सेस मार्ग (hidden access route) जो सामान्य प्रमाणीकरण (authentication) या एक्सेस चेक्स को बायपास (bypass) करने देता है"},{"en":"An official admin login portal","hi":"एक आधिकारिक एडमिन लॉगिन पोर्टल"}],"exp":{"en":"A backdoor is a method, often installed secretly by malware, that bypasses standard security mechanisms to give an attacker persistent, unauthorized access to a system.","hi":"बैकडोर सिस्टम में प्रवेश करने का एक छिपा हुआ रास्ता है, जिससे हैकर सामान्य पासवर्ड या सिक्योरिटी चेक को चकमा देकर कभी भी सिस्टम में घुस सकता है।"},"num":39},{"id":"q40","q":{"en":"What does spyware do?","hi":"स्पाईवेयर (Spyware) क्या करता है?"},"a":{"en":"It secretly collects user activity, browsing habits, or personal data and sometimes sends it to an external party","hi":"यह गुप्त रूप से उपयोगकर्ता की गतिविधि, ब्राउज़िंग आदतों (browsing habits) या व्यक्तिगत डेटा (personal data) एकत्र करता है और कभी-कभी इसे किसी बाहरी पार्टी को भेजता है"},"o":[{"en":"It speeds up the computer","hi":"यह कंप्यूटर की गति बढ़ाता है"},{"en":"It secretly collects user activity, browsing habits, or personal data and sometimes sends it to an external party","hi":"यह गुप्त रूप से उपयोगकर्ता की गतिविधि, ब्राउज़िंग आदतों (browsing habits) या व्यक्तिगत डेटा (personal data) एकत्र करता है और कभी-कभी इसे किसी बाहरी पार्टी को भेजता है"},{"en":"It repairs corrupted files","hi":"यह दूषित फाइलों की मरम्मत करता है"},{"en":"It prevents unauthorized access","hi":"यह अनधिकृत पहुंच को रोकता है"}],"exp":{"en":"Spyware monitors user behavior—such as tracking websites visited or capturing keystrokes—and transmits that private data to a third party without the user's consent.","hi":"स्पाईवेयर एक जासूसी प्रोग्राम है जो यूज़र की जानकारी के बिना उसकी गतिविधियों, पासवर्ड्स और ब्राउज़िंग हिस्ट्री को रिकॉर्ड करता है और हैकर को भेजता है।"},"num":40},{"id":"q41","q":{"en":"What is a source example of spyware and advertiser tracking?","hi":"स्पाईवेयर और एडवरटाइज़र ट्रैकिंग का एक स्रोत उदाहरण (Source example) क्या है?"},"a":{"en":"Unauthorized browsing data can be collected and sent to an advertiser or data buyer. Consent and behavior classification matter here","hi":"अनधिकृत ब्राउज़िंग डेटा एकत्र करके किसी विज्ञापनदाता या डेटा खरीदार को भेजा जा सकता है। इसमें सहमति (consent) और व्यवहार का वर्गीकरण (behavior classification) मायने रखता है"},"o":[{"en":"Tracking software is always illegal","hi":"ट्रैकिंग सॉफ्टवेयर हमेशा अवैध होता है"},{"en":"Unauthorized browsing data can be collected and sent to an advertiser or data buyer. Consent and behavior classification matter here","hi":"अनधिकृत ब्राउज़िंग डेटा एकत्र करके किसी विज्ञापनदाता या डेटा खरीदार को भेजा जा सकता है। इसमें सहमति (consent) और व्यवहार का वर्गीकरण (behavior classification) मायने रखता है"},{"en":"Advertisers send physical mail based on your IP","hi":"विज्ञापनदाता आपके IP के आधार पर भौतिक मेल भेजते हैं"},{"en":"Spyware disables all advertisements","hi":"स्पाईवेयर सभी विज्ञापनों को अक्षम कर देता है"}],"exp":{"en":"Some trackers blur the line between aggressive marketing and spyware. If it operates secretly without explicit user consent to harvest data, it functions as spyware.","hi":"कई बार विज्ञापन कंपनियाँ बिना आपकी सहमति के आपका ब्राउज़िंग डेटा चुराती हैं। यदि यह काम चोरी-छिपे किया जा रहा है, तो यह स्पाईवेयर (जासूसी) की श्रेणी में आता है।"},"num":41},{"id":"q42","q":{"en":"What is the main role of a rootkit?","hi":"रूटकिट (Rootkit) की मुख्य भूमिका क्या है?"},"a":{"en":"To hide unauthorized access or the presence of malicious processes/files and sometimes maintain privileged control","hi":"अनधिकृत पहुंच (unauthorized access) या दुर्भावनापूर्ण प्रक्रियाओं/फाइलों की उपस्थिति को छिपाना और कभी-कभी विशेषाधिकार प्राप्त नियंत्रण (privileged control) बनाए रखना"},"o":[{"en":"To optimize the operating system's kernel","hi":"ऑपरेटिंग सिस्टम के कर्नेल को अनुकूलित (optimize) करना"},{"en":"To provide a graphical user interface","hi":"ग्राफिकल यूजर इंटरफेस प्रदान करना"},{"en":"To hide unauthorized access or the presence of malicious processes/files and sometimes maintain privileged control","hi":"अनधिकृत पहुंच (unauthorized access) या दुर्भावनापूर्ण प्रक्रियाओं/फाइलों की उपस्थिति को छिपाना और कभी-कभी विशेषाधिकार प्राप्त नियंत्रण (privileged control) बनाए रखना"},{"en":"To encrypt user data for backup","hi":"बैकअप के लिए उपयोगकर्ता डेटा को एन्क्रिप्ट करना"}],"exp":{"en":"A rootkit is designed to conceal the existence of malware or attackers on a system, often by modifying the operating system to grant persistent, root-level (administrator) access.","hi":"रूटकिट एक ऐसा खतरनाक प्रोग्राम है जो सिस्टम में गहराई तक छिप जाता है। यह अन्य मैलवेयर को छिपने में मदद करता है और हैकर को एडमिन (root) लेवल का कंट्रोल देता है।"},"num":42},{"id":"q43","q":{"en":"How can a rootkit evade ordinary detection?","hi":"रूटकिट सामान्य डिटेक्शन (पहचान) से कैसे बच सकता है?"},"a":{"en":"By manipulating lower layers of the OS or system/API responses to give scanners incomplete or misleading information","hi":"ओएस (OS) की निचली परतों या सिस्टम/एपीआई प्रतिक्रियाओं (API responses) में हेरफेर करके स्कैनर्स को अधूरी या भ्रामक जानकारी दे सकता है"},"o":[{"en":"By turning off the computer monitor","hi":"कंप्यूटर मॉनिटर बंद करके"},{"en":"By manipulating lower layers of the OS or system/API responses to give scanners incomplete or misleading information","hi":"ओएस (OS) की निचली परतों या सिस्टम/एपीआई प्रतिक्रियाओं (API responses) में हेरफेर करके स्कैनर्स को अधूरी या भ्रामक जानकारी दे सकता है"},{"en":"By moving files to the recycle bin","hi":"फाइलों को रीसायकल बिन में ले जाकर"},{"en":"It cannot evade detection; it is always visible","hi":"यह डिटेक्शन से नहीं बच सकता; यह हमेशा दिखाई देता है"}],"exp":{"en":"By intercepting and altering the data that the operating system reports to antivirus software, a rootkit makes malicious files and processes effectively invisible to standard scans.","hi":"रूटकिट ऑपरेटिंग सिस्टम के मूल कार्यों (API) में छेड़छाड़ करता है। जब एंटीवायरस सिस्टम को स्कैन करता है, तो रूटकिट उसे झूठी जानकारी देता है जिससे वायरस दिखाई ही नहीं देते।"},"num":43},{"id":"q44","q":{"en":"What is adware?","hi":"एडवेयर (Adware) क्या होता है?"},"a":{"en":"Software that displays advertisements. Disclosed ad-supported apps can be legitimate, while intrusive or deceptive variants can be unwanted or malicious","hi":"विज्ञापन (ads) प्रदर्शित करने वाला सॉफ्टवेयर। डिसक्लोज़ किए गए विज्ञापन-समर्थित ऐप्स (ad-supported apps) वैध (legitimate) हो सकते हैं, जबकि घुसपैठ (intrusive) या भ्रामक (deceptive) वेरिएंट अवांछित (unwanted) या दुर्भावनापूर्ण हो सकते हैं"},"o":[{"en":"Software that displays advertisements. Disclosed ad-supported apps can be legitimate, while intrusive or deceptive variants can be unwanted or malicious","hi":"विज्ञापन (ads) प्रदर्शित करने वाला सॉफ्टवेयर। डिसक्लोज़ किए गए विज्ञापन-समर्थित ऐप्स (ad-supported apps) वैध (legitimate) हो सकते हैं, जबकि घुसपैठ (intrusive) या भ्रामक (deceptive) वेरिएंट अवांछित (unwanted) या दुर्भावनापूर्ण हो सकते हैं"},{"en":"A type of firewall","hi":"एक प्रकार का फ़ायरवॉल"},{"en":"A program used exclusively by advertising agencies to design posters","hi":"एक प्रोग्राम जिसका उपयोग विशेष रूप से विज्ञापन एजेंसियों द्वारा पोस्टर डिजाइन करने के लिए किया जाता है"},{"en":"Software that blocks all ads","hi":"सॉफ्टवेयर जो सभी विज्ञापनों को ब्लॉक करता है"}],"exp":{"en":"Adware automatically displays or downloads advertising material when a user is online. While some adware is legal and supports free software, malicious adware aggressively serves pop-ups or redirects browsers without consent.","hi":"एडवेयर वह सॉफ़्टवेयर है जो कंप्यूटर या मोबाइल पर विज्ञापन (Ads) दिखाता है। कुछ एडवेयर सामान्य होते हैं (जैसे फ्री ऐप्स में विज्ञापन), लेकिन कुछ दुर्भावनापूर्ण होते हैं जो बिना आपकी अनुमति के लगातार पॉप-अप विज्ञापन दिखाते हैं।"},"num":44},{"id":"q45","q":{"en":"What is the primary cue for distinguishing between spyware and adware?","hi":"स्पाईवेयर और एडवेयर के बीच अंतर करने के लिए प्राथमिक संकेत (primary cue) क्या है?"},"a":{"en":"Spyware's cue is secret data collection. Adware's cue is displaying advertisements","hi":"स्पाईवेयर का संकेत (cue) गुप्त डेटा संग्रह (secret data collection) है। एडवेयर का संकेत विज्ञापन (advertisements) प्रदर्शित करना है"},"o":[{"en":"Spyware slows down the PC, adware speeds it up","hi":"स्पाईवेयर पीसी को धीमा कर देता है, एडवेयर इसकी गति बढ़ाता है"},{"en":"Spyware's cue is secret data collection. Adware's cue is displaying advertisements","hi":"स्पाईवेयर का संकेत (cue) गुप्त डेटा संग्रह (secret data collection) है। एडवेयर का संकेत विज्ञापन (advertisements) प्रदर्शित करना है"},{"en":"Spyware is legal, adware is illegal","hi":"स्पाईवेयर कानूनी है, एडवेयर अवैध है"},{"en":"There is no difference","hi":"कोई अंतर नहीं है"}],"exp":{"en":"When taking exams, key your answers on their core function: Spyware = spying/secret data theft. Adware = pushing unsolicited advertisements.","hi":"परीक्षा के लिए याद रखें: स्पाईवेयर का काम आपकी जानकारी के बिना जासूसी करना और डेटा चुराना है। एडवेयर का काम आपको अनचाहे विज्ञापन दिखाना है।"},"num":45}]},{"title":{"en":"5. Keylogger, Logic Bomb & Ransomware","hi":"5. कीलॉगर, लॉजिक बम और रैनसमवेयर"},"questions":[{"id":"q46","q":{"en":"What does a keylogger record?","hi":"कीलॉगर (Keylogger) क्या रिकॉर्ड करता है?"},"a":{"en":"The keystrokes entered on a keyboard. Typed passwords, chat messages, or emails can also be captured","hi":"कीबोर्ड पर दर्ज किए गए कीस्ट्रोक्स (keystrokes)। टाइप किए गए पासवर्ड, चैट संदेश या ईमेल भी कैप्चर किए जा सकते हैं"},"o":[{"en":"Mouse clicks only","hi":"केवल माउस क्लिक"},{"en":"The computer's temperature","hi":"कंप्यूटर का तापमान"},{"en":"The keystrokes entered on a keyboard. Typed passwords, chat messages, or emails can also be captured","hi":"कीबोर्ड पर दर्ज किए गए कीस्ट्रोक्स (keystrokes)। टाइप किए गए पासवर्ड, चैट संदेश या ईमेल भी कैप्चर किए जा सकते हैं"},{"en":"Voice conversations near the microphone","hi":"माइक्रोफ़ोन के पास आवाज़ की बातचीत"}],"exp":{"en":"A keylogger is a type of spyware (either software or hardware) that covertly records every key pressed on a keyboard, making it highly effective at stealing passwords and sensitive communications.","hi":"कीलॉगर एक जासूसी प्रोग्राम या डिवाइस है जो कीबोर्ड पर दबाए गए हर बटन (keystroke) का रिकॉर्ड रखता है। इससे आपके पासवर्ड, मैसेज और ईमेल चुराए जा सकते हैं।"},"num":46},{"id":"q47","q":{"en":"Where can keylogger data be sent?","hi":"कीलॉगर डेटा कहाँ भेजा जा सकता है?"},"a":{"en":"It can be stored in a local log file or sent to an external destination. Depending on the implementation, encryption may be involved","hi":"इसे लोकल लॉग फाइल में स्टोर किया जा सकता है या बाहरी गंतव्य (external destination) पर भेजा जा सकता है। कार्यान्वयन (implementation) के आधार पर एन्क्रिप्शन शामिल हो सकता है"},"o":[{"en":"It is always printed on paper","hi":"यह हमेशा कागज पर प्रिंट होता है"},{"en":"It is only saved on the hard drive permanently","hi":"यह केवल हार्ड ड्राइव पर स्थायी रूप से सहेजा जाता है"},{"en":"It can be stored in a local log file or sent to an external destination. Depending on the implementation, encryption may be involved","hi":"इसे लोकल लॉग फाइल में स्टोर किया जा सकता है या बाहरी गंतव्य (external destination) पर भेजा जा सकता है। कार्यान्वयन (implementation) के आधार पर एन्क्रिप्शन शामिल हो सकता है"},{"en":"It is always deleted immediately","hi":"यह हमेशा तुरंत हटा दिया जाता है"}],"exp":{"en":"Software keyloggers often save the captured keystrokes in a hidden local file and periodically transmit that file over the internet back to the attacker.","hi":"कीलॉगर डेटा को कंप्यूटर में ही किसी छिपी हुई फाइल में स्टोर कर सकता है, या इंटरनेट के ज़रिए उसे सीधे हैकर (attacker) के पास भेज सकता है।"},"num":47},{"id":"q48","q":{"en":"What is a logic bomb?","hi":"लॉजिक बॉम्ब (Logic bomb) क्या होता है?"},"a":{"en":"Malicious code that is triggered when a specified date, event, or condition is matched","hi":"दुर्भावनापूर्ण कोड जो एक निर्दिष्ट तिथि (date), घटना (event) या स्थिति (condition) के मेल खाने पर ट्रिगर होता है"},"o":[{"en":"A bomb made of computer parts","hi":"कंप्यूटर के पुर्जों से बना बम"},{"en":"Malicious code that is triggered when a specified date, event, or condition is matched","hi":"दुर्भावनापूर्ण कोड जो एक निर्दिष्ट तिथि (date), घटना (event) या स्थिति (condition) के मेल खाने पर ट्रिगर होता है"},{"en":"A program used to teach logic gates","hi":"लॉजिक गेट्स सिखाने के लिए उपयोग किया जाने वाला एक प्रोग्राम"},{"en":"An error in the processor's arithmetic unit","hi":"प्रोसेसर की अंकगणितीय इकाई (arithmetic unit) में एक त्रुटि"}],"exp":{"en":"A logic bomb is a piece of code intentionally inserted into software that lies dormant until a specific condition is met, such as a specific date, a missing database entry, or an employee being fired.","hi":"लॉजिक बॉम्ब ऐसा दुर्भावनापूर्ण कोड है जो सिस्टम में छिपा रहता है और किसी खास शर्त के पूरा होने पर (जैसे कोई खास तारीख या किसी कर्मचारी को नौकरी से निकाले जाने पर) अचानक हमला करता है।"},"num":48},{"id":"q49","q":{"en":"What is the exam cue for a time-based logic bomb?","hi":"समय-आधारित लॉजिक बॉम्ब (Time-based logic bomb) के लिए परीक्षा संकेत (Exam cue) क्या है?"},"a":{"en":"The malicious action activates when a preset date or time arrives. Such a case is also called a time bomb","hi":"जब एक पूर्व निर्धारित तिथि या समय (preset date or time) आता है तो दुर्भावनापूर्ण कार्रवाई सक्रिय हो जाती है। ऐसे मामले को टाइम बॉम्ब (time bomb) भी कहा जाता है"},"o":[{"en":"It stops time on the computer","hi":"यह कंप्यूटर पर समय रोक देता है"},{"en":"It makes the computer run faster over time","hi":"यह समय के साथ कंप्यूटर को तेजी से चलाता है"},{"en":"The malicious action activates when a preset date or time arrives. Such a case is also called a time bomb","hi":"जब एक पूर्व निर्धारित तिथि या समय (preset date or time) आता है तो दुर्भावनापूर्ण कार्रवाई सक्रिय हो जाती है। ऐसे मामले को टाइम बॉम्ब (time bomb) भी कहा जाता है"},{"en":"It only affects timezone settings","hi":"यह केवल टाइमज़ोन सेटिंग्स को प्रभावित करता है"}],"exp":{"en":"When a logic bomb's trigger is strictly based on a specific date or time being reached, it is commonly referred to in exams as a 'time bomb'.","hi":"जब कोई लॉजिक बॉम्ब किसी खास तारीख या समय पर हमला करने के लिए प्रोग्राम किया गया हो, तो परीक्षा में इसे अक्सर 'टाइम बॉम्ब' (Time bomb) कहा जाता है।"},"num":49},{"id":"q50","q":{"en":"What does ransomware do?","hi":"रैंसमवेयर (Ransomware) क्या करता है?"},"a":{"en":"It demands a ransom by encrypting files or blocking system access","hi":"यह फाइलों को एन्क्रिप्ट (encrypt) करके या सिस्टम एक्सेस को ब्लॉक करके फिरौती (ransom) की मांग करता है"},"o":[{"en":"It gives free software to the user","hi":"यह उपयोगकर्ता को मुफ्त सॉफ्टवेयर देता है"},{"en":"It demands a ransom by encrypting files or blocking system access","hi":"यह फाइलों को एन्क्रिप्ट (encrypt) करके या सिस्टम एक्सेस को ब्लॉक करके फिरौती (ransom) की मांग करता है"},{"en":"It translates text into other languages","hi":"यह टेक्स्ट को अन्य भाषाओं में अनुवादित करता है"},{"en":"It automatically pays your bills","hi":"यह आपके बिलों का स्वचालित रूप से भुगतान करता है"}],"exp":{"en":"Ransomware is a type of malware that locks users out of their devices or encrypts their personal files, demanding an online payment (often cryptocurrency) to restore access.","hi":"रैंसमवेयर एक ऐसा मैलवेयर है जो आपके कंप्यूटर की फाइलों को लॉक (एन्क्रिप्ट) कर देता है और उन्हें दोबारा खोलने के लिए आपसे पैसों (फिरौती/ransom) की मांग करता है।"},"num":50},{"id":"q51","q":{"en":"What is double extortion in ransomware?","hi":"रैंसमवेयर में डबल एक्सटॉर्शन (Double extortion) क्या है?"},"a":{"en":"Threatening to publish the stolen data along with blocking/encrypting access","hi":"एक्सेस को ब्लॉक/एन्क्रिप्ट करने के साथ-साथ चुराए गए डेटा (stolen data) को प्रकाशित करने की धमकी देना"},"o":[{"en":"Demanding to be paid in two different currencies","hi":"दो अलग-अलग मुद्राओं (currencies) में भुगतान की मांग करना"},{"en":"Encrypting the files twice","hi":"फाइलों को दो बार एन्क्रिप्ट करना"},{"en":"Threatening to publish the stolen data along with blocking/encrypting access","hi":"एक्सेस को ब्लॉक/एन्क्रिप्ट करने के साथ-साथ चुराए गए डेटा (stolen data) को प्रकाशित करने की धमकी देना"},{"en":"Infecting two computers at the same time","hi":"एक ही समय में दो कंप्यूटरों को संक्रमित करना"}],"exp":{"en":"In a double extortion ransomware attack, the attacker not only encrypts the victim's data but also steals it, threatening to release sensitive information publicly if the ransom is not paid.","hi":"डबल एक्सटॉर्शन (दोहरा जबरन वसूली) में हैकर न केवल फाइलों को लॉक करता है, बल्कि उन्हें चुरा भी लेता है और धमकी देता है कि अगर पैसे नहीं दिए, तो वह उस गुप्त डेटा को पब्लिक (लीक) कर देगा।"},"num":51},{"id":"q52","q":{"en":"How do you identify a logic bomb and ransomware?","hi":"लॉजिक बॉम्ब और रैंसमवेयर की पहचान कैसे करें?"},"a":{"en":"Trigger condition → logic bomb. Making data or access a hostage and demanding payment → ransomware","hi":"ट्रिगर स्थिति (Trigger condition) → लॉजिक बॉम्ब। डेटा या एक्सेस को बंधक (hostage) बनाकर भुगतान की मांग करना → रैंसमवेयर"},"o":[{"en":"A logic bomb asks for money, ransomware is a trigger","hi":"लॉजिक बॉम्ब पैसे मांगता है, रैंसमवेयर एक ट्रिगर है"},{"en":"Trigger condition → logic bomb. Making data or access a hostage and demanding payment → ransomware","hi":"ट्रिगर स्थिति (Trigger condition) → लॉजिक बॉम्ब। डेटा या एक्सेस को बंधक (hostage) बनाकर भुगतान की मांग करना → रैंसमवेयर"},{"en":"Both are hardware devices","hi":"दोनों हार्डवेयर डिवाइस हैं"},{"en":"There is no difference","hi":"कोई अंतर नहीं है"}],"exp":{"en":"Key exam identifiers: If the malware waits for an event or date, it's a logic bomb. If it locks files and demands money, it's ransomware.","hi":"परीक्षा के लिए संकेत: यदि मैलवेयर किसी 'शर्त' (तारीख या घटना) के पूरा होने का इंतज़ार करता है, तो वह 'लॉजिक बॉम्ब' है। यदि वह डेटा को बंधक बनाकर 'पैसे' मांगता है, तो वह 'रैंसमवेयर' है।"},"num":52}]},{"title":{"en":"6. Hacking, Ethics & Hacker Categories","hi":"6. हैकिंग, नैतिकता और हैकर्स की श्रेणियाँ"},"questions":[{"id":"q53","q":{"en":"What is the broad meaning of hacking?","hi":"हैकिंग (Hacking) का व्यापक अर्थ क्या है?"},"a":{"en":"Using technical methods to inspect, modify, or exploit the behavior of a system or network. The context and permission decide the nature of the activity","hi":"सिस्टम या नेटवर्क के व्यवहार (behavior) का निरीक्षण (inspect), संशोधन (modify) या शोषण (exploit) करने के लिए तकनीकी तरीकों का उपयोग करना। संदर्भ (Context) और अनुमति (permission) से गतिविधि की प्रकृति तय होती है"},"o":[{"en":"Breaking a computer with a hammer","hi":"हथौड़े से कंप्यूटर तोड़ना"},{"en":"Only stealing credit card information","hi":"केवल क्रेडिट कार्ड की जानकारी चुराना"},{"en":"Using technical methods to inspect, modify, or exploit the behavior of a system or network. The context and permission decide the nature of the activity","hi":"सिस्टम या नेटवर्क के व्यवहार (behavior) का निरीक्षण (inspect), संशोधन (modify) या शोषण (exploit) करने के लिए तकनीकी तरीकों का उपयोग करना। संदर्भ (Context) और अनुमति (permission) से गतिविधि की प्रकृति तय होती है"},{"en":"Writing code for a new operating system","hi":"नए ऑपरेटिंग सिस्टम के लिए कोड लिखना"}],"exp":{"en":"Hacking broadly refers to applying technical skills to overcome a problem or bypass a security control. It can be done maliciously (cybercrime) or defensively (security testing).","hi":"हैकिंग का मतलब सिर्फ चोरी करना नहीं है। किसी भी कंप्यूटर या नेटवर्क की कार्यप्रणाली को तकनीकी रूप से जाँचना, बदलना या उसकी कमियों का इस्तेमाल करना हैकिंग है। यह अच्छे या बुरे, दोनों इरादों से की जा सकती है।"},"num":53},{"id":"q54","q":{"en":"How does a textbook distinguish between a hacker and a cracker?","hi":"पाठ्यपुस्तक (Textbook) एक हैकर (hacker) और एक क्रैकर (cracker) के बीच कैसे अंतर करती है?"},"a":{"en":"Hacker is a broad term. Cracker is often the textbook term for a person who performs unauthorized or malicious bypasses","hi":"हैकर एक व्यापक शब्द (broad term) है। क्रैकर (Cracker) अक्सर अनधिकृत (unauthorized) या दुर्भावनापूर्ण बायपास (malicious bypass) करने वाले व्यक्ति के लिए उपयोग किया जाने वाला पाठ्यपुस्तक शब्द (textbook term) है"},"o":[{"en":"Hacker is a broad term. Cracker is often the textbook term for a person who performs unauthorized or malicious bypasses","hi":"हैकर एक व्यापक शब्द (broad term) है। क्रैकर (Cracker) अक्सर अनधिकृत (unauthorized) या दुर्भावनापूर्ण बायपास (malicious bypass) करने वाले व्यक्ति के लिए उपयोग किया जाने वाला पाठ्यपुस्तक शब्द (textbook term) है"},{"en":"Hacker is for hardware, cracker is for software","hi":"हैकर हार्डवेयर के लिए है, क्रैकर सॉफ्टवेयर के लिए है"},{"en":"They are exactly the same","hi":"वे बिल्कुल एक समान हैं"},{"en":"Hacker is a beginner, cracker is an expert","hi":"हैकर नौसिखिया है, क्रैकर विशेषज्ञ है"}],"exp":{"en":"In traditional computer science terminology, a 'hacker' is an expert programmer, while a 'cracker' specifically refers to someone who breaks security for malicious reasons (criminal hacking).","hi":"पारंपरिक कंप्यूटर विज्ञान में, 'हैकर' एक ऐसा व्यक्ति है जिसे कंप्यूटर की बहुत अच्छी जानकारी होती है। जबकि 'क्रैकर' (Cracker) वह व्यक्ति है जो बुरे इरादे से सुरक्षा तोड़कर सिस्टम में घुसता है (अपराधी हैकर)।"},"num":54},{"id":"q55","q":{"en":"What is ethical hacking?","hi":"एथिकल हैकिंग (Ethical hacking) क्या होती है?"},"a":{"en":"Testing and reporting security weaknesses within the explicit permission and defined scope of the system owner","hi":"सिस्टम ओनर की स्पष्ट अनुमति (explicit permission) और निर्धारित दायरे (defined scope) के अंदर सुरक्षा कमजोरियों का परीक्षण (test) और रिपोर्ट करना"},"o":[{"en":"Hacking to steal money for charity","hi":"चैरिटी के लिए पैसे चुराने के लिए हैकिंग"},{"en":"Testing and reporting security weaknesses within the explicit permission and defined scope of the system owner","hi":"सिस्टम ओनर की स्पष्ट अनुमति (explicit permission) और निर्धारित दायरे (defined scope) के अंदर सुरक्षा कमजोरियों का परीक्षण (test) और रिपोर्ट करना"},{"en":"Hacking without getting caught","hi":"पकड़े बिना हैकिंग करना"},{"en":"Guessing passwords randomly","hi":"बेतरतीब ढंग से पासवर्ड का अनुमान लगाना"}],"exp":{"en":"Ethical hacking (or penetration testing) involves authorized attempts to bypass system security to identify vulnerabilities before malicious hackers can exploit them.","hi":"एथिकल हैकिंग (Ethical Hacking) में सिस्टम के मालिक की अनुमति लेकर सुरक्षा कमजोरियों का पता लगाया जाता है, ताकि उन कमियों को दूर किया जा सके।"},"num":55},{"id":"q56","q":{"en":"What is the exam cue for non-ethical hacking?","hi":"नॉन-एथिकल (गैर-नैतिक) हैकिंग का परीक्षा संकेत (exam cue) क्या है?"},"a":{"en":"System access without permission, unauthorized exploitation, data theft, or disruption","hi":"अनुमति के बिना सिस्टम एक्सेस, अनधिकृत शोषण (unauthorized exploitation), डेटा चोरी या व्यवधान (disruption)"},"o":[{"en":"Improving system speed","hi":"सिस्टम की गति में सुधार"},{"en":"Updating software","hi":"सॉफ्टवेयर अपडेट करना"},{"en":"System access without permission, unauthorized exploitation, data theft, or disruption","hi":"अनुमति के बिना सिस्टम एक्सेस, अनधिकृत शोषण (unauthorized exploitation), डेटा चोरी या व्यवधान (disruption)"},{"en":"Running an antivirus scan","hi":"एंटीवायरस स्कैन चलाना"}],"exp":{"en":"Non-ethical hacking involves unauthorized access and malicious intent, such as stealing data, causing damage, or extorting money.","hi":"नॉन-एथिकल हैकिंग (जैसे ब्लैक-हैट हैकिंग) का मतलब है बिना अनुमति के किसी सिस्टम में घुसना, डेटा चुराना या उसे नुकसान पहुँचाना।"},"num":56},{"id":"q57","q":{"en":"What does a white-hat hacker do?","hi":"व्हाइट-हैट (White-hat) हैकर क्या करता है?"},"a":{"en":"Performs authorized assessments and helps the organization fix security flaws","hi":"अधिकृत मूल्यांकन (authorized assessment) करता है और संगठन को सुरक्षा खामियों (security flaws) को ठीक करने में मदद करता है"},"o":[{"en":"Performs authorized assessments and helps the organization fix security flaws","hi":"अधिकृत मूल्यांकन (authorized assessment) करता है और संगठन को सुरक्षा खामियों (security flaws) को ठीक करने में मदद करता है"},{"en":"Steals credit card numbers","hi":"क्रेडिट कार्ड नंबर चुराता है"},{"en":"Sells vulnerabilities on the dark web","hi":"डार्क वेब पर कमजोरियां (vulnerabilities) बेचता है"},{"en":"Creates new malware for fun","hi":"मनोरंजन के लिए नया मैलवेयर बनाता है"}],"exp":{"en":"A white-hat hacker is an ethical security professional who uses their skills to improve security by finding and responsibly disclosing vulnerabilities to the system owner.","hi":"व्हाइट-हैट हैकर एक 'अच्छा हैकर' (एथिकल हैकर) होता है जो कंपनी की अनुमति से सिस्टम की सुरक्षा जांचता है और कमियों को ठीक करने में मदद करता है।"},"num":57},{"id":"q58","q":{"en":"Why do organizations hire ethical hackers?","hi":"संगठन (Organizations) एथिकल हैकर्स को क्यों नियुक्त करते हैं?"},"a":{"en":"To identify, prioritize, and fix vulnerabilities so that real attackers cannot misuse them","hi":"कमजोरियों (vulnerabilities) को पहचानने, प्राथमिकता देने और उन्हें ठीक करने के लिए, ताकि असली हमलावर (real attackers) उनका दुरुपयोग न कर सकें"},"o":[{"en":"To attack rival companies","hi":"प्रतिद्वंद्वी कंपनियों पर हमला करने के लिए"},{"en":"To identify, prioritize, and fix vulnerabilities so that real attackers cannot misuse them","hi":"कमजोरियों (vulnerabilities) को पहचानने, प्राथमिकता देने और उन्हें ठीक करने के लिए, ताकि असली हमलावर (real attackers) उनका दुरुपयोग न कर सकें"},{"en":"To save money on buying antivirus software","hi":"एंटीवायरस सॉफ़्टवेयर खरीदने पर पैसे बचाने के लिए"},{"en":"To design new company logos","hi":"नए कंपनी लोगो डिज़ाइन करने के लिए"}],"exp":{"en":"Organizations hire ethical hackers to proactively find security gaps and patch them before malicious cybercriminals can exploit those exact same weaknesses.","hi":"कंपनियाँ एथिकल हैकर्स को इसलिए रखती हैं ताकि वे साइबर अपराधियों से पहले ही सिस्टम की कमियों को ढूंढकर उन्हें ठीक कर सकें।"},"num":58},{"id":"q59","q":{"en":"What is the typical objective of a black-hat hacker?","hi":"ब्लैक-हैट (Black-hat) हैकर का सामान्य उद्देश्य क्या होता है?"},"a":{"en":"Malicious objectives such as unauthorized access, theft, extortion, or disruption","hi":"अनधिकृत पहुंच (unauthorized access), चोरी, जबरन वसूली (extortion) या व्यवधान (disruption) जैसे दुर्भावनापूर्ण उद्देश्य"},"o":[{"en":"To secure a network","hi":"नेटवर्क को सुरक्षित करना"},{"en":"Malicious objectives such as unauthorized access, theft, extortion, or disruption","hi":"अनधिकृत पहुंच (unauthorized access), चोरी, जबरन वसूली (extortion) या व्यवधान (disruption) जैसे दुर्भावनापूर्ण उद्देश्य"},{"en":"To help users recover lost passwords","hi":"खोए हुए पासवर्ड को पुनर्प्राप्त करने में उपयोगकर्ताओं की मदद करना"},{"en":"To train other ethical hackers","hi":"अन्य एथिकल हैकर्स को प्रशिक्षित करना"}],"exp":{"en":"Black-hat hackers break into computer networks with malicious intent to steal data, spread malware, or conduct cyber espionage, often for financial gain.","hi":"ब्लैक-हैट हैकर एक 'बुरा हैकर' होता है जो बिना अनुमति के, अपने निजी या आर्थिक फायदे (चोरी, फिरौती) के लिए कंप्यूटर सिस्टम पर हमला करता है।"},"num":59},{"id":"q60","q":{"en":"What is a grey-hat hacker?","hi":"ग्रे-हैट (Grey-hat) हैकर क्या होता है?"},"a":{"en":"An informal label used for a person who tests or accesses a system without permission, though sometimes with the intent to report the flaw","hi":"एक अनौपचारिक लेबल (informal label) जो बिना अनुमति के सिस्टम का परीक्षण (test) या एक्सेस करने वाले व्यक्ति के लिए उपयोग होता है, हालांकि कभी-कभी उनका इरादा खामी (flaw) को रिपोर्ट करने का भी हो सकता है"},"o":[{"en":"A hacker who only works during the day","hi":"एक हैकर जो केवल दिन में काम करता है"},{"en":"An informal label used for a person who tests or accesses a system without permission, though sometimes with the intent to report the flaw","hi":"एक अनौपचारिक लेबल (informal label) जो बिना अनुमति के सिस्टम का परीक्षण (test) या एक्सेस करने वाले व्यक्ति के लिए उपयोग होता है, हालांकि कभी-कभी उनका इरादा खामी (flaw) को रिपोर्ट करने का भी हो सकता है"},{"en":"A hacker who only targets hardware","hi":"एक हैकर जो केवल हार्डवेयर को लक्षित करता है"},{"en":"A completely legal and authorized tester","hi":"एक पूरी तरह से कानूनी और अधिकृत परीक्षक (tester)"}],"exp":{"en":"A grey-hat hacker falls between white and black hats. They may violate laws or typical ethical standards by testing a system without permission, but they generally do not have malicious intent and often report the flaw to the owner.","hi":"ग्रे-हैट हैकर, व्हाइट और ब्लैक हैकर के बीच का होता है। वह किसी सिस्टम की सुरक्षा को बिना अनुमति के तोड़ता है (जो कि गलत है), लेकिन उसका इरादा नुकसान पहुँचाना नहीं होता। वह मालिक को कमी के बारे में बता देता है।"},"num":60},{"id":"q61","q":{"en":"Does good intent alone make an activity ethical?","hi":"क्या केवल अच्छा इरादा (good intent) ही किसी गतिविधि को नैतिक (ethical) बना देता है?"},"a":{"en":"Authorization and agreed scope are important for ethical testing. Testing without permission can be unauthorized","hi":"एथिकल परीक्षण (ethical testing) के लिए प्राधिकरण (authorization) और सहमत दायरा (agreed scope) महत्वपूर्ण हैं। अनुमति के बिना परीक्षण करना अनधिकृत (unauthorized) हो सकता है"},"o":[{"en":"Yes, intent is the only thing that matters","hi":"हां, केवल इरादा ही मायने रखता है"},{"en":"Authorization and agreed scope are important for ethical testing. Testing without permission can be unauthorized","hi":"एथिकल परीक्षण (ethical testing) के लिए प्राधिकरण (authorization) और सहमत दायरा (agreed scope) महत्वपूर्ण हैं। अनुमति के बिना परीक्षण करना अनधिकृत (unauthorized) हो सकता है"},{"en":"No, ethical hacking must be done for free","hi":"नहीं, एथिकल हैकिंग मुफ्त में की जानी चाहिए"},{"en":"Yes, if no data is stolen","hi":"हां, यदि कोई डेटा चोरी नहीं हुआ है"}],"exp":{"en":"Good intentions are not enough; ethical hacking requires explicit authorization. Scanning or attacking a network without permission is illegal, regardless of the hacker's intent.","hi":"सिर्फ अच्छा इरादा होना काफी नहीं है। एथिकल हैकिंग के लिए सिस्टम के मालिक की स्पष्ट अनुमति (Permission) होना बहुत ज़रूरी है। बिना अनुमति के की गई हैकिंग गैर-कानूनी (unauthorized) मानी जाती है।"},"num":61},{"id":"q62","q":{"en":"What is the main comparison between white, grey, and black hats?","hi":"व्हाइट, ग्रे और ब्लैक हैट्स के बीच मुख्य तुलना क्या है?"},"a":{"en":"White: authorized testing. Grey: permission may be missing and motive can be mixed. Black: malicious unauthorized activity","hi":"व्हाइट: अधिकृत परीक्षण (authorized testing)। ग्रे: अनुमति गायब हो सकती है और उद्देश्य मिला-जुला (mixed) हो सकता है। ब्लैक: दुर्भावनापूर्ण अनधिकृत गतिविधि (malicious unauthorized activity)"},"o":[{"en":"White: software, Grey: network, Black: hardware","hi":"White: software, Grey: network, Black: hardware"},{"en":"White: authorized testing. Grey: permission may be missing and motive can be mixed. Black: malicious unauthorized activity","hi":"व्हाइट: अधिकृत परीक्षण (authorized testing)। ग्रे: अनुमति गायब हो सकती है और उद्देश्य मिला-जुला (mixed) हो सकता है। ब्लैक: दुर्भावनापूर्ण अनधिकृत गतिविधि (malicious unauthorized activity)"},{"en":"They are just different fashion choices","hi":"वे केवल अलग-अलग फैशन विकल्प हैं"},{"en":"White: slow hackers, Grey: medium speed, Black: fast hackers","hi":"White: slow hackers, Grey: medium speed, Black: fast hackers"}],"exp":{"en":"White hats are authorized and ethical. Black hats are unauthorized and malicious. Grey hats are unauthorized but generally non-malicious.","hi":"व्हाइट हैट: अनुमति के साथ अच्छे काम के लिए। ब्लैक हैट: बिना अनुमति के बुरे काम के लिए। ग्रे हैट: बिना अनुमति के, लेकिन आमतौर पर अच्छे या मिले-जुले इरादे से।"},"num":62},{"id":"q63","q":{"en":"What assessment areas does the source list for ethical hacking?","hi":"स्रोत (Source) एथिकल हैकिंग के लिए कौन-से मूल्यांकन क्षेत्रों (assessment areas) को सूचीबद्ध करता है?"},"a":{"en":"Web application, system, web server, wireless network, and social engineering assessments","hi":"वेब एप्लीकेशन, सिस्टम, वेब सर्वर, वायरलेस नेटवर्क और सोशल इंजीनियरिंग मूल्यांकन (assessment)"},"o":[{"en":"Only physical security of buildings","hi":"केवल इमारतों की भौतिक सुरक्षा"},{"en":"Web application, system, web server, wireless network, and social engineering assessments","hi":"वेब एप्लीकेशन, सिस्टम, वेब सर्वर, वायरलेस नेटवर्क और सोशल इंजीनियरिंग मूल्यांकन (assessment)"},{"en":"Only employee background checks","hi":"केवल कर्मचारी पृष्ठभूमि (background) की जांच"},{"en":"Database design and programming only","hi":"केवल डेटाबेस डिज़ाइन और प्रोग्रामिंग"}],"exp":{"en":"Ethical hackers evaluate security across various domains, including applications, physical systems, server configurations, Wi-Fi networks, and even employee susceptibility to social engineering.","hi":"एथिकल हैकिंग के तहत कई चीज़ों की जाँच की जाती है, जैसे: वेब एप्लिकेशन, कंप्यूटर सिस्टम, वेब सर्वर, वायरलेस नेटवर्क (Wi-Fi) और सोशल इंजीनियरिंग (कर्मचारियों की जागरूकता)।"},"num":63},{"id":"q64","q":{"en":"What is the focus in web application and web server assessment?","hi":"वेब एप्लिकेशन और वेब सर्वर मूल्यांकन (assessment) में मुख्य फोकस क्या होता है?"},"a":{"en":"Web application assessment focuses on app logic, input handling, and access controls. Server assessment focuses on hosting software, services, and configuration","hi":"वेब एप्लिकेशन मूल्यांकन ऐप लॉजिक, इनपुट हैंडलिंग और एक्सेस कंट्रोल पर फोकस करता है। सर्वर मूल्यांकन होस्टिंग सॉफ्टवेयर, सेवाओं और कॉन्फ़िगरेशन पर फोकस करता है"},"o":[{"en":"Web application assessment focuses on app logic, input handling, and access controls. Server assessment focuses on hosting software, services, and configuration","hi":"वेब एप्लिकेशन मूल्यांकन ऐप लॉजिक, इनपुट हैंडलिंग और एक्सेस कंट्रोल पर फोकस करता है। सर्वर मूल्यांकन होस्टिंग सॉफ्टवेयर, सेवाओं और कॉन्फ़िगरेशन पर फोकस करता है"},{"en":"Both focus only on website design","hi":"दोनों केवल वेबसाइट डिज़ाइन पर फोकस करते हैं"},{"en":"Application assessment focuses on server hardware, server assessment focuses on internet speed","hi":"एप्लीकेशन मूल्यांकन सर्वर हार्डवेयर पर फोकस करता है, सर्वर मूल्यांकन इंटरनेट स्पीड पर फोकस करता है"},{"en":"There is no difference","hi":"कोई अंतर नहीं है"}],"exp":{"en":"App assessment tests the code (like SQL injection). Server assessment tests the environment hosting the code (like unpatched Apache or IIS servers).","hi":"वेब एप्लिकेशन असेसमेंट में सॉफ्टवेयर के कोड, इनपुट और सुरक्षा की जाँच होती है (जैसे ऐप कैसे काम करता है)। वेब सर्वर असेसमेंट में उस सर्वर और उसकी सेटिंग्स की जाँच होती है जहाँ वह ऐप होस्ट किया गया है।"},"num":64},{"id":"q65","q":{"en":"What is the focus of system and wireless network assessments?","hi":"सिस्टम और वायरलेस नेटवर्क मूल्यांकन (assessments) का फोकस क्या है?"},"a":{"en":"System assessment focuses on endpoint/OS controls. Wireless assessment looks at Wi-Fi access, authentication, and configuration","hi":"सिस्टम मूल्यांकन एंडपॉइंट/ओएस (OS) नियंत्रण (controls) को देखता है। वायरलेस मूल्यांकन वाई-फाई एक्सेस, प्रमाणीकरण (authentication) और कॉन्फ़िगरेशन को देखता है"},"o":[{"en":"System assessment focuses on endpoint/OS controls. Wireless assessment looks at Wi-Fi access, authentication, and configuration","hi":"सिस्टम मूल्यांकन एंडपॉइंट/ओएस (OS) नियंत्रण (controls) को देखता है। वायरलेस मूल्यांकन वाई-फाई एक्सेस, प्रमाणीकरण (authentication) और कॉन्फ़िगरेशन को देखता है"},{"en":"Both focus on physical cable lengths","hi":"दोनों भौतिक केबल की लंबाई पर फोकस करते हैं"},{"en":"System assessment looks at cloud storage, wireless looks at Bluetooth only","hi":"सिस्टम मूल्यांकन क्लाउड स्टोरेज को देखता है, वायरलेस केवल ब्लूटूथ को देखता है"},{"en":"They both only check antivirus definitions","hi":"वे दोनों केवल एंटीवायरस परिभाषाओं की जांच करते हैं"}],"exp":{"en":"System hacking tests OS-level vulnerabilities (Windows/Linux). Wireless hacking tests the security of WLANs (like cracking WEP/WPA passwords).","hi":"सिस्टम असेसमेंट कंप्यूटर के ऑपरेटिंग सिस्टम (जैसे Windows) की सुरक्षा को परखता है। वायरलेस असेसमेंट Wi-Fi नेटवर्क के पासवर्ड और सेटिंग्स की सुरक्षा की जाँच करता है।"},"num":65},{"id":"q66","q":{"en":"What is social engineering?","hi":"सोशल इंजीनियरिंग (Social engineering) क्या होती है?"},"a":{"en":"Using human trust, urgency, or authority to trick a person into providing sensitive information or taking a risky action","hi":"किसी व्यक्ति से संवेदनशील जानकारी निकालने या उसे कोई जोखिम भरा कार्य (risky action) करने के लिए मानवीय विश्वास (human trust), तात्कालिकता (urgency) या अधिकार (authority) का उपयोग करना"},"o":[{"en":"Building social media websites","hi":"सोशल मीडिया वेबसाइट बनाना"},{"en":"Using human trust, urgency, or authority to trick a person into providing sensitive information or taking a risky action","hi":"किसी व्यक्ति से संवेदनशील जानकारी निकालने या उसे कोई जोखिम भरा कार्य (risky action) करने के लिए मानवीय विश्वास (human trust), तात्कालिकता (urgency) या अधिकार (authority) का उपयोग करना"},{"en":"Engineering networks for schools","hi":"स्कूलों के लिए नेटवर्क की इंजीनियरिंग करना"},{"en":"Creating fake news","hi":"फर्जी खबरें बनाना"}],"exp":{"en":"Social engineering is the psychological manipulation of people into performing actions or divulging confidential information, bypassing technical security controls.","hi":"सोशल इंजीनियरिंग एक तकनीक है जिसमें हैकर तकनीकी तरीकों के बजाय, लोगों को मनोवैज्ञानिक रूप से धोखा देकर (जैसे विश्वास जीतना, डराना या जल्दबाज़ी दिखाना) उनसे पासवर्ड या गुप्त जानकारी निकलवाते हैं।"},"num":66}]},{"title":{"en":"7. Phishing, Sniffing, Spoofing & Snooping","hi":"7. फ़िशिंग, स्निफ़िंग, स्पूफ़िंग और स्नूपिंग"},"questions":[{"id":"q67","q":{"en":"What is Phishing?","hi":"फ़िशिंग (Phishing) क्या है?"},"a":{"en":"A fraud to collect credentials, bank details, or other sensitive information by posing as a trusted entity through fake messages, websites, or calls","hi":"फर्जी संदेशों, वेबसाइटों या कॉल के माध्यम से एक विश्वसनीय संस्था (trusted entity) बनकर क्रेडेंशियल्स (पासवर्ड आदि), बैंक विवरण या अन्य संवेदनशील जानकारी एकत्र करने की एक धोखाधड़ी (fraud)"},"o":[{"en":"A type of network router","hi":"एक प्रकार का नेटवर्क राउटर"},{"en":"A fraud to collect credentials, bank details, or other sensitive information by posing as a trusted entity through fake messages, websites, or calls","hi":"फर्जी संदेशों, वेबसाइटों या कॉल के माध्यम से एक विश्वसनीय संस्था (trusted entity) बनकर क्रेडेंशियल्स (पासवर्ड आदि), बैंक विवरण या अन्य संवेदनशील जानकारी एकत्र करने की एक धोखाधड़ी (fraud)"},{"en":"A secure way to log into a bank","hi":"बैंक में लॉग इन करने का एक सुरक्षित तरीका"},{"en":"A software testing technique","hi":"एक सॉफ्टवेयर परीक्षण तकनीक"}],"exp":{"en":"Phishing is a cybercrime in which a target is contacted by email, telephone, or text message by someone posing as a legitimate institution to lure them into providing sensitive data.","hi":"फ़िशिंग एक साइबर अपराध है जिसमें हैकर किसी असली कंपनी या बैंक का भेष बनाकर यूज़र को फ़र्ज़ी ईमेल, एसएमएस या लिंक भेजते हैं, ताकि वे यूज़र के पासवर्ड, क्रेडिट कार्ड की जानकारी या अन्य संवेदनशील डेटा चुरा सकें।"},"num":67},{"id":"q68","q":{"en":"Why does an attacker use logos and copied designs in phishing?","hi":"फ़िशिंग में हमलावर (Attacker) लोगो (logos) और कॉपी किए गए डिज़ाइन का उपयोग क्यों करता है?"},"a":{"en":"To make the fake content look like a genuine brand message or website","hi":"फर्जी कंटेंट को असली ब्रांड के संदेश या वेबसाइट जैसा दिखाने के लिए"},"o":[{"en":"To make the email look colorful","hi":"ईमेल को रंगीन बनाने के लिए"},{"en":"To prove they are hackers","hi":"यह साबित करने के लिए कि वे हैकर्स हैं"},{"en":"To make the fake content look like a genuine brand message or website","hi":"फर्जी कंटेंट को असली ब्रांड के संदेश या वेबसाइट जैसा दिखाने के लिए"},{"en":"To avoid copyright strikes","hi":"कॉपीराइट स्ट्राइक से बचने के लिए"}],"exp":{"en":"Attackers replicate the branding, logos, and language of trusted organizations (like banks or Amazon) to establish trust and deceive the victim into believing the communication is authentic.","hi":"हमलावर (हैकर) असली कंपनी (जैसे बैंक या अमेज़न) के लोगो और डिज़ाइन की हूबहू नकल करते हैं, ताकि यूज़र को लगे कि वह संदेश या वेबसाइट बिल्कुल असली और भरोसेमंद है।"},"num":68},{"id":"q69","q":{"en":"On what channels does phishing occur besides email?","hi":"ईमेल के अलावा फ़िशिंग किन चैनलों (channels) पर होती है?"},"a":{"en":"Text messages, phone calls, and other messaging platforms. SMS phishing is called smishing and voice phishing is called vishing","hi":"टेक्स्ट संदेश (SMS), फोन कॉल और अन्य मैसेजिंग प्लेटफॉर्म। एसएमएस फ़िशिंग को स्मिशिंग (smishing) और वॉयस फ़िशिंग को विशिंग (vishing) कहा जाता है"},"o":[{"en":"Only on physical letters","hi":"केवल भौतिक पत्रों पर"},{"en":"Text messages, phone calls, and other messaging platforms. SMS phishing is called smishing and voice phishing is called vishing","hi":"टेक्स्ट संदेश (SMS), फोन कॉल और अन्य मैसेजिंग प्लेटफॉर्म। एसएमएस फ़िशिंग को स्मिशिंग (smishing) और वॉयस फ़िशिंग को विशिंग (vishing) कहा जाता है"},{"en":"Only through fax machines","hi":"केवल फैक्स मशीनों के माध्यम से"},{"en":"It only happens on email","hi":"यह केवल ईमेल पर होता है"}],"exp":{"en":"While email is common, phishing is also prevalent via SMS (Smishing) and voice calls (Vishing), exploiting whatever communication channel the victim uses.","hi":"फ़िशिंग केवल ईमेल तक सीमित नहीं है। यह SMS (जिसे स्मिशिंग/smishing कहते हैं) और फोन कॉल (जिसे विशिंग/vishing कहते हैं) के ज़रिए भी बहुत आम है।"},"num":69},{"id":"q70","q":{"en":"What type of attack is a fake banking login page an example of?","hi":"फर्जी बैंकिंग लॉगिन पेज (fake banking login page) किस प्रकार के हमले का उदाहरण है?"},"a":{"en":"Phishing. The user is tricked into entering a username, password, or card details on an impersonated site","hi":"फ़िशिंग (Phishing)। उपयोगकर्ता को एक प्रतिरूपित (impersonated) साइट पर उपयोगकर्ता नाम, पासवर्ड या कार्ड विवरण दर्ज करने के लिए धोखा दिया जाता है"},"o":[{"en":"Phishing. The user is tricked into entering a username, password, or card details on an impersonated site","hi":"फ़िशिंग (Phishing)। उपयोगकर्ता को एक प्रतिरूपित (impersonated) साइट पर उपयोगकर्ता नाम, पासवर्ड या कार्ड विवरण दर्ज करने के लिए धोखा दिया जाता है"},{"en":"Ransomware","hi":"रैंसमवेयर"},{"en":"Denial of Service (DoS)","hi":"डिनायल ऑफ सर्विस (DoS)"},{"en":"Hardware failure","hi":"हार्डवेयर विफलता"}],"exp":{"en":"A fake login page is a classic phishing technique. The victim believes they are logging into their actual bank, but their credentials go straight to the attacker.","hi":"फर्जी बैंकिंग लॉगिन पेज फ़िशिंग का सबसे आम तरीका है। इसमें यूज़र को एक नकली वेबसाइट का लिंक भेजा जाता है जो बिल्कुल असली बैंक जैसी दिखती है, ताकि यूज़र उसमें अपना पासवर्ड डाल दे।"},"num":70},{"id":"q71","q":{"en":"What are common clues of a phishing message?","hi":"फ़िशिंग संदेश के सामान्य सुराग (Common clues) क्या हैं?"},"a":{"en":"Unexpected urgency, unfamiliar sender/domain, demand for sensitive details, and suspicious links or attachments","hi":"अप्रत्याशित तात्कालिकता (unexpected urgency), अपरिचित प्रेषक/डोमेन (unfamiliar sender/domain), संवेदनशील विवरणों की मांग, और संदिग्ध लिंक (suspicious links) या अटैचमेंट"},"o":[{"en":"Perfect grammar and correct spelling","hi":"पूर्ण व्याकरण और सही वर्तनी"},{"en":"Unexpected urgency, unfamiliar sender/domain, demand for sensitive details, and suspicious links or attachments","hi":"अप्रत्याशित तात्कालिकता (unexpected urgency), अपरिचित प्रेषक/डोमेन (unfamiliar sender/domain), संवेदनशील विवरणों की मांग, और संदिग्ध लिंक (suspicious links) या अटैचमेंट"},{"en":"A digitally signed certificate from the government","hi":"सरकार की ओर से डिजिटली हस्ताक्षरित प्रमाणपत्र"},{"en":"A personalized message from a known friend","hi":"एक ज्ञात मित्र का व्यक्तिगत संदेश"}],"exp":{"en":"Red flags for phishing include threats to close an account (urgency), mispelled domain names (e.g., paypa1.com), and unsolicited requests for passwords or PINs.","hi":"फ़िशिंग संदेशों की पहचान इन बातों से की जा सकती है: जल्दबाज़ी दिखाना (जैसे 'आपका अकाउंट ब्लॉक हो जाएगा'), गलत या अजीब ईमेल एड्रेस, पासवर्ड मांगना, और संदेहास्पद लिंक भेजना।"},"num":71},{"id":"q72","q":{"en":"What is packet sniffing?","hi":"पैकेट स्निफ़िंग (Packet sniffing) क्या होती है?"},"a":{"en":"Capturing and inspecting packets traveling over a network","hi":"नेटवर्क पर यात्रा कर रहे पैकेटों (packets) को कैप्चर करना और उनका निरीक्षण (inspect) करना"},"o":[{"en":"Sending large packets to crash a server","hi":"सर्वर को क्रैश करने के लिए बड़े पैकेट भेजना"},{"en":"Capturing and inspecting packets traveling over a network","hi":"नेटवर्क पर यात्रा कर रहे पैकेटों (packets) को कैप्चर करना और उनका निरीक्षण (inspect) करना"},{"en":"Encrypting data packets","hi":"डेटा पैकेटों को एन्क्रिप्ट करना"},{"en":"A dog sniffing physical mail","hi":"भौतिक मेल को सूंघने वाला कुत्ता"}],"exp":{"en":"Packet sniffing involves intercepting and logging network traffic (data packets) as it passes over a digital network, which can be done for troubleshooting or malicious eavesdropping.","hi":"पैकेट स्निफ़िंग का मतलब है किसी नेटवर्क (जैसे Wi-Fi) से गुज़रने वाले डेटा (पैकेट्स) को बीच में ही पकड़ना और उसे पढ़ना (निरीक्षण करना)। यह नेटवर्क की जासूसी करने का एक तरीका है।"},"num":72},{"id":"q73","q":{"en":"What is a packet sniffer?","hi":"पैकेट स्निफ़र (Packet sniffer) क्या होता है?"},"a":{"en":"A software or device that captures network traffic. Authorized administrators can use it for troubleshooting and security monitoring","hi":"सॉफ्टवेयर या उपकरण जो नेटवर्क ट्रैफिक को कैप्चर करता है। अधिकृत प्रशासक (Authorized administrators) इसका उपयोग समस्या निवारण (troubleshooting) और सुरक्षा निगरानी के लिए कर सकते हैं"},"o":[{"en":"A software or device that captures network traffic. Authorized administrators can use it for troubleshooting and security monitoring","hi":"सॉफ्टवेयर या उपकरण जो नेटवर्क ट्रैफिक को कैप्चर करता है। अधिकृत प्रशासक (Authorized administrators) इसका उपयोग समस्या निवारण (troubleshooting) और सुरक्षा निगरानी के लिए कर सकते हैं"},{"en":"A type of firewall that blocks all traffic","hi":"एक प्रकार का फ़ायरवॉल जो सभी ट्रैफ़िक को ब्लॉक करता है"},{"en":"A physical tool used to cut network cables","hi":"नेटवर्क केबलों को काटने के लिए इस्तेमाल किया जाने वाला एक भौतिक उपकरण"},{"en":"A virus that destroys network cards","hi":"एक वायरस जो नेटवर्क कार्ड को नष्ट कर देता है"}],"exp":{"en":"A packet sniffer (like Wireshark) is a tool that intercepts data flowing in a network. While hackers use it to steal data, network admins use it legitimately to monitor and diagnose network issues.","hi":"पैकेट स्निफ़र एक सॉफ़्टवेयर या हार्डवेयर टूल है जो नेटवर्क ट्रैफ़िक को कैप्चर करता है। नेटवर्क एडमिन इसका इस्तेमाल नेटवर्क की खराबी ढूँढने के लिए करते हैं, लेकिन हैकर इसका इस्तेमाल डेटा चुराने के लिए करते हैं।"},"num":73},{"id":"q74","q":{"en":"What is the role of encryption in network packet capture and credential theft?","hi":"नेटवर्क पैकेट कैप्चर और क्रेडेंशियल चोरी में एन्क्रिप्शन (Encryption) की क्या भूमिका है?"},"a":{"en":"The traffic of an encrypted session can be captured, but a properly encrypted payload is not available in a readable form to a passive observer","hi":"एन्क्रिप्टेड सत्र (encrypted session) का ट्रैफ़िक कैप्चर किया जा सकता है, लेकिन एक पैसिव ऑब्जर्वर (passive observer) को ठीक से एन्क्रिप्टेड पेलोड (payload) पठनीय रूप (readable form) में उपलब्ध नहीं होता है"},"o":[{"en":"Encryption prevents packets from being captured at all","hi":"एन्क्रिप्शन पैकेट को कैप्चर होने से पूरी तरह रोकता है"},{"en":"The traffic of an encrypted session can be captured, but a properly encrypted payload is not available in a readable form to a passive observer","hi":"एन्क्रिप्टेड सत्र (encrypted session) का ट्रैफ़िक कैप्चर किया जा सकता है, लेकिन एक पैसिव ऑब्जर्वर (passive observer) को ठीक से एन्क्रिप्टेड पेलोड (payload) पठनीय रूप (readable form) में उपलब्ध नहीं होता है"},{"en":"Encryption automatically deletes captured packets","hi":"एन्क्रिप्शन कैप्चर किए गए पैकेटों को स्वचालित रूप से हटा देता है"},{"en":"Encryption makes passwords visible","hi":"एन्क्रिप्शन पासवर्ड को दृश्यमान बनाता है"}],"exp":{"en":"Sniffers can still capture encrypted packets, but without the decryption key, the attacker only sees scrambled data, preventing the theft of plaintext passwords.","hi":"यदि डेटा एन्क्रिप्टेड (सुरक्षित) है, तो पैकेट स्निफ़र उस डेटा को कैप्चर (पकड़) तो सकता है, लेकिन वह उसे पढ़ या समझ नहीं सकता (वह डेटा उसे कचरे या कोड के रूप में दिखेगा)।"},"num":74},{"id":"q75","q":{"en":"What is spoofing?","hi":"स्पूफिंग (Spoofing) क्या है?"},"a":{"en":"Falsifying the identity of a sender, device, or data source to make it appear like a trusted source","hi":"प्रेषक (sender), डिवाइस या डेटा स्रोत की पहचान को गलत साबित करना (falsify) ताकि वह एक विश्वसनीय स्रोत (trusted source) जैसा दिखे"},"o":[{"en":"Sending spam emails in bulk","hi":"बड़ी मात्रा में स्पैम ईमेल भेजना"},{"en":"Falsifying the identity of a sender, device, or data source to make it appear like a trusted source","hi":"प्रेषक (sender), डिवाइस या डेटा स्रोत की पहचान को गलत साबित करना (falsify) ताकि वह एक विश्वसनीय स्रोत (trusted source) जैसा दिखे"},{"en":"Guessing a password by trying all combinations","hi":"सभी संयोजनों की कोशिश करके पासवर्ड का अनुमान लगाना"},{"en":"Encrypting a hard drive","hi":"हार्ड ड्राइव को एन्क्रिप्ट करना"}],"exp":{"en":"Spoofing is the act of disguising a communication from an unknown source as being from a known, trusted source, often used to bypass access controls or trick users.","hi":"स्पूफिंग का मतलब है अपनी असली पहचान (जैसे IP एड्रेस, ईमेल या फोन नंबर) को छिपाकर किसी और का भेष (Trusted source) बना लेना, ताकि सामने वाले को धोखा दिया जा सके।"},"num":75},{"id":"q76","q":{"en":"What are the three network spoofing examples from the source?","hi":"स्रोत (Source) के तीन नेटवर्क स्पूफिंग (network spoofing) उदाहरण कौन से हैं?"},"a":{"en":"ARP spoofing, DNS spoofing, and IP address spoofing","hi":"ARP स्पूफिंग, DNS स्पूफिंग और IP एड्रेस स्पूफिंग"},"o":[{"en":"HTML spoofing, CSS spoofing, JS spoofing","hi":"HTML spoofing, CSS spoofing, JS spoofing"},{"en":"ARP spoofing, DNS spoofing, and IP address spoofing","hi":"ARP स्पूफिंग, DNS स्पूफिंग और IP एड्रेस स्पूफिंग"},{"en":"WiFi spoofing, Bluetooth spoofing, NFC spoofing","hi":"WiFi spoofing, Bluetooth spoofing, NFC spoofing"},{"en":"Windows spoofing, Linux spoofing, Mac spoofing","hi":"Windows spoofing, Linux spoofing, Mac spoofing"}],"exp":{"en":"Common network-level spoofing techniques include IP spoofing (faking the source IP), ARP spoofing (linking an attacker's MAC address to a legitimate IP), and DNS spoofing (altering name resolution).","hi":"नेटवर्क के स्तर पर तीन मुख्य प्रकार की स्पूफिंग होती है: ARP स्पूफिंग, DNS स्पूफिंग और IP एड्रेस स्पूफिंग।"},"num":76},{"id":"q77","q":{"en":"What is the basic effect of ARP spoofing?","hi":"ARP स्पूफिंग का बुनियादी प्रभाव (Basic effect) क्या है?"},"a":{"en":"By forcing the acceptance of a false IP-to-MAC mapping, it can misdirect local traffic","hi":"फाल्स (गलत) IP-to-MAC मैपिंग को स्वीकार करवाकर, यह स्थानीय ट्रैफ़िक (local traffic) को गलत दिशा (misdirect) में भेज सकता है"},"o":[{"en":"It crashes the DNS server","hi":"यह DNS सर्वर को क्रैश कर देता है"},{"en":"By forcing the acceptance of a false IP-to-MAC mapping, it can misdirect local traffic","hi":"फाल्स (गलत) IP-to-MAC मैपिंग को स्वीकार करवाकर, यह स्थानीय ट्रैफ़िक (local traffic) को गलत दिशा (misdirect) में भेज सकता है"},{"en":"It changes the computer's MAC address permanently","hi":"यह कंप्यूटर के मैक एड्रेस को स्थायी रूप से बदल देता है"},{"en":"It blocks all incoming emails","hi":"यह सभी आने वाले ईमेल को ब्लॉक कर देता है"}],"exp":{"en":"In ARP spoofing, an attacker sends falsified ARP messages over a local area network to link their MAC address with the IP address of a legitimate computer or gateway, allowing them to intercept traffic.","hi":"ARP स्पूफिंग में हैकर लोकल नेटवर्क (LAN) पर गलत जानकारी (IP से MAC एड्रेस की मैपिंग) भेजता है, जिससे नेटवर्क का ट्रैफ़िक (डेटा) असली व्यक्ति के बजाय हैकर के पास चला जाता है।"},"num":77},{"id":"q78","q":{"en":"What is the basic effect of DNS spoofing?","hi":"DNS स्पूफिंग का बुनियादी प्रभाव क्या है?"},"a":{"en":"A false name-resolution response can direct the user to a wrong address","hi":"फाल्स नेम-रिज़ॉल्यूशन रिस्पांस (false name-resolution response) से उपयोगकर्ता को गलत एड्रेस (वेबसाइट) पर भेजा जा सकता है"},"o":[{"en":"It prevents the user from typing on their keyboard","hi":"यह उपयोगकर्ता को अपने कीबोर्ड पर टाइप करने से रोकता है"},{"en":"A false name-resolution response can direct the user to a wrong address","hi":"फाल्स नेम-रिज़ॉल्यूशन रिस्पांस (false name-resolution response) से उपयोगकर्ता को गलत एड्रेस (वेबसाइट) पर भेजा जा सकता है"},{"en":"It creates a backup of the DNS server","hi":"यह DNS सर्वर का बैकअप बनाता है"},{"en":"It speeds up website loading times","hi":"यह वेबसाइट लोडिंग समय को तेज करता है"}],"exp":{"en":"DNS spoofing (or DNS cache poisoning) alters DNS records so that when a user types a legitimate web address, they are redirected to a fraudulent, malicious website.","hi":"DNS स्पूफिंग में हैकर DNS सर्वर की जानकारी में हेरफेर कर देता है। इसके कारण जब आप कोई सही वेबसाइट का नाम (जैसे google.com) टाइप करते हैं, तो आप हैकर की नकली वेबसाइट पर पहुँच जाते हैं।"},"num":78},{"id":"q79","q":{"en":"What is the basic effect of IP spoofing?","hi":"IP स्पूफिंग का बुनियादी प्रभाव क्या है?"},"a":{"en":"A false source IP is used in the packet, making it look like the packet came from another system","hi":"पैकेट में फाल्स सोर्स आईपी (false source IP) का उपयोग होता है, जिससे ऐसा लग सकता है कि पैकेट किसी अन्य सिस्टम से आया है"},"o":[{"en":"The computer changes its physical location","hi":"कंप्यूटर अपना भौतिक स्थान बदल लेता है"},{"en":"A false source IP is used in the packet, making it look like the packet came from another system","hi":"पैकेट में फाल्स सोर्स आईपी (false source IP) का उपयोग होता है, जिससे ऐसा लग सकता है कि पैकेट किसी अन्य सिस्टम से आया है"},{"en":"It prevents the computer from connecting to the internet","hi":"यह कंप्यूटर को इंटरनेट से कनेक्ट होने से रोकता है"},{"en":"It encrypts the entire hard drive","hi":"यह पूरी हार्ड ड्राइव को एन्क्रिप्ट करता है"}],"exp":{"en":"IP spoofing involves creating IP packets with a forged source IP address to conceal the identity of the sender or impersonate another computing system.","hi":"IP स्पूफिंग में डेटा पैकेट के अंदर भेजने वाले का IP एड्रेस बदल (फर्जी कर) दिया जाता है। इससे ऐसा लगता है कि डेटा किसी भरोसेमंद कंप्यूटर से आया है, जबकि असल में वह हैकर ने भेजा होता है।"},"num":79},{"id":"q80","q":{"en":"What is the difference between phishing and spoofing?","hi":"फ़िशिंग (Phishing) और स्पूफिंग (Spoofing) में क्या अंतर है?"},"a":{"en":"Phishing tricks a person. Spoofing fakes source identity or network information. Phishing can use spoofing","hi":"फ़िशिंग किसी व्यक्ति को धोखा (trick) देती है। स्पूफिंग स्रोत पहचान (source identity) या नेटवर्क जानकारी को फेक (fake) करती है। फ़िशिंग में स्पूफिंग का उपयोग हो सकता है"},"o":[{"en":"Phishing tricks a person. Spoofing fakes source identity or network information. Phishing can use spoofing","hi":"फ़िशिंग किसी व्यक्ति को धोखा (trick) देती है। स्पूफिंग स्रोत पहचान (source identity) या नेटवर्क जानकारी को फेक (fake) करती है। फ़िशिंग में स्पूफिंग का उपयोग हो सकता है"},{"en":"Phishing is a virus, spoofing is a worm","hi":"फ़िशिंग एक वायरस है, स्पूफिंग एक वर्म है"},{"en":"Phishing targets hardware, spoofing targets software","hi":"फ़िशिंग हार्डवेयर को लक्षित करती है, स्पूफिंग सॉफ्टवेयर को लक्षित करती है"},{"en":"There is no difference; they are exactly the same","hi":"कोई अंतर नहीं है; वे बिल्कुल एक समान हैं"}],"exp":{"en":"Spoofing is a technical deception (faking an identity/address), while phishing is a psychological deception (tricking a human). Phishing campaigns often use spoofed email addresses to appear legitimate.","hi":"स्पूफिंग का मतलब है तकनीकी रूप से भेष बदलना (जैसे नकली ईमेल या IP एड्रेस)। फ़िशिंग का मतलब है किसी इंसान को मनोवैज्ञानिक रूप से धोखा देना। अक्सर फ़िशिंग करने के लिए स्पूफिंग (नकली पहचान) का इस्तेमाल किया जाता है।"},"num":80},{"id":"q81","q":{"en":"What is snooping?","hi":"स्नूपिंग (Snooping) क्या होती है?"},"a":{"en":"Inspecting someone's files, data, messages, or traffic in a secret or unauthorized way","hi":"किसी की फाइलों, डेटा, संदेशों या ट्रैफ़िक का गुप्त (secret) या अनधिकृत तरीके (unauthorized way) से निरीक्षण (inspect) करना"},"o":[{"en":"Looking at public information","hi":"सार्वजनिक जानकारी देखना"},{"en":"Inspecting someone's files, data, messages, or traffic in a secret or unauthorized way","hi":"किसी की फाइलों, डेटा, संदेशों या ट्रैफ़िक का गुप्त (secret) या अनधिकृत तरीके (unauthorized way) से निरीक्षण (inspect) करना"},{"en":"Encrypting files securely","hi":"फाइलों को सुरक्षित रूप से एन्क्रिप्ट करना"},{"en":"A type of firewall configuration","hi":"एक प्रकार का फ़ायरवॉल कॉन्फ़िगरेशन"}],"exp":{"en":"Snooping generally refers to unauthorized, covert observation or inspection of another person's files, messages, or data as it travels across a network.","hi":"स्नूपिंग का मतलब है किसी अन्य व्यक्ति के कंप्यूटर, फाइल, मैसेज या नेटवर्क ट्रैफ़िक पर छिपकर नज़र रखना या जासूसी करना।"},"num":81},{"id":"q82","q":{"en":"What does the unencrypted-login example in the source show?","hi":"स्रोत (Source) का अनएन्क्रिप्टेड-लॉगिन (unencrypted-login) उदाहरण क्या दिखाता है?"},"a":{"en":"A person capturing secret traffic on the network can see readable usernames/passwords if the session is in cleartext","hi":"नेटवर्क पर गुप्त ट्रैफ़िक कैप्चर करने वाला व्यक्ति पठनीय उपयोगकर्ता नाम/पासवर्ड (readable username/password) देख सकता है यदि सत्र (session) क्लियरटेक्स्ट (cleartext) में हो"},"o":[{"en":"A person capturing secret traffic on the network can see readable usernames/passwords if the session is in cleartext","hi":"नेटवर्क पर गुप्त ट्रैफ़िक कैप्चर करने वाला व्यक्ति पठनीय उपयोगकर्ता नाम/पासवर्ड (readable username/password) देख सकता है यदि सत्र (session) क्लियरटेक्स्ट (cleartext) में हो"},{"en":"Unencrypted logins are more secure","hi":"अनएन्क्रिप्टेड लॉगिन अधिक सुरक्षित हैं"},{"en":"Passwords are automatically encrypted by the router","hi":"पासवर्ड राउटर द्वारा स्वचालित रूप से एन्क्रिप्ट किए जाते हैं"},{"en":"The server rejects unencrypted traffic","hi":"सर्वर अनएन्क्रिप्टेड ट्रैफ़िक को अस्वीकार करता है"}],"exp":{"en":"If communication is not encrypted (using HTTP instead of HTTPS, for instance), anyone snooping on the network traffic can read sensitive information like passwords directly.","hi":"अगर आप बिना एन्क्रिप्शन (बिना HTTPS) वाले पेज पर लॉगिन करते हैं, तो नेटवर्क पर स्नूपिंग करने वाला हैकर आपका पासवर्ड आसानी से पढ़ सकता है क्योंकि वह सादे टेक्स्ट (cleartext) में जा रहा होता है।"},"num":82},{"id":"q83","q":{"en":"What concept is shown in the IGMP Snooping diagram on PDF p. 181?","hi":"PDF पृ. 181 पर IGMP स्नूपिंग (IGMP Snooping) आरेख (diagram) किस अवधारणा का है?"},"a":{"en":"A switch's multicast forwarding feature. By observing Internet Group Management Protocol (IGMP) messages, the switch limits multicast traffic to relevant ports. Security-context snooping is a term for covert observation","hi":"यह स्विच का मल्टीकास्ट फॉरवर्डिंग (multicast forwarding) फीचर है। इंटरनेट ग्रुप मैनेजमेंट प्रोटोकॉल (IGMP) संदेशों को देखकर (observe), स्विच मल्टीकास्ट ट्रैफ़िक को केवल प्रासंगिक पोर्ट (relevant ports) तक सीमित करता है। सुरक्षा-संदर्भ (security-context) में स्नूपिंग गुप्त अवलोकन (covert observation) का शब्द है"},"o":[{"en":"A switch's multicast forwarding feature. By observing Internet Group Management Protocol (IGMP) messages, the switch limits multicast traffic to relevant ports. Security-context snooping is a term for covert observation","hi":"यह स्विच का मल्टीकास्ट फॉरवर्डिंग (multicast forwarding) फीचर है। इंटरनेट ग्रुप मैनेजमेंट प्रोटोकॉल (IGMP) संदेशों को देखकर (observe), स्विच मल्टीकास्ट ट्रैफ़िक को केवल प्रासंगिक पोर्ट (relevant ports) तक सीमित करता है। सुरक्षा-संदर्भ (security-context) में स्नूपिंग गुप्त अवलोकन (covert observation) का शब्द है"},{"en":"A hacker stealing emails","hi":"एक हैकर जो ईमेल चुराता है"},{"en":"A method for printing documents wirelessly","hi":"दस्तावेज़ों को वायरलेस तरीके से प्रिंट करने की एक विधि"},{"en":"A protocol for sending spam","hi":"स्पैम भेजने का एक प्रोटोकॉल"}],"exp":{"en":"In networking, IGMP snooping is a beneficial switch feature that optimizes multicast traffic. In a security context, 'snooping' means unauthorized eavesdropping.","hi":"नेटवर्किंग में IGMP स्नूपिंग एक अच्छी तकनीक है जिससे स्विच केवल उसी कंप्यूटर को डेटा भेजता है जिसे उसकी ज़रूरत है। लेकिन साइबर सुरक्षा (Security) में 'स्नूपिंग' का मतलब जासूसी (चोरी-छिपे डेटा देखना) होता है।"},"num":83}]},{"title":{"en":"8. Firewall, Authentication, Authorization & Antivirus","hi":"8. फ़ायरवॉल, प्रमाणीकरण, प्राधिकरण और एंटीवायरस"},"questions":[{"id":"q84","q":{"en":"What is a firewall?","hi":"फ़ायरवॉल (Firewall) क्या होता है?"},"a":{"en":"A hardware, software, or combined control that allows or blocks incoming and outgoing network traffic based on security rules","hi":"एक हार्डवेयर, सॉफ्टवेयर या संयुक्त नियंत्रण (combined control) जो सुरक्षा नियमों (security rules) के आधार पर आने वाले (incoming) और जाने वाले (outgoing) नेटवर्क ट्रैफ़िक को अनुमति देता है या ब्लॉक करता है"},"o":[{"en":"A physical wall to prevent server fires","hi":"सर्वर की आग को रोकने के लिए एक भौतिक दीवार"},{"en":"A hardware, software, or combined control that allows or blocks incoming and outgoing network traffic based on security rules","hi":"एक हार्डवेयर, सॉफ्टवेयर या संयुक्त नियंत्रण (combined control) जो सुरक्षा नियमों (security rules) के आधार पर आने वाले (incoming) और जाने वाले (outgoing) नेटवर्क ट्रैफ़िक को अनुमति देता है या ब्लॉक करता है"},{"en":"An antivirus program","hi":"एक एंटीवायरस प्रोग्राम"},{"en":"A cooling system for CPUs","hi":"सीपीयू के लिए एक कूलिंग सिस्टम"}],"exp":{"en":"A firewall acts as a barrier between a trusted network and an untrusted network, using predetermined security rules to monitor and control network traffic.","hi":"फ़ायरवॉल एक सुरक्षा प्रणाली (हार्डवेयर या सॉफ्टवेयर) है जो यह तय करती है कि कौन सा डेटा नेटवर्क या कंप्यूटर के अंदर आ सकता है और कौन सा बाहर जा सकता है, इसके लिए वह सुरक्षा नियमों का पालन करती है।"},"num":84},{"id":"q85","q":{"en":"What does a firewall do between a trusted network and the Internet?","hi":"फ़ायरवॉल विश्वसनीय नेटवर्क (trusted network) और इंटरनेट के बीच क्या करता है?"},"a":{"en":"It filters traffic at network boundaries. A host firewall can filter traffic on a single device","hi":"यह नेटवर्क सीमाओं (boundaries) पर ट्रैफ़िक को फ़िल्टर करता है। एक होस्ट फ़ायरवॉल (host firewall) एक डिवाइस पर ट्रैफ़िक फ़िल्टर कर सकता है"},"o":[{"en":"It speeds up the internet connection","hi":"यह इंटरनेट कनेक्शन को तेज करता है"},{"en":"It filters traffic at network boundaries. A host firewall can filter traffic on a single device","hi":"यह नेटवर्क सीमाओं (boundaries) पर ट्रैफ़िक को फ़िल्टर करता है। एक होस्ट फ़ायरवॉल (host firewall) एक डिवाइस पर ट्रैफ़िक फ़िल्टर कर सकता है"},{"en":"It acts as a search engine","hi":"यह एक सर्च इंजन के रूप में कार्य करता है"},{"en":"It stores backup data","hi":"यह बैकअप डेटा स्टोर करता है"}],"exp":{"en":"Network firewalls protect the perimeter of a network from external internet threats. Host-based firewalls protect individual computers (endpoints) regardless of the network they are connected to.","hi":"नेटवर्क फ़ायरवॉल पूरे नेटवर्क की सीमा (बॉर्डर) पर डेटा को छानता (फ़िल्टर) है। जबकि होस्ट फ़ायरवॉल (जैसे Windows Firewall) केवल उसी एक कंप्यूटर पर डेटा को फ़िल्टर करता है जिस पर वह इंस्टॉल है।"},"num":85},{"id":"q86","q":{"en":"What is a simple match for hardware and software firewalls?","hi":"हार्डवेयर और सॉफ्टवेयर फ़ायरवॉल के लिए एक सरल मिलान (simple match) क्या है?"},"a":{"en":"Hardware/network firewall controls traffic between devices or networks. Software/host firewall can be implemented on an individual computer","hi":"हार्डवेयर/नेटवर्क फ़ायरवॉल उपकरणों या नेटवर्क के बीच ट्रैफ़िक को नियंत्रित करता है। सॉफ्टवेयर/होस्ट फ़ायरवॉल व्यक्तिगत कंप्यूटर पर लागू (implement) हो सकता है"},"o":[{"en":"Hardware/network firewall controls traffic between devices or networks. Software/host firewall can be implemented on an individual computer","hi":"हार्डवेयर/नेटवर्क फ़ायरवॉल उपकरणों या नेटवर्क के बीच ट्रैफ़िक को नियंत्रित करता है। सॉफ्टवेयर/होस्ट फ़ायरवॉल व्यक्तिगत कंप्यूटर पर लागू (implement) हो सकता है"},{"en":"Hardware firewall is for Mac, software is for Windows","hi":"हार्डवेयर फ़ायरवॉल मैक के लिए है, सॉफ्टवेयर विंडोज के लिए है"},{"en":"Hardware firewall is obsolete, software is new","hi":"हार्डवेयर फ़ायरवॉल अप्रचलित है, सॉफ्टवेयर नया है"},{"en":"There is no difference","hi":"कोई अंतर नहीं है"}],"exp":{"en":"A hardware firewall is a physical appliance guarding a network boundary. A software firewall is an application running on a user's operating system.","hi":"हार्डवेयर फ़ायरवॉल एक अलग डिवाइस होता है जो पूरे नेटवर्क को सुरक्षित करता है। सॉफ्टवेयर फ़ायरवॉल एक प्रोग्राम होता है जो आपके कंप्यूटर या लैपटॉप पर इंस्टॉल होता है।"},"num":86},{"id":"q87","q":{"en":"Is a firewall's main job to scan an already infected file?","hi":"क्या फ़ायरवॉल का मुख्य काम पहले से संक्रमित फाइल (infected file) को स्कैन करना है?"},"a":{"en":"No, the firewall's primary role is to filter network traffic. Scanning infected files is the role of an antivirus","hi":"नहीं, फ़ायरवॉल की प्राथमिक भूमिका (primary role) नेटवर्क ट्रैफ़िक को फ़िल्टर करना है। संक्रमित फाइलों को स्कैन करना एंटीवायरस का काम है"},"o":[{"en":"Yes, it scans all files on the hard drive","hi":"हां, यह हार्ड ड्राइव पर सभी फाइलों को स्कैन करता है"},{"en":"No, the firewall's primary role is to filter network traffic. Scanning infected files is the role of an antivirus","hi":"नहीं, फ़ायरवॉल की प्राथमिक भूमिका (primary role) नेटवर्क ट्रैफ़िक को फ़िल्टर करना है। संक्रमित फाइलों को स्कैन करना एंटीवायरस का काम है"},{"en":"Yes, firewalls are the same as antivirus","hi":"हां, फ़ायरवॉल एंटीवायरस के समान हैं"},{"en":"Yes, it deletes all files automatically","hi":"हां, यह सभी फाइलों को स्वचालित रूप से हटा देता है"}],"exp":{"en":"Firewalls block unauthorized traffic trying to enter or leave. If malicious code is already on your hard drive, it's the job of antivirus software to scan, detect, and remove it.","hi":"नहीं। फ़ायरवॉल दरवाज़े के गार्ड की तरह है जो केवल आने-जाने वाले ट्रैफ़िक को रोकता है। यदि वायरस पहले ही घर (हार्ड डिस्क) में घुस चुका है, तो उसे ढूँढने और निकालने का काम एंटीवायरस का है।"},"num":87},{"id":"q88","q":{"en":"What does Authentication verify?","hi":"ऑथेंटिकेशन (Authentication - प्रमाणीकरण) क्या सत्यापित (verify) करता है?"},"a":{"en":"A claimed identity. Passwords, OTPs, security keys, or biometrics are examples of authentication methods","hi":"एक दावा की गई पहचान (claimed identity)। पासवर्ड, ओटीपी, सुरक्षा कुंजी (security keys) या बायोमेट्रिक्स प्रमाणीकरण विधियों के उदाहरण हैं"},"o":[{"en":"The speed of the network","hi":"नेटवर्क की गति"},{"en":"A claimed identity. Passwords, OTPs, security keys, or biometrics are examples of authentication methods","hi":"एक दावा की गई पहचान (claimed identity)। पासवर्ड, ओटीपी, सुरक्षा कुंजी (security keys) या बायोमेट्रिक्स प्रमाणीकरण विधियों के उदाहरण हैं"},{"en":"The size of a downloaded file","hi":"डाउनलोड की गई फाइल का आकार"},{"en":"The physical location of a user","hi":"उपयोगकर्ता का भौतिक स्थान"}],"exp":{"en":"Authentication is the process of verifying that a user or device is who they claim to be, typically using credentials like passwords or fingerprints.","hi":"ऑथेंटिकेशन यह पक्का करता है कि जो यूज़र लॉगिन कर रहा है, वह असल में वही है या कोई और (जैसे पासवर्ड, OTP या फिंगरप्रिंट चेक करना)।"},"num":88},{"id":"q89","q":{"en":"What does Authorization verify or decide?","hi":"ऑथोराइजेशन (Authorization - प्राधिकरण) क्या सत्यापित या तय (decide) करता है?"},"a":{"en":"What resources an authenticated entity can access or actions they can perform. Roles and permissions are used in this decision","hi":"एक प्रमाणित इकाई (authenticated entity) किन संसाधनों (resources) तक पहुंच सकती है या कौन से कार्य कर सकती है। इस निर्णय में भूमिकाओं (Roles) और अनुमतियों (permissions) का उपयोग किया जाता है"},"o":[{"en":"The time zone of the server","hi":"सर्वर का समय क्षेत्र (time zone)"},{"en":"What resources an authenticated entity can access or actions they can perform. Roles and permissions are used in this decision","hi":"एक प्रमाणित इकाई (authenticated entity) किन संसाधनों (resources) तक पहुंच सकती है या कौन से कार्य कर सकती है। इस निर्णय में भूमिकाओं (Roles) और अनुमतियों (permissions) का उपयोग किया जाता है"},{"en":"The user's password","hi":"उपयोगकर्ता का पासवर्ड"},{"en":"The IP address of the router","hi":"राउटर का आईपी एड्रेस"}],"exp":{"en":"Authorization occurs after authentication and determines the level of access or privileges the user has (e.g., standard user vs. administrator).","hi":"ऑथोराइजेशन यह तय करता है कि एक बार लॉगिन (प्रमाणित) हो जाने के बाद, यूज़र को कौन सी फाइलें देखने या कौन सा काम करने की अनुमति (परमिशन) है।"},"num":89},{"id":"q90","q":{"en":"What is a one-line comparison of Authentication vs Authorization?","hi":"ऑथेंटिकेशन बनाम ऑथोराइजेशन का एक-लाइन में तुलना (one-line comparison) क्या है?"},"a":{"en":"Authentication → 'Who are you?' Authorization → 'What can you do?'","hi":"ऑथेंटिकेशन → 'आप कौन हैं?' (Who are you?) ऑथोराइजेशन → 'आप क्या कर सकते हैं?' (What can you do?)"},"o":[{"en":"Authentication → What can you do? Authorization → Who are you?","hi":"ऑथेंटिकेशन → आप क्या कर सकते हैं? ऑथोराइजेशन → आप कौन हैं?"},{"en":"Authentication → 'Who are you?' Authorization → 'What can you do?'","hi":"ऑथेंटिकेशन → 'आप कौन हैं?' (Who are you?) ऑथोराइजेशन → 'आप क्या कर सकते हैं?' (What can you do?)"},{"en":"Both mean 'Who are you?'","hi":"दोनों का अर्थ है 'आप कौन हैं?'"},{"en":"Both are hardware devices","hi":"दोनों हार्डवेयर डिवाइस हैं"}],"exp":{"en":"For exams: Authentication verifies identity ('Who are you?'). Authorization verifies permissions ('What are you allowed to do?').","hi":"परीक्षा के लिए याद रखें: ऑथेंटिकेशन का मतलब है पहचानना (आप कौन हैं?)। ऑथोराइजेशन का मतलब है अनुमति देना (आपको क्या करने की इजाज़त है?)।"},"num":90},{"id":"q91","q":{"en":"A login is successful, but the admin page is blocked. Which control was applied?","hi":"लॉगिन सफल (successful) है, लेकिन एडमिन पेज ब्लॉक है। यहाँ कौन सा नियंत्रण (control) लागू हुआ?"},"a":{"en":"Identity was authenticated, but authorization for the admin page is missing","hi":"पहचान प्रमाणित (authenticated) हो गई थी। एडमिन पेज के लिए प्राधिकरण (authorization) गायब है"},"o":[{"en":"Firewall blocked the login","hi":"फ़ायरवॉल ने लॉगिन को ब्लॉक कर दिया"},{"en":"Authentication failed","hi":"प्रमाणीकरण (Authentication) विफल रहा"},{"en":"Identity was authenticated, but authorization for the admin page is missing","hi":"पहचान प्रमाणित (authenticated) हो गई थी। एडमिन पेज के लिए प्राधिकरण (authorization) गायब है"},{"en":"The server crashed","hi":"सर्वर क्रैश हो गया"}],"exp":{"en":"The successful login proves identity (Authentication succeeded). Being denied access to the admin page proves lack of privileges (Authorization denied).","hi":"लॉगिन होना मतलब आपकी पहचान सही है (ऑथेंटिकेशन सफल)। एडमिन पेज न खुलना मतलब आपको वह पेज देखने का अधिकार नहीं है (ऑथोराइजेशन विफल)।"},"num":91},{"id":"q92","q":{"en":"What does an antivirus do?","hi":"एंटीवायरस (Antivirus) क्या करता है?"},"a":{"en":"It helps prevent, detect, quarantine, or remove viruses, worms, Trojans, and other malware","hi":"यह वायरस, वर्म, ट्रोजन और अन्य मैलवेयर को रोकने, पता लगाने (detect), क्वारंटाइन (quarantine) करने या हटाने में मदद करता है"},"o":[{"en":"It speeds up the internet connection","hi":"यह इंटरनेट कनेक्शन को तेज करता है"},{"en":"It helps prevent, detect, quarantine, or remove viruses, worms, Trojans, and other malware","hi":"यह वायरस, वर्म, ट्रोजन और अन्य मैलवेयर को रोकने, पता लगाने (detect), क्वारंटाइन (quarantine) करने या हटाने में मदद करता है"},{"en":"It backs up data to the cloud","hi":"यह क्लाउड में डेटा का बैकअप लेता है"},{"en":"It blocks all network traffic","hi":"यह सभी नेटवर्क ट्रैफ़िक को ब्लॉक करता है"}],"exp":{"en":"Antivirus software actively monitors a system for malicious files and activity, stopping infections before they happen or cleaning them up afterward.","hi":"एंटीवायरस एक सॉफ़्टवेयर है जो कंप्यूटर में वायरस, वर्म, ट्रोजन और अन्य खतरनाक मैलवेयर को आने से रोकता है, उन्हें ढूँढता है, और हटाता (डिलीट) है।"},"num":92},{"id":"q93","q":{"en":"What is the overlap between antivirus and antimalware?","hi":"एंटीवायरस और एंटीमैलवेयर के बीच क्या समानता (overlap) है?"},"a":{"en":"Modern antivirus products detect many malware families besides viruses. Antimalware is a broader defensive term","hi":"आधुनिक एंटीवायरस उत्पाद वायरस के अलावा कई मैलवेयर परिवारों (malware families) का पता लगाते हैं। एंटीमैलवेयर एक व्यापक रक्षात्मक शब्द (broader defensive term) है"},"o":[{"en":"Antivirus only stops physical viruses","hi":"एंटीवायरस केवल भौतिक वायरस को रोकता है"},{"en":"Antivirus is for Mac, antimalware is for Windows","hi":"एंटीवायरस मैक के लिए है, एंटीमैलवेयर विंडोज के लिए है"},{"en":"Modern antivirus products detect many malware families besides viruses. Antimalware is a broader defensive term","hi":"आधुनिक एंटीवायरस उत्पाद वायरस के अलावा कई मैलवेयर परिवारों (malware families) का पता लगाते हैं। एंटीमैलवेयर एक व्यापक रक्षात्मक शब्द (broader defensive term) है"},{"en":"There is no overlap","hi":"कोई समानता नहीं है"}],"exp":{"en":"Historically, 'antivirus' only looked for viruses. Today, almost all modern antivirus software functions as comprehensive antimalware, detecting ransomware, spyware, etc.","hi":"शुरुआत में एंटीवायरस केवल 'वायरस' पकड़ते थे। आज के आधुनिक एंटीवायरस लगभग सभी प्रकार के मैलवेयर (जैसे रैंसमवेयर, स्पाईवेयर) पकड़ सकते हैं, इसलिए अब एंटीवायरस और एंटीमैलवेयर का काम लगभग एक ही है।"},"num":93},{"id":"q94","q":{"en":"What is the meaning of Quarantine?","hi":"क्वारंटाइन (Quarantine) का क्या अर्थ है?"},"a":{"en":"Isolating a suspicious file so it cannot execute or spread in normal files or the system","hi":"किसी संदिग्ध फाइल (suspicious file) को अलग (isolate) करना, ताकि वह सामान्य फाइलों या सिस्टम में निष्पादित (execute) या फैल (spread) न सके"},"o":[{"en":"Deleting a file immediately","hi":"किसी फाइल को तुरंत हटाना"},{"en":"Isolating a suspicious file so it cannot execute or spread in normal files or the system","hi":"किसी संदिग्ध फाइल (suspicious file) को अलग (isolate) करना, ताकि वह सामान्य फाइलों या सिस्टम में निष्पादित (execute) या फैल (spread) न सके"},{"en":"Sending the file to the government","hi":"फाइल को सरकार को भेजना"},{"en":"Encrypting the file for safety","hi":"सुरक्षा के लिए फाइल को एन्क्रिप्ट करना"}],"exp":{"en":"When an antivirus quarantines a file, it moves it to a secure, isolated folder where the malware cannot run or harm the operating system.","hi":"क्वारंटाइन (Quarantine) का मतलब है किसी संदिग्ध (खतरनाक) फाइल को कंप्यूटर में एक सुरक्षित और अलग जगह पर कैद कर देना, ताकि वह फाइल रन न हो सके और कंप्यूटर को नुकसान न पहुँचा सके।"},"num":94},{"id":"q95","q":{"en":"What is the short match for Antivirus and Firewall?","hi":"एंटीवायरस और फ़ायरवॉल के लिए संक्षिप्त मिलान (short match) क्या है?"},"a":{"en":"Antivirus focuses on malware/file/activity detection. Firewall enforces network traffic policy","hi":"एंटीवायरस मैलवेयर/फाइल/गतिविधि का पता लगाने (detection) पर फोकस करता है। फ़ायरवॉल नेटवर्क ट्रैफ़िक नीति (network traffic policy) लागू करता है"},"o":[{"en":"Antivirus blocks IP addresses. Firewall removes malware","hi":"एंटीवायरस आईपी एड्रेस को ब्लॉक करता है। फ़ायरवॉल मैलवेयर को हटाता है"},{"en":"Antivirus focuses on malware/file/activity detection. Firewall enforces network traffic policy","hi":"एंटीवायरस मैलवेयर/फाइल/गतिविधि का पता लगाने (detection) पर फोकस करता है। फ़ायरवॉल नेटवर्क ट्रैफ़िक नीति (network traffic policy) लागू करता है"},{"en":"Both do exactly the same thing","hi":"दोनों बिल्कुल एक ही काम करते हैं"},{"en":"Antivirus is hardware, firewall is software","hi":"एंटीवायरस हार्डवेयर है, फ़ायरवॉल सॉफ्टवेयर है"}],"exp":{"en":"Antivirus inspects the content (files) on your computer. A firewall acts as a security guard at the door, inspecting the network traffic trying to get in or out.","hi":"एंटीवायरस कंप्यूटर के अंदर मौजूद फाइलों और मैलवेयर की जाँच करता है। फ़ायरवॉल कंप्यूटर और इंटरनेट के बीच आने-जाने वाले डेटा (ट्रैफ़िक) के नियमों को लागू करता है।"},"num":95},{"id":"q96","q":{"en":"What are the examples of antivirus in the DOCX?","hi":"DOCX में एंटीवायरस के उदाहरण कौन से हैं?"},"a":{"en":"Norton, McAfee, Kaspersky, Avast, Quick Heal, AVG, Bitdefender, Microsoft Defender Antivirus, Avira, and ESET NOD32","hi":"नॉर्टन, मैकेफी, कैस्परस्की, अवास्ट, क्विक हील, एवीजी, बिटडिफेंडर, माइक्रोसॉफ्ट डिफेंडर एंटीवायरस, अवीरा और ईएसईटी एनओडी32"},"o":[{"en":"Word, Excel, PowerPoint, Access","hi":"Word, Excel, PowerPoint, Access"},{"en":"Chrome, Firefox, Safari, Edge","hi":"Chrome, Firefox, Safari, Edge"},{"en":"Norton, McAfee, Kaspersky, Avast, Quick Heal, AVG, Bitdefender, Microsoft Defender Antivirus, Avira, and ESET NOD32","hi":"नॉर्टन, मैकेफी, कैस्परस्की, अवास्ट, क्विक हील, एवीजी, बिटडिफेंडर, माइक्रोसॉफ्ट डिफेंडर एंटीवायरस, अवीरा और ईएसईटी एनओडी32"},{"en":"Windows, Linux, macOS, Android","hi":"Windows, Linux, macOS, Android"}],"exp":{"en":"These are well-known commercial and built-in software brands that provide antivirus and comprehensive antimalware protection.","hi":"कंप्यूटर परीक्षा में अक्सर एंटीवायरस सॉफ़्टवेयर के नाम पूछे जाते हैं, जैसे: McAfee, Norton, Kaspersky, Avast, Quick Heal आदि। ये सभी लोकप्रिय एंटीवायरस हैं।"},"num":96},{"id":"q97","q":{"en":"What is the current product name for Windows' built-in antivirus?","hi":"विंडोज के अंतर्निहित (built-in) एंटीवायरस का वर्तमान उत्पाद नाम (product name) क्या है?"},"a":{"en":"Microsoft Defender Antivirus. The notes give the name as Windows Defender","hi":"माइक्रोसॉफ्ट डिफेंडर एंटीवायरस। नोट्स में विंडोज डिफेंडर (Windows Defender) नाम दिया गया है"},"o":[{"en":"Windows Security Center","hi":"विंडोज सिक्योरिटी सेंटर"},{"en":"Microsoft Defender Antivirus. The notes give the name as Windows Defender","hi":"माइक्रोसॉफ्ट डिफेंडर एंटीवायरस। नोट्स में विंडोज डिफेंडर (Windows Defender) नाम दिया गया है"},{"en":"Microsoft Security Essentials","hi":"माइक्रोसॉफ्ट सिक्योरिटी एसेंशियल्स"},{"en":"Windows Antimalware","hi":"विंडोज एंटीमैलवेयर"}],"exp":{"en":"Previously known as Windows Defender, Microsoft's native antivirus solution is now officially branded as Microsoft Defender Antivirus.","hi":"विंडोज़ ऑपरेटिंग सिस्टम (Windows 10/11) में पहले से इंस्टॉल होकर आने वाले एंटीवायरस का नाम 'माइक्रोसॉफ्ट डिफेंडर एंटीवायरस' (पुराना नाम: विंडोज डिफेंडर) है।"},"num":97}]},{"title":{"en":"9. Exam Trap Reverse-Questions","hi":"9. परीक्षा के महत्वपूर्ण उल्टे प्रश्न"},"questions":[{"id":"q98","q":{"en":"[Reverse] Data theft, data tampering, and server downtime match which CIA goals?","hi":"[रिवर्स] डेटा चोरी, डेटा से छेड़छाड़ (tampering) और सर्वर डाउनटाइम CIA के किन लक्ष्यों से मेल खाते हैं?"},"a":{"en":"Confidentiality, integrity, and availability respectively","hi":"क्रमशः कॉन्फिडेंशियलिटी, इंटीग्रिटी और अवेलेबिलिटी"},"o":[{"en":"Availability, Integrity, and Confidentiality","hi":"अवेलेबिलिटी, इंटीग्रिटी और कॉन्फिडेंशियलिटी"},{"en":"Confidentiality, integrity, and availability respectively","hi":"क्रमशः कॉन्फिडेंशियलिटी, इंटीग्रिटी और अवेलेबिलिटी"},{"en":"Integrity, Availability, and Confidentiality","hi":"इंटीग्रिटी, अवेलेबिलिटी और कॉन्फिडेंशियलिटी"},{"en":"All three affect Confidentiality","hi":"तीनों कॉन्फिडेंशियलिटी को प्रभावित करते हैं"}],"exp":{"en":"Theft breaks confidentiality, tampering breaks integrity, and downtime breaks availability.","hi":"डेटा चोरी होना (Confidentiality टूटना), डेटा में छेड़छाड़ होना (Integrity टूटना), और सर्वर डाउन होना (Availability टूटना)।"},"num":98},{"id":"q99","q":{"en":"[Reverse] Incident response, national coordination, and botnet cleaning match which agencies?","hi":"[रिवर्स] घटना प्रतिक्रिया (Incident response), राष्ट्रीय समन्वय (national coordination) और बॉटनेट क्लीनिंग किन एजेंसियों से मेल खाते हैं?"},"a":{"en":"CERT-In, NCSC, and Cyber Swachhta Kendra","hi":"CERT-In, NCSC, और साइबर स्वच्छता केंद्र"},"o":[{"en":"CERT-In, NCSC, and Cyber Swachhta Kendra","hi":"CERT-In, NCSC, और साइबर स्वच्छता केंद्र"},{"en":"NCSC, CERT-In, and Cyber Swachhta Kendra","hi":"NCSC, CERT-In, और साइबर स्वच्छता केंद्र"},{"en":"Cyber Swachhta Kendra, CERT-In, and NCSC","hi":"साइबर स्वच्छता केंद्र, CERT-In, और NCSC"},{"en":"CERT-In, Cyber Swachhta Kendra, and NCSC","hi":"CERT-In, साइबर स्वच्छता केंद्र, और NCSC"}],"exp":{"en":"CERT-In is incident response. NCSC is national coordination. Cyber Swachhta Kendra handles botnets and malware.","hi":"साइबर घटनाओं पर प्रतिक्रिया = CERT-In; राष्ट्रीय समन्वय = NCSC; बॉटनेट और मैलवेयर सफाई = साइबर स्वच्छता केंद्र।"},"num":99},{"id":"q100","q":{"en":"[Reverse] What is attached to a host file vs independently spreads on a network?","hi":"[रिवर्स] होस्ट फाइल से जुड़ा हुआ (attached) बनाम स्वतंत्र रूप से (independently) नेटवर्क पर फैलने वाला मैलवेयर कौन सा है?"},"a":{"en":"Virus vs worm","hi":"वायरस बनाम वर्म"},"o":[{"en":"Worm vs Virus","hi":"वर्म बनाम वायरस"},{"en":"Trojan vs Spyware","hi":"ट्रोजन बनाम स्पाईवेयर"},{"en":"Virus vs worm","hi":"वायरस बनाम वर्म"},{"en":"Rootkit vs Adware","hi":"रूटकिट बनाम एडवेयर"}],"exp":{"en":"A virus requires a host file and user action to spread. A worm replicates autonomously over networks.","hi":"जो फाइल (Host) से जुड़कर फैले वह 'वायरस' है। जो बिना फाइल के नेटवर्क पर अपने आप फैले वह 'वर्म' है।"},"num":100},{"id":"q101","q":{"en":"[Reverse] What is the difference between storage WORM and malware worm?","hi":"[रिवर्स] स्टोरेज WORM और मैलवेयर वर्म (malware worm) के बीच क्या अंतर है?"},"a":{"en":"Storage WORM means Write Once, Read Many. Malware worm independently self-replicates and spreads","hi":"स्टोरेज WORM का अर्थ है 'राइट वन्स, रीड मेनी' (Write Once, Read Many)। मैलवेयर वर्म स्वतंत्र रूप से सेल्फ-रेप्लिकेट करता है और फैलता है"},"o":[{"en":"Both mean the same thing","hi":"दोनों का मतलब एक ही है"},{"en":"Storage WORM means Write Once, Read Many. Malware worm independently self-replicates and spreads","hi":"स्टोरेज WORM का अर्थ है 'राइट वन्स, रीड मेनी' (Write Once, Read Many)। मैलवेयर वर्म स्वतंत्र रूप से सेल्फ-रेप्लिकेट करता है और फैलता है"},{"en":"Storage WORM is a virus, malware worm is a hard drive","hi":"स्टोरेज WORM एक वायरस है, मैलवेयर वर्म एक हार्ड ड्राइव है"},{"en":"Storage WORM is for Macs, malware worm is for PCs","hi":"स्टोरेज WORM मैक के लिए है, मैलवेयर वर्म पीसी के लिए है"}],"exp":{"en":"WORM in hardware refers to write-once optical media. A malware worm is a self-propagating malicious program.","hi":"हार्डवेयर में WORM का मतलब है CD-R जैसी डिस्क (Write Once, Read Many)। जबकि साइबर सुरक्षा में 'वर्म' एक खतरनाक वायरस (मैलवेयर) है।"},"num":101},{"id":"q102","q":{"en":"[Reverse] What virus infects both the boot area and program files?","hi":"[रिवर्स] बूट एरिया और प्रोग्राम फाइलों दोनों को संक्रमित करने वाला वायरस कौन सा है?"},"a":{"en":"Multipartite virus","hi":"मल्टीपार्टाइट वायरस"},"o":[{"en":"Macro virus","hi":"मैक्रो वायरस"},{"en":"Stealth virus","hi":"स्टेल्थ वायरस"},{"en":"Multipartite virus","hi":"मल्टीपार्टाइट वायरस"},{"en":"Polymorphic virus","hi":"पॉलीमॉर्फिक वायरस"}],"exp":{"en":"A multipartite virus uses multiple attack vectors (both boot sector and executable files) simultaneously.","hi":"जो वायरस कंप्यूटर के बूट सेक्टर (स्टार्टअप एरिया) और प्रोग्राम फाइलों दोनों पर एक साथ हमला करता है, उसे मल्टीपार्टाइट (Multipartite) वायरस कहते हैं।"},"num":102},{"id":"q103","q":{"en":"[Reverse] What virus fits its code into the unused space of a file?","hi":"[रिवर्स] किसी फाइल के अप्रयुक्त स्थान (unused space) में अपना कोड फिट करने वाला वायरस कौन सा है?"},"a":{"en":"Cavity/space-filler virus","hi":"कैविटी/स्पेस-फिलर वायरस"},"o":[{"en":"Cluster virus","hi":"क्लस्टर वायरस"},{"en":"Tunnelling virus","hi":"टनलिंग वायरस"},{"en":"Cavity/space-filler virus","hi":"कैविटी/स्पेस-फिलर वायरस"},{"en":"Boot-sector virus","hi":"बूट-सेक्टर वायरस"}],"exp":{"en":"A cavity (or space-filler) virus avoids detection by hiding its payload in the empty sections of a host file.","hi":"कैविटी (Cavity) या स्पेस-फिलर वायरस प्रोग्राम फाइल की खाली जगह में छिप जाता है, जिससे फाइल का साइज़ नहीं बढ़ता।"},"num":103},{"id":"q104","q":{"en":"[Reverse] What virus changes its appearance in every copy?","hi":"[रिवर्स] हर कॉपी (प्रतिलिपि) में अपनी उपस्थिति (appearance) बदलने वाला वायरस कौन सा है?"},"a":{"en":"Polymorphic virus","hi":"पॉलीमॉर्फिक वायरस"},"o":[{"en":"Polymorphic virus","hi":"पॉलीमॉर्फिक वायरस"},{"en":"Macro virus","hi":"मैक्रो वायरस"},{"en":"Stealth virus","hi":"स्टेल्थ वायरस"},{"en":"Cluster virus","hi":"क्लस्टर वायरस"}],"exp":{"en":"A polymorphic virus mutates or encrypts its code differently with each infection to evade signature-based detection.","hi":"पॉलीमॉर्फिक (Polymorphic) वायरस हर बार खुद को कॉपी करते समय अपना कोड या रूप बदल लेता है ताकि एंटीवायरस उसे पकड़ न सके।"},"num":104},{"id":"q105","q":{"en":"[Reverse] What is the combination of a useful software disguise and hidden access?","hi":"[रिवर्स] उपयोगी सॉफ्टवेयर के भेष (disguise) और छिपी हुई पहुंच (hidden access) का संयोजन क्या है?"},"a":{"en":"Trojan, which can install a backdoor","hi":"ट्रोजन, जो बैकडोर (backdoor) स्थापित कर सकता है"},"o":[{"en":"Spyware","hi":"स्पाईवेयर"},{"en":"Worm","hi":"वर्म"},{"en":"Trojan, which can install a backdoor","hi":"ट्रोजन, जो बैकडोर (backdoor) स्थापित कर सकता है"},{"en":"Ransomware","hi":"रैंसमवेयर"}],"exp":{"en":"A Trojan masquerades as legitimate software and often drops a backdoor (RAT) as its payload.","hi":"ट्रोजन हॉर्स (Trojan) अच्छे और उपयोगी सॉफ्टवेयर का भेष बनाकर आता है और कंप्यूटर में एक चोर दरवाज़ा (Backdoor) खोल देता है।"},"num":105},{"id":"q106","q":{"en":"[Reverse] What is the difference between capturing keystrokes and broader secret monitoring?","hi":"[रिवर्स] कीस्ट्रोक कैप्चर करने और व्यापक गुप्त निगरानी (secret monitoring) के बीच क्या अंतर है?"},"a":{"en":"Keylogger vs spyware","hi":"कीलॉगर बनाम स्पाईवेयर"},"o":[{"en":"Keylogger vs spyware","hi":"कीलॉगर बनाम स्पाईवेयर"},{"en":"Trojan vs worm","hi":"ट्रोजन बनाम वर्म"},{"en":"Ransomware vs adware","hi":"रैंसमवेयर बनाम एडवेयर"},{"en":"Rootkit vs backdoor","hi":"रूटकिट बनाम बैकडोर"}],"exp":{"en":"A keylogger specifically records keyboard input. Spyware is a broader category that includes monitoring browsing habits and screen activity.","hi":"कीलॉगर केवल कीबोर्ड पर टाइप की गई जानकारी को रिकॉर्ड करता है, जबकि स्पाईवेयर एक बड़ी श्रेणी है जो आपकी स्क्रीन, ब्राउज़िंग और अन्य गतिविधियां भी ट्रैक कर सकता है।"},"num":106},{"id":"q107","q":{"en":"[Reverse] What is a date condition trigger vs a ransom demand?","hi":"[रिवर्स] डेट कंडीशन ट्रिगर (तारीख की शर्त) बनाम फिरौती की मांग (ransom demand) क्या है?"},"a":{"en":"Logic bomb vs ransomware","hi":"लॉजिक बॉम्ब बनाम रैंसमवेयर"},"o":[{"en":"Worm vs Trojan","hi":"वर्म बनाम ट्रोजन"},{"en":"Adware vs Spyware","hi":"एडवेयर बनाम स्पाईवेयर"},{"en":"Logic bomb vs ransomware","hi":"लॉजिक बॉम्ब बनाम रैंसमवेयर"},{"en":"Rootkit vs Keylogger","hi":"रूटकिट बनाम कीलॉगर"}],"exp":{"en":"A logic bomb triggers when a condition (like a date) is met. Ransomware locks data and demands payment.","hi":"लॉजिक बॉम्ब किसी खास तारीख या शर्त पर हमला करता है, जबकि रैंसमवेयर फाइलों को लॉक करके पैसे (फिरौती) मांगता है।"},"num":107},{"id":"q108","q":{"en":"[Reverse] What is the common hat label for making an unauthorized assessment to disclose a flaw?","hi":"[रिवर्स] खामी (flaw) को उजागर (disclose) करने के लिए अनधिकृत मूल्यांकन (unauthorized assessment) करने का सामान्य हैट लेबल क्या है?"},"a":{"en":"Grey hat. Disclosure does not replace permission","hi":"ग्रे हैट। प्रकटीकरण (Disclosure), अनुमति (permission) की जगह नहीं लेता है"},"o":[{"en":"White hat","hi":"व्हाइट हैट"},{"en":"Black hat","hi":"ब्लैक हैट"},{"en":"Grey hat. Disclosure does not replace permission","hi":"ग्रे हैट। प्रकटीकरण (Disclosure), अनुमति (permission) की जगह नहीं लेता है"},{"en":"Red hat","hi":"रेड हैट"}],"exp":{"en":"A grey hat hacker breaks into systems without permission (illegal) but usually with the intent to notify the owner, not to cause harm.","hi":"ग्रे हैट हैकर बिना अनुमति के सुरक्षा तोड़ता है (जो गलत है), लेकिन उसका इरादा नुकसान पहुँचाना नहीं होता, वह कंपनी को उसकी खामी के बारे में बता देता है।"},"num":108},{"id":"q109","q":{"en":"[Reverse] What is a fake login page vs a false source address?","hi":"[रिवर्स] फर्जी लॉगिन पेज बनाम झूठा स्रोत पता (false source address) क्या है?"},"a":{"en":"Phishing vs spoofing","hi":"फ़िशिंग बनाम स्पूफिंग"},"o":[{"en":"Phishing vs spoofing","hi":"फ़िशिंग बनाम स्पूफिंग"},{"en":"Spoofing vs sniffing","hi":"स्पूफिंग बनाम स्निफ़िंग"},{"en":"Sniffing vs snooping","hi":"स्निफ़िंग बनाम स्नूपिंग"},{"en":"Ransomware vs adware","hi":"रैंसमवेयर बनाम एडवेयर"}],"exp":{"en":"A fake login page is phishing (deceiving the user). A false source IP or MAC address is spoofing (technical impersonation).","hi":"फर्जी वेबसाइट बनाकर इंसान को धोखा देना 'फ़िशिंग' है। जबकि नकली IP या MAC एड्रेस बनाकर तकनीकी रूप से पहचान छिपाना 'स्पूफिंग' है।"},"num":109},{"id":"q110","q":{"en":"[Reverse] What matches traffic capture, secret inspection, and traffic filtering?","hi":"[रिवर्स] ट्रैफ़िक कैप्चर, गुप्त निरीक्षण (secret inspection) और ट्रैफ़िक फ़िल्टरिंग का मिलान क्या है?"},"a":{"en":"Packet sniffing, snooping, and firewall","hi":"पैकेट स्निफ़िंग, स्नूपिंग और फ़ायरवॉल"},"o":[{"en":"Firewall, antivirus, and VPN","hi":"फ़ायरवॉल, एंटीवायरस और वीपीएन"},{"en":"Packet sniffing, snooping, and firewall","hi":"पैकेट स्निफ़िंग, स्नूपिंग और फ़ायरवॉल"},{"en":"Phishing, spoofing, and sniffing","hi":"फ़िशिंग, स्पूफिंग और स्निफ़िंग"},{"en":"Router, switch, and hub","hi":"राउटर, स्विच और हब"}],"exp":{"en":"Capturing packets = sniffing. Covertly inspecting data = snooping. Blocking/allowing traffic based on rules = firewall.","hi":"नेटवर्क के डेटा को पकड़ना = पैकेट स्निफ़िंग; डेटा को चुपके से जासूसी करके पढ़ना = स्नूपिंग; और डेटा को सुरक्षा नियमों के आधार पर रोकना या आने देना = फ़ायरवॉल।"},"num":110},{"id":"q111","q":{"en":"[Reverse] What is the match for login credentials vs file permissions?","hi":"[रिवर्स] लॉगिन क्रेडेंशियल्स (पासवर्ड आदि) बनाम फाइल अनुमतियों (file permissions) के लिए क्या मिलान है?"},"a":{"en":"Authentication vs authorization","hi":"ऑथेंटिकेशन बनाम ऑथोराइजेशन"},"o":[{"en":"Firewall vs Antivirus","hi":"फ़ायरवॉल बनाम एंटीवायरस"},{"en":"Encryption vs Decryption","hi":"एन्क्रिप्शन बनाम डिक्रिप्शन"},{"en":"Authentication vs authorization","hi":"ऑथेंटिकेशन बनाम ऑथोराइजेशन"},{"en":"Public key vs Private key","hi":"पब्लिक की (key) बनाम प्राइवेट की"}],"exp":{"en":"Login credentials prove identity (Authentication). File permissions dictate access rights (Authorization).","hi":"पासवर्ड से लॉगिन करना 'ऑथेंटिकेशन' (पहचान साबित करना) है। लॉगिन होने के बाद फाइल देखने या बदलने की अनुमति होना 'ऑथोराइजेशन' (अधिकार) है।"},"num":111},{"id":"q112","q":{"en":"[Reverse] What is the match for network rules and malware scanning?","hi":"[रिवर्स] फ़ायरवॉल और एंटीवायरस में, नेटवर्क नियमों और मैलवेयर स्कैनिंग का मिलान क्या है?"},"a":{"en":"Firewall network traffic rules. Antivirus malware scanning/detection","hi":"फ़ायरवॉल नेटवर्क ट्रैफ़िक नियम (rules)। एंटीवायरस मैलवेयर स्कैनिंग/डिटेक्शन"},"o":[{"en":"Firewall network traffic rules. Antivirus malware scanning/detection","hi":"फ़ायरवॉल नेटवर्क ट्रैफ़िक नियम (rules)। एंटीवायरस मैलवेयर स्कैनिंग/डिटेक्शन"},{"en":"Firewall scans for viruses, antivirus controls traffic","hi":"फ़ायरवॉल वायरस के लिए स्कैन करता है, एंटीवायरस ट्रैफ़िक को नियंत्रित करता है"},{"en":"Both apply network rules","hi":"दोनों नेटवर्क नियम लागू करते हैं"},{"en":"Both scan for malware","hi":"दोनों मैलवेयर के लिए स्कैन करते हैं"}],"exp":{"en":"A firewall inspects and controls traffic at the network perimeter. Antivirus scans internal files for malicious code.","hi":"फ़ायरवॉल नेटवर्क के अंदर आने और जाने वाले डेटा (ट्रैफ़िक) के नियमों को लागू करता है। एंटीवायरस कंप्यूटर के अंदर फाइलों में वायरस और मैलवेयर को ढूँढता (स्कैन करता) है।"},"num":112}]},{"title":{"en":"10. Rapid-Fire Final Revision","hi":"10. त्वरित अंतिम पुनरावृत्ति"},"questions":[{"id":"q113","q":{"en":"What is the CIA triad?","hi":"CIA ट्रायड क्या है?"},"a":{"en":"Confidentiality, Integrity, Availability","hi":"कॉन्फिडेंशियलिटी, इंटीग्रिटी, अवेलेबिलिटी"},"o":[{"en":"Central Intelligence Agency","hi":"सेंट्रल इंटेलिजेंस एजेंसी"},{"en":"Confidentiality, Integrity, Availability","hi":"कॉन्फिडेंशियलिटी, इंटीग्रिटी, अवेलेबिलिटी"},{"en":"Cyber, Information, Access","hi":"साइबर, इन्फॉर्मेशन, एक्सेस"},{"en":"Computer, Internet, Architecture","hi":"कंप्यूटर, इंटरनेट, आर्किटेक्चर"}],"exp":{"en":"The core pillars of information security.","hi":"सूचना सुरक्षा के तीन मुख्य स्तंभ: गोपनीयता, अखंडता और उपलब्धता।"},"num":113},{"id":"q114","q":{"en":"What is a potential danger in cybersecurity?","hi":"साइबर सुरक्षा में संभावित खतरा (Potential danger) क्या कहलाता है?"},"a":{"en":"Threat","hi":"थ्रेट"},"o":[{"en":"Vulnerability","hi":"वल्नरेबिलिटी"},{"en":"Malware","hi":"मैलवेयर"},{"en":"Threat","hi":"थ्रेट"},{"en":"Firewall","hi":"फ़ायरवॉल"}],"exp":{"en":"A threat is any potential event or actor that could cause harm.","hi":"थ्रेट (खतरा) कोई भी ऐसा व्यक्ति या घटना है जो नुकसान पहुँचा सकता है।"},"num":114},{"id":"q115","q":{"en":"What is an exploitable weakness?","hi":"शोषण योग्य कमजोरी (Exploitable weakness) क्या कहलाती है?"},"a":{"en":"Vulnerability","hi":"वल्नरेबिलिटी"},"o":[{"en":"Threat","hi":"थ्रेट"},{"en":"Vulnerability","hi":"वल्नरेबिलिटी"},{"en":"Risk","hi":"रिस्क"},{"en":"Bug","hi":"बग"}],"exp":{"en":"A vulnerability is a flaw that a threat can exploit.","hi":"वल्नरेबिलिटी (खामी) वह कमजोरी है जिसका फायदा उठाकर हमलावर सिस्टम में घुस सकता है।"},"num":115},{"id":"q116","q":{"en":"Which statutory section designates CERT-In?","hi":"कौन सी वैधानिक धारा (statutory section) CERT-In को नामित करती है?"},"a":{"en":"IT Act Section 70B","hi":"IT एक्ट धारा 70B"},"o":[{"en":"IT Act Section 66A","hi":"IT एक्ट धारा 66A"},{"en":"IT Act Section 70B","hi":"IT एक्ट धारा 70B"},{"en":"IT Act Section 43","hi":"IT एक्ट धारा 43"},{"en":"IT Act Section 69","hi":"IT एक्ट धारा 69"}],"exp":{"en":"CERT-In operates under Section 70B of the Information Technology Act, 2000.","hi":"CERT-In सूचना प्रौद्योगिकी अधिनियम की धारा 70B के तहत कार्य करता है।"},"num":116},{"id":"q117","q":{"en":"In what year was the National Cyber Security Policy introduced?","hi":"राष्ट्रीय साइबर सुरक्षा नीति (National Cyber Security Policy) किस वर्ष शुरू की गई थी?"},"a":{"en":"2013","hi":"2013"},"o":[{"en":"2000","hi":"2000"},{"en":"2013","hi":"2013"},{"en":"2018","hi":"2018"},{"en":"2021","hi":"2021"}],"exp":{"en":"The National Cyber Security Policy was framed in 2013.","hi":"राष्ट्रीय साइबर सुरक्षा नीति 2013 में लागू की गई थी।"},"num":117},{"id":"q118","q":{"en":"What is the Botnet Cleaning and Malware Analysis Centre initiative?","hi":"बॉटनेट क्लीनिंग और मैलवेयर एनालिसिस सेंटर पहल क्या है?"},"a":{"en":"Cyber Swachhta Kendra","hi":"साइबर स्वच्छता केंद्र"},"o":[{"en":"CCPWC","hi":"CCPWC"},{"en":"Cyber Swachhta Kendra","hi":"साइबर स्वच्छता केंद्र"},{"en":"NCSC","hi":"NCSC"},{"en":"CERT-In","hi":"CERT-In"}],"exp":{"en":"The Cyber Swachhta Kendra provides tools to remove malware and botnet infections.","hi":"साइबर स्वच्छता केंद्र कंप्यूटर से मैलवेयर और बॉटनेट हटाने के लिए मुफ़्त टूल देता है।"},"num":118},{"id":"q119","q":{"en":"What type of infection targets executable files?","hi":"किस प्रकार का संक्रमण निष्पादन योग्य फाइलों (executable files) को लक्षित करता है?"},"a":{"en":"File virus","hi":"फाइल वायरस"},"o":[{"en":"Macro virus","hi":"मैक्रो वायरस"},{"en":"Boot-sector virus","hi":"बूट-सेक्टर वायरस"},{"en":"File virus","hi":"फाइल वायरस"},{"en":"Stealth virus","hi":"स्टेल्थ वायरस"}],"exp":{"en":"A file infector virus targets executable programs (.exe, .com).","hi":"फाइल वायरस मुख्य रूप से प्रोग्राम रन करने वाली फाइलों (.exe) को संक्रमित करता है।"},"num":119},{"id":"q120","q":{"en":"What type of infection targets Office document macros?","hi":"किस प्रकार का संक्रमण ऑफिस डॉक्यूमेंट मैक्रोज़ (Office document macros) को लक्षित करता है?"},"a":{"en":"Macro virus","hi":"मैक्रो वायरस"},"o":[{"en":"File virus","hi":"फाइल वायरस"},{"en":"Macro virus","hi":"मैक्रो वायरस"},{"en":"Polymorphic virus","hi":"पॉलीमॉर्फिक वायरस"},{"en":"Cluster virus","hi":"क्लस्टर वायरस"}],"exp":{"en":"Macro viruses infect documents and templates, using the application's own scripting language.","hi":"मैक्रो वायरस MS Word या Excel की फाइलों के अंदर लिखे मैक्रो कोड को संक्रमित करता है।"},"num":120},{"id":"q121","q":{"en":"What does MBR stand for?","hi":"MBR का फुल फॉर्म क्या है?"},"a":{"en":"Master Boot Record","hi":"मास्टर बूट रिकॉर्ड"},"o":[{"en":"Master Boot Record","hi":"मास्टर बूट रिकॉर्ड"},{"en":"Main Block Resource","hi":"मेन ब्लॉक रिसोर्स"},{"en":"Micro Byte RAM","hi":"माइक्रो बाइट रैम"},{"en":"Multicast Basic Router","hi":"मल्टीकास्ट बेसिक राउटर"}],"exp":{"en":"MBR is the first sector of a hard drive, targeted by boot-sector viruses.","hi":"हार्ड डिस्क का पहला सेक्टर जहाँ से कंप्यूटर स्टार्ट होता है।"},"num":121},{"id":"q122","q":{"en":"What malware features host-independent self-replication?","hi":"कौन सा मैलवेयर होस्ट-स्वतंत्र (host-independent) सेल्फ-रेप्लिकेशन करता है?"},"a":{"en":"Worm","hi":"वर्म"},"o":[{"en":"Virus","hi":"वायरस"},{"en":"Trojan","hi":"ट्रोजन"},{"en":"Worm","hi":"वर्म"},{"en":"Keylogger","hi":"कीलॉगर"}],"exp":{"en":"Worms self-replicate and spread without needing a host file.","hi":"वर्म बिना किसी होस्ट फाइल के खुद को रेप्लिकेट करके फैलता है।"},"num":122},{"id":"q123","q":{"en":"What is a disguised malicious application?","hi":"एक भेष बदला हुआ (disguised) दुर्भावनापूर्ण एप्लिकेशन क्या कहलाता है?"},"a":{"en":"Trojan","hi":"ट्रोजन"},"o":[{"en":"Worm","hi":"वर्म"},{"en":"Trojan","hi":"ट्रोजन"},{"en":"Adware","hi":"एडवेयर"},{"en":"Logic bomb","hi":"लॉजिक बॉम्ब"}],"exp":{"en":"A Trojan disguises itself as legitimate software.","hi":"ट्रोजन असली सॉफ्टवेयर का भेष बनाकर आता है।"},"num":123},{"id":"q124","q":{"en":"What toolkit is used to hide unauthorized activity?","hi":"अनधिकृत गतिविधि (unauthorized activity) को छिपाने के लिए किस टूलकिट का उपयोग किया जाता है?"},"a":{"en":"Rootkit","hi":"रूटकिट"},"o":[{"en":"Rootkit","hi":"रूटकिट"},{"en":"Firewall","hi":"फ़ायरवॉल"},{"en":"Sniffer","hi":"स्निफ़र"},{"en":"VPN","hi":"वीपीएन"}],"exp":{"en":"A rootkit hides the presence of malware and unauthorized access.","hi":"रूटकिट सिस्टम में वायरस और हैकर को छिपने में मदद करता है।"},"num":124},{"id":"q125","q":{"en":"What records keyboard input?","hi":"कीबोर्ड इनपुट को कौन रिकॉर्ड करता है?"},"a":{"en":"Keylogger","hi":"कीलॉगर"},"o":[{"en":"Keylogger","hi":"कीलॉगर"},{"en":"Spyware","hi":"स्पाईवेयर"},{"en":"Adware","hi":"एडवेयर"},{"en":"Ransomware","hi":"रैंसमवेयर"}],"exp":{"en":"A keylogger captures keystrokes.","hi":"कीलॉगर आपके द्वारा टाइप किए गए हर बटन को रिकॉर्ड करता है।"},"num":125},{"id":"q126","q":{"en":"What is condition-triggered malicious code?","hi":"कंडीशन-ट्रिगर्ड (शर्त-आधारित) दुर्भावनापूर्ण कोड क्या है?"},"a":{"en":"Logic bomb","hi":"लॉजिक बॉम्ब"},"o":[{"en":"Logic bomb","hi":"लॉजिक बॉम्ब"},{"en":"Worm","hi":"वर्म"},{"en":"Rootkit","hi":"रूटकिट"},{"en":"Spoof","hi":"स्पूफ"}],"exp":{"en":"A logic bomb triggers when a specific condition is met.","hi":"लॉजिक बॉम्ब किसी खास शर्त या तारीख पर हमला करता है।"},"num":126},{"id":"q127","q":{"en":"What involves an encrypt and leak threat?","hi":"एन्क्रिप्ट और लीक की धमकी किसमें शामिल है?"},"a":{"en":"Double extortion ransomware","hi":"डबल एक्सटॉर्शन रैंसमवेयर"},"o":[{"en":"Double extortion ransomware","hi":"डबल एक्सटॉर्शन रैंसमवेयर"},{"en":"Smishing","hi":"स्मिशिंग"},{"en":"ARP spoofing","hi":"ARP स्पूफिंग"},{"en":"Vishing","hi":"विशिंग"}],"exp":{"en":"It locks files and threatens to publish stolen data.","hi":"इसमें फाइलों को लॉक करने के साथ-साथ डेटा को पब्लिक करने की धमकी दी जाती है।"},"num":127},{"id":"q128","q":{"en":"Who is an authorized security tester?","hi":"अधिकृत (authorized) सुरक्षा परीक्षक कौन है?"},"a":{"en":"White hat","hi":"व्हाइट हैट"},"o":[{"en":"Black hat","hi":"ब्लैक हैट"},{"en":"Grey hat","hi":"ग्रे हैट"},{"en":"White hat","hi":"व्हाइट हैट"},{"en":"Blue hat","hi":"ब्लू हैट"}],"exp":{"en":"A white hat is an ethical hacker with permission.","hi":"व्हाइट हैट एक एथिकल हैकर होता है जो अनुमति लेकर काम करता है।"},"num":128},{"id":"q129","q":{"en":"What is SMS phishing?","hi":"SMS फ़िशिंग क्या है?"},"a":{"en":"Smishing","hi":"स्मिशिंग"},"o":[{"en":"Vishing","hi":"विशिंग"},{"en":"Smishing","hi":"स्मिशिंग"},{"en":"Spoofing","hi":"स्पूफिंग"},{"en":"Snooping","hi":"स्नूपिंग"}],"exp":{"en":"Smishing is phishing via SMS text messages.","hi":"SMS के ज़रिए की गई फ़िशिंग को स्मिशिंग कहते हैं।"},"num":129},{"id":"q130","q":{"en":"What causes a false IP-to-MAC mapping?","hi":"फाल्स (गलत) IP-to-MAC मैपिंग का कारण क्या है?"},"a":{"en":"ARP spoofing","hi":"ARP स्पूफिंग"},"o":[{"en":"DNS spoofing","hi":"DNS स्पूफिंग"},{"en":"ARP spoofing","hi":"ARP स्पूफिंग"},{"en":"IP spoofing","hi":"IP स्पूफिंग"},{"en":"Packet sniffing","hi":"पैकेट स्निफ़िंग"}],"exp":{"en":"ARP spoofing falsely links a MAC address to an IP.","hi":"ARP स्पूफिंग में गलत MAC और IP एड्रेस को लिंक किया जाता है।"},"num":130},{"id":"q131","q":{"en":"What allows/blocks traffic based on network rules?","hi":"नेटवर्क नियमों के आधार पर ट्रैफ़िक को अनुमति देने/ब्लॉक करने का काम कौन करता है?"},"a":{"en":"Firewall","hi":"फ़ायरवॉल"},"o":[{"en":"Antivirus","hi":"एंटीवायरस"},{"en":"Firewall","hi":"फ़ायरवॉल"},{"en":"Router","hi":"राउटर"},{"en":"Switch","hi":"स्विच"}],"exp":{"en":"A firewall enforces network traffic policies.","hi":"फ़ायरवॉल नेटवर्क ट्रैफ़िक के नियमों को लागू करता है।"},"num":131},{"id":"q132","q":{"en":"What are the cues for verifying identity and permissions?","hi":"पहचान (identity) और अनुमतियों (permissions) को सत्यापित करने के लिए संकेत (cues) क्या हैं?"},"a":{"en":"Authentication and authorization","hi":"ऑथेंटिकेशन और ऑथोराइजेशन"},"o":[{"en":"Encryption and Decryption","hi":"एन्क्रिप्शन और डिक्रिप्शन"},{"en":"Authentication and authorization","hi":"ऑथेंटिकेशन और ऑथोराइजेशन"},{"en":"Public key and Private key","hi":"पब्लिक की और प्राइवेट की"},{"en":"Sniffing and Snooping","hi":"स्निफ़िंग और स्नूपिंग"}],"exp":{"en":"Authentication verifies identity; authorization verifies permissions.","hi":"ऑथेंटिकेशन पहचान की पुष्टि करता है, और ऑथोराइजेशन अनुमतियों की।"},"num":132},{"id":"q133","q":{"en":"What is isolating a suspicious file called?","hi":"किसी संदिग्ध फाइल को अलग (isolate) करना क्या कहलाता है?"},"a":{"en":"Quarantine","hi":"क्वारंटाइन"},"o":[{"en":"Deleting","hi":"डिलीटिंग"},{"en":"Scanning","hi":"स्कैनिंग"},{"en":"Quarantine","hi":"क्वारंटाइन"},{"en":"Restoring","hi":"रिस्टोरिंग"}],"exp":{"en":"Quarantine isolates malware so it cannot run.","hi":"क्वारंटाइन में संदिग्ध फाइल को सुरक्षित जगह कैद कर दिया जाता है।"},"num":133}]}],"8. Data Representation & Number Systems — Data Processing, Statistics, Encoding & Base Conversions":[{"title":{"en":"1. Data, Structure, Metadata & Storage","hi":"1. डेटा, संरचना, मेटाडेटा और भंडारण"},"questions":[{"id":"q1","q":{"en":"What is Data?","hi":"डेटा (Data) क्या होता है?"},"a":{"en":"A collection of characters, numbers, symbols or observations that represent the values of a situation or variable","hi":"कैरेक्टर, नंबर, सिंबल या अवलोकनों का एक संग्रह जो किसी स्थिति या चर (variable) के मानों को दर्शाता है"},"o":[{"en":"A physical computer component","hi":"एक भौतिक कंप्यूटर घटक"},{"en":"A collection of characters, numbers, symbols or observations that represent the values of a situation or variable","hi":"कैरेक्टर, नंबर, सिंबल या अवलोकनों का एक संग्रह जो किसी स्थिति या चर (variable) के मानों को दर्शाता है"},{"en":"Processed information ready for decision making","hi":"निर्णय लेने के लिए तैयार प्रसंस्कृत (processed) जानकारी"},{"en":"An operating system instruction","hi":"एक ऑपरेटिंग सिस्टम निर्देश"}],"exp":{"en":"Data is defined as raw, unorganized facts that need to be processed. It can be a collection of characters, numbers, symbols, or observations representing variables.","hi":"डेटा को कच्चे, असंगठित तथ्यों के रूप में परिभाषित किया जाता है जिन्हें संसाधित (process) करने की आवश्यकता होती है। यह कैरेक्टर, नंबर, सिंबल या अवलोकनों का एक संग्रह है जो किसी स्थिति या चर (variable) को दर्शाता है।"},"num":1},{"id":"q2","q":{"en":"What is the primary difference between data and information?","hi":"डेटा और इंफॉर्मेशन (Information) में प्राथमिक अंतर क्या है?"},"a":{"en":"Data are raw observations or values; information is the meaningful output after context and processing are applied","hi":"डेटा कच्चे अवलोकन या मान (raw observations or values) हैं; इंफॉर्मेशन संदर्भ और प्रोसेसिंग के बाद प्राप्त अर्थपूर्ण आउटपुट (meaningful output) है"},"o":[{"en":"Data is meaningful, information is raw","hi":"डेटा अर्थपूर्ण है, इंफॉर्मेशन कच्ची है"},{"en":"Data consists of hardware, information consists of software","hi":"डेटा में हार्डवेयर होता है, इंफॉर्मेशन में सॉफ्टवेयर होता है"},{"en":"Data are raw observations or values; information is the meaningful output after context and processing are applied","hi":"डेटा कच्चे अवलोकन या मान (raw observations or values) हैं; इंफॉर्मेशन संदर्भ और प्रोसेसिंग के बाद प्राप्त अर्थपूर्ण आउटपुट (meaningful output) है"},{"en":"There is no difference","hi":"कोई अंतर नहीं है"}],"exp":{"en":"Data is raw and unorganized. Once data is processed, organized, and structured in a given context to make it useful, it is called information.","hi":"डेटा कच्चा और असंगठित होता है। एक बार जब डेटा को उपयोगी बनाने के लिए किसी संदर्भ में संसाधित (process) और व्यवस्थित किया जाता है, तो यह 'इंफॉर्मेशन' (जानकारी) बन जाता है।"},"num":2},{"id":"q3","q":{"en":"Based on the source format, what are the two main types of data?","hi":"स्रोत प्रारूप (Source format) के आधार पर डेटा के दो मुख्य प्रकार कौन से हैं?"},"a":{"en":"Structured and Unstructured data (Semi-structured is another common category)","hi":"स्ट्रक्चर्ड (Structured) और अनस्ट्रक्चर्ड (Unstructured) डेटा (सेमी-स्ट्रक्चर्ड एक अन्य सामान्य श्रेणी है)"},"o":[{"en":"Hardware and Software","hi":"हार्डवेयर और सॉफ्टवेयर"},{"en":"Structured and Unstructured data (Semi-structured is another common category)","hi":"स्ट्रक्चर्ड (Structured) और अनस्ट्रक्चर्ड (Unstructured) डेटा (सेमी-स्ट्रक्चर्ड एक अन्य सामान्य श्रेणी है)"},{"en":"Input and Output","hi":"इनपुट और आउटपुट"},{"en":"Primary and Secondary","hi":"प्राथमिक और द्वितीयक"}],"exp":{"en":"Data is generally categorized based on its format into structured data (like tables/databases) and unstructured data (like text, images).","hi":"प्रारूप (format) के आधार पर डेटा को आमतौर पर स्ट्रक्चर्ड (व्यवस्थित, जैसे टेबल/डेटाबेस) और अनस्ट्रक्चर्ड (अव्यवस्थित, जैसे टेक्स्ट, चित्र) में वर्गीकृत किया जाता है।"},"num":3},{"id":"q4","q":{"en":"What is structured data?","hi":"स्ट्रक्चर्ड डेटा (Structured data) क्या होता है?"},"a":{"en":"Data organized in a well-defined format or schema, such as a database table or inventory sheet","hi":"ऐसा डेटा जो एक अच्छी तरह से परिभाषित प्रारूप (well-defined format) या स्कीमा (schema) में व्यवस्थित होता है, जैसे डेटाबेस टेबल या इन्वेंट्री शीट"},"o":[{"en":"Data that is completely random","hi":"डेटा जो पूरी तरह से यादृच्छिक (random) है"},{"en":"Data organized in a well-defined format or schema, such as a database table or inventory sheet","hi":"ऐसा डेटा जो एक अच्छी तरह से परिभाषित प्रारूप (well-defined format) या स्कीमा (schema) में व्यवस्थित होता है, जैसे डेटाबेस टेबल या इन्वेंट्री शीट"},{"en":"Only video files","hi":"केवल वीडियो फाइलें"},{"en":"Data with no relationship between elements","hi":"ऐसा डेटा जिसमें तत्वों के बीच कोई संबंध नहीं है"}],"exp":{"en":"Structured data is highly organized and formatted so that it is easily searchable in relational databases, like rows and columns in an inventory sheet.","hi":"स्ट्रक्चर्ड डेटा अत्यधिक व्यवस्थित और स्वरूपित (formatted) होता है ताकि इसे डेटाबेस में आसानी से खोजा जा सके, जैसे इन्वेंट्री शीट में पंक्तियाँ (rows) और कॉलम।"},"num":4},{"id":"q5","q":{"en":"What do a row and a column represent in a table?","hi":"एक टेबल (Table) में पंक्ति (row) और कॉलम (column) क्या दर्शाते हैं?"},"a":{"en":"A row represents an observation or record; a column represents an attribute, field, or variable","hi":"एक पंक्ति (row) एक अवलोकन या रिकॉर्ड (observation or record) दर्शाती है; एक कॉलम (column) एक एट्रिब्यूट (attribute), फ़ील्ड (field) या चर (variable) को दर्शाता है"},"o":[{"en":"A row represents a variable; a column represents a record","hi":"एक पंक्ति एक चर (variable) दर्शाती है; एक कॉलम एक रिकॉर्ड (record) दर्शाता है"},{"en":"Both represent the same thing","hi":"दोनों एक ही बात दर्शाते हैं"},{"en":"A row represents an observation or record; a column represents an attribute, field, or variable","hi":"एक पंक्ति (row) एक अवलोकन या रिकॉर्ड (observation or record) दर्शाती है; एक कॉलम (column) एक एट्रिब्यूट (attribute), फ़ील्ड (field) या चर (variable) को दर्शाता है"},{"en":"A row is for numbers, a column is for text","hi":"एक पंक्ति संख्याओं के लिए है, एक कॉलम टेक्स्ट के लिए है"}],"exp":{"en":"In data tables, a row represents a single complete entity or observation (a record), while a column represents a specific property or attribute of that entity (a field).","hi":"डेटा टेबल में, एक पंक्ति (row) एक रिकॉर्ड या अवलोकन को दर्शाती है, जबकि एक कॉलम उस रिकॉर्ड की एक विशिष्ट विशेषता या फ़ील्ड (field) को दर्शाता है।"},"num":5},{"id":"q6","q":{"en":"Which fields are present in the inventory example?","hi":"इन्वेंट्री के उदाहरण (Inventory example) में कौन से फ़ील्ड (fields) मौजूद हैं?"},"a":{"en":"ModelNo, ProductName, Unit Price, Discount (%), and Items_in_Inventory","hi":"मॉडल नंबर (ModelNo), उत्पाद का नाम (ProductName), इकाई मूल्य (Unit Price), छूट (Discount %), और इन्वेंट्री में आइटम (Items_in_Inventory)"},"o":[{"en":"Name, Age, Address","hi":"नाम, उम्र, पता"},{"en":"ModelNo, ProductName, Unit Price, Discount (%), and Items_in_Inventory","hi":"मॉडल नंबर (ModelNo), उत्पाद का नाम (ProductName), इकाई मूल्य (Unit Price), छूट (Discount %), और इन्वेंट्री में आइटम (Items_in_Inventory)"},{"en":"Date, Time, Location","hi":"तिथि, समय, स्थान"},{"en":"EmployeeID, Salary, Department","hi":"कर्मचारी आईडी, वेतन, विभाग"}],"exp":{"en":"The inventory example uses columns representing the product attributes: ModelNo, ProductName, Unit Price, Discount (%), and Items_in_Inventory.","hi":"इन्वेंट्री उदाहरण में उत्पाद की विशेषताओं को दर्शाने वाले कॉलम हैं: मॉडल नंबर, उत्पाद का नाम, इकाई मूल्य, छूट (%), और स्टॉक में आइटम।"},"num":6},{"id":"q7","q":{"en":"According to the inventory table, which products have the highest unit price and the highest stock?","hi":"इन्वेंट्री टेबल के अनुसार, किन उत्पादों का इकाई मूल्य (unit price) सबसे अधिक है और स्टॉक (stock) सबसे अधिक है?"},"a":{"en":"Highest price: Dinner Set (4,200); Highest stock: Melamine Plates (45)","hi":"उच्चतम मूल्य: डिनर सेट (4,200); उच्चतम स्टॉक: मेलामाइन प्लेट्स (45)"},"o":[{"en":"Highest price: Kitchen Towel, Highest stock: Water Bottle","hi":"उच्चतम मूल्य: किचन टॉवल, उच्चतम स्टॉक: पानी की बोतल"},{"en":"Highest price: Dinner Set (4,200); Highest stock: Melamine Plates (45)","hi":"उच्चतम मूल्य: डिनर सेट (4,200); उच्चतम स्टॉक: मेलामाइन प्लेट्स (45)"},{"en":"Highest price: Glass Jug, Highest stock: Dinner Set","hi":"उच्चतम मूल्य: ग्लास जग, उच्चतम स्टॉक: डिनर सेट"},{"en":"Highest price: Melamine Plates, Highest stock: Kitchen Towel","hi":"उच्चतम मूल्य: मेलामाइन प्लेट्स, उच्चतम स्टॉक: किचन टॉवल"}],"exp":{"en":"In the given inventory dataset, the Dinner Set has the highest unit price at 4,200, and Melamine Plates have the highest stock count of 45.","hi":"दिए गए इन्वेंट्री डेटासेट में, डिनर सेट का इकाई मूल्य 4,200 सबसे अधिक है, और मेलामाइन प्लेट्स का स्टॉक सबसे अधिक 45 है।"},"num":7},{"id":"q8","q":{"en":"What is the total stock and the lowest unit price in the inventory example?","hi":"इन्वेंट्री उदाहरण में कुल स्टॉक (total stock) और सबसे कम इकाई मूल्य (lowest unit price) क्या है?"},"a":{"en":"Total stock: 128 items; Lowest unit price: Kitchen Towel (25)","hi":"कुल स्टॉक: 128 आइटम; सबसे कम इकाई मूल्य: किचन टॉवल (25)"},"o":[{"en":"Total stock: 128 items; Lowest unit price: Kitchen Towel (25)","hi":"कुल स्टॉक: 128 आइटम; सबसे कम इकाई मूल्य: किचन टॉवल (25)"},{"en":"Total stock: 100 items; Lowest unit price: Glass Jug (50)","hi":"कुल स्टॉक: 100 आइटम; सबसे कम इकाई मूल्य: ग्लास जग (50)"},{"en":"Total stock: 150 items; Lowest unit price: Dinner Set (4200)","hi":"कुल स्टॉक: 150 आइटम; सबसे कम इकाई मूल्य: डिनर सेट (4200)"},{"en":"Total stock: 128 items; Lowest unit price: Water Bottle (10)","hi":"कुल स्टॉक: 128 आइटम; सबसे कम इकाई मूल्य: पानी की बोतल (10)"}],"exp":{"en":"By summing the stock column, we get 128 total items. The lowest value in the unit price column is 25 for the Kitchen Towel.","hi":"स्टॉक कॉलम को जोड़ने पर हमें कुल 128 आइटम मिलते हैं। इकाई मूल्य कॉलम में सबसे कम मूल्य 25 है जो किचन टॉवल का है।"},"num":8},{"id":"q9","q":{"en":"What is unstructured data?","hi":"अनस्ट्रक्चर्ड डेटा (Unstructured data) क्या होता है?"},"a":{"en":"Content that does not naturally fit into a predefined tabular schema, such as free-form text, photos, or audio","hi":"ऐसा कंटेंट जो प्राकृतिक रूप से किसी पूर्वनिर्धारित सारणीबद्ध स्कीमा (predefined tabular schema) में फिट नहीं होता है, जैसे मुक्त-रूप टेक्स्ट (free-form text), फोटो या ऑडियो"},"o":[{"en":"Data formatted strictly in an SQL database","hi":"SQL डेटाबेस में कड़ाई से स्वरूपित डेटा"},{"en":"Content that does not naturally fit into a predefined tabular schema, such as free-form text, photos, or audio","hi":"ऐसा कंटेंट जो प्राकृतिक रूप से किसी पूर्वनिर्धारित सारणीबद्ध स्कीमा (predefined tabular schema) में फिट नहीं होता है, जैसे मुक्त-रूप टेक्स्ट (free-form text), फोटो या ऑडियो"},{"en":"Only numerical data","hi":"केवल संख्यात्मक डेटा"},{"en":"Data used exclusively for mathematical calculations","hi":"विशेष रूप से गणितीय गणनाओं के लिए उपयोग किया जाने वाला डेटा"}],"exp":{"en":"Unstructured data is information that either does not have a pre-defined data model or is not organized in a pre-defined manner, like images, videos, and large text documents.","hi":"अनस्ट्रक्चर्ड डेटा वह जानकारी है जिसका कोई पूर्व-निर्धारित डेटा मॉडल नहीं होता है, जैसे चित्र, वीडियो और बड़े टेक्स्ट दस्तावेज़।"},"num":9},{"id":"q10","q":{"en":"Why is a webpage considered an example of unstructured (or semi-structured) data?","hi":"वेबपेज (Webpage) को अनस्ट्रक्चर्ड (या सेमी-स्ट्रक्चर्ड) डेटा का उदाहरण क्यों माना जाता है?"},"a":{"en":"The page's text and multimedia do not fit into fixed rows/columns, although the HTML markup itself contains structured tags","hi":"पेज का टेक्स्ट और मल्टीमीडिया निश्चित पंक्तियों/कॉलमों (fixed rows/columns) में फिट नहीं होते हैं, हालाँकि HTML मार्कअप में स्वयं स्ट्रक्चर्ड टैग (structured tags) होते हैं"},"o":[{"en":"Because it only contains numbers","hi":"क्योंकि इसमें केवल संख्याएँ होती हैं"},{"en":"Because it is always offline","hi":"क्योंकि यह हमेशा ऑफलाइन होता है"},{"en":"The page's text and multimedia do not fit into fixed rows/columns, although the HTML markup itself contains structured tags","hi":"पेज का टेक्स्ट और मल्टीमीडिया निश्चित पंक्तियों/कॉलमों (fixed rows/columns) में फिट नहीं होते हैं, हालाँकि HTML मार्कअप में स्वयं स्ट्रक्चर्ड टैग (structured tags) होते हैं"},{"en":"Because it uses an SQL database to display","hi":"क्योंकि यह प्रदर्शित करने के लिए SQL डेटाबेस का उपयोग करता है"}],"exp":{"en":"A webpage is semi-structured. The HTML tags provide structure, but the actual text content and media inside the tags are free-form and do not conform to a strict tabular format.","hi":"एक वेबपेज सेमी-स्ट्रक्चर्ड होता है। HTML टैग संरचना प्रदान करते हैं, लेकिन टैग के अंदर का वास्तविक टेक्स्ट और मीडिया मुक्त-रूप में होते हैं और किसी सख्त टेबल प्रारूप के अनुरूप नहीं होते हैं।"},"num":10},{"id":"q11","q":{"en":"What is metadata?","hi":"मेटाडेटा (Metadata) क्या है?"},"a":{"en":"Data about data, such as file name, size, creation date, sender, and content type","hi":"डेटा के बारे में डेटा (Data about data), जैसे फ़ाइल का नाम, आकार, निर्माण की तिथि, प्रेषक (sender) और कंटेंट का प्रकार (content type)"},"o":[{"en":"Data about data, such as file name, size, creation date, sender, and content type","hi":"डेटा के बारे में डेटा (Data about data), जैसे फ़ाइल का नाम, आकार, निर्माण की तिथि, प्रेषक (sender) और कंटेंट का प्रकार (content type)"},{"en":"A large collection of databases","hi":"डेटाबेस का एक बड़ा संग्रह"},{"en":"The primary processing unit of a computer","hi":"कंप्यूटर की प्राथमिक प्रोसेसिंग इकाई"},{"en":"A type of computer virus","hi":"एक प्रकार का कंप्यूटर वायरस"}],"exp":{"en":"Metadata summarizes basic information about data, which can make finding and working with particular instances of data easier. It is 'data about data'.","hi":"मेटाडेटा डेटा के बारे में बुनियादी जानकारी को सारांशित करता है, जिससे डेटा के विशिष्ट उदाहरणों को ढूंढना और उनके साथ काम करना आसान हो जाता है। यह 'डेटा के बारे में डेटा' है।"},"num":11},{"id":"q12","q":{"en":"What are examples of metadata and actual content in an email?","hi":"ईमेल में मेटाडेटा (metadata) और वास्तविक कंटेंट (actual content) के उदाहरण क्या हैं?"},"a":{"en":"Metadata: Sender, recipient, date, subject, and attachment filename. Content: The message body and the attached file","hi":"मेटाडेटा: प्रेषक, प्राप्तकर्ता, तिथि, विषय और अटैचमेंट फ़ाइल का नाम। कंटेंट: संदेश का मुख्य भाग (message body) और संलग्न फ़ाइल (attached file)"},"o":[{"en":"Metadata: The message text; Content: The date","hi":"मेटाडेटा: संदेश का टेक्स्ट; कंटेंट: तिथि"},{"en":"Metadata: Sender, recipient, date, subject, and attachment filename. Content: The message body and the attached file","hi":"मेटाडेटा: प्रेषक, प्राप्तकर्ता, तिथि, विषय और अटैचमेंट फ़ाइल का नाम। कंटेंट: संदेश का मुख्य भाग (message body) और संलग्न फ़ाइल (attached file)"},{"en":"Metadata: The email server; Content: The user password","hi":"मेटाडेटा: ईमेल सर्वर; कंटेंट: उपयोगकर्ता का पासवर्ड"},{"en":"Both are exactly the same","hi":"दोनों बिल्कुल समान हैं"}],"exp":{"en":"In an email, the headers (sender, receiver, time, subject) are metadata describing the email, while the body paragraph and attachments are the actual data content.","hi":"ईमेल में, हेडर (प्रेषक, प्राप्तकर्ता, समय, विषय) मेटाडेटा हैं जो ईमेल का वर्णन करते हैं, जबकि मुख्य पैराग्राफ और अटैचमेंट वास्तविक डेटा कंटेंट हैं।"},"num":12},{"id":"q13","q":{"en":"What is data collection?","hi":"डेटा कलेक्शन (Data collection) क्या है?"},"a":{"en":"Identifying existing relevant data or collecting fresh observations from appropriate sources","hi":"मौजूदा प्रासंगिक डेटा (existing relevant data) की पहचान करना या उपयुक्त स्रोतों से नए अवलोकन (fresh observations) एकत्र करना"},"o":[{"en":"Deleting old data from a hard drive","hi":"हार्ड ड्राइव से पुराने डेटा को हटाना"},{"en":"Identifying existing relevant data or collecting fresh observations from appropriate sources","hi":"मौजूदा प्रासंगिक डेटा (existing relevant data) की पहचान करना या उपयुक्त स्रोतों से नए अवलोकन (fresh observations) एकत्र करना"},{"en":"Writing a computer program","hi":"कंप्यूटर प्रोग्राम लिखना"},{"en":"Creating a backup of an operating system","hi":"ऑपरेटिंग सिस्टम का बैकअप बनाना"}],"exp":{"en":"Data collection is the process of gathering and measuring information on targeted variables in an established system, which then enables one to answer relevant questions and evaluate outcomes.","hi":"डेटा कलेक्शन किसी स्थापित प्रणाली में लक्षित चर (variables) पर जानकारी इकट्ठा करने और मापने की प्रक्रिया है, जो फिर सवालों के जवाब देने और परिणामों का मूल्यांकन करने में सक्षम बनाती है।"},"num":13},{"id":"q14","q":{"en":"What is the purpose of data storage?","hi":"डेटा स्टोरेज (Data storage) का उद्देश्य क्या है?"},"a":{"en":"To save data on a storage medium so that it can be retrieved and used later","hi":"डेटा को स्टोरेज माध्यम (storage medium) पर सहेजना (save) ताकि इसे बाद में पुनर्प्राप्त (retrieve) और उपयोग किया जा सके"},"o":[{"en":"To print data on paper","hi":"डेटा को कागज पर प्रिंट करना"},{"en":"To save data on a storage medium so that it can be retrieved and used later","hi":"डेटा को स्टोरेज माध्यम (storage medium) पर सहेजना (save) ताकि इसे बाद में पुनर्प्राप्त (retrieve) और उपयोग किया जा सके"},{"en":"To delete data permanently","hi":"डेटा को स्थायी रूप से हटाना"},{"en":"To translate data into foreign languages","hi":"डेटा का विदेशी भाषाओं में अनुवाद करना"}],"exp":{"en":"Data storage is the retention of information using technology specifically developed to keep that data and have it as accessible as necessary.","hi":"डेटा स्टोरेज तकनीक का उपयोग करके जानकारी को बनाए रखना है, ताकि डेटा को सुरक्षित रखा जा सके और आवश्यकतानुसार एक्सेस किया जा सके।"},"num":14},{"id":"q15","q":{"en":"What are source examples of digital storage devices?","hi":"डिजिटल स्टोरेज डिवाइस (Digital storage devices) के स्रोत उदाहरण क्या हैं?"},"a":{"en":"HDD, SSD, CD/DVD, tape drive, pen drive, and memory cards","hi":"एचडीडी (HDD), एसएसडी (SSD), सीडी/डीवीडी (CD/DVD), टेप ड्राइव, पेन ड्राइव और मेमोरी कार्ड"},"o":[{"en":"Keyboards, Mice, Monitors","hi":"कीबोर्ड, माउस, मॉनिटर"},{"en":"HDD, SSD, CD/DVD, tape drive, pen drive, and memory cards","hi":"एचडीडी (HDD), एसएसडी (SSD), सीडी/डीवीडी (CD/DVD), टेप ड्राइव, पेन ड्राइव और मेमोरी कार्ड"},{"en":"Printers, Scanners, Speakers","hi":"प्रिंटर, स्कैनर, स्पीकर"},{"en":"RAM, CPU, GPU","hi":"रैम, सीपीयू, जीपीयू"}],"exp":{"en":"These are non-volatile secondary storage devices used to retain digital data over long periods, unlike temporary memory like RAM.","hi":"ये गैर-वाष्पशील (non-volatile) द्वितीयक स्टोरेज डिवाइस हैं जिनका उपयोग लंबे समय तक डिजिटल डेटा को बनाए रखने के लिए किया जाता है, रैम (RAM) जैसी अस्थायी मेमोरी के विपरीत।"},"num":15},{"id":"q16","q":{"en":"How can the limitations of traditional file processing be reduced?","hi":"पारंपरिक फाइल प्रोसेसिंग (File processing) की सीमाओं को कैसे कम किया जा सकता है?"},"a":{"en":"By using a DBMS (Database Management System) to support centralized queries, consistency controls, permissions, and multi-user access (e.g., Access, Oracle, MySQL)","hi":"केंद्रीकृत क्वेरी (centralized queries), स्थिरता नियंत्रण (consistency controls), अनुमतियों (permissions) और बहु-उपयोगकर्ता पहुंच (multi-user access) का समर्थन करने के लिए DBMS का उपयोग करके (उदाहरण: Access, Oracle, MySQL)"},"o":[{"en":"By using paper files instead","hi":"इसके बजाय कागजी फाइलों का उपयोग करके"},{"en":"By using a DBMS (Database Management System) to support centralized queries, consistency controls, permissions, and multi-user access (e.g., Access, Oracle, MySQL)","hi":"केंद्रीकृत क्वेरी (centralized queries), स्थिरता नियंत्रण (consistency controls), अनुमतियों (permissions) और बहु-उपयोगकर्ता पहुंच (multi-user access) का समर्थन करने के लिए DBMS का उपयोग करके (उदाहरण: Access, Oracle, MySQL)"},{"en":"By turning off the computer","hi":"कंप्यूटर बंद करके"},{"en":"By only using floppy disks","hi":"केवल फ्लॉपी डिस्क का उपयोग करके"}],"exp":{"en":"A Database Management System overcomes the data redundancy, inconsistency, and isolation problems inherent in flat-file processing systems.","hi":"डेटाबेस मैनेजमेंट सिस्टम फ्लैट-फाइल प्रोसेसिंग सिस्टम में मौजूद डेटा रिडंडेंसी (डेटा दोहराव), असंगतता और आइसोलेशन की समस्याओं को दूर करता है।"},"num":16},{"id":"q17","q":{"en":"What is the full form of DBMS?","hi":"DBMS का फुल फॉर्म क्या है?"},"a":{"en":"Database Management System","hi":"डेटाबेस मैनेजमेंट सिस्टम"},"o":[{"en":"Database Management System","hi":"डेटाबेस मैनेजमेंट सिस्टम"},{"en":"Digital Binary Memory Storage","hi":"डिजिटल बाइनरी मेमोरी स्टोरेज"},{"en":"Data Backup and Maintenance System","hi":"डेटा बैकअप एंड मेंटेनेंस सिस्टम"},{"en":"Dynamic Broadband Media Server","hi":"डायनेमिक ब्रॉडबैंड मीडिया सर्वर"}],"exp":{"en":"DBMS stands for Database Management System, software that interacts with end users, applications, and the database itself to capture and analyze the data.","hi":"DBMS का फुल फॉर्म डेटाबेस मैनेजमेंट सिस्टम है, यह एक सॉफ्टवेयर है जो डेटा को कैप्चर और विश्लेषण करने के लिए एंड यूज़र, एप्लिकेशन और डेटाबेस के साथ इंटरैक्ट करता है।"},"num":17}]},{"title":{"en":"2. Data Processing Cycle","hi":"2. डेटा प्रोसेसिंग चक्र"},"questions":[{"id":"q18","q":{"en":"What is data processing?","hi":"डेटा प्रोसेसिंग (Data processing) क्या है?"},"a":{"en":"Classifying, sorting, calculating, and summarizing raw data to produce useful output","hi":"उपयोगी आउटपुट (useful output) प्राप्त करने के लिए कच्चे डेटा (raw data) को वर्गीकृत (classify), सॉर्ट, गणना (calculate) और सारांशित (summarize) करना"},"o":[{"en":"Cleaning the hardware components of a computer","hi":"कंप्यूटर के हार्डवेयर घटकों की सफाई करना"},{"en":"Classifying, sorting, calculating, and summarizing raw data to produce useful output","hi":"उपयोगी आउटपुट (useful output) प्राप्त करने के लिए कच्चे डेटा (raw data) को वर्गीकृत (classify), सॉर्ट, गणना (calculate) और सारांशित (summarize) करना"},{"en":"Typing data into a word processor","hi":"वर्ड प्रोसेसर में डेटा टाइप करना"},{"en":"Transferring data over the internet","hi":"इंटरनेट पर डेटा ट्रांसफर करना"}],"exp":{"en":"Data processing is the collection and manipulation of items of data to produce meaningful information.","hi":"डेटा प्रोसेसिंग, अर्थपूर्ण जानकारी उत्पन्न करने के लिए डेटा के आइटमों का संग्रह और हेरफेर (manipulation) है।"},"num":18},{"id":"q19","q":{"en":"What are the main steps of the data processing cycle?","hi":"डेटा प्रोसेसिंग साइकिल (Data processing cycle) के मुख्य चरण क्या हैं?"},"a":{"en":"Input → Processing → Output (Output or intermediate data can be stored for later use)","hi":"इनपुट → प्रोसेसिंग → आउटपुट (आउटपुट या मध्यवर्ती डेटा को बाद में उपयोग के लिए स्टोर किया जा सकता है)"},"o":[{"en":"Start → Stop","hi":"स्टार्ट → स्टॉप"},{"en":"Input → Processing → Output (Output or intermediate data can be stored for later use)","hi":"इनपुट → प्रोसेसिंग → आउटपुट (आउटपुट या मध्यवर्ती डेटा को बाद में उपयोग के लिए स्टोर किया जा सकता है)"},{"en":"Read → Write → Execute","hi":"रीड → राइट → एग्जीक्यूट"},{"en":"Download → Upload","hi":"डाउनलोड → अपलोड"}],"exp":{"en":"The standard data processing cycle consists of Input (gathering data), Processing (manipulating data), and Output (presenting results), often followed by Storage.","hi":"मानक डेटा प्रोसेसिंग चक्र में इनपुट (डेटा एकत्र करना), प्रोसेसिंग (डेटा में हेरफेर) और आउटपुट (परिणाम प्रस्तुत करना) शामिल हैं, जिसके बाद अक्सर स्टोरेज होता है।"},"num":19},{"id":"q20","q":{"en":"What happens in the input stage?","hi":"इनपुट चरण (Input stage) में क्या होता है?"},"a":{"en":"Data collection, preparation, and data entry. Numbers, text, or images can be input","hi":"डेटा संग्रह (Data collection), तैयारी (preparation) और डेटा प्रविष्टि (data entry)। संख्याएँ, टेक्स्ट या चित्र इनपुट हो सकते हैं"},"o":[{"en":"The final report is printed","hi":"अंतिम रिपोर्ट प्रिंट की जाती है"},{"en":"Data collection, preparation, and data entry. Numbers, text, or images can be input","hi":"डेटा संग्रह (Data collection), तैयारी (preparation) और डेटा प्रविष्टि (data entry)। संख्याएँ, टेक्स्ट या चित्र इनपुट हो सकते हैं"},{"en":"The CPU calculates equations","hi":"CPU समीकरणों की गणना करता है"},{"en":"Data is permanently deleted","hi":"डेटा स्थायी रूप से हटा दिया जाता है"}],"exp":{"en":"Input is the first stage where raw data is gathered, prepared, and fed into the processing system.","hi":"इनपुट पहला चरण है जहां कच्चे डेटा को एकत्र किया जाता है, तैयार किया जाता है, और प्रोसेसिंग सिस्टम में डाला जाता है।"},"num":20},{"id":"q21","q":{"en":"What operations can take place in the processing stage?","hi":"प्रोसेसिंग चरण (Processing stage) में कौन से कार्य (operations) हो सकते हैं?"},"a":{"en":"Classification, sorting, calculation, summarization, and storing, retrieving, or updating according to the system","hi":"वर्गीकरण (Classification), सॉर्टिंग, गणना (calculation), संक्षेपीकरण (summarization), और सिस्टम के अनुसार स्टोर करना, पुनर्प्राप्त (retrieve) या अपडेट करना"},"o":[{"en":"Only converting data to binary","hi":"केवल डेटा को बाइनरी में परिवर्तित करना"},{"en":"Classification, sorting, calculation, summarization, and storing, retrieving, or updating according to the system","hi":"वर्गीकरण (Classification), सॉर्टिंग, गणना (calculation), संक्षेपीकरण (summarization), और सिस्टम के अनुसार स्टोर करना, पुनर्प्राप्त (retrieve) या अपडेट करना"},{"en":"Only displaying data on the monitor","hi":"केवल मॉनिटर पर डेटा प्रदर्शित करना"},{"en":"Physical printing of documents","hi":"दस्तावेजों की भौतिक छपाई"}],"exp":{"en":"Processing involves taking the raw input and applying various mathematical or logical operations to transform it into useful information.","hi":"प्रोसेसिंग में कच्चे इनपुट को लेना और इसे उपयोगी जानकारी में बदलने के लिए विभिन्न गणितीय या तार्किक (logical) कार्य करना शामिल है।"},"num":21},{"id":"q22","q":{"en":"What is an example of the output stage?","hi":"आउटपुट चरण (Output stage) का एक उदाहरण क्या है?"},"a":{"en":"Reports, tables, charts, text summaries, and calculated results","hi":"रिपोर्ट, टेबल, चार्ट, टेक्स्ट सारांश, और गणना किए गए परिणाम"},"o":[{"en":"Typing on a keyboard","hi":"कीबोर्ड पर टाइप करना"},{"en":"Reports, tables, charts, text summaries, and calculated results","hi":"रिपोर्ट, टेबल, चार्ट, टेक्स्ट सारांश, और गणना किए गए परिणाम"},{"en":"A hard drive storing files","hi":"फाइलें स्टोर करने वाली एक हार्ड ड्राइव"},{"en":"Scanning a document","hi":"एक दस्तावेज़ को स्कैन करना"}],"exp":{"en":"Output is the final result of data processing, presented in a human-readable and useful format like charts or reports.","hi":"आउटपुट डेटा प्रोसेसिंग का अंतिम परिणाम है, जिसे चार्ट या रिपोर्ट जैसे मानव-पठनीय (human-readable) और उपयोगी प्रारूप में प्रस्तुत किया जाता है।"},"num":22},{"id":"q23","q":{"en":"What is the analysis of the output used for?","hi":"आउटपुट का विश्लेषण (Analysis of output) किस काम आता है?"},"a":{"en":"To understand patterns, draw conclusions, and make decisions","hi":"पैटर्न समझने (understanding patterns), निष्कर्ष निकालने (drawing conclusions) और निर्णय लेने (making decisions) में"},"o":[{"en":"To turn off the computer","hi":"कंप्यूटर बंद करने के लिए"},{"en":"To understand patterns, draw conclusions, and make decisions","hi":"पैटर्न समझने (understanding patterns), निष्कर्ष निकालने (drawing conclusions) और निर्णय लेने (making decisions) में"},{"en":"To increase internet speed","hi":"इंटरनेट की गति बढ़ाने के लिए"},{"en":"To generate more raw data","hi":"अधिक कच्चा डेटा उत्पन्न करने के लिए"}],"exp":{"en":"The ultimate goal of processing data into information is analysis, which informs strategic decision-making and pattern recognition.","hi":"डेटा को जानकारी में संसाधित करने का अंतिम लक्ष्य विश्लेषण है, जो रणनीतिक निर्णय लेने और पैटर्न की पहचान करने में मदद करता है।"},"num":23},{"id":"q24","q":{"en":"Arranging inventory by price and finding the total are examples of which operations?","hi":"इन्वेंट्री को मूल्य क्रम (price order) में व्यवस्थित करना और कुल (total) निकालना कौन से कार्य (operations) हैं?"},"a":{"en":"Arranging by price is sorting. Finding the total is calculation/summarization","hi":"मूल्य के क्रम में व्यवस्थित करना 'सॉर्टिंग' (sorting) है। कुल (total) निकालना गणना/संक्षेपीकरण (calculation/summarization) है"},"o":[{"en":"Input and Storage","hi":"इनपुट और स्टोरेज"},{"en":"Arranging by price is sorting. Finding the total is calculation/summarization","hi":"मूल्य के क्रम में व्यवस्थित करना 'सॉर्टिंग' (sorting) है। कुल (total) निकालना गणना/संक्षेपीकरण (calculation/summarization) है"},{"en":"Output and Deletion","hi":"आउटपुट और विलोपन (Deletion)"},{"en":"Scanning and Printing","hi":"स्कैनिंग और प्रिंटिंग"}],"exp":{"en":"Sorting changes the order of data (e.g., by price), while summarization or calculation aggregates data (e.g., finding the total sum).","hi":"सॉर्टिंग डेटा का क्रम बदलता है (जैसे, मूल्य के अनुसार), जबकि संक्षेपीकरण या गणना डेटा को एकत्रित करता है (जैसे, कुल योग निकालना)।"},"num":24}]},{"title":{"en":"3. Mean, Median & Mode","hi":"3. माध्य, माध्यिका और बहुलक"},"questions":[{"id":"q25","q":{"en":"What is the meaning of central tendency?","hi":"केंद्रीय प्रवृत्ति (Central tendency) का क्या अर्थ है?"},"a":{"en":"Summarizing the typical or central value of a dataset. Common measures are mean, median, and mode","hi":"किसी डेटासेट के विशिष्ट (typical) या केंद्रीय मान (central value) को सारांशित करना। इसके सामान्य उपाय (measures) माध्य (mean), माध्यिका (median) और बहुलक (mode) हैं"},"o":[{"en":"The highest value in a dataset","hi":"डेटासेट में उच्चतम मान"},{"en":"Summarizing the typical or central value of a dataset. Common measures are mean, median, and mode","hi":"किसी डेटासेट के विशिष्ट (typical) या केंद्रीय मान (central value) को सारांशित करना। इसके सामान्य उपाय (measures) माध्य (mean), माध्यिका (median) और बहुलक (mode) हैं"},{"en":"The difference between maximum and minimum","hi":"अधिकतम और न्यूनतम के बीच का अंतर"},{"en":"The total sum of all values","hi":"सभी मानों का कुल योग"}],"exp":{"en":"A measure of central tendency is a single value that attempts to describe a set of data by identifying the central position within that set.","hi":"केंद्रीय प्रवृत्ति (central tendency) का माप एक एकल मान है जो डेटा के एक सेट के भीतर केंद्रीय स्थिति की पहचान करके उस डेटा का वर्णन करने का प्रयास करता है।"},"num":25},{"id":"q26","q":{"en":"What is the formula for arithmetic mean?","hi":"अंकगणितीय माध्य (Arithmetic mean) का सूत्र क्या है?"},"a":{"en":"x̄ = (x₁ + x₂ + ... + xₙ) ÷ n. (i.e., Total sum ÷ number of observations)","hi":"x̄ = (x₁ + x₂ + ... + xₙ) ÷ n. (यानी कुल योग ÷ अवलोकनों की संख्या)"},"o":[{"en":"x̄ = (Maximum + Minimum) ÷ 2","hi":"x̄ = (Maximum + Minimum) ÷ 2"},{"en":"x̄ = (x₁ + x₂ + ... + xₙ) ÷ n. (i.e., Total sum ÷ number of observations)","hi":"x̄ = (x₁ + x₂ + ... + xₙ) ÷ n. (यानी कुल योग ÷ अवलोकनों की संख्या)"},{"en":"x̄ = n ÷ Total sum","hi":"x̄ = n ÷ Total sum"},{"en":"x̄ = Maximum - Minimum","hi":"x̄ = Maximum - Minimum"}],"exp":{"en":"The mean is calculated by adding all the numerical values in a dataset and then dividing by the number of values.","hi":"माध्य (Mean) की गणना डेटासेट में सभी संख्यात्मक मानों को जोड़कर और फिर मानों की कुल संख्या से विभाजित करके की जाती है।"},"num":26},{"id":"q27","q":{"en":"What is the mean of the values 4, 7, and 10?","hi":"मूल्यों (values) 4, 7 और 10 का माध्य (mean) क्या है?"},"a":{"en":"7. Because (4 + 7 + 10) ÷ 3 = 21 ÷ 3 = 7","hi":"7. क्योंकि (4 + 7 + 10) ÷ 3 = 21 ÷ 3 = 7"},"o":[{"en":"6","hi":"6"},{"en":"7. Because (4 + 7 + 10) ÷ 3 = 21 ÷ 3 = 7","hi":"7. क्योंकि (4 + 7 + 10) ÷ 3 = 21 ÷ 3 = 7"},{"en":"8","hi":"8"},{"en":"21","hi":"21"}],"exp":{"en":"Sum = 4+7+10 = 21. Total count = 3. Mean = 21/3 = 7.","hi":"योग = 4+7+10 = 21. कुल संख्या = 3. माध्य = 21/3 = 7."},"num":27},{"id":"q28","q":{"en":"What is the first step to find the median?","hi":"माध्यिका (Median) निकालने का पहला कदम क्या है?"},"a":{"en":"Arranging the values in ascending or descending order","hi":"मानों (values) को आरोही (ascending) या अवरोही (descending) क्रम में व्यवस्थित करना"},"o":[{"en":"Divide by 2","hi":"2 से विभाजित करना"},{"en":"Arranging the values in ascending or descending order","hi":"मानों (values) को आरोही (ascending) या अवरोही (descending) क्रम में व्यवस्थित करना"},{"en":"Adding all the values","hi":"सभी मानों को जोड़ना"},{"en":"Finding the most frequent value","hi":"सबसे अधिक बार आने वाले मान को खोजना"}],"exp":{"en":"Before finding the middle value (median), the data must be sorted either from lowest to highest or highest to lowest.","hi":"मध्य मान (माध्यिका) खोजने से पहले, डेटा को निम्नतम से उच्चतम या उच्चतम से निम्नतम (sorted) क्रम में व्यवस्थित किया जाना चाहिए।"},"num":28},{"id":"q29","q":{"en":"What is the position of the median in an odd number of observations?","hi":"अवलोकनों की विषम संख्या (odd number) में माध्यिका (median) की स्थिति (position) क्या होती है?"},"a":{"en":"In a sorted list, it is the (n + 1) ÷ 2 position. Example: Median of 1, 2, 3, 4, 5 is 3","hi":"एक क्रमबद्ध (sorted) सूची में, यह (n + 1) ÷ 2 स्थिति होती है। उदाहरण: 1, 2, 3, 4, 5 की माध्यिका 3 है"},"o":[{"en":"Position n","hi":"n स्थिति"},{"en":"In a sorted list, it is the (n + 1) ÷ 2 position. Example: Median of 1, 2, 3, 4, 5 is 3","hi":"एक क्रमबद्ध (sorted) सूची में, यह (n + 1) ÷ 2 स्थिति होती है। उदाहरण: 1, 2, 3, 4, 5 की माध्यिका 3 है"},{"en":"Position n ÷ 2","hi":"n ÷ 2 स्थिति"},{"en":"The very first value","hi":"सबसे पहला मान"}],"exp":{"en":"For an odd number of data points 'n', the median is exactly in the middle at position (n+1)/2 of the sorted list.","hi":"डेटा बिंदुओं 'n' की विषम संख्या (odd number) के लिए, माध्यिका क्रमबद्ध सूची के (n+1)/2 स्थिति पर ठीक बीच में होती है।"},"num":29},{"id":"q30","q":{"en":"How is the median calculated in an even number of observations?","hi":"अवलोकनों की सम संख्या (even number) में माध्यिका (median) कैसे निकाली जाती है?"},"a":{"en":"It is the mean of the values at the n/2 and (n/2 + 1) positions in the sorted list. Example: Median of 1, 2, 3, 4 is 2.5","hi":"यह क्रमबद्ध (sorted) सूची के n/2 और (n/2 + 1) स्थितियों (positions) के मानों का माध्य (mean) होता है। उदाहरण: 1, 2, 3, 4 की माध्यिका 2.5 है"},"o":[{"en":"It is the mean of the values at the n/2 and (n/2 + 1) positions in the sorted list. Example: Median of 1, 2, 3, 4 is 2.5","hi":"यह क्रमबद्ध (sorted) सूची के n/2 और (n/2 + 1) स्थितियों (positions) के मानों का माध्य (mean) होता है। उदाहरण: 1, 2, 3, 4 की माध्यिका 2.5 है"},{"en":"It is simply the n/2 position value","hi":"यह केवल n/2 स्थिति का मान है"},{"en":"It is the (n+1)/2 position value","hi":"यह (n+1)/2 स्थिति का मान है"},{"en":"An even dataset has no median","hi":"सम (even) डेटासेट में कोई माध्यिका नहीं होती है"}],"exp":{"en":"When 'n' is even, there are two middle values. The median is calculated as the average of these two middle values.","hi":"जब 'n' सम (even) होता है, तो दो मध्य मान होते हैं। माध्यिका की गणना इन दो मध्य मानों के औसत (average) के रूप में की जाती है।"},"num":30},{"id":"q31","q":{"en":"What is the median of the unsorted values 9, 2, 7, and 4?","hi":"अव्यवस्थित (unsorted) मानों 9, 2, 7 और 4 की माध्यिका क्या है?"},"a":{"en":"5.5 (Sorted: 2, 4, 7, 9. Middle values are 4 and 7, their mean is 5.5)","hi":"5.5 (क्रमबद्ध: 2, 4, 7, 9। बीच की वैल्यू 4 और 7 हैं, उनका माध्य 5.5 है)"},"o":[{"en":"2","hi":"2"},{"en":"5.5 (Sorted: 2, 4, 7, 9. Middle values are 4 and 7, their mean is 5.5)","hi":"5.5 (क्रमबद्ध: 2, 4, 7, 9। बीच की वैल्यू 4 और 7 हैं, उनका माध्य 5.5 है)"},{"en":"4.5","hi":"4.5"},{"en":"7","hi":"7"}],"exp":{"en":"First, sort: 2, 4, 7, 9. The middle two are 4 and 7. The average of 4 and 7 is 5.5.","hi":"सबसे पहले क्रमित (sort) करें: 2, 4, 7, 9। बीच के दो 4 और 7 हैं। 4 और 7 का औसत 5.5 है।"},"num":31},{"id":"q32","q":{"en":"What is mode?","hi":"बहुलक (Mode) क्या है?"},"a":{"en":"The value or category that appears most frequently (has the highest frequency)","hi":"वह मान (value) या श्रेणी जो सबसे अधिक बार आती है (जिसकी आवृत्ति/frequency सबसे अधिक होती है)"},"o":[{"en":"The average of all numbers","hi":"सभी संख्याओं का औसत"},{"en":"The value or category that appears most frequently (has the highest frequency)","hi":"वह मान (value) या श्रेणी जो सबसे अधिक बार आती है (जिसकी आवृत्ति/frequency सबसे अधिक होती है)"},{"en":"The middle value","hi":"मध्य मान"},{"en":"The difference between maximum and minimum","hi":"अधिकतम और न्यूनतम के बीच का अंतर"}],"exp":{"en":"The mode is the value that appears most often in a set of data values.","hi":"बहुलक (Mode) वह मान है जो डेटा मानों के समूह में सबसे अधिक बार आता है।"},"num":32},{"id":"q33","q":{"en":"Can mode be found for non-numeric data?","hi":"क्या गैर-संख्यात्मक (non-numeric) डेटा के लिए बहुलक (mode) निकाला जा सकता है?"},"a":{"en":"Yes. For example, the mode of Red, Blue, Red, Green is Red","hi":"हाँ। उदाहरण के लिए, Red, Blue, Red, Green का बहुलक Red है"},"o":[{"en":"No, mode is only for numbers","hi":"नहीं, बहुलक केवल संख्याओं के लिए है"},{"en":"Yes. For example, the mode of Red, Blue, Red, Green is Red","hi":"हाँ। उदाहरण के लिए, Red, Blue, Red, Green का बहुलक Red है"},{"en":"Only if it can be converted to binary","hi":"केवल तभी जब इसे बाइनरी में बदला जा सके"},{"en":"Yes, but it is called median instead","hi":"हाँ, लेकिन इसे इसके बजाय माध्यिका (median) कहा जाता है"}],"exp":{"en":"Unlike mean and median, the mode can be applied to categorical (non-numeric) data to find the most popular category.","hi":"माध्य और माध्यिका के विपरीत, सबसे लोकप्रिय श्रेणी का पता लगाने के लिए बहुलक (mode) को श्रेणीबद्ध (गैर-संख्यात्मक) डेटा पर लागू किया जा सकता है।"},"num":33},{"id":"q34","q":{"en":"Can a dataset have multiple modes?","hi":"क्या किसी डेटासेट में कई बहुलक (multiple modes) हो सकते हैं?"},"a":{"en":"Yes. For example, in 1, 1, 2, 2, 3, both 1 and 2 are equally most frequent, so the dataset is bimodal","hi":"हाँ। उदाहरण के लिए, 1, 1, 2, 2, 3 में 1 और 2 दोनों समान रूप से सबसे अधिक बार आते हैं, इसलिए डेटासेट द्वि-बहुलक (bimodal) है"},"o":[{"en":"No, a dataset always has exactly one mode","hi":"नहीं, डेटासेट में हमेशा ठीक एक ही बहुलक होता है"},{"en":"Yes. For example, in 1, 1, 2, 2, 3, both 1 and 2 are equally most frequent, so the dataset is bimodal","hi":"हाँ। उदाहरण के लिए, 1, 1, 2, 2, 3 में 1 और 2 दोनों समान रूप से सबसे अधिक बार आते हैं, इसलिए डेटासेट द्वि-बहुलक (bimodal) है"},{"en":"Only if the dataset is larger than 100 values","hi":"केवल तभी जब डेटासेट 100 मानों से बड़ा हो"},{"en":"Yes, but they must all be prime numbers","hi":"हाँ, लेकिन वे सभी अभाज्य (prime) संख्याएँ होनी चाहिए"}],"exp":{"en":"If two values appear with the same highest frequency, the data is bimodal. If more than two, it is multimodal.","hi":"यदि दो मान एक ही उच्चतम आवृत्ति (frequency) के साथ आते हैं, तो डेटा द्वि-बहुलक (bimodal) है। यदि दो से अधिक हैं, तो यह बहु-बहुलक (multimodal) है।"},"num":34},{"id":"q35","q":{"en":"Which is more affected by an outlier: mean or median?","hi":"माध्य (mean) और माध्यिका (median) में से कौन सा आउटलायर (outlier - चरम मान) से अधिक प्रभावित होता है?"},"a":{"en":"Usually the mean. Example: Mean of 2, 3, 4 is 3, but mean of 2, 3, 100 is 35. The median for both is 3","hi":"आमतौर पर माध्य (mean)। उदाहरण: 2, 3, 4 का माध्य 3 है, लेकिन 2, 3, 100 का माध्य 35 है। दोनों के लिए माध्यिका 3 है"},"o":[{"en":"Median","hi":"माध्यिका"},{"en":"Usually the mean. Example: Mean of 2, 3, 4 is 3, but mean of 2, 3, 100 is 35. The median for both is 3","hi":"आमतौर पर माध्य (mean)। उदाहरण: 2, 3, 4 का माध्य 3 है, लेकिन 2, 3, 100 का माध्य 35 है। दोनों के लिए माध्यिका 3 है"},{"en":"Both are affected equally","hi":"दोनों समान रूप से प्रभावित होते हैं"},{"en":"Neither is affected","hi":"कोई भी प्रभावित नहीं होता है"}],"exp":{"en":"The mean uses all values in its calculation, so extreme outliers skew it heavily. The median only looks at the central position, making it robust against outliers.","hi":"माध्य अपनी गणना में सभी मानों का उपयोग करता है, इसलिए चरम आउटलायर इसे भारी रूप से तिरछा (skew) कर देते हैं। माध्यिका केवल केंद्रीय स्थिति को देखती है, जो इसे आउटलायर के प्रति मजबूत बनाती है।"},"num":35},{"id":"q36","q":{"en":"What is the median and mode of the inventory discounts 8, 5, 10, 0, 5, 12, 0?","hi":"इन्वेंट्री छूट (discounts) 8, 5, 10, 0, 5, 12, 0 की माध्यिका और बहुलक क्या है?"},"a":{"en":"Median: 5%. Modes: 0% and 5% (Sorted: 0, 0, 5, 5, 8, 10, 12)","hi":"माध्यिका: 5%। बहुलक: 0% और 5% (क्रमबद्ध: 0, 0, 5, 5, 8, 10, 12)"},"o":[{"en":"Median: 5%. Modes: 0% and 5% (Sorted: 0, 0, 5, 5, 8, 10, 12)","hi":"माध्यिका: 5%। बहुलक: 0% और 5% (क्रमबद्ध: 0, 0, 5, 5, 8, 10, 12)"},{"en":"Median: 0%. Mode: 12%","hi":"माध्यिका: 0%। बहुलक: 12%"},{"en":"Median: 8%. Mode: 5%","hi":"माध्यिका: 8%। बहुलक: 5%"},{"en":"Median: 10%. Mode: 0%","hi":"माध्यिका: 10%। बहुलक: 0%"}],"exp":{"en":"Sorting the list: 0, 0, 5, 5, 8, 10, 12. The middle value is 5. Both 0 and 5 appear twice, so it is bimodal.","hi":"सूची को क्रमबद्ध करना: 0, 0, 5, 5, 8, 10, 12. मध्य मान 5 है। 0 और 5 दोनों दो बार आते हैं, इसलिए यह द्वि-बहुलक (bimodal) है।"},"num":36}]},{"title":{"en":"4. Range, Variance & Standard Deviation","hi":"4. परास, प्रसरण और मानक विचलन"},"questions":[{"id":"q37","q":{"en":"What do measures of variability indicate?","hi":"परिवर्तनशीलता के माप (Measures of variability) क्या दर्शाते हैं?"},"a":{"en":"How spread out the values are. This is also called dispersion","hi":"मान (values) कितने फैले हुए हैं (spread out)। इसे विक्षेपण (dispersion) भी कहा जाता है"},"o":[{"en":"How fast a computer processes data","hi":"कंप्यूटर कितनी तेजी से डेटा प्रोसेस करता है"},{"en":"How spread out the values are. This is also called dispersion","hi":"मान (values) कितने फैले हुए हैं (spread out)। इसे विक्षेपण (dispersion) भी कहा जाता है"},{"en":"The exact middle of the dataset","hi":"डेटासेट का बिल्कुल मध्य भाग"},{"en":"The total sum of all values","hi":"सभी मानों का कुल योग"}],"exp":{"en":"Variability (or dispersion) tells us how far the data points are spread away from the center (mean/median).","hi":"परिवर्तनशीलता (या विक्षेपण / dispersion) हमें बताती है कि डेटा बिंदु केंद्र (माध्य/माध्यिका) से कितनी दूर फैले हुए हैं।"},"num":37},{"id":"q38","q":{"en":"What are the common measures of dispersion according to the source?","hi":"स्रोत के अनुसार विक्षेपण (dispersion) के सामान्य उपाय कौन से हैं?"},"a":{"en":"Range and Standard Deviation","hi":"रेंज (Range) और मानक विचलन (Standard Deviation)"},"o":[{"en":"Mean and Median","hi":"माध्य और माध्यिका"},{"en":"Range and Standard Deviation","hi":"रेंज (Range) और मानक विचलन (Standard Deviation)"},{"en":"Mode and Average","hi":"बहुलक और औसत"},{"en":"Input and Output","hi":"इनपुट और आउटपुट"}],"exp":{"en":"The text highlights Range and Standard Deviation (along with Variance) as key metrics for measuring data dispersion.","hi":"टेक्स्ट डेटा विक्षेपण को मापने के लिए प्रमुख मेट्रिक्स के रूप में रेंज (Range) और मानक विचलन (Variance के साथ) पर प्रकाश डालता है।"},"num":38},{"id":"q39","q":{"en":"What is the formula for range?","hi":"रेंज (Range) का सूत्र क्या है?"},"a":{"en":"Maximum − Minimum","hi":"अधिकतम − न्यूनतम"},"o":[{"en":"Maximum + Minimum","hi":"अधिकतम + न्यूनतम"},{"en":"Maximum − Minimum","hi":"अधिकतम − न्यूनतम"},{"en":"(Maximum + Minimum) ÷ 2","hi":"(अधिकतम + न्यूनतम) ÷ 2"},{"en":"Total sum ÷ n","hi":"कुल योग ÷ n"}],"exp":{"en":"The range is the simplest measure of variability, calculated by subtracting the smallest value from the largest value in a dataset.","hi":"रेंज (Range) परिवर्तनशीलता का सबसे सरल माप है, जिसकी गणना डेटासेट में सबसे बड़े मान से सबसे छोटे मान को घटाकर की जाती है।"},"num":39},{"id":"q40","q":{"en":"What is the range of 2, 6, 10, and 11?","hi":"2, 6, 10 और 11 की रेंज (Range) क्या है?"},"a":{"en":"9 (Because 11 − 2 = 9)","hi":"9 (क्योंकि 11 − 2 = 9)"},"o":[{"en":"9 (Because 11 − 2 = 9)","hi":"9 (क्योंकि 11 − 2 = 9)"},{"en":"11","hi":"11"},{"en":"2","hi":"2"},{"en":"6.5","hi":"6.5"}],"exp":{"en":"Max value = 11. Min value = 2. Range = 11 - 2 = 9.","hi":"अधिकतम मान = 11. न्यूनतम मान = 2. रेंज = 11 - 2 = 9."},"num":40},{"id":"q41","q":{"en":"What is the difference between range and midrange?","hi":"रेंज (Range) और मिडरेंज (Midrange) में क्या अंतर है?"},"a":{"en":"Range is max - min. Midrange is (max + min) ÷ 2","hi":"रेंज (max - min) है। मिडरेंज (max + min) ÷ 2 है"},"o":[{"en":"Range is max - min. Midrange is (max + min) ÷ 2","hi":"रेंज (max - min) है। मिडरेंज (max + min) ÷ 2 है"},{"en":"There is no difference","hi":"कोई अंतर नहीं है"},{"en":"Range is for odd numbers, midrange is for even numbers","hi":"रेंज विषम संख्याओं के लिए है, मिडरेंज सम संख्याओं के लिए है"},{"en":"Range is max + min. Midrange is max - min","hi":"रेंज (max + min) है। मिडरेंज (max - min) है"}],"exp":{"en":"The range gives the total spread, whereas the midrange gives the exact halfway point between the lowest and highest values.","hi":"रेंज कुल फैलाव (spread) बताती है, जबकि मिडरेंज सबसे कम और उच्चतम मानों के बीच का सटीक मध्य बिंदु बताता है।"},"num":41},{"id":"q42","q":{"en":"What is the main limitation of range?","hi":"रेंज (Range) की मुख्य सीमा (limitation) क्या है?"},"a":{"en":"It only uses the minimum and maximum, so it can be strongly affected by outliers","hi":"यह केवल न्यूनतम (minimum) और अधिकतम (maximum) का उपयोग करता है, इसलिए यह आउटलायर (outliers) से बहुत अधिक प्रभावित हो सकता है"},"o":[{"en":"It is too difficult to calculate","hi":"इसकी गणना करना बहुत कठिन है"},{"en":"It only uses the minimum and maximum, so it can be strongly affected by outliers","hi":"यह केवल न्यूनतम (minimum) और अधिकतम (maximum) का उपयोग करता है, इसलिए यह आउटलायर (outliers) से बहुत अधिक प्रभावित हो सकता है"},{"en":"It only works with binary numbers","hi":"यह केवल बाइनरी संख्याओं के साथ काम करता है"},{"en":"It requires at least 100 data points","hi":"इसके लिए कम से कम 100 डेटा पॉइंट की आवश्यकता होती है"}],"exp":{"en":"Because the range ignores all the values in between the extremes, a single unusually high or low value (outlier) can make the data seem more spread out than it really is.","hi":"चूंकि रेंज अधिकतम और न्यूनतम के बीच के सभी मानों को अनदेखा करती है, इसलिए एक असामान्य रूप से उच्च या निम्न मान (आउटलायर) यह दिखा सकता है कि डेटा वास्तव में जितना है, उससे कहीं अधिक फैला हुआ है।"},"num":42},{"id":"q43","q":{"en":"What is the basic idea of variance?","hi":"विचरण (Variance) का मूल विचार (basic idea) क्या है?"},"a":{"en":"An average-type measure calculated by squaring the deviations from the mean. For population variance, the denominator is n","hi":"माध्य (mean) से विचलनों (deviations) का वर्ग (square) करके मापा गया एक औसत-प्रकार का माप। जनसंख्या विचरण (population variance) के लिए हर (denominator) n है"},"o":[{"en":"It is the sum of all numbers","hi":"यह सभी संख्याओं का योग है"},{"en":"An average-type measure calculated by squaring the deviations from the mean. For population variance, the denominator is n","hi":"माध्य (mean) से विचलनों (deviations) का वर्ग (square) करके मापा गया एक औसत-प्रकार का माप। जनसंख्या विचरण (population variance) के लिए हर (denominator) n है"},{"en":"It is the difference between mean and median","hi":"यह माध्य और माध्यिका के बीच का अंतर है"},{"en":"It counts how many items are in the dataset","hi":"यह गिनता है कि डेटासेट में कितने आइटम हैं"}],"exp":{"en":"Variance quantifies dispersion by averaging the squared differences between each data point and the mean.","hi":"विचरण (Variance) प्रत्येक डेटा बिंदु और माध्य (mean) के बीच के वर्ग अंतर (squared differences) का औसत निकालकर विक्षेपण (dispersion) की मात्रा निर्धारित करता है।"},"num":43},{"id":"q44","q":{"en":"What is the formula for population standard deviation?","hi":"जनसंख्या मानक विचलन (Population standard deviation) का सूत्र क्या है?"},"a":{"en":"σ = √[Σ(xᵢ − μ)² ÷ n], where μ is the mean of the dataset","hi":"σ = √[Σ(xᵢ − μ)² ÷ n], जहाँ μ डेटासेट का माध्य है"},"o":[{"en":"σ = Σ(xᵢ − μ)","hi":"σ = Σ(xᵢ − μ)"},{"en":"σ = √[Σ(xᵢ − μ)² ÷ n], where μ is the mean of the dataset","hi":"σ = √[Σ(xᵢ − μ)² ÷ n], जहाँ μ डेटासेट का माध्य है"},{"en":"σ = (Maximum - Minimum) ÷ 2","hi":"σ = (Maximum - Minimum) ÷ 2"},{"en":"σ = n ÷ Σ(xᵢ)","hi":"σ = n ÷ Σ(xᵢ)"}],"exp":{"en":"The standard deviation is the square root of the variance. It returns the measure of dispersion back to the original units of the data.","hi":"मानक विचलन विचरण (variance) का वर्गमूल (square root) है। यह विक्षेपण के माप को वापस डेटा की मूल इकाइयों में लौटाता है।"},"num":44},{"id":"q45","q":{"en":"What is the step order to calculate standard deviation?","hi":"मानक विचलन (standard deviation) की गणना करने का चरण क्रम (step order) क्या है?"},"a":{"en":"Mean → deviations → square each deviation → mean of squared deviations → square root","hi":"माध्य → विचलन → प्रत्येक विचलन का वर्ग करें → वर्ग विचलनों का माध्य → वर्गमूल"},"o":[{"en":"Square root → Mean → Deviations","hi":"वर्गमूल → माध्य → विचलन"},{"en":"Mean → deviations → square each deviation → mean of squared deviations → square root","hi":"माध्य → विचलन → प्रत्येक विचलन का वर्ग करें → वर्ग विचलनों का माध्य → वर्गमूल"},{"en":"Deviations → Square root → Mean","hi":"विचलन → वर्गमूल → माध्य"},{"en":"Sort → Median → Square root","hi":"क्रमबद्ध करें → माध्यिका → वर्गमूल"}],"exp":{"en":"The process is: find the mean, find each value's distance (deviation) from the mean, square those distances, find the average of those squares (variance), and finally take the square root.","hi":"प्रक्रिया है: माध्य खोजें, माध्य से प्रत्येक मान की दूरी (विचलन) ज्ञात करें, उन दूरियों का वर्ग करें, उन वर्गों का औसत खोजें (विचरण), और अंत में वर्गमूल लें।"},"num":45},{"id":"q46","q":{"en":"What is the population standard deviation of 1, 2, 3, and 4?","hi":"1, 2, 3 और 4 का जनसंख्या मानक विचलन क्या है?"},"a":{"en":"1.118 (Mean=2.5. Squared deviations: 2.25, 0.25, 0.25, 2.25. Variance: 5÷4=1.25. SD=√1.25 ≈ 1.118)","hi":"1.118 (माध्य 2.5। वर्गाकार विचलन: 2.25, 0.25, 0.25, 2.25। विचरण: 5÷4=1.25। SD = √1.25 ≈ 1.118)"},"o":[{"en":"1.25","hi":"1.25"},{"en":"1.118 (Mean=2.5. Squared deviations: 2.25, 0.25, 0.25, 2.25. Variance: 5÷4=1.25. SD=√1.25 ≈ 1.118)","hi":"1.118 (माध्य 2.5। वर्गाकार विचलन: 2.25, 0.25, 0.25, 2.25। विचरण: 5÷4=1.25। SD = √1.25 ≈ 1.118)"},{"en":"2.5","hi":"2.5"},{"en":"5","hi":"5"}],"exp":{"en":"Following the formula: The sum of squared deviations is 5. Dividing by n (4) gives a variance of 1.25. The square root of 1.25 is approximately 1.118.","hi":"सूत्र के अनुसार: वर्ग विचलनों का योग 5 है। n (4) से विभाजित करने पर 1.25 का विचरण (variance) प्राप्त होता है। 1.25 का वर्गमूल लगभग 1.118 है।"},"num":46},{"id":"q47","q":{"en":"What is the exam distinction regarding the denominator in population SD and sample SD?","hi":"जनसंख्या SD (Population SD) और नमूना SD (Sample SD) में हर (denominator) के संबंध में परीक्षा का अंतर क्या है?"},"a":{"en":"For a complete population, it is n. The usual sample SD formula uses n−1 when estimating population spread from a sample","hi":"संपूर्ण जनसंख्या के लिए n है। सामान्य नमूना (sample) SD सूत्र n−1 का उपयोग करता है जब नमूने से जनसंख्या प्रसार (population spread) का अनुमान लगाया जाता है"},"o":[{"en":"Both use n","hi":"दोनों n का उपयोग करते हैं"},{"en":"For a complete population, it is n. The usual sample SD formula uses n−1 when estimating population spread from a sample","hi":"संपूर्ण जनसंख्या के लिए n है। सामान्य नमूना (sample) SD सूत्र n−1 का उपयोग करता है जब नमूने से जनसंख्या प्रसार (population spread) का अनुमान लगाया जाता है"},{"en":"Population uses n−1, sample uses n","hi":"जनसंख्या n−1 का उपयोग करती है, नमूना n का उपयोग करता है"},{"en":"Both use n−1","hi":"दोनों n−1 का उपयोग करते हैं"}],"exp":{"en":"When you only have a sample of data but want to estimate the standard deviation of the whole population, you divide by n-1 (Bessel's correction) to get a more accurate, unbiased estimate.","hi":"जब आपके पास डेटा का केवल एक नमूना (sample) होता है, लेकिन आप पूरी आबादी के मानक विचलन का अनुमान लगाना चाहते हैं, तो अधिक सटीक अनुमान प्राप्त करने के लिए आप n-1 (बैसेल सुधार) से विभाजित करते हैं।"},"num":47},{"id":"q48","q":{"en":"What will be the range and SD if all values are equal?","hi":"यदि सभी मान (values) समान हैं तो रेंज और SD क्या होंगे?"},"a":{"en":"Both 0, because the spread and deviations are zero","hi":"दोनों 0, क्योंकि फैलाव (spread) और विचलन शून्य हैं"},"o":[{"en":"Range will be maximum, SD will be minimum","hi":"रेंज अधिकतम होगी, SD न्यूनतम होगा"},{"en":"Both 0, because the spread and deviations are zero","hi":"दोनों 0, क्योंकि फैलाव (spread) और विचलन शून्य हैं"},{"en":"Both will be equal to the mean","hi":"दोनों माध्य (mean) के बराबर होंगे"},{"en":"They cannot be calculated","hi":"इनकी गणना नहीं की जा सकती"}],"exp":{"en":"If all values in a dataset are identical, there is no variation or spread. Therefore, measures of dispersion (range, variance, standard deviation) are all exactly zero.","hi":"यदि किसी डेटासेट में सभी मान समान हैं, तो कोई भिन्नता या फैलाव नहीं है। इसलिए, विक्षेपण के उपाय (रेंज, विचरण, मानक विचलन) सभी बिल्कुल शून्य हैं।"},"num":48},{"id":"q49","q":{"en":"What is the difference in the units of variance and standard deviation?","hi":"विचरण (Variance) और मानक विचलन (Standard deviation) की इकाइयों (units) में क्या अंतर है?"},"a":{"en":"Variance is in squared units. SD is in the original units of the data","hi":"विचरण (Variance) वर्गाकार इकाइयों (squared units) में होता है। SD डेटा की मूल इकाइयों (original units) में होता है"},"o":[{"en":"Variance is in original units. SD is in squared units","hi":"विचरण मूल इकाइयों में है। SD वर्गाकार इकाइयों में है"},{"en":"Variance is in squared units. SD is in the original units of the data","hi":"विचरण (Variance) वर्गाकार इकाइयों (squared units) में होता है। SD डेटा की मूल इकाइयों (original units) में होता है"},{"en":"There is no difference","hi":"कोई अंतर नहीं है"},{"en":"Variance has no units","hi":"विचरण की कोई इकाई नहीं होती"}],"exp":{"en":"Because variance calculates the average of the *squared* deviations, its units are squared (e.g., dollars squared). Standard deviation takes the square root, returning to the original units (e.g., dollars).","hi":"चूँकि विचरण *वर्गाकार* विचलनों के औसत की गणना करता है, इसलिए इसकी इकाइयाँ वर्गाकार होती हैं। मानक विचलन वर्गमूल लेता है, जिससे मूल इकाइयाँ वापस आ जाती हैं।"},"num":49}]},{"title":{"en":"5. Bits, Bytes, Encoding, ASCII, ISCII & Unicode","hi":"5. बिट्स, बाइट्स, एन्कोडिंग, ASCII, ISCII और यूनिकोड"},"questions":[{"id":"q50","q":{"en":"What is data representation?","hi":"डेटा निरूपण (Data representation) क्या है?"},"a":{"en":"Representing numbers, text, images, or audio into bit patterns suitable for processing and storage in a computer","hi":"कंप्यूटर में प्रोसेसिंग और स्टोरेज के लिए संख्याओं, टेक्स्ट, इमेज या ऑडियो को बिट पैटर्न (bit patterns) में प्रस्तुत करना (Representing)"},"o":[{"en":"Drawing charts and graphs","hi":"चार्ट और ग्राफ़ बनाना"},{"en":"Representing numbers, text, images, or audio into bit patterns suitable for processing and storage in a computer","hi":"कंप्यूटर में प्रोसेसिंग और स्टोरेज के लिए संख्याओं, टेक्स्ट, इमेज या ऑडियो को बिट पैटर्न (bit patterns) में प्रस्तुत करना (Representing)"},{"en":"Printing data on paper","hi":"डेटा को कागज पर छापना"},{"en":"Translating software into different languages","hi":"सॉफ्टवेयर का विभिन्न भाषाओं में अनुवाद करना"}],"exp":{"en":"Computers can only understand binary data. Data representation is the process of converting various types of information (text, sound, images) into a format of 0s and 1s.","hi":"कंप्यूटर केवल बाइनरी डेटा समझ सकता है। डेटा निरूपण विभिन्न प्रकार की सूचनाओं (टेक्स्ट, ध्वनि, चित्र) को 0 और 1 के प्रारूप में परिवर्तित करने की प्रक्रिया है।"},"num":50},{"id":"q51","q":{"en":"What is the full form of Bit and what are its possible values?","hi":"बिट (Bit) का फुल फॉर्म क्या है और इसके संभावित मान (possible values) क्या हैं?"},"a":{"en":"Binary Digit. Its two possible values are 0 and 1","hi":"बाइनरी डिजिट (Binary digit)। इसके दो संभावित मान 0 और 1 हैं"},"o":[{"en":"Basic Input Text. Values: A to Z","hi":"बेसिक इनपुट टेक्स्ट। मान: A से Z"},{"en":"Binary Digit. Its two possible values are 0 and 1","hi":"बाइनरी डिजिट (Binary digit)। इसके दो संभावित मान 0 और 1 हैं"},{"en":"Byte Integer Table. Values: 0 to 9","hi":"बाइट इंटीजर टेबल। मान: 0 से 9"},{"en":"Big Information Transfer. Values: True or False","hi":"बिग इंफॉर्मेशन ट्रांसफर। मान: True या False"}],"exp":{"en":"A 'bit' is a portmanteau of 'binary digit'. It is the most basic unit of information in computing, represented as either a 0 or a 1.","hi":"एक 'बिट' 'बाइनरी डिजिट' का संक्षिप्त रूप है। यह कंप्यूटिंग में सूचना की सबसे बुनियादी इकाई है, जिसे 0 या 1 के रूप में दर्शाया जाता है।"},"num":51},{"id":"q52","q":{"en":"How many bits are in a byte and a nibble?","hi":"एक बाइट (byte) और एक निबल (nibble) में कितने बिट होते हैं?"},"a":{"en":"Byte = 8 bits. Nibble = 4 bits","hi":"बाइट = 8 बिट्स (bits)। निबल = 4 बिट्स (bits)"},"o":[{"en":"Byte = 4 bits. Nibble = 8 bits","hi":"बाइट = 4 बिट्स। निबल = 8 बिट्स"},{"en":"Byte = 8 bits. Nibble = 4 bits","hi":"बाइट = 8 बिट्स (bits)। निबल = 4 बिट्स (bits)"},{"en":"Byte = 10 bits. Nibble = 5 bits","hi":"बाइट = 10 बिट्स। निबल = 5 बिट्स"},{"en":"Byte = 16 bits. Nibble = 8 bits","hi":"बाइट = 16 बिट्स। निबल = 8 बिट्स"}],"exp":{"en":"A byte consists of 8 bits. Half a byte (4 bits) is called a nibble.","hi":"एक बाइट में 8 बिट होते हैं। आधे बाइट (4 बिट) को निबल कहा जाता है।"},"num":52},{"id":"q53","q":{"en":"Why do digital circuits use binary?","hi":"डिजिटल सर्किट बाइनरी का उपयोग क्यों करते हैं?"},"a":{"en":"Transistor-based circuits reliably represent two logic levels, which are considered as 0 and 1","hi":"ट्रांजिस्टर-आधारित सर्किट (Transistor-based circuits) विश्वसनीय रूप से दो तर्क स्तरों (logic levels) का प्रतिनिधित्व करते हैं, जिन्हें 0 और 1 माना जाता है"},"o":[{"en":"Because it looks cool","hi":"क्योंकि यह अच्छा दिखता है"},{"en":"Because they only have two wires","hi":"क्योंकि उनमें केवल दो तार होते हैं"},{"en":"Transistor-based circuits reliably represent two logic levels, which are considered as 0 and 1","hi":"ट्रांजिस्टर-आधारित सर्किट (Transistor-based circuits) विश्वसनीय रूप से दो तर्क स्तरों (logic levels) का प्रतिनिधित्व करते हैं, जिन्हें 0 और 1 माना जाता है"},{"en":"Because base-10 math is too hard","hi":"क्योंकि बेस-10 गणित बहुत कठिन है"}],"exp":{"en":"Electronic components like transistors essentially function as switches with two stable states: on (voltage present, represented as 1) and off (no voltage, represented as 0).","hi":"इलेक्ट्रॉनिक घटक जैसे ट्रांजिस्टर अनिवार्य रूप से दो स्थिर अवस्थाओं वाले स्विच के रूप में कार्य करते हैं: ऑन (वोल्टेज मौजूद है, जिसे 1 के रूप में दर्शाया गया है) और ऑफ (कोई वोल्टेज नहीं, जिसे 0 के रूप में दर्शाया गया है)।"},"num":53},{"id":"q54","q":{"en":"What does encoding do?","hi":"एन्कोडिंग (Encoding) क्या करती है?"},"a":{"en":"It maps information into an agreed code or byte format so that software can store, process, and interpret it","hi":"यह जानकारी को एक सहमत कोड या बाइट प्रारूप (agreed code or byte format) में मैप करती है, ताकि सॉफ्टवेयर इसे स्टोर, प्रोसेस और व्याख्या (interpret) कर सके"},"o":[{"en":"It deletes files","hi":"यह फाइलें डिलीट करती है"},{"en":"It maps information into an agreed code or byte format so that software can store, process, and interpret it","hi":"यह जानकारी को एक सहमत कोड या बाइट प्रारूप (agreed code or byte format) में मैप करती है, ताकि सॉफ्टवेयर इसे स्टोर, प्रोसेस और व्याख्या (interpret) कर सके"},{"en":"It creates computer viruses","hi":"यह कंप्यूटर वायरस बनाती है"},{"en":"It increases internet speed","hi":"यह इंटरनेट की गति बढ़ाती है"}],"exp":{"en":"Encoding assigns a specific, standardized sequence of bits (like a number) to characters, ensuring different systems understand the data the same way.","hi":"एन्कोडिंग वर्णों (characters) को बिट्स का एक विशिष्ट, मानकीकृत अनुक्रम (sequence) निर्दिष्ट करती है, जिससे यह सुनिश्चित होता है कि विभिन्न सिस्टम डेटा को एक ही तरह से समझते हैं।"},"num":54},{"id":"q55","q":{"en":"What is the full form of ASCII?","hi":"ASCII का फुल फॉर्म क्या है?"},"a":{"en":"American Standard Code for Information Interchange","hi":"अमेरिकन स्टैंडर्ड कोड फॉर इंफॉर्मेशन इंटरचेंज"},"o":[{"en":"Advanced Standard Code for Internet Interface","hi":"एडवांस्ड स्टैंडर्ड कोड फॉर इंटरनेट इंटरफ़ेस"},{"en":"American Standard Code for Information Interchange","hi":"अमेरिकन स्टैंडर्ड कोड फॉर इंफॉर्मेशन इंटरचेंज"},{"en":"Asian Standard Code for Information Interchange","hi":"एशियन स्टैंडर्ड कोड फॉर इंफॉर्मेशन इंटरचेंज"},{"en":"Automated System Code for Information Input","hi":"ऑटोमेटेड सिस्टम कोड फॉर इंफॉर्मेशन इनपुट"}],"exp":{"en":"ASCII is a standard character encoding format for electronic communication, originally based on the English alphabet.","hi":"ASCII इलेक्ट्रॉनिक संचार के लिए एक मानक कैरेक्टर एन्कोडिंग प्रारूप है, जो मूल रूप से अंग्रेजी वर्णमाला पर आधारित है।"},"num":55},{"id":"q56","q":{"en":"How many bits and code positions does Standard ASCII use?","hi":"स्टैंडर्ड ASCII कितने बिट्स और कितने कोड पोजीशन का उपयोग करता है?"},"a":{"en":"7 bits, 2⁷ = 128 positions, including printable characters and control codes","hi":"7 बिट्स, 2⁷ = 128 पोजीशन, जिसमें प्रिंट करने योग्य वर्ण (printable characters) और नियंत्रण कोड (control codes) शामिल हैं"},"o":[{"en":"8 bits, 256 positions","hi":"8 बिट्स, 256 पोजीशन"},{"en":"7 bits, 2⁷ = 128 positions, including printable characters and control codes","hi":"7 बिट्स, 2⁷ = 128 पोजीशन, जिसमें प्रिंट करने योग्य वर्ण (printable characters) और नियंत्रण कोड (control codes) शामिल हैं"},{"en":"16 bits, 65536 positions","hi":"16 बिट्स, 65536 पोजीशन"},{"en":"4 bits, 16 positions","hi":"4 बिट्स, 16 पोजीशन"}],"exp":{"en":"Original ASCII uses 7 bits, providing 128 distinct codes (0-127) for English letters, numbers, and basic punctuation.","hi":"मूल ASCII 7 बिट्स का उपयोग करता है, जो अंग्रेजी अक्षरों, संख्याओं और बुनियादी विराम चिह्नों के लिए 128 अलग-अलग कोड (0-127) प्रदान करता है।"},"num":56},{"id":"q57","q":{"en":"How should the 128 and 256 numbers of ASCII be understood?","hi":"ASCII के 128 और 256 संख्याओं को कैसे समझा जाना चाहिए?"},"a":{"en":"Standard ASCII has 128 codes. 8-bit code pages have 256 possible positions, whose upper-half mappings may vary","hi":"स्टैंडर्ड ASCII में 128 कोड होते हैं। 8-बिट कोड पेजों (8-bit code pages) में 256 संभावित स्थितियाँ होती हैं, जिनके ऊपरी-आधे भाग (upper-half mappings) अलग हो सकते हैं"},"o":[{"en":"There are 256 codes in standard ASCII","hi":"मानक ASCII में 256 कोड हैं"},{"en":"Standard ASCII has 128 codes. 8-bit code pages have 256 possible positions, whose upper-half mappings may vary","hi":"स्टैंडर्ड ASCII में 128 कोड होते हैं। 8-बिट कोड पेजों (8-bit code pages) में 256 संभावित स्थितियाँ होती हैं, जिनके ऊपरी-आधे भाग (upper-half mappings) अलग हो सकते हैं"},{"en":"They are exactly the same","hi":"वे बिल्कुल समान हैं"},{"en":"Both refer to Unicode","hi":"दोनों यूनिकोड का संदर्भ देते हैं"}],"exp":{"en":"The standard 7-bit ASCII defines codes 0-127. 'Extended ASCII' uses 8 bits (codes 0-255), but the codes from 128-255 are not universally standardized and depend on the specific 'code page' being used.","hi":"मानक 7-बिट ASCII कोड 0-127 को परिभाषित करता है। 'एक्सटेंडेड ASCII' 8 बिट्स (कोड 0-255) का उपयोग करता है, लेकिन 128-255 के कोड सार्वभौमिक रूप से मानकीकृत नहीं हैं।"},"num":57},{"id":"q58","q":{"en":"Which characters does ASCII cover?","hi":"ASCII किन कैरेक्टर्स को कवर करता है?"},"a":{"en":"Basic Latin letters, digits, common punctuation, and control codes. Broader encoding is required for scripts like Devanagari","hi":"बेसिक लैटिन अक्षर (लैटिन लेटर्स), अंक (डिजिट्स), सामान्य विराम चिह्न (कॉमन पंक्चुएशन) और नियंत्रण कोड (कंट्रोल कोड)। देवनागरी जैसी लिपियों के लिए व्यापक एन्कोडिंग (broader encoding) की आवश्यकता होती है"},"o":[{"en":"All languages in the world","hi":"दुनिया की सभी भाषाएँ"},{"en":"Basic Latin letters, digits, common punctuation, and control codes. Broader encoding is required for scripts like Devanagari","hi":"बेसिक लैटिन अक्षर (लैटिन लेटर्स), अंक (डिजिट्स), सामान्य विराम चिह्न (कॉमन पंक्चुएशन) और नियंत्रण कोड (कंट्रोल कोड)। देवनागरी जैसी लिपियों के लिए व्यापक एन्कोडिंग (broader encoding) की आवश्यकता होती है"},{"en":"Only numbers and punctuation","hi":"केवल संख्याएँ और विराम चिह्न"},{"en":"Only emojis","hi":"केवल इमोजी"}],"exp":{"en":"Because ASCII only has 128 slots, it is limited primarily to the English alphabet. It cannot represent characters from other languages like Hindi, Arabic, or Chinese.","hi":"चूँकि ASCII में केवल 128 स्लॉट होते हैं, इसलिए यह मुख्य रूप से अंग्रेजी वर्णमाला तक ही सीमित है। यह हिंदी, अरबी या चीनी जैसी अन्य भाषाओं के वर्णों का प्रतिनिधित्व नहीं कर सकता है।"},"num":58},{"id":"q59","q":{"en":"What are the decimal codes for uppercase A and the digit character '0' in ASCII?","hi":"ASCII में अपरकेस A और डिजिट कैरेक्टर '0' के लिए दशमलव कोड (decimal codes) क्या हैं?"},"a":{"en":"A = 65 (i.e., 01000001 in an 8-bit byte). Character '0' = 48 (i.e., 00110000)","hi":"A = 65, यानी एक 8-बिट बाइट में 01000001। कैरेक्टर '0' = 48, यानी 00110000"},"o":[{"en":"A = 1, '0' = 0","hi":"A = 1, '0' = 0"},{"en":"A = 65 (i.e., 01000001 in an 8-bit byte). Character '0' = 48 (i.e., 00110000)","hi":"A = 65, यानी एक 8-बिट बाइट में 01000001। कैरेक्टर '0' = 48, यानी 00110000"},{"en":"A = 97, '0' = 10","hi":"A = 97, '0' = 10"},{"en":"A = 255, '0' = 128","hi":"A = 255, '0' = 128"}],"exp":{"en":"In the ASCII table, capital 'A' corresponds to the decimal number 65, and the text character for zero ('0') corresponds to 48.","hi":"ASCII तालिका में, कैपिटल 'A' दशमलव संख्या 65 से मेल खाता है, और शून्य ('0') के लिए टेक्स्ट कैरेक्टर 48 से मेल खाता है।"},"num":59},{"id":"q60","q":{"en":"Does every key on a keyboard have a fixed ASCII code?","hi":"क्या कीबोर्ड की प्रत्येक की (key) का एक निश्चित ASCII कोड होता है?"},"a":{"en":"No. Keyboard key events and layout/IME are interpreted by software. Encoding of text happens later, and inputs like arrow or function keys are not ASCII printable characters","hi":"नहीं। कीबोर्ड की इवेंट्स (key events) और लेआउट/IME को सॉफ्टवेयर द्वारा इंटरप्रेट (व्याख्या) किया जाता है। टेक्स्ट की एन्कोडिंग बाद में होती है, और एरो (arrow) या फंक्शन की (function keys) जैसे इनपुट ASCII प्रिंट करने योग्य वर्ण नहीं हैं"},"o":[{"en":"Yes, hardware directly sends ASCII codes","hi":"हाँ, हार्डवेयर सीधे ASCII कोड भेजता है"},{"en":"No. Keyboard key events and layout/IME are interpreted by software. Encoding of text happens later, and inputs like arrow or function keys are not ASCII printable characters","hi":"नहीं। कीबोर्ड की इवेंट्स (key events) और लेआउट/IME को सॉफ्टवेयर द्वारा इंटरप्रेट (व्याख्या) किया जाता है। टेक्स्ट की एन्कोडिंग बाद में होती है, और एरो (arrow) या फंक्शन की (function keys) जैसे इनपुट ASCII प्रिंट करने योग्य वर्ण नहीं हैं"},{"en":"Yes, but only on Windows","hi":"हाँ, लेकिन केवल विंडोज पर"},{"en":"No, keyboards do not use codes","hi":"नहीं, कीबोर्ड कोड का उपयोग नहीं करते हैं"}],"exp":{"en":"Keyboards send 'scan codes' identifying physical keys pressed. The operating system maps these to characters based on language settings. Function keys (F1, Shift) do not have standard printable ASCII codes.","hi":"कीबोर्ड दबाई गई भौतिक कुंजियों की पहचान करने वाले 'स्कैन कोड' भेजते हैं। ऑपरेटिंग सिस्टम भाषा सेटिंग्स के आधार पर इन्हें वर्णों में मैप करता है।"},"num":60},{"id":"q61","q":{"en":"How should the full form of ISCII be remembered?","hi":"ISCII का फुल फॉर्म कैसे याद रखा जाना चाहिए?"},"a":{"en":"The title of IS 13194 is 'Indian Script Code for Information Interchange'. In the chapter and C-DAC material, 'Indian Standard Code for Information Interchange' is also found","hi":"IS 13194 का शीर्षक 'इंडियन स्क्रिप्ट कोड फॉर इंफॉर्मेशन इंटरचेंज' (Indian Script Code for Information Interchange) है। अध्याय और C-DAC की सामग्री में 'इंडियन स्टैंडर्ड कोड फॉर इंफॉर्मेशन इंटरचेंज' भी मिलता है"},"o":[{"en":"Indian Standard Code for Internet Interface","hi":"इंडियन स्टैंडर्ड कोड फॉर इंटरनेट इंटरफ़ेस"},{"en":"The title of IS 13194 is 'Indian Script Code for Information Interchange'. In the chapter and C-DAC material, 'Indian Standard Code for Information Interchange' is also found","hi":"IS 13194 का शीर्षक 'इंडियन स्क्रिप्ट कोड फॉर इंफॉर्मेशन इंटरचेंज' (Indian Script Code for Information Interchange) है। अध्याय और C-DAC की सामग्री में 'इंडियन स्टैंडर्ड कोड फॉर इंफॉर्मेशन इंटरचेंज' भी मिलता है"},{"en":"International Script Code for India","hi":"इंटरनेशनल स्क्रिप्ट कोड फॉर इंडिया"},{"en":"Independent Standard Code for Information Interchange","hi":"इंडिपेंडेंट स्टैंडर्ड कोड फॉर इंफॉर्मेशन इंटरचेंज"}],"exp":{"en":"Both 'Indian Script Code...' and 'Indian Standard Code...' are used in literature. It was developed to represent Indian languages.","hi":"साहित्य में 'इंडियन स्क्रिप्ट कोड...' और 'इंडियन स्टैंडर्ड कोड...' दोनों का उपयोग किया जाता है। इसे भारतीय भाषाओं का प्रतिनिधित्व करने के लिए विकसित किया गया था।"},"num":61},{"id":"q62","q":{"en":"What was the purpose and size of ISCII?","hi":"ISCII का उद्देश्य और आकार (size) क्या था?"},"a":{"en":"An 8-bit standard to encode Indian scripts. The lower 128 positions are ASCII-compatible, and the upper part is used for Indian script coding and controls","hi":"भारतीय लिपियों (Indian scripts) को एन्कोड करने का एक 8-बिट मानक। निचली 128 स्थितियाँ (lower 128 positions) ASCII-संगत हैं, और ऊपरी भाग का उपयोग भारतीय लिपि कोडिंग और नियंत्रणों (controls) के लिए किया जाता है"},"o":[{"en":"A 16-bit standard for global languages","hi":"वैश्विक भाषाओं के लिए 16-बिट मानक"},{"en":"An 8-bit standard to encode Indian scripts. The lower 128 positions are ASCII-compatible, and the upper part is used for Indian script coding and controls","hi":"भारतीय लिपियों (Indian scripts) को एन्कोड करने का एक 8-बिट मानक। निचली 128 स्थितियाँ (lower 128 positions) ASCII-संगत हैं, और ऊपरी भाग का उपयोग भारतीय लिपि कोडिंग और नियंत्रणों (controls) के लिए किया जाता है"},{"en":"A 7-bit standard for English only","hi":"केवल अंग्रेजी के लिए 7-बिट मानक"},{"en":"A 32-bit standard for emojis","hi":"इमोजी के लिए 32-बिट मानक"}],"exp":{"en":"ISCII was created by India's C-DAC to support various Indian scripts (like Devanagari) while maintaining compatibility with basic ASCII in an 8-bit format.","hi":"ISCII को 8-बिट प्रारूप में बुनियादी ASCII के साथ अनुकूलता बनाए रखते हुए विभिन्न भारतीय लिपियों (जैसे देवनागरी) का समर्थन करने के लिए भारत के C-DAC द्वारा बनाया गया था।"},"num":62},{"id":"q63","q":{"en":"What is the BIS standard number and year for ISCII?","hi":"ISCII के लिए BIS मानक संख्या (standard number) और वर्ष क्या है?"},"a":{"en":"IS 13194:1991","hi":"IS 13194:1991"},"o":[{"en":"IS 2000:2001","hi":"IS 2000:2001"},{"en":"IS 13194:1991","hi":"IS 13194:1991"},{"en":"IS 10101:1980","hi":"IS 10101:1980"},{"en":"IS 9999:2010","hi":"IS 9999:2010"}],"exp":{"en":"The Bureau of Indian Standards (BIS) officially adopted ISCII as standard IS 13194 in the year 1991.","hi":"भारतीय मानक ब्यूरो (BIS) ने आधिकारिक तौर पर वर्ष 1991 में ISCII को मानक IS 13194 के रूप में अपनाया।"},"num":63},{"id":"q64","q":{"en":"What is the role of Unicode?","hi":"यूनिकोड (Unicode) की भूमिका क्या है?"},"a":{"en":"It assigns standard code points to different scripts, symbols, and characters, such as A = U+0041 and अ = U+0905","hi":"यह विभिन्न लिपियों (scripts), प्रतीकों और वर्णों को मानक कोड पॉइंट (standard code points) निर्दिष्ट करता है, जैसे A = U+0041 और अ = U+0905"},"o":[{"en":"To translate between programming languages","hi":"प्रोग्रामिंग भाषाओं के बीच अनुवाद करना"},{"en":"It assigns standard code points to different scripts, symbols, and characters, such as A = U+0041 and अ = U+0905","hi":"यह विभिन्न लिपियों (scripts), प्रतीकों और वर्णों को मानक कोड पॉइंट (standard code points) निर्दिष्ट करता है, जैसे A = U+0041 और अ = U+0905"},{"en":"To compress files","hi":"फ़ाइलों को संपीड़ित (compress) करना"},{"en":"To encrypt passwords","hi":"पासवर्ड एन्क्रिप्ट करना"}],"exp":{"en":"Unicode aims to provide a unique number (code point) for every character, regardless of the platform, program, or language.","hi":"यूनिकोड का उद्देश्य प्लेटफॉर्म, प्रोग्राम या भाषा की परवाह किए बिना प्रत्येक वर्ण के लिए एक विशिष्ट संख्या (कोड पॉइंट) प्रदान करना है।"},"num":64},{"id":"q65","q":{"en":"What are UTF-8, UTF-16, and UTF-32?","hi":"UTF-8, UTF-16 और UTF-32 क्या हैं?"},"a":{"en":"Unicode encoding forms. UTF-8 uses 8-bit units, UTF-16 uses 16-bit units, and UTF-32 uses 32-bit units","hi":"यूनिकोड एन्कोडिंग रूप (Unicode encoding forms)। UTF-8 8-बिट इकाइयों का उपयोग करता है, UTF-16 16-बिट इकाइयों का उपयोग करता है, और UTF-32 32-बिट इकाइयों का उपयोग करता है"},"o":[{"en":"Types of internet cables","hi":"इंटरनेट केबल के प्रकार"},{"en":"Unicode encoding forms. UTF-8 uses 8-bit units, UTF-16 uses 16-bit units, and UTF-32 uses 32-bit units","hi":"यूनिकोड एन्कोडिंग रूप (Unicode encoding forms)। UTF-8 8-बिट इकाइयों का उपयोग करता है, UTF-16 16-बिट इकाइयों का उपयोग करता है, और UTF-32 32-बिट इकाइयों का उपयोग करता है"},{"en":"Versions of Windows","hi":"विंडोज के संस्करण"},{"en":"Computer processor speeds","hi":"कंप्यूटर प्रोसेसर की गति"}],"exp":{"en":"These are different ways to translate Unicode code points into actual bytes for storage in computer memory.","hi":"ये कंप्यूटर मेमोरी में स्टोरेज के लिए यूनिकोड कोड पॉइंट को वास्तविक बाइट्स में अनुवाद करने के विभिन्न तरीके हैं।"},"num":65},{"id":"q66","q":{"en":"Is a character always one byte?","hi":"क्या एक कैरेक्टर हमेशा एक बाइट (byte) का होता है?"},"a":{"en":"In UTF-8, one Unicode code point can use 1–4 bytes. Example: A uses 1 byte, and अ uses 3 bytes","hi":"UTF-8 में, एक यूनिकोड कोड पॉइंट 1-4 बाइट्स का उपयोग कर सकता है। उदाहरण: A 1 बाइट का उपयोग करता है, और अ 3 बाइट्स का उपयोग करता है"},"o":[{"en":"Yes, all characters are exactly 1 byte","hi":"हाँ, सभी कैरेक्टर ठीक 1 बाइट के होते हैं"},{"en":"In UTF-8, one Unicode code point can use 1–4 bytes. Example: A uses 1 byte, and अ uses 3 bytes","hi":"UTF-8 में, एक यूनिकोड कोड पॉइंट 1-4 बाइट्स का उपयोग कर सकता है। उदाहरण: A 1 बाइट का उपयोग करता है, और अ 3 बाइट्स का उपयोग करता है"},{"en":"Yes, but only in Unicode","hi":"हाँ, लेकिन केवल यूनिकोड में"},{"en":"No, characters are always 8 bytes","hi":"नहीं, कैरेक्टर हमेशा 8 बाइट के होते हैं"}],"exp":{"en":"UTF-8 is a variable-length encoding. Standard English letters take 1 byte, while characters from other scripts or emojis take 2 to 4 bytes.","hi":"UTF-8 एक चर-लंबाई (variable-length) एन्कोडिंग है। मानक अंग्रेजी अक्षरों में 1 बाइट लगता है, जबकि अन्य लिपियों या इमोजी के अक्षरों में 2 से 4 बाइट लगते हैं।"},"num":66},{"id":"q67","q":{"en":"What is the difference between a Unicode code point and encoding?","hi":"यूनिकोड कोड पॉइंट (Unicode code point) और एन्कोडिंग (Encoding) में क्या अंतर है?"},"a":{"en":"Code point is the character's assigned numerical identity. Encoding dictates how to store that identity in bytes/code units","hi":"कोड पॉइंट (Code point) कैरेक्टर की निर्दिष्ट संख्यात्मक पहचान (assigned numerical identity) है। एन्कोडिंग यह बताती है कि उस पहचान को बाइट्स/कोड इकाइयों में कैसे स्टोर करना है"},"o":[{"en":"There is no difference","hi":"कोई अंतर नहीं है"},{"en":"Code point is the character's assigned numerical identity. Encoding dictates how to store that identity in bytes/code units","hi":"कोड पॉइंट (Code point) कैरेक्टर की निर्दिष्ट संख्यात्मक पहचान (assigned numerical identity) है। एन्कोडिंग यह बताती है कि उस पहचान को बाइट्स/कोड इकाइयों में कैसे स्टोर करना है"},{"en":"Code point is hardware, encoding is software","hi":"कोड पॉइंट हार्डवेयर है, एन्कोडिंग सॉफ्टवेयर है"},{"en":"Code point is for text, encoding is for video","hi":"कोड पॉइंट टेक्स्ट के लिए है, एन्कोडिंग वीडियो के लिए है"}],"exp":{"en":"A code point is a theoretical concept mapping a character to a number. Encoding is the practical implementation of how that number is saved on a hard drive.","hi":"कोड पॉइंट एक सैद्धांतिक अवधारणा है जो एक वर्ण को एक संख्या में मैप करती है। एन्कोडिंग इसका व्यावहारिक कार्यान्वयन है कि उस संख्या को हार्ड ड्राइव पर कैसे सहेजा जाता है।"},"num":67}]},{"title":{"en":"6. Number Systems & Positional Values","hi":"6. संख्या पद्धतियाँ और स्थानीय मान"},"questions":[{"id":"q68","q":{"en":"What is a number system?","hi":"नंबर सिस्टम (Number system) क्या है?"},"a":{"en":"A system of digits and rules by which numbers are represented. The chapter covers binary, decimal, octal, and hexadecimal","hi":"अंकों (digits) और नियमों का एक सिस्टम जिसके द्वारा संख्याओं का प्रतिनिधित्व (represent) किया जाता है। अध्याय बाइनरी, डेसीमल (decimal), ऑक्टल और हेक्साडेसिमल को कवर करता है"},"o":[{"en":"A way to count physical objects only","hi":"केवल भौतिक वस्तुओं को गिनने का एक तरीका"},{"en":"A system of digits and rules by which numbers are represented. The chapter covers binary, decimal, octal, and hexadecimal","hi":"अंकों (digits) और नियमों का एक सिस्टम जिसके द्वारा संख्याओं का प्रतिनिधित्व (represent) किया जाता है। अध्याय बाइनरी, डेसीमल (decimal), ऑक्टल और हेक्साडेसिमल को कवर करता है"},{"en":"A computer program for mathematics","hi":"गणित के लिए एक कंप्यूटर प्रोग्राम"},{"en":"A type of database","hi":"एक प्रकार का डेटाबेस"}],"exp":{"en":"A number system defines the set of symbols (digits) and the base used to represent quantitative values.","hi":"नंबर सिस्टम मात्रात्मक मानों का प्रतिनिधित्व करने के लिए उपयोग किए जाने वाले प्रतीकों (अंकों) और आधार (base) के सेट को परिभाषित करता है।"},"num":68},{"id":"q69","q":{"en":"What does the base or radix indicate?","hi":"बेस (Base) या मूलांक (radix) क्या बताता है?"},"a":{"en":"The count of available distinct digits in a positional system, including 0","hi":"एक स्थिति-आधारित प्रणाली (positional system) में उपलब्ध विशिष्ट अंकों (distinct digits) की संख्या, जिसमें 0 शामिल है"},"o":[{"en":"The maximum value a number can have","hi":"वह अधिकतम मान जो एक संख्या का हो सकता है"},{"en":"The count of available distinct digits in a positional system, including 0","hi":"एक स्थिति-आधारित प्रणाली (positional system) में उपलब्ध विशिष्ट अंकों (distinct digits) की संख्या, जिसमें 0 शामिल है"},{"en":"The number of bits in a byte","hi":"एक बाइट में बिट्स की संख्या"},{"en":"The physical size of the computer memory","hi":"कंप्यूटर मेमोरी का भौतिक आकार"}],"exp":{"en":"The base (or radix) tells you how many different digits are used. Decimal uses base 10 (0-9), binary uses base 2 (0-1).","hi":"बेस (या मूलांक) आपको बताता है कि कितने अलग-अलग अंकों का उपयोग किया जाता है। डेसीमल बेस 10 (0-9) का उपयोग करता है, बाइनरी बेस 2 (0-1) का उपयोग करता है।"},"num":69},{"id":"q70","q":{"en":"How is the value of a digit calculated in a positional number system?","hi":"स्थितीय संख्या प्रणाली (Positional number system) में किसी अंक (digit) का मान कैसे निकाला जाता है?"},"a":{"en":"Digit value × base raised to position. In the integer part, the rightmost position is 0","hi":"अंक का मान × स्थिति (position) की घात (power) तक उठाया गया आधार (base)। पूर्णांक (integer) भाग में, सबसे दाहिनी स्थिति 0 होती है"},"o":[{"en":"By adding the base to the digit","hi":"अंक में आधार (base) जोड़कर"},{"en":"Digit value × base raised to position. In the integer part, the rightmost position is 0","hi":"अंक का मान × स्थिति (position) की घात (power) तक उठाया गया आधार (base)। पूर्णांक (integer) भाग में, सबसे दाहिनी स्थिति 0 होती है"},{"en":"By dividing the digit by the base","hi":"अंक को आधार से विभाजित करके"},{"en":"By multiplying the digit by itself","hi":"अंक को स्वयं से गुणा करके"}],"exp":{"en":"For example, in decimal '345', the '4' is in position 1, so its value is 4 * 10^1 = 40.","hi":"उदाहरण के लिए, दशमलव '345' में, '4' स्थिति 1 में है, इसलिए इसका मान 4 * 10^1 = 40 है।"},"num":70},{"id":"q71","q":{"en":"What are the base and digits of the binary number system?","hi":"बाइनरी नंबर सिस्टम का बेस (base) और अंक (digits) क्या हैं?"},"a":{"en":"Base 2, digits 0 and 1. Example: (10101)₂","hi":"बेस 2, अंक 0 और 1। उदाहरण: (10101)₂"},"o":[{"en":"Base 10, digits 0-9","hi":"Base 10, digits 0-9"},{"en":"Base 2, digits 0 and 1. Example: (10101)₂","hi":"बेस 2, अंक 0 और 1। उदाहरण: (10101)₂"},{"en":"Base 8, digits 0-7","hi":"Base 8, digits 0-7"},{"en":"Base 16, digits 0-9 and A-F","hi":"Base 16, digits 0-9 and A-F"}],"exp":{"en":"Binary is a base-2 system, meaning it relies entirely on combinations of 0s and 1s to represent any value.","hi":"बाइनरी एक बेस-2 प्रणाली है, जिसका अर्थ है कि यह किसी भी मान का प्रतिनिधित्व करने के लिए पूरी तरह से 0 और 1 के संयोजन पर निर्भर करता है।"},"num":71},{"id":"q72","q":{"en":"What are the base and digits of the decimal number system?","hi":"डेसीमल नंबर सिस्टम (दशमलव प्रणाली) का बेस और अंक क्या हैं?"},"a":{"en":"Base 10, digits 0–9. Example: (1275)₁₀","hi":"बेस 10, अंक 0–9। उदाहरण: (1275)₁₀"},"o":[{"en":"Base 2, digits 0, 1","hi":"Base 2, digits 0, 1"},{"en":"Base 10, digits 0–9. Example: (1275)₁₀","hi":"बेस 10, अंक 0–9। उदाहरण: (1275)₁₀"},{"en":"Base 16, digits A-F","hi":"Base 16, digits A-F"},{"en":"Base 8, digits 0-8","hi":"Base 8, digits 0-8"}],"exp":{"en":"The standard numbering system used by humans in everyday life is base 10.","hi":"रोजमर्रा की जिंदगी में मनुष्यों द्वारा उपयोग की जाने वाली मानक संख्या प्रणाली बेस 10 है।"},"num":72},{"id":"q73","q":{"en":"What are the base and digits of the octal number system?","hi":"ऑक्टल नंबर सिस्टम (Octal number system) का बेस और अंक क्या हैं?"},"a":{"en":"Base 8, digits 0–7. Example: (234)₈","hi":"बेस 8, अंक 0–7। उदाहरण: (234)₈"},"o":[{"en":"Base 10, digits 0-9","hi":"Base 10, digits 0-9"},{"en":"Base 16, digits 0-15","hi":"Base 16, digits 0-15"},{"en":"Base 8, digits 0–7. Example: (234)₈","hi":"बेस 8, अंक 0–7। उदाहरण: (234)₈"},{"en":"Base 2, digits 0-7","hi":"Base 2, digits 0-7"}],"exp":{"en":"The octal numeral system is the base-8 number system, and uses the digits 0 to 7.","hi":"ऑक्टल अंक प्रणाली बेस-8 संख्या प्रणाली है, और इसमें 0 से 7 तक के अंकों का उपयोग किया जाता है।"},"num":73},{"id":"q74","q":{"en":"What are the base and digits of the hexadecimal number system?","hi":"हेक्साडेसिमल नंबर सिस्टम (Hexadecimal number system) का बेस और अंक क्या हैं?"},"a":{"en":"Base 16, digits 0–9 and A–F. Example: (F9D)₁₆","hi":"बेस 16, अंक 0–9 और A–F। उदाहरण: (F9D)₁₆"},"o":[{"en":"Base 10, digits 0-9","hi":"Base 10, digits 0-9"},{"en":"Base 8, digits 0-7","hi":"Base 8, digits 0-7"},{"en":"Base 16, digits 0–9 and A–F. Example: (F9D)₁₆","hi":"बेस 16, अंक 0–9 और A–F। उदाहरण: (F9D)₁₆"},{"en":"Base 20, digits 0-19","hi":"Base 20, digits 0-19"}],"exp":{"en":"Hexadecimal uses 16 symbols: the standard 0-9 for values zero to nine, and letters A-F for values ten to fifteen.","hi":"हेक्साडेसिमल 16 प्रतीकों का उपयोग करता है: शून्य से नौ तक के मानों के लिए मानक 0-9, और दस से पंद्रह मानों के लिए अक्षर A-F।"},"num":74},{"id":"q75","q":{"en":"What are the decimal values of hexadecimal A to F?","hi":"हेक्साडेसिमल A से F के डेसीमल मान (decimal values) क्या हैं?"},"a":{"en":"A=10, B=11, C=12, D=13, E=14, F=15","hi":"A=10, B=11, C=12, D=13, E=14, F=15"},"o":[{"en":"A=1, B=2, C=3, D=4, E=5, F=6","hi":"A=1, B=2, C=3, D=4, E=5, F=6"},{"en":"A=10, B=11, C=12, D=13, E=14, F=15","hi":"A=10, B=11, C=12, D=13, E=14, F=15"},{"en":"A=11, B=12, C=13, D=14, E=15, F=16","hi":"A=11, B=12, C=13, D=14, E=15, F=16"},{"en":"A=0, B=1, C=2, D=3, E=4, F=5","hi":"A=0, B=1, C=2, D=3, E=4, F=5"}],"exp":{"en":"Since single digits can only go up to 9, hexadecimal borrows the first six letters of the alphabet to represent 10 through 15.","hi":"चूँकि एकल अंक (single digits) केवल 9 तक ही जा सकते हैं, हेक्साडेसिमल 10 से 15 का प्रतिनिधित्व करने के लिए वर्णमाला के पहले छह अक्षरों का उपयोग करता है।"},"num":75},{"id":"q76","q":{"en":"What is the binary lookup for decimal digits 0–9?","hi":"दशमलव अंक (Decimal digits) 0–9 के लिए बाइनरी लुकअप क्या है?"},"a":{"en":"0→0, 1→1, 2→10, 3→11, 4→100, 5→101, 6→110, 7→111, 8→1000, 9→1001","hi":"0→0, 1→1, 2→10, 3→11, 4→100, 5→101, 6→110, 7→111, 8→1000, 9→1001"},"o":[{"en":"0→1, 1→2, 2→3 ...","hi":"0→1, 1→2, 2→3 ..."},{"en":"0→0, 1→1, 2→10, 3→11, 4→100, 5→101, 6→110, 7→111, 8→1000, 9→1001","hi":"0→0, 1→1, 2→10, 3→11, 4→100, 5→101, 6→110, 7→111, 8→1000, 9→1001"},{"en":"0→0000, 1→0001, 2→0011 ...","hi":"0→0000, 1→0001, 2→0011 ..."},{"en":"0→A, 1→B, 2→C ...","hi":"0→A, 1→B, 2→C ..."}],"exp":{"en":"These are the direct binary conversions for the digits 0 through 9.","hi":"ये 0 से 9 तक के अंकों के लिए सीधे बाइनरी रूपांतरण हैं।"},"num":76},{"id":"q77","q":{"en":"How are octal digits 0–7 mapped to 3-bit binary?","hi":"ऑक्टल अंक (Octal digits) 0–7 को 3-बिट बाइनरी में कैसे मैप किया जाता है?"},"a":{"en":"0→000, 1→001, 2→010, 3→011, 4→100, 5→101, 6→110, 7→111","hi":"0→000, 1→001, 2→010, 3→011, 4→100, 5→101, 6→110, 7→111"},"o":[{"en":"0→00, 1→01, 2→10 ...","hi":"0→00, 1→01, 2→10 ..."},{"en":"0→000, 1→001, 2→010, 3→011, 4→100, 5→101, 6→110, 7→111","hi":"0→000, 1→001, 2→010, 3→011, 4→100, 5→101, 6→110, 7→111"},{"en":"0→0000, 1→0001, 2→0010 ...","hi":"0→0000, 1→0001, 2→0010 ..."},{"en":"0→111, 1→110, 2→101 ...","hi":"0→111, 1→110, 2→101 ..."}],"exp":{"en":"Because 8 is 2^3, every octal digit can be perfectly represented by a unique sequence of exactly 3 binary bits.","hi":"चूँकि 8 2^3 है, प्रत्येक ऑक्टल अंक को ठीक 3 बाइनरी बिट्स के एक अद्वितीय अनुक्रम (unique sequence) द्वारा पूरी तरह से दर्शाया जा सकता है।"},"num":77},{"id":"q78","q":{"en":"Why are hex and octal considered binary shorthand?","hi":"हेक्स (Hex) और ऑक्टल (Octal) को बाइनरी शॉर्टहैंड (binary shorthand) क्यों माना जाता है?"},"a":{"en":"16 = 2⁴, so 1 hex digit = 4 bits. 8 = 2³, so 1 octal digit = 3 bits","hi":"16 = 2⁴, इसलिए 1 हेक्स अंक = 4 बिट्स। 8 = 2³, इसलिए 1 ऑक्टल अंक = 3 बिट्स"},"o":[{"en":"Because they are easier to pronounce","hi":"क्योंकि उनका उच्चारण आसान है"},{"en":"16 = 2⁴, so 1 hex digit = 4 bits. 8 = 2³, so 1 octal digit = 3 bits","hi":"16 = 2⁴, इसलिए 1 हेक्स अंक = 4 बिट्स। 8 = 2³, इसलिए 1 ऑक्टल अंक = 3 बिट्स"},{"en":"Because they use fewer letters","hi":"क्योंकि वे कम अक्षरों का उपयोग करते हैं"},{"en":"They are not shorthand","hi":"वे शॉर्टहैंड नहीं हैं"}],"exp":{"en":"They allow humans to read and write long binary numbers much more compactly, grouping bits into chunks of 3 (octal) or 4 (hex).","hi":"वे मनुष्यों को बिट्स को 3 (ऑक्टल) या 4 (हेक्स) के टुकड़ों में बांटकर लंबी बाइनरी संख्याओं को अधिक संक्षिप्त रूप से पढ़ने और लिखने की अनुमति देते हैं।"},"num":78},{"id":"q79","q":{"en":"Where is hexadecimal used in programming?","hi":"प्रोग्रामिंग में हेक्साडेसिमल (Hexadecimal) का उपयोग कहाँ किया जाता है?"},"a":{"en":"To write memory addresses, byte dumps, machine-code displays, and colour values compactly","hi":"मेमोरी एड्रेस, बाइट डंप, मशीन-कोड डिस्प्ले और कलर वैल्यू को कॉम्पैक्ट (संक्षिप्त) रूप में लिखने के लिए"},"o":[{"en":"Only in mathematical equations","hi":"केवल गणितीय समीकरणों में"},{"en":"To write memory addresses, byte dumps, machine-code displays, and colour values compactly","hi":"मेमोरी एड्रेस, बाइट डंप, मशीन-कोड डिस्प्ले और कलर वैल्यू को कॉम्पैक्ट (संक्षिप्त) रूप में लिखने के लिए"},{"en":"To design user interfaces","hi":"यूजर इंटरफेस डिजाइन करने के लिए"},{"en":"To increase internet bandwidth","hi":"इंटरनेट बैंडविड्थ बढ़ाने के लिए"}],"exp":{"en":"Hex is the standard for representing raw binary data in a human-readable format, heavily used in debugging and web color codes (e.g., #FFFFFF).","hi":"हेक्स मानव-पठनीय प्रारूप में कच्चे बाइनरी डेटा का प्रतिनिधित्व करने का मानक है, जिसका उपयोग डिबगिंग और वेब रंग कोड (जैसे, #FFFFFF) में भारी मात्रा में किया जाता है।"},"num":79},{"id":"q80","q":{"en":"Are 102 binary or 89 octal valid?","hi":"क्या 102 बाइनरी या 89 ऑक्टल मान्य (valid) है?"},"a":{"en":"In binary, the digit 2 is invalid. In octal, 8 and 9 are invalid. Every digit must be smaller than the base","hi":"बाइनरी में, अंक 2 अमान्य (invalid) है। ऑक्टल में, 8 और 9 अमान्य हैं। प्रत्येक अंक आधार (base) से छोटा होना चाहिए"},"o":[{"en":"Yes, both are valid","hi":"हाँ, दोनों मान्य हैं"},{"en":"In binary, the digit 2 is invalid. In octal, 8 and 9 are invalid. Every digit must be smaller than the base","hi":"बाइनरी में, अंक 2 अमान्य (invalid) है। ऑक्टल में, 8 और 9 अमान्य हैं। प्रत्येक अंक आधार (base) से छोटा होना चाहिए"},{"en":"No, because numbers must start with 0","hi":"नहीं, क्योंकि संख्याएँ 0 से शुरू होनी चाहिए"},{"en":"Only 89 octal is valid","hi":"केवल 89 ऑक्टल मान्य है"}],"exp":{"en":"The highest possible digit in any number system is one less than its base. Binary (base 2) only has 0,1. Octal (base 8) only has 0-7.","hi":"किसी भी संख्या प्रणाली में उच्चतम संभव अंक उसके आधार से एक कम होता है। बाइनरी (बेस 2) में केवल 0,1 होता है। ऑक्टल (बेस 8) में केवल 0-7 होता है।"},"num":80},{"id":"q81","q":{"en":"How is (1275)₁₀ written in place-value form?","hi":"(1275)₁₀ को प्लेस-वैल्यू (place-value) रूप में कैसे लिखा जाता है?"},"a":{"en":"1×10³ + 2×10² + 7×10¹ + 5×10⁰","hi":"1×10³ + 2×10² + 7×10¹ + 5×10⁰"},"o":[{"en":"1×10⁴ + 2×10³ + 7×10² + 5×10¹","hi":"1×10⁴ + 2×10³ + 7×10² + 5×10¹"},{"en":"1×10³ + 2×10² + 7×10¹ + 5×10⁰","hi":"1×10³ + 2×10² + 7×10¹ + 5×10⁰"},{"en":"1×10 + 2×10 + 7×10 + 5×10","hi":"1×10 + 2×10 + 7×10 + 5×10"},{"en":"1 + 2 + 7 + 5 × 10","hi":"1 + 2 + 7 + 5 × 10"}],"exp":{"en":"In a base-10 system, moving right to left from the decimal point, the powers of 10 increase starting from 0 (10^0, 10^1, 10^2...).","hi":"बेस-10 सिस्टम में, दशमलव बिंदु (decimal point) से दाएं से बाएं जाने पर, 10 की घातें (powers) 0 से शुरू होकर बढ़ती हैं (10^0, 10^1, 10^2...)।"},"num":81},{"id":"q82","q":{"en":"What is the positional expansion of the digits in (237.25)₁₀?","hi":"(237.25)₁₀ के अंकों (digits) का स्थितीय विस्तार (positional expansion) क्या है?"},"a":{"en":"2×10² + 3×10¹ + 7×10⁰ + 2×10⁻¹ + 5×10⁻²","hi":"2×10² + 3×10¹ + 7×10⁰ + 2×10⁻¹ + 5×10⁻²"},"o":[{"en":"2×10² + 3×10¹ + 7×10⁰ + 2×10¹ + 5×10²","hi":"2×10² + 3×10¹ + 7×10⁰ + 2×10¹ + 5×10²"},{"en":"2×10³ + 3×10² + 7×10¹ + 2×10⁰ + 5×10⁻¹","hi":"2×10³ + 3×10² + 7×10¹ + 2×10⁰ + 5×10⁻¹"},{"en":"2×10² + 3×10¹ + 7×10⁰ + 2×10⁻¹ + 5×10⁻²","hi":"2×10² + 3×10¹ + 7×10⁰ + 2×10⁻¹ + 5×10⁻²"},{"en":"2×100 + 3×10 + 7×1 + 2×10 + 5×100","hi":"2×100 + 3×10 + 7×1 + 2×10 + 5×100"}],"exp":{"en":"The fractional part (.25) is represented with negative powers of 10: 2 * 10^-1 (tenths) and 5 * 10^-2 (hundredths).","hi":"भिन्नात्मक भाग (fractional part .25) को 10 की ऋणात्मक घातों (negative powers) के साथ दर्शाया जाता है: 2 * 10^-1 (दसवां) और 5 * 10^-2 (सौवां)।"},"num":82},{"id":"q83","q":{"en":"What are the positional weights after the radix point?","hi":"मूलांक बिंदु (radix point) के बाद स्थितीय भार (positional weights) क्या होते हैं?"},"a":{"en":"First fractional digit b⁻¹, next b⁻², then b⁻³","hi":"पहला भिन्नात्मक अंक b⁻¹, अगला b⁻², फिर b⁻³"},"o":[{"en":"b¹, b², b³","hi":"b¹, b², b³"},{"en":"First fractional digit b⁻¹, next b⁻², then b⁻³","hi":"पहला भिन्नात्मक अंक b⁻¹, अगला b⁻², फिर b⁻³"},{"en":"b⁰, b⁻¹, b⁻²","hi":"b⁰, b⁻¹, b⁻²"},{"en":"All are b⁰","hi":"सभी b⁰ हैं"}],"exp":{"en":"Just as moving left from the radix point increases the power, moving right uses negative powers starting from -1.","hi":"जिस तरह मूलांक बिंदु से बायीं ओर बढ़ने पर घात (power) बढ़ती है, उसी तरह दायीं ओर बढ़ने पर -1 से शुरू होने वाली ऋणात्मक घातों (negative powers) का उपयोग होता है।"},"num":83}]},{"title":{"en":"7. Decimal to Binary, Octal & Hexadecimal","hi":"7. दशमलव से बाइनरी, ऑक्टल और हेक्साडेसिमल में रूपांतरण"},"questions":[{"id":"q84","q":{"en":"What is the common method to convert a decimal integer to another base?","hi":"डेसीमल पूर्णांक (Decimal integer) को किसी अन्य बेस में बदलने की सामान्य विधि क्या है?"},"a":{"en":"Repeatedly divide by the target base, note each remainder, stop when the quotient is 0, then read the remainders from bottom to top","hi":"लक्ष्य आधार (target base) से बार-बार भाग (divide) दें, प्रत्येक शेषफल (remainder) को नोट करें, भागफल 0 होने पर रुकें, फिर शेषफल को नीचे से ऊपर तक पढ़ें"},"o":[{"en":"Multiply by the target base repeatedly","hi":"लक्ष्य आधार (target base) से बार-बार गुणा करें"},{"en":"Repeatedly divide by the target base, note each remainder, stop when the quotient is 0, then read the remainders from bottom to top","hi":"लक्ष्य आधार (target base) से बार-बार भाग (divide) दें, प्रत्येक शेषफल (remainder) को नोट करें, भागफल 0 होने पर रुकें, फिर शेषफल को नीचे से ऊपर तक पढ़ें"},{"en":"Add the target base repeatedly","hi":"लक्ष्य आधार को बार-बार जोड़ें"},{"en":"Subtract the target base repeatedly","hi":"लक्ष्य आधार को बार-बार घटाएं"}],"exp":{"en":"This is known as the repeated-division method. You divide by the new base, keep the remainders, and write them in reverse order to get the final converted number.","hi":"इसे बार-बार-विभाजन विधि (repeated-division method) के रूप में जाना जाता है। आप नए आधार से विभाजित करते हैं, शेषफल रखते हैं, और अंतिम परिवर्तित संख्या प्राप्त करने के लिए उन्हें उल्टे क्रम में लिखते हैं।"},"num":84},{"id":"q85","q":{"en":"How do you convert (122)₁₀ to binary?","hi":"(122)₁₀ को बाइनरी में कैसे बदलेंगे?"},"a":{"en":"Successive division by 2 yields remainders 0, 1, 0, 1, 1, 1, 1. Reversing them gives (1111010)₂","hi":"2 से क्रमिक विभाजन पर शेषफल 0, 1, 0, 1, 1, 1, 1 प्राप्त होता है। उन्हें उलटने पर (1111010)₂ प्राप्त होता है"},"o":[{"en":"Divide by 8 repeatedly","hi":"8 से बार-बार भाग दें"},{"en":"Successive division by 2 yields remainders 0, 1, 0, 1, 1, 1, 1. Reversing them gives (1111010)₂","hi":"2 से क्रमिक विभाजन पर शेषफल 0, 1, 0, 1, 1, 1, 1 प्राप्त होता है। उन्हें उलटने पर (1111010)₂ प्राप्त होता है"},{"en":"Multiply by 2","hi":"2 से गुणा करें"},{"en":"Subtract 2","hi":"2 घटाएँ"}],"exp":{"en":"122/2 = 61 (0); 61/2 = 30 (1); 30/2 = 15 (0); 15/2 = 7 (1); 7/2 = 3 (1); 3/2 = 1 (1); 1/2 = 0 (1). Reading upwards: 1111010.","hi":"122/2 = 61 (शेष 0); 61/2 = 30 (शेष 1); 30/2 = 15 (शेष 0); 15/2 = 7 (शेष 1); 7/2 = 3 (शेष 1); 3/2 = 1 (शेष 1); 1/2 = 0 (शेष 1)। नीचे से ऊपर पढ़ने पर: 1111010।"},"num":85},{"id":"q86","q":{"en":"How do you convert (122)₁₀ to octal?","hi":"(122)₁₀ को ऑक्टल (octal) में कैसे बदलेंगे?"},"a":{"en":"122 ÷ 8 = 15 r2, 15 ÷ 8 = 1 r7, 1 ÷ 8 = 0 r1. Reverse → (172)₈","hi":"122 ÷ 8 = 15 शेष 2, 15 ÷ 8 = 1 शेष 7, 1 ÷ 8 = 0 शेष 1। उलटने पर → (172)₈"},"o":[{"en":"122 ÷ 8 = 15 r2, 15 ÷ 8 = 1 r7, 1 ÷ 8 = 0 r1. Reverse → (172)₈","hi":"122 ÷ 8 = 15 शेष 2, 15 ÷ 8 = 1 शेष 7, 1 ÷ 8 = 0 शेष 1। उलटने पर → (172)₈"},{"en":"122 ÷ 2 = 61 r0","hi":"122 ÷ 2 = 61 शेष 0"},{"en":"122 ÷ 16 = 7 r10","hi":"122 ÷ 16 = 7 शेष 10"},{"en":"Multiply by 8","hi":"8 से गुणा करें"}],"exp":{"en":"Dividing by 8 gives the remainders 2, 7, and 1. Writing them from last to first gives 172.","hi":"8 से भाग देने पर शेषफल 2, 7 और 1 प्राप्त होता है। इन्हें अंतिम से प्रथम तक लिखने पर 172 प्राप्त होता है।"},"num":86},{"id":"q87","q":{"en":"How do you convert (122)₁₀ to hexadecimal?","hi":"(122)₁₀ को हेक्साडेसिमल (hexadecimal) में कैसे बदलेंगे?"},"a":{"en":"122 ÷ 16 = 7 r10, which is written as A. 7 ÷ 16 = 0 r7. Reverse → (7A)₁₆","hi":"122 ÷ 16 = 7 शेष 10, जिसे A लिखा जाता है। 7 ÷ 16 = 0 शेष 7। उलटने पर → (7A)₁₆"},"o":[{"en":"122 ÷ 16 = 7 r10, which is written as A. 7 ÷ 16 = 0 r7. Reverse → (7A)₁₆","hi":"122 ÷ 16 = 7 शेष 10, जिसे A लिखा जाता है। 7 ÷ 16 = 0 शेष 7। उलटने पर → (7A)₁₆"},{"en":"122 ÷ 16 = 7 r0","hi":"122 ÷ 16 = 7 शेष 0"},{"en":"122 ÷ 8 = 15 r2","hi":"122 ÷ 8 = 15 शेष 2"},{"en":"Convert to binary first","hi":"पहले बाइनरी में कनवर्ट करें"}],"exp":{"en":"122 / 16 gives a quotient of 7 and a remainder of 10. In hex, 10 is 'A'. Next, 7 / 16 gives 0 with remainder 7. Read upwards: 7A.","hi":"122 / 16 से भागफल 7 और शेषफल 10 मिलता है। हेक्स में, 10 का अर्थ 'A' है। इसके बाद, 7 / 16 से शेषफल 7 के साथ 0 मिलता है। ऊपर की ओर पढ़ें: 7A।"},"num":87},{"id":"q88","q":{"en":"What are the binary, octal, and hex equivalents of (65)₁₀?","hi":"(65)₁₀ के बाइनरी, ऑक्टल और हेक्स समतुल्य (equivalents) क्या हैं?"},"a":{"en":"(1000001)₂, (101)₈, and (41)₁₆. Quick check: 65 = 64 + 1","hi":"(1000001)₂, (101)₈ और (41)₁₆। त्वरित जांच: 65 = 64 + 1"},"o":[{"en":"(100)₂, (10)₈, (A)₁₆","hi":"(100)₂, (10)₈, (A)₁₆"},{"en":"(1000001)₂, (101)₈, and (41)₁₆. Quick check: 65 = 64 + 1","hi":"(1000001)₂, (101)₈ और (41)₁₆। त्वरित जांच: 65 = 64 + 1"},{"en":"(111)₂, (77)₈, (FF)₁₆","hi":"(111)₂, (77)₈, (FF)₁₆"},{"en":"(101)₂, (65)₈, (41)₁₆","hi":"(101)₂, (65)₈, (41)₁₆"}],"exp":{"en":"65 in binary is 64 + 1 (1000001). In octal, 64 is 8^2, so it's 101. In hex, 64 is 4 * 16, plus 1 is 41.","hi":"बाइनरी में 65, 64 + 1 (1000001) है। ऑक्टल में, 64 8^2 है, इसलिए यह 101 है। हेक्स में, 64 4 * 16 है, साथ ही 1 जोड़ने पर 41 है।"},"num":88},{"id":"q89","q":{"en":"In a decimal to hexadecimal conversion, how is a remainder of 13 written?","hi":"डेसीमल से हेक्साडेसिमल रूपांतरण में, 13 का शेषफल (remainder) कैसे लिखा जाता है?"},"a":{"en":"D. Remainders 10–15 are written as A–F","hi":"D. शेषफल 10-15 को A-F के रूप में लिखा जाता है"},"o":[{"en":"13","hi":"13"},{"en":"C","hi":"C"},{"en":"D. Remainders 10–15 are written as A–F","hi":"D. शेषफल 10-15 को A-F के रूप में लिखा जाता है"},{"en":"E","hi":"E"}],"exp":{"en":"A=10, B=11, C=12, D=13, E=14, F=15. Therefore, a remainder of 13 is written as 'D'.","hi":"A=10, B=11, C=12, D=13, E=14, F=15. इसलिए, 13 के शेषफल को 'D' के रूप में लिखा जाता है।"},"num":89},{"id":"q90","q":{"en":"In the repeated-division method, which digit does the first remainder give?","hi":"बार-बार-विभाजन विधि (repeated-division method) में, पहला शेषफल कौन सा अंक (digit) देता है?"},"a":{"en":"The least significant, i.e., the rightmost digit","hi":"सबसे कम महत्वपूर्ण (Least significant), यानी सबसे दाहिना अंक (rightmost digit)"},"o":[{"en":"The most significant digit","hi":"सबसे महत्वपूर्ण अंक (Most significant digit)"},{"en":"The least significant, i.e., the rightmost digit","hi":"सबसे कम महत्वपूर्ण (Least significant), यानी सबसे दाहिना अंक (rightmost digit)"},{"en":"The middle digit","hi":"मध्य अंक"},{"en":"The base","hi":"आधार"}],"exp":{"en":"The very first remainder you calculate when dividing represents the 1s column (the rightmost or least significant digit).","hi":"विभाजन करते समय आपके द्वारा गणना किया गया सबसे पहला शेषफल 1s कॉलम (सबसे दाहिना या सबसे कम महत्वपूर्ण अंक) का प्रतिनिधित्व करता है।"},"num":90},{"id":"q91","q":{"en":"How is decimal 0 written in binary, octal, and hex?","hi":"डेसीमल 0 को बाइनरी, ऑक्टल और हेक्स में कैसे लिखा जाता है?"},"a":{"en":"Digit 0 in every base. In the division algorithm, simply write 0 for 0","hi":"हर बेस (base) में अंक 0। विभाजन एल्गोरिथ्म में, 0 के लिए सीधे 0 लिखें"},"o":[{"en":"It cannot be written","hi":"इसे नहीं लिखा जा सकता"},{"en":"Digit 0 in every base. In the division algorithm, simply write 0 for 0","hi":"हर बेस (base) में अंक 0। विभाजन एल्गोरिथ्म में, 0 के लिए सीधे 0 लिखें"},{"en":"As A","hi":"A के रूप में"},{"en":"As 1","hi":"1 के रूप में"}],"exp":{"en":"Zero represents nothingness in every numbering system, so it is always just '0'.","hi":"शून्य हर संख्या प्रणाली में कुछ नहीं होने (nothingness) को दर्शाता है, इसलिए यह हमेशा केवल '0' ही होता है।"},"num":91}]},{"title":{"en":"8. Binary, Octal & Hexadecimal to Decimal","hi":"8. बाइनरी, ऑक्टल और हेक्साडेसिमल से दशमलव में रूपांतरण"},"questions":[{"id":"q92","q":{"en":"What is the rule to convert any positional number to decimal?","hi":"किसी स्थितीय संख्या (positional number) को दशमलव (decimal) में बदलने का नियम क्या है?"},"a":{"en":"Multiply each digit by its base-power weight, then add all terms","hi":"प्रत्येक अंक को उसके आधार-घात भार (base-power weight) से गुणा करें, फिर सभी पदों (terms) को जोड़ें"},"o":[{"en":"Add all the digits together","hi":"सभी अंकों को एक साथ जोड़ें"},{"en":"Multiply each digit by its base-power weight, then add all terms","hi":"प्रत्येक अंक को उसके आधार-घात भार (base-power weight) से गुणा करें, फिर सभी पदों (terms) को जोड़ें"},{"en":"Divide each digit by 10","hi":"प्रत्येक अंक को 10 से विभाजित करें"},{"en":"Multiply the whole number by 2","hi":"पूरी संख्या को 2 से गुणा करें"}],"exp":{"en":"This is the standard expansion method. You take each digit, multiply it by (Base^Position), and sum the results to get the decimal value.","hi":"यह मानक विस्तार विधि (expansion method) है। आप प्रत्येक अंक लेते हैं, इसे (Base^Position) से गुणा करते हैं, और दशमलव मान प्राप्त करने के लिए परिणामों को जोड़ते हैं।"},"num":92},{"id":"q93","q":{"en":"What is the decimal value of (1101)₂?","hi":"(1101)₂ का डेसीमल मान (decimal value) क्या है?"},"a":{"en":"13 (1×8 + 1×4 + 0×2 + 1×1 = 13)","hi":"13 (1×8 + 1×4 + 0×2 + 1×1 = 13)"},"o":[{"en":"10","hi":"10"},{"en":"13 (1×8 + 1×4 + 0×2 + 1×1 = 13)","hi":"13 (1×8 + 1×4 + 0×2 + 1×1 = 13)"},{"en":"14","hi":"14"},{"en":"15","hi":"15"}],"exp":{"en":"(1 * 2^3) + (1 * 2^2) + (0 * 2^1) + (1 * 2^0) = 8 + 4 + 0 + 1 = 13.","hi":"(1 * 2^3) + (1 * 2^2) + (0 * 2^1) + (1 * 2^0) = 8 + 4 + 0 + 1 = 13।"},"num":93},{"id":"q94","q":{"en":"What is the decimal value of (110101)₂?","hi":"(110101)₂ का डेसीमल मान क्या है?"},"a":{"en":"53 (32 + 16 + 0 + 4 + 0 + 1 = 53)","hi":"53 (32 + 16 + 0 + 4 + 0 + 1 = 53)"},"o":[{"en":"32","hi":"32"},{"en":"53 (32 + 16 + 0 + 4 + 0 + 1 = 53)","hi":"53 (32 + 16 + 0 + 4 + 0 + 1 = 53)"},{"en":"64","hi":"64"},{"en":"45","hi":"45"}],"exp":{"en":"From left to right: 32 (1), 16 (1), 8 (0), 4 (1), 2 (0), 1 (1). 32 + 16 + 4 + 1 = 53.","hi":"बाएं से दाएं: 32 (1), 16 (1), 8 (0), 4 (1), 2 (0), 1 (1)। 32 + 16 + 4 + 1 = 53।"},"num":94},{"id":"q95","q":{"en":"What is the decimal value of (10101)₂?","hi":"(10101)₂ का डेसीमल मान क्या है?"},"a":{"en":"21 (16 + 0 + 4 + 0 + 1 = 21)","hi":"21 (16 + 0 + 4 + 0 + 1 = 21)"},"o":[{"en":"15","hi":"15"},{"en":"21 (16 + 0 + 4 + 0 + 1 = 21)","hi":"21 (16 + 0 + 4 + 0 + 1 = 21)"},{"en":"25","hi":"25"},{"en":"31","hi":"31"}],"exp":{"en":"From left to right: 16 (1), 8 (0), 4 (1), 2 (0), 1 (1). 16 + 4 + 1 = 21.","hi":"बाएं से दाएं: 16 (1), 8 (0), 4 (1), 2 (0), 1 (1)। 16 + 4 + 1 = 21।"},"num":95},{"id":"q96","q":{"en":"What is the decimal value of (100101.101)₂?","hi":"(100101.101)₂ का डेसीमल मान क्या है?"},"a":{"en":"37.625 (Integer part: 32+4+1 = 37. Fraction: 1/2 + 0/4 + 1/8 = 0.625. Total = 37.625)","hi":"37.625 (पूर्णांक भाग: 32+4+1 = 37। अंश: 1/2 + 0/4 + 1/8 = 0.625। कुल = 37.625)"},"o":[{"en":"37.5","hi":"37.5"},{"en":"37.625 (Integer part: 32+4+1 = 37. Fraction: 1/2 + 0/4 + 1/8 = 0.625. Total = 37.625)","hi":"37.625 (पूर्णांक भाग: 32+4+1 = 37। अंश: 1/2 + 0/4 + 1/8 = 0.625। कुल = 37.625)"},{"en":"38.125","hi":"38.125"},{"en":"36.25","hi":"36.25"}],"exp":{"en":"The integer part is 100101 (32+4+1=37). The fractional part is .101, which is (1 * 0.5) + (0 * 0.25) + (1 * 0.125) = 0.625.","hi":"पूर्णांक भाग 100101 (32+4+1=37) है। भिन्नात्मक भाग .101 है, जो (1 * 0.5) + (0 * 0.25) + (1 * 0.125) = 0.625 है।"},"num":96},{"id":"q97","q":{"en":"What is the decimal value of (257)₈?","hi":"(257)₈ का डेसीमल मान क्या है?"},"a":{"en":"175 (2×64 + 5×8 + 7×1 = 175)","hi":"175 (2×64 + 5×8 + 7×1 = 175)"},"o":[{"en":"150","hi":"150"},{"en":"175 (2×64 + 5×8 + 7×1 = 175)","hi":"175 (2×64 + 5×8 + 7×1 = 175)"},{"en":"200","hi":"200"},{"en":"257","hi":"257"}],"exp":{"en":"(2 * 8^2) + (5 * 8^1) + (7 * 8^0) = (2 * 64) + (5 * 8) + (7 * 1) = 128 + 40 + 7 = 175.","hi":"(2 * 8^2) + (5 * 8^1) + (7 * 8^0) = (2 * 64) + (5 * 8) + (7 * 1) = 128 + 40 + 7 = 175।"},"num":97},{"id":"q98","q":{"en":"What is the decimal value of (234)₈?","hi":"(234)₈ का डेसीमल मान क्या है?"},"a":{"en":"156 (2×64 + 3×8 + 4×1 = 156)","hi":"156 (2×64 + 3×8 + 4×1 = 156)"},"o":[{"en":"100","hi":"100"},{"en":"156 (2×64 + 3×8 + 4×1 = 156)","hi":"156 (2×64 + 3×8 + 4×1 = 156)"},{"en":"234","hi":"234"},{"en":"180","hi":"180"}],"exp":{"en":"(2 * 8^2) + (3 * 8^1) + (4 * 8^0) = 128 + 24 + 4 = 156.","hi":"(2 * 8^2) + (3 * 8^1) + (4 * 8^0) = 128 + 24 + 4 = 156।"},"num":98},{"id":"q99","q":{"en":"What is the decimal value of (605.12)₈?","hi":"(605.12)₈ का डेसीमल मान क्या है?"},"a":{"en":"389.15625 (6×64 + 0×8 + 5 + 1/8 + 2/64 = 389.15625)","hi":"389.15625 (6×64 + 0×8 + 5 + 1/8 + 2/64 = 389.15625)"},"o":[{"en":"389.1","hi":"389.1"},{"en":"389.15625 (6×64 + 0×8 + 5 + 1/8 + 2/64 = 389.15625)","hi":"389.15625 (6×64 + 0×8 + 5 + 1/8 + 2/64 = 389.15625)"},{"en":"400.125","hi":"400.125"},{"en":"300.25","hi":"300.25"}],"exp":{"en":"Integer: (6*64)+(0*8)+5 = 384+5=389. Fraction: (1/8)+(2/64) = 0.125 + 0.03125 = 0.15625.","hi":"पूर्णांक: (6*64)+(0*8)+5 = 384+5=389. अंश: (1/8)+(2/64) = 0.125 + 0.03125 = 0.15625."},"num":99},{"id":"q100","q":{"en":"What is the decimal value of (3A5)₁₆?","hi":"(3A5)₁₆ का डेसीमल मान क्या है?"},"a":{"en":"933 (3×256 + 10×16 + 5×1 = 933)","hi":"933 (3×256 + 10×16 + 5×1 = 933)"},"o":[{"en":"500","hi":"500"},{"en":"933 (3×256 + 10×16 + 5×1 = 933)","hi":"933 (3×256 + 10×16 + 5×1 = 933)"},{"en":"1000","hi":"1000"},{"en":"1200","hi":"1200"}],"exp":{"en":"A is 10. So, (3 * 16^2) + (10 * 16^1) + (5 * 16^0) = (3 * 256) + (10 * 16) + 5 = 768 + 160 + 5 = 933.","hi":"A का अर्थ 10 है। तो, (3 * 16^2) + (10 * 16^1) + (5 * 16^0) = (3 * 256) + (10 * 16) + 5 = 768 + 160 + 5 = 933।"},"num":100},{"id":"q101","q":{"en":"What is the decimal value of (F9D)₁₆?","hi":"(F9D)₁₆ का डेसीमल मान क्या है?"},"a":{"en":"3997 (15×256 + 9×16 + 13×1 = 3997)","hi":"3997 (15×256 + 9×16 + 13×1 = 3997)"},"o":[{"en":"2000","hi":"2000"},{"en":"3997 (15×256 + 9×16 + 13×1 = 3997)","hi":"3997 (15×256 + 9×16 + 13×1 = 3997)"},{"en":"4000","hi":"4000"},{"en":"5000","hi":"5000"}],"exp":{"en":"F is 15, D is 13. (15 * 16^2) + (9 * 16^1) + (13 * 16^0) = 3840 + 144 + 13 = 3997.","hi":"F का अर्थ 15 है, D का अर्थ 13 है। (15 * 16^2) + (9 * 16^1) + (13 * 16^0) = 3840 + 144 + 13 = 3997।"},"num":101},{"id":"q102","q":{"en":"What are the decimal fractions of (.101)₂ and (.12)₈?","hi":"(.101)₂ और (.12)₈ के दशमलव अंश (decimal fractions) क्या हैं?"},"a":{"en":"Binary fraction = 1/2 + 1/8 = 0.625. Octal fraction = 1/8 + 2/64 = 0.15625","hi":"बाइनरी अंश = 1/2 + 1/8 = 0.625। ऑक्टल अंश = 1/8 + 2/64 = 0.15625"},"o":[{"en":"0.5 and 0.2","hi":"0.5 and 0.2"},{"en":"Binary fraction = 1/2 + 1/8 = 0.625. Octal fraction = 1/8 + 2/64 = 0.15625","hi":"बाइनरी अंश = 1/2 + 1/8 = 0.625। ऑक्टल अंश = 1/8 + 2/64 = 0.15625"},{"en":"0.25 and 0.1","hi":"0.25 and 0.1"},{"en":"0.75 and 0.5","hi":"0.75 and 0.5"}],"exp":{"en":"Binary: (1*2^-1) + (0*2^-2) + (1*2^-3) = 0.5 + 0.125 = 0.625. Octal: (1*8^-1) + (2*8^-2) = 0.125 + 0.03125 = 0.15625.","hi":"बाइनरी: 0.5 + 0 + 0.125 = 0.625। ऑक्टल: 1/8 + 2/64 = 0.125 + 0.03125 = 0.15625।"},"num":102}]},{"title":{"en":"9. Direct Binary ↔ Octal & Hexadecimal","hi":"9. बाइनरी ↔ ऑक्टल और हेक्साडेसिमल का सीधा रूपांतरण"},"questions":[{"id":"q103","q":{"en":"How do you directly convert a binary integer to octal?","hi":"बाइनरी पूर्णांक (binary integer) को सीधे ऑक्टल में कैसे बदलते हैं?"},"a":{"en":"Form 3-bit groups starting from the right. Pad the leftmost incomplete group with leading zeros, then map each group to an octal digit","hi":"दाईं ओर से 3-बिट समूह (3-bit groups) बनाएं। सबसे बाएँ अपूर्ण समूह (leftmost incomplete group) को अग्रणी शून्य (leading zeros) से पैड करें (भरें), फिर प्रत्येक समूह को एक ऑक्टल अंक में मैप करें"},"o":[{"en":"Group bits into 4s from the left","hi":"बाईं ओर से बिट्स को 4 के समूह में रखें"},{"en":"Form 3-bit groups starting from the right. Pad the leftmost incomplete group with leading zeros, then map each group to an octal digit","hi":"दाईं ओर से 3-बिट समूह (3-bit groups) बनाएं। सबसे बाएँ अपूर्ण समूह (leftmost incomplete group) को अग्रणी शून्य (leading zeros) से पैड करें (भरें), फिर प्रत्येक समूह को एक ऑक्टल अंक में मैप करें"},{"en":"Add 8 to each bit","hi":"प्रत्येक बिट में 8 जोड़ें"},{"en":"Divide by 8","hi":"8 से भाग दें"}],"exp":{"en":"Since 8 = 2^3, every three bits of binary correspond to exactly one octal digit.","hi":"चूंकि 8 = 2^3, बाइनरी के प्रत्येक तीन बिट ठीक एक ऑक्टल अंक से मेल खाते हैं।"},"num":103},{"id":"q104","q":{"en":"How do you convert (10101100)₂ to octal?","hi":"(10101100)₂ को ऑक्टल में कैसे बदलेंगे?"},"a":{"en":"(254)₈ (Groupings: 010 101 100 → 2, 5, 4)","hi":"(254)₈ (समूहीकरण: 010 101 100 → 2, 5, 4)"},"o":[{"en":"(123)₈","hi":"(123)₈"},{"en":"(254)₈ (Groupings: 010 101 100 → 2, 5, 4)","hi":"(254)₈ (समूहीकरण: 010 101 100 → 2, 5, 4)"},{"en":"(354)₈","hi":"(354)₈"},{"en":"(264)₈","hi":"(264)₈"}],"exp":{"en":"From the right: 100 is 4. Next 101 is 5. Next is 10, padded to 010 is 2. Result is 254.","hi":"दायीं ओर से: 100 का 4 है। अगला 101 का 5 है। अगला 10 है, जिसे 010 करने पर 2 है। परिणाम 254 है।"},"num":104},{"id":"q105","q":{"en":"How do you convert (10110110)₂ to octal?","hi":"(10110110)₂ को ऑक्टल में कैसे बदलेंगे?"},"a":{"en":"(266)₈ (Groupings: 010 110 110 → 2, 6, 6)","hi":"(266)₈ (समूहीकरण: 010 110 110 → 2, 6, 6)"},"o":[{"en":"(156)₈","hi":"(156)₈"},{"en":"(266)₈ (Groupings: 010 110 110 → 2, 6, 6)","hi":"(266)₈ (समूहीकरण: 010 110 110 → 2, 6, 6)"},{"en":"(346)₈","hi":"(346)₈"},{"en":"(276)₈","hi":"(276)₈"}],"exp":{"en":"From the right: 110 (6), 110 (6), 010 (2). Result: 266.","hi":"दायीं ओर से: 110 (6), 110 (6), 010 (2)। परिणाम: 266।"},"num":105},{"id":"q106","q":{"en":"How do you directly convert an octal number to binary?","hi":"ऑक्टल संख्या को बाइनरी में सीधे कैसे बदलते हैं?"},"a":{"en":"Replace each octal digit with its fixed 3-bit binary group, then join the groups","hi":"प्रत्येक ऑक्टल अंक को उसके निश्चित 3-बिट बाइनरी समूह से बदलें, फिर समूहों को जोड़ें"},"o":[{"en":"Divide by 2","hi":"2 से भाग दें"},{"en":"Replace each octal digit with its fixed 3-bit binary group, then join the groups","hi":"प्रत्येक ऑक्टल अंक को उसके निश्चित 3-बिट बाइनरी समूह से बदलें, फिर समूहों को जोड़ें"},{"en":"Multiply by 2","hi":"2 से गुणा करें"},{"en":"Replace each octal digit with a 4-bit group","hi":"प्रत्येक ऑक्टल अंक को 4-बिट समूह से बदलें"}],"exp":{"en":"The reverse process: just take each octal digit and write out its 3-bit binary equivalent.","hi":"उलट प्रक्रिया: बस प्रत्येक ऑक्टल अंक लें और उसका 3-बिट बाइनरी समतुल्य (equivalent) लिखें।"},"num":106},{"id":"q107","q":{"en":"What is the binary value of (705)₈?","hi":"(705)₈ का बाइनरी मान क्या है?"},"a":{"en":"(111000101)₂ (7→111, 0→000, 5→101)","hi":"(111000101)₂ (7→111, 0→000, 5→101)"},"o":[{"en":"(111101)₂","hi":"(111101)₂"},{"en":"(111000101)₂ (7→111, 0→000, 5→101)","hi":"(111000101)₂ (7→111, 0→000, 5→101)"},{"en":"(110000101)₂","hi":"(110000101)₂"},{"en":"(111001101)₂","hi":"(111001101)₂"}],"exp":{"en":"7 is 111, 0 is 000, 5 is 101. Put them together: 111 000 101.","hi":"7 का 111, 0 का 000, 5 का 101 है। उन्हें एक साथ रखें: 111 000 101।"},"num":107},{"id":"q108","q":{"en":"What is the binary value of (472)₈?","hi":"(472)₈ का बाइनरी मान क्या है?"},"a":{"en":"(100111010)₂ (4→100, 7→111, 2→010)","hi":"(100111010)₂ (4→100, 7→111, 2→010)"},"o":[{"en":"(101111010)₂","hi":"(101111010)₂"},{"en":"(100111010)₂ (4→100, 7→111, 2→010)","hi":"(100111010)₂ (4→100, 7→111, 2→010)"},{"en":"(100110010)₂","hi":"(100110010)₂"},{"en":"(110111010)₂","hi":"(110111010)₂"}],"exp":{"en":"4 is 100, 7 is 111, 2 is 010. Put them together: 100 111 010.","hi":"4 का 100, 7 का 111, 2 का 010 है। उन्हें एक साथ रखें: 100 111 010।"},"num":108},{"id":"q109","q":{"en":"How do you directly convert a binary integer to hexadecimal?","hi":"बाइनरी पूर्णांक को हेक्साडेसिमल में सीधे कैसे बदलते हैं?"},"a":{"en":"Form 4-bit groups starting from the right. Pad the leftmost incomplete group with leading zeros, then map to hex symbols","hi":"दाईं ओर से 4-बिट समूह (4-bit groups) बनाएं। सबसे बाएँ अपूर्ण समूह को अग्रणी शून्य (leading zeros) से भरें, फिर हेक्स प्रतीकों में मैप करें"},"o":[{"en":"Form 3-bit groups","hi":"3-बिट समूह बनाएं"},{"en":"Form 4-bit groups starting from the right. Pad the leftmost incomplete group with leading zeros, then map to hex symbols","hi":"दाईं ओर से 4-बिट समूह (4-bit groups) बनाएं। सबसे बाएँ अपूर्ण समूह को अग्रणी शून्य (leading zeros) से भरें, फिर हेक्स प्रतीकों में मैप करें"},{"en":"Multiply by 16","hi":"16 से गुणा करें"},{"en":"Divide by 16","hi":"16 से भाग दें"}],"exp":{"en":"Since 16 = 2^4, every four bits of binary correspond to exactly one hexadecimal digit.","hi":"चूंकि 16 = 2^4, बाइनरी के हर चार बिट ठीक एक हेक्साडेसिमल अंक से मेल खाते हैं।"},"num":109},{"id":"q110","q":{"en":"What is the hexadecimal value of (0110101100)₂?","hi":"(0110101100)₂ का हेक्साडेसिमल मान क्या है?"},"a":{"en":"(1AC)₁₆ (Groupings: 0001 1010 1100 → 1, A, C)","hi":"(1AC)₁₆ (समूहीकरण: 0001 1010 1100 → 1, A, C)"},"o":[{"en":"(2BC)₁₆","hi":"(2BC)₁₆"},{"en":"(1AC)₁₆ (Groupings: 0001 1010 1100 → 1, A, C)","hi":"(1AC)₁₆ (समूहीकरण: 0001 1010 1100 → 1, A, C)"},{"en":"(1BC)₁₆","hi":"(1BC)₁₆"},{"en":"(3AC)₁₆","hi":"(3AC)₁₆"}],"exp":{"en":"From the right: 1100 is C. Next 1010 is A. Next is 01, padded to 0001 is 1. Result is 1AC.","hi":"दायीं ओर से: 1100 का C है। अगला 1010 का A है। अगला 01 है, 0001 करने पर 1 है। परिणाम 1AC है।"},"num":110},{"id":"q111","q":{"en":"What is the hexadecimal value of (1101011100)₂?","hi":"(1101011100)₂ का हेक्साडेसिमल मान क्या है?"},"a":{"en":"(35C)₁₆ (Groupings: 0011 0101 1100 → 3, 5, C)","hi":"(35C)₁₆ (समूहीकरण: 0011 0101 1100 → 3, 5, C)"},"o":[{"en":"(25C)₁₆","hi":"(25C)₁₆"},{"en":"(35C)₁₆ (Groupings: 0011 0101 1100 → 3, 5, C)","hi":"(35C)₁₆ (समूहीकरण: 0011 0101 1100 → 3, 5, C)"},{"en":"(45C)₁₆","hi":"(45C)₁₆"},{"en":"(36C)₁₆","hi":"(36C)₁₆"}],"exp":{"en":"From the right: 1100 is C. Next 0101 is 5. Next 11, padded to 0011 is 3. Result is 35C.","hi":"दायीं ओर से: 1100 का C है। अगला 0101 का 5 है। अगला 11, 0011 करने पर 3 है। परिणाम 35C है।"},"num":111},{"id":"q112","q":{"en":"How do you directly convert a hexadecimal number to binary?","hi":"हेक्साडेसिमल संख्या को बाइनरी में सीधे कैसे बदलते हैं?"},"a":{"en":"Replace each hex digit with its fixed 4-bit group. Join the groups in the same order","hi":"प्रत्येक हेक्स अंक को उसके निश्चित 4-बिट समूह से बदलें। समूहों को उसी क्रम में जोड़ें"},"o":[{"en":"Divide by 2","hi":"2 से भाग दें"},{"en":"Replace each hex digit with its fixed 4-bit group. Join the groups in the same order","hi":"प्रत्येक हेक्स अंक को उसके निश्चित 4-बिट समूह से बदलें। समूहों को उसी क्रम में जोड़ें"},{"en":"Multiply by 2","hi":"2 से गुणा करें"},{"en":"Replace each hex digit with a 3-bit group","hi":"प्रत्येक हेक्स अंक को 3-बिट समूह से बदलें"}],"exp":{"en":"The reverse process: simply take each hex digit and expand it into its 4-bit binary equivalent.","hi":"उलट प्रक्रिया: बस प्रत्येक हेक्स अंक लें और इसे इसके 4-बिट बाइनरी समतुल्य में विस्तृत करें।"},"num":112},{"id":"q113","q":{"en":"What is the binary value of (23D)₁₆?","hi":"(23D)₁₆ का बाइनरी मान क्या है?"},"a":{"en":"(1000111101)₂ (2→0010, 3→0011, D→1101. Dropping leading zeros)","hi":"(1000111101)₂ (2→0010, 3→0011, D→1101. अग्रणी शून्य हटाकर)"},"o":[{"en":"(1000101101)₂","hi":"(1000101101)₂"},{"en":"(1000111101)₂ (2→0010, 3→0011, D→1101. Dropping leading zeros)","hi":"(1000111101)₂ (2→0010, 3→0011, D→1101. अग्रणी शून्य हटाकर)"},{"en":"(1100111101)₂","hi":"(1100111101)₂"},{"en":"(1001111101)₂","hi":"(1001111101)₂"}],"exp":{"en":"2 is 0010, 3 is 0011, D is 1101. Joined: 001000111101. Trim the front zeros: 1000111101.","hi":"2 का 0010, 3 का 0011, D का 1101 है। जोड़ने पर: 0010 0011 1101। सामने के शून्य हटाने पर: 1000111101।"},"num":113},{"id":"q114","q":{"en":"What is the binary value of (2F9)₁₆?","hi":"(2F9)₁₆ का बाइनरी मान क्या है?"},"a":{"en":"(1011111001)₂ (2→0010, F→1111, 9→1001. Dropping leading zeros)","hi":"(1011111001)₂ (2→0010, F→1111, 9→1001. अग्रणी शून्य हटाकर)"},"o":[{"en":"(1001111001)₂","hi":"(1001111001)₂"},{"en":"(1011111001)₂ (2→0010, F→1111, 9→1001. Dropping leading zeros)","hi":"(1011111001)₂ (2→0010, F→1111, 9→1001. अग्रणी शून्य हटाकर)"},{"en":"(1111111001)₂","hi":"(1111111001)₂"},{"en":"(1010111001)₂","hi":"(1010111001)₂"}],"exp":{"en":"2 is 0010, F is 1111, 9 is 1001. Joined: 001011111001. Trim the front zeros: 1011111001.","hi":"2 का 0010, F का 1111, 9 का 1001 है। जोड़ने पर: 0010 1111 1001। सामने के शून्य हटाने पर: 1011111001।"},"num":114},{"id":"q115","q":{"en":"What is the practical shortcut for direct conversion between octal and hexadecimal?","hi":"ऑक्टल और हेक्साडेसिमल के बीच सीधे रूपांतरण (direct conversion) के लिए व्यावहारिक शॉर्टकट क्या है?"},"a":{"en":"First convert to binary groups, then regroup into the target base's groups. Example: (172)₈ = (7A)₁₆","hi":"पहले बाइनरी समूहों (binary groups) में बदलें, फिर लक्ष्य आधार (target base) के समूहों में पुनर्समूहित (regroup) करें। उदाहरण: (172)₈ = (7A)₁₆"},"o":[{"en":"Multiply by 2","hi":"2 से गुणा करें"},{"en":"First convert to binary groups, then regroup into the target base's groups. Example: (172)₈ = (7A)₁₆","hi":"पहले बाइनरी समूहों (binary groups) में बदलें, फिर लक्ष्य आधार (target base) के समूहों में पुनर्समूहित (regroup) करें। उदाहरण: (172)₈ = (7A)₁₆"},{"en":"Add 8 to the number","hi":"संख्या में 8 जोड़ें"},{"en":"Divide by 2","hi":"2 से भाग दें"}],"exp":{"en":"Converting Octal -> Binary -> Hex (or vice versa) is much faster and less error-prone than converting through decimal.","hi":"ऑक्टल -> बाइनरी -> हेक्स (या इसके विपरीत) में परिवर्तित करना डेसीमल के माध्यम से परिवर्तित करने की तुलना में बहुत तेज है।"},"num":115},{"id":"q116","q":{"en":"What is the difference between leading zeros and internal zeros in digit groups?","hi":"अंक समूहों (digit groups) में अग्रणी शून्य (leading zeros) और बीच के शून्य (internal zeros) में क्या अंतर है?"},"a":{"en":"Overall leading zeros do not change the integer value. Zeros inside digit groups (like 000 in (705)₈) are necessary for place value","hi":"समग्र अग्रणी शून्य (overall leading zeros) पूर्णांक मान (integer value) को नहीं बदलते हैं। अंक समूहों के अंदर के शून्य (जैसे (705)₈ में 000) स्थानीय मान (place value) के लिए आवश्यक हैं"},"o":[{"en":"There is no difference","hi":"कोई अंतर नहीं है"},{"en":"Overall leading zeros do not change the integer value. Zeros inside digit groups (like 000 in (705)₈) are necessary for place value","hi":"समग्र अग्रणी शून्य (overall leading zeros) पूर्णांक मान (integer value) को नहीं बदलते हैं। अंक समूहों के अंदर के शून्य (जैसे (705)₈ में 000) स्थानीय मान (place value) के लिए आवश्यक हैं"},{"en":"Leading zeros change the value, internal zeros do not","hi":"अग्रणी शून्य मान बदलते हैं, बीच के शून्य नहीं"},{"en":"Both change the value","hi":"दोनों मान बदलते हैं"}],"exp":{"en":"00101 is the same as 101. But inside a conversion like 705 octal -> binary, the '0' must be written as '000' to keep the '7' in the correct place value position.","hi":"00101, 101 के समान है। लेकिन 705 ऑक्टल -> बाइनरी जैसे रूपांतरण के अंदर, '7' को सही स्थान पर रखने के लिए '0' को '000' के रूप में लिखा जाना चाहिए।"},"num":116}]},{"title":{"en":"10. Exam Trap Reverse-Questions","hi":"10. परीक्षा के महत्वपूर्ण उल्टे प्रश्न"},"questions":[{"id":"q117","q":{"en":"Row record and column attribute is a cue for which data type?","hi":"'पंक्ति (Row) रिकॉर्ड है और कॉलम (column) एट्रिब्यूट है' - यह किस डेटा प्रकार का संकेत (cue) है?"},"a":{"en":"Structured data","hi":"स्ट्रक्चर्ड डेटा"},"o":[{"en":"Unstructured data","hi":"अनस्ट्रक्चर्ड डेटा"},{"en":"Structured data","hi":"स्ट्रक्चर्ड डेटा"},{"en":"Metadata","hi":"मेटाडेटा"},{"en":"Binary data","hi":"बाइनरी डेटा"}],"exp":{"en":"Structured data is highly organized and formatted, typically into rows and columns (like an Excel spreadsheet or SQL database).","hi":"स्ट्रक्चर्ड डेटा अत्यधिक व्यवस्थित होता है, आमतौर पर पंक्तियों और कॉलमों में (जैसे एक्सेल स्प्रेडशीट या SQL डेटाबेस)।"},"num":117},{"id":"q118","q":{"en":"Descriptive information like subject and sender is called what?","hi":"विषय (subject) और प्रेषक (sender) जैसी विवरणात्मक जानकारी क्या कहलाती है?"},"a":{"en":"Metadata","hi":"मेटाडेटा"},"o":[{"en":"Database","hi":"डेटाबेस"},{"en":"Metadata","hi":"मेटाडेटा"},{"en":"Raw data","hi":"कच्चा डेटा"},{"en":"Output","hi":"आउटपुट"}],"exp":{"en":"Information that describes other data is called metadata.","hi":"वह जानकारी जो अन्य डेटा का वर्णन करती है, मेटाडेटा कहलाती है।"},"num":118},{"id":"q119","q":{"en":"What is the first step and formula when finding the median of an unsorted even list?","hi":"एक अव्यवस्थित सम सूची (unsorted even list) की माध्यिका (median) निकालते समय पहला कदम और सूत्र क्या है?"},"a":{"en":"Sort the list, then take the average of the two middle values","hi":"सूची को क्रमित (sort) करें, फिर दो मध्य मानों का औसत लें"},"o":[{"en":"Sum all numbers and divide by n","hi":"सभी संख्याओं को जोड़ें और n से विभाजित करें"},{"en":"Sort the list, then take the average of the two middle values","hi":"सूची को क्रमित (sort) करें, फिर दो मध्य मानों का औसत लें"},{"en":"Find the most frequent number","hi":"सबसे अधिक बार आने वाली संख्या खोजें"},{"en":"Take the maximum minus the minimum","hi":"अधिकतम में से न्यूनतम घटाएं"}],"exp":{"en":"For an even number of observations, the median is the mean of the n/2 and (n/2)+1 values in the sorted list.","hi":"अवलोकनों की सम संख्या के लिए, माध्यिका क्रमबद्ध सूची में n/2 और (n/2)+1 मानों का माध्य है।"},"num":119},{"id":"q120","q":{"en":"What matches 'most frequent category' and 'sum divided by count' respectively?","hi":"क्रमशः 'सबसे लगातार श्रेणी (most frequent category)' और 'योग को गिनती से विभाजित (sum divided by count)' का मिलान क्या है?"},"a":{"en":"Mode and Arithmetic Mean","hi":"बहुलक (Mode) और अंकगणितीय माध्य (Arithmetic Mean)"},"o":[{"en":"Mean and Median","hi":"माध्य और माध्यिका"},{"en":"Mode and Arithmetic Mean","hi":"बहुलक (Mode) और अंकगणितीय माध्य (Arithmetic Mean)"},{"en":"Range and Variance","hi":"रेंज और विचरण"},{"en":"Standard Deviation and Range","hi":"मानक विचलन और रेंज"}],"exp":{"en":"The mode is the most frequent value. The mean is the total sum divided by the number of items.","hi":"बहुलक सबसे अधिक बार आने वाला मान है। माध्य, कुल योग को आइटमों की संख्या से विभाजित करने पर प्राप्त होता है।"},"num":120},{"id":"q121","q":{"en":"Max minus min and the square root of variance match which measures?","hi":"Max माइनस min और विचरण (variance) का वर्गमूल (square root) किन उपायों (measures) से मेल खाते हैं?"},"a":{"en":"Range and standard deviation","hi":"रेंज और मानक विचलन"},"o":[{"en":"Mean and Median","hi":"माध्य और माध्यिका"},{"en":"Mode and Average","hi":"बहुलक और औसत"},{"en":"Range and standard deviation","hi":"रेंज और मानक विचलन"},{"en":"Range and mode","hi":"रेंज और बहुलक"}],"exp":{"en":"Range is the difference between maximum and minimum values. Standard deviation is the square root of the variance.","hi":"रेंज अधिकतम और न्यूनतम मानों के बीच का अंतर है। मानक विचलन विचरण का वर्गमूल है।"},"num":121},{"id":"q122","q":{"en":"What is the match for the denominators of population and sample variance?","hi":"जनसंख्या (population) और नमूना (sample) विचरण के हर (denominator) का मिलान क्या है?"},"a":{"en":"Population n, usual sample n−1","hi":"जनसंख्या n, सामान्य नमूना n−1"},"o":[{"en":"Population n, usual sample n−1","hi":"जनसंख्या n, सामान्य नमूना n−1"},{"en":"Population n−1, usual sample n","hi":"जनसंख्या n−1, सामान्य नमूना n"},{"en":"Both use n","hi":"दोनों n का उपयोग करते हैं"},{"en":"Both use n−1","hi":"दोनों n−1 का उपयोग करते हैं"}],"exp":{"en":"When calculating variance, divide by 'n' for a complete population, and 'n-1' when estimating from a sample.","hi":"विचरण की गणना करते समय, पूरी जनसंख्या के लिए 'n' से विभाजित करें, और नमूने से अनुमान लगाते समय 'n-1' से।"},"num":122},{"id":"q123","q":{"en":"128 positions and 7-bit is a cue for which code?","hi":"128 पोजीशन और 7-बिट किस कोड का संकेत (cue) है?"},"a":{"en":"Standard ASCII","hi":"स्टैंडर्ड ASCII"},"o":[{"en":"Standard ASCII","hi":"स्टैंडर्ड ASCII"},{"en":"Unicode","hi":"यूनिकोड"},{"en":"Extended ASCII","hi":"एक्सटेंडेड ASCII"},{"en":"ISCII","hi":"ISCII"}],"exp":{"en":"Original, standard ASCII uses 7 bits to provide 128 unique character codes.","hi":"मूल, मानक ASCII 128 अद्वितीय वर्ण कोड प्रदान करने के लिए 7 बिट्स का उपयोग करता है।"},"num":123},{"id":"q124","q":{"en":"What is the match for the 8-bit Indian-script standard and the worldwide code-point standard?","hi":"8-बिट इंडियन-स्क्रिप्ट मानक और विश्वव्यापी कोड-पॉइंट मानक का मिलान क्या है?"},"a":{"en":"ISCII and Unicode","hi":"ISCII और यूनिकोड"},"o":[{"en":"ASCII and EBCDIC","hi":"ASCII and EBCDIC"},{"en":"ISCII and Unicode","hi":"ISCII और यूनिकोड"},{"en":"Unicode and ISCII","hi":"यूनिकोड और ISCII"},{"en":"ISCII and ASCII","hi":"ISCII और ASCII"}],"exp":{"en":"ISCII was created for Indian scripts in an 8-bit format. Unicode is the global standard assigning code points to all characters.","hi":"ISCII को 8-बिट प्रारूप में भारतीय लिपियों के लिए बनाया गया था। यूनिकोड सभी वर्णों को कोड पॉइंट निर्दिष्ट करने वाला वैश्विक मानक है।"},"num":124},{"id":"q125","q":{"en":"What are the binary group sizes for base 8 and base 16?","hi":"बेस 8 (base 8) और बेस 16 (base 16) के लिए बाइनरी समूह आकार (binary group sizes) क्या हैं?"},"a":{"en":"Octal 3 bits, hex 4 bits","hi":"ऑक्टल 3 बिट्स, हेक्स 4 बिट्स"},"o":[{"en":"Octal 2 bits, hex 4 bits","hi":"ऑक्टल 2 बिट्स, हेक्स 4 बिट्स"},{"en":"Octal 4 bits, hex 3 bits","hi":"ऑक्टल 4 बिट्स, हेक्स 3 बिट्स"},{"en":"Octal 3 bits, hex 4 bits","hi":"ऑक्टल 3 बिट्स, हेक्स 4 बिट्स"},{"en":"Octal 3 bits, hex 5 bits","hi":"ऑक्टल 3 बिट्स, हेक्स 5 बिट्स"}],"exp":{"en":"Since 8=2^3 and 16=2^4, octal digits correspond to 3 binary bits, and hex digits correspond to 4 binary bits.","hi":"चूँकि 8=2^3 और 16=2^4, ऑक्टल अंक 3 बाइनरी बिट्स के अनुरूप होते हैं, और हेक्स अंक 4 बाइनरी बिट्स के अनुरूप होते हैं।"},"num":125},{"id":"q126","q":{"en":"What is the exam cue for converting a decimal to another base vs another base to decimal?","hi":"दशमलव (decimal) से दूसरे बेस में बनाम दूसरे बेस से दशमलव में बदलने के लिए परीक्षा संकेत (exam cue) क्या है?"},"a":{"en":"Out of decimal integer → repeated division and reverse remainders. Into decimal → weighted sum","hi":"दशमलव पूर्णांक से बाहर (Out of decimal integer) → बार-बार विभाजन और उल्टे शेषफल (repeated division and reverse remainders)। दशमलव में आना (Into decimal) → भारित योग (weighted sum)"},"o":[{"en":"Both use multiplication","hi":"दोनों गुणा का उपयोग करते हैं"},{"en":"Both use division","hi":"दोनों विभाजन का उपयोग करते हैं"},{"en":"Out of decimal integer → repeated division and reverse remainders. Into decimal → weighted sum","hi":"दशमलव पूर्णांक से बाहर (Out of decimal integer) → बार-बार विभाजन और उल्टे शेषफल (repeated division and reverse remainders)। दशमलव में आना (Into decimal) → भारित योग (weighted sum)"},{"en":"Out of decimal integer → weighted sum. Into decimal → repeated division","hi":"दशमलव पूर्णांक से बाहर → भारित योग। दशमलव में आना → बार-बार विभाजन"}],"exp":{"en":"To convert decimal 10 to binary, you divide by 2. To convert binary 1010 to decimal, you multiply digits by base powers and add them up.","hi":"दशमलव 10 को बाइनरी में बदलने के लिए, आप 2 से भाग देते हैं। बाइनरी 1010 को दशमलव में बदलने के लिए, आप अंकों को आधार की घातों से गुणा करते हैं और उन्हें जोड़ते हैं।"},"num":126},{"id":"q127","q":{"en":"What is the direction of position powers to the left and right of the radix point?","hi":"मूलांक बिंदु (radix point) के बाएँ और दाएँ घातों (powers) की दिशा क्या है?"},"a":{"en":"Left: 0, 1, 2... positions from point outward. Right: −1, −2, −3... positions","hi":"बाएँ (Left) पर 0, 1, 2... पॉइंट से बाहर की ओर स्थितियां (positions from point outward)। दाएँ (Right) पर −1, −2, −3... स्थितियां"},"o":[{"en":"Left: 1, 2, 3... Right: 0, -1, -2...","hi":"Left: 1, 2, 3... Right: 0, -1, -2..."},{"en":"Left: 0, 1, 2... positions from point outward. Right: −1, −2, −3... positions","hi":"बाएँ (Left) पर 0, 1, 2... पॉइंट से बाहर की ओर स्थितियां (positions from point outward)। दाएँ (Right) पर −1, −2, −3... स्थितियां"},{"en":"Left: -1, -2, -3... Right: 0, 1, 2...","hi":"Left: -1, -2, -3... Right: 0, 1, 2..."},{"en":"Left: 0, -1, -2... Right: 1, 2, 3...","hi":"Left: 0, -1, -2... Right: 1, 2, 3..."}],"exp":{"en":"The integer part starts at power 0 and increases to the left. The fractional part starts at -1 and decreases to the right.","hi":"पूर्णांक भाग घात 0 से शुरू होता है और बाईं ओर बढ़ता है। भिन्नात्मक भाग -1 से शुरू होता है और दाईं ओर घटता है।"},"num":127},{"id":"q128","q":{"en":"Hex digit A is decimal 10. Does hex “10” equal decimal 10?","hi":"हेक्स अंक A दशमलव 10 है। क्या हेक्स '10' दशमलव 10 के बराबर है?"},"a":{"en":"No, (10)₁₆ = 16 decimal, whereas (A)₁₆ = 10 decimal","hi":"नहीं, (10)₁₆ = 16 डेसीमल, जबकि (A)₁₆ = 10 डेसीमल"},"o":[{"en":"Yes, they are the same","hi":"हाँ, वे समान हैं"},{"en":"No, (10)₁₆ = 16 decimal, whereas (A)₁₆ = 10 decimal","hi":"नहीं, (10)₁₆ = 16 डेसीमल, जबकि (A)₁₆ = 10 डेसीमल"},{"en":"No, (10)₁₆ is 100 decimal","hi":"नहीं, (10)₁₆ 100 डेसीमल है"},{"en":"No, (10)₁₆ is 8 decimal","hi":"नहीं, (10)₁₆ 8 डेसीमल है"}],"exp":{"en":"In hex, '10' means 1 group of sixteen and 0 units, which is 16 in decimal. The value 10 is represented by the single letter 'A'.","hi":"हेक्स में, '10' का मतलब सोलह का 1 समूह और 0 इकाइयाँ हैं, जो दशमलव में 16 है। मान 10 को एकल अक्षर 'A' द्वारा दर्शाया जाता है।"},"num":128},{"id":"q129","q":{"en":"In the example converting 122 to 7A, what is the correct target-base label?","hi":"122 को 7A में बदलने वाले उदाहरण में, सही लक्ष्य-आधार लेबल (target-base label) क्या है?"},"a":{"en":"Base 16. Base 8's answer is 172","hi":"बेस 16। बेस 8 का उत्तर 172 है"},"o":[{"en":"Base 2","hi":"Base 2"},{"en":"Base 8","hi":"Base 8"},{"en":"Base 16. Base 8's answer is 172","hi":"बेस 16। बेस 8 का उत्तर 172 है"},{"en":"Base 10","hi":"Base 10"}],"exp":{"en":"7A contains the letter 'A', which is only valid in base 16 (hexadecimal).","hi":"7A में अक्षर 'A' है, जो केवल बेस 16 (हेक्साडेसिमल) में मान्य है।"},"num":129}]},{"title":{"en":"11. Rapid-Fire Final Revision","hi":"11. त्वरित अंतिम पुनरावृत्ति"},"questions":[{"id":"q130","q":{"en":"What is data about data?","hi":"डेटा के बारे में डेटा क्या है?"},"a":{"en":"Metadata","hi":"मेटाडेटा"},"o":[{"en":"Output","hi":"आउटपुट"},{"en":"Database","hi":"डेटाबेस"},{"en":"Metadata","hi":"मेटाडेटा"},{"en":"Input","hi":"इनपुट"}],"exp":{"en":"Metadata provides information about other data.","hi":"मेटाडेटा अन्य डेटा के बारे में जानकारी प्रदान करता है।"},"num":130},{"id":"q131","q":{"en":"What do rows and columns represent respectively?","hi":"पंक्तियाँ (rows) और कॉलम (columns) क्रमशः क्या दर्शाते हैं?"},"a":{"en":"Records and fields","hi":"रिकॉर्ड (Records) और फ़ील्ड (fields)"},"o":[{"en":"Numbers and Text","hi":"संख्याएँ और टेक्स्ट"},{"en":"Fields and Records","hi":"फ़ील्ड और रिकॉर्ड"},{"en":"Records and fields","hi":"रिकॉर्ड (Records) और फ़ील्ड (fields)"},{"en":"Input and Output","hi":"इनपुट और आउटपुट"}],"exp":{"en":"Rows are individual records (observations); columns are fields (attributes).","hi":"पंक्तियाँ व्यक्तिगत रिकॉर्ड (अवलोकन) हैं; कॉलम फ़ील्ड (विशेषताएं) हैं।"},"num":131},{"id":"q132","q":{"en":"What is the abbreviation for database management system?","hi":"डेटाबेस मैनेजमेंट सिस्टम का संक्षिप्त नाम क्या है?"},"a":{"en":"DBMS","hi":"DBMS"},"o":[{"en":"SQL","hi":"SQL"},{"en":"DBMS","hi":"DBMS"},{"en":"DBA","hi":"DBA"},{"en":"DBMD","hi":"DBMD"}],"exp":{"en":"DBMS stands for Database Management System.","hi":"DBMS का अर्थ डेटाबेस मैनेजमेंट सिस्टम है।"},"num":132},{"id":"q133","q":{"en":"What is the process of making raw values into useful results?","hi":"कच्चे मानों (raw values) को उपयोगी परिणामों में बनाने की प्रक्रिया क्या है?"},"a":{"en":"Data processing","hi":"डेटा प्रोसेसिंग"},"o":[{"en":"Data representation","hi":"डेटा निरूपण"},{"en":"Data collection","hi":"डेटा कलेक्शन"},{"en":"Data processing","hi":"डेटा प्रोसेसिंग"},{"en":"Data storage","hi":"डेटा स्टोरेज"}],"exp":{"en":"Data processing transforms raw data into meaningful information.","hi":"डेटा प्रोसेसिंग कच्चे डेटा को सार्थक जानकारी में बदल देती है।"},"num":133},{"id":"q134","q":{"en":"What is the total sum divided by count?","hi":"कुल योग को गिनती से विभाजित करने पर क्या मिलता है?"},"a":{"en":"Mean","hi":"माध्य"},"o":[{"en":"Median","hi":"माध्यिका"},{"en":"Mean","hi":"माध्य"},{"en":"Mode","hi":"बहुलक"},{"en":"Range","hi":"रेंज"}],"exp":{"en":"This is the formula for the arithmetic mean (average).","hi":"यह अंकगणितीय माध्य (औसत) का सूत्र है।"},"num":134},{"id":"q135","q":{"en":"What is the middle value of a sorted list?","hi":"एक क्रमबद्ध सूची का मध्य मान (middle value) क्या है?"},"a":{"en":"Median","hi":"माध्यिका"},"o":[{"en":"Mean","hi":"माध्य"},{"en":"Median","hi":"माध्यिका"},{"en":"Mode","hi":"बहुलक"},{"en":"Variance","hi":"विचरण"}],"exp":{"en":"The median splits the dataset exactly in half.","hi":"माध्यिका डेटासेट को ठीक आधे में विभाजित करती है।"},"num":135},{"id":"q136","q":{"en":"What is the value with the highest frequency?","hi":"सबसे अधिक आवृत्ति (highest frequency) वाला मान क्या है?"},"a":{"en":"Mode","hi":"बहुलक"},"o":[{"en":"Median","hi":"माध्यिका"},{"en":"Mean","hi":"माध्य"},{"en":"Mode","hi":"बहुलक"},{"en":"Standard Deviation","hi":"मानक विचलन"}],"exp":{"en":"The mode is the most frequently occurring value in a dataset.","hi":"बहुलक एक डेटासेट में सबसे अधिक बार आने वाला मान है।"},"num":136},{"id":"q137","q":{"en":"What is maximum minus minimum?","hi":"अधिकतम में से न्यूनतम घटाने पर क्या मिलता है?"},"a":{"en":"Range","hi":"रेंज"},"o":[{"en":"Variance","hi":"विचरण"},{"en":"Range","hi":"रेंज"},{"en":"Standard Deviation","hi":"मानक विचलन"},{"en":"Midrange","hi":"मिडरेंज"}],"exp":{"en":"The range is the difference between the highest and lowest values.","hi":"रेंज उच्चतम और निम्नतम मानों के बीच का अंतर है।"},"num":137},{"id":"q138","q":{"en":"What is the square root of variance?","hi":"विचरण (variance) का वर्गमूल क्या है?"},"a":{"en":"Standard deviation","hi":"मानक विचलन"},"o":[{"en":"Mean","hi":"माध्य"},{"en":"Median","hi":"माध्यिका"},{"en":"Standard deviation","hi":"मानक विचलन"},{"en":"Range","hi":"रेंज"}],"exp":{"en":"Standard deviation is defined as the square root of the variance.","hi":"मानक विचलन को विचरण के वर्गमूल के रूप में परिभाषित किया गया है।"},"num":138},{"id":"q139","q":{"en":"What makes 1 byte?","hi":"1 बाइट (byte) कैसे बनता है?"},"a":{"en":"8 bits","hi":"8 बिट्स"},"o":[{"en":"4 bits","hi":"4 बिट्स"},{"en":"8 bits","hi":"8 बिट्स"},{"en":"16 bits","hi":"16 बिट्स"},{"en":"2 bits","hi":"2 बिट्स"}],"exp":{"en":"A byte is universally defined as a grouping of 8 bits.","hi":"एक बाइट को सार्वभौमिक रूप से 8 बिट्स के समूह के रूप में परिभाषित किया गया है।"},"num":139},{"id":"q140","q":{"en":"What does 'Bit' stand for?","hi":"'Bit' का क्या अर्थ है?"},"a":{"en":"Binary digit","hi":"बाइनरी डिजिट"},"o":[{"en":"Binary input","hi":"बाइनरी इनपुट"},{"en":"Byte integer","hi":"बाइट इंटीजर"},{"en":"Binary digit","hi":"बाइनरी डिजिट"},{"en":"Basic item","hi":"बेसिक आइटम"}],"exp":{"en":"A bit is a binary digit (0 or 1).","hi":"एक बिट एक बाइनरी डिजिट (0 या 1) है।"},"num":140},{"id":"q141","q":{"en":"How many bits are in standard ASCII?","hi":"मानक (standard) ASCII में कितने बिट होते हैं?"},"a":{"en":"7","hi":"7"},"o":[{"en":"7","hi":"7"},{"en":"8","hi":"8"},{"en":"16","hi":"16"},{"en":"32","hi":"32"}],"exp":{"en":"Standard ASCII is a 7-bit character encoding.","hi":"मानक ASCII एक 7-बिट कैरेक्टर एन्कोडिंग है।"},"num":141},{"id":"q142","q":{"en":"How many code positions does standard ASCII have?","hi":"मानक ASCII में कितनी कोड पोजीशन (code positions) होती हैं?"},"a":{"en":"128","hi":"128"},"o":[{"en":"256","hi":"256"},{"en":"128","hi":"128"},{"en":"64","hi":"64"},{"en":"512","hi":"512"}],"exp":{"en":"With 7 bits, standard ASCII provides 2^7 = 128 positions.","hi":"7 बिट्स के साथ, मानक ASCII 2^7 = 128 पोजीशन प्रदान करता है।"},"num":142},{"id":"q143","q":{"en":"What is the 8-bit Indian-script legacy standard?","hi":"8-बिट इंडियन-स्क्रिप्ट लीगेसी स्टैंडर्ड (legacy standard) क्या है?"},"a":{"en":"ISCII","hi":"ISCII"},"o":[{"en":"Unicode","hi":"यूनिकोड"},{"en":"ASCII","hi":"ASCII"},{"en":"ISCII","hi":"ISCII"},{"en":"UTF-8","hi":"UTF-8"}],"exp":{"en":"ISCII (Indian Script Code for Information Interchange) is the legacy 8-bit standard.","hi":"ISCII (इंडियन स्क्रिप्ट कोड फॉर इंफॉर्मेशन इंटरचेंज) लीगेसी 8-बिट मानक है।"},"num":143},{"id":"q144","q":{"en":"UTF-8, UTF-16, and UTF-32 are related to which standard?","hi":"UTF-8, UTF-16 और UTF-32 किस मानक (standard) से संबंधित हैं?"},"a":{"en":"Unicode","hi":"यूनिकोड"},"o":[{"en":"ISCII","hi":"ISCII"},{"en":"ASCII","hi":"ASCII"},{"en":"Unicode","hi":"यूनिकोड"},{"en":"EBCDIC","hi":"EBCDIC"}],"exp":{"en":"They are Unicode Transformation Formats.","hi":"ये यूनिकोड ट्रांसफॉर्मेशन फॉर्मेट (Unicode Transformation Formats) हैं।"},"num":144},{"id":"q145","q":{"en":"What are the names of base 2, 8, 10, and 16 systems respectively?","hi":"बेस 2, 8, 10 और 16 सिस्टम के नाम क्रमशः क्या हैं?"},"a":{"en":"Binary, octal, decimal, hexadecimal","hi":"बाइनरी, ऑक्टल, डेसीमल, हेक्साडेसिमल"},"o":[{"en":"Binary, octal, decimal, hexadecimal","hi":"बाइनरी, ऑक्टल, डेसीमल, हेक्साडेसिमल"},{"en":"Decimal, binary, octal, hexadecimal","hi":"डेसीमल, बाइनरी, ऑक्टल, हेक्साडेसिमल"},{"en":"Octal, binary, decimal, hexadecimal","hi":"ऑक्टल, बाइनरी, डेसीमल, हेक्साडेसिमल"},{"en":"Hexadecimal, decimal, octal, binary","hi":"हेक्साडेसिमल, डेसीमल, ऑक्टल, बाइनरी"}],"exp":{"en":"Base 2 is Binary, Base 8 is Octal, Base 10 is Decimal, Base 16 is Hexadecimal.","hi":"बेस 2 बाइनरी है, बेस 8 ऑक्टल है, बेस 10 डेसीमल है, बेस 16 हेक्साडेसिमल है।"},"num":145},{"id":"q146","q":{"en":"What are the decimal values of Hex C and F?","hi":"हेक्स C और F के दशमलव मान क्या हैं?"},"a":{"en":"12 and 15 decimal","hi":"12 और 15 डेसीमल"},"o":[{"en":"10 and 15","hi":"10 और 15"},{"en":"12 and 15 decimal","hi":"12 और 15 डेसीमल"},{"en":"11 and 14","hi":"11 और 14"},{"en":"13 and 16","hi":"13 और 16"}],"exp":{"en":"A=10, B=11, C=12, D=13, E=14, F=15.","hi":"A=10, B=11, C=12, D=13, E=14, F=15."},"num":146},{"id":"q147","q":{"en":"What is the decimal value of binary 1000?","hi":"बाइनरी 1000 का दशमलव मान क्या है?"},"a":{"en":"8","hi":"8"},"o":[{"en":"4","hi":"4"},{"en":"8","hi":"8"},{"en":"16","hi":"16"},{"en":"2","hi":"2"}],"exp":{"en":"1 * 2^3 = 8.","hi":"1 * 2^3 = 8."},"num":147},{"id":"q148","q":{"en":"What are the binary, octal, and hex forms of (122)₁₀?","hi":"(122)₁₀ के बाइनरी, ऑक्टल और हेक्स रूप क्या हैं?"},"a":{"en":"(1111010)₂, (172)₈, (7A)₁₆","hi":"(1111010)₂, (172)₈, (7A)₁₆"},"o":[{"en":"(1111010)₂, (172)₈, (7A)₁₆","hi":"(1111010)₂, (172)₈, (7A)₁₆"},{"en":"(1010101)₂, (172)₈, (7B)₁₆","hi":"(1010101)₂, (172)₈, (7B)₁₆"},{"en":"(1110000)₂, (152)₈, (6A)₁₆","hi":"(1110000)₂, (152)₈, (6A)₁₆"},{"en":"(1111110)₂, (174)₈, (7C)₁₆","hi":"(1111110)₂, (174)₈, (7C)₁₆"}],"exp":{"en":"The conversions are: 1111010 in binary, 172 in octal, and 7A in hexadecimal.","hi":"रूपांतरण हैं: बाइनरी में 1111010, ऑक्टल में 172 और हेक्साडेसिमल में 7A।"},"num":148},{"id":"q149","q":{"en":"What is the decimal result of (257)₈ and (3A5)₁₆?","hi":"(257)₈ और (3A5)₁₆ का दशमलव परिणाम (decimal result) क्या है?"},"a":{"en":"175 and 933","hi":"175 और 933"},"o":[{"en":"150 and 900","hi":"150 और 900"},{"en":"175 and 933","hi":"175 और 933"},{"en":"200 and 1000","hi":"200 और 1000"},{"en":"175 and 950","hi":"175 और 950"}],"exp":{"en":"(2*64 + 5*8 + 7) = 175. (3*256 + 10*16 + 5) = 933.","hi":"(2*64 + 5*8 + 7) = 175. (3*256 + 10*16 + 5) = 933."},"num":149},{"id":"q150","q":{"en":"Where does grouping start when converting from binary to octal/hex?","hi":"बाइनरी से ऑक्टल/हेक्स में परिवर्तित करते समय समूहीकरण (grouping) कहाँ से शुरू होता है?"},"a":{"en":"From the integer's right end (the radix point) and moving left","hi":"पूर्णांक के दाएँ छोर (मूलांक बिंदु / radix point) से और बाएँ (left) की ओर बढ़ते हुए"},"o":[{"en":"From the left end","hi":"बाएँ छोर से"},{"en":"From the integer's right end (the radix point) and moving left","hi":"पूर्णांक के दाएँ छोर (मूलांक बिंदु / radix point) से और बाएँ (left) की ओर बढ़ते हुए"},{"en":"From the middle","hi":"बीच से"},{"en":"It does not matter","hi":"इससे कोई फर्क नहीं पड़ता"}],"exp":{"en":"Grouping bits for integers always starts from the right side (least significant bit) and moves leftwards.","hi":"पूर्णांकों के लिए बिट्स को समूहीकृत करना हमेशा दाईं ओर (सबसे कम महत्वपूर्ण बिट) से शुरू होता है और बाईं ओर बढ़ता है।"},"num":150},{"id":"q151","q":{"en":"What is the decimal value of the binary fraction .101?","hi":"बाइनरी अंश (binary fraction) .101 का दशमलव मान क्या है?"},"a":{"en":"0.625","hi":"0.625"},"o":[{"en":"0.101","hi":"0.101"},{"en":"0.5","hi":"0.5"},{"en":"0.625","hi":"0.625"},{"en":"0.75","hi":"0.75"}],"exp":{"en":"(1 * 1/2) + (0 * 1/4) + (1 * 1/8) = 0.5 + 0.125 = 0.625.","hi":"(1 * 1/2) + (0 * 1/4) + (1 * 1/8) = 0.5 + 0.125 = 0.625."},"num":151}]}],"9. Computer Codes, Boolean Data & Logic Gates":[{"title":{"en":"1. Computer Codes & Character Representation","hi":"1. कंप्यूटर कोड और कैरेक्टर रिप्रेजेंटेशन"},"questions":[{"id":"q1","q":{"en":"What is a computer code?","hi":"कंप्यूटर कोड (Computer code) क्या होता है?"},"a":{"en":"A defined mapping that represents letters, digits, special symbols, or control characters using binary patterns","hi":"एक परिभाषित मैपिंग जो बाइनरी पैटर्न का उपयोग करके अक्षरों, अंकों, विशेष प्रतीकों या नियंत्रण वर्णों को दर्शाती है"},"o":[{"en":"A type of computer hardware","hi":"एक प्रकार का कंप्यूटर हार्डवेयर"},{"en":"A defined mapping that represents letters, digits, special symbols, or control characters using binary patterns","hi":"एक परिभाषित मैपिंग जो बाइनरी पैटर्न का उपयोग करके अक्षरों, अंकों, विशेष प्रतीकों या नियंत्रण वर्णों को दर्शाती है"},{"en":"A mechanical switch used in old computers","hi":"पुराने कंप्यूटरों में इस्तेमाल होने वाला एक यांत्रिक स्विच"},{"en":"A programming language like Python","hi":"पायथन जैसी एक प्रोग्रामिंग भाषा"}],"exp":{"en":"A computer code is a defined mapping that uses binary patterns to represent letters, digits, special symbols, or control characters.","hi":"कंप्यूटर कोड एक परिभाषित मैपिंग (defined mapping) है जो अक्षरों, अंकों, विशेष प्रतीकों या कंट्रोल कैरेक्टर को बाइनरी पैटर्न से दर्शाती है।"},"num":1},{"id":"q2","q":{"en":"Does the bit pattern 01000001 always have the same meaning?","hi":"क्या बिट पैटर्न 01000001 का अर्थ हमेशा एक समान होता है?"},"a":{"en":"No, the meaning depends on the code used; in ASCII it is capital 'A', while as an unsigned binary number it is 65","hi":"नहीं, अर्थ उपयोग किए गए कोड पर निर्भर करता है; ASCII में यह कैपिटल 'A' है, जबकि अनसाइन्ड बाइनरी नंबर के रूप में इसका मान 65 है"},"o":[{"en":"Yes, it always means the number 65","hi":"हाँ, इसका अर्थ हमेशा संख्या 65 होता है"},{"en":"Yes, it always means the letter 'A'","hi":"हाँ, इसका अर्थ हमेशा अक्षर 'A' होता है"},{"en":"No, the meaning depends on the code used; in ASCII it is capital 'A', while as an unsigned binary number it is 65","hi":"नहीं, अर्थ उपयोग किए गए कोड पर निर्भर करता है; ASCII में यह कैपिटल 'A' है, जबकि अनसाइन्ड बाइनरी नंबर के रूप में इसका मान 65 है"},{"en":"No, it always represents an error code","hi":"नहीं, यह हमेशा एक त्रुटि कोड (error code) को दर्शाता है"}],"exp":{"en":"The meaning of a bit pattern depends entirely on the code used; for example, 01000001 is 'A' in ASCII but represents the value 65 as an unsigned binary number.","hi":"किसी बिट पैटर्न का अर्थ उपयोग किए गए कोड पर निर्भर करता है। उदाहरण के लिए, 01000001 ASCII में कैपिटल A है, लेकिन एक अनसाइन्ड बाइनरी नंबर (unsigned binary number) के रूप में इसका मान 65 है।"},"num":2},{"id":"q3","q":{"en":"What is the full form of BCD and what is its basic rule in 8421 format?","hi":"BCD का पूर्ण रूप क्या है और 8421 प्रारूप में इसका मूल नियम क्या है?"},"a":{"en":"Binary Coded Decimal; each decimal digit (0–9) has its own 4-bit code with weights 8, 4, 2, and 1","hi":"बाइनरी कोडेड डेसिमल; प्रत्येक दशमलव अंक (0-9) का अपना 4-बिट कोड होता है, जिसके वेट (weights) 8, 4, 2 और 1 होते हैं"},"o":[{"en":"Binary Coded Decimal; each decimal digit (0–9) has its own 4-bit code with weights 8, 4, 2, and 1","hi":"बाइनरी कोडेड डेसिमल; प्रत्येक दशमलव अंक (0-9) का अपना 4-बिट कोड होता है, जिसके वेट (weights) 8, 4, 2 और 1 होते हैं"},{"en":"Basic Computer Data; it converts numbers to 8-bit text","hi":"बेसिक कंप्यूटर डेटा; यह संख्याओं को 8-बिट टेक्स्ट में बदलता है"},{"en":"Binary Code Dictionary; it translates letters to 16-bit binary","hi":"बाइनरी कोड डिक्शनरी; यह अक्षरों को 16-बिट बाइनरी में अनुवादित करता है"},{"en":"Byte Coded Decimal; every byte represents one digit","hi":"बाइट कोडेड डेसिमल; प्रत्येक बाइट एक अंक को दर्शाता है"}],"exp":{"en":"BCD stands for Binary Coded Decimal. In 8421 BCD, each decimal digit from 0 to 9 is represented by a unique 4-bit code based on the positional weights 8, 4, 2, and 1.","hi":"BCD का पूर्ण रूप बाइनरी कोडेड डेसिमल (Binary Coded Decimal) है। 8421 BCD में, प्रत्येक दशमलव अंक (0–9) का अपना 4-बिट कोड होता है, जिसके वेट 8, 4, 2 और 1 होते हैं।"},"num":3},{"id":"q4","q":{"en":"What are the 8421 BCD codes for decimal digits 0 to 9?","hi":"8421 BCD में दशमलव अंक 0 से 9 के कोड क्या हैं?"},"a":{"en":"0→0000, 1→0001, 2→0010, 3→0011, 4→0100, 5→0101, 6→0110, 7→0111, 8→1000, 9→1001","hi":"0→0000, 1→0001, 2→0010, 3→0011, 4→0100, 5→0101, 6→0110, 7→0111, 8→1000, 9→1001"},"o":[{"en":"They start at 1000 and go up to 1001","hi":"वे 1000 से शुरू होकर 1001 तक जाते हैं"},{"en":"0→0000, 1→0001, 2→0010, 3→0011, 4→0100, 5→0101, 6→0110, 7→0111, 8→1000, 9→1001","hi":"0→0000, 1→0001, 2→0010, 3→0011, 4→0100, 5→0101, 6→0110, 7→0111, 8→1000, 9→1001"},{"en":"0→1111, 1→1110, down to 9→0110","hi":"0→1111, 1→1110, नीचे 9→0110 तक"},{"en":"They use 8 bits for each digit","hi":"वे प्रत्येक अंक के लिए 8 बिट का उपयोग करते हैं"}],"exp":{"en":"The 8421 BCD representation follows standard 4-bit binary equivalents for the decimal digits 0 through 9.","hi":"8421 BCD में दशमलव अंकों (0–9) के कोड उनके मानक 4-बिट बाइनरी समतुल्य होते हैं (0→0000 से 9→1001 तक)।"},"num":4},{"id":"q5","q":{"en":"How is the decimal number 59 written in 8421 BCD?","hi":"दशमलव 59 को 8421 BCD में कैसे लिखा जाता है?"},"a":{"en":"By writing 5 and 9 together as 0101 1001","hi":"5 और 9 को एक साथ 0101 1001 के रूप में लिखकर"},"o":[{"en":"As a single 8-bit number: 00111011","hi":"एक एकल 8-बिट संख्या के रूप में: 00111011"},{"en":"By writing 5 and 9 together as 0101 1001","hi":"5 और 9 को एक साथ 0101 1001 के रूप में लिखकर"},{"en":"59 cannot be written in BCD","hi":"59 को BCD में नहीं लिखा जा सकता"},{"en":"By adding 5 and 9 to get 14, then writing 1110","hi":"5 और 9 को जोड़कर 14 प्राप्त करके, फिर 1110 लिखकर"}],"exp":{"en":"In BCD, each decimal digit is encoded separately. So, 5 becomes 0101 and 9 becomes 1001, combining to 0101 1001 (whereas pure binary 59 is 111011).","hi":"BCD में प्रत्येक दशमलव अंक अलग से एन्कोड होता है। 5 के लिए 0101 और 9 के लिए 1001, कुल मिलाकर 0101 1001 (जबकि शुद्ध बाइनरी में 59 का मान 111011 होता है)।"},"num":5},{"id":"q6","q":{"en":"What is the decimal number for the BCD pattern 0010 0101 1001?","hi":"BCD पैटर्न 0010 0101 1001 का दशमलव नंबर क्या है?"},"a":{"en":"259 (Groups 0010, 0101, and 1001 are read as 2, 5, and 9)","hi":"259 (समूह 0010, 0101 और 1001 को 2, 5 और 9 पढ़ा जाता है)"},"o":[{"en":"59","hi":"59"},{"en":"105","hi":"105"},{"en":"259 (Groups 0010, 0101, and 1001 are read as 2, 5, and 9)","hi":"259 (समूह 0010, 0101 और 1001 को 2, 5 और 9 पढ़ा जाता है)"},{"en":"601 (Treated as a pure 12-bit binary number)","hi":"601 (शुद्ध 12-बिट बाइनरी संख्या माना जाता है)"}],"exp":{"en":"Reading the BCD pattern in 4-bit groups: 0010 is 2, 0101 is 5, and 1001 is 9, resulting in the decimal number 259.","hi":"BCD पैटर्न को 4-बिट समूहों में पढ़ने पर: 0010 = 2, 0101 = 5, और 1001 = 9, जिससे दशमलव संख्या 259 बनती है।"},"num":6},{"id":"q7","q":{"en":"Which 4-bit patterns are invalid for a single digit in 8421 BCD?","hi":"8421 BCD में एक अंक (single digit) के लिए कौन से 4-बिट पैटर्न अमान्य (invalid) हैं?"},"a":{"en":"1010, 1011, 1100, 1101, 1110, and 1111 (binary 10 to 15, since a decimal digit only goes up to 9)","hi":"1010, 1011, 1100, 1101, 1110 और 1111 (बाइनरी 10 से 15, क्योंकि दशमलव अंक केवल 9 तक होता है)"},"o":[{"en":"0000 to 1001","hi":"0000 से 1001"},{"en":"1010, 1011, 1100, 1101, 1110, and 1111 (binary 10 to 15, since a decimal digit only goes up to 9)","hi":"1010, 1011, 1100, 1101, 1110 और 1111 (बाइनरी 10 से 15, क्योंकि दशमलव अंक केवल 9 तक होता है)"},{"en":"Only 1111 is invalid","hi":"केवल 1111 अमान्य है"},{"en":"There are no invalid 4-bit patterns","hi":"कोई अमान्य 4-बिट पैटर्न नहीं है"}],"exp":{"en":"Since a single decimal digit only goes from 0 to 9, the 4-bit patterns representing 10 to 15 (1010 through 1111) are invalid in standard 8421 BCD.","hi":"चूँकि एक दशमलव अंक 0 से 9 तक ही होता है, बाइनरी में 10 से 15 तक के पैटर्न (1010, 1011, 1100, 1101, 1110, 1111) BCD में अमान्य (invalid) होते हैं।"},"num":7},{"id":"q8","q":{"en":"How many bits are required to store the BCD digits for the decimal number 100?","hi":"दशमलव 100 के BCD अंकों को स्टोर करने के लिए कितने बिट्स की आवश्यकता होगी?"},"a":{"en":"12 bits (Three digits × 4 bits; code is 0001 0000 0000)","hi":"12 बिट्स (तीन अंक × 4 बिट्स; कोड 0001 0000 0000 है)"},"o":[{"en":"4 bits","hi":"4 बिट्स"},{"en":"8 bits","hi":"8 बिट्स"},{"en":"12 bits (Three digits × 4 bits; code is 0001 0000 0000)","hi":"12 बिट्स (तीन अंक × 4 बिट्स; कोड 0001 0000 0000 है)"},{"en":"16 bits","hi":"16 बिट्स"}],"exp":{"en":"The decimal number 100 has three digits. In BCD, each digit requires 4 bits, so it takes 3 × 4 = 12 bits (0001 0000 0000). Extra storage depends on the system format.","hi":"दशमलव संख्या 100 में तीन अंक हैं। प्रत्येक अंक के लिए 4 बिट्स चाहिए, इसलिए कुल 3 × 4 = 12 बिट्स (0001 0000 0000) लगेंगे। (अतिरिक्त पैडिंग सिस्टम पर निर्भर करती है)।"},"num":8},{"id":"q9","q":{"en":"Is BCD representation limited to only a single 4-bit group?","hi":"क्या BCD प्रतिनिधित्व केवल एक ही 4-बिट समूह तक सीमित है?"},"a":{"en":"No, groups can be added for each digit; maximum length depends on implementation or field size","hi":"नहीं, प्रत्येक अंक के लिए समूह जोड़े जा सकते हैं; अधिकतम लंबाई कार्यान्वयन या फ़ील्ड आकार पर निर्भर करती है"},"o":[{"en":"Yes, it can only represent numbers 0 to 9","hi":"हाँ, यह केवल 0 से 9 तक की संख्या को दर्शा सकता है"},{"en":"No, groups can be added for each digit; maximum length depends on implementation or field size","hi":"नहीं, प्रत्येक अंक के लिए समूह जोड़े जा सकते हैं; अधिकतम लंबाई कार्यान्वयन या फ़ील्ड आकार पर निर्भर करती है"},{"en":"Yes, it is restricted to one byte","hi":"हाँ, यह एक बाइट तक सीमित है"},{"en":"No, but it can only go up to 99","hi":"नहीं, लेकिन यह केवल 99 तक ही जा सकता है"}],"exp":{"en":"BCD is not limited to one digit; you can string together multiple 4-bit groups to represent larger decimal numbers, limited only by the system's field size.","hi":"BCD एक अंक तक सीमित नहीं है। आप प्रत्येक अंक के लिए एक 4-बिट समूह जोड़ सकते हैं। अधिकतम स्टोर की जाने वाली लंबाई सिस्टम के फ़ील्ड आकार (field size) पर निर्भर करती है।"},"num":9},{"id":"q10","q":{"en":"What is the full form of ASCII?","hi":"ASCII का पूर्ण रूप क्या है?"},"a":{"en":"American Standard Code for Information Interchange","hi":"अमेरिकन स्टैंडर्ड कोड फॉर इंफॉर्मेशन इंटरचेंज"},"o":[{"en":"Asian Standard Code for Information Interchange","hi":"एशियन स्टैंडर्ड कोड फॉर इंफॉर्मेशन इंटरचेंज"},{"en":"Advanced System Code for Internet Interchange","hi":"एडवांस्ड सिस्टम कोड फॉर इंटरनेट इंटरचेंज"},{"en":"American Standard Code for Information Interchange","hi":"अमेरिकन स्टैंडर्ड कोड फॉर इंफॉर्मेशन इंटरचेंज"},{"en":"Automatic Standard Code for Information Integration","hi":"ऑटोमैटिक स्टैंडर्ड कोड फॉर इंफॉर्मेशन इंटीग्रेशन"}],"exp":{"en":"ASCII stands for American Standard Code for Information Interchange.","hi":"ASCII का पूर्ण रूप 'अमेरिकन स्टैंडर्ड कोड फॉर इंफॉर्मेशन इंटरचेंज' (American Standard Code for Information Interchange) है।"},"num":10},{"id":"q11","q":{"en":"How many bits and code values are there in standard ASCII?","hi":"स्टैंडर्ड ASCII में कितने बिट्स और कितने कोड वैल्यू होते हैं?"},"a":{"en":"7 bits and 128 values (decimal 0–127, including printable and control characters)","hi":"7 बिट्स और 128 वैल्यू (दशमलव 0-127, जिसमें प्रिंट करने योग्य और कंट्रोल कैरेक्टर शामिल हैं)"},"o":[{"en":"8 bits and 256 values","hi":"8 बिट्स और 256 वैल्यू"},{"en":"7 bits and 128 values (decimal 0–127, including printable and control characters)","hi":"7 बिट्स और 128 वैल्यू (दशमलव 0-127, जिसमें प्रिंट करने योग्य और कंट्रोल कैरेक्टर शामिल हैं)"},{"en":"16 bits and 65,536 values","hi":"16 बिट्स और 65,536 वैल्यू"},{"en":"4 bits and 16 values","hi":"4 बिट्स और 16 वैल्यू"}],"exp":{"en":"Standard ASCII is a 7-bit code, which means it can represent 2⁷ = 128 distinct values (from 0 to 127).","hi":"स्टैंडर्ड ASCII 7-बिट का कोड है, इसलिए इसमें 2⁷ = 128 वैल्यू (दशमलव 0–127) होते हैं, जिनमें प्रिंटेबल (printable) और कंट्रोल कैरेक्टर आते हैं।"},"num":11},{"id":"q12","q":{"en":"What is the meaning of the label 'Extended ASCII' or 'ASCII-8' in the notes?","hi":"नोट्स में 'एक्सटेंडेड ASCII' (Extended ASCII) या 'ASCII-8' लेबल का क्या अर्थ है?"},"a":{"en":"It refers to 8-bit ASCII-based extensions offering 256 possible values (0–255), where the upper 128 mappings vary by code page","hi":"यह 8-बिट ASCII-आधारित एक्सटेंशन को संदर्भित करता है जो 256 संभावित मान (0-255) प्रदान करता है, जहां ऊपरी 128 मैपिंग कोड पेज के अनुसार भिन्न होती है"},"o":[{"en":"It refers to 16-bit Unicode","hi":"यह 16-बिट यूनिकोड को संदर्भित करता है"},{"en":"It refers to 8-bit ASCII-based extensions offering 256 possible values (0–255), where the upper 128 mappings vary by code page","hi":"यह 8-बिट ASCII-आधारित एक्सटेंशन को संदर्भित करता है जो 256 संभावित मान (0-255) प्रदान करता है, जहां ऊपरी 128 मैपिंग कोड पेज के अनुसार भिन्न होती है"},{"en":"It means ASCII translated to BCD","hi":"इसका अर्थ है BCD में अनुवादित ASCII"},{"en":"It is an old 6-bit encoding format","hi":"यह एक पुराना 6-बिट एन्कोडिंग प्रारूप है"}],"exp":{"en":"Extended ASCII refers to 8-bit encodings that use the 8th bit to provide 256 values. The lower 128 remain standard ASCII, while the upper 128 vary depending on the specific code page used.","hi":"एक्सटेंडेड ASCII 8-बिट एक्सटेंशन है जिसमें 2⁸ = 256 संभावित वैल्यू (0–255) होते हैं। अलग-अलग कोड पेज में ऊपरी 128 वैल्यू की मैपिंग अलग हो सकती है।"},"num":12},{"id":"q13","q":{"en":"What is the full form of EBCDIC?","hi":"EBCDIC का पूर्ण रूप क्या है?"},"a":{"en":"Extended Binary Coded Decimal Interchange Code (an IBM character encoding family)","hi":"एक्सटेंडेड बाइनरी कोडेड डेसिमल इंटरचेंज कोड (IBM का एक कैरेक्टर एन्कोडिंग परिवार)"},"o":[{"en":"Extended Binary Coded Decimal Interchange Code (an IBM character encoding family)","hi":"एक्सटेंडेड बाइनरी कोडेड डेसिमल इंटरचेंज कोड (IBM का एक कैरेक्टर एन्कोडिंग परिवार)"},{"en":"Electronic Binary Computer Digital Interchange Code","hi":"इलेक्ट्रॉनिक बाइनरी कंप्यूटर डिजिटल इंटरचेंज कोड"},{"en":"Encoded Binary Character Dictionary and Interchange Code","hi":"एन्कोडेड बाइनरी कैरेक्टर डिक्शनरी एंड इंटरचेंज कोड"},{"en":"Eight-Bit Code Decimal Interchange Code","hi":"एट-बिट कोड डेसिमल इंटरचेंज कोड"}],"exp":{"en":"EBCDIC stands for Extended Binary Coded Decimal Interchange Code, a character encoding family primarily used on IBM mainframe operating systems.","hi":"EBCDIC का पूर्ण रूप एक्सटेंडेड बाइनरी कोडेड डेसिमल इंटरचेंज कोड (Extended Binary Coded Decimal Interchange Code) है, जो IBM सिस्टम में इस्तेमाल हुआ।"},"num":13},{"id":"q14","q":{"en":"How many bit patterns are possible in EBCDIC?","hi":"EBCDIC में कितने बिट पैटर्न संभव हैं?"},"a":{"en":"256 patterns (2⁸ = 256 since it is an 8-bit code)","hi":"256 पैटर्न (2⁸ = 256 क्योंकि यह एक 8-बिट कोड है)"},"o":[{"en":"128 patterns (7 bits)","hi":"128 पैटर्न (7 बिट्स)"},{"en":"256 patterns (2⁸ = 256 since it is an 8-bit code)","hi":"256 पैटर्न (2⁸ = 256 क्योंकि यह एक 8-बिट कोड है)"},{"en":"512 patterns (9 bits)","hi":"512 पैटर्न (9 बिट्स)"},{"en":"65,536 patterns (16 bits)","hi":"65,536 पैटर्न (16 बिट्स)"}],"exp":{"en":"Like Extended ASCII, EBCDIC is an 8-bit encoding system, so it allows for 2⁸ = 256 possible bit patterns.","hi":"EBCDIC 8-बिट का कोड है, इसलिए इसमें 2⁸ = 256 संभावित बिट पैटर्न होते हैं। (कैरेक्टर मैपिंग EBCDIC कोड पेज पर निर्भर करती है)।"},"num":14},{"id":"q15","q":{"en":"Both Extended ASCII and EBCDIC are 8-bit. Are their character mappings the same?","hi":"एक्सटेंडेड ASCII और EBCDIC दोनों 8-बिट हैं। क्या इनकी कैरेक्टर मैपिंग समान है?"},"a":{"en":"No, they are different encodings; for example, capital 'A' is hex 41 in ASCII but hex C1 in IBM EBCDIC code page 037","hi":"नहीं, वे अलग-अलग एन्कोडिंग हैं; उदाहरण के लिए, कैपिटल 'A' ASCII में हेक्स 41 है लेकिन IBM EBCDIC कोड पेज 037 में हेक्स C1 है"},"o":[{"en":"Yes, they are completely identical","hi":"हाँ, वे पूरी तरह से समान हैं"},{"en":"Yes, except for the numbers 0-9","hi":"हाँ, केवल 0-9 संख्याओं को छोड़कर"},{"en":"No, they are different encodings; for example, capital 'A' is hex 41 in ASCII but hex C1 in IBM EBCDIC code page 037","hi":"नहीं, वे अलग-अलग एन्कोडिंग हैं; उदाहरण के लिए, कैपिटल 'A' ASCII में हेक्स 41 है लेकिन IBM EBCDIC कोड पेज 037 में हेक्स C1 है"},{"en":"They cannot both be 8-bit codes","hi":"वे दोनों 8-बिट कोड नहीं हो सकते"}],"exp":{"en":"They are completely different encoding systems. The bit pattern for a character like 'A' differs between ASCII and EBCDIC.","hi":"नहीं, ये अलग-अलग एन्कोडिंग हैं। उदाहरण के लिए, कैपिटल A का हेक्स कोड ASCII में 41 होता है, जबकि IBM EBCDIC कोड पेज 037 में यह C1 होता है।"},"num":15},{"id":"q16","q":{"en":"What is the purpose of Unicode?","hi":"यूनिकोड (Unicode) का काम क्या है?"},"a":{"en":"To assign standard code points to different scripts, symbols, and emoji (e.g., Latin 'A' is U+0041, Devanagari 'अ' is U+0905)","hi":"विभिन्न लिपियों, प्रतीकों और इमोजी को मानक कोड पॉइंट देना (जैसे, लैटिन 'A' U+0041 है, देवनागरी 'अ' U+0905 है)"},"o":[{"en":"To compress video files","hi":"वीडियो फ़ाइलों को संपीड़ित (compress) करना"},{"en":"To assign standard code points to different scripts, symbols, and emoji (e.g., Latin 'A' is U+0041, Devanagari 'अ' is U+0905)","hi":"विभिन्न लिपियों, प्रतीकों और इमोजी को मानक कोड पॉइंट देना (जैसे, लैटिन 'A' U+0041 है, देवनागरी 'अ' U+0905 है)"},{"en":"To speed up internet connections","hi":"इंटरनेट कनेक्शन की गति बढ़ाना"},{"en":"To replace hardware logic gates","hi":"हार्डवेयर लॉजिक गेट्स को बदलना"}],"exp":{"en":"Unicode provides a unique standard code point for every character, enabling consistent representation of text across different languages, scripts, and platforms.","hi":"यूनिकोड का काम दुनिया की अलग-अलग लिपियों, प्रतीकों और इमोजी को मानक कोड पॉइंट (standard code points) देना है, ताकि सभी कंप्यूटर उन्हें सही से पढ़ सकें।"},"num":16},{"id":"q17","q":{"en":"Why is it incorrect to call Unicode a \"maximum 16 bits\" code?","hi":"यूनिकोड को \"अधिकतम 16 बिट्स\" कहना क्यों गलत है?"},"a":{"en":"Because the Unicode code space goes up to U+10FFFF, beyond the 16-bit Basic Multilingual Plane (U+0000–U+FFFF)","hi":"क्योंकि यूनिकोड कोड स्पेस U+10FFFF तक जाता है, जो 16-बिट बेसिक मल्टीलिंगुअल प्लेन (U+0000-U+FFFF) से परे है"},"o":[{"en":"Because it is only an 8-bit code","hi":"क्योंकि यह केवल 8-बिट कोड है"},{"en":"Because the Unicode code space goes up to U+10FFFF, beyond the 16-bit Basic Multilingual Plane (U+0000–U+FFFF)","hi":"क्योंकि यूनिकोड कोड स्पेस U+10FFFF तक जाता है, जो 16-बिट बेसिक मल्टीलिंगुअल प्लेन (U+0000-U+FFFF) से परे है"},{"en":"Because it uses exactly 32 bits for every single character","hi":"क्योंकि यह हर एक कैरेक्टर के लिए ठीक 32 बिट्स का उपयोग करता है"},{"en":"Because it is an analog representation","hi":"क्योंकि यह एक एनालॉग प्रतिनिधित्व है"}],"exp":{"en":"While the Basic Multilingual Plane fits in 16 bits, the full Unicode standard defines code points up to U+10FFFF. UTF-16 uses surrogate pairs (two 16-bit units) for characters beyond the BMP.","hi":"यूनिकोड का बेसिक मल्टीलिंगुअल प्लेन (BMP) U+0000 से U+FFFF (16 बिट्स) तक है, लेकिन पूरा यूनिकोड स्पेस U+10FFFF तक जाता है। इसलिए इसे 16-बिट तक सीमित कहना गलत है।"},"num":17},{"id":"q18","q":{"en":"How do UTF-8 and UTF-16 store Unicode code points?","hi":"UTF-8 और UTF-16 यूनिकोड कोड पॉइंट्स को कैसे स्टोर करते हैं?"},"a":{"en":"UTF-8 uses 1 to 4 bytes per value; UTF-16 uses one or two 16-bit code units","hi":"UTF-8 प्रति वैल्यू 1 से 4 बाइट्स का उपयोग करता है; UTF-16 एक या दो 16-बिट कोड इकाइयों का उपयोग करता है"},"o":[{"en":"They both use exactly one byte per character","hi":"वे दोनों प्रति कैरेक्टर ठीक एक बाइट का उपयोग करते हैं"},{"en":"UTF-8 uses 1 to 4 bytes per value; UTF-16 uses one or two 16-bit code units","hi":"UTF-8 प्रति वैल्यू 1 से 4 बाइट्स का उपयोग करता है; UTF-16 एक या दो 16-बिट कोड इकाइयों का उपयोग करता है"},{"en":"UTF-8 uses 8 bytes and UTF-16 uses 16 bytes","hi":"UTF-8 8 बाइट्स और UTF-16 16 बाइट्स का उपयोग करता है"},{"en":"They store characters as decimal numbers in plain text files","hi":"वे सादे टेक्स्ट फ़ाइलों में कैरेक्टर को दशमलव संख्याओं के रूप में संग्रहीत करते हैं"}],"exp":{"en":"UTF-8 is a variable-width encoding using 1 to 4 bytes. UTF-16 is also variable-width, using either one or two 16-bit code units to store a scalar value.","hi":"UTF-8 एक वेरिएबल-लेंथ एन्कोडिंग है जिसमें 1 से 4 बाइट्स लगते हैं। UTF-16 में एक कैरेक्टर को स्टोर करने के लिए एक या दो 16-बिट कोड यूनिट्स (surrogate pairs) का उपयोग होता है।"},"num":18}]},{"title":{"en":"2. Boolean Data & Logic Fundamentals","hi":"2. बूलियन डेटा और लॉजिक की मूल बातें"},"questions":[{"id":"q19","q":{"en":"What are the two logical values of Boolean data?","hi":"बूलियन डेटा के दो लॉजिकल मान (logical values) क्या हैं?"},"a":{"en":"True and False (represented as 1/HIGH and 0/LOW in standard positive logic)","hi":"सत्य और असत्य (मानक सकारात्मक लॉजिक में 1/HIGH और 0/LOW के रूप में दर्शाया गया है)"},"o":[{"en":"Yes and No","hi":"हाँ और नहीं"},{"en":"Positive and Negative","hi":"सकारात्मक और नकारात्मक"},{"en":"True and False (represented as 1/HIGH and 0/LOW in standard positive logic)","hi":"सत्य और असत्य (मानक सकारात्मक लॉजिक में 1/HIGH और 0/LOW के रूप में दर्शाया गया है)"},{"en":"On and Off","hi":"चालू और बंद"}],"exp":{"en":"Boolean data represents two logical states: True and False. In standard positive logic circuits, True is mapped to 1 (HIGH voltage) and False to 0 (LOW voltage).","hi":"बूलियन डेटा के दो लॉजिकल मान सत्य (True) और असत्य (False) होते हैं। मानक सकारात्मक लॉजिक (positive logic) में इन्हें 1 (HIGH) और 0 (LOW) से दर्शाते हैं।"},"num":19},{"id":"q20","q":{"en":"What is a logic gate?","hi":"लॉजिक गेट (Logic gate) क्या है?"},"a":{"en":"The basic building block of a digital circuit that performs a Boolean operation on input bit(s) to produce a single output bit","hi":"एक डिजिटल सर्किट का मूल निर्माण खंड (building block) जो सिंगल आउटपुट बिट देने के लिए इनपुट बिट(s) पर बूलियन ऑपरेशन करता है"},"o":[{"en":"A software firewall","hi":"एक सॉफ्टवेयर फ़ायरवॉल"},{"en":"The basic building block of a digital circuit that performs a Boolean operation on input bit(s) to produce a single output bit","hi":"एक डिजिटल सर्किट का मूल निर्माण खंड (building block) जो सिंगल आउटपुट बिट देने के लिए इनपुट बिट(s) पर बूलियन ऑपरेशन करता है"},{"en":"An input device like a keyboard","hi":"कीबोर्ड जैसा एक इनपुट डिवाइस"},{"en":"A mechanical gear in an abacus","hi":"अबेकस में एक यांत्रिक गियर"}],"exp":{"en":"A logic gate is a foundational hardware component in digital circuits that takes one or more binary inputs, applies a Boolean logical operation, and returns a single binary output.","hi":"लॉजिक गेट डिजिटल सर्किट का बेसिक बिल्डिंग ब्लॉक (building block) है जो एक या अधिक इनपुट बिट्स पर बूलियन ऑपरेशन करके एक आउटपुट बिट देता है।"},"num":20},{"id":"q21","q":{"en":"Does every logic gate have exactly two inputs?","hi":"क्या हर लॉजिक गेट में ठीक दो इनपुट होते हैं?"},"a":{"en":"No, the NOT gate has one input, and AND/OR gates can have two or more inputs","hi":"नहीं, NOT गेट का एक इनपुट होता है, और AND/OR गेट्स के दो या अधिक इनपुट हो सकते हैं"},"o":[{"en":"Yes, all gates have exactly two inputs","hi":"हाँ, सभी गेट्स में ठीक दो इनपुट होते हैं"},{"en":"No, the NOT gate has one input, and AND/OR gates can have two or more inputs","hi":"नहीं, NOT गेट का एक इनपुट होता है, और AND/OR गेट्स के दो या अधिक इनपुट हो सकते हैं"},{"en":"Yes, except for the XOR gate","hi":"हाँ, XOR गेट को छोड़कर"},{"en":"No, they can have any number of inputs but must have multiple outputs","hi":"नहीं, उनके इनपुट की संख्या कितनी भी हो सकती है लेकिन आउटपुट एक से अधिक होने चाहिए"}],"exp":{"en":"Not all gates have two inputs. A NOT gate (inverter) takes exactly one input. Other gates like AND, OR, NAND, and NOR can be designed with two or more inputs.","hi":"नहीं, NOT गेट में केवल एक इनपुट होता है। AND और OR गेट्स के दो या उससे अधिक इनपुट हो सकते हैं (हालाँकि तुलना तालिकाओं में आमतौर पर 2-इनपुट संस्करण दिखाए जाते हैं)।"},"num":21},{"id":"q22","q":{"en":"How are logic gates built in physical circuits?","hi":"भौतिक सर्किट (physical circuits) में लॉजिक गेट्स कैसे बनाए जाते हैं?"},"a":{"en":"Using electronic switching components, where modern ICs commonly use transistors","hi":"इलेक्ट्रॉनिक स्विचिंग घटकों का उपयोग करके, जहाँ आधुनिक IC आमतौर पर ट्रांजिस्टर का उपयोग करते हैं"},"o":[{"en":"Using mechanical switches","hi":"यांत्रिक स्विच का उपयोग करके"},{"en":"Using electronic switching components, where modern ICs commonly use transistors","hi":"इलेक्ट्रॉनिक स्विचिंग घटकों का उपयोग करके, जहाँ आधुनिक IC आमतौर पर ट्रांजिस्टर का उपयोग करते हैं"},{"en":"Using vacuum tubes exclusively","hi":"विशेष रूप से वैक्यूम ट्यूब का उपयोग करके"},{"en":"Using fiber optic cables","hi":"फाइबर ऑप्टिक केबल का उपयोग करके"}],"exp":{"en":"Modern logic gates are physically constructed using electronic switching components; transistors are the most common building blocks inside modern Integrated Circuits (ICs).","hi":"लॉजिक गेट्स इलेक्ट्रॉनिक स्विचिंग घटकों (components) से बनते हैं। आधुनिक एकीकृत परिपथों (ICs) में इन्हें बनाने के लिए आमतौर पर ट्रांजिस्टर का उपयोग होता है (कुछ कार्यान्वयन डायोड का भी उपयोग करते हैं)।"},"num":22},{"id":"q23","q":{"en":"What does a truth table show?","hi":"ट्रुथ टेबल (Truth table) क्या दर्शाती है?"},"a":{"en":"The output of a gate or circuit for every possible combination of inputs","hi":"इनपुट के हर संभव संयोजन (combination) के लिए गेट या सर्किट का आउटपुट"},"o":[{"en":"The physical layout of the circuit board","hi":"सर्किट बोर्ड का भौतिक लेआउट"},{"en":"The output of a gate or circuit for every possible combination of inputs","hi":"इनपुट के हर संभव संयोजन (combination) के लिए गेट या सर्किट का आउटपुट"},{"en":"The mathematical proof of Boolean algebra","hi":"बूलियन बीजगणित का गणितीय प्रमाण"},{"en":"The maximum voltage capacity of the gate","hi":"गेट की अधिकतम वोल्टेज क्षमता"}],"exp":{"en":"A truth table maps out the behavior of a logic gate or circuit by listing the resulting output for every possible binary input combination.","hi":"ट्रुथ टेबल इनपुट के हर संभव संयोजन (जैसे दो इनपुट के लिए 00, 01, 10, और 11) के लिए किसी गेट या सर्किट का आउटपुट (परिणाम) बताती है।"},"num":23},{"id":"q24","q":{"en":"How many rows are there in a complete truth table for three binary inputs?","hi":"तीन बाइनरी इनपुट (three binary inputs) के लिए पूर्ण ट्रुथ टेबल में कितनी पंक्तियाँ (rows) होती हैं?"},"a":{"en":"8 rows (calculated as 2³)","hi":"8 पंक्तियाँ (2³ के रूप में परिकलित)"},"o":[{"en":"3 rows","hi":"3 पंक्तियाँ"},{"en":"6 rows","hi":"6 पंक्तियाँ"},{"en":"8 rows (calculated as 2³)","hi":"8 पंक्तियाँ (2³ के रूप में परिकलित)"},{"en":"9 rows","hi":"9 पंक्तियाँ"}],"exp":{"en":"For a circuit with 'n' binary inputs, the truth table will have 2ⁿ combinations. For three inputs, this is 2³ = 8 rows.","hi":"सामान्य नियम 'n' इनपुट के लिए 2ⁿ पंक्तियाँ (rows) है। इसलिए 3 बाइनरी इनपुट के लिए 2³ = 8 पंक्तियाँ होंगी।"},"num":24},{"id":"q25","q":{"en":"In Boolean algebra, what do the symbols ·, +, prime (′), and ⊕ mean respectively?","hi":"बूलियन बीजगणित में, क्रमशः ·, +, प्राइम (′) और ⊕ प्रतीकों का क्या अर्थ है?"},"a":{"en":"AND, OR, NOT (complement), and XOR","hi":"AND, OR, NOT (पूरक/complement) और XOR"},"o":[{"en":"Multiply, Add, Subtract, and Divide","hi":"गुणा, जोड़, घटाव और भाग"},{"en":"AND, OR, NOT (complement), and XOR","hi":"AND, OR, NOT (पूरक/complement) और XOR"},{"en":"NAND, NOR, XNOR, and Buffer","hi":"NAND, NOR, XNOR और बफर"},{"en":"True, False, Null, and Infinity","hi":"सत्य, असत्य, शून्य और अनंत"}],"exp":{"en":"In standard Boolean algebra notation, a dot (·) represents AND, a plus (+) represents OR, a prime mark (′) represents NOT, and an encircled plus (⊕) represents XOR.","hi":"बूलियन बीजगणित में · का अर्थ AND है, + का अर्थ OR है, प्राइम (′) का अर्थ NOT (पूरक) है, और ⊕ का अर्थ XOR है।"},"num":25},{"id":"q26","q":{"en":"What is the function of an Identity (or Buffer) gate?","hi":"आइडेंटिटी या बफर गेट (Identity or buffer gate) क्या कार्य करता है?"},"a":{"en":"It passes the input logically unchanged (Y = A); its symbol is a triangle without an output bubble","hi":"यह इनपुट को तार्किक रूप से अपरिवर्तित (logically unchanged) पास करता है (Y = A); इसका प्रतीक बिना आउटपुट बबल वाला एक त्रिकोण (triangle) होता है"},"o":[{"en":"It inverts the input signal","hi":"यह इनपुट सिग्नल को उलट (invert) देता है"},{"en":"It adds two binary inputs","hi":"यह दो बाइनरी इनपुट को जोड़ता है"},{"en":"It passes the input logically unchanged (Y = A); its symbol is a triangle without an output bubble","hi":"यह इनपुट को तार्किक रूप से अपरिवर्तित (logically unchanged) पास करता है (Y = A); इसका प्रतीक बिना आउटपुट बबल वाला एक त्रिकोण (triangle) होता है"},{"en":"It stores one bit of data permanently","hi":"यह डेटा के एक बिट को स्थायी रूप से स्टोर करता है"}],"exp":{"en":"A buffer gate passes its single input through to the output logically unchanged (Y = A). It is often used to boost a signal's electrical strength.","hi":"आइडेंटिटी या बफर गेट (Buffer gate) इनपुट को बिना बदले (Y = A) पास करता है। इसका प्रतीक एक त्रिकोण (triangle) होता है, जिसमें आउटपुट बबल नहीं होता।"},"num":26},{"id":"q27","q":{"en":"In what complex circuits are logic gates used, and how does Boolean algebra help?","hi":"लॉजिक गेट्स किन जटिल सर्किटों (complex circuits) में उपयोग किए जाते हैं, और बूलियन बीजगणित इसमें कैसे मदद करता है?"},"a":{"en":"Used in multiplexers, decoders, flip-flops, and CPUs; Boolean algebra simplifies the circuit expression, making gate implementation easier","hi":"मल्टीप्लेक्सर्स, डिकोडर्स, फ्लिप-फ्लॉप और CPU में उपयोग किए जाते हैं; बूलियन बीजगणित सर्किट एक्सप्रेशन को सरल बनाता है, जिससे गेट कार्यान्वयन आसान हो जाता है"},"o":[{"en":"Used in motors; Boolean algebra increases voltage","hi":"मोटर्स में उपयोग किया जाता है; बूलियन बीजगणित वोल्टेज बढ़ाता है"},{"en":"Used in multiplexers, decoders, flip-flops, and CPUs; Boolean algebra simplifies the circuit expression, making gate implementation easier","hi":"मल्टीप्लेक्सर्स, डिकोडर्स, फ्लिप-फ्लॉप और CPU में उपयोग किए जाते हैं; बूलियन बीजगणित सर्किट एक्सप्रेशन को सरल बनाता है, जिससे गेट कार्यान्वयन आसान हो जाता है"},{"en":"Used only in mechanical switches; Boolean algebra reduces weight","hi":"केवल यांत्रिक स्विच में उपयोग किया जाता है; बूलियन बीजगणित वजन कम करता है"},{"en":"Used in analog displays; Boolean algebra converts AC to DC","hi":"एनालॉग डिस्प्ले में उपयोग किया जाता है; बूलियन बीजगणित AC को DC में परिवर्तित करता है"}],"exp":{"en":"Logic gates form the core of complex circuits like CPUs and flip-flops. Boolean algebra allows engineers to simplify logic expressions, thereby requiring fewer gates to build the circuit.","hi":"लॉजिक गेट्स मल्टीप्लेक्सर्स (Multiplexers), डिकोडर्स (Decoders), फ्लिप-फ्लॉप (Flip-flops) और CPUs में उपयोग होते हैं। बूलियन बीजगणित (Boolean algebra) से सर्किट एक्सप्रेशन को सरल बनाकर (simplify) गेट डिज़ाइन को आसान बनाया जाता है।"},"num":27}]},{"title":{"en":"3. Basic Gates — AND, OR & NOT","hi":"3. बेसिक गेट्स — AND, OR और NOT"},"questions":[{"id":"q28","q":{"en":"What are the symbol, Boolean expression, and truth table logic of an AND gate?","hi":"AND गेट का प्रतीक (symbol), एक्सप्रेशन और ट्रुथ टेबल लॉजिक क्या है?"},"a":{"en":"D-shaped gate; Y = A · B; Output is 1 only when all inputs are 1","hi":"D-आकार का गेट; Y = A · B; आउटपुट 1 तभी होता है जब सभी इनपुट 1 हों"},"o":[{"en":"Triangle with a bubble; Y = A'; Output is 1 if input is 0","hi":"बबल के साथ त्रिकोण; Y = A'; यदि इनपुट 0 है तो आउटपुट 1 है"},{"en":"Curved shape; Y = A + B; Output is 1 if any input is 1","hi":"घुमावदार (Curved) आकार; Y = A + B; यदि कोई भी इनपुट 1 है तो आउटपुट 1 है"},{"en":"D-shaped gate; Y = A · B; Output is 1 only when all inputs are 1","hi":"D-आकार का गेट; Y = A · B; आउटपुट 1 तभी होता है जब सभी इनपुट 1 हों"},{"en":"D-shaped gate with a bubble; Y = (A · B)'; Output is 0 only when all inputs are 1","hi":"बबल के साथ D-आकार का गेट; Y = (A · B)'; आउटपुट 0 तभी होता है जब सभी इनपुट 1 हों"}],"exp":{"en":"An AND gate uses a straight-backed D-shaped symbol, has the expression Y = A · B, and produces a 1 (HIGH) output exclusively when every single input is 1.","hi":"AND गेट का प्रतीक D-आकार का होता है। इसका एक्सप्रेशन Y = A · B है। इसका आउटपुट 1 तभी होता है, जब इसके सारे इनपुट 1 हों।"},"num":28},{"id":"q29","q":{"en":"If the inputs to an AND gate are 1, 1, and 0, what is the output?","hi":"यदि AND गेट के इनपुट 1, 1 और 0 हों, तो आउटपुट क्या होगा?"},"a":{"en":"0 (Because if even one input is 0, the AND output is 0)","hi":"0 (क्योंकि यदि एक भी इनपुट 0 है, तो AND का आउटपुट 0 होता है)"},"o":[{"en":"1","hi":"1"},{"en":"0 (Because if even one input is 0, the AND output is 0)","hi":"0 (क्योंकि यदि एक भी इनपुट 0 है, तो AND का आउटपुट 0 होता है)"},{"en":"2","hi":"2"},{"en":"Not determined","hi":"निर्धारित नहीं"}],"exp":{"en":"For an AND gate, output is HIGH only when ALL inputs are HIGH. The presence of a single 0 forces the output to 0 (1 · 1 · 0 = 0).","hi":"AND गेट में एक भी इनपुट 0 होने पर आउटपुट 0 हो जाता है। इसलिए 1, 1 और 0 होने पर आउटपुट 0 होगा।"},"num":29},{"id":"q30","q":{"en":"What are the symbol, Boolean expression, and truth table logic of an OR gate?","hi":"OR गेट का प्रतीक (symbol), एक्सप्रेशन और ट्रुथ टेबल लॉजिक क्या है?"},"a":{"en":"Curved shape; Y = A + B; Output is 1 if at least one input is 1","hi":"घुमावदार (Curved) आकार; Y = A + B; यदि कम से कम एक इनपुट 1 हो तो आउटपुट 1 है"},"o":[{"en":"D-shaped gate; Y = A · B; Output is 1 if all inputs are 1","hi":"D-आकार का गेट; Y = A · B; यदि सभी इनपुट 1 हैं तो आउटपुट 1 है"},{"en":"Curved shape; Y = A + B; Output is 1 if at least one input is 1","hi":"घुमावदार (Curved) आकार; Y = A + B; यदि कम से कम एक इनपुट 1 हो तो आउटपुट 1 है"},{"en":"Triangle shape; Y = A'; Output is the reverse of input","hi":"त्रिकोण आकार; Y = A'; आउटपुट इनपुट का उल्टा है"},{"en":"Curved shape with an extra curve on the input; Y = A ⊕ B; Output is 1 if inputs differ","hi":"इनपुट पर एक अतिरिक्त घुमाव के साथ घुमावदार आकार; Y = A ⊕ B; यदि इनपुट अलग हैं तो आउटपुट 1 है"}],"exp":{"en":"An OR gate uses a curved, shield-like symbol, has the expression Y = A + B, and outputs a 1 (HIGH) as long as at least one of its inputs is 1.","hi":"OR गेट का प्रतीक घुमावदार (Curved) होता है। इसका एक्सप्रेशन Y = A + B है। यदि कम से कम एक इनपुट भी 1 हो, तो आउटपुट 1 होता है।"},"num":30},{"id":"q31","q":{"en":"If the inputs to an OR gate are 1 and 1, what is the output?","hi":"यदि OR गेट में इनपुट 1 और 1 हों, तो आउटपुट क्या होगा?"},"a":{"en":"1 (In Boolean OR logic, 1 + 1 = 1)","hi":"1 (बूलियन OR लॉजिक में 1 + 1 = 1 होता है)"},"o":[{"en":"0","hi":"0"},{"en":"10","hi":"10"},{"en":"2","hi":"2"},{"en":"1 (In Boolean OR logic, 1 + 1 = 1)","hi":"1 (बूलियन OR लॉजिक में 1 + 1 = 1 होता है)"}],"exp":{"en":"Boolean arithmetic differs from standard binary arithmetic. In Boolean logic, 1 OR 1 is simply 1 (True OR True is True).","hi":"बूलियन OR लॉजिक में 1 + 1 (यानी 1 OR 1) का मान 1 ही होता है।"},"num":31},{"id":"q32","q":{"en":"What are the symbol, expression, and logic of a NOT gate?","hi":"NOT गेट का प्रतीक (symbol), एक्सप्रेशन और लॉजिक क्या है?"},"a":{"en":"Triangle with an output bubble; Y = A′; Output is 1 for input 0, and output is 0 for input 1 (it is an inverter)","hi":"आउटपुट बबल वाला त्रिकोण (Triangle); Y = A′; इनपुट 0 पर आउटपुट 1 और इनपुट 1 पर आउटपुट 0 (इसे इन्वर्टर/inverter कहते हैं)"},"o":[{"en":"D-shape; Y = A · B; outputs 1 if inputs match","hi":"D-आकार; Y = A · B; यदि इनपुट मेल खाते हैं तो 1 आउटपुट करता है"},{"en":"Triangle with an output bubble; Y = A′; Output is 1 for input 0, and output is 0 for input 1 (it is an inverter)","hi":"आउटपुट बबल वाला त्रिकोण (Triangle); Y = A′; इनपुट 0 पर आउटपुट 1 और इनपुट 1 पर आउटपुट 0 (इसे इन्वर्टर/inverter कहते हैं)"},{"en":"Square with a bubble; Y = A + B; adds the inputs","hi":"बबल के साथ वर्ग; Y = A + B; इनपुट जोड़ता है"},{"en":"Triangle without a bubble; Y = A; leaves the input unchanged","hi":"बिना बबल का त्रिकोण; Y = A; इनपुट को अपरिवर्तित छोड़ देता है"}],"exp":{"en":"The NOT gate (inverter) uses a triangle symbol with a small circle (bubble) at the output, meaning it produces the complement of its single input (Y = A′).","hi":"NOT गेट (जिसे इन्वर्टर भी कहते हैं) का प्रतीक एक आउटपुट बबल वाला त्रिकोण (triangle) है। इसका एक्सप्रेशन Y = A′ है। यह इनपुट 0 को 1 में, और 1 को 0 में बदल देता है।"},"num":32},{"id":"q33","q":{"en":"What is the result of passing an input through two consecutive NOT gates?","hi":"एक इनपुट को लगातार दो NOT गेट्स (NOT gates) से गुजारने का क्या परिणाम होता है?"},"a":{"en":"It returns to the original input A, due to the double complement rule (A′)′ = A","hi":"यह वापस मूल इनपुट A बन जाता है, क्योंकि डबल कॉम्प्लिमेंट (double complement) नियम (A′)′ = A होता है"},"o":[{"en":"It always becomes 0","hi":"यह हमेशा 0 हो जाता है"},{"en":"It always becomes 1","hi":"यह हमेशा 1 हो जाता है"},{"en":"It returns to the original input A, due to the double complement rule (A′)′ = A","hi":"यह वापस मूल इनपुट A बन जाता है, क्योंकि डबल कॉम्प्लिमेंट (double complement) नियम (A′)′ = A होता है"},{"en":"It produces an error","hi":"यह त्रुटि (error) पैदा करता है"}],"exp":{"en":"Inverting a signal twice restores it to its original state, demonstrating the Boolean rule of double negation: (A′)′ = A.","hi":"किसी सिग्नल को दो बार इनवर्ट करने पर वह अपनी मूल अवस्था (original input A) में वापस आ जाता है। इसे डबल कॉम्प्लिमेंट नियम (A′)′ = A कहते हैं।"},"num":33},{"id":"q34","q":{"en":"Why are NOT, AND, and OR referred to as the 'basic gates'?","hi":"NOT, AND और OR को 'बेसिक गेट्स' (basic gates) क्यों कहा जाता है?"},"a":{"en":"Because they implement the fundamental operations of complement, conjunction, and disjunction in Boolean expressions","hi":"क्योंकि ये बूलियन एक्सप्रेशन के मौलिक कार्यों—पूरक (complement), संयोजन (conjunction) और वियोजन (disjunction)—को लागू करते हैं"},"o":[{"en":"Because they are the only gates that exist","hi":"क्योंकि ये केवल यही गेट्स मौजूद हैं"},{"en":"Because they implement the fundamental operations of complement, conjunction, and disjunction in Boolean expressions","hi":"क्योंकि ये बूलियन एक्सप्रेशन के मौलिक कार्यों—पूरक (complement), संयोजन (conjunction) और वियोजन (disjunction)—को लागू करते हैं"},{"en":"Because they consume the least power","hi":"क्योंकि ये सबसे कम बिजली की खपत करते हैं"},{"en":"Because they were the first gates invented","hi":"क्योंकि वे आविष्कार किए गए पहले गेट्स थे"}],"exp":{"en":"NOT, AND, and OR are considered basic gates because every logical relationship in Boolean algebra (complement/inversion, conjunction/multiplication, and disjunction/addition) can be built directly from them.","hi":"इन तीनों गेट्स को बेसिक गेट्स इसलिए कहते हैं क्योंकि ये बूलियन एक्सप्रेशन के तीन मौलिक ऑपरेशन्स (NOT/complement, AND/conjunction, और OR/disjunction) को लागू (implement) करते हैं।"},"num":34}]},{"title":{"en":"4. Universal Gates & De Morgan’s Laws","hi":"4. यूनिवर्सल गेट्स और डी मॉर्गन के नियम"},"questions":[{"id":"q35","q":{"en":"What are the symbol, expression, and logic of a NAND gate?","hi":"NAND गेट का प्रतीक (symbol), एक्सप्रेशन और लॉजिक क्या है?"},"a":{"en":"D-shaped gate with a bubble at the output; Y = (A · B)′; Output is 0 only when all inputs are 1","hi":"आउटपुट पर बबल के साथ D-आकार का गेट; Y = (A · B)′; आउटपुट 0 तभी होता है जब सभी इनपुट 1 हों"},"o":[{"en":"Curved shape with an extra line; Y = A + B; Output is 1 if any input is 1","hi":"एक अतिरिक्त रेखा के साथ घुमावदार आकार; Y = A + B; यदि कोई भी इनपुट 1 है तो आउटपुट 1 है"},{"en":"Triangle with a bubble; Y = A'; Output is the reverse of input","hi":"बबल के साथ त्रिकोण; Y = A'; आउटपुट इनपुट का उल्टा है"},{"en":"D-shaped gate with a bubble at the output; Y = (A · B)′; Output is 0 only when all inputs are 1","hi":"आउटपुट पर बबल के साथ D-आकार का गेट; Y = (A · B)′; आउटपुट 0 तभी होता है जब सभी इनपुट 1 हों"},{"en":"D-shaped gate without a bubble; Y = A · B; Output is 1 only when all inputs are 1","hi":"बिना बबल का D-आकार का गेट; Y = A · B; आउटपुट 1 तभी होता है जब सभी इनपुट 1 हों"}],"exp":{"en":"The NAND gate uses an AND symbol followed by a NOT bubble. Its expression is Y = (A · B)′. It outputs 0 (LOW) only when all inputs are 1 (HIGH); otherwise, it outputs 1.","hi":"NAND गेट का प्रतीक AND गेट के आउटपुट पर एक बबल (bubble) लगाकर बनता है। इसका एक्सप्रेशन Y = (A · B)′ है। इसका आउटपुट 0 तभी होता है जब इसके सभी इनपुट 1 हों।"},"num":35},{"id":"q36","q":{"en":"What are the symbol, expression, and logic of a NOR gate?","hi":"NOR गेट का प्रतीक (symbol), एक्सप्रेशन और लॉजिक क्या है?"},"a":{"en":"Curved shape (OR symbol) with a bubble at the output; Y = (A + B)′; Output is 1 only when all inputs are 0","hi":"आउटपुट पर बबल के साथ घुमावदार आकार (OR प्रतीक); Y = (A + B)′; आउटपुट 1 तभी होता है जब सभी इनपुट 0 हों"},"o":[{"en":"Curved shape (OR symbol) with a bubble at the output; Y = (A + B)′; Output is 1 only when all inputs are 0","hi":"आउटपुट पर बबल के साथ घुमावदार आकार (OR प्रतीक); Y = (A + B)′; आउटपुट 1 तभी होता है जब सभी इनपुट 0 हों"},{"en":"Curved shape without a bubble; Y = A + B; Output is 1 if any input is 1","hi":"बिना बबल का घुमावदार आकार; Y = A + B; यदि कोई भी इनपुट 1 है तो आउटपुट 1 है"},{"en":"D-shaped gate with a bubble; Y = (A · B)′; Output is 0 only when all inputs are 1","hi":"बबल के साथ D-आकार का गेट; Y = (A · B)′; आउटपुट 0 तभी होता है जब सभी इनपुट 1 हों"},{"en":"Square gate; Y = A ⊕ B; Output is 1 if inputs differ","hi":"वर्गाकार गेट; Y = A ⊕ B; यदि इनपुट अलग हैं तो आउटपुट 1 है"}],"exp":{"en":"The NOR gate uses an OR symbol followed by a NOT bubble. Its expression is Y = (A + B)′. It outputs a 1 (HIGH) strictly when all its inputs are 0 (LOW).","hi":"NOR गेट का प्रतीक OR गेट के आउटपुट पर एक बबल (bubble) लगाकर बनता है। इसका एक्सप्रेशन Y = (A + B)′ है। इसका आउटपुट 1 तभी होता है जब इसके सभी इनपुट 0 हों।"},"num":36},{"id":"q37","q":{"en":"Why are NAND and NOR called 'universal gates'?","hi":"NAND और NOR को 'यूनिवर्सल गेट्स' (universal gates) क्यों कहा जाता है?"},"a":{"en":"Because any Boolean function (and therefore any other logic gate) can be constructed using only NAND gates or using only NOR gates","hi":"क्योंकि कोई भी बूलियन फ़ंक्शन (और इसलिए कोई अन्य लॉजिक गेट) केवल NAND गेट्स या केवल NOR गेट्स का उपयोग करके बनाया जा सकता है"},"o":[{"en":"Because they are found in the universe","hi":"क्योंकि वे ब्रह्मांड में पाए जाते हैं"},{"en":"Because they can only perform the NOT operation","hi":"क्योंकि वे केवल NOT ऑपरेशन कर सकते हैं"},{"en":"Because they are the most expensive gates","hi":"क्योंकि वे सबसे महंगे गेट हैं"},{"en":"Because any Boolean function (and therefore any other logic gate) can be constructed using only NAND gates or using only NOR gates","hi":"क्योंकि कोई भी बूलियन फ़ंक्शन (और इसलिए कोई अन्य लॉजिक गेट) केवल NAND गेट्स या केवल NOR गेट्स का उपयोग करके बनाया जा सकता है"}],"exp":{"en":"NAND and NOR are termed universal gates because either one of them can be used exclusively to replicate the functions of NOT, AND, and OR gates, enabling the creation of any digital circuit.","hi":"NAND और NOR को यूनिवर्सल गेट्स इसलिए कहते हैं, क्योंकि सिर्फ NAND गेट्स (या सिर्फ NOR गेट्स) का उपयोग करके कोई भी बूलियन फ़ंक्शन (और कोई भी अन्य गेट) बनाया जा सकता है।"},"num":37},{"id":"q38","q":{"en":"How can you create a NOT gate from a single NAND or NOR gate?","hi":"एक NAND या NOR गेट से NOT गेट (NOT gate) कैसे बनाया जाता है?"},"a":{"en":"By tying (connecting) both input pins together and feeding the single input 'A' (A NAND A = A′ and A NOR A = A′)","hi":"दोनों इनपुट पिनों को एक साथ जोड़कर और सिंगल इनपुट 'A' देकर (A NAND A = A′ और A NOR A = A′)"},"o":[{"en":"By tying (connecting) both input pins together and feeding the single input 'A' (A NAND A = A′ and A NOR A = A′)","hi":"दोनों इनपुट पिनों को एक साथ जोड़कर और सिंगल इनपुट 'A' देकर (A NAND A = A′ और A NOR A = A′)"},{"en":"By leaving one input unconnected","hi":"एक इनपुट को बिना जुड़े छोड़कर"},{"en":"By connecting one input to 1 (HIGH) permanently","hi":"एक इनपुट को स्थायी रूप से 1 (HIGH) से जोड़कर"},{"en":"By connecting one input to 0 (LOW) permanently","hi":"एक इनपुट को स्थायी रूप से 0 (LOW) से जोड़कर"}],"exp":{"en":"Tying both inputs of a 2-input NAND or NOR gate together converts it into a NOT gate (inverter). For NAND: (A · A)′ = A′. For NOR: (A + A)′ = A′.","hi":"यदि आप NAND या NOR गेट के दोनों इनपुट पिनों को एक साथ जोड़ (tie) कर उनमें एक ही इनपुट 'A' दें, तो वे NOT गेट (A′) बन जाते हैं।"},"num":38},{"id":"q39","q":{"en":"How can you construct AND and OR logic using only NAND gates?","hi":"केवल NAND गेट्स का उपयोग करके AND और OR लॉजिक (लॉजिक गेट्स) कैसे बनाए जा सकते हैं?"},"a":{"en":"For AND: Invert the output of a NAND gate. For OR: Invert inputs A and B using NANDs, then feed them into a third NAND gate.","hi":"AND के लिए: एक NAND गेट के आउटपुट को इनवर्ट (invert) करें। OR के लिए: NANDs का उपयोग करके इनपुट A और B को इनवर्ट करें, फिर उन्हें तीसरे NAND गेट में दें।"},"o":[{"en":"AND requires 3 NANDs, OR requires 1 NAND","hi":"AND के लिए 3 NAND, OR के लिए 1 NAND चाहिए"},{"en":"AND requires 1 NAND, OR requires 2 NANDs","hi":"AND के लिए 1 NAND, OR के लिए 2 NAND चाहिए"},{"en":"For AND: Invert the output of a NAND gate. For OR: Invert inputs A and B using NANDs, then feed them into a third NAND gate.","hi":"AND के लिए: एक NAND गेट के आउटपुट को इनवर्ट (invert) करें। OR के लिए: NANDs का उपयोग करके इनपुट A और B को इनवर्ट करें, फिर उन्हें तीसरे NAND गेट में दें।"},{"en":"It is physically impossible to make OR from NAND","hi":"NAND से OR बनाना भौतिक रूप से असंभव है"}],"exp":{"en":"AND from NAND: Pass inputs through a NAND, then invert the result. OR from NAND: Invert each input individually using NANDs, then feed both inverted signals into a third NAND gate.","hi":"NAND से AND बनाने के लिए, NAND के आउटपुट को इनवर्ट (invert) किया जाता है। NAND से OR बनाने के लिए, पहले इनपुट A और B को इनवर्ट करके (A′, B′) एक तीसरे NAND गेट में भेजा जाता है।"},"num":39},{"id":"q40","q":{"en":"How can you construct OR and AND logic using only NOR gates?","hi":"केवल NOR गेट्स का उपयोग करके OR और AND लॉजिक (लॉजिक गेट्स) कैसे बनाए जा सकते हैं?"},"a":{"en":"For OR: Invert the output of a NOR gate. For AND: Invert inputs A and B using NORs, then feed them into a third NOR gate.","hi":"OR के लिए: एक NOR गेट के आउटपुट को इनवर्ट (invert) करें। AND के लिए: NORs का उपयोग करके इनपुट A और B को इनवर्ट करें, फिर उन्हें तीसरे NOR गेट में दें।"},"o":[{"en":"For OR: Invert the output of a NOR gate. For AND: Invert inputs A and B using NORs, then feed them into a third NOR gate.","hi":"OR के लिए: एक NOR गेट के आउटपुट को इनवर्ट (invert) करें। AND के लिए: NORs का उपयोग करके इनपुट A और B को इनवर्ट करें, फिर उन्हें तीसरे NOR गेट में दें।"},{"en":"For OR: Use 3 NOR gates. For AND: Use 1 NOR gate.","hi":"OR के लिए: 3 NOR गेट्स का उपयोग करें। AND के लिए: 1 NOR गेट का उपयोग करें।"},{"en":"It is impossible to make AND from NOR","hi":"NOR से AND बनाना असंभव है"},{"en":"Both require exactly 4 NOR gates","hi":"दोनों के लिए बिल्कुल 4 NOR गेट्स की आवश्यकता होती है"}],"exp":{"en":"OR from NOR: Pass inputs through a NOR, then invert the result. AND from NOR: Invert each input individually using NORs, then feed both inverted signals into a third NOR gate.","hi":"NOR से OR बनाने के लिए, NOR के आउटपुट को इनवर्ट (invert) किया जाता है। NOR से AND बनाने के लिए, पहले इनपुट A और B को इनवर्ट करके (A′, B′) एक तीसरे NOR गेट में भेजा जाता है।"},"num":40},{"id":"q41","q":{"en":"How does De Morgan's first law express a NAND operation?","hi":"डी मॉर्गन का पहला नियम (De Morgan's first law) NAND ऑपरेशन को कैसे व्यक्त करता है?"},"a":{"en":"(A · B)′ = A′ + B′ (Complementing an AND operation is equivalent to ORing the complemented inputs)","hi":"(A · B)′ = A′ + B′ (एक AND ऑपरेशन का पूरक (complement) लेना, पूरक किए गए इनपुट (complemented inputs) का OR करने के बराबर है)"},"o":[{"en":"(A + B)′ = A′ + B′","hi":"(A + B)′ = A′ + B′"},{"en":"(A · B)′ = A + B","hi":"(A · B)′ = A + B"},{"en":"(A · B)′ = A′ + B′ (Complementing an AND operation is equivalent to ORing the complemented inputs)","hi":"(A · B)′ = A′ + B′ (एक AND ऑपरेशन का पूरक (complement) लेना, पूरक किए गए इनपुट (complemented inputs) का OR करने के बराबर है)"},{"en":"(A + B) = A′ · B′","hi":"(A + B) = A′ · B′"}],"exp":{"en":"De Morgan's first law states that the complement of a product (NAND) equals the sum of the complements: (A · B)′ = A′ + B′.","hi":"डी मॉर्गन के पहले नियम के अनुसार, (A · B)′ = A′ + B′। यानी, AND ऑपरेशन का कॉम्प्लिमेंट (NAND) लेने पर ऑपरेटर '+' (OR) बन जाता है और दोनों इनपुट इनवर्ट हो जाते हैं।"},"num":41},{"id":"q42","q":{"en":"How does De Morgan's second law express a NOR operation?","hi":"डी मॉर्गन का दूसरा नियम (De Morgan's second law) NOR ऑपरेशन को कैसे व्यक्त करता है?"},"a":{"en":"(A + B)′ = A′ · B′ (Complementing an OR operation is equivalent to ANDing the complemented inputs)","hi":"(A + B)′ = A′ · B′ (एक OR ऑपरेशन का पूरक (complement) लेना, पूरक किए गए इनपुट का AND करने के बराबर है)"},"o":[{"en":"(A + B)′ = A′ · B′ (Complementing an OR operation is equivalent to ANDing the complemented inputs)","hi":"(A + B)′ = A′ · B′ (एक OR ऑपरेशन का पूरक (complement) लेना, पूरक किए गए इनपुट का AND करने के बराबर है)"},{"en":"(A + B)′ = A′ + B′","hi":"(A + B)′ = A′ + B′"},{"en":"(A · B)′ = A′ · B′","hi":"(A · B)′ = A′ · B′"},{"en":"(A + B) = A′ + B′","hi":"(A + B) = A′ + B′"}],"exp":{"en":"De Morgan's second law states that the complement of a sum (NOR) equals the product of the complements: (A + B)′ = A′ · B′.","hi":"डी मॉर्गन के दूसरे नियम के अनुसार, (A + B)′ = A′ · B′। यानी, OR ऑपरेशन का कॉम्प्लिमेंट (NOR) लेने पर ऑपरेटर '·' (AND) बन जाता है और दोनों इनपुट इनवर्ट हो जाते हैं।"},"num":42},{"id":"q43","q":{"en":"Simplify the Boolean expression Y = (A + B′)′ using De Morgan's laws.","hi":"डी मॉर्गन के नियमों का उपयोग करके बूलियन एक्सप्रेशन Y = (A + B′)′ को सरल (Simplify) करें।"},"a":{"en":"Y = A′ · B (By applying De Morgan's law: A′ · (B′)′, and double negation (B′)′ = B)","hi":"Y = A′ · B (डी मॉर्गन का नियम लागू करके: A′ · (B′)′, और डबल नेगेशन (B′)′ = B)"},"o":[{"en":"Y = A + B","hi":"Y = A + B"},{"en":"Y = A′ + B","hi":"Y = A′ + B"},{"en":"Y = A′ · B (By applying De Morgan's law: A′ · (B′)′, and double negation (B′)′ = B)","hi":"Y = A′ · B (डी मॉर्गन का नियम लागू करके: A′ · (B′)′, और डबल नेगेशन (B′)′ = B)"},{"en":"Y = A · B′","hi":"Y = A · B′"}],"exp":{"en":"Applying De Morgan's second law to (A + B′)′ yields A′ · (B′)′. Because (B′)′ is just B, the simplified expression is A′ · B.","hi":"Y = (A + B′)′ पर डी मॉर्गन का नियम लगाने से ऑपरेटर AND (·) बन जाता है: A′ · (B′)′। डबल नेगेशन नियम से (B′)′ = B होता है, इसलिए उत्तर A′ · B होगा।"},"num":43}]},{"title":{"en":"5. XOR, XNOR & Circuit Practice","hi":"5. XOR, XNOR और सर्किट अभ्यास"},"questions":[{"id":"q44","q":{"en":"What are the symbol, expression, and logic of an XOR (Exclusive-OR) gate?","hi":"XOR (Exclusive-OR) गेट का प्रतीक (symbol), एक्सप्रेशन और लॉजिक क्या है?"},"a":{"en":"Curved shape with an extra curve on the input side; Y = A ⊕ B = A′B + AB′; Output is 1 only when inputs are DIFFERENT (0,1 or 1,0)","hi":"इनपुट साइड पर एक अतिरिक्त वक्र (curve) के साथ घुमावदार आकार; Y = A ⊕ B = A′B + AB′; आउटपुट 1 तभी होता है जब इनपुट अलग (DIFFERENT) हों (0,1 या 1,0)"},"o":[{"en":"Curved shape with an extra curve on the input side; Y = A ⊕ B = A′B + AB′; Output is 1 only when inputs are DIFFERENT (0,1 or 1,0)","hi":"इनपुट साइड पर एक अतिरिक्त वक्र (curve) के साथ घुमावदार आकार; Y = A ⊕ B = A′B + AB′; आउटपुट 1 तभी होता है जब इनपुट अलग (DIFFERENT) हों (0,1 या 1,0)"},{"en":"D-shaped gate; Y = A · B; Output is 1 only when all inputs are 1","hi":"D-आकार का गेट; Y = A · B; आउटपुट 1 तभी होता है जब सभी इनपुट 1 हों"},{"en":"Curved shape with an extra curve and an output bubble; Y = (A ⊕ B)′; Output is 1 only when inputs are the same","hi":"एक अतिरिक्त वक्र और आउटपुट बबल के साथ घुमावदार आकार; Y = (A ⊕ B)′; आउटपुट 1 तभी होता है जब इनपुट समान हों"},{"en":"Triangle with a bubble; Y = A′; Output is 1 for input 0","hi":"बबल के साथ त्रिकोण; Y = A′; इनपुट 0 के लिए आउटपुट 1 है"}],"exp":{"en":"An XOR gate uses an OR symbol with an extra curved line on the input side. It outputs a 1 only when the two inputs are not identical.","hi":"XOR गेट के प्रतीक में इनपुट साइड पर एक अतिरिक्त वक्र (curve) होता है। इसका एक्सप्रेशन Y = A ⊕ B (या A′B + AB′) है। यदि दोनों इनपुट अलग-अलग (0,1 या 1,0) हों, तभी इसका आउटपुट 1 होता है।"},"num":44},{"id":"q45","q":{"en":"What are the symbol, expression, and logic of an XNOR (Exclusive-NOR) gate?","hi":"XNOR (Exclusive-NOR) गेट का प्रतीक (symbol), एक्सप्रेशन और लॉजिक क्या है?"},"a":{"en":"XOR shape with an output bubble; Y = (A ⊕ B)′ = AB + A′B′; Output is 1 only when inputs are the SAME (0,0 or 1,1)","hi":"आउटपुट बबल के साथ XOR आकार; Y = (A ⊕ B)′ = AB + A′B′; आउटपुट 1 तभी होता है जब इनपुट समान (SAME) हों (0,0 या 1,1)"},"o":[{"en":"Curved shape with an extra curve on the input side; Y = A ⊕ B; Output is 1 when inputs are different","hi":"इनपुट साइड पर एक अतिरिक्त वक्र के साथ घुमावदार आकार; Y = A ⊕ B; जब इनपुट अलग होते हैं तो आउटपुट 1 होता है"},{"en":"D-shaped gate with an output bubble; Y = (A · B)′; Output is 0 when all inputs are 1","hi":"आउटपुट बबल के साथ D-आकार का गेट; Y = (A · B)′; जब सभी इनपुट 1 होते हैं तो आउटपुट 0 होता है"},{"en":"XOR shape with an output bubble; Y = (A ⊕ B)′ = AB + A′B′; Output is 1 only when inputs are the SAME (0,0 or 1,1)","hi":"आउटपुट बबल के साथ XOR आकार; Y = (A ⊕ B)′ = AB + A′B′; आउटपुट 1 तभी होता है जब इनपुट समान (SAME) हों (0,0 या 1,1)"},{"en":"OR shape with an output bubble; Y = (A + B)′; Output is 1 when all inputs are 0","hi":"आउटपुट बबल के साथ OR आकार; Y = (A + B)′; जब सभी इनपुट 0 होते हैं तो आउटपुट 1 होता है"}],"exp":{"en":"An XNOR gate is an XOR gate followed by a NOT bubble. It outputs a 1 (HIGH) strictly when its two inputs are exactly identical (both 0 or both 1).","hi":"XNOR गेट का प्रतीक XOR गेट के आउटपुट पर एक बबल लगाकर बनता है। इसका एक्सप्रेशन Y = (A ⊕ B)′ (या AB + A′B′) है। यदि दोनों इनपुट समान (0,0 या 1,1) हों, तभी इसका आउटपुट 1 होता है।"},"num":45},{"id":"q46","q":{"en":"How are two-input XOR and XNOR gates commonly used for comparison?","hi":"तुलना (Comparison) के लिए 2-इनपुट XOR और XNOR गेट्स का उपयोग कैसे किया जाता है?"},"a":{"en":"XOR reveals a 1-bit mismatch (inputs differ); XNOR reveals a 1-bit match (inputs are identical) / XOR 1-बिट बेमेल (मिसमैच / mismatch) दिखाता है; XNOR 1-बिट मिलान (मैच","hi":"match) दिखाता है"},"o":[{"en":"XOR outputs 1 if inputs are identical; XNOR outputs 1 if they differ","hi":"XOR आउटपुट 1 देता है यदि इनपुट समान हैं; XNOR आउटपुट 1 देता है यदि वे भिन्न हैं"},{"en":"Both output 1 when inputs are 0,0","hi":"दोनों 1 आउटपुट देते हैं जब इनपुट 0,0 होते हैं"},{"en":"XOR reveals a 1-bit mismatch (inputs differ); XNOR reveals a 1-bit match (inputs are identical) / XOR 1-बिट बेमेल (मिसमैच / mismatch) दिखाता है; XNOR 1-बिट मिलान (मैच","hi":"match) दिखाता है"},{"en":"They cannot be used for comparison","hi":"उनका उपयोग तुलना के लिए नहीं किया जा सकता है"}],"exp":{"en":"In digital comparators, an XOR gate is an inequality detector (outputting 1 on mismatch), while an XNOR gate is an equality detector (outputting 1 on match).","hi":"तुलना (Comparison) में, XOR गेट 1-बिट का मिसमैच (mismatch - जब इनपुट अलग हों) दिखाता है, जबकि XNOR गेट 1-बिट का मैच (match - जब इनपुट समान हों) दिखाता है।"},"num":46},{"id":"q47","q":{"en":"If three inputs (1, 1, 1) are fed into a chained XOR circuit, what is the final output?","hi":"यदि तीन इनपुट (1, 1, 1) को एक चेन्ड (chained) XOR सर्किट में दिया जाए, तो अंतिम आउटपुट क्या होगा?"},"a":{"en":"1 (Because (1 ⊕ 1) ⊕ 1 = 0 ⊕ 1 = 1; chained XOR acts as an odd-parity generator, outputting 1 for an odd count of 1s)","hi":"1 (क्योंकि (1 ⊕ 1) ⊕ 1 = 0 ⊕ 1 = 1; चेन्ड XOR एक ऑड-पैरिटी (odd-parity) जनरेटर के रूप में कार्य करता है, जो 1s की विषम (odd) गिनती पर 1 आउटपुट करता है)"},"o":[{"en":"0","hi":"0"},{"en":"1 (Because (1 ⊕ 1) ⊕ 1 = 0 ⊕ 1 = 1; chained XOR acts as an odd-parity generator, outputting 1 for an odd count of 1s)","hi":"1 (क्योंकि (1 ⊕ 1) ⊕ 1 = 0 ⊕ 1 = 1; चेन्ड XOR एक ऑड-पैरिटी (odd-parity) जनरेटर के रूप में कार्य करता है, जो 1s की विषम (odd) गिनती पर 1 आउटपुट करता है)"},{"en":"2","hi":"2"},{"en":"None of the above","hi":"उपर्युक्त में से कोई नहीं"}],"exp":{"en":"A chained multi-input XOR circuit outputs 1 if there is an odd number of 1s among its inputs. Here, there are three 1s (odd count), so the output is 1.","hi":"चेन्ड (chained) XOR सर्किट में यदि इनपुट्स में '1' की संख्या विषम (odd) हो, तो आउटपुट 1 होता है। यहाँ (1 ⊕ 1) ⊕ 1 = 0 ⊕ 1 = 1 होगा।"},"num":47},{"id":"q48","q":{"en":"How can you quickly revise the output sequences of the six two-input gates (AND, OR, NAND, NOR, XOR, XNOR) for input order 00, 01, 10, 11?","hi":"इनपुट क्रम 00, 01, 10, 11 के लिए छह 2-इनपुट गेट्स (AND, OR, NAND, NOR, XOR, XNOR) के आउटपुट अनुक्रम (sequences) को आप एक साथ कैसे रिवाइज कर सकते हैं?"},"a":{"en":"AND 0001, OR 0111, NAND 1110, NOR 1000, XOR 0110, XNOR 1001","hi":"AND 0001, OR 0111, NAND 1110, NOR 1000, XOR 0110, XNOR 1001"},"o":[{"en":"They all have the same sequence 0011","hi":"उन सभी का एक ही क्रम 0011 है"},{"en":"AND 0001, OR 0111, NAND 1110, NOR 1000, XOR 0110, XNOR 1001","hi":"AND 0001, OR 0111, NAND 1110, NOR 1000, XOR 0110, XNOR 1001"},{"en":"They are completely random and cannot be memorized","hi":"वे पूरी तरह से यादृच्छिक हैं और उन्हें याद नहीं किया जा सकता है"},{"en":"AND 1111, OR 0000, NAND 0101, NOR 1010, XOR 1100, XNOR 0011","hi":"AND 1111, OR 0000, NAND 0101, NOR 1010, XOR 1100, XNOR 0011"}],"exp":{"en":"For inputs in standard binary counting order (00, 01, 10, 11), the four-bit output sequences are AND(0001), OR(0111), NAND(1110), NOR(1000), XOR(0110), and XNOR(1001).","hi":"इनपुट क्रम 00, 01, 10, 11 के लिए गेट्स के आउटपुट अनुक्रम (sequences) इस प्रकार हैं: AND 0001, OR 0111, NAND 1110, NOR 1000, XOR 0110, और XNOR 1001।"},"num":48},{"id":"q49","q":{"en":"If inputs A and B first pass through an OR gate, and that output plus input C are fed into a NAND gate, what is the final output Y if A=0, B=1, and C=1?","hi":"यदि इनपुट A और B पहले OR गेट से गुजरते हैं, और वह आउटपुट प्लस इनपुट C एक NAND गेट में दिए जाते हैं, तो A=0, B=1, और C=1 होने पर अंतिम आउटपुट Y क्या होगा?"},"a":{"en":"0 (OR output is 0 + 1 = 1; then 1 NAND 1 = 0)","hi":"0 (OR आउटपुट 0 + 1 = 1 है; फिर 1 NAND 1 = 0)"},"o":[{"en":"1","hi":"1"},{"en":"0 (OR output is 0 + 1 = 1; then 1 NAND 1 = 0)","hi":"0 (OR आउटपुट 0 + 1 = 1 है; फिर 1 NAND 1 = 0)"},{"en":"2","hi":"2"},{"en":"None of the above","hi":"उपर्युक्त में से कोई नहीं"}],"exp":{"en":"First stage: A (0) OR B (1) yields 1. Second stage: That 1 is NANDed with C (1), and 1 NAND 1 yields 0.","hi":"पहला चरण: A=0 और B=1 का OR आउटपुट 1 होगा (0+1=1)। दूसरा चरण: यह 1 और C=1 दोनों NAND गेट में जाएंगे, तो 1 NAND 1 का आउटपुट 0 होगा।"},"num":49},{"id":"q50","q":{"en":"In the Boolean expression Y = A · B + C′, what is the final output if A=1, B=0, and C=0?","hi":"बूलियन एक्सप्रेशन Y = A · B + C′ में, यदि A=1, B=0, और C=0 हो, तो अंतिम आउटपुट क्या होगा?"},"a":{"en":"1 (Because A · B = 0, C′ = 1, and 0 + 1 = 1)","hi":"1 (क्योंकि A · B = 0, C′ = 1, और 0 + 1 = 1)"},"o":[{"en":"0","hi":"0"},{"en":"1 (Because A · B = 0, C′ = 1, and 0 + 1 = 1)","hi":"1 (क्योंकि A · B = 0, C′ = 1, और 0 + 1 = 1)"},{"en":"2","hi":"2"},{"en":"-1","hi":"-1"}],"exp":{"en":"Substitute the values: (1 · 0) + (0)′. The AND operation gives 0, the NOT operation gives 1, and 0 + 1 (OR) yields 1.","hi":"मान रखने पर: A · B (यानी 1 · 0) का मान 0 होगा। C′ (यानी 0 का उल्टा) 1 होगा। अंत में 0 + 1 (OR) करने पर 1 प्राप्त होगा।"},"num":50}]},{"title":{"en":"6. DOCX Supplement — Computer Security","hi":"6. कंप्यूटर सुरक्षा — DOCX सप्लीमेंट"},"questions":[{"id":"q51","q":{"en":"What does computer security protect?","hi":"कंप्यूटर सुरक्षा (Computer security) क्या सुरक्षित करती है?"},"a":{"en":"It protects computer systems and information from damage, theft, and unauthorized use (covers hardware, software, networks, and data)","hi":"यह कंप्यूटर सिस्टम और सूचना को क्षति (damage), चोरी (theft) और अनधिकृत उपयोग (unauthorized use) से बचाती है (इसमें हार्डवेयर, सॉफ्टवेयर, नेटवर्क और डेटा शामिल हैं)"},"o":[{"en":"It only protects the plastic casing of the monitor","hi":"यह केवल मॉनिटर के प्लास्टिक आवरण की रक्षा करती है"},{"en":"It protects computer systems and information from damage, theft, and unauthorized use (covers hardware, software, networks, and data)","hi":"यह कंप्यूटर सिस्टम और सूचना को क्षति (damage), चोरी (theft) और अनधिकृत उपयोग (unauthorized use) से बचाती है (इसमें हार्डवेयर, सॉफ्टवेयर, नेटवर्क और डेटा शामिल हैं)"},{"en":"It strictly protects against physical fire only","hi":"यह केवल भौतिक आग से सख्ती से रक्षा करती है"},{"en":"It prevents the computer from consuming electricity","hi":"यह कंप्यूटर को बिजली की खपत करने से रोकती है"}],"exp":{"en":"Computer security is a broad discipline that protects entire systems—hardware, software, networks, and data—from damage, theft, and unauthorized access.","hi":"कंप्यूटर सुरक्षा (Computer Security) हार्डवेयर, सॉफ्टवेयर, नेटवर्क और डेटा को नुकसान, चोरी और बिना अनुमति के उपयोग (unauthorized use) से बचाती है।"},"num":51},{"id":"q52","q":{"en":"What are the three pillars of the CIA triad?","hi":"CIA ट्रायड (CIA triad) के तीन स्तंभ (pillars) क्या हैं?"},"a":{"en":"Confidentiality, Integrity, and Availability","hi":"गोपनीयता (Confidentiality), अखंडता (Integrity) और उपलब्धता (Availability)"},"o":[{"en":"Central, Intelligence, and Agency","hi":"सेंट्रल, इंटेलिजेंस और एजेंसी"},{"en":"Confidentiality, Integrity, and Availability","hi":"गोपनीयता (Confidentiality), अखंडता (Integrity) और उपलब्धता (Availability)"},{"en":"Computer, Internet, and Application","hi":"कंप्यूटर, इंटरनेट और एप्लिकेशन"},{"en":"Code, Information, and Access","hi":"कोड, सूचना और एक्सेस"}],"exp":{"en":"The foundational model of information security is the CIA triad, which stands for Confidentiality, Integrity, and Availability.","hi":"सूचना सुरक्षा का मूल मॉडल CIA ट्रायड है, जिसका अर्थ है: Confidentiality (गोपनीयता), Integrity (अखंडता), और Availability (उपलब्धता)।"},"num":52},{"id":"q53","q":{"en":"Ensuring that sensitive data can only be viewed by authorized users falls under which pillar?","hi":"संवेदनशील डेटा (sensitive data) केवल अधिकृत उपयोगकर्ता (authorized users) ही देख सकें, यह किस स्तंभ (pillar) के अंतर्गत आता है?"},"a":{"en":"Confidentiality (e.g., access control or encryption)","hi":"गोपनीयता (Confidentiality) (जैसे, एक्सेस कंट्रोल या एन्क्रिप्शन)"},"o":[{"en":"Confidentiality (e.g., access control or encryption)","hi":"गोपनीयता (Confidentiality) (जैसे, एक्सेस कंट्रोल या एन्क्रिप्शन)"},{"en":"Integrity","hi":"अखंडता (Integrity)"},{"en":"Availability","hi":"उपलब्धता (Availability)"},{"en":"Authenticity","hi":"प्रामाणिकता (Authenticity)"}],"exp":{"en":"Confidentiality ensures that sensitive information is kept private and only accessible to those with the proper authorization (e.g., through passwords or encryption).","hi":"गोपनीयता (Confidentiality) यह सुनिश्चित करती है कि संवेदनशील जानकारी केवल सही/अधिकृत लोगों तक ही पहुँचे (एक्सेस कंट्रोल या एन्क्रिप्शन के माध्यम से)।"},"num":53},{"id":"q54","q":{"en":"Protecting the correctness of records from unauthorized changes is the goal of which pillar?","hi":"अनधिकृत परिवर्तनों (unauthorized changes) से रिकॉर्ड की शुद्धता (correctness) को बचाना किस स्तंभ का लक्ष्य है?"},"a":{"en":"Integrity (preserves data accuracy and completeness)","hi":"अखंडता (Integrity) (यह डेटा की सटीकता और पूर्णता को संरक्षित करता है)"},"o":[{"en":"Confidentiality","hi":"गोपनीयता (Confidentiality)"},{"en":"Availability","hi":"उपलब्धता (Availability)"},{"en":"Portability","hi":"सुवाह्यता (Portability)"},{"en":"Integrity (preserves data accuracy and completeness)","hi":"अखंडता (Integrity) (यह डेटा की सटीकता और पूर्णता को संरक्षित करता है)"}],"exp":{"en":"Integrity safeguards the accuracy, consistency, and completeness of data over its entire lifecycle, preventing unauthorized modifications.","hi":"अखंडता (Integrity) डेटा की सटीकता और पूर्णता को बनाए रखती है, ताकि कोई अनधिकृत व्यक्ति उसमें बदलाव (changes) न कर सके।"},"num":54},{"id":"q55","q":{"en":"Ensuring that authorized users can access the system when needed is the goal of which pillar?","hi":"अधिकृत उपयोगकर्ताओं (authorized users) को ज़रूरत पड़ने पर सिस्टम मिल सके, यह किस स्तंभ का लक्ष्य है?"},"a":{"en":"Availability (affected by outages, downtime, and resource loss)","hi":"उपलब्धता (Availability) (यह आउटेज, डाउनटाइम और संसाधनों के नुकसान से प्रभावित होती है)"},"o":[{"en":"Integrity","hi":"अखंडता (Integrity)"},{"en":"Availability (affected by outages, downtime, and resource loss)","hi":"उपलब्धता (Availability) (यह आउटेज, डाउनटाइम और संसाधनों के नुकसान से प्रभावित होती है)"},{"en":"Confidentiality","hi":"गोपनीयता (Confidentiality)"},{"en":"Accountability","hi":"जवाबदेही (Accountability)"}],"exp":{"en":"Availability ensures that systems, networks, and data are functioning and accessible when authorized users need them (preventing downtime).","hi":"उपलब्धता (Availability) यह सुनिश्चित करती है कि सिस्टम और डेटा ज़रूरत के समय हमेशा चालू रहें (डाउनटाइम या आउटेज को रोककर)।"},"num":55},{"id":"q56","q":{"en":"What are examples of physical or environmental threats?","hi":"भौतिक या पर्यावरणीय खतरों (physical or environmental threats) के उदाहरण क्या हैं?"},"a":{"en":"Fire, flood, earthquake, lightning, extreme temperature, and power failure","hi":"आग, बाढ़, भूकंप, बिजली गिरना, अत्यधिक तापमान और बिजली की विफलता"},"o":[{"en":"Fire, flood, earthquake, lightning, extreme temperature, and power failure","hi":"आग, बाढ़, भूकंप, बिजली गिरना, अत्यधिक तापमान और बिजली की विफलता"},{"en":"Phishing emails and ransomware","hi":"फ़िशिंग ईमेल और रैनसमवेयर"},{"en":"Weak passwords and outdated software","hi":"कमज़ोर पासवर्ड और पुराना सॉफ़्टवेयर"},{"en":"SQL injection and cross-site scripting","hi":"SQL इंजेक्शन और क्रॉस-साइट स्क्रिप्टिंग"}],"exp":{"en":"Environmental threats include natural disasters (fires, floods, earthquakes) and infrastructure failures like extreme temperature variations and power outages.","hi":"भौतिक/पर्यावरणीय खतरों में आग, बाढ़, भूकंप, खराब मौसम, अत्यधिक तापमान और बिजली का गुल होना (power failure) शामिल हैं।"},"num":56},{"id":"q57","q":{"en":"What are examples of human threats in computer security?","hi":"कंप्यूटर सुरक्षा में मानवीय खतरों (human threats) के उदाहरण क्या हैं?"},"a":{"en":"Malicious intrusion, insider misuse, phishing, social engineering, accidental deletion, and malware attacks","hi":"दुर्भावनापूर्ण घुसपैठ, अंदरूनी दुरुपयोग, फ़िशिंग, सोशल इंजीनियरिंग, आकस्मिक विलोपन (accidental deletion) और मैलवेयर हमले"},"o":[{"en":"Earthquakes and lightning","hi":"भूकंप और बिजली गिरना"},{"en":"Malicious intrusion, insider misuse, phishing, social engineering, accidental deletion, and malware attacks","hi":"दुर्भावनापूर्ण घुसपैठ, अंदरूनी दुरुपयोग, फ़िशिंग, सोशल इंजीनियरिंग, आकस्मिक विलोपन (accidental deletion) और मैलवेयर हमले"},{"en":"Hardware overheating","hi":"हार्डवेयर का ज़्यादा गरम होना"},{"en":"Software bugs in the operating system kernel","hi":"ऑपरेटिंग सिस्टम कर्नेल में सॉफ़्टवेयर बग"}],"exp":{"en":"Human threats involve human action, either intentional (hacking, phishing, insider misuse, deploying malware) or unintentional (accidental deletion of files).","hi":"मानवीय खतरों में हैकिंग, अंदरूनी लोगों द्वारा दुरुपयोग, फ़िशिंग, सोशल इंजीनियरिंग, गलती से फाइलें डिलीट करना (accidental deletion) और मैलवेयर हमले शामिल हैं।"},"num":57},{"id":"q58","q":{"en":"What does authentication verify?","hi":"प्रमाणीकरण (Authentication) क्या सत्यापित करता है?"},"a":{"en":"The identity of a user, process, or device (examples: Password, PIN, biometrics, and token-based OTP)","hi":"किसी उपयोगकर्ता, प्रक्रिया या डिवाइस की पहचान (उदाहरण: पासवर्ड, पिन, बायोमेट्रिक्स और टोकन-आधारित OTP)"},"o":[{"en":"The speed of the CPU","hi":"CPU की गति"},{"en":"The identity of a user, process, or device (examples: Password, PIN, biometrics, and token-based OTP)","hi":"किसी उपयोगकर्ता, प्रक्रिया या डिवाइस की पहचान (उदाहरण: पासवर्ड, पिन, बायोमेट्रिक्स और टोकन-आधारित OTP)"},{"en":"The amount of free RAM available","hi":"उपलब्ध फ्री RAM की मात्रा"},{"en":"The physical location of a server","hi":"सर्वर का भौतिक स्थान"}],"exp":{"en":"Authentication is the process of verifying that a user or system is exactly who they claim to be, typically using passwords, PINs, OTPs, or biometrics.","hi":"प्रमाणीकरण (Authentication) उपयोगकर्ता या डिवाइस की पहचान (identity) को वेरिफाई करता है। इसके उदाहरण पासवर्ड, पिन, OTP और फिंगरप्रिंट (बायोमेट्रिक्स) हैं।"},"num":58},{"id":"q59","q":{"en":"Why is using a password and a PIN together not considered True Two-Factor Authentication (2FA)?","hi":"पासवर्ड और पिन को एक साथ उपयोग करना सही टू-फैक्टर ऑथेंटिकेशन (2FA) क्यों नहीं माना जाता है?"},"a":{"en":"Because they are both 'knowledge factors' (something you know); true 2FA requires two different factor types (e.g., password + possession of an authenticator app)","hi":"क्योंकि वे दोनों 'नॉलेज फैक्टर' (knowledge factors - कुछ ऐसा जो आप जानते हैं) हैं; सही 2FA के लिए दो अलग-अलग प्रकार के फैक्टर (जैसे, पासवर्ड + ऑथेंटिकेटर ऐप का कब्ज़ा) की आवश्यकता होती है"},"o":[{"en":"Because a PIN is an analog device","hi":"क्योंकि पिन एक एनालॉग डिवाइस है"},{"en":"Because they are both 'knowledge factors' (something you know); true 2FA requires two different factor types (e.g., password + possession of an authenticator app)","hi":"क्योंकि वे दोनों 'नॉलेज फैक्टर' (knowledge factors - कुछ ऐसा जो आप जानते हैं) हैं; सही 2FA के लिए दो अलग-अलग प्रकार के फैक्टर (जैसे, पासवर्ड + ऑथेंटिकेटर ऐप का कब्ज़ा) की आवश्यकता होती है"},{"en":"Because passwords are no longer used","hi":"क्योंकि अब पासवर्ड का उपयोग नहीं किया जाता है"},{"en":"Because they both use alphabetical characters","hi":"क्योंकि वे दोनों वर्णमाला (alphabetical) वर्णों का उपयोग करते हैं"}],"exp":{"en":"True 2FA requires mixing categories (e.g., something you know + something you have). A password and a PIN both belong to the 'something you know' category.","hi":"2FA (Two-Factor Authentication) में दो अलग-अलग फैक्टर (जैसे: कुछ जो आप जानते हैं + कुछ जो आपके पास है) चाहिए। पासवर्ड और पिन दोनों ही 'नॉलेज फैक्टर' (knowledge factor) हैं, इसलिए ये मिलकर 2FA नहीं बनाते।"},"num":59},{"id":"q60","q":{"en":"What are the directions of encryption and decryption?","hi":"एन्क्रिप्शन (Encryption) और डिक्रिप्शन (Decryption) की दिशाएँ (directions) क्या हैं?"},"a":{"en":"Encryption converts plaintext to ciphertext. Decryption brings ciphertext back to plaintext using a key.","hi":"एन्क्रिप्शन प्लेनटेक्स्ट को सिफरटेक्स्ट बनाता है। डिक्रिप्शन की (key) की मदद से सिफरटेक्स्ट को प्लेनटेक्स्ट में वापस लाता है।"},"o":[{"en":"Both convert ciphertext to plaintext","hi":"दोनों सिफरटेक्स्ट को प्लेनटेक्स्ट में बदलते हैं"},{"en":"Encryption converts plaintext to ciphertext. Decryption brings ciphertext back to plaintext using a key.","hi":"एन्क्रिप्शन प्लेनटेक्स्ट को सिफरटेक्स्ट बनाता है। डिक्रिप्शन की (key) की मदद से सिफरटेक्स्ट को प्लेनटेक्स्ट में वापस लाता है।"},{"en":"Both permanently delete data","hi":"दोनों डेटा को स्थायी रूप से हटा देते हैं"},{"en":"Encryption converts binary to analog; decryption converts analog to binary","hi":"एन्क्रिप्शन बाइनरी को एनालॉग में बदलता है; डिक्रिप्शन एनालॉग को बाइनरी में बदलता है"}],"exp":{"en":"Encryption scrambles readable plaintext into unreadable ciphertext. Decryption is the reverse process, using a cryptographic key to restore the plaintext.","hi":"एन्क्रिप्शन (Encryption) पढ़े जा सकने वाले प्लेनटेक्स्ट को सिफरटेक्स्ट (कोड) में बदलता है। डिक्रिप्शन (Decryption) एक की (key) का उपयोग करके उसे वापस प्लेनटेक्स्ट में लाता है।"},"num":60},{"id":"q61","q":{"en":"What is malware and what are some examples?","hi":"मैलवेयर (Malware) क्या होता है और इसके उदाहरण क्या हैं?"},"a":{"en":"Malicious software that can damage, disrupt, or compromise systems; examples include virus, worm, Trojan, ransomware, and spyware","hi":"दुर्भावनापूर्ण सॉफ़्टवेयर (Malicious software) जो सिस्टम को नुकसान, बाधित या समझौता (compromise) कर सकता है; उदाहरणों में वायरस, वर्म, ट्रोजन, रैनसमवेयर और स्पाईवेयर शामिल हैं"},"o":[{"en":"It is hardware used for gaming","hi":"यह गेमिंग के लिए प्रयुक्त हार्डवेयर है"},{"en":"It is a protective firewall system","hi":"यह एक सुरक्षात्मक फ़ायरवॉल सिस्टम है"},{"en":"Malicious software that can damage, disrupt, or compromise systems; examples include virus, worm, Trojan, ransomware, and spyware","hi":"दुर्भावनापूर्ण सॉफ़्टवेयर (Malicious software) जो सिस्टम को नुकसान, बाधित या समझौता (compromise) कर सकता है; उदाहरणों में वायरस, वर्म, ट्रोजन, रैनसमवेयर और स्पाईवेयर शामिल हैं"},{"en":"It is a type of mechanical punch card","hi":"यह एक प्रकार का यांत्रिक पंच कार्ड है"}],"exp":{"en":"Malware (malicious software) encompasses all software designed to harm or exploit computers, including viruses, worms, Trojans, ransomware, and spyware.","hi":"मैलवेयर दुर्भावनापूर्ण सॉफ़्टवेयर (Malicious software) है जो सिस्टम को नुकसान पहुँचाता है। वायरस, वर्म, ट्रोजन, रैनसमवेयर और स्पाईवेयर इसके प्रमुख उदाहरण हैं।"},"num":61},{"id":"q62","q":{"en":"What does a digital signature help verify?","hi":"डिजिटल हस्ताक्षर (Digital signature) क्या सत्यापित करने में मदद करता है?"},"a":{"en":"The origin authenticity and integrity of a message or document (signer uses a private key, verified with a public key)","hi":"किसी संदेश या दस्तावेज़ की मूल प्रामाणिकता (origin authenticity) और अखंडता (integrity); (हस्ताक्षरकर्ता निजी कुंजी (private key) का उपयोग करता है, जिसे सार्वजनिक कुंजी (public key) से सत्यापित किया जाता है)"},"o":[{"en":"The grammatical correctness of an email","hi":"एक ईमेल की व्याकरणिक शुद्धता"},{"en":"The physical address of the sender","hi":"प्रेषक का भौतिक पता"},{"en":"The origin authenticity and integrity of a message or document (signer uses a private key, verified with a public key)","hi":"किसी संदेश या दस्तावेज़ की मूल प्रामाणिकता (origin authenticity) और अखंडता (integrity); (हस्ताक्षरकर्ता निजी कुंजी (private key) का उपयोग करता है, जिसे सार्वजनिक कुंजी (public key) से सत्यापित किया जाता है)"},{"en":"The file size limit of an attachment","hi":"एक अटैचमेंट की फ़ाइल आकार सीमा"}],"exp":{"en":"A digital signature proves that a message was created by a known sender (authenticity) and was not altered in transit (integrity).","hi":"डिजिटल हस्ताक्षर संदेश की उत्पत्ति (authenticity) और अखंडता (integrity) को प्रमाणित करता है। भेजने वाला अपनी प्राइवेट की (private key) से साइन करता है और रिसीवर पब्लिक की (public key) से वेरिफाई करता है।"},"num":62},{"id":"q63","q":{"en":"If a readable message has a valid digital signature, which security goal is achieved?","hi":"यदि किसी पढ़े जा सकने वाले संदेश (readable message) पर वैध डिजिटल हस्ताक्षर है, तो कौन सा सुरक्षा लक्ष्य (security goal) प्राप्त होता है?"},"a":{"en":"Origin authenticity and integrity (message is intact and from the verified sender); encryption would be needed for privacy","hi":"मूल प्रामाणिकता और अखंडता (संदेश बरकरार है और सत्यापित प्रेषक से है); निजता (privacy) के लिए एन्क्रिप्शन की आवश्यकता होगी"},"o":[{"en":"Complete confidentiality (nobody else can read it)","hi":"पूर्ण गोपनीयता (कोई और इसे नहीं पढ़ सकता)"},{"en":"Origin authenticity and integrity (message is intact and from the verified sender); encryption would be needed for privacy","hi":"मूल प्रामाणिकता और अखंडता (संदेश बरकरार है और सत्यापित प्रेषक से है); निजता (privacy) के लिए एन्क्रिप्शन की आवश्यकता होगी"},{"en":"Protection against physical fire","hi":"भौतिक आग से सुरक्षा"},{"en":"It prevents the receiver from deleting the file","hi":"यह रिसीवर को फ़ाइल हटाने से रोकता है"}],"exp":{"en":"A digital signature on plaintext guarantees authenticity and integrity, but it does NOT provide confidentiality. If you need privacy, the message must also be encrypted.","hi":"डिजिटल हस्ताक्षर केवल प्रामाणिकता (authenticity) और अखंडता (integrity) सुनिश्चित करता है। यदि संदेश पहले से ही पढ़ने योग्य (readable) है, तो उसमें गोपनीयता (confidentiality) नहीं है; निजता के लिए एन्क्रिप्शन चाहिए।"},"num":63}]},{"title":{"en":"7. Exam Trap Reverse-Questions","hi":"7. परीक्षा के महत्वपूर्ण उल्टे प्रश्न"},"questions":[{"id":"q64","q":{"en":"Which code is identified by 7 bits, 128 values, and a range of 0–127?","hi":"7 बिट्स, 128 वैल्यू और 0-127 की सीमा से कौन सा कोड पहचाना जाता है?"},"a":{"en":"Standard ASCII","hi":"स्टैंडर्ड ASCII"},"o":[{"en":"EBCDIC","hi":"EBCDIC"},{"en":"UTF-16","hi":"UTF-16"},{"en":"Standard ASCII","hi":"स्टैंडर्ड ASCII"},{"en":"8421 BCD","hi":"8421 BCD"}],"exp":{"en":"Standard ASCII is exactly a 7-bit code mapping 128 (0 to 127) standard characters.","hi":"7 बिट्स और 128 (0–127) वैल्यू वाला कोड स्टैंडर्ड ASCII (Standard ASCII) है।"},"num":64},{"id":"q65","q":{"en":"What is the name of the 8-bit IBM character code?","hi":"8-बिट IBM कैरेक्टर कोड का नाम क्या है?"},"a":{"en":"EBCDIC","hi":"EBCDIC (एक्सटेंडेड बाइनरी कोडेड डेसिमल इंटरचेंज कोड)"},"o":[{"en":"Unicode","hi":"Unicode"},{"en":"Standard ASCII","hi":"Standard ASCII"},{"en":"UTF-8","hi":"UTF-8"},{"en":"EBCDIC","hi":"EBCDIC (एक्सटेंडेड बाइनरी कोडेड डेसिमल इंटरचेंज कोड)"}],"exp":{"en":"EBCDIC is the 8-bit character encoding family developed and primarily used by IBM.","hi":"IBM द्वारा उपयोग किया जाने वाला 8-बिट कैरेक्टर कोड EBCDIC है।"},"num":65},{"id":"q66","q":{"en":"Read the pattern 0100 0010 in 8421 BCD and as an unsigned binary number respectively.","hi":"पैटर्न 0100 0010 को क्रमशः 8421 BCD और अनसाइन्ड बाइनरी नंबर के रूप में पढ़ें।"},"a":{"en":"BCD: 42; Binary: 66 (Pure binary is 64 + 2 = 66)","hi":"BCD: 42; बाइनरी: 66 (शुद्ध बाइनरी 64 + 2 = 66 है)"},"o":[{"en":"BCD: 24; Binary: 128","hi":"BCD: 24; बाइनरी: 128"},{"en":"BCD: 42; Binary: 66 (Pure binary is 64 + 2 = 66)","hi":"BCD: 42; बाइनरी: 66 (शुद्ध बाइनरी 64 + 2 = 66 है)"},{"en":"BCD: 66; Binary: 42","hi":"BCD: 66; बाइनरी: 42"},{"en":"BCD: Invalid; Binary: 64","hi":"BCD: अमान्य; बाइनरी: 64"}],"exp":{"en":"In BCD, 0100 is 4 and 0010 is 2, giving 42. In pure unsigned binary, 01000010 = 64 + 2 = 66.","hi":"BCD में, 0100 का अर्थ 4 है और 0010 का अर्थ 2 है, जिससे 42 बनता है। शुद्ध बाइनरी में, 01000010 = 64 + 2 = 66 होता है।"},"num":66},{"id":"q67","q":{"en":"Someone wrote the BCD for decimal digit 9 as 1010. What is the correct code?","hi":"किसी ने दशमलव अंक 9 का BCD 1010 लिखा है। सही कोड क्या है?"},"a":{"en":"1001 (1010 is invalid for an 8421 BCD digit, as it equals 10)","hi":"1001 (1010 एक 8421 BCD अंक के लिए अमान्य है, क्योंकि यह 10 के बराबर है)"},"o":[{"en":"1111","hi":"1111"},{"en":"1001 (1010 is invalid for an 8421 BCD digit, as it equals 10)","hi":"1001 (1010 एक 8421 BCD अंक के लिए अमान्य है, क्योंकि यह 10 के बराबर है)"},{"en":"0110","hi":"0110"},{"en":"0000","hi":"0000"}],"exp":{"en":"The decimal digit 9 corresponds to binary 1001. The pattern 1010 is binary 10, which is an invalid BCD digit.","hi":"दशमलव अंक 9 का सही BCD कोड 1001 है। 1010 बाइनरी 10 है, जो BCD में अमान्य है।"},"num":67},{"id":"q68","q":{"en":"Which two-input gate is identified by an output of 1 at 00, and 0 at 01, 10, and 11?","hi":"00 पर 1 और 01, 10, 11 पर 0 आउटपुट से किस 2-इनपुट गेट की पहचान होती है?"},"a":{"en":"NOR","hi":"NOR गेट"},"o":[{"en":"NAND","hi":"NAND"},{"en":"XOR","hi":"XOR"},{"en":"OR","hi":"OR"},{"en":"NOR","hi":"NOR गेट"}],"exp":{"en":"A NOR gate outputs 1 strictly when both inputs are 0. Any presence of a 1 input forces the output to 0.","hi":"NOR गेट का आउटपुट 1 केवल तब होता है जब इसके दोनों इनपुट 0 (00) हों।"},"num":68},{"id":"q69","q":{"en":"Which two-input gate is identified by an output of 1 at 00, 01, and 10, and 0 at 11?","hi":"00, 01, 10 पर 1 और 11 पर 0 आउटपुट से किस 2-इनपुट गेट की पहचान होती है?"},"a":{"en":"NAND","hi":"NAND गेट"},"o":[{"en":"AND","hi":"AND"},{"en":"XNOR","hi":"XNOR"},{"en":"NAND","hi":"NAND गेट"},{"en":"OR","hi":"OR"}],"exp":{"en":"A NAND gate outputs 0 only when all inputs are 1. In all other cases (00, 01, 10), it outputs 1.","hi":"NAND गेट का आउटपुट 0 केवल तब होता है जब दोनों इनपुट 1 (11) हों, अन्य सभी में 1 होता है।"},"num":69},{"id":"q70","q":{"en":"Identify the gate: Output is 1 at 00 and 11, while it is 0 at 01 and 10.","hi":"गेट की पहचान करें: 00 और 11 पर आउटपुट 1 है, जबकि 01 और 10 पर 0 है।"},"a":{"en":"XNOR","hi":"XNOR गेट"},"o":[{"en":"XOR","hi":"XOR"},{"en":"NAND","hi":"NAND"},{"en":"NOR","hi":"NOR"},{"en":"XNOR","hi":"XNOR गेट"}],"exp":{"en":"An XNOR gate outputs 1 when its two inputs are exactly the same (00 or 11).","hi":"XNOR गेट का आउटपुट 1 तब होता है जब दोनों इनपुट समान हों (00 या 11)।"},"num":70},{"id":"q71","q":{"en":"Identify the gate: The symbol is shaped like an OR gate, has an extra input curve, and has NO output bubble.","hi":"गेट की पहचान करें: गेट का प्रतीक OR जैसा है, इसमें एक अतिरिक्त इनपुट वक्र (curve) है और कोई आउटपुट बबल नहीं है।"},"a":{"en":"XOR","hi":"XOR गेट"},"o":[{"en":"NOR","hi":"NOR"},{"en":"XNOR","hi":"XNOR"},{"en":"XOR","hi":"XOR गेट"},{"en":"AND","hi":"AND"}],"exp":{"en":"The XOR gate has an OR-like shield with a detached curved line on the input side and lacks a NOT bubble at the output.","hi":"XOR गेट के प्रतीक में इनपुट साइड पर एक अतिरिक्त वक्र (curve) होता है और आउटपुट पर कोई बबल नहीं होता।"},"num":71},{"id":"q72","q":{"en":"Which gate is identified by a single input, a triangle symbol, and an output bubble?","hi":"एक इनपुट, त्रिकोण (triangle) प्रतीक और आउटपुट बबल देखकर आप किस गेट की पहचान करेंगे?"},"a":{"en":"NOT gate (or inverter)","hi":"NOT गेट (या इन्वर्टर)"},"o":[{"en":"AND gate","hi":"AND gate"},{"en":"Identity/Buffer gate","hi":"Identity/Buffer gate"},{"en":"NOT gate (or inverter)","hi":"NOT गेट (या इन्वर्टर)"},{"en":"OR gate","hi":"OR gate"}],"exp":{"en":"The NOT gate (inverter) takes a single input and uses a triangle symbol with an inversion bubble.","hi":"त्रिकोण और आउटपुट बबल वाला सिंगल इनपुट गेट NOT गेट (इन्वर्टर) होता है।"},"num":72},{"id":"q73","q":{"en":"In a two-input circuit, which gates represent 'at least one high' and 'exactly one high' respectively?","hi":"दो-इनपुट सर्किट में, 'कम से कम एक हाई (at least one high)' और 'ठीक एक हाई (exactly one high)' क्रमशः किन गेट्स का प्रतिनिधित्व करते हैं?"},"a":{"en":"OR and XOR (For inputs 11, OR = 1 and XOR = 0)","hi":"OR और XOR (इनपुट 11 के लिए, OR = 1 और XOR = 0)"},"o":[{"en":"NAND and NOR","hi":"NAND and NOR"},{"en":"AND and XNOR","hi":"AND and XNOR"},{"en":"OR and XOR (For inputs 11, OR = 1 and XOR = 0)","hi":"OR और XOR (इनपुट 11 के लिए, OR = 1 और XOR = 0)"},{"en":"XOR and OR","hi":"XOR and OR"}],"exp":{"en":"An OR gate fires if at least one input is 1. An XOR gate fires only if exactly one input is 1 (excluding 1,1).","hi":"'कम से कम एक हाई' OR गेट (1,1 पर 1 देता है) है, और 'ठीक एक हाई' XOR गेट (1,1 पर 0 देता है) है।"},"num":73}]},{"title":{"en":"8. Rapid-Fire Final Revision","hi":"8. त्वरित अंतिम पुनरावृत्ति"},"questions":[{"id":"q74","q":{"en":"How many bits are there per digit in 8421 BCD?","hi":"8421 BCD में प्रति अंक कितने बिट्स होते हैं?"},"a":{"en":"4","hi":"4"},"o":[{"en":"2","hi":"2"},{"en":"8","hi":"8"},{"en":"4","hi":"4"},{"en":"16","hi":"16"}],"exp":{"en":"Each decimal digit is represented by 4 bits in BCD.","hi":"BCD में प्रत्येक दशमलव अंक 4 बिट्स से दर्शाया जाता है।"},"num":74},{"id":"q75","q":{"en":"What is the highest decimal code value in standard ASCII?","hi":"स्टैंडर्ड ASCII में उच्चतम दशमलव कोड मान (highest decimal code value) क्या है?"},"a":{"en":"127","hi":"127"},"o":[{"en":"127","hi":"127"},{"en":"255","hi":"255"},{"en":"64","hi":"64"},{"en":"128","hi":"128"}],"exp":{"en":"Standard 7-bit ASCII ranges from 0 to 127.","hi":"स्टैंडर्ड 7-बिट ASCII में मान 0 से 127 तक होते हैं।"},"num":75},{"id":"q76","q":{"en":"How many bit patterns are possible with 2⁸?","hi":"2⁸ के साथ कितने बिट पैटर्न संभव हैं?"},"a":{"en":"256","hi":"256"},"o":[{"en":"128","hi":"128"},{"en":"256","hi":"256"},{"en":"512","hi":"512"},{"en":"64","hi":"64"}],"exp":{"en":"An 8-bit sequence yields 2⁸ = 256 possible combinations.","hi":"8-बिट अनुक्रम (2⁸) से कुल 256 पैटर्न बनते हैं।"},"num":76},{"id":"q77","q":{"en":"What are the two common encoding forms of Unicode?","hi":"यूनिकोड के दो सामान्य एन्कोडिंग रूप कौन से हैं?"},"a":{"en":"UTF-8 and UTF-16","hi":"UTF-8 और UTF-16"},"o":[{"en":"ASCII and EBCDIC","hi":"ASCII and EBCDIC"},{"en":"UTF-8 and UTF-16","hi":"UTF-8 और UTF-16"},{"en":"BCD and Hex","hi":"BCD and Hex"},{"en":"Base64 and Binary","hi":"Base64 and Binary"}],"exp":{"en":"UTF-8 and UTF-16 are the primary encoding formats for Unicode code points.","hi":"यूनिकोड को आमतौर पर UTF-8 और UTF-16 में एन्कोड किया जाता है।"},"num":77},{"id":"q78","q":{"en":"What is the standard bit mapping for True and False?","hi":"सत्य (True) और असत्य (False) की बिट मैपिंग क्या है?"},"a":{"en":"True = 1, False = 0","hi":"सत्य (True) = 1, असत्य (False) = 0"},"o":[{"en":"True = 1, False = 0","hi":"सत्य (True) = 1, असत्य (False) = 0"},{"en":"True = 0, False = 1","hi":"True = 0, False = 1"},{"en":"True = 2, False = 1","hi":"True = 2, False = 1"},{"en":"True = A, False = B","hi":"True = A, False = B"}],"exp":{"en":"In positive logic, True is mapped to 1 and False to 0.","hi":"सकारात्मक लॉजिक में True को 1 और False को 0 माना जाता है।"},"num":78},{"id":"q79","q":{"en":"Which pair is known as the universal gates?","hi":"किस जोड़ी को यूनिवर्सल गेट्स (universal gates) के रूप में जाना जाता है?"},"a":{"en":"NAND and NOR","hi":"NAND और NOR"},"o":[{"en":"AND and OR","hi":"AND and OR"},{"en":"XOR and XNOR","hi":"XOR and XNOR"},{"en":"NAND and NOR","hi":"NAND और NOR"},{"en":"NOT and Buffer","hi":"NOT and Buffer"}],"exp":{"en":"NAND and NOR are the universal gates used to build any circuit.","hi":"NAND और NOR को यूनिवर्सल गेट्स कहा जाता है।"},"num":79},{"id":"q80","q":{"en":"What does an output bubble on a logic gate symbol indicate?","hi":"लॉजिक गेट प्रतीक (symbol) पर आउटपुट बबल (bubble) क्या दर्शाता है?"},"a":{"en":"Logical inversion","hi":"लॉजिकल इन्वर्शन (Logical inversion)"},"o":[{"en":"Amplification","hi":"Amplification"},{"en":"Logical inversion","hi":"लॉजिकल इन्वर्शन (Logical inversion)"},{"en":"Ground connection","hi":"Ground connection"},{"en":"Infinite loop","hi":"Infinite loop"}],"exp":{"en":"A small circle (bubble) at a gate's output signifies logical inversion (NOT).","hi":"आउटपुट बबल का मतलब लॉजिकल इन्वर्शन (NOT या पूरक) होता है।"},"num":80},{"id":"q81","q":{"en":"What are the outputs of AND, OR, and XOR gates when A=1 and B=1?","hi":"A=1, B=1 होने पर AND, OR और XOR के आउटपुट क्या होंगे?"},"a":{"en":"AND 1, OR 1, XOR 0","hi":"AND 1, OR 1, XOR 0"},"o":[{"en":"AND 1, OR 1, XOR 0","hi":"AND 1, OR 1, XOR 0"},{"en":"AND 0, OR 1, XOR 1","hi":"AND 0, OR 1, XOR 1"},{"en":"AND 1, OR 0, XOR 1","hi":"AND 1, OR 0, XOR 1"},{"en":"AND 0, OR 0, XOR 0","hi":"AND 0, OR 0, XOR 0"}],"exp":{"en":"For inputs 1,1: AND gives 1, OR gives 1, but XOR (exclusive) gives 0.","hi":"1,1 पर: AND=1, OR=1, और XOR=0 होता है।"},"num":81},{"id":"q82","q":{"en":"What are the outputs of NAND, NOR, and XNOR gates when A=0 and B=0?","hi":"A=0, B=0 होने पर NAND, NOR और XNOR के आउटपुट क्या होंगे?"},"a":{"en":"All three output 1","hi":"तीनों का आउटपुट 1 (All three output 1)"},"o":[{"en":"All three output 0","hi":"All three output 0"},{"en":"All three output 1","hi":"तीनों का आउटपुट 1 (All three output 1)"},{"en":"NAND 1, NOR 0, XNOR 0","hi":"NAND 1, NOR 0, XNOR 0"},{"en":"NAND 0, NOR 1, XNOR 1","hi":"NAND 0, NOR 1, XNOR 1"}],"exp":{"en":"For inputs 0,0: AND is 0 (so NAND is 1), OR is 0 (so NOR is 1), XOR is 0 (so XNOR is 1).","hi":"0,0 पर: NAND=1, NOR=1, और XNOR=1 होता है (तीनों 1 देते हैं)।"},"num":82},{"id":"q83","q":{"en":"What are the basic building blocks of flip-flops and decoders?","hi":"फ्लिप-फ्लॉप और डिकोडर्स के बेसिक बिल्डिंग ब्लॉक्स (basic building blocks) क्या हैं?"},"a":{"en":"Logic gates","hi":"लॉजिक गेट्स (Logic gates)"},"o":[{"en":"Vacuum tubes","hi":"Vacuum tubes"},{"en":"Logic gates","hi":"लॉजिक गेट्स (Logic gates)"},{"en":"Fiber optics","hi":"Fiber optics"},{"en":"Magnetic tape","hi":"Magnetic tape"}],"exp":{"en":"Complex digital components like flip-flops and decoders are constructed from logic gates.","hi":"फ्लिप-फ्लॉप और डिकोडर्स लॉजिक गेट्स से बनाए जाते हैं।"},"num":83},{"id":"q84","q":{"en":"What does the 'A' stand for in the CIA triad of computer security?","hi":"कंप्यूटर सुरक्षा के CIA ट्रायड में 'A' का पूर्ण रूप क्या है?"},"a":{"en":"Availability","hi":"उपलब्धता (Availability)"},"o":[{"en":"Agency","hi":"Agency"},{"en":"Authentication","hi":"Authentication"},{"en":"Availability","hi":"उपलब्धता (Availability)"},{"en":"Access","hi":"Access"}],"exp":{"en":"In the CIA triad, 'A' stands for Availability.","hi":"CIA ट्रायड में 'A' का अर्थ उपलब्धता (Availability) है।"},"num":84}]}],"10. OSI, TCP/IP Models & Protocols":[{"title":{"en":"1. OSI Model — Introduction, Layer Order & PDUs","hi":"1. OSI मॉडल — परिचय, लेयर क्रम और PDU"},"questions":[{"id":"q1","q":{"en":"What is the full form of OSI?","hi":"OSI का फुल फॉर्म क्या है?"},"a":{"en":"Open Systems Interconnection. 'Open' implies that systems with different architectures can communicate using standard interfaces and protocols","hi":"ओपन सिस्टम्स इंटरकनेक्शन (Open Systems Interconnection)। 'ओपन' का तात्पर्य है कि विभिन्न आर्किटेक्चर (architectures) वाले सिस्टम मानक इंटरफेस और प्रोटोकॉल का उपयोग करके संवाद (communicate) कर सकते हैं"},"o":[{"en":"Open Systems Internet","hi":"ओपन सिस्टम्स इंटरनेट"},{"en":"Open Systems Interconnection. 'Open' implies that systems with different architectures can communicate using standard interfaces and protocols","hi":"ओपन सिस्टम्स इंटरकनेक्शन (Open Systems Interconnection)। 'ओपन' का तात्पर्य है कि विभिन्न आर्किटेक्चर (architectures) वाले सिस्टम मानक इंटरफेस और प्रोटोकॉल का उपयोग करके संवाद (communicate) कर सकते हैं"},{"en":"Online System Interface","hi":"ऑनलाइन सिस्टम इंटरफेस"},{"en":"Operating System Interconnection","hi":"ऑपरेटिंग सिस्टम इंटरकनेक्शन"}],"exp":{"en":"The OSI model provides a standard framework that allows different computer systems to communicate regardless of their underlying architecture.\nSource-note (Hinglish): Open Systems Interconnection. “Open” ka idea hai ki standard interfaces aur protocols ke through alag systems communicate kar saken.","hi":"OSI मॉडल एक मानक ढांचा (standard framework) प्रदान करता है जो विभिन्न कंप्यूटर प्रणालियों को उनके अंतर्निहित आर्किटेक्चर (underlying architecture) की परवाह किए बिना संवाद (communicate) करने की अनुमति देता है।"},"num":1},{"id":"q2","q":{"en":"What does the OSI model explain?","hi":"OSI मॉडल क्या समझाता है?"},"a":{"en":"A reference model that divides networking into seven layers. It explains how data travels from an application on one host, through a physical medium, to an application on another host","hi":"एक संदर्भ मॉडल (reference model) जो नेटवर्किंग को सात परतों (seven layers) में विभाजित करता है। यह बताता है कि डेटा एक होस्ट पर एक एप्लिकेशन से भौतिक माध्यम (physical medium) के माध्यम से दूसरे होस्ट पर एप्लिकेशन तक कैसे यात्रा करता है"},"o":[{"en":"How to build a computer","hi":"कंप्यूटर कैसे बनाएं"},{"en":"A reference model that divides networking into seven layers. It explains how data travels from an application on one host, through a physical medium, to an application on another host","hi":"एक संदर्भ मॉडल (reference model) जो नेटवर्किंग को सात परतों (seven layers) में विभाजित करता है। यह बताता है कि डेटा एक होस्ट पर एक एप्लिकेशन से भौतिक माध्यम (physical medium) के माध्यम से दूसरे होस्ट पर एप्लिकेशन तक कैसे यात्रा करता है"},{"en":"How to write a software program","hi":"सॉफ्टवेयर प्रोग्राम कैसे लिखें"},{"en":"The history of the internet","hi":"इंटरनेट का इतिहास"}],"exp":{"en":"It acts as a theoretical blueprint for understanding network communication step-by-step.\nSource-note (Hinglish): Ek reference model jo networking ko seven layers mein divide karta hai. Yeh samjhata hai ki ek host ke application se data physical medium ke through doosre host ke application tak kaise jaata hai.","hi":"यह चरण-दर-चरण नेटवर्क संचार (network communication) को समझने के लिए एक सैद्धांतिक खाका (theoretical blueprint) के रूप में कार्य करता है।"},"num":2},{"id":"q3","q":{"en":"Which organization is associated with the OSI model, and what is its original publication year?","hi":"कौन सा संगठन (organization) OSI मॉडल से जुड़ा है, और इसका मूल प्रकाशन वर्ष (original publication year) क्या है?"},"a":{"en":"ISO (International Organization for Standardization). The original OSI reference model is associated with 1984. There is also a joint ISO/IEC–ITU-T edition of the basic model","hi":"आईएसओ (ISO - इंटरनेशनल ऑर्गनाइजेशन फॉर स्टैंडर्डाइजेशन)। मूल OSI संदर्भ मॉडल 1984 से जुड़ा है। मूल मॉडल का एक संयुक्त ISO/IEC–ITU-T संस्करण भी है"},"o":[{"en":"IEEE, 1990","hi":"IEEE, 1990"},{"en":"ISO (International Organization for Standardization). The original OSI reference model is associated with 1984. There is also a joint ISO/IEC–ITU-T edition of the basic model","hi":"आईएसओ (ISO - इंटरनेशनल ऑर्गनाइजेशन फॉर स्टैंडर्डाइजेशन)। मूल OSI संदर्भ मॉडल 1984 से जुड़ा है। मूल मॉडल का एक संयुक्त ISO/IEC–ITU-T संस्करण भी है"},{"en":"IETF, 1980","hi":"IETF, 1980"},{"en":"W3C, 1995","hi":"W3C, 1995"}],"exp":{"en":"The International Organization for Standardization (ISO) published the first version of the OSI reference model to standardize network protocols.\nSource-note (Hinglish): ISO (International Organization for Standardization). Original OSI reference model 1984 se associated hai. Basic model ka joint ISO/IEC–ITU-T edition bhi hai.","hi":"इंटरनेशनल ऑर्गनाइजेशन फॉर स्टैंडर्डाइजेशन (ISO) ने नेटवर्क प्रोटोकॉल को मानकीकृत (standardize) करने के लिए OSI संदर्भ मॉडल का पहला संस्करण प्रकाशित किया।"},"num":3},{"id":"q4","q":{"en":"What is the order of the seven OSI layers from Physical to Application?","hi":"OSI की सात परतों (layers) का क्रम फिजिकल (Physical) से एप्लिकेशन (Application) तक क्या है?"},"a":{"en":"L1 Physical → L2 Data Link → L3 Network → L4 Transport → L5 Session → L6 Presentation → L7 Application","hi":"L1 फिजिकल → L2 डेटा लिंक → L3 नेटवर्क → L4 ट्रांसपोर्ट → L5 सेशन → L6 प्रेजेंटेशन → L7 एप्लिकेशन"},"o":[{"en":"L1 Application → L2 Presentation → L3 Session → L4 Transport → L5 Network → L6 Data Link → L7 Physical","hi":"L1 Application → L2 Presentation → L3 Session → L4 Transport → L5 Network → L6 Data Link → L7 Physical"},{"en":"L1 Physical → L2 Data Link → L3 Network → L4 Transport → L5 Session → L6 Presentation → L7 Application","hi":"L1 फिजिकल → L2 डेटा लिंक → L3 नेटवर्क → L4 ट्रांसपोर्ट → L5 सेशन → L6 प्रेजेंटेशन → L7 एप्लिकेशन"},{"en":"L1 Data Link → L2 Network → L3 Physical → L4 Transport → L5 Session → L6 Presentation → L7 Application","hi":"L1 Data Link → L2 Network → L3 Physical → L4 Transport → L5 Session → L6 Presentation → L7 Application"},{"en":"L1 Physical → L2 Network → L3 Data Link → L4 Transport → L5 Session → L6 Presentation → L7 Application","hi":"L1 Physical → L2 Network → L3 Data Link → L4 Transport → L5 Session → L6 Presentation → L7 Application"}],"exp":{"en":"This is the standard bottom-to-top numbering scheme. Layer 1 is closest to the physical wire, and Layer 7 is closest to the user.\nSource-note (Hinglish): L1 Physical → L2 Data Link → L3 Network → L4 Transport → L5 Session → L6 Presentation → L7 Application.","hi":"यह मानक नीचे से ऊपर (bottom-to-top) नंबरिंग योजना है। लेयर 1 फिजिकल वायर के सबसे करीब है, और लेयर 7 उपयोगकर्ता के सबसे करीब है।"},"num":4},{"id":"q5","q":{"en":"How can you remember the OSI layers from bottom to top?","hi":"OSI लेयर्स को नीचे से ऊपर (bottom to top) तक कैसे याद रखा जा सकता है?"},"a":{"en":"'Please Do Not Throw Sausage Pizza Away' → Physical, Data Link, Network, Transport, Session, Presentation, Application","hi":"'प्लीज डू नॉट थ्रो सॉसेज पिज्जा अवे' (Please Do Not Throw Sausage Pizza Away) → फिजिकल, डेटा लिंक, नेटवर्क, ट्रांसपोर्ट, सेशन, प्रेजेंटेशन, एप्लीकेशन"},"o":[{"en":"'All People Seem To Need Data Processing'","hi":"'ऑल पीपल सीम टू नीड डेटा प्रोसेसिंग'"},{"en":"'Please Do Not Throw Sausage Pizza Away' → Physical, Data Link, Network, Transport, Session, Presentation, Application","hi":"'प्लीज डू नॉट थ्रो सॉसेज पिज्जा अवे' (Please Do Not Throw Sausage Pizza Away) → फिजिकल, डेटा लिंक, नेटवर्क, ट्रांसपोर्ट, सेशन, प्रेजेंटेशन, एप्लीकेशन"},{"en":"'Every Good Boy Does Fine'","hi":"'एवरी गुड बॉय डज़ फाइन'"},{"en":"'My Very Educated Mother Just Served Us Noodles'","hi":"'माय वेरी एजुकेटेड मदर जस्ट सर्व्ड अस नूडल्स'"}],"exp":{"en":"This is a common mnemonic device used to recall the layers in L1 to L7 order.\nSource-note (Hinglish): “Please Do Not Throw Sausage Pizza Away” → Physical, Data Link, Network, Transport, Session, Presentation, Application.","hi":"यह L1 से L7 क्रम में परतों को याद करने के लिए उपयोग किया जाने वाला एक सामान्य स्मरणीय उपकरण (mnemonic device) है।"},"num":5},{"id":"q6","q":{"en":"How can you remember the OSI layers from top to bottom?","hi":"OSI लेयर्स को ऊपर से नीचे (top to bottom) तक कैसे याद रखा जा सकता है?"},"a":{"en":"'All People Seem To Need Data Processing' → Application, Presentation, Session, Transport, Network, Data Link, Physical","hi":"'ऑल पीपल सीम टू नीड डेटा प्रोसेसिंग' (All People Seem To Need Data Processing) → एप्लीकेशन, प्रेजेंटेशन, सेशन, ट्रांसपोर्ट, नेटवर्क, डेटा लिंक, फिजिकल"},"o":[{"en":"'Please Do Not Throw Sausage Pizza Away'","hi":"'Please Do Not Throw Sausage Pizza Away'"},{"en":"'All People Seem To Need Data Processing' → Application, Presentation, Session, Transport, Network, Data Link, Physical","hi":"'ऑल पीपल सीम टू नीड डेटा प्रोसेसिंग' (All People Seem To Need Data Processing) → एप्लीकेशन, प्रेजेंटेशन, सेशन, ट्रांसपोर्ट, नेटवर्क, डेटा लिंक, फिजिकल"},{"en":"'Some People Catch Fish'","hi":"'सम पीपल कैच फिश'"},{"en":"'Never Eat Shredded Wheat'","hi":"'नेवर ईट श्रेडेड व्हीट'"}],"exp":{"en":"This mnemonic helps remember the layers in L7 to L1 order.\nSource-note (Hinglish): “All People Seem To Need Data Processing” → Application, Presentation, Session, Transport, Network, Data Link, Physical.","hi":"यह L7 से L1 क्रम में परतों को याद रखने में मदद करता है।"},"num":6},{"id":"q7","q":{"en":"What is the exam grouping of the upper and lower OSI layers?","hi":"ऊपरी (upper) और निचली (lower) OSI लेयर्स की परीक्षा समूह (exam grouping) क्या है?"},"a":{"en":"L4–L7 are the upper or host layers. L1–L3 are the lower or media layers. Notes also refer to these as software/hardware groupings. Real implementations can use both hardware and software","hi":"L4-L7 ऊपरी (upper) या होस्ट लेयर हैं। L1-L3 निचली (lower) या मीडिया लेयर हैं। नोट्स इन्हें सॉफ्टवेयर/हार्डवेयर ग्रुपिंग भी कहते हैं। वास्तविक कार्यान्वयन (Real implementations) हार्डवेयर और सॉफ्टवेयर दोनों का उपयोग कर सकते हैं"},"o":[{"en":"L1-L2 are upper, L3-L7 are lower","hi":"L1-L2 ऊपरी हैं, L3-L7 निचली हैं"},{"en":"L4–L7 are the upper or host layers. L1–L3 are the lower or media layers. Notes also refer to these as software/hardware groupings. Real implementations can use both hardware and software","hi":"L4-L7 ऊपरी (upper) या होस्ट लेयर हैं। L1-L3 निचली (lower) या मीडिया लेयर हैं। नोट्स इन्हें सॉफ्टवेयर/हार्डवेयर ग्रुपिंग भी कहते हैं। वास्तविक कार्यान्वयन (Real implementations) हार्डवेयर और सॉफ्टवेयर दोनों का उपयोग कर सकते हैं"},{"en":"All layers are the same","hi":"सभी लेयर समान हैं"},{"en":"Only L7 is upper","hi":"केवल L7 ऊपरी है"}],"exp":{"en":"Lower layers deal with the physical routing of data across the network, while upper layers deal with applications and data formatting on the end hosts.\nSource-note (Hinglish): L4–L7 upper ya host layers. L1–L3 lower ya media layers. Notes inhe software/hardware grouping bhi kehte hain. Real implementations hardware aur software dono use kar sakti hain.","hi":"निचली परतें (Lower layers) नेटवर्क पर डेटा के भौतिक मार्ग (physical routing) से निपटती हैं, जबकि ऊपरी परतें (upper layers) एंड होस्ट पर एप्लिकेशन और डेटा फ़ॉर्मेटिंग से निपटती हैं।"},"num":7},{"id":"q8","q":{"en":"What is a practical benefit of layering?","hi":"लेयरिंग (layering) का व्यावहारिक लाभ क्या है?"},"a":{"en":"Networking tasks are divided into manageable parts. Each layer uses the service of the layer below it and provides service to the layer above it. If interfaces are stable, implementations can change independently","hi":"नेटवर्किंग कार्यों (Networking tasks) को प्रबंधनीय भागों (manageable parts) में विभाजित किया जाता है। प्रत्येक परत अपने से नीचे की परत की सेवा (service) का उपयोग करती है और अपने से ऊपर की परत को सेवा प्रदान करती है। यदि इंटरफेस स्थिर (stable) हैं, तो कार्यान्वयन स्वतंत्र रूप से बदल सकते हैं"},"o":[{"en":"It makes the network slower","hi":"यह नेटवर्क को धीमा कर देता है"},{"en":"Networking tasks are divided into manageable parts. Each layer uses the service of the layer below it and provides service to the layer above it. If interfaces are stable, implementations can change independently","hi":"नेटवर्किंग कार्यों (Networking tasks) को प्रबंधनीय भागों (manageable parts) में विभाजित किया जाता है। प्रत्येक परत अपने से नीचे की परत की सेवा (service) का उपयोग करती है और अपने से ऊपर की परत को सेवा प्रदान करती है। यदि इंटरफेस स्थिर (stable) हैं, तो कार्यान्वयन स्वतंत्र रूप से बदल सकते हैं"},{"en":"It combines all functions into one big program","hi":"यह सभी कार्यों को एक बड़े प्रोग्राम में जोड़ता है"},{"en":"It only allows one computer to connect at a time","hi":"यह एक बार में केवल एक कंप्यूटर को कनेक्ट करने की अनुमति देता है"}],"exp":{"en":"Layering allows for modular design. For example, you can upgrade a physical network cable (L1) without rewriting your web browser (L7).\nSource-note (Hinglish): Networking tasks manageable parts mein divide hote hain. Har layer neeche ki layer ki service leti hai aur upar ki layer ko service deti hai. Interfaces stable hon to implementation independently change ho sakti hai.","hi":"लेयरिंग मॉड्यूलर डिज़ाइन (modular design) की अनुमति देता है। उदाहरण के लिए, आप अपने वेब ब्राउज़र (L7) को फिर से लिखे बिना एक भौतिक नेटवर्क केबल (L1) को अपग्रेड कर सकते हैं।"},"num":8},{"id":"q9","q":{"en":"What is the order of the PDU (Protocol Data Unit) from sender to receiver?","hi":"प्रेषक (sender) से रिसीवर (receiver) तक PDU (Protocol Data Unit) का क्रम क्या है?"},"a":{"en":"At the sender: Data → TCP segment/UDP datagram → packet → frame → bits. The reverse order applies at the receiver. PDU stands for Protocol Data Unit","hi":"प्रेषक (sender) पर: डेटा (Data) → TCP सेगमेंट/UDP डेटाग्राम → पैकेट (packet) → फ्रेम (frame) → बिट्स (bits)। रिसीवर पर उल्टा क्रम लागू होता है। PDU का मतलब प्रोटोकॉल डेटा यूनिट (Protocol Data Unit) है"},"o":[{"en":"Bits → Frame → Packet → Segment → Data","hi":"बिट्स → फ्रेम → पैकेट → सेगमेंट → डेटा"},{"en":"At the sender: Data → TCP segment/UDP datagram → packet → frame → bits. The reverse order applies at the receiver. PDU stands for Protocol Data Unit","hi":"प्रेषक (sender) पर: डेटा (Data) → TCP सेगमेंट/UDP डेटाग्राम → पैकेट (packet) → फ्रेम (frame) → बिट्स (bits)। रिसीवर पर उल्टा क्रम लागू होता है। PDU का मतलब प्रोटोकॉल डेटा यूनिट (Protocol Data Unit) है"},{"en":"Packet → Bits → Data","hi":"पैकेट → बिट्स → डेटा"},{"en":"Segment → Data → Frame","hi":"सेगमेंट → डेटा → फ्रेम"}],"exp":{"en":"As data moves down the OSI stack on the sender side, it is encapsulated into different PDUs at each layer.\nSource-note (Hinglish): Sender mein Data → TCP segment/UDP datagram → packet → frame → bits. Receiver par reverse order. PDU ka full form Protocol Data Unit hai.","hi":"चूंकि डेटा प्रेषक की ओर OSI स्टैक के नीचे ले जाया जाता है, इसे प्रत्येक परत पर विभिन्न PDU में एन्कैप्सुलेट (encapsulated) किया जाता है।"},"num":9},{"id":"q10","q":{"en":"What are encapsulation and decapsulation?","hi":"एनकैप्सुलेशन (encapsulation) और डिकैप्सुलेशन (decapsulation) क्या हैं?"},"a":{"en":"At the sender, layers add headers (and in some cases, a trailer). At the receiver, each layer processes its control information and passes the payload to the next upper layer","hi":"प्रेषक (sender) पर, लेयर्स हेडर (और कुछ मामलों में, एक ट्रेलर) जोड़ते हैं। रिसीवर पर, प्रत्येक परत अपनी नियंत्रण जानकारी (control information) को प्रोसेस करती है और पेलोड (payload) को अगली ऊपरी परत (upper layer) पर भेजती है"},"o":[{"en":"Creating and deleting files","hi":"फ़ाइलें बनाना और हटाना"},{"en":"At the sender, layers add headers (and in some cases, a trailer). At the receiver, each layer processes its control information and passes the payload to the next upper layer","hi":"प्रेषक (sender) पर, लेयर्स हेडर (और कुछ मामलों में, एक ट्रेलर) जोड़ते हैं। रिसीवर पर, प्रत्येक परत अपनी नियंत्रण जानकारी (control information) को प्रोसेस करती है और पेलोड (payload) को अगली ऊपरी परत (upper layer) पर भेजती है"},{"en":"Encrypting and decrypting data","hi":"डेटा को एन्क्रिप्ट और डिक्रिप्ट करना"},{"en":"Turning the computer on and off","hi":"कंप्यूटर को चालू और बंद करना"}],"exp":{"en":"Encapsulation is like putting a letter in an envelope, then putting that envelope in a box. Decapsulation is the process of opening the box and then the envelope.\nSource-note (Hinglish): Sender par layers headers aur kuch cases mein trailer add karti hain. Receiver par har layer apni control information process karke payload next upper layer ko deti hai.","hi":"एनकैप्सुलेशन एक पत्र को एक लिफाफे में रखने और फिर उस लिफाफे को एक बॉक्स में रखने जैसा है। डिकैप्सुलेशन बॉक्स और फिर लिफाफा खोलने की प्रक्रिया है।"},"num":10}]},{"title":{"en":"2. Physical Layer — Bits, Signals & Media","hi":"2. फिजिकल लेयर — बिट्स, सिग्नल और माध्यम"},"questions":[{"id":"q11","q":{"en":"What is the main function of the Physical Layer?","hi":"फिजिकल लेयर (Physical Layer) का मुख्य कार्य क्या है?"},"a":{"en":"L1 transmits raw bits over a communication channel between connected devices using electrical, optical, or radio signals. The receiver recovers the bit stream from the signal, and L2 handles the framing","hi":"L1 कनेक्टेड डिवाइसों के बीच इलेक्ट्रिकल, ऑप्टिकल या रेडियो सिग्नल का उपयोग करके संचार चैनल (communication channel) पर रॉ बिट्स (raw bits) को प्रसारित (transmits) करता है। रिसीवर सिग्नल से बिट स्ट्रीम को पुनर्प्राप्त (recovers) करता है, और L2 फ़्रेमिंग को संभालता है"},"o":[{"en":"To route packets","hi":"पैकेट रूट (route) करना"},{"en":"L1 transmits raw bits over a communication channel between connected devices using electrical, optical, or radio signals. The receiver recovers the bit stream from the signal, and L2 handles the framing","hi":"L1 कनेक्टेड डिवाइसों के बीच इलेक्ट्रिकल, ऑप्टिकल या रेडियो सिग्नल का उपयोग करके संचार चैनल (communication channel) पर रॉ बिट्स (raw bits) को प्रसारित (transmits) करता है। रिसीवर सिग्नल से बिट स्ट्रीम को पुनर्प्राप्त (recovers) करता है, और L2 फ़्रेमिंग को संभालता है"},{"en":"To encrypt passwords","hi":"पासवर्ड को एन्क्रिप्ट करना"},{"en":"To display images","hi":"चित्र प्रदर्शित करना"}],"exp":{"en":"Layer 1 is entirely concerned with the physical transmission of the 1s and 0s over the cable or wireless medium.\nSource-note (Hinglish): L1 connected devices ke beech raw bits ko electrical, optical ya radio signals se bhejti hai. Receiver signal se bit stream recover karta hai aur L2 framing handle karti hai.","hi":"लेयर 1 पूरी तरह से केबल या वायरलेस माध्यम पर 1s और 0s के भौतिक संचरण (physical transmission) से संबंधित है।"},"num":11},{"id":"q12","q":{"en":"What is the PDU of the Physical Layer?","hi":"फिजिकल लेयर का PDU क्या है?"},"a":{"en":"Bits (0 and 1)","hi":"बिट्स (0 और 1)"},"o":[{"en":"Packet","hi":"पैकेट"},{"en":"Bits (0 and 1)","hi":"बिट्स (0 और 1)"},{"en":"Frame","hi":"फ्रेम"},{"en":"Segment","hi":"सेगमेंट"}],"exp":{"en":"At this lowest layer, data is just a stream of individual bits.\nSource-note (Hinglish): Bits (0 aur 1).","hi":"इस सबसे निचली परत पर, डेटा केवल व्यक्तिगत बिट्स (individual bits) की एक स्ट्रीम है।"},"num":12},{"id":"q13","q":{"en":"What is bit synchronization?","hi":"बिट सिंक्रोनाइज़ेशन (Bit synchronization) क्या है?"},"a":{"en":"Aligning the timing so the receiver samples incoming bits at the correct boundaries. The timing can be recovered from a clock or the signal itself","hi":"समय (timing) को संरेखित (align) करना ताकि रिसीवर सही सीमाओं (boundaries) पर आने वाले बिट्स का नमूना (samples) ले सके। समय (timing) एक घड़ी या स्वयं संकेत (signal) से पुनर्प्राप्त की जा सकती है"},"o":[{"en":"Making bits identical","hi":"बिट्स को समान बनाना"},{"en":"Aligning the timing so the receiver samples incoming bits at the correct boundaries. The timing can be recovered from a clock or the signal itself","hi":"समय (timing) को संरेखित (align) करना ताकि रिसीवर सही सीमाओं (boundaries) पर आने वाले बिट्स का नमूना (samples) ले सके। समय (timing) एक घड़ी या स्वयं संकेत (signal) से पुनर्प्राप्त की जा सकती है"},{"en":"Deleting old bits","hi":"पुराने बिट्स हटाना"},{"en":"Compressing bits","hi":"बिट्स को संपीड़ित (Compressing) करना"}],"exp":{"en":"Synchronization ensures the receiver reads the signal exactly when a bit is being transmitted, preventing read errors.\nSource-note (Hinglish): Timing align karna taaki receiver sahi boundaries par incoming bits sample kare. Timing clock ya signal se recover ho sakti hai.","hi":"सिंक्रोनाइज़ेशन यह सुनिश्चित करता है कि रिसीवर सिग्नल को ठीक उसी समय पढ़ता है जब एक बिट प्रसारित किया जा रहा हो, जिससे रीड एरर (read errors) को रोका जा सके।"},"num":13},{"id":"q14","q":{"en":"What does bit rate control define?","hi":"बिट रेट कंट्रोल (Bit rate control) क्या परिभाषित करता है?"},"a":{"en":"The number of bits transmitted per second, i.e., bits per second (bps)","hi":"प्रति सेकंड प्रसारित होने वाले बिट्स की संख्या, यानी बिट्स प्रति सेकंड (bps)"},"o":[{"en":"The cost of the network","hi":"नेटवर्क की लागत"},{"en":"The number of bits transmitted per second, i.e., bits per second (bps)","hi":"प्रति सेकंड प्रसारित होने वाले बिट्स की संख्या, यानी बिट्स प्रति सेकंड (bps)"},{"en":"The size of the hard drive","hi":"हार्ड ड्राइव का आकार"},{"en":"The voltage of the signal","hi":"सिग्नल का वोल्टेज"}],"exp":{"en":"This is the fundamental measure of transmission speed on a physical link.\nSource-note (Hinglish): Per second transmit hone wale bits, yani bits per second (bps).","hi":"यह भौतिक लिंक पर संचरण गति (transmission speed) का मूल माप है।"},"num":14},{"id":"q15","q":{"en":"What does physical topology mean?","hi":"फिजिकल टोपोलॉजी (Physical topology) का क्या मतलब है?"},"a":{"en":"The physical arrangement of nodes and links. Bus, star, and mesh are common examples","hi":"नोड्स और लिंक की भौतिक व्यवस्था (physical arrangement)। बस, स्टार और मेश सामान्य उदाहरण हैं"},"o":[{"en":"The software layout","hi":"सॉफ्टवेयर लेआउट"},{"en":"The physical arrangement of nodes and links. Bus, star, and mesh are common examples","hi":"नोड्स और लिंक की भौतिक व्यवस्था (physical arrangement)। बस, स्टार और मेश सामान्य उदाहरण हैं"},{"en":"The logical IP addresses","hi":"तार्किक आईपी पते"},{"en":"The shape of the computer","hi":"कंप्यूटर का आकार"}],"exp":{"en":"Topology describes how the devices are physically wired or connected together.\nSource-note (Hinglish): Nodes aur links ka physical arrangement. Bus, star aur mesh common examples hain.","hi":"टोपोलॉजी वर्णन करती है कि उपकरणों को भौतिक रूप से कैसे तार (wired) या एक साथ जोड़ा गया है।"},"num":15},{"id":"q16","q":{"en":"What are simplex, half-duplex, and full-duplex?","hi":"सिम्प्लेक्स (simplex), हाफ-डुप्लेक्स (half-duplex) और फुल-डुप्लेक्स (full-duplex) क्या हैं?"},"a":{"en":"Simplex → one direction. Half-duplex → both directions, one at a time. Full-duplex → both directions simultaneously","hi":"सिम्प्लेक्स → एक दिशा (one direction)। हाफ-डुप्लेक्स → दोनों दिशाएँ, एक समय में एक (one at a time)। फुल-डुप्लेक्स → दोनों दिशाएँ एक साथ (simultaneously)"},"o":[{"en":"Types of cables","hi":"केबलों के प्रकार"},{"en":"Simplex → one direction. Half-duplex → both directions, one at a time. Full-duplex → both directions simultaneously","hi":"सिम्प्लेक्स → एक दिशा (one direction)। हाफ-डुप्लेक्स → दोनों दिशाएँ, एक समय में एक (one at a time)। फुल-डुप्लेक्स → दोनों दिशाएँ एक साथ (simultaneously)"},{"en":"Operating systems","hi":"ऑपरेटिंग सिस्टम"},{"en":"Network topologies","hi":"नेटवर्क टोपोलॉजी"}],"exp":{"en":"These modes define the direction and timing of data flow between two devices.\nSource-note (Hinglish): Simplex → ek direction. Half-duplex → dono directions, ek waqt mein ek. Full-duplex → dono directions ek saath.","hi":"ये मोड दो उपकरणों के बीच डेटा प्रवाह की दिशा और समय (direction and timing) को परिभाषित करते हैं।"},"num":16},{"id":"q17","q":{"en":"What are common device and media examples of the Physical Layer?","hi":"फिजिकल लेयर (Physical Layer) के सामान्य डिवाइस और मीडिया उदाहरण क्या हैं?"},"a":{"en":"Hub, repeater, and modem are typical L1 examples. Twisted-pair, coaxial, and optical fibre are transmission media","hi":"हब (Hub), रिपीटर (repeater) और मॉडेम विशिष्ट L1 उदाहरण हैं। ट्विस्टेड-पेयर, समाक्षीय (coaxial) और ऑप्टिकल फाइबर ट्रांसमिशन मीडिया हैं"},"o":[{"en":"Router and switch","hi":"राउटर और स्विच"},{"en":"Hub, repeater, and modem are typical L1 examples. Twisted-pair, coaxial, and optical fibre are transmission media","hi":"हब (Hub), रिपीटर (repeater) और मॉडेम विशिष्ट L1 उदाहरण हैं। ट्विस्टेड-पेयर, समाक्षीय (coaxial) और ऑप्टिकल फाइबर ट्रांसमिशन मीडिया हैं"},{"en":"Browser and email","hi":"ब्राउज़र और ईमेल"},{"en":"CPU and RAM","hi":"सीपीयू और रैम"}],"exp":{"en":"These devices and media operate purely on electrical or optical signals, without reading MAC or IP addresses.\nSource-note (Hinglish): Hub, repeater aur modem typical L1 examples hain. Twisted-pair, coaxial aur optical fibre transmission media hain.","hi":"ये उपकरण और मीडिया विशुद्ध रूप से विद्युत या ऑप्टिकल सिग्नल पर काम करते हैं, बिना मैक (MAC) या आईपी (IP) पते पढ़े।"},"num":17}]},{"title":{"en":"3. Data Link Layer — Frames, MAC & Local Delivery","hi":"3. डेटा लिंक लेयर — फ्रेम, MAC और स्थानीय डिलीवरी"},"questions":[{"id":"q18","q":{"en":"What is the delivery scope and PDU of the Data Link Layer?","hi":"डेटा लिंक लेयर (Data Link Layer) का डिलीवरी स्कोप (delivery scope) और PDU क्या है?"},"a":{"en":"L2 performs node-to-node delivery on a local link. The data unit is a frame","hi":"L2 एक स्थानीय लिंक (local link) पर नोड-टू-नोड (node-to-node) डिलीवरी करता है। डेटा यूनिट 'फ्रेम' (frame) है"},"o":[{"en":"Global delivery, Packet","hi":"ग्लोबल डिलीवरी, पैकेट"},{"en":"L2 performs node-to-node delivery on a local link. The data unit is a frame","hi":"L2 एक स्थानीय लिंक (local link) पर नोड-टू-नोड (node-to-node) डिलीवरी करता है। डेटा यूनिट 'फ्रेम' (frame) है"},{"en":"Process-to-process, Segment","hi":"प्रोसेस-टू-प्रोसेस, सेगमेंट"},{"en":"End-to-end, Data","hi":"एंड-टू-एंड, डेटा"}],"exp":{"en":"Layer 2 only cares about getting data to the next directly connected device on the same network segment.\nSource-note (Hinglish): L2 ek local link par node-to-node delivery karti hai. Data unit frame hai.","hi":"लेयर 2 केवल उसी नेटवर्क सेगमेंट पर अगले सीधे कनेक्टेड डिवाइस तक डेटा पहुंचाने की परवाह करता है।"},"num":18},{"id":"q19","q":{"en":"What are the five main functions of L2?","hi":"L2 के पांच मुख्य कार्य क्या हैं?"},"a":{"en":"Framing, physical/MAC addressing, error control, flow control, and shared medium access control","hi":"फ्रेमिंग (Framing), भौतिक/मैक एड्रेसिंग (physical/MAC addressing), त्रुटि नियंत्रण (error control), प्रवाह नियंत्रण (flow control) और साझा माध्यम पहुँच नियंत्रण (shared medium access control)"},"o":[{"en":"Routing, switching, browsing, printing, saving","hi":"रूटिंग, स्विचिंग, ब्राउजिंग, प्रिंटिंग, सेविंग"},{"en":"Framing, physical/MAC addressing, error control, flow control, and shared medium access control","hi":"फ्रेमिंग (Framing), भौतिक/मैक एड्रेसिंग (physical/MAC addressing), त्रुटि नियंत्रण (error control), प्रवाह नियंत्रण (flow control) और साझा माध्यम पहुँच नियंत्रण (shared medium access control)"},{"en":"Encryption, decryption, compression, formatting, translation","hi":"एन्क्रिप्शन, डिक्रिप्शन, कम्प्रेशन, फॉर्मेटिंग, अनुवाद"},{"en":"IP addressing, routing, forwarding, fragmentation, TTL","hi":"आईपी एड्रेसिंग, रूटिंग, फॉरवर्डिंग, विखंडन (fragmentation), टीटीएल (TTL)"}],"exp":{"en":"These functions ensure reliable data transfer across a single physical link.\nSource-note (Hinglish): Framing, physical/MAC addressing, error control, flow control aur shared medium access control.","hi":"ये फ़ंक्शन एकल भौतिक लिंक (single physical link) पर विश्वसनीय डेटा स्थानांतरण (data transfer) सुनिश्चित करते हैं।"},"num":19},{"id":"q20","q":{"en":"How does framing occur?","hi":"फ्रेमिंग (Framing) कैसे होती है?"},"a":{"en":"L2 carries the packet in a frame. Depending on the link standard, the header may contain addressing and the trailer an error-check field","hi":"L2 पैकेट को एक फ्रेम में ले जाता है। लिंक मानक (link standard) के आधार पर, हेडर में एड्रेसिंग हो सकती है और ट्रेलर में एक त्रुटि-जांच (error-check) फ़ील्ड हो सकती है"},"o":[{"en":"By painting a picture","hi":"एक चित्र बनाकर"},{"en":"L2 carries the packet in a frame. Depending on the link standard, the header may contain addressing and the trailer an error-check field","hi":"L2 पैकेट को एक फ्रेम में ले जाता है। लिंक मानक (link standard) के आधार पर, हेडर में एड्रेसिंग हो सकती है और ट्रेलर में एक त्रुटि-जांच (error-check) फ़ील्ड हो सकती है"},{"en":"By compressing the data","hi":"डेटा को संपीड़ित (compressing) करके"},{"en":"By converting data to audio","hi":"डेटा को ऑडियो में परिवर्तित करके"}],"exp":{"en":"Framing defines the beginning and end of a transmission unit on the local network.\nSource-note (Hinglish): L2 packet ko frame mein carry karti hai. Link standard ke hisaab se header mein addressing aur trailer mein error-check field ho sakti hai.","hi":"फ्रेमिंग स्थानीय नेटवर्क पर एक ट्रांसमिशन इकाई की शुरुआत और अंत को परिभाषित करती है।"},"num":20},{"id":"q21","q":{"en":"What is the role of source and destination MAC addresses in a frame?","hi":"फ्रेम में स्रोत (source) और गंतव्य (destination) मैक एड्रेस की क्या भूमिका है?"},"a":{"en":"In an Ethernet frame, they identify the sender and intended receiver on the local link. In routed traffic, the destination MAC is usually that of the next hop","hi":"एक ईथरनेट फ्रेम में, वे स्थानीय लिंक (local link) पर प्रेषक (sender) और इच्छित प्राप्तकर्ता (intended receiver) की पहचान करते हैं। रूट किए गए ट्रैफ़िक में, गंतव्य मैक (destination MAC) आमतौर पर अगले हॉप (next hop) का होता है"},"o":[{"en":"They identify websites","hi":"वे वेबसाइटों की पहचान करते हैं"},{"en":"In an Ethernet frame, they identify the sender and intended receiver on the local link. In routed traffic, the destination MAC is usually that of the next hop","hi":"एक ईथरनेट फ्रेम में, वे स्थानीय लिंक (local link) पर प्रेषक (sender) और इच्छित प्राप्तकर्ता (intended receiver) की पहचान करते हैं। रूट किए गए ट्रैफ़िक में, गंतव्य मैक (destination MAC) आमतौर पर अगले हॉप (next hop) का होता है"},{"en":"They encrypt the payload","hi":"वे पेलोड को एन्क्रिप्ट करते हैं"},{"en":"They determine the physical location","hi":"वे भौतिक स्थान (physical location) निर्धारित करते हैं"}],"exp":{"en":"MAC addresses are used for local delivery within a single network segment (LAN).\nSource-note (Hinglish): Ethernet frame mein ye local link par sender aur intended receiver identify karte hain. Routed traffic mein destination MAC aam taur par next hop ka hota hai.","hi":"मैक (MAC) पते का उपयोग एकल नेटवर्क सेगमेंट (LAN) के भीतर स्थानीय डिलीवरी (local delivery) के लिए किया जाता है।"},"num":21},{"id":"q22","q":{"en":"What does the error control of the Data Link Layer do?","hi":"डेटा लिंक लेयर का त्रुटि नियंत्रण (error control) क्या करता है?"},"a":{"en":"It detects frame errors. Some link protocols also retransmit lost or damaged frames. Ethernet detects errors via FCS and discards invalid frames","hi":"यह फ्रेम त्रुटियों (frame errors) का पता लगाता है। कुछ लिंक प्रोटोकॉल खोए या क्षतिग्रस्त फ्रेम को फिर से प्रसारित (retransmit) भी करते हैं। इथरनेट (Ethernet) FCS के माध्यम से त्रुटियों का पता लगाता है और अमान्य फ्रेम को छोड़ (discard) देता है"},"o":[{"en":"It fixes hardware problems","hi":"यह हार्डवेयर समस्याओं को ठीक करता है"},{"en":"It detects frame errors. Some link protocols also retransmit lost or damaged frames. Ethernet detects errors via FCS and discards invalid frames","hi":"यह फ्रेम त्रुटियों (frame errors) का पता लगाता है। कुछ लिंक प्रोटोकॉल खोए या क्षतिग्रस्त फ्रेम को फिर से प्रसारित (retransmit) भी करते हैं। इथरनेट (Ethernet) FCS के माध्यम से त्रुटियों का पता लगाता है और अमान्य फ्रेम को छोड़ (discard) देता है"},{"en":"It translates languages","hi":"यह भाषाओं का अनुवाद करता है"},{"en":"It manages passwords","hi":"यह पासवर्ड प्रबंधित करता है"}],"exp":{"en":"The Frame Check Sequence (FCS) in the trailer is a mathematical checksum used to verify data integrity over the link.\nSource-note (Hinglish): Frame errors detect karta hai. Kuch link protocols lost ya damaged frames retransmit bhi karte hain. Ethernet FCS se error detect karta hai aur invalid frame discard karta hai.","hi":"ट्रेलर (trailer) में फ्रेम चेक अनुक्रम (Frame Check Sequence - FCS) एक गणितीय चेकसम (mathematical checksum) है जिसका उपयोग लिंक पर डेटा अखंडता (integrity) को सत्यापित करने के लिए किया जाता है।"},"num":22},{"id":"q23","q":{"en":"What does the flow control of the Data Link Layer do?","hi":"डेटा लिंक लेयर का प्रवाह नियंत्रण (flow control) क्या करता है?"},"a":{"en":"It regulates the sender's speed or outstanding data on the link so that the receiver is not overloaded. The mechanism depends on the protocol","hi":"यह लिंक पर प्रेषक (sender) की गति या बकाया डेटा (outstanding data) को नियंत्रित करता है ताकि रिसीवर ओवरलोड (overloaded) न हो। तंत्र (mechanism) प्रोटोकॉल पर निर्भर करता है"},"o":[{"en":"It manages the power supply","hi":"यह बिजली आपूर्ति (power supply) का प्रबंधन करता है"},{"en":"It regulates the sender's speed or outstanding data on the link so that the receiver is not overloaded. The mechanism depends on the protocol","hi":"यह लिंक पर प्रेषक (sender) की गति या बकाया डेटा (outstanding data) को नियंत्रित करता है ताकि रिसीवर ओवरलोड (overloaded) न हो। तंत्र (mechanism) प्रोटोकॉल पर निर्भर करता है"},{"en":"It stops network traffic entirely","hi":"यह नेटवर्क ट्रैफ़िक को पूरी तरह से रोक देता है"},{"en":"It compresses files","hi":"यह फ़ाइलों को संपीड़ित (compresses) करता है"}],"exp":{"en":"Flow control prevents a fast sender from overwhelming a slow receiver.\nSource-note (Hinglish): Link par sender ki speed ya outstanding data ko regulate karta hai, taaki receiver overload na ho. Mechanism protocol par depend karta hai.","hi":"प्रवाह नियंत्रण एक तेज प्रेषक को एक धीमे रिसीवर को भारी (overwhelming) करने से रोकता है।"},"num":23},{"id":"q24","q":{"en":"What are the full forms and roles of the LLC and MAC sublayers?","hi":"LLC और MAC सबलेयर्स के पूर्ण रूप और भूमिकाएँ क्या हैं?"},"a":{"en":"LLC = Logical Link Control, interfaces upper-layer protocols with link services. MAC = Media Access Control, handles addressing and shared medium access","hi":"LLC = लॉजिकल लिंक कंट्रोल (Logical Link Control), ऊपरी-परत प्रोटोकॉल को लिंक सेवाओं के साथ इंटरफेस करता है। MAC = मीडिया एक्सेस कंट्रोल (Media Access Control), एड्रेसिंग और साझा माध्यम (shared medium) एक्सेस को संभालता है"},"o":[{"en":"Local Logic Control; Media Address Component","hi":"लोकल लॉजिक कंट्रोल; मीडिया एड्रेस कंपोनेंट"},{"en":"LLC = Logical Link Control, interfaces upper-layer protocols with link services. MAC = Media Access Control, handles addressing and shared medium access","hi":"LLC = लॉजिकल लिंक कंट्रोल (Logical Link Control), ऊपरी-परत प्रोटोकॉल को लिंक सेवाओं के साथ इंटरफेस करता है। MAC = मीडिया एक्सेस कंट्रोल (Media Access Control), एड्रेसिंग और साझा माध्यम (shared medium) एक्सेस को संभालता है"},{"en":"Line Link Connection; Main Access Control","hi":"लाइन लिंक कनेक्शन; मेन एक्सेस कंट्रोल"},{"en":"Low Level Code; Machine Address Control","hi":"लो लेवल कोड; मशीन एड्रेस कंट्रोल"}],"exp":{"en":"IEEE 802 divides Layer 2 into these two sublayers to separate software-based logical control (LLC) from hardware-specific medium access (MAC).\nSource-note (Hinglish): LLC = Logical Link Control, upper-layer protocols ko link services se interface deta hai. MAC = Media Access Control, addressing aur shared medium access handle karta hai.","hi":"IEEE 802 हार्डवेयर-विशिष्ट माध्यम एक्सेस (MAC) से सॉफ्टवेयर-आधारित लॉजिकल कंट्रोल (LLC) को अलग करने के लिए लेयर 2 को इन दो सबलेयर्स में विभाजित करता है।"},"num":24},{"id":"q25","q":{"en":"What is the relation of switch, bridge, and NIC to L2?","hi":"स्विच, ब्रिज और NIC का L2 से क्या संबंध है?"},"a":{"en":"A Layer-2 switch and bridge forward frames based on MAC addresses. The NIC (Network Interface Card) and its driver help with the host's link-layer work. The NIC may also implement physical signaling","hi":"एक लेयर-2 स्विच और ब्रिज मैक एड्रेस (MAC addresses) के आधार पर फ्रेम (frames) को आगे (forward) भेजते हैं। NIC (नेटवर्क इंटरफ़ेस कार्ड) और उसका ड्राइवर होस्ट के लिंक-लेयर कार्य में मदद करते हैं। NIC भौतिक सिग्नलिंग (physical signaling) भी लागू कर सकता है"},"o":[{"en":"They operate at Layer 4","hi":"वे लेयर 4 पर काम करते हैं"},{"en":"A Layer-2 switch and bridge forward frames based on MAC addresses. The NIC (Network Interface Card) and its driver help with the host's link-layer work. The NIC may also implement physical signaling","hi":"एक लेयर-2 स्विच और ब्रिज मैक एड्रेस (MAC addresses) के आधार पर फ्रेम (frames) को आगे (forward) भेजते हैं। NIC (नेटवर्क इंटरफ़ेस कार्ड) और उसका ड्राइवर होस्ट के लिंक-लेयर कार्य में मदद करते हैं। NIC भौतिक सिग्नलिंग (physical signaling) भी लागू कर सकता है"},{"en":"They are software programs only","hi":"वे केवल सॉफ्टवेयर प्रोग्राम हैं"},{"en":"They are used for routing IP packets","hi":"उनका उपयोग IP पैकेट को रूट करने के लिए किया जाता है"}],"exp":{"en":"Switches and bridges are the primary networking devices that operate at Layer 2, making forwarding decisions based on MAC addresses.\nSource-note (Hinglish): Layer-2 switch aur bridge MAC address se frames forward karte hain. NIC (Network Interface Card) aur driver host ke link-layer work mein help karte hain. NIC physical signaling bhi implement kar sakta hai.","hi":"स्विच और ब्रिज प्राथमिक नेटवर्किंग डिवाइस हैं जो लेयर 2 पर काम करते हैं, मैक (MAC) पते के आधार पर फॉरवर्डिंग निर्णय लेते हैं।"},"num":25}]},{"title":{"en":"4. Network Layer — IP Addressing & Routing","hi":"4. नेटवर्क लेयर — IP एड्रेसिंग और रूटिंग"},"questions":[{"id":"q26","q":{"en":"What is the main purpose and PDU of the Network Layer?","hi":"नेटवर्क लेयर (Network Layer) का मुख्य उद्देश्य और PDU क्या है?"},"a":{"en":"L3 helps forward data from the source host to the destination host through interconnected networks. The typical PDU is a packet","hi":"L3 परस्पर जुड़े नेटवर्कों (interconnected networks) के माध्यम से स्रोत होस्ट (source host) से गंतव्य होस्ट (destination host) तक डेटा को अग्रेषित (forward) करने में मदद करता है। विशिष्ट PDU एक पैकेट (packet) है"},"o":[{"en":"Physical transmission, Bits","hi":"भौतिक संचरण, बिट्स"},{"en":"L3 helps forward data from the source host to the destination host through interconnected networks. The typical PDU is a packet","hi":"L3 परस्पर जुड़े नेटवर्कों (interconnected networks) के माध्यम से स्रोत होस्ट (source host) से गंतव्य होस्ट (destination host) तक डेटा को अग्रेषित (forward) करने में मदद करता है। विशिष्ट PDU एक पैकेट (packet) है"},{"en":"Local delivery, Frame","hi":"स्थानीय वितरण, फ़्रेम"},{"en":"Process delivery, Segment","hi":"प्रोसेस डिलीवरी, सेगमेंट"}],"exp":{"en":"Layer 3 is responsible for getting data across multiple networks, finding a path from the original sender to the final receiver.\nSource-note (Hinglish): L3 data ko interconnected networks ke through source host se destination host tak forward karne mein help karti hai. Typical PDU packet hai.","hi":"लेयर 3 कई नेटवर्क के पार डेटा प्राप्त करने, मूल प्रेषक से अंतिम रिसीवर तक एक रास्ता खोजने के लिए जिम्मेदार है।"},"num":26},{"id":"q27","q":{"en":"How does logical addressing work in the Network Layer?","hi":"नेटवर्क लेयर में लॉजिकल एड्रेसिंग (logical addressing) कैसे काम करती है?"},"a":{"en":"The IP packet header contains the source and destination IP addresses. IPv4 and IPv6 are logical addressing schemes","hi":"आईपी पैकेट हेडर में स्रोत (source) और गंतव्य (destination) आईपी पते होते हैं। IPv4 और IPv6 तार्किक एड्रेसिंग (logical addressing) योजनाएं हैं"},"o":[{"en":"Using MAC addresses","hi":"MAC पते का उपयोग करना"},{"en":"The IP packet header contains the source and destination IP addresses. IPv4 and IPv6 are logical addressing schemes","hi":"आईपी पैकेट हेडर में स्रोत (source) और गंतव्य (destination) आईपी पते होते हैं। IPv4 और IPv6 तार्किक एड्रेसिंग (logical addressing) योजनाएं हैं"},{"en":"Using names like 'google.com'","hi":"'google.com' जैसे नामों का उपयोग करना"},{"en":"Using port numbers","hi":"पोर्ट नंबरों का उपयोग करना"}],"exp":{"en":"Unlike MAC addresses which are burned into hardware, IP addresses are logical and change based on the network the device is connected to.\nSource-note (Hinglish): IP packet header mein source aur destination IP addresses hote hain. IPv4 aur IPv6 logical addressing schemes hain.","hi":"हार्डवेयर में बर्न किए गए MAC पतों के विपरीत, IP पते तार्किक (logical) होते हैं और डिवाइस जिस नेटवर्क से जुड़ा है उसके आधार पर बदलते हैं।"},"num":27},{"id":"q28","q":{"en":"What is the difference between routing and forwarding?","hi":"रूटिंग (routing) और फॉरवर्डिंग (forwarding) में क्या अंतर है?"},"a":{"en":"Routing calculates paths or next hops. Forwarding sends each packet to the matching next hop or output interface","hi":"रूटिंग रास्तों (paths) या अगले हॉप्स (next hops) की गणना करती है। फॉरवर्डिंग प्रत्येक पैकेट को मिलान करने वाले अगले हॉप (matching next hop) या आउटपुट इंटरफ़ेस पर भेजती है"},"o":[{"en":"They are exactly the same","hi":"वे बिल्कुल एक ही हैं"},{"en":"Routing calculates paths or next hops. Forwarding sends each packet to the matching next hop or output interface","hi":"रूटिंग रास्तों (paths) या अगले हॉप्स (next hops) की गणना करती है। फॉरवर्डिंग प्रत्येक पैकेट को मिलान करने वाले अगले हॉप (matching next hop) या आउटपुट इंटरफ़ेस पर भेजती है"},{"en":"Routing is hardware, forwarding is software","hi":"रूटिंग हार्डवेयर है, फॉरवर्डिंग सॉफ्टवेयर है"},{"en":"Routing is for email, forwarding is for websites","hi":"रूटिंग ईमेल के लिए है, फॉरवर्डिंग वेबसाइटों के लिए है"}],"exp":{"en":"Routing is the planning phase (building the map); forwarding is the action phase (moving the packet according to the map).\nSource-note (Hinglish): Routing paths ya next hops calculate karta hai. Forwarding har packet ko matching next hop ya output interface par bhejta hai.","hi":"रूटिंग नियोजन चरण (नक्शा बनाना) है; फॉरवर्डिंग कार्रवाई चरण (नक्शे के अनुसार पैकेट को ले जाना) है।"},"num":28},{"id":"q29","q":{"en":"What might 'shortest path' mean in routing?","hi":"रूटिंग में 'शॉर्टेस्ट पाथ' (shortest path) का क्या मतलब हो सकता है?"},"a":{"en":"The preferred route according to a policy or the lowest-cost based on the protocol's metric. Assuming physical distance as the metric can be incorrect","hi":"नीति (policy) के अनुसार पसंदीदा मार्ग या प्रोटोकॉल के मीट्रिक (metric) के आधार पर न्यूनतम-लागत (lowest-cost)। भौतिक दूरी (physical distance) को मीट्रिक मानना गलत हो सकता है"},"o":[{"en":"The physically shortest cable","hi":"भौतिक रूप से सबसे छोटी केबल"},{"en":"The preferred route according to a policy or the lowest-cost based on the protocol's metric. Assuming physical distance as the metric can be incorrect","hi":"नीति (policy) के अनुसार पसंदीदा मार्ग या प्रोटोकॉल के मीट्रिक (metric) के आधार पर न्यूनतम-लागत (lowest-cost)। भौतिक दूरी (physical distance) को मीट्रिक मानना गलत हो सकता है"},{"en":"The route with the fewest routers","hi":"सबसे कम राउटर वाला मार्ग"},{"en":"The route with the lowest IP addresses","hi":"सबसे कम IP पते वाला मार्ग"}],"exp":{"en":"Routing metrics can be based on bandwidth, delay, reliability, or administrative cost, not just physical distance.\nSource-note (Hinglish): Protocol ke metric par lowest-cost ya policy ke hisaab se preferred route. Physical distance ko metric maan lena galat ho sakta hai.","hi":"रूटिंग मेट्रिक्स (Routing metrics) केवल भौतिक दूरी के बजाय बैंडविड्थ, विलंब (delay), विश्वसनीयता या प्रशासनिक लागत (administrative cost) पर आधारित हो सकते हैं।"},"num":29},{"id":"q30","q":{"en":"What are typical Layer 3 devices?","hi":"विशिष्ट लेयर 3 (Layer 3) डिवाइस कौन से हैं?"},"a":{"en":"Router and Layer-3 switch. A brouter can do both bridging and routing","hi":"राउटर (Router) और लेयर-3 स्विच (Layer-3 switch)। एक ब्राउटर (brouter) ब्रिजिंग और रूटिंग दोनों कर सकता है"},"o":[{"en":"Hub and Repeater","hi":"हब और रिपीटर"},{"en":"Router and Layer-3 switch. A brouter can do both bridging and routing","hi":"राउटर (Router) और लेयर-3 स्विच (Layer-3 switch)। एक ब्राउटर (brouter) ब्रिजिंग और रूटिंग दोनों कर सकता है"},{"en":"Modem and NIC","hi":"मोडेम और NIC"},{"en":"Webcam and Microphone","hi":"वेबकैम और माइक्रोफोन"}],"exp":{"en":"Routers connect different networks together and make path decisions based on IP addresses (Layer 3).\nSource-note (Hinglish): Router aur Layer-3 switch. Brouter bridging aur routing dono kar sakta hai.","hi":"राउटर विभिन्न नेटवर्क को एक साथ जोड़ते हैं और आईपी पते (लेयर 3) के आधार पर पथ (path) निर्णय लेते हैं।"},"num":30},{"id":"q31","q":{"en":"In which scope do the MAC address, IP address, and port number operate?","hi":"मैक एड्रेस (MAC address), आईपी एड्रेस (IP address) और पोर्ट नंबर (port number) किस दायरे (scope) में काम करते हैं?"},"a":{"en":"MAC → interface or next hop on the link. IP → destination on the internetwork. Port → transport endpoint or service within the host","hi":"मैक (MAC) → लिंक पर इंटरफ़ेस या अगला हॉप (next hop)। आईपी (IP) → इंटरनेटवर्क पर गंतव्य (destination)। पोर्ट (Port) → होस्ट के भीतर परिवहन समापन बिंदु (transport endpoint) या सेवा"},"o":[{"en":"All operate on the internetwork","hi":"सभी इंटरनेटवर्क पर काम करते हैं"},{"en":"MAC → interface or next hop on the link. IP → destination on the internetwork. Port → transport endpoint or service within the host","hi":"मैक (MAC) → लिंक पर इंटरफ़ेस या अगला हॉप (next hop)। आईपी (IP) → इंटरनेटवर्क पर गंतव्य (destination)। पोर्ट (Port) → होस्ट के भीतर परिवहन समापन बिंदु (transport endpoint) या सेवा"},{"en":"MAC → host, IP → link, Port → internetwork","hi":"MAC → होस्ट, IP → लिंक, पोर्ट → इंटरनेटवर्क"},{"en":"All are randomly assigned","hi":"सभी बेतरतीब ढंग से (randomly) असाइन किए गए हैं"}],"exp":{"en":"These three addresses are critical: MAC gets data across a single hop (L2), IP gets it to the final computer (L3), and Port gets it to the right application (L4).\nSource-note (Hinglish): MAC → link par interface ya next hop. IP → internetwork par destination. Port → host ke andar transport endpoint ya service.","hi":"ये तीन पते महत्वपूर्ण हैं: MAC एक हॉप (L2) पर डेटा प्राप्त करता है, IP इसे अंतिम कंप्यूटर (L3) पर प्राप्त करता है, और पोर्ट इसे सही एप्लिकेशन (L4) पर प्राप्त करता है।"},"num":31}]},{"title":{"en":"5. Transport Layer — TCP, UDP & Ports","hi":"5. ट्रांसपोर्ट लेयर — TCP, UDP और पोर्ट"},"questions":[{"id":"q32","q":{"en":"What is the number and main role of the Transport Layer?","hi":"ट्रांसपोर्ट लेयर (Transport Layer) का नंबर और मुख्य भूमिका क्या है?"},"a":{"en":"L4. Provides end-to-end, process-to-process communication. It takes service from the Network Layer below and provides transport service to the upper layers","hi":"L4. यह एंड-टू-एंड (end-to-end), प्रोसेस-टू-प्रोसेस (process-to-process) संचार प्रदान करता है। यह नीचे नेटवर्क लेयर से सेवा लेता है और ऊपरी परतों को परिवहन सेवा प्रदान करता है"},"o":[{"en":"L2. Connects cables","hi":"L2. केबल जोड़ता है"},{"en":"L4. Provides end-to-end, process-to-process communication. It takes service from the Network Layer below and provides transport service to the upper layers","hi":"L4. यह एंड-टू-एंड (end-to-end), प्रोसेस-टू-प्रोसेस (process-to-process) संचार प्रदान करता है। यह नीचे नेटवर्क लेयर से सेवा लेता है और ऊपरी परतों को परिवहन सेवा प्रदान करता है"},{"en":"L6. Translates languages","hi":"L6. भाषाओं का अनुवाद करता है"},{"en":"L7. Opens websites","hi":"L7. वेबसाइटें खोलता है"}],"exp":{"en":"Layer 4 ensures that data from an application on the sending host is delivered correctly to the corresponding application on the receiving host.\nSource-note (Hinglish): L4. End-to-end, process-to-process communication provide karti hai. Neeche Network Layer ki service leti hai aur upper layers ko transport service deti hai.","hi":"लेयर 4 यह सुनिश्चित करता है कि प्रेषक होस्ट पर एक एप्लिकेशन से डेटा रिसीवर होस्ट पर संबंधित एप्लिकेशन को सही ढंग से वितरित किया गया है।"},"num":32},{"id":"q33","q":{"en":"Which layer is the exam phrase 'Heart of OSI model' used for?","hi":"परीक्षाओं में उपयोग किया जाने वाला वाक्यांश (phrase) 'OSI मॉडल का हृदय' (Heart of OSI model) किस लेयर के लिए प्रयुक्त होता है?"},"a":{"en":"Transport Layer, L4. This is a memory phrase from the source notes","hi":"ट्रांसपोर्ट लेयर (Transport Layer), L4। यह स्रोत नोट्स से एक मेमोरी वाक्यांश है"},"o":[{"en":"Physical Layer","hi":"फिजिकल लेयर"},{"en":"Transport Layer, L4. This is a memory phrase from the source notes","hi":"ट्रांसपोर्ट लेयर (Transport Layer), L4। यह स्रोत नोट्स से एक मेमोरी वाक्यांश है"},{"en":"Application Layer","hi":"एप्लीकेशन लेयर"},{"en":"Data Link Layer","hi":"डेटा लिंक लेयर"}],"exp":{"en":"It's called the 'heart' because it links the lower media layers (1-3) with the upper host layers (5-7).\nSource-note (Hinglish): Transport Layer, L4. Yeh source notes ka memory phrase hai.","hi":"इसे 'हृदय' कहा जाता है क्योंकि यह निचली मीडिया परतों (1-3) को ऊपरी होस्ट परतों (5-7) के साथ जोड़ता है।"},"num":33},{"id":"q34","q":{"en":"What is the exact name of the Transport PDU?","hi":"ट्रांसपोर्ट PDU (Transport PDU) का सटीक नाम क्या है?"},"a":{"en":"TCP's unit is a segment and UDP's unit is a datagram. The generic OSI exam chart writes 'segment' at L4","hi":"TCP की इकाई 'सेगमेंट' (segment) है और UDP की इकाई 'डेटाग्राम' (datagram) है। जेनेरिक OSI परीक्षा चार्ट L4 पर 'सेगमेंट' (segment) लिखता है"},"o":[{"en":"Packet","hi":"पैकेट"},{"en":"TCP's unit is a segment and UDP's unit is a datagram. The generic OSI exam chart writes 'segment' at L4","hi":"TCP की इकाई 'सेगमेंट' (segment) है और UDP की इकाई 'डेटाग्राम' (datagram) है। जेनेरिक OSI परीक्षा चार्ट L4 पर 'सेगमेंट' (segment) लिखता है"},{"en":"Frame","hi":"फ्रेम"},{"en":"Message","hi":"संदेश"}],"exp":{"en":"While 'segment' is the general term for a Layer 4 PDU, specifically for UDP it is often called a datagram.\nSource-note (Hinglish): TCP ki unit segment hai aur UDP ki unit datagram. Generic OSI exam chart L4 par “segment” likhta hai.","hi":"जबकि 'सेगमेंट' लेयर 4 PDU के लिए सामान्य शब्द है, विशेष रूप से UDP के लिए इसे अक्सर डेटाग्राम (datagram) कहा जाता है।"},"num":34},{"id":"q35","q":{"en":"What do segmentation and reassembly mean?","hi":"विभाजन (segmentation) और पुनः संयोजन (reassembly) का क्या अर्थ है?"},"a":{"en":"The TCP sender sends the byte stream in segments. The receiver uses sequence information to reconstruct the byte stream in the correct order","hi":"TCP प्रेषक (sender) बाइट स्ट्रीम (byte stream) को सेगमेंट में भेजता है। रिसीवर अनुक्रम जानकारी (sequence information) का उपयोग बाइट स्ट्रीम को सही क्रम में पुनर्निर्माण (reconstruct) करने के लिए करता है"},"o":[{"en":"Deleting and restoring files","hi":"फ़ाइलें हटाना और पुनर्स्थापित करना"},{"en":"The TCP sender sends the byte stream in segments. The receiver uses sequence information to reconstruct the byte stream in the correct order","hi":"TCP प्रेषक (sender) बाइट स्ट्रीम (byte stream) को सेगमेंट में भेजता है। रिसीवर अनुक्रम जानकारी (sequence information) का उपयोग बाइट स्ट्रीम को सही क्रम में पुनर्निर्माण (reconstruct) करने के लिए करता है"},{"en":"Splitting an image into pixels","hi":"एक छवि को पिक्सेल में विभाजित करना"},{"en":"Compressing a folder","hi":"किसी फ़ोल्डर को संपीड़ित (Compressing) करना"}],"exp":{"en":"Because lower layers have limits on packet size, L4 breaks large messages into smaller segments and puts them back together at the destination.\nSource-note (Hinglish): TCP sender byte stream ko segments mein bhejta hai. Receiver sequence information se byte stream ko sahi order mein reconstruct karta hai.","hi":"चूंकि निचली परतों की पैकेट के आकार पर सीमाएं होती हैं, L4 बड़े संदेशों को छोटे खंडों (segments) में तोड़ देता है और उन्हें गंतव्य (destination) पर वापस एक साथ रखता है।"},"num":35},{"id":"q36","q":{"en":"What is service point addressing?","hi":"सर्विस पॉइंट एड्रेसिंग (service point addressing) क्या है?"},"a":{"en":"Source and destination ports are in transport headers. The port number helps deliver data to the relevant application endpoint","hi":"स्रोत (Source) और गंतव्य (destination) पोर्ट परिवहन हेडर (transport headers) में होते हैं। पोर्ट नंबर डेटा को प्रासंगिक एप्लिकेशन एंडपॉइंट (relevant application endpoint) तक पहुंचाने में मदद करता है"},"o":[{"en":"Using IP addresses","hi":"आईपी पते का उपयोग करना"},{"en":"Source and destination ports are in transport headers. The port number helps deliver data to the relevant application endpoint","hi":"स्रोत (Source) और गंतव्य (destination) पोर्ट परिवहन हेडर (transport headers) में होते हैं। पोर्ट नंबर डेटा को प्रासंगिक एप्लिकेशन एंडपॉइंट (relevant application endpoint) तक पहुंचाने में मदद करता है"},{"en":"Using MAC addresses","hi":"MAC पते का उपयोग करना"},{"en":"Using email addresses","hi":"ईमेल पते का उपयोग करना"}],"exp":{"en":"A port number (like port 80 for HTTP) identifies the specific process or service running on the host computer.\nSource-note (Hinglish): Source aur destination ports transport headers mein hote hain. Port number data ko relevant application endpoint tak pahunchane mein help karta hai.","hi":"एक पोर्ट नंबर (जैसे HTTP के लिए पोर्ट 80) होस्ट कंप्यूटर पर चल रही विशिष्ट प्रक्रिया या सेवा की पहचान करता है।"},"num":36},{"id":"q37","q":{"en":"How do applications access the Transport Layer?","hi":"एप्लिकेशन ट्रांसपोर्ट लेयर (Transport Layer) तक कैसे पहुँचते हैं?"},"a":{"en":"Typically through the OS's socket API. In the TCP/IP Internet model, the application can use transport services directly","hi":"आमतौर पर ओएस (OS) के सॉकेट एपीआई (socket API) के माध्यम से। TCP/IP इंटरनेट मॉडल में, एप्लिकेशन सीधे परिवहन सेवाओं (transport services) का उपयोग कर सकता है"},"o":[{"en":"Through a physical switch","hi":"एक भौतिक स्विच के माध्यम से"},{"en":"Typically through the OS's socket API. In the TCP/IP Internet model, the application can use transport services directly","hi":"आमतौर पर ओएस (OS) के सॉकेट एपीआई (socket API) के माध्यम से। TCP/IP इंटरनेट मॉडल में, एप्लिकेशन सीधे परिवहन सेवाओं (transport services) का उपयोग कर सकता है"},{"en":"Through a web browser only","hi":"केवल एक वेब ब्राउज़र के माध्यम से"},{"en":"They cannot access it","hi":"वे इस तक नहीं पहुंच सकते"}],"exp":{"en":"Applications open 'sockets' (which bind an IP address and a Port) to send and receive data over the network via TCP or UDP.\nSource-note (Hinglish): Aam taur par OS ki socket API ke through. TCP/IP ke Internet model mein application directly transport services use kar sakti hai.","hi":"एप्लिकेशन TCP या UDP के माध्यम से नेटवर्क पर डेटा भेजने और प्राप्त करने के लिए 'सॉकेट' खोलते हैं (जो एक IP पता और एक पोर्ट बांधते हैं)।"},"num":37},{"id":"q38","q":{"en":"What are the full forms and service types of TCP and UDP?","hi":"TCP और UDP के पूर्ण रूप (full forms) और सेवा प्रकार (service types) क्या हैं?"},"a":{"en":"TCP = Transmission Control Protocol, connection-oriented. UDP = User Datagram Protocol, connectionless","hi":"TCP = ट्रांसमिशन कंट्रोल प्रोटोकॉल (Transmission Control Protocol), कनेक्शन-ओरिएंटेड (connection-oriented)। UDP = यूजर डेटाग्राम प्रोटोकॉल (User Datagram Protocol), कनेक्शनलेस (connectionless)"},"o":[{"en":"Text Control Protocol (wireless); User Data Protocol (wired)","hi":"टेक्स्ट कंट्रोल प्रोटोकॉल (वायरलेस); यूज़र डेटा प्रोटोकॉल (वायर्ड)"},{"en":"TCP = Transmission Control Protocol, connection-oriented. UDP = User Datagram Protocol, connectionless","hi":"TCP = ट्रांसमिशन कंट्रोल प्रोटोकॉल (Transmission Control Protocol), कनेक्शन-ओरिएंटेड (connection-oriented)। UDP = यूजर डेटाग्राम प्रोटोकॉल (User Datagram Protocol), कनेक्शनलेस (connectionless)"},{"en":"Terminal Control Protocol (fast); Universal Data Protocol (slow)","hi":"टर्मिनल कंट्रोल प्रोटोकॉल (तेज़); यूनिवर्सल डेटा प्रोटोकॉल (धीमा)"},{"en":"Transfer Central Protocol (secure); Uniform Datagram Protocol (open)","hi":"ट्रांसफर सेंट्रल प्रोटोकॉल (सुरक्षित); यूनिफॉर्म डेटाग्राम प्रोटोकॉल (ओपन)"}],"exp":{"en":"TCP guarantees delivery and ordering (like a phone call). UDP just sends data quickly without guarantees (like a postcard).\nSource-note (Hinglish): TCP = Transmission Control Protocol, connection-oriented. UDP = User Datagram Protocol, connectionless.","hi":"TCP वितरण और क्रम (जैसे फोन कॉल) की गारंटी देता है। UDP बस बिना किसी गारंटी के डेटा जल्दी भेजता है (जैसे पोस्टकार्ड)।"},"num":38},{"id":"q39","q":{"en":"What are the three phases of connection-oriented service?","hi":"कनेक्शन-ओरिएंटेड (connection-oriented) सेवा के तीन चरण क्या हैं?"},"a":{"en":"Connection establishment → data transfer → termination. TCP is a common example of these phases","hi":"कनेक्शन स्थापना (Connection establishment) → डेटा ट्रांसफर (data transfer) → समाप्ति (termination)। TCP इन चरणों का एक सामान्य उदाहरण है"},"o":[{"en":"Start, Stop, Delete","hi":"शुरू, बंद, हटाना"},{"en":"Connection establishment → data transfer → termination. TCP is a common example of these phases","hi":"कनेक्शन स्थापना (Connection establishment) → डेटा ट्रांसफर (data transfer) → समाप्ति (termination)। TCP इन चरणों का एक सामान्य उदाहरण है"},{"en":"Read, Write, Execute","hi":"पढ़ना, लिखना, निष्पादित करना"},{"en":"Input, Processing, Output","hi":"इनपुट, प्रोसेसिंग, आउटपुट"}],"exp":{"en":"TCP uses a 'three-way handshake' to establish a connection before any actual data is transferred.\nSource-note (Hinglish): Connection establishment → data transfer → termination. TCP in phases ka common example hai.","hi":"TCP किसी भी वास्तविक डेटा को स्थानांतरित करने से पहले एक कनेक्शन स्थापित करने के लिए 'थ्री-वे हैंडशेक' (three-way handshake) का उपयोग करता है।"},"num":39},{"id":"q40","q":{"en":"How does TCP provide reliable transfer?","hi":"TCP विश्वसनीय स्थानांतरण (reliable transfer) कैसे प्रदान करता है?"},"a":{"en":"It delivers a reliable, in-order byte stream using sequence numbers, acknowledgments, and retransmission. Flow control takes the receiver's capacity into account","hi":"यह अनुक्रम संख्याओं (sequence numbers), पावती (acknowledgments) और पुनर्प्रेषण (retransmission) का उपयोग करके एक विश्वसनीय, इन-ऑर्डर बाइट स्ट्रीम (in-order byte stream) प्रदान करता है। प्रवाह नियंत्रण (Flow control) रिसीवर की क्षमता को ध्यान में रखता है"},"o":[{"en":"By encrypting all data","hi":"सभी डेटा को एन्क्रिप्ट करके"},{"en":"It delivers a reliable, in-order byte stream using sequence numbers, acknowledgments, and retransmission. Flow control takes the receiver's capacity into account","hi":"यह अनुक्रम संख्याओं (sequence numbers), पावती (acknowledgments) और पुनर्प्रेषण (retransmission) का उपयोग करके एक विश्वसनीय, इन-ऑर्डर बाइट स्ट्रीम (in-order byte stream) प्रदान करता है। प्रवाह नियंत्रण (Flow control) रिसीवर की क्षमता को ध्यान में रखता है"},{"en":"By using shorter cables","hi":"छोटी केबलों का उपयोग करके"},{"en":"By compressing the data twice","hi":"डेटा को दो बार संपीड़ित (compressing) करके"}],"exp":{"en":"If TCP sends a packet and doesn't get an ACK (acknowledgment) back, it automatically resends the packet.\nSource-note (Hinglish): Sequence numbers, acknowledgments aur retransmission se reliable, in-order byte stream deliver karta hai. Flow control receiver ki capacity ko dhyan mein rakhta hai.","hi":"यदि TCP एक पैकेट भेजता है और वापस ACK (पावती) प्राप्त नहीं करता है, तो यह स्वचालित रूप से पैकेट को फिर से भेजता है।"},"num":40},{"id":"q41","q":{"en":"How does a connectionless service work?","hi":"कनेक्शनलेस सेवा कैसे काम करती है?"},"a":{"en":"Transport handshake without prior connection setup. UDP does not guarantee delivery, ordering, acknowledgments, or retransmission","hi":"ट्रांसपोर्ट हैंडशेक के बिना कनेक्शन सेटअप। UDP डिलीवरी, ऑर्डरिंग, पावती (acknowledgments) या पुनर्प्रेषण की गारंटी नहीं देता"},"o":[{"en":"With a three-way handshake and explicit setup","hi":"तीन-वे हैंडशेक और स्पष्ट सेटअप के साथ"},{"en":"Transport handshake without prior connection setup. UDP does not guarantee delivery, ordering, acknowledgments, or retransmission","hi":"ट्रांसपोर्ट हैंडशेक के बिना कनेक्शन सेटअप। UDP डिलीवरी, ऑर्डरिंग, पावती (acknowledgments) या पुनर्प्रेषण की गारंटी नहीं देता"},{"en":"By establishing a dedicated physical circuit","hi":"एक समर्पित भौतिक सर्किट स्थापित करके"},{"en":"Using token passing","hi":"टोकन पासिंग का उपयोग करके"}],"exp":{"en":"Connectionless service like UDP sends datagrams without prior connection setup, offering high speed with best-effort delivery.\nSource-note (Hinglish): Transport handshake ke bina datagrams bheje jaate hain. UDP delivery, ordering, acknowledgments ya retransmission ki built-in guarantee nahin deta.","hi":"UDP जैसी कनेक्शनलेस सेवा बिना किसी पूर्व कनेक्शन सेटअप के डेटाग्राम भेजती है, जो बेस्ट-इफ़ोर्ट डिलीवरी के साथ उच्च गति प्रदान करती है।"},"num":41},{"id":"q42","q":{"en":"Why does UDP have lower overhead?","hi":"UDP का ओवरहेड कम क्यों होता है?"},"a":{"en":"Because UDP lacks connection setup and TCP-like reliability machinery, allowing applications to add their own ACKs, retries, or security","hi":"क्योंकि UDP में कनेक्शन सेटअप और TCP जैसी विश्वसनीयता मशीनरी की कमी होती है, जिससे एप्लिकेशन अपने स्वयं के ACK, पुनः प्रयास (retries) या सुरक्षा जोड़ने में सक्षम होते हैं"},"o":[{"en":"Because it uses more bandwidth","hi":"क्योंकि यह अधिक बैंडविड्थ का उपयोग करता है"},{"en":"Because UDP lacks connection setup and TCP-like reliability machinery, allowing applications to add their own ACKs, retries, or security","hi":"क्योंकि UDP में कनेक्शन सेटअप और TCP जैसी विश्वसनीयता मशीनरी की कमी होती है, जिससे एप्लिकेशन अपने स्वयं के ACK, पुनः प्रयास (retries) या सुरक्षा जोड़ने में सक्षम होते हैं"},{"en":"Because it runs on physical wires","hi":"क्योंकि यह भौतिक तारों पर चलता है"},{"en":"Because it is encrypted by default","hi":"क्योंकि यह डिफ़ॉल्ट रूप से एन्क्रिप्टेड है"}],"exp":{"en":"UDP has a smaller header and lower overhead because it does not track state, sequence numbers, or acknowledgments.\nSource-note (Hinglish): UDP mein connection setup aur TCP jaisi reliability machinery nahin hoti. Application chahe to apne ACKs, retries ya security add kar sakti hai.","hi":"UDP का एक छोटा हेडर और कम ओवरहेड होता है क्योंकि यह स्टेट, अनुक्रम संख्या (sequence numbers) या पावती को ट्रैक नहीं करता है।"},"num":42},{"id":"q43","q":{"en":"Does TCP reliable delivery also provide encryption?","hi":"क्या TCP की विश्वसनीय डिलीवरी से एन्क्रिप्शन भी मिलता है?"},"a":{"en":"No. Confidentiality requires separate mechanisms like TLS. TCP reliability only ensures order and delivery recovery","hi":"नहीं। गोपनीयता के लिए TLS जैसे अलग तंत्र की आवश्यकता होती है। TCP विश्वसनीयता केवल क्रम और डिलीवरी पुनर्प्राप्ति सुनिश्चित करती है"},"o":[{"en":"Yes, reliability includes data encryption","hi":"हाँ, विश्वसनीयता में डेटा एन्क्रिप्ट करना शामिल है"},{"en":"No. Confidentiality requires separate mechanisms like TLS. TCP reliability only ensures order and delivery recovery","hi":"नहीं। गोपनीयता के लिए TLS जैसे अलग तंत्र की आवश्यकता होती है। TCP विश्वसनीयता केवल क्रम और डिलीवरी पुनर्प्राप्ति सुनिश्चित करती है"},{"en":"Yes, TCP encrypts bytes automatically","hi":"हाँ, TCP बाइट्स को स्वचालित रूप से एन्क्रिप्ट करता है"},{"en":"Encryption is handled at Layer 1","hi":"एन्क्रिप्शन लेयर 1 पर संभाला जाता है"}],"exp":{"en":"Reliability in transport protocols means error-free and in-order delivery, which is distinct from cryptographic confidentiality (encryption).\nSource-note (Hinglish): Confidentiality ke liye TLS jaise security mechanisms alag se lagte hain. TCP reliability ka matlab order aur delivery recover karna hai.","hi":"परिवहन प्रोटोकॉल में विश्वसनीयता का अर्थ त्रुटि-मुक्त और क्रम में डिलीवरी है, जो क्रिप्टोग्राफिक गोपनीयता (एनक्रिप्शन) से अलग है।"},"num":43}]},{"title":{"en":"6. Session, Presentation & Application Layers","hi":"6. सेशन, प्रेजेंटेशन और एप्लिकेशन लेयर"},"questions":[{"id":"q44","q":{"en":"What is the layer number and core function of the Session Layer?","hi":"सेशन लेयर का नंबर और मुख्य कार्य क्या है?"},"a":{"en":"L5 · Establishes, maintains, and terminates communication sessions; handles dialog control and synchronization","hi":"L5. संचार सत्रों को स्थापित, बनाए रखता और समाप्त करता है; संवाद नियंत्रण (dialog control) और सिंक्रोनाइज़ेशन को संभालता है"},"o":[{"en":"L3 · Routing and forwarding","hi":"L3 · रूटिंग और फॉरवर्डिंग"},{"en":"L5 · Establishes, maintains, and terminates communication sessions; handles dialog control and synchronization","hi":"L5. संचार सत्रों को स्थापित, बनाए रखता और समाप्त करता है; संवाद नियंत्रण (dialog control) और सिंक्रोनाइज़ेशन को संभालता है"},{"en":"L7 · Application services","hi":"L7 · एप्लिकेशन सेवाएं"},{"en":"L4 · End-to-end transport","hi":"L4 · एंड-टू-एंड ट्रांसपोर्ट"}],"exp":{"en":"The Session Layer (Layer 5) manages dialogue between end-user applications, opening, closing, and maintaining sessions.\nSource-note (Hinglish): L5. Communication sessions establish, maintain aur terminate karti hai. Dialog control aur synchronization iske main functions hain.","hi":"सेशन लेयर (लेयर 5) एंड-यूज़र एप्लिकेशन के बीच संवाद का प्रबंधन करती है, सत्रों को खोलती, बंद करती और बनाए रखती है।"},"num":44},{"id":"q45","q":{"en":"How does synchronization help in the Session Layer?","hi":"सेशन लेयर में सिंक्रोनाइज़ेशन कैसे मदद करता है?"},"a":{"en":"By adding checkpoints so that after an interruption, transfer can resume or resynchronize from an agreed recovery point","hi":"चेकपॉइंट जोड़कर ताकि व्यवधान के बाद, एक सहमत पुनर्प्राप्ति बिंदु (recovery point) से ट्रांसफर फिर से शुरू या पुनर्सिंक्रनाइज़ हो सके"},"o":[{"en":"By restarting the entire file from byte zero","hi":"बाइट शून्य से पूरी फ़ाइल को पुनरारंभ करके"},{"en":"By adding checkpoints so that after an interruption, transfer can resume or resynchronize from an agreed recovery point","hi":"चेकपॉइंट जोड़कर ताकि व्यवधान के बाद, एक सहमत पुनर्प्राप्ति बिंदु (recovery point) से ट्रांसफर फिर से शुरू या पुनर्सिंक्रनाइज़ हो सके"},{"en":"By increasing the clock speed","hi":"घड़ी की गति (clock speed) बढ़ाकर"},{"en":"By changing MAC addresses","hi":"MAC पते बदलकर"}],"exp":{"en":"Synchronization points (checkpoints) prevent data loss during large transfers by allowing resumed transmission from the last checkpoint rather than restarting.\nSource-note (Hinglish): Checkpoints add karke interruption ke baad agreed recovery point se transfer resume ya resynchronize karne mein help karti hai.","hi":"सिंक्रोनाइज़ेशन पॉइंट (चेकपॉइंट) पुनरारंभ करने के बजाय अंतिम चेकपॉइंट से फिर से शुरू किए गए प्रसारण की अनुमति देकर बड़े स्थानान्तरण के दौरान डेटा हानि को रोकते हैं।"},"num":45},{"id":"q46","q":{"en":"What does dialog control manage in the Session Layer?","hi":"सेशन लेयर में डायलॉग कंट्रोल क्या प्रबंधित करता है?"},"a":{"en":"Who can speak, when the turn changes, and how communication is coordinated in half-duplex or full-duplex style","hi":"कौन बोल सकता है, जब टर्न बदलता है, और आधे-डुप्लेक्स या पूर्ण-डुप्लेक्स शैली में संचार कैसे समन्वित होता है"},"o":[{"en":"IP addresses and MAC routing","hi":"IP पते और MAC रूटिंग"},{"en":"Who can speak, when the turn changes, and how communication is coordinated in half-duplex or full-duplex style","hi":"कौन बोल सकता है, जब टर्न बदलता है, और आधे-डुप्लेक्स या पूर्ण-डुप्लेक्स शैली में संचार कैसे समन्वित होता है"},{"en":"Data encryption and decryption","hi":"डेटा एन्क्रिप्शन और डिक्रिप्शन"},{"en":"Packet segmentation and reassembly","hi":"पैकेट विभाजन और पुनर्जोड़"}],"exp":{"en":"Dialog control manages which device transmits data and when, coordinating interaction modes (simplex, half-duplex, full-duplex).\nSource-note (Hinglish): Kaun bol sakta hai, kab turn change hoga aur communication half-duplex ya full-duplex style mein kaise coordinate hogi.","hi":"डायलॉग कंट्रोल प्रबंधित करता है कि कौन सा डिवाइस डेटा प्रसारित करता है और कब, बातचीत मोड (सिम्प्लेक्स, हाफ-डुप्लेक्स, फुल-डुप्लेक्स) का समन्वय करता है।"},"num":46},{"id":"q47","q":{"en":"What role can authentication play during session establishment?","hi":"सेशन स्थापित करते समय ऑथेंटिकेशन की क्या भूमिका होती है?"},"a":{"en":"Peer identity checks can occur during session setup, though actual authentication and security can be implemented across multiple protocol stack parts","hi":"सत्र सेटअप (session setup) के दौरान पीयर पहचान जांच हो सकती है, हालांकि वास्तविक प्रमाणीकरण और सुरक्षा को कई प्रोटोकॉल स्टैक भागों में लागू किया जा सकता है"},"o":[{"en":"Authentication is strictly prohibited","hi":"प्रमाणीकरण सख्त वर्जित है"},{"en":"Peer identity checks can occur during session setup, though actual authentication and security can be implemented across multiple protocol stack parts","hi":"सत्र सेटअप (session setup) के दौरान पीयर पहचान जांच हो सकती है, हालांकि वास्तविक प्रमाणीकरण और सुरक्षा को कई प्रोटोकॉल स्टैक भागों में लागू किया जा सकता है"},{"en":"Authentication only happens at Layer 1","hi":"प्रमाणीकरण केवल लेयर 1 पर होता है"},{"en":"Authentication is handled by the physical cable","hi":"प्रमाणीकरण भौतिक केबल द्वारा संभाला जाता है"}],"exp":{"en":"Session establishment often incorporates security handshakes or credentials verification, while overall security spans multiple layers.\nSource-note (Hinglish): Session setup mein peer identity checks ho sakte hain. Actual authentication aur security protocol stack ke kai parts mein implement ho sakti hai.","hi":"सत्र स्थापना में अक्सर सुरक्षा हैंडशेक या क्रेडेंशियल सत्यापन शामिल होता है, जबकि समग्र सुरक्षा कई परतों में फैली हुई है।"},"num":47},{"id":"q48","q":{"en":"Why is the Presentation Layer called the Translation Layer?","hi":"प्रेजेंटेशन लेयर को ट्रांसलेशन लेयर क्यों कहते हैं?"},"a":{"en":"Because L6 transforms data representation and syntax (e.g., ASCII to EBCDIC) so the receiving system can interpret it in an agreed format","hi":"क्योंकि L6 डेटा प्रतिनिधित्व और सिंटैक्स (जैसे, ASCII से EBCDIC) को बदलता है ताकि प्राप्त करने वाला सिस्टम इसे एक सहमत प्रारूप में व्याख्या कर सके"},"o":[{"en":"Because it translates foreign languages into English","hi":"क्योंकि यह विदेशी भाषाओं का अंग्रेजी में अनुवाद करता है"},{"en":"Because L6 transforms data representation and syntax (e.g., ASCII to EBCDIC) so the receiving system can interpret it in an agreed format","hi":"क्योंकि L6 डेटा प्रतिनिधित्व और सिंटैक्स (जैसे, ASCII से EBCDIC) को बदलता है ताकि प्राप्त करने वाला सिस्टम इसे एक सहमत प्रारूप में व्याख्या कर सके"},{"en":"Because it translates audio into video","hi":"क्योंकि यह ऑडियो को वीडियो में अनुवाद करता है"},{"en":"Because it converts IP addresses to domain names","hi":"क्योंकि यह IP पतों को डोमेन नामों में परिवर्तित करता है"}],"exp":{"en":"The Presentation Layer (Layer 4/6 in some contexts, strictly L6 in OSI) ensures that data sent from the application layer of one system can be read by the application layer of another.\nSource-note (Hinglish): L6 data representation aur syntax transform karti hai, jaise ASCII se EBCDIC. Isse receiving system data ko agreed format mein interpret kar sakta hai.","hi":"प्रेजेंटेशन लेयर (लेयर 6) यह सुनिश्चित करती है कि एक सिस्टम की एप्लिकेशन लेयर से भेजा गया डेटा दूसरे सिस्टम की एप्लिकेशन लेयर द्वारा पढ़ा जा सके।"},"num":48},{"id":"q49","q":{"en":"What are the three textbook functions of the Presentation Layer?","hi":"प्रेजेंटेशन लेयर के तीन प्रमुख पाठ्यपुस्तकीय कार्य क्या हैं?"},"a":{"en":"Translation/format conversion, encryption/decryption, and compression","hi":"अनुवाद/प्रारूप रूपांतरण, एन्क्रिप्शन/डिक्रिप्शन, और संपीड़न (compression)"},"o":[{"en":"Routing, Switching, Forwarding","hi":"रूटिंग, स्विचिंग, फॉरवर्डिंग"},{"en":"Translation/format conversion, encryption/decryption, and compression","hi":"अनुवाद/प्रारूप रूपांतरण, एन्क्रिप्शन/डिक्रिप्शन, और संपीड़न (compression)"},{"en":"Framing, Error Control, Flow Control","hi":"फ्रेमिंग, एरर कंट्रोल, फ्लो कंट्रोल"},{"en":"Session setup, Checkpointing, Termination","hi":"सेशन सेटअप, चेकपॉइंटिंग, टर्मिनेशन"}],"exp":{"en":"These three are the classic textbook functions assigned to the Presentation Layer (Layer 6).\nSource-note (Hinglish): Translation/format conversion, encryption/decryption aur compression.","hi":"ये तीनों प्रेजेंटेशन लेयर (लेयर 6) को सौंपे गए क्लासिक पाठ्यपुस्तक कार्य हैं।"},"num":49},{"id":"q50","q":{"en":"What are plaintext and ciphertext?","hi":"प्लेनटेक्स्ट और सिफरटेक्स्ट क्या होते हैं?"},"a":{"en":"Plaintext is original unencrypted data. Ciphertext is data after encryption, which can be decrypted with a suitable key","hi":"सादा पाठ (Plaintext) मूल अनएन्क्रिप्टेड डेटा है। सिफर्हरटेक्स्ट (Ciphertext) एन्क्रिप्शन के बाद का डेटा है, जिसे उपयुक्त कुंजी (key) से डिक्रिप्ट किया जा सकता है"},"o":[{"en":"Ciphertext is compressed, plaintext is uncompressed","hi":"सिफर्हरटेक्स्ट संपीड़ित है, सादा पाठ असंपीडित है"},{"en":"Plaintext is original unencrypted data. Ciphertext is data after encryption, which can be decrypted with a suitable key","hi":"सादा पाठ (Plaintext) मूल अनएन्क्रिप्टेड डेटा है। सिफर्हरटेक्स्ट (Ciphertext) एन्क्रिप्शन के बाद का डेटा है, जिसे उपयुक्त कुंजी (key) से डिक्रिप्ट किया जा सकता है"},{"en":"Plaintext is binary, ciphertext is text","hi":"सादा पाठ बाइनरी है, सिफर्हरटेक्स्ट टेक्स्ट है"},{"en":"There is no difference","hi":"कोई अंतर नहीं है"}],"exp":{"en":"Plaintext refers to readable data before cryptographic transformation, whereas ciphertext is the unreadable scrambled result of encryption.\nSource-note (Hinglish): Plaintext original unencrypted data. Ciphertext encryption ke baad ka data, jo suitable key se decrypt kiya ja sakta hai.","hi":"प्लेनटेक्स्ट क्रिप्टोग्राफिक परिवर्तन से पहले पठनीय डेटा को संदर्भित करता है, जबकि सिफर्हरटेक्स्ट एन्क्रिप्शन का अपठनीय प्रसंस्कृत (scrambled) परिणाम है।"},"num":50},{"id":"q51","q":{"en":"What is the benefit of compression in networking?","hi":"नेटवर्किंग में डेटा संपीड़न का क्या लाभ है?"},"a":{"en":"It reduces the number of transmitted bits by minimizing data redundancy","hi":"यह डेटा रिडंडेंसी को कम करके प्रेषित बिट्स (transmitted bits) की संख्या को कम करता है"},"o":[{"en":"It increases network speed by adding padding","hi":"यह पैडिंग जोड़कर नेटवर्क गति बढ़ाता है"},{"en":"It reduces the number of transmitted bits by minimizing data redundancy","hi":"यह डेटा रिडंडेंसी को कम करके प्रेषित बिट्स (transmitted bits) की संख्या को कम करता है"},{"en":"It converts text to images","hi":"यह टेक्स्ट को इमेज में बदलता है"},{"en":"It splits packets into smaller fragments","hi":"यह पैकेट को छोटे टुकड़ों में विभाजित करता है"}],"exp":{"en":"Compression reduces the size of data bytes, improving throughput and reducing transmission time over the network.\nSource-note (Hinglish): Redundancy kam karke transmitted bits ki sankhya reduce kar sakti hai.","hi":"कम्प्रेशन डेटा बाइट्स के आकार को कम करता है, थ्रूपुट में सुधार करता है और नेटवर्क पर संचरण समय को कम करता है।"},"num":51},{"id":"q52","q":{"en":"With which OSI layer are JPEG, MPEG, and GIF commonly associated in textbooks?","hi":"पाठ्यपुस्तकों में JPEG, MPEG और GIF को किस OSI लेयर से जोड़ा जाता है?"},"a":{"en":"Presentation Layer format examples (JPEG for images, MPEG for audio/video, GIF for graphics)","hi":"प्रेजेंटेशन लेयर प्रारूप उदाहरण (छवियों के लिए JPEG, ऑडियो/वीडियो के लिए MPEG, ग्राफिक्स के लिए GIF)"},"o":[{"en":"Network Layer routing protocols","hi":"नेटवर्क लेयर रूटिंग प्रोटोकॉल"},{"en":"Presentation Layer format examples (JPEG for images, MPEG for audio/video, GIF for graphics)","hi":"प्रेजेंटेशन लेयर प्रारूप उदाहरण (छवियों के लिए JPEG, ऑडियो/वीडियो के लिए MPEG, ग्राफिक्स के लिए GIF)"},{"en":"Transport Layer protocols","hi":"ट्रांसपोर्ट लेयर प्रोटोकॉल"},{"en":"Data Link framing standards","hi":"डेटा लिंक फ़्रेमिंग मानक"}],"exp":{"en":"These multimedia standards define how visual and audio data are structured and represented, handled at the presentation layer.\nSource-note (Hinglish): Presentation Layer ke format examples. JPEG images, MPEG audio/video standards aur GIF graphics format se related hai.","hi":"ये मल्टीमीडिया मानक यह परिभाषित करते हैं कि दृश्य और ऑडियो डेटा को कैसे संरचित और दर्शाया जाता है, जिन्हें प्रेजेंटेशन लेयर पर संभाला जाता है।"},"num":52},{"id":"q53","q":{"en":"Which is the topmost OSI layer and what does it do?","hi":"OSI की सबसे ऊपरी लेयर कौन-सी है और उसका कार्य क्या है?"},"a":{"en":"L7 Application Layer. It provides network services to application processes (e.g., HTTP for browsers, SMTP for email). Also labeled 'Desktop Layer' in notes","hi":"L7 एप्लिकेशन लेयर। यह एप्लिकेशन प्रक्रियाओं को नेटवर्क सेवाएं प्रदान करती है (जैसे, ब्राउज़र के लिए HTTP, ईमेल के लिए SMTP)। नोट्स में 'डेस्कटॉप लेयर' भी कहा गया है"},"o":[{"en":"L1 Physical Layer","hi":"L1 फिजिकल लेयर"},{"en":"L7 Application Layer. It provides network services to application processes (e.g., HTTP for browsers, SMTP for email). Also labeled 'Desktop Layer' in notes","hi":"L7 एप्लिकेशन लेयर। यह एप्लिकेशन प्रक्रियाओं को नेटवर्क सेवाएं प्रदान करती है (जैसे, ब्राउज़र के लिए HTTP, ईमेल के लिए SMTP)। नोट्स में 'डेस्कटॉप लेयर' भी कहा गया है"},{"en":"L4 Transport Layer","hi":"L4 ट्रांसपोर्ट लेयर"},{"en":"L5 Session Layer","hi":"L5 सेशन लेयर"}],"exp":{"en":"The Application Layer is the top-most layer of the OSI model, directly serving end-user software and applications.\nSource-note (Hinglish): L7 Application Layer. Application processes ko network services deti hai, jaise browser ke liye HTTP aur email client ke liye SMTP. Notes mein “Desktop Layer” memory label bhi hai.","hi":"एप्लिकेशन लेयर OSI मॉडल की सबसे ऊपरी परत है, जो सीधे एंड-यूज़र सॉफ्टवेयर और एप्लिकेशन को सेवा देती है।"},"num":53},{"id":"q54","q":{"en":"What is Network Virtual Terminal (NVT) used for at the Application Layer?","hi":"एप्लिकेशन लेयर में नेटवर्क वर्चुअल टर्मिनल (NVT) का क्या उपयोग है?"},"a":{"en":"To provide a common representation for remote terminal interaction (e.g., Telnet remote host login)","hi":"रिमोट टर्मिनल इंटरैक्शन के लिए एक सामान्य प्रतिनिधित्व प्रदान करना (जैसे, Telnet रिमोट होस्ट लॉगिन)"},"o":[{"en":"To encrypt network traffic","hi":"नेटवर्क ट्रैफ़िक को एन्क्रिप्ट करने के लिए"},{"en":"To provide a common representation for remote terminal interaction (e.g., Telnet remote host login)","hi":"रिमोट टर्मिनल इंटरैक्शन के लिए एक सामान्य प्रतिनिधित्व प्रदान करना (जैसे, Telnet रिमोट होस्ट लॉगिन)"},{"en":"To manage IP routing tables","hi":"IP रूटिंग टेबल प्रबंधित करने के लिए"},{"en":"To provide a graphical user interface","hi":"ग्राफिकल यूजर इंटरफेस प्रदान करने के लिए"}],"exp":{"en":"Network Virtual Terminal (NVT) creates a standard virtual terminal interface so different types of user terminals can interact uniformly with remote hosts.\nSource-note (Hinglish): Remote terminal interaction ko common representation deta hai, jaise Telnet mein remote host login.","hi":"नेटवर्क वर्चुअल टर्मिनल (NVT) एक मानक वर्चुअल टर्मिनल इंटरफ़ेस बनाता है ताकि विभिन्न प्रकार के उपयोगकर्ता टर्मिनल दूरस्थ होस्ट के साथ समान रूप से बातचीत कर सकें।"},"num":54},{"id":"q55","q":{"en":"What is the full form and function of FTAM?","hi":"FTAM का पूरा नाम और कार्य क्या है?"},"a":{"en":"File Transfer, Access and Management. An OSI application service to transfer, access, and manage remote files","hi":"फाइल ट्रांसफर, एक्सेस एंड मैनेजमेंट (File Transfer, Access and Management)। दूरस्थ फ़ाइलों को स्थानांतरित करने, एक्सेस करने और प्रबंधित करने के लिए एक OSI एप्लिकेशन सेवा"},"o":[{"en":"Fast File Transport Mechanism","hi":"फास्ट फाइल ट्रांसपोर्ट मैकेनिज्म"},{"en":"File Transfer, Access and Management. An OSI application service to transfer, access, and manage remote files","hi":"फाइल ट्रांसफर, एक्सेस एंड मैनेजमेंट (File Transfer, Access and Management)। दूरस्थ फ़ाइलों को स्थानांतरित करने, एक्सेस करने और प्रबंधित करने के लिए एक OSI एप्लिकेशन सेवा"},{"en":"Folder Type and Media","hi":"फ़ोल्डर प्रकार और मीडिया"},{"en":"Fixed Transport Access Method","hi":"फिक्सड ट्रांसपोर्ट एक्सेस मेथड"}],"exp":{"en":"FTAM is the OSI model's specific application-layer protocol for file operations across a network.\nSource-note (Hinglish): File Transfer, Access and Management. Remote files ko transfer, access aur manage karne ke liye OSI application service.","hi":"FTAM नेटवर्क पर फ़ाइल संचालन के लिए OSI मॉडल का विशिष्ट एप्लिकेशन-लेयर प्रोटोकॉल है।"},"num":55},{"id":"q56","q":{"en":"What do the Application Layer mail and directory services do?","hi":"एप्लिकेशन लेयर की मेल और डायरेक्टरी सेवाएँ क्या करती हैं?"},"a":{"en":"Mail services transfer, forward, or store messages. Directory services provide searchable information about network objects and services","hi":"मेल सेवाएं संदेशों को स्थानांतरित, अग्रेषित (forward) या संग्रहीत करती हैं। डायरेक्टरी सेवाएं नेटवर्क ऑब्जेक्ट्स और सेवाओं के बारे में खोज योग्य जानकारी (searchable information) प्रदान करती हैं"},"o":[{"en":"They route IP packets across routers","hi":"वे रूटर्स पर IP पैकेट रूट करते हैं"},{"en":"Mail services transfer, forward, or store messages. Directory services provide searchable information about network objects and services","hi":"मेल सेवाएं संदेशों को स्थानांतरित, अग्रेषित (forward) या संग्रहीत करती हैं। डायरेक्टरी सेवाएं नेटवर्क ऑब्जेक्ट्स और सेवाओं के बारे में खोज योग्य जानकारी (searchable information) प्रदान करती हैं"},{"en":"They provide hardware drivers","hi":"वे हार्डवेयर ड्राइवर प्रदान करते हैं"},{"en":"They compress images","hi":"वे छवियों को संपीड़ित करते हैं"}],"exp":{"en":"At the application layer, mail services handle electronic correspondence while directory services act as a phone book for network resources.\nSource-note (Hinglish): Mail services messages transfer, forward ya store karti hain. Directory services network objects aur services ke baare mein searchable information provide karti hain.","hi":"एप्लिकेशन लेयर पर, मेल सेवाएं इलेक्ट्रॉनिक पत्राचार को संभालती हैं जबकि डायरेक्टरी सेवाएं नेटवर्क संसाधनों के लिए फोन बुक के रूप में कार्य करती हैं।"},"num":56}]},{"title":{"en":"7. Protocols, Standards & Full Forms","hi":"7. प्रोटोकॉल, मानक और पूर्ण रूप"},"questions":[{"id":"q57","q":{"en":"What are the full forms of HTTP, HTTPS, and WWW?","hi":"HTTP, HTTPS और WWW के पूर्ण रूप क्या हैं?"},"a":{"en":"Hypertext Transfer Protocol; HTTP over TLS (Secure); World Wide Web","hi":"हाइपरटेक्स्ट ट्रांसफर प्रोटोकॉल; TLS पर HTTP (सुरक्षित); वर्ल्ड वाइड वेब"},"o":[{"en":"Hypertext Transfer Protocol; HTTP over TLS (Secure); World Wide Web","hi":"हाइपरटेक्स्ट ट्रांसफर प्रोटोकॉल; TLS पर HTTP (सुरक्षित); वर्ल्ड वाइड वेब"},{"en":"High Transfer Text Protocol; Secure Text Protocol; World Wide Wireless","hi":"हाई ट्रांसफर टेक्स्ट प्रोटोकॉल; सिक्योर टेक्स्ट प्रोटोकॉल; वर्ल्ड वाइड वायरलेस"},{"en":"Hyperlink Transmission Text Protocol; Secure Web Version; Wide World Web","hi":"हाइपरलिंक ट्रांसमिशन टेक्स्ट प्रोटोकॉल; सिक्योर वेब वर्ज़न; वाइड वर्ल्ड वेब"},{"en":"Host Transfer Protocol; Secure Transmission Protocol; Web World Wide","hi":"होस्ट ट्रांसफर प्रोटोकॉल; सिक्योर ट्रांसमिशन प्रोटोकॉल; वेब वर्ल्ड वाइड"}],"exp":{"en":"HTTP and HTTPS are the foundational application protocols for retrieving web pages on the World Wide Web (WWW).\nSource-note (Hinglish): HTTP = Hypertext Transfer Protocol. HTTPS = HTTP over TLS, commonly Hypertext Transfer Protocol Secure. WWW = World Wide Web.","hi":"HTTP और HTTPS वर्ल्ड वाइड वेब (WWW) पर वेब पेज पुनर्प्राप्त करने के लिए बुनियादी एप्लिकेशन प्रोटोकॉल हैं।"},"num":57},{"id":"q58","q":{"en":"What are FTP, TFTP, Telnet, SSH, and WAP used for?","hi":"FTP, TFTP, Telnet, SSH और WAP का उपयोग किसलिए होता है?"},"a":{"en":"FTP = File Transfer Protocol. TFTP = Trivial File Transfer Protocol. Telnet = remote terminal protocol. SSH = Secure Shell (encrypted remote access). WAP = Wireless Application Protocol","hi":"FTP = फाइल ट्रांसफर प्रोटोकॉल। TFTP = ट्रिवियल फाइल ट्रांसफर प्रोटोकॉल। Telnet = रिमोट टर्मिनल प्रोटोकॉल। SSH = सिक्योर शेल (एन्क्रिप्टेड रिमोट एक्सेस)। WAP = वायरलेस एप्लीकेशन प्रोटोकॉल"},"o":[{"en":"FTP = File Transfer Protocol. TFTP = Trivial File Transfer Protocol. Telnet = remote terminal protocol. SSH = Secure Shell (encrypted remote access). WAP = Wireless Application Protocol","hi":"FTP = फाइल ट्रांसफर प्रोटोकॉल। TFTP = ट्रिवियल फाइल ट्रांसफर प्रोटोकॉल। Telnet = रिमोट टर्मिनल प्रोटोकॉल। SSH = सिक्योर शेल (एन्क्रिप्टेड रिमोट एक्सेस)। WAP = वायरलेस एप्लीकेशन प्रोटोकॉल"},{"en":"FTP = Fast Transfer Protocol. TFTP = Total File Transfer Protocol. Telnet = Telephone Network. SSH = Super Secure Host. WAP = Web Access Protocol","hi":"FTP = फास्ट ट्रांसफर प्रोटोकॉल; TFTP = टोटल फाइल ट्रांसफर प्रोटोकॉल; Telnet = टेलीफोन नेटवर्क; SSH = सुपर सिक्योर होस्ट; WAP = वेब एक्सेस प्रोटोकॉल"},{"en":"FTP = File Transmission Program. TFTP = Temporary File Transfer. Telnet = Television Network. SSH = Secure Server Host. WAP = Wide Area Protocol","hi":"FTP = फाइल ट्रांसमिशन प्रोग्राम; TFTP = टेम्पररी फाइल ट्रांसफर; Telnet = टेलीविज़न नेटवर्क; SSH = सिक्योर सर्वर होस्ट; WAP = वाइड एरिया प्रोटोकॉल"},{"en":"All are data link protocols","hi":"सभी डेटा लिंक प्रोटोकॉल हैं"}],"exp":{"en":"These are prominent application-layer protocols used for file transfers, remote login, secure shell access, and mobile web browsing.\nSource-note (Hinglish): FTP = File Transfer Protocol. TFTP = Trivial File Transfer Protocol. Telnet remote terminal protocol hai. SSH = Secure Shell, encrypted remote access. WAP = Wireless Application Protocol.","hi":"ये फ़ाइल ट्रांसफर, रिमोट लॉगिन, सिक्योर शेल एक्सेस और मोबाइल वेब ब्राउज़िंग के लिए उपयोग किए जाने वाले प्रमुख एप्लिकेशन-लेयर प्रोटोकॉल हैं।"},"num":58},{"id":"q59","q":{"en":"What are the full forms and uses of SMTP, POP3, IMAP, and MIME?","hi":"SMTP, POP3, IMAP और MIME के पूरे नाम व उपयोग क्या हैं?"},"a":{"en":"SMTP = send mail; POP3 = mail retrieval; IMAP = server mailbox access; MIME = content types and attachments","hi":"SMTP = मेल भेजना; POP3 = मेल पुनर्प्राप्ति; IMAP = सर्वर मेलबॉक्स एक्सेस; MIME = सामग्री प्रकार और अटैचमेंट"},"o":[{"en":"SMTP = send mail; POP3 = mail retrieval; IMAP = server mailbox access; MIME = content types and attachments","hi":"SMTP = मेल भेजना; POP3 = मेल पुनर्प्राप्ति; IMAP = सर्वर मेलबॉक्स एक्सेस; MIME = सामग्री प्रकार और अटैचमेंट"},{"en":"SMTP = Secure Mail; POP3 = Post Office 3; IMAP = Internet Mail; MIME = Mail Internet","hi":"SMTP = सिक्योर मेल; POP3 = पोस्ट ऑफिस 3; IMAP = इंटरनेट मेल; MIME = मेल इंटरनेट"},{"en":"All are used for routing IP packets","hi":"सभी का उपयोग IP पैकेट रूट करने के लिए किया जाता है"},{"en":"All are physical layer protocols","hi":"सभी फिजिकल लेयर प्रोटोकॉल हैं"}],"exp":{"en":"These email-related standards and protocols govern how electronic mail is transmitted, stored, retrieved, and formatted with non-text attachments.\nSource-note (Hinglish): SMTP = Simple Mail Transfer Protocol, mail send/relay. POP3 = Post Office Protocol version 3, mail retrieval. IMAP = Internet Message Access Protocol, server mailbox access. MIME = Multipurpose Internet Mail Extensions, content types aur attachments.","hi":"ये ईमेल-संबंधित मानक और प्रोटोकॉल नियंत्रित करते हैं कि इलेक्ट्रॉनिक मेल को कैसे प्रेषित, संग्रहीत, पुनर्प्राप्त और गैर-पाठ संलग्नक (non-text attachments) के साथ स्वरूपित किया जाता है।"},"num":59},{"id":"q60","q":{"en":"What are the full forms and uses of DNS, DHCP, and SNMP?","hi":"DNS, DHCP और SNMP के पूरे नाम व उपयोग क्या हैं?"},"a":{"en":"DNS = Domain Name System (resolves names); DHCP = Dynamic Host Configuration (allocates IP); SNMP = Simple Network Management (monitoring)","hi":"DNS = डोमेन नेम सिस्टम (नामों को हल करता है); DHCP = डायनेमिक होस्ट कॉन्फ़िगरेशन (IP आवंटित करता है); SNMP = सिंपल नेटवर्क मैनेजमेंट (निगरानी और प्रबंधन)"},"o":[{"en":"DNS = Domain Name System (resolves names); DHCP = Dynamic Host Configuration (allocates IP); SNMP = Simple Network Management (monitoring)","hi":"DNS = डोमेन नेम सिस्टम (नामों को हल करता है); DHCP = डायनेमिक होस्ट कॉन्फ़िगरेशन (IP आवंटित करता है); SNMP = सिंपल नेटवर्क मैनेजमेंट (निगरानी और प्रबंधन)"},{"en":"DNS = Data Network Service; DHCP = Data Host Control; SNMP = Secure Network Management","hi":"DNS = डेटा नेटवर्क सर्विस; DHCP = डेटा होस्ट कंट्रोल; SNMP = सिक्योर नेटवर्क मैनेजमेंट"},{"en":"DNS = Digital Name Server; DHCP = Dynamic Hardware Connection; SNMP = Simple Node Protocol","hi":"DNS = डिजिटल नेम सर्वर; DHCP = डायनेमिक हार्डवेयर कनेक्शन; SNMP = सिंपल नोड प्रोटोकॉल"},{"en":"All are transport layer protocols","hi":"सभी ट्रांसपोर्ट लेयर प्रोटोकॉल हैं"}],"exp":{"en":"These core infrastructure protocols handle hostname resolution, IP address assignment, and network device management.\nSource-note (Hinglish): DNS = Domain Name System, names aur resource records resolve karta hai. DHCP = Dynamic Host Configuration Protocol, IP settings allocate karta hai. SNMP = Simple Network Management Protocol, monitoring aur management.","hi":"ये मुख्य बुनियादी ढांचा प्रोटोकॉल (core infrastructure protocols) होस्टनाम रिज़ॉल्यूशन, IP एड्रेस असाइनमेंट और नेटवर्क डिवाइस मैनेजमेंट को संभालते हैं।"},"num":60},{"id":"q61","q":{"en":"What are the full forms of JPEG, MPEG, GIF, TIFF, PNG, and MIDI?","hi":"JPEG, MPEG, GIF, TIFF, PNG और MIDI के पूर्ण रूप क्या हैं?"},"a":{"en":"Both answers describe the multimedia format names correctly","hi":"दोनों उत्तर मल्टीमीडिया प्रारूप नामों का सही वर्णन करते हैं"},"o":[{"en":"JPEG, MPEG, GIF, TIFF, PNG, and MIDI full forms","hi":"JPEG, MPEG, GIF, TIFF, PNG, और MIDI के पूर्ण रूप"},{"en":"Joint Photographic Experts Group, Moving Picture Experts Group, Graphics Interchange Format, Tagged Image File Format, Portable Network Graphics, and Musical Instrument Digital Interface","hi":"जॉइंट फोटोग्राफिक एक्सपर्ट्स ग्रुप, मूविंग पिक्चर एक्सपर्ट्स ग्रुप, ग्राफ़िक्स इंटरचेंज फ़ॉर्मेट, टैग्ड इमेज फ़ाइल फ़ॉर्मेट, पोर्टेबल नेटवर्क ग्राफ़िक्स और म्यूज़िकल इंस्ट्रूमेंट डिजिटल इंटरफ़ेस"},{"en":"Both answers describe the multimedia format names correctly","hi":"दोनों उत्तर मल्टीमीडिया प्रारूप नामों का सही वर्णन करते हैं"},{"en":"None of the above","hi":"इनमें से कोई नहीं"}],"exp":{"en":"These standard file formats and interfaces are handled by the presentation layer for image, video, graphics, and music representation.\nSource-note (Hinglish): Joint Photographic Experts Group, Moving Picture Experts Group, Graphics Interchange Format, Tagged Image File Format, Portable Network Graphics aur Musical Instrument Digital Interface.","hi":"इन मानक फ़ाइल स्वरूपों और इंटरफेस को छवि, वीडियो, ग्राफिक्स और संगीत प्रतिनिधित्व के लिए प्रेजेंटेशन लेयर द्वारा संभाला जाता है।"},"num":61},{"id":"q62","q":{"en":"What are the full forms of SSL and TLS, and where do textbooks place them?","hi":"SSL और TLS के पूरे नाम क्या हैं और पाठ्यपुस्तकों में इन्हें किस लेयर से जोड़ते हैं?"},"a":{"en":"SSL = Secure Sockets Layer; TLS = Transport Layer Security. Textbooks associate encryption with Presentation Layer, though in the practical Internet stack TLS sits between application and transport","hi":"SSL = सिक्योर सॉकेट्स लेयर; TLS = ट्रांसपोर्ट लेयर सिक्योरिटी। पाठ्यपुस्तकें एन्क्रिप्शन को प्रेजेंटेशन लेयर से जोड़ती हैं, हालांकि व्यावहारिक इंटरनेट स्टैक में TLS एप्लिकेशन और ट्रांसपोर्ट के बीच बैठता है"},"o":[{"en":"SSL = Secure Sockets Layer; TLS = Transport Layer Security. Textbooks associate encryption with Presentation Layer, though in the practical Internet stack TLS sits between application and transport","hi":"SSL = सिक्योर सॉकेट्स लेयर; TLS = ट्रांसपोर्ट लेयर सिक्योरिटी। पाठ्यपुस्तकें एन्क्रिप्शन को प्रेजेंटेशन लेयर से जोड़ती हैं, हालांकि व्यावहारिक इंटरनेट स्टैक में TLS एप्लिकेशन और ट्रांसपोर्ट के बीच बैठता है"},{"en":"SSL = System Secure Link; TLS = Transport Link Secure","hi":"SSL = सिस्टम सिक्योर लिंक; TLS = ट्रांसपोर्ट लिंक सिक्योर"},{"en":"Both are physical layer protocols","hi":"दोनों फिजिकल लेयर प्रोटोकॉल हैं"},{"en":"SSL and TLS are routing protocols","hi":"SSL और TLS रूटिंग प्रोटोकॉल हैं"}],"exp":{"en":"While theoretical OSI models place encryption in L6 (Presentation), modern web security (HTTPS) uses TLS operating just above the transport layer.\nSource-note (Hinglish): SSL = Secure Sockets Layer aur TLS = Transport Layer Security. Textbooks encryption ko Presentation Layer se associate karte hain. Practical Internet stack mein TLS ko generally application protocol aur transport ke beech use kiya jaata hai.","hi":"जबकि सैद्धांतिक OSI मॉडल L6 (प्रेजेंटेशन) में एन्क्रिप्शन रखते हैं, आधुनिक वेब सुरक्षा (HTTPS) ट्रांसपोर्ट लेयर के ठीक ऊपर काम करने वाले TLS का उपयोग करती है।"},"num":62},{"id":"q63","q":{"en":"Which protocol names are listed as Session Layer examples in the DOCX?","hi":"DOCX में सेशन लेयर के उदाहरण के रूप में किन प्रोटोकॉलों के नाम हैं?"},"a":{"en":"NetBIOS, RPC, PPTP, NFS, PAP, SAP, and SQL. A mixed list including application file service (NFS), authentication (PAP), tunneling (PPTP), and database language (SQL)","hi":"NetBIOS, RPC, PPTP, NFS, PAP, SAP, और SQL। एक मिश्रित सूची जिसमें एप्लिकेशन फ़ाइल सेवा (NFS), प्रमाणीकरण (PAP), टनलिंग (PPTP), और डेटाबेस भाषा (SQL) शामिल हैं"},"o":[{"en":"Network Layer routing algorithms","hi":"नेटवर्क लेयर रूटिंग एल्गोरिदम"},{"en":"NetBIOS, RPC, PPTP, NFS, PAP, SAP, and SQL. A mixed list including application file service (NFS), authentication (PAP), tunneling (PPTP), and database language (SQL)","hi":"NetBIOS, RPC, PPTP, NFS, PAP, SAP, और SQL। एक मिश्रित सूची जिसमें एप्लिकेशन फ़ाइल सेवा (NFS), प्रमाणीकरण (PAP), टनलिंग (PPTP), और डेटाबेस भाषा (SQL) शामिल हैं"},{"en":"Physical Layer cable standards","hi":"फिजिकल लेयर केबल मानक"},{"en":"Data Link framing protocols","hi":"डेटा लिंक फ़्रेमिंग प्रोटोकॉल"}],"exp":{"en":"Textbook curricula often list these under Session Layer examples despite overlapping with application and transport functions in practical stacks.\nSource-note (Hinglish): NetBIOS (Network Basic Input/Output System), RPC (Remote Procedure Call), PPTP (Point-to-Point Tunneling Protocol), NFS (Network File System), PAP (Password Authentication Protocol), SAP aur SQL. Yeh list mixed functions ki hai. NFS application-level file service, PAP PPP authentication, PPTP tunneling aur SQL database language hai.","hi":"व्यावहारिक स्टैक में एप्लिकेशन और ट्रांसपोर्ट कार्यों के साथ ओवरलैप होने के बावजूद पाठ्यपुस्तक पाठ्यक्रम अक्सर इन्हें सेशन लेयर के उदाहरणों के तहत सूचीबद्ध करते हैं।"},"num":63},{"id":"q64","q":{"en":"What are the full forms of SAP and SQL?","hi":"SAP और SQL के पूर्ण रूप क्या हैं?"},"a":{"en":"In PDF context, SAP = Session Announcement Protocol (announces sessions). SQL = Structured Query Language (database queries). Check meaning by context","hi":"PDF संदर्भ में, SAP = सेशन अनाउंसमेंट प्रोटोकॉल (सत्रों की घोषणा करता है)। SQL = स्ट्रक्चर्ड क्वेरी लैंग्वेज (डेटाबेस क्वेरी)। संदर्भ द्वारा अर्थ जांचें"},"o":[{"en":"System Access Protocol and Structured Query Language","hi":"सिस्टम एक्सेस प्रोटोकॉल और स्ट्रक्चर्ड क्वेरी लैंग्वेज"},{"en":"In PDF context, SAP = Session Announcement Protocol (announces sessions). SQL = Structured Query Language (database queries). Check meaning by context","hi":"PDF संदर्भ में, SAP = सेशन अनाउंसमेंट प्रोटोकॉल (सत्रों की घोषणा करता है)। SQL = स्ट्रक्चर्ड क्वेरी लैंग्वेज (डेटाबेस क्वेरी)। संदर्भ द्वारा अर्थ जांचें"},{"en":"Simple Application Protocol and Simple Query Language","hi":"सिंपल एप्लीकेशन प्रोटोकॉल और सिंपल क्वेरी लैंग्वेज"},{"en":"Secure Access Point and Standard Query Logic","hi":"सिक्योर एक्सेस पॉइंट और स्टैंडर्ड क्वेरी लॉजिक"}],"exp":{"en":"Acronyms can have multiple meanings depending on networking vs database contexts; SAP here refers to Session Announcement Protocol.\nSource-note (Hinglish): PDF context mein SAP = Session Announcement Protocol, jo sessions announce karta hai. SQL = Structured Query Language, database queries ke liye. SAP acronym ka meaning context se check karo.","hi":"नेटवर्किंग बनाम डेटाबेस संदर्भ के आधार पर संक्षिप्त नाम के कई अर्थ हो सकते हैं; यहाँ SAP का तात्पर्य सेशन अनाउंसमेंट प्रोटोकॉल से है।"},"num":64},{"id":"q65","q":{"en":"What do IP, ICMP, IGMP, and OSPF do?","hi":"IP, ICMP, IGMP और OSPF क्या कार्य करते हैं?"},"a":{"en":"IP = addressing/forwarding; ICMP = error reporting/diagnostics; IGMP = IPv4 multicast membership; OSPF = routing","hi":"IP = एड्रेसिंग/फॉरवर्डिंग; ICMP = त्रुटि रिपोर्टिंग/डायग्नोस्टिक्स; IGMP = IPv4 मल्टीicast सदस्यता; OSPF = रूटिंग"},"o":[{"en":"IP = addressing/forwarding; ICMP = error reporting/diagnostics; IGMP = IPv4 multicast membership; OSPF = routing","hi":"IP = एड्रेसिंग/फॉरवर्डिंग; ICMP = त्रुटि रिपोर्टिंग/डायग्नोस्टिक्स; IGMP = IPv4 मल्टीicast सदस्यता; OSPF = रूटिंग"},{"en":"IP = Transport Protocol; ICMP = File Transfer; IGMP = Web Browser; OSPF = Encryption","hi":"IP = ट्रांसपोर्ट प्रोटोकॉल; ICMP = फ़ाइल ट्रांसफ़र; IGMP = वेब ब्राउज़र; OSPF = एन्क्रिप्शन"},{"en":"All are Data Link Layer protocols","hi":"सभी डेटा लिंक लेयर प्रोटोकॉल हैं"},{"en":"All are Application Layer protocols","hi":"सभी एप्लिकेशन लेयर प्रोटोकॉल हैं"}],"exp":{"en":"These are foundational Network Layer (Layer 3) protocols responsible for packet delivery, error messaging, multicast management, and dynamic routing.\nSource-note (Hinglish): IP = Internet Protocol, addressing aur forwarding. ICMP = Internet Control Message Protocol, error reporting aur diagnostics. IGMP = Internet Group Management Protocol, IPv4 multicast membership. OSPF = Open Shortest Path First, routing.","hi":"ये बुनियादी नेटवर्क लेयर (लेयर 3) प्रोटोकॉल हैं जो पैकेट डिलीवरी, त्रुटि मैसेजिंग, मल्टीकास्ट प्रबंधन और गतिशील रूटिंग के लिए जिम्मेदार हैं।"},"num":65},{"id":"q66","q":{"en":"Why is AppleTalk included with Network Layer examples?","hi":"AppleTalk को नेटवर्क लेयर के उदाहरणों के साथ क्यों दिखाते हैं?"},"a":{"en":"AppleTalk is a legacy protocol suite. Within it, Datagram Delivery Protocol (DDP) handled network-layer addressing and delivery","hi":"AppleTalk एक लीगेसी प्रोटोकॉल सूट है। इसके भीतर, डेटाग्राम डिलीवरी प्रोटोकॉल (DDP) नेटवर्क-लेयर एड्रेसिंग और डिलीवरी को संभालता था"},"o":[{"en":"Because it is a physical cable","hi":"क्योंकि यह एक भौतिक केबल है"},{"en":"AppleTalk is a legacy protocol suite. Within it, Datagram Delivery Protocol (DDP) handled network-layer addressing and delivery","hi":"AppleTalk एक लीगेसी प्रोटोकॉल सूट है। इसके भीतर, डेटाग्राम डिलीवरी प्रोटोकॉल (DDP) नेटवर्क-लेयर एड्रेसिंग और डिलीवरी को संभालता था"},{"en":"Because it uses IPv6 exclusively","hi":"क्योंकि यह विशेष रूप से IPv6 का उपयोग करता है"},{"en":"Because it is an application protocol","hi":"क्योंकि यह एक एप्लिकेशन प्रोटोकॉल है"}],"exp":{"en":"AppleTalk was Apple's proprietary networking suite, where DDP functioned at Layer 3 (Network Layer).\nSource-note (Hinglish): AppleTalk ek legacy protocol suite hai. Iske andar Datagram Delivery Protocol (DDP) network-layer addressing aur delivery handle karta tha.","hi":"AppleTalk Apple का मालिकाना नेटवर्किंग सूट था, जहाँ DDP लेयर 3 (नेटवर्क लेयर) पर काम करता था।"},"num":66},{"id":"q67","q":{"en":"What are the functions of ARP, RARP, and IPsec?","hi":"ARP, RARP और IPsec के कार्य क्या हैं?"},"a":{"en":"ARP = resolves IPv4 to MAC;小物 RARP = reverse lookup; IPsec = IP layer security suite","hi":"ARP = IPv4 को MAC में हल करता है; RARP = रिवर्स लुकअप; IPsec = IP लेयर सुरक्षा सुइट"},"o":[{"en":"ARP = resolves IPv4 to MAC;小物 RARP = reverse lookup; IPsec = IP layer security suite","hi":"ARP = IPv4 को MAC में हल करता है; RARP = रिवर्स लुकअप; IPsec = IP लेयर सुरक्षा सुइट"},{"en":"ARP = routing; RARP = switching; IPsec = browsing","hi":"ARP = रूटिंग; RARP = स्विचिंग; IPsec = ब्राउज़िंग"},{"en":"All are transport protocols","hi":"सभी ट्रांसपोर्ट प्रोटोकॉल हैं"},{"en":"All are physical layer protocols","hi":"सभी फिजिकल लेयर प्रोटोकॉल हैं"}],"exp":{"en":"These protocols assist the network layer or bridge it to the data link layer (ARP/RARP) and provide cryptographic security at the IP layer (IPsec).\nSource-note (Hinglish): ARP = Address Resolution Protocol, local link par IPv4 se hardware/MAC address resolve karta hai. RARP = Reverse Address Resolution Protocol, legacy hardware-address-to-IP lookup. IPsec = Internet Protocol Security, IP layer security suite.","hi":"ये प्रोटोकॉल नेटवर्क लेयर की सहायता करते हैं या इसे डेटा लिंक लेयर (ARP/RARP) से जोड़ते हैं और IP लेयर (IPsec) पर क्रिप्टोग्राफिक सुरक्षा प्रदान करते हैं।"},"num":67},{"id":"q68","q":{"en":"How should ARP be remembered in an OSI layer chart?","hi":"OSI लेयर चार्ट में ARP को कैसे याद रखना चाहिए?"},"a":{"en":"Textbooks may show it with L3 addressing. ARP bridges IPv4 and MAC addressing. RFC 1122 covers it in the TCP/IP Link Layer","hi":"पाठ्यपुस्तकें इसे L3 एड्रेसिंग के साथ दिखा सकती हैं। ARP IPv4 और MAC एड्रेसिंग को जोड़ता है। RFC 1122 इसे TCP/IP लिंक लेयर में कवर करता है"},"o":[{"en":"It belongs strictly to the Physical Layer","hi":"यह पूरी तरह से फिजिकल लेयर से संबंधित है"},{"en":"Textbooks may show it with L3 addressing. ARP bridges IPv4 and MAC addressing. RFC 1122 covers it in the TCP/IP Link Layer","hi":"पाठ्यपुस्तकें इसे L3 एड्रेसिंग के साथ दिखा सकती हैं। ARP IPv4 और MAC एड्रेसिंग को जोड़ता है। RFC 1122 इसे TCP/IP लिंक लेयर में कवर करता है"},{"en":"It is an Application layer protocol","hi":"यह एक एप्लिकेशन लेयर प्रोटोकॉल है"},{"en":"It is a Presentation layer protocol","hi":"यह एक प्रेजेंटेशन लेयर प्रोटोकॉल है"}],"exp":{"en":"ARP operates conceptually between the network layer (IP) and data link layer (MAC), often categorized differently in OSI vs TCP/IP models.\nSource-note (Hinglish): Textbook mein L3 addressing ke saath dikh sakta hai. ARP IPv4 aur MAC addressing ko bridge karta hai. RFC 1122 ise TCP/IP Link Layer mein cover karta hai.","hi":"ARP वैचारिक रूप से नेटवर्क लेयर (IP) और डेटा लिंक लेयर (MAC) के बीच काम करता है, जिसे अक्सर OSI बनाम TCP/IP मॉडल में अलग-अलग वर्गीकृत किया जाता है।"},"num":68},{"id":"q69","q":{"en":"What are examples of Layer 2 protocols and standards?","hi":"लेयर 2 के प्रोटोकॉल और मानकों के उदाहरण क्या हैं?"},"a":{"en":"Ethernet MAC (IEEE 802.3), Wi-Fi MAC (IEEE 802.11), PPP, HDLC, Frame Relay, ATM, and FDDI","hi":"ईथरनेट MAC, वाई-फाई MAC, PPP, HDLC, फ्रेम रिले, ATM, और FDDI"},"o":[{"en":"Ethernet MAC (IEEE 802.3), Wi-Fi MAC (IEEE 802.11), PPP, HDLC, Frame Relay, ATM, and FDDI","hi":"ईथरनेट MAC, वाई-फाई MAC, PPP, HDLC, फ्रेम रिले, ATM, और FDDI"},{"en":"IP, TCP, UDP, HTTP","hi":"IP, TCP, UDP, HTTP"},{"en":"Hub, Repeater, Router","hi":"हब, रिपीटर, राउटर"},{"en":"ASCII, JPEG, MPEG","hi":"ASCII, JPEG, MPEG"}],"exp":{"en":"These protocols and standards operate at Layer 2 (Data Link Layer), managing framing, MAC addresses, and link-level media access.\nSource-note (Hinglish): Ethernet MAC (IEEE 802.3), Wi-Fi MAC (IEEE 802.11), PPP, HDLC, Frame Relay, ATM aur FDDI. Ethernet aur Wi-Fi standards mein Physical Layer specifications bhi hoti hain.","hi":"ये प्रोटोकॉल और मानक लेयर 2 (डेटा लिंक लेयर) पर काम करते हैं, फ्रेमिंग, मैक पते और लिंक-स्तरीय मीडिया एक्सेस का प्रबंधन करते हैं।"},"num":69},{"id":"q70","q":{"en":"What are the full forms of PPP, HDLC, and SLIP?","hi":"PPP, HDLC और SLIP के पूर्ण रूप क्या हैं?"},"a":{"en":"Point-to-Point Protocol, High-Level Data Link Control, and Serial Line Internet Protocol","hi":"पॉइंट-टू-पॉइंट प्रोटोकॉल, हाई-लेवल डेटा लिंक कंट्रोल, और सीरियल लाइन इंटरनेट प्रोटोकॉल"},"o":[{"en":"Point-to-Point Protocol, High-Level Data Link Control, and Serial Line Internet Protocol","hi":"पॉइंट-टू-पॉइंट प्रोटोकॉल, हाई-लेवल डेटा लिंक कंट्रोल, और सीरियल लाइन इंटरनेट प्रोटोकॉल"},{"en":"Packet Transfer Protocol, Host Data Link, and Session Line IP","hi":"पैकेट ट्रांसफर प्रोटोकॉल, होस्ट डेटा लिंक और सेशन लाइन IP"},{"en":"Public Phone Protocol, Hardware Data Line, and Secure Link IP","hi":"पब्लिक फोन प्रोटोकॉल, हार्डवेयर डेटा लाइन और सिक्योर लिंक IP"},{"en":"Primary Packet Protocol, High Data Logic, and Simple Line Internet","hi":"प्राइमरी पैकेट प्रोटोकॉल, हाई डेटा लॉजिक और सिंपल लाइन इंटरनेट"}],"exp":{"en":"PPP, HDLC, and SLIP are data link layer protocols traditionally used for framing and transmitting datagrams over serial communication links.\nSource-note (Hinglish): Point-to-Point Protocol, High-Level Data Link Control aur Serial Line Internet Protocol. PPP aur SLIP serial links par network traffic carry kar sakte hain.","hi":"PPP, HDLC, और SLIP डेटा लिंक लेयर प्रोटोकॉल हैं जिनका उपयोग पारंपरिक रूप से सीरियल कम्युनिकेशन लिंक पर डेटाग्राम को फ्रेम करने और प्रसारित करने के लिए किया जाता है।"},"num":70},{"id":"q71","q":{"en":"What are examples of Physical Layer signaling and interfaces?","hi":"फिजिकल लेयर के सिग्नलिंग और इंटरफेस के उदाहरण क्या हैं?"},"a":{"en":"RS-232, Ethernet PHY, DSL, ISDN, and SONET/SDH physical specs. RJ45 is a connector label. USB and Bluetooth are full standards with physical specs","hi":"RS-232, ईथरनेट PHY, DSL, ISDN, और SONET/SDH भौतिक विनिर्देश। RJ45 एक कनेक्टर लेबल है। USB और ब्लूटूथ भौतिक विनिर्देशों के साथ पूर्ण मानक हैं"},"o":[{"en":"RS-232, Ethernet PHY, DSL, ISDN, and SONET/SDH physical specs. RJ45 is a connector label. USB and Bluetooth are full standards with physical specs","hi":"RS-232, ईथरनेट PHY, DSL, ISDN, और SONET/SDH भौतिक विनिर्देश। RJ45 एक कनेक्टर लेबल है। USB और ब्लूटूथ भौतिक विनिर्देशों के साथ पूर्ण मानक हैं"},{"en":"HTTP, FTP, SMTP, DNS","hi":"HTTP, FTP, SMTP, DNS"},{"en":"TCP, UDP, IP, ARP","hi":"TCP, UDP, IP, ARP"},{"en":"JPEG, GIF, MIDI, PNG","hi":"JPEG, GIF, MIDI, PNG"}],"exp":{"en":"These represent physical layer standards, hardware connectors, and interface specifications governing raw signal transmission.\nSource-note (Hinglish): RS-232, Ethernet PHY, DSL, ISDN aur SONET/SDH ki physical specifications. RJ45 common connector label hai. USB aur Bluetooth poore standards hain, jinmein physical specification bhi hoti hai.","hi":"ये कच्चे सिग्नल ट्रांसमिशन को नियंत्रित करने वाले फिजिकल लेयर मानकों, हार्डवेयर कनेक्टर्स और इंटरफ़ेस विनिर्देशों का प्रतिनिधित्व करते हैं।"},"num":71},{"id":"q72","q":{"en":"Can firewalls and gateways be assigned to one fixed OSI layer?","hi":"क्या फ़ायरवॉल और गेटवे को एक ही निश्चित OSI लेयर का उपकरण माना जा सकता है?"},"a":{"en":"Placement depends on function. Packet filtering can use L3/L4 headers. Application proxies can understand L7 traffic","hi":"प्लेसमेंट फ़ंक्शन पर निर्भर करता है। पैकेट फ़िल्टरिंग L3/L4 हेडर का उपयोग कर सकती है। एप्लिकेशन प्रॉक्सी L7 ट्रैफ़िक को समझ सकती है"},"o":[{"en":"A firewall is always Layer 7, a gateway is always Layer 1","hi":"फ़ायरवॉल हमेशा लेयर 7 है, गेटवे हमेशा लेयर 1 है"},{"en":"Placement depends on function. Packet filtering can use L3/L4 headers. Application proxies can understand L7 traffic","hi":"प्लेसमेंट फ़ंक्शन पर निर्भर करता है। पैकेट फ़िल्टरिंग L3/L4 हेडर का उपयोग कर सकती है। एप्लिकेशन प्रॉक्सी L7 ट्रैफ़िक को समझ सकती है"},{"en":"Firewalls and gateways do not belong to the OSI model","hi":"फ़ायरवॉल और गेटवे OSI मॉडल के अंतर्गत नहीं आते हैं"},{"en":"They operate exclusively at Layer 2","hi":"वे विशेष रूप से लेयर 2 पर काम करते हैं"}],"exp":{"en":"Network security devices like firewalls and multi-protocol gateways can inspect traffic across multiple OSI layers depending on their inspection depth.\nSource-note (Hinglish): Placement function par depend karti hai. Packet filtering L3/L4 headers use kar sakti hai. Application proxy L7 traffic samajh sakta hai.","hi":"फ़ायरवॉल और मल्टी-प्रोटोकॉल गेटवे जैसे नेटवर्क सुरक्षा उपकरण अपनी निरीक्षण गहराई (inspection depth) के आधार पर कई OSI परतों में ट्रैफ़िक का निरीक्षण कर सकते हैं।"},"num":72}]},{"title":{"en":"8. TCP/IP Model & OSI Mapping","hi":"8. TCP/IP मॉडल और OSI के बीच मैपिंग"},"questions":[{"id":"q73","q":{"en":"What is the full form of TCP/IP?","hi":"TCP/IP का पूरा नाम क्या है?"},"a":{"en":"Transmission Control Protocol / Internet Protocol. The name comes from the two foundational protocols of the Internet protocol suite","hi":"ट्रांसमिशन कंट्रोल प्रोटोकॉल / इंटरनेट प्रोटोकॉल (Transmission Control Protocol / Internet Protocol)। नाम इंटरनेट प्रोटोकॉल सूट के दो मूलभूत प्रोटोकॉल से आता है"},"o":[{"en":"Transfer Control Protocol / Internet Protocol","hi":"ट्रांसफर कंट्रोल प्रोटोकॉल / इंटरनेट प्रोटोकॉल"},{"en":"Transmission Control Protocol / Internet Protocol. The name comes from the two foundational protocols of the Internet protocol suite","hi":"ट्रांसमिशन कंट्रोल प्रोटोकॉल / इंटरनेट प्रोटोकॉल (Transmission Control Protocol / Internet Protocol)। नाम इंटरनेट प्रोटोकॉल सूट के दो मूलभूत प्रोटोकॉल से आता है"},{"en":"Telecommunication Control Program / Internal Protocol","hi":"टेलीकम्युनिकेशन कंट्रोल प्रोग्राम / इंटरनल प्रोटोकॉल"},{"en":"Total Connection Processing / Information Provider","hi":"टोटल कनेक्शन प्रोसेसिंग / इंफॉर्मेशन प्रोवाइडर"}],"exp":{"en":"TCP/IP is the foundational suite of communication protocols used for the internet and most local computer networks.\nSource-note (Hinglish): Transmission Control Protocol / Internet Protocol. Naam Internet protocol suite ke do foundational protocols se aata hai.","hi":"TCP/IP इंटरनेट और अधिकांश स्थानीय कंप्यूटर नेटवर्क के लिए उपयोग किए जाने वाले संचार प्रोटोकॉल का मूल सूट है।"},"num":73},{"id":"q74","q":{"en":"Who is associated with the development of TCP/IP?","hi":"TCP/IP के विकास से कौन जुड़े हुए हैं?"},"a":{"en":"U.S. Department of Defense ARPA-funded research. Background was ARPANET in the 1960s. Early TCP spec RFC 675 was in December 1974","hi":"अमेरिकी रक्षा विभाग (U.S. Department of Defense) ARPA-वित्त पोषित अनुसंधान। पृष्ठभूमि 1960 के दशक में ARPANET थी। प्रारंभिक TCP विनिर्देश RFC 675 दिसंबर 1974 में आया था"},"o":[{"en":"Google's internal R&D in 2010","hi":"2010 में Google का आंतरिक R&D"},{"en":"U.S. Department of Defense ARPA-funded research. Background was ARPANET in the 1960s. Early TCP spec RFC 675 was in December 1974","hi":"अमेरिकी रक्षा विभाग (U.S. Department of Defense) ARPA-वित्त पोषित अनुसंधान। पृष्ठभूमि 1960 के दशक में ARPANET थी। प्रारंभिक TCP विनिर्देश RFC 675 दिसंबर 1974 में आया था"},{"en":"Microsoft Windows development in 1995","hi":"1995 में Microsoft Windows विकास"},{"en":"Apple Macintosh networking in 1984","hi":"1984 में Apple Macintosh नेटवर्किंग"}],"exp":{"en":"The TCP/IP architecture was developed by Vint Cerf, Bob Kahn, and others under a DARPA contract to connect disparate packet-switching networks.\nSource-note (Hinglish): U.S. Department of Defense ki ARPA-funded research se. 1960s ka ARPANET background tha. TCP ka early specification RFC 675 December 1974 mein aaya.","hi":"TCP/IP आर्किटेक्चर को विंट सर्फ, बॉब काहिन और अन्य द्वारा भिन्न पैकेट-स्विचिंग नेटवर्क को जोड़ने के लिए DARPA अनुबंध के तहत विकसित किया गया था।"},"num":74},{"id":"q75","q":{"en":"What are the four TCP/IP layers from bottom to top?","hi":"TCP/IP मॉडल की चार लेयर नीचे से ऊपर तक कौन-सी हैं?"},"a":{"en":"Link/Network Access → Internet → Transport/Host-to-Host → Application","hi":"लिंक/नेटवर्क एक्सेस → इंटरनेट → ट्रांसपोर्ट/होस्ट-टू-होस्ट → एप्लिकेशन"},"o":[{"en":"Physical, Data Link, Network, Transport","hi":"फिजिकल, डेटा लिंक, नेटवर्क, ट्रांसपोर्ट"},{"en":"Link/Network Access → Internet → Transport/Host-to-Host → Application","hi":"लिंक/नेटवर्क एक्सेस → इंटरनेट → ट्रांसपोर्ट/होस्ट-टू-होस्ट → एप्लिकेशन"},{"en":"Session, Presentation, Application, Transport","hi":"सेशन, प्रेजेंटेशन, एप्लीकेशन, ट्रांसपोर्ट"},{"en":"Application, Transport, Network, Physical","hi":"एप्लीकेशन, ट्रांसपोर्ट, नेटवर्क, फिजिकल"}],"exp":{"en":"These are the four official layers of the TCP/IP (Internet) reference model from bottom to top.\nSource-note (Hinglish): Link/Network Access → Internet → Transport/Host-to-Host → Application.","hi":"ये नीचे से ऊपर तक TCP/IP (इंटरनेट) संदर्भ मॉडल की चार आधिकारिक परतें हैं।"},"num":75},{"id":"q76","q":{"en":"Which OSI layers map to the TCP/IP Application Layer?","hi":"OSI की कौन-सी लेयर TCP/IP की एप्लिकेशन लेयर में आती हैं?"},"a":{"en":"OSI Application (L7), Presentation (L6), and Session (L5) roughly map into the TCP/IP Application Layer","hi":"OSI एप्लीकेशन (L7), प्रेजेंटेशन (L6), और सेशन (L5) मोटे तौर पर TCP/IP एप्लीकेशन लेयर में मैप होते हैं"},"o":[{"en":"Only L7 Application","hi":"केवल L7 एप्लिकेशन"},{"en":"OSI Application (L7), Presentation (L6), and Session (L5) roughly map into the TCP/IP Application Layer","hi":"OSI एप्लीकेशन (L7), प्रेजेंटेशन (L6), और सेशन (L5) मोटे तौर पर TCP/IP एप्लीकेशन लेयर में मैप होते हैं"},{"en":"Only L4 Transport","hi":"केवल L4 ट्रांसपोर्ट"},{"en":"Only L3 Network","hi":"केवल L3 नेटवर्क"}],"exp":{"en":"The TCP/IP model combines the upper three OSI layers into a single comprehensive Application Layer.\nSource-note (Hinglish): OSI Application (L7), Presentation (L6) aur Session (L5) roughly TCP/IP Application Layer mein map hoti hain.","hi":"TCP/IP मॉडल OSI की ऊपरी तीन परतों को एक एकल व्यापक एप्लिकेशन लेयर में जोड़ता है।"},"num":76},{"id":"q77","q":{"en":"What are the OSI counterparts of the TCP/IP Transport and Internet Layers?","hi":"TCP/IP की ट्रांसपोर्ट और इंटरनेट लेयर की समकक्ष OSI लेयर कौन-सी हैं?"},"a":{"en":"Transport ≈ Transport (L4); Internet ≈ Network (L3)","hi":"ट्रांसपोर्ट ≈ ट्रांसपोर्ट (L4); इंटरनेट ≈ नेटवर्क (L3)"},"o":[{"en":"Transport ≈ Transport (L4); Internet ≈ Network (L3)","hi":"ट्रांसपोर्ट ≈ ट्रांसपोर्ट (L4); इंटरनेट ≈ नेटवर्क (L3)"},{"en":"Transport ≈ Network (L3); Internet ≈ Transport (L4)","hi":"ट्रांसपोर्ट ≈ नेटवर्क (L3); इंटरनेट ≈ ट्रांसपोर्ट (L4)"},{"en":"Transport ≈ Application (L7); Internet ≈ Physical (L1)","hi":"ट्रांसपोर्ट ≈ एप्लिकेशन (L7); इंटरनेट ≈ फिजिकल (L1)"},{"en":"Transport ≈ Data Link (L2); Internet ≈ Session (L5)","hi":"ट्रांसपोर्ट ≈ डेटा लिंक (L2); इंटरनेट ≈ सेशन (L5)"}],"exp":{"en":"These two layers in the TCP/IP suite directly correspond in function to the Transport and Network layers of the OSI model.\nSource-note (Hinglish): TCP/IP Transport ≈ OSI Transport (L4). TCP/IP Internet ≈ OSI Network (L3).","hi":"TCP/IP सूट में ये दो परतें कार्य में OSI मॉडल की ट्रांसपोर्ट और नेटवर्क परतों के सीधे अनुरूप हैं।"},"num":77},{"id":"q78","q":{"en":"Which OSI layers are included in the TCP/IP Network Access Layer?","hi":"OSI की कौन-सी लेयर TCP/IP नेटवर्क एक्सेस लेयर में आती हैं?"},"a":{"en":"OSI Data Link (L2) and Physical (L1) map to the TCP/IP Link/Network Access Layer (often called Link Layer)","hi":"OSI डेटा लिंक (L2) और फिजिकल (L1) TCP/IP लिंक/नेटवर्क एक्सेस लेयर (जिसे अक्सर लिंक लेयर कहा जाता है) पर मैप होते हैं"},"o":[{"en":"Physical Layer and Data Link Layer","hi":"फिजिकल लेयर और डेटा लिंक लेयर"},{"en":"OSI Data Link (L2) and Physical (L1) map to the TCP/IP Link/Network Access Layer (often called Link Layer)","hi":"OSI डेटा लिंक (L2) और फिजिकल (L1) TCP/IP लिंक/नेटवर्क एक्सेस लेयर (जिसे अक्सर लिंक लेयर कहा जाता है) पर मैप होते हैं"},{"en":"Session Layer and Presentation Layer","hi":"सेशन लेयर और प्रेजेंटेशन लेयर"},{"en":"Application Layer and Transport Layer","hi":"एप्लिकेशन लेयर और ट्रांसपोर्ट लेयर"}],"exp":{"en":"The TCP/IP Link layer encompasses all the hardware and media details defined in OSI Layers 1 and 2.\nSource-note (Hinglish): Data Link (L2) aur Physical (L1). Network Access ko Link Layer bhi kehte hain.","hi":"TCP/IP लिंक लेयर में OSI लेयर 1 और 2 में परिभाषित सभी हार्डवेयर और मीडिया विवरण शामिल हैं।"},"num":78},{"id":"q79","q":{"en":"What is the function of each of the four TCP/IP layers?","hi":"TCP/IP की चारों लेयर का एक-एक प्रमुख कार्य क्या है?"},"a":{"en":"Application → network services. Transport → application endpoints. Internet → packet addressing/routing. Link → local medium and frames","hi":"एप्लिकेशन → नेटवर्क सेवाएं। ट्रांसपोर्ट → एप्लिकेशन एंडपॉइंट। इंटरनेट → पैकेट एड्रेसिंग/रूटिंग। लिंक → स्थानीय माध्यम और फ्रेम"},"o":[{"en":"Application → routing; Transport → framing; Internet → bits; Link → web pages","hi":"एप्लिकेशन → रूटिंग; ट्रांसपोर्ट → फ्रेमिंग; इंटरनेट → बिट्स; लिंक → वेब पेज"},{"en":"Application → network services. Transport → application endpoints. Internet → packet addressing/routing. Link → local medium and frames","hi":"एप्लिकेशन → नेटवर्क सेवाएं। ट्रांसपोर्ट → एप्लिकेशन एंडपॉइंट। इंटरनेट → पैकेट एड्रेसिंग/रूटिंग। लिंक → स्थानीय माध्यम और फ्रेम"},{"en":"All layers do the same thing","hi":"सभी परतें एक ही काम करती हैं"},{"en":"None of the above","hi":"इनमें से कोई नहीं"}],"exp":{"en":"This summarizes the core responsibility of each of the four layers in the TCP/IP model stack.\nSource-note (Hinglish): Application → network services. Transport → application endpoints. Internet → packet addressing/routing. Link → local medium aur frames.","hi":"यह TCP/IP मॉडल स्टैक में चार परतों में से प्रत्येक की मुख्य जिम्मेदारी को सारांशित करता है।"},"num":79},{"id":"q80","q":{"en":"What are the uses of the OSI and TCP/IP models?","hi":"OSI और TCP/IP मॉडल का उपयोग क्या है?"},"a":{"en":"OSI is a seven-layer reference model for networking functions. The TCP/IP model organizes the Internet protocol suite into four broad layers. The mapping is conceptual","hi":"OSI नेटवर्किंग कार्यों के लिए सात-परत संदर्भ मॉडल है। TCP/IP मॉडल इंटरनेट प्रोटोकॉल सूट को चार व्यापक परतों में व्यवस्थित करता है। मैपिंग वैचारिक (conceptual) है"},"o":[{"en":"They are completely identical","hi":"वे पूरी तरह से समान हैं"},{"en":"OSI is a seven-layer reference model for networking functions. The TCP/IP model organizes the Internet protocol suite into four broad layers. The mapping is conceptual","hi":"OSI नेटवर्किंग कार्यों के लिए सात-परत संदर्भ मॉडल है। TCP/IP मॉडल इंटरनेट प्रोटोकॉल सूट को चार व्यापक परतों में व्यवस्थित करता है। मैपिंग वैचारिक (conceptual) है"},{"en":"TCP/IP is older than OSI","hi":"TCP/IP, OSI से पुराना है"},{"en":"OSI replaced TCP/IP globally","hi":"OSI ने वैश्विक स्तर पर TCP/IP की जगह ली"}],"exp":{"en":"While OSI is a conceptual reference framework, TCP/IP is the practical protocol suite actually used to run the modern internet.\nSource-note (Hinglish): OSI networking functions ka seven-layer reference model hai. TCP/IP model Internet protocol suite ko four broad layers mein organize karta hai. Mapping conceptual hai.","hi":"जबकि OSI एक वैचारिक संदर्भ ढांचा है, TCP/IP वास्तविक प्रोटोकॉल सूट है जिसका उपयोग वास्तव में आधुनिक इंटरनेट को चलाने के लिए किया जाता है।"},"num":80},{"id":"q81","q":{"en":"Why do some textbooks describe the TCP/IP model as having five layers?","hi":"कुछ पाठ्यपुस्तकें TCP/IP मॉडल को पांच परतों (five layers) का क्यों बताती हैं?"},"a":{"en":"Teaching variants split the Link/Network Access Layer into separate Data Link and Physical layers, whereas RFC 1122 uses a four-layer organization","hi":"शिक्षण संस्करण (teaching variants) लिंक/नेटवर्क एक्सेस लेयर को अलग डेटा लिंक और फिजिकल लेयर्स में विभाजित करते हैं, जबकि RFC 1122 चार-परत संगठन का उपयोग करता है"},"o":[{"en":"Because they add a separate Security Layer","hi":"क्योंकि वे एक अलग सुरक्षा परत जोड़ते हैं"},{"en":"Teaching variants split the Link/Network Access Layer into separate Data Link and Physical layers, whereas RFC 1122 uses a four-layer organization","hi":"शिक्षण संस्करण (teaching variants) लिंक/नेटवर्क एक्सेस लेयर को अलग डेटा लिंक और फिजिकल लेयर्स में विभाजित करते हैं, जबकि RFC 1122 चार-परत संगठन का उपयोग करता है"},{"en":"Because the Internet added an extra layer in 2020","hi":"क्योंकि इंटरनेट ने 2020 में एक अतिरिक्त परत जोड़ी"},{"en":"Because Session Layer was merged with Transport Layer","hi":"क्योंकि सेशन लेयर को ट्रांसपोर्ट लेयर में मिला दिया गया था"}],"exp":{"en":"Computer networking textbooks (like Forouzan or Tanenbaum) often use a 5-layer pedagogical TCP/IP model (Physical, Data Link, Network, Transport, Application) to make it easier to map directly to the OSI model, while standard RFC 1122 specifies four layers.\nSource-note (Hinglish): Teaching variant Link ko Data Link aur Physical mein split karta hai. Is chapter ka Internet model RFC 1122 ki four-layer organization follow karta hai.","hi":"कंप्यूटर नेटवर्किंग पाठ्यपुस्तकें (जैसे Forouzan या Tanenbaum) अक्सर OSI मॉडल के साथ सीधे मैप करना आसान बनाने के लिए 5-परत शैक्षणिक TCP/IP मॉडल (फिजिकल, डेटा लिंक, नेटवर्क, ट्रांसपोर्ट, एप्लिकेशन) का उपयोग करती हैं, जबकि आधिकारिक RFC 1122 चार परतों को निर्दिष्ट करता है।"},"num":81}]},{"title":{"en":"9. Exam Trap Reverse-Questions","hi":"9. परीक्षा के महत्वपूर्ण उल्टे प्रश्न"},"questions":[{"id":"q82","q":{"en":"Identify the OSI layers corresponding to Frame, Packet, and TCP Segment.","hi":"फ्रेम (Frame), पैकेट (Packet) और टीसीपी सेगमेंट (TCP Segment) से संबंधित OSI लेयर्स की पहचान करें।"},"a":{"en":"Frame → L2 Data Link; Packet → L3 Network; TCP segment → L4 Transport","hi":"फ्रेम → L2 डेटा लिंक; पैकेट → L3 नेटवर्क; TCP सेगमेंट → L4 ट्रांसपोर्ट"},"o":[{"en":"Frame → L1 Physical; Packet → L2 Data Link; Segment → L3 Network","hi":"फ्रेम → L1 फिजिकल; पैकेट → L2 डेटा लिंक; सेगमेंट → L3 नेटवर्क"},{"en":"Frame → L2 Data Link; Packet → L3 Network; TCP segment → L4 Transport","hi":"फ्रेम → L2 डेटा लिंक; पैकेट → L3 नेटवर्क; TCP सेगमेंट → L4 ट्रांसपोर्ट"},{"en":"Frame → L3 Network; Packet → L4 Transport; Segment → L5 Session","hi":"फ्रेम → L3 नेटवर्क; पैकेट → L4 ट्रांसपोर्ट; सेगमेंट → L5 सेशन"},{"en":"Frame → L4 Transport; Packet → L2 Data Link; Segment → L1 Physical","hi":"फ्रेम → L4 ट्रांसपोर्ट; पैकेट → L2 डेटा लिंक; सेगमेंट → L1 फिजिकल"}],"exp":{"en":"These are the fundamental Protocol Data Units (PDUs): Data Link encapsulates into Frames (L2), Network encapsulates into Packets (L3), and Transport encapsulates into Segments (L4).\nSource-note (Hinglish): Frame → L2 Data Link. Packet → L3 Network. TCP segment → L4 Transport.","hi":"ये मूलभूत प्रोटोकॉल डेटा इकाइयां (PDUs) हैं: डेटा लिंक फ्रेम्स (L2) में समाहित करता है, नेटवर्क पैकेट्स (L3) में, और ट्रांसपोर्ट सेगमेंट्स (L4) में।"},"num":82},{"id":"q83","q":{"en":"Bit timing, bit rate control, and transmission modes (simplex/duplex) are all clues for which OSI layer?","hi":"बिट टाइमिंग (Bit timing), बिट रेट कंट्रोल (bit rate) और ट्रांसमिशन मोड (simplex/duplex) एक साथ दिए गए हैं। यह किस लेयर के संकेत हैं?"},"a":{"en":"L1 Physical Layer","hi":"L1 फिजिकल लेयर"},"o":[{"en":"L2 Data Link Layer","hi":"L2 डेटा लिंक लेयर"},{"en":"L1 Physical Layer","hi":"L1 फिजिकल लेयर"},{"en":"L3 Network Layer","hi":"L3 नेटवर्क लेयर"},{"en":"L4 Transport Layer","hi":"L4 ट्रांसपोर्ट लेयर"}],"exp":{"en":"All physical transmission parameters, including bit signaling, timing synchronization, line rate, and transmission modes, operate strictly at Layer 1 (Physical).\nSource-note (Hinglish): L1 Physical.","hi":"बिट सिग्नलिंग, टाइमिंग सिंक्रोनाइज़ेशन, लाइन रेट और ट्रांसमिशन मोड सहित सभी भौतिक संचरण पैरामीटर विशेष रूप से लेयर 1 (फिजिकल) पर काम करते हैं।"},"num":83},{"id":"q84","q":{"en":"Framing and shared-medium access control are both distinctive clues for which OSI layer?","hi":"फ्रेमिंग (Framing) और शेयर्ड-मीडियम एक्सेस कंट्रोल (shared-medium access) दोनों किस लेयर के मुख्य लक्षण हैं?"},"a":{"en":"L2 Data Link Layer (specifically MAC sublayer handles medium access)","hi":"L2 डेटा लिंक लेयर (विशेष रूप से MAC सबलेयर माध्यम एक्सेस को संभालती है)"},"o":[{"en":"L1 Physical Layer","hi":"L1 फिजिकल लेयर"},{"en":"L2 Data Link Layer (specifically MAC sublayer handles medium access)","hi":"L2 डेटा लिंक लेयर (विशेष रूप से MAC सबलेयर माध्यम एक्सेस को संभालती है)"},{"en":"L3 Network Layer","hi":"L3 नेटवर्क लेयर"},{"en":"L5 Session Layer","hi":"L5 सेशन लेयर"}],"exp":{"en":"Framing defines frame boundaries for local link transmission, while Media Access Control (MAC) manages contention on shared physical media like Ethernet or Wi-Fi.\nSource-note (Hinglish): L2 Data Link. Medium access specifically MAC sublayer ka role hai.","hi":"फ्रेमिंग स्थानीय लिंक ट्रांसमिशन के लिए फ्रेम सीमाओं को परिभाषित करती है, जबकि मीडिया एक्सेस कंट्रोल (MAC) ईथरनेट या वाई-फाई जैसे साझा माध्यम पर टकराव का प्रबंधन करती है।"},"num":84},{"id":"q85","q":{"en":"During packet forwarding across a router, why does the Ethernet destination MAC address change while the destination IP address remains the same?","hi":"राउटर के पार पैकेट फॉरवर्डिंग में ईथरनेट गंतव्य MAC (destination MAC) क्यों बदलता है जबकि गंतव्य IP (destination IP) समान रहता है?"},"a":{"en":"Each link creates a new frame for the next hop, so destination MAC identifies the next router interface, while IP identifies the final end-host","hi":"प्रत्येक लिंक अगले हॉप के लिए एक नया फ्रेम बनाता है, इसलिए गंतव्य MAC अगले राउटर इंटरफेस की पहचान करता है, जबकि IP अंतिम एंड-होस्ट की पहचान करता है"},"o":[{"en":"Because MAC addresses are randomly generated on each hop","hi":"क्योंकि प्रत्येक हॉप पर MAC पते बेतरतीब ढंग से उत्पन्न होते हैं"},{"en":"Each link creates a new frame for the next hop, so destination MAC identifies the next router interface, while IP identifies the final end-host","hi":"प्रत्येक लिंक अगले हॉप के लिए एक नया फ्रेम बनाता है, इसलिए गंतव्य MAC अगले राउटर इंटरफेस की पहचान करता है, जबकि IP अंतिम एंड-होस्ट की पहचान करता है"},{"en":"Because routers always encrypt the MAC address","hi":"क्योंकि राउटर हमेशा MAC पते को एन्क्रिप्ट करते हैं"},{"en":"Because IP addresses cannot be read by routers","hi":"क्योंकि IP पते को राउटर द्वारा पढ़ा नहीं जा सकता"}],"exp":{"en":"MAC addresses have hop-by-hop local scope, changing at every router interface. IP addresses have end-to-end global scope, remaining unchanged from source to destination (unless rewritten by NAT).\nSource-note (Hinglish): Har link ka frame next hop ke liye banaya jaata hai. IP destination end host ko identify karta hai, jab tak NAT ya doosra rewriting mechanism use na ho.","hi":"MAC पते हॉप-बाय-हॉप स्थानीय दायरे के होते हैं, जो हर राउटर इंटरफेस पर बदलते हैं। IP पते एंड-टू-एंड वैश्विक दायरे के होते हैं, जो स्रोत से गंतव्य तक अपरिवर्तित रहते हैं (जब तक कि NAT द्वारा दोबारा न लिखा जाए)।"},"num":85},{"id":"q86","q":{"en":"Which OSI layers correspond to 'Node-to-node delivery' and 'Process-to-process delivery' respectively?","hi":"'नोड-टू-नोड डिलीवरी' (Node-to-node) और 'प्रोसेस-टू-प्रोसेस डिलीवरी' (Process-to-process) क्रमशः किन परतों से संबंधित हैं?"},"a":{"en":"Node-to-node → Data Link Layer; Process-to-process → Transport Layer (while host-to-host internetwork delivery is Network Layer)","hi":"नोड-टू-नोड → डेटा लिंक लेयर; प्रोसेस-टू-प्रोसेस → ट्रांसपोर्ट लेयर (जबकि होस्ट-टू-होस्ट इंटरनेटवर्क डिलीवरी नेटवर्क लेयर है)"},"o":[{"en":"Node-to-node → Physical; Process-to-process → Network","hi":"नोड-टू-नोड → फिजिकल; प्रोसेस-टू-प्रोसेस → नेटवर्क"},{"en":"Node-to-node → Data Link Layer; Process-to-process → Transport Layer (while host-to-host internetwork delivery is Network Layer)","hi":"नोड-टू-नोड → डेटा लिंक लेयर; प्रोसेस-टू-प्रोसेस → ट्रांसपोर्ट लेयर (जबकि होस्ट-टू-होस्ट इंटरनेटवर्क डिलीवरी नेटवर्क लेयर है)"},{"en":"Node-to-node → Transport; Process-to-process → Application","hi":"नोड-टू-नोड → ट्रांसपोर्ट; प्रोसेस-टू-प्रोसेस → एप्लिकेशन"},{"en":"Node-to-node → Network; Process-to-process → Session","hi":"नोड-टू-नोड → नेटवर्क; प्रोसेस-टू-प्रोसेस → सेशन"}],"exp":{"en":"Exam terminology traps: Data Link = Node-to-node / hop-to-hop; Network = Host-to-host / source-to-destination; Transport = Process-to-process / port-to-port.\nSource-note (Hinglish): Node-to-node → Data Link. Process-to-process → Transport. Hosts ke beech internetwork delivery → Network.","hi":"परीक्षा शब्दावली जाल: डेटा लिंक = नोड-टू-नोड / हॉप-टू-हॉप; नेटवर्क = होस्ट-टू-होस्ट; ट्रांसपोर्ट = प्रोसेस-टू-प्रोसेस / पोर्ट-टू-पोर्ट।"},"num":86},{"id":"q87","q":{"en":"If an exam question mentions 'Checkpointing' and 'Format conversion', which two OSI layers are being referred to?","hi":"यदि किसी प्रश्न में 'चेकपॉइंटिंग' (Checkpoint) और 'प्रारूप रूपांतरण' (Format conversion) दिए गए हैं, तो वे कौन सी दो परतें हैं?"},"a":{"en":"Checkpoint → Session Layer (L5); Format conversion → Presentation Layer (L6)","hi":"चेकपॉइंट → सेशन लेयर (L5); प्रारूप रूपांतरण → प्रेजेंटेशन लेयर (L6)"},"o":[{"en":"Checkpoint → Transport; Format conversion → Application","hi":"चेकपॉइंट → ट्रांसपोर्ट; फ़ॉर्मेट कन्वर्ज़न → एप्लिकेशन"},{"en":"Checkpoint → Session Layer (L5); Format conversion → Presentation Layer (L6)","hi":"चेकपॉइंट → सेशन लेयर (L5); प्रारूप रूपांतरण → प्रेजेंटेशन लेयर (L6)"},{"en":"Checkpoint → Data Link; Format conversion → Physical","hi":"चेकपॉइंट → डेटा लिंक; फ़ॉर्मेट कन्वर्ज़न → फिजिकल"},{"en":"Checkpoint → Network; Format conversion → Session","hi":"चेकपॉइंट → नेटवर्क; फ़ॉर्मेट कन्वर्ज़न → सेशन"}],"exp":{"en":"Checkpointing and synchronization belong exclusively to the Session Layer (L5), while syntax, formatting, and translation belong to the Presentation Layer (L6).\nSource-note (Hinglish): Checkpoint → Session. Format conversion → Presentation.","hi":"चेकपॉइंटिंग और सिंक्रोनाइज़ेशन विशेष रूप से सेशन लेयर (L5) के हैं, जबकि सिंटैक्स, स्वरूपण और अनुवाद प्रेजेंटेशन लेयर (L6) से संबंधित हैं।"},"num":87},{"id":"q88","q":{"en":"Match 'Port addressing' and 'IP addressing' to their correct OSI layers.","hi":"'पोर्ट एड्रेसिंग' (Port addressing) और 'आईपी एड्रेसिंग' (IP addressing) को सही OSI लेयर्स से सुमेलित करें।"},"a":{"en":"Port → L4 Transport Layer; IP → L3 Network Layer","hi":"पोर्ट → L4 ट्रांसपोर्ट लेयर; IP → L3 नेटवर्क लेयर"},"o":[{"en":"Port → L3 Network; IP → L2 Data Link","hi":"पोर्ट → L3 नेटवर्क; IP → L2 डेटा लिंक"},{"en":"Port → L4 Transport Layer; IP → L3 Network Layer","hi":"पोर्ट → L4 ट्रांसपोर्ट लेयर; IP → L3 नेटवर्क लेयर"},{"en":"Port → L5 Session Layer; IP → L4 Transport Layer","hi":"पोर्ट → L5 सेशन; IP → L4 ट्रांसपोर्ट"},{"en":"Port → L7 Application Layer; IP → L1 Physical Layer","hi":"पोर्ट → L7 एप्लिकेशन; IP → L1 फिजिकल"}],"exp":{"en":"Port addresses identify specific processes at the Transport Layer (Layer 4), while IP addresses logically identify hosts at the Network Layer (Layer 3).\nSource-note (Hinglish): Port → L4 Transport. IP → L3 Network.","hi":"पोर्ट पते ट्रांसपोर्ट लेयर (लेयर 4) पर विशिष्ट प्रक्रियाओं की पहचान करते हैं, जबकि IP पते नेटवर्क लेयर (लेयर 3) पर होस्ट की तार्किक रूप से पहचान करते हैं।"},"num":88},{"id":"q89","q":{"en":"What is the key exam distinction between a standard Ethernet switch and a Layer-3 switch?","hi":"एक सामान्य ईथरनेट स्विच (L2 Switch) और लेयर-3 स्विच (L3 Switch) के बीच मुख्य परीक्षा अंतर क्या है?"},"a":{"en":"A standard L2 switch forwards frames based on MAC addresses, while a Layer-3 switch inspects IP packets and performs hardware routing","hi":"एक सामान्य L2 स्विच MAC पते के आधार पर फ्रेम अग्रेषित करता है, जबकि लेयर-3 स्विच IP पैकेट का निरीक्षण करता है और हार्डवेयर रूटिंग करता है"},"o":[{"en":"Standard switch has faster ports than Layer-3 switch","hi":"मानक स्विच में लेयर-3 स्विच की तुलना में तेज़ पोर्ट होते हैं"},{"en":"A standard L2 switch forwards frames based on MAC addresses, while a Layer-3 switch inspects IP packets and performs hardware routing","hi":"एक सामान्य L2 स्विच MAC पते के आधार पर फ्रेम अग्रेषित करता है, जबकि लेयर-3 स्विच IP पैकेट का निरीक्षण करता है और हार्डवेयर रूटिंग करता है"},{"en":"Layer-3 switch connects wireless devices only","hi":"लेयर-3 स्विच केवल वायरलेस उपकरणों को जोड़ता है"},{"en":"Standard switch can route traffic across WANs","hi":"मानक स्विच WAN में ट्रैफ़िक रूट कर सकता है"}],"exp":{"en":"Standard switches operate purely at Layer 2 using MAC tables, whereas Layer 3 switches combine switching speed with IP routing capabilities.\nSource-note (Hinglish): Normal L2 switch MAC frames forward karta hai. Layer-3 switch IP routing bhi karta hai.","hi":"मानक स्विच पूरी तरह से MAC टेबल का उपयोग करके लेयर 2 पर काम करते हैं, जबकि लेयर 3 स्विच आईपी रूटिंग क्षमताओं के साथ स्विचिंग गति को जोड़ते हैं।"},"num":89},{"id":"q90","q":{"en":"UDP is connectionless. Can an application running on top of UDP implement its own acknowledgments (ACKs)?","hi":"UDP कनेक्शनलेस है। क्या UDP के ऊपर चलने वाला एप्लिकेशन अपनी स्वयं की पावती (ACK) भेज सकता है?"},"a":{"en":"Yes. Built-in transport acknowledgment (TCP) and application-level acknowledgment are separate mechanisms. An application can add retries and ACKs over UDP","hi":"हाँ। बिल्ट-इन ट्रांसपोर्ट पावती (TCP) और एप्लिकेशन-स्तरीय पावती अलग तंत्र हैं। एक एप्लिकेशन UDP पर पुनः प्रयास और ACK जोड़ सकता है"},"o":[{"en":"No, applications are strictly forbidden from implementing ACKs","hi":"नहीं, अनुप्रयोगों को ACK लागू करने से पूरी तरह से मना किया गया है"},{"en":"Yes. Built-in transport acknowledgment (TCP) and application-level acknowledgment are separate mechanisms. An application can add retries and ACKs over UDP","hi":"हाँ। बिल्ट-इन ट्रांसपोर्ट पावती (TCP) और एप्लिकेशन-स्तरीय पावती अलग तंत्र हैं। एक एप्लिकेशन UDP पर पुनः प्रयास और ACK जोड़ सकता है"},{"en":"No, because UDP drops all acknowledgment packets","hi":"नहीं, क्योंकि UDP सभी पावती पैकेटों को छोड़ देता है"},{"en":"Only if the hardware supports it","hi":"केवल तभी जब हार्डवेयर इसका समर्थन करता है"}],"exp":{"en":"Protocols like DNS, TFTP, and HTTP/3 (QUIC) use UDP at the transport layer but implement their own reliability, timeouts, or acknowledgments at the application layer.\nSource-note (Hinglish): Haan. Built-in UDP transport acknowledgment aur app-level acknowledgment alag mechanisms hain.","hi":"DNS, TFTP, और HTTP/3 (QUIC) जैसे प्रोटोकॉल ट्रांसपोर्ट लेयर पर UDP का उपयोग करते हैं लेकिन एप्लिकेशन लेयर पर अपनी स्वयं की विश्वसनीयता, टाइमआउट या पावती लागू करते हैं।"},"num":90},{"id":"q91","q":{"en":"Does the TCP/IP Link Layer map only to OSI Layer 2?","hi":"क्या TCP/IP का लिंक लेयर (Link Layer) केवल OSI लेयर 2 से मैप होता है?"},"a":{"en":"No. In the classic four-layer model, the Link/Network Access Layer encompasses both OSI Layer 1 (Physical) and Layer 2 (Data Link)","hi":"नहीं। क्लासिक चार-परत मॉडल में, लिंक/नेटवर्क एक्सेस लेयर OSI लेयर 1 (फिजिकल) और लेयर 2 (डेटा लिंक) दोनों को शामिल करता है"},"o":[{"en":"Yes, strictly to Layer 2","hi":"हाँ, पूरी तरह से लेयर 2 पर"},{"en":"No. In the classic four-layer model, the Link/Network Access Layer encompasses both OSI Layer 1 (Physical) and Layer 2 (Data Link)","hi":"नहीं। क्लासिक चार-परत मॉडल में, लिंक/नेटवर्क एक्सेस लेयर OSI लेयर 1 (फिजिकल) और लेयर 2 (डेटा लिंक) दोनों को शामिल करता है"},{"en":"No, it maps to Layer 3 and Layer 4","hi":"नहीं, यह लेयर 3 और लेयर 4 पर मैप होता है"},{"en":"It maps to all 7 OSI layers","hi":"यह सभी 7 OSI परतों पर मैप होता है"}],"exp":{"en":"In the standard RFC 1122 Internet model, the Link layer handles everything necessary to put packets onto the physical wire, combining OSI L1 and L2.\nSource-note (Hinglish): Is four-layer model mein Link/Network Access ≈ OSI Layers 1 aur 2.","hi":"मानक RFC 1122 इंटरनेट मॉडल में, लिंक लेयर भौतिक तार पर पैकेट डालने के लिए आवश्यक हर चीज को संभालता है, जो OSI L1 और L2 को जोड़ता है।"},"num":91}]},{"title":{"en":"10. Rapid-Fire Final Revision","hi":"10. त्वरित अंतिम पुनरावृत्ति"},"questions":[{"id":"q92","q":{"en":"How many layers are in the OSI Reference Model?","hi":"OSI संदर्भ मॉडल (Reference Model) में कुल कितनी परतें (layers) हैं?"},"a":{"en":"7 layers","hi":"7 परतें"},"o":[{"en":"4 layers","hi":"4 परतें"},{"en":"7 layers","hi":"7 परतें"},{"en":"5 layers","hi":"5 परतें"},{"en":"6 layers","hi":"6 परतें"}],"exp":{"en":"The OSI (Open Systems Interconnection) reference model defines exactly 7 distinct architectural layers (L1 to L7).\nSource-note (Hinglish): 7.","hi":"OSI (ओपन सिस्टम्स इंटरकनेक्शन) संदर्भ मॉडल में ठीक 7 अलग-अलग वास्तुशिल्प परतें (L1 से L7) परिभाषित हैं।"},"num":92},{"id":"q93","q":{"en":"How many layers are in the classic TCP/IP reference model (RFC 1122)?","hi":"क्लासिक TCP/IP संदर्भ मॉडल (RFC 1122) में कुल कितनी परतें (layers) हैं?"},"a":{"en":"4 layers (Link, Internet, Transport, Application)","hi":"4 परतें (लिंक, इंटरनेट, ट्रांसपोर्ट, एप्लिकेशन)"},"o":[{"en":"7 layers","hi":"7 परतें"},{"en":"4 layers (Link, Internet, Transport, Application)","hi":"4 परतें (लिंक, इंटरनेट, ट्रांसपोर्ट, एप्लिकेशन)"},{"en":"3 layers","hi":"3 परतें"},{"en":"5 layers","hi":"5 परतें"}],"exp":{"en":"RFC 1122 defines the Internet architecture into four conceptual layers: Link, Internet, Transport, and Application.\nSource-note (Hinglish): 4.","hi":"RFC 1122 इंटरनेट आर्किटेक्चर को चार वैचारिक परतों में परिभाषित करता है: लिंक, इंटरनेट, ट्रांसपोर्ट और एप्लिकेशन।"},"num":93},{"id":"q94","q":{"en":"What are the default OSI layer numbers for a Hub, Bridge, and Router respectively?","hi":"हब (Hub), ब्रिज (Bridge) और राउटर (Router) की डिफ़ॉल्ट लेयर संख्याएँ क्रमशः क्या हैं?"},"a":{"en":"Hub = L1 (Physical), Bridge = L2 (Data Link), Router = L3 (Network)","hi":"हब = L1 (फिजिकल), ब्रिज = L2 (डेटा लिंक), राउटर = L3 (नेटवर्क)"},"o":[{"en":"Hub = L2, Bridge = L3, Router = L4","hi":"हब = L2; ब्रिज = L3; राउटर = L4"},{"en":"Hub = L1 (Physical), Bridge = L2 (Data Link), Router = L3 (Network)","hi":"हब = L1 (फिजिकल), ब्रिज = L2 (डेटा लिंक), राउटर = L3 (नेटवर्क)"},{"en":"Hub = L3, Bridge = L2, Router = L1","hi":"हब = L3; ब्रिज = L2; राउटर = L1"},{"en":"Hub = L1, Bridge = L4, Router = L7","hi":"हब = L1; ब्रिज = L4; राउटर = L7"}],"exp":{"en":"A hub regenerates physical electrical signals (L1), a bridge inspects MAC addresses to filter frames (L2), and a router evaluates IP addresses to route packets (L3).\nSource-note (Hinglish): Hub L1, bridge L2, router L3.","hi":"एक हब भौतिक विद्युत संकेतों को पुन: उत्पन्न करता है (L1), एक ब्रिज फ्रेम को फ़िल्टर करने के लिए MAC पतों का निरीक्षण करता है (L2), और एक राउटर पैकेट को रूट करने के लिए IP पतों का मूल्यांकन करता है (L3)।"},"num":94},{"id":"q95","q":{"en":"What is the official layer number of the Session Layer in the OSI model?","hi":"OSI मॉडल में सेशन लेयर (Session Layer) का आधिकारिक लेयर नंबर क्या है?"},"a":{"en":"Layer 5","hi":"लेयर 5"},"o":[{"en":"Layer 4","hi":"लेयर 4"},{"en":"Layer 5","hi":"लेयर 5"},{"en":"Layer 6","hi":"लेयर 6"},{"en":"Layer 3","hi":"लेयर 3"}],"exp":{"en":"Session Layer is Layer 5, situated between Transport Layer (L4) and Presentation Layer (L6).\nSource-note (Hinglish): L5.","hi":"सेशन लेयर लेयर 5 है, जो ट्रांसपोर्ट लेयर (L4) और प्रेजेंटेशन लेयर (L6) के बीच स्थित है।"},"num":95},{"id":"q96","q":{"en":"What is the standard official OSI name for the layer often termed the 'Translation Layer'?","hi":"अक्सर 'ट्रांसलेशन लेयर' (Translation Layer) कहे जाने वाले लेयर का मानक आधिकारिक OSI नाम क्या है?"},"a":{"en":"Presentation Layer (Layer 6)","hi":"प्रेजेंटेशन लेयर (लेयर 6)"},"o":[{"en":"Application Layer (L7)","hi":"एप्लीकेशन लेयर"},{"en":"Presentation Layer (Layer 6)","hi":"प्रेजेंटेशन लेयर (लेयर 6)"},{"en":"Session Layer (L5)","hi":"सेशन लेयर"},{"en":"Data Link Layer (L2)","hi":"डेटा लिंक लेयर"}],"exp":{"en":"The Presentation Layer (L6) is nicknamed the 'Translation Layer' because its core responsibility is syntax conversion, data formatting, encryption, and compression.\nSource-note (Hinglish): Presentation Layer (L6).","hi":"प्रेजेंटेशन लेयर (L6) को 'ट्रांसलेशन लेयर' उपनाम दिया गया है क्योंकि इसकी मुख्य जिम्मेदारी सिंटैक्स रूपांतरण, डेटा फ़ॉर्मेटिंग, एन्क्रिप्शन और संपीड़न है।"},"num":96},{"id":"q97","q":{"en":"At which OSI layer do TCP and UDP operate?","hi":"TCP और UDP किस OSI लेयर पर काम करते हैं?"},"a":{"en":"Transport Layer (Layer 4)","hi":"ट्रांसपोर्ट लेयर (लेयर 4)"},"o":[{"en":"Network Layer (L3)","hi":"नेटवर्क लेयर"},{"en":"Transport Layer (Layer 4)","hi":"ट्रांसपोर्ट लेयर (लेयर 4)"},{"en":"Data Link Layer (L2)","hi":"डेटा लिंक लेयर"},{"en":"Application Layer (L7)","hi":"एप्लीकेशन लेयर"}],"exp":{"en":"TCP (reliable, connection-oriented) and UDP (unreliable, connectionless) are the two primary protocols operating at Layer 4 (Transport Layer).\nSource-note (Hinglish): Transport Layer (L4).","hi":"TCP (विश्वसनीय, कनेक्शन-उन्मुख) और UDP (अविश्वसनीय, कनेक्शन रहित) लेयर 4 (ट्रांसपोर्ट लेयर) पर काम करने वाले दो प्राथमिक प्रोटोकॉल हैं।"},"num":97},{"id":"q98","q":{"en":"At which OSI layer do HTTP, FTP, SMTP, and DNS operate?","hi":"HTTP, FTP, SMTP और DNS किस OSI लेयर पर काम करते हैं?"},"a":{"en":"Application Layer (Layer 7)","hi":"एप्लीकेशन लेयर (लेयर 7)"},"o":[{"en":"Transport Layer (L4)","hi":"ट्रांसपोर्ट लेयर"},{"en":"Application Layer (Layer 7)","hi":"एप्लीकेशन लेयर (लेयर 7)"},{"en":"Network Layer (L3)","hi":"नेटवर्क लेयर"},{"en":"Presentation Layer (L6)","hi":"प्रेजेंटेशन लेयर"}],"exp":{"en":"These protocols interact directly with software applications (web browsers, email clients, transfer utilities) and thus reside in Layer 7 (Application Layer).\nSource-note (Hinglish): Application Layer (L7).","hi":"ये प्रोटोकॉल सीधे सॉफ्टवेयर अनुप्रयोगों (वेब ब्राउज़र, ईमेल क्लाइंट आदि) के साथ बातचीत करते हैं और इस प्रकार लेयर 7 (एप्लिकेशन लेयर) में स्थित होते हैं।"},"num":98},{"id":"q99","q":{"en":"MAC and LLC are sublayers of which OSI layer?","hi":"MAC और LLC किस OSI लेयर के उप-स्तर (sublayers) हैं?"},"a":{"en":"Data Link Layer (Layer 2)","hi":"डेटा लिंक लेयर (लेयर 2)"},"o":[{"en":"Physical Layer (L1)","hi":"फिजिकल लेयर"},{"en":"Data Link Layer (Layer 2)","hi":"डेटा लिंक लेयर (लेयर 2)"},{"en":"Network Layer (L3)","hi":"नेटवर्क लेयर"},{"en":"Transport Layer (L4)","hi":"ट्रांसपोर्ट लेयर"}],"exp":{"en":"Under IEEE 802 standards, Layer 2 is divided into the upper Logical Link Control (LLC) sublayer and the lower Media Access Control (MAC) sublayer.\nSource-note (Hinglish): Data Link Layer.","hi":"IEEE 802 मानकों के तहत, लेयर 2 को ऊपरी लॉजिकल लिंक कंट्रोल (LLC) सबलेयर और निचले मीडिया एक्सेस कंट्रोल (MAC) सबलेयर में विभाजित किया गया है।"},"num":99},{"id":"q100","q":{"en":"Ciphertext is the output of which cryptographic process?","hi":"सिफरटेक्स्ट (Ciphertext) किस क्रिप्टोग्राफ़िक प्रक्रिया का आउटपुट है?"},"a":{"en":"Encryption (transforming plaintext into scrambled ciphertext)","hi":"एन्क्रिप्शन (प्लेनटेक्स्ट को सिफरटेक्स्ट में बदलना)"},"o":[{"en":"Decryption","hi":"डिक्रिप्शन"},{"en":"Encryption (transforming plaintext into scrambled ciphertext)","hi":"एन्क्रिप्शन (प्लेनटेक्स्ट को सिफरटेक्स्ट में बदलना)"},{"en":"Compression","hi":"कम्प्रेशन"},{"en":"Segmentation","hi":"विखंडन"}],"exp":{"en":"Encryption converts readable plaintext into unreadable ciphertext using an algorithm and key; decryption reverses ciphertext back to plaintext.\nSource-note (Hinglish): Encryption.","hi":"एन्क्रिप्शन एक एल्गोरिथ्म और कुंजी का उपयोग करके पठनीय प्लेनटेक्स्ट को अपठनीय सिफरटेक्स्ट में परिवर्तित करता है; डिक्रिप्शन सिफरटेक्स्ट को वापस प्लेनटेक्स्ट में बदल देता है।"},"num":100},{"id":"q101","q":{"en":"In the TCP/IP suite, what are the common alternative names for the Host-to-Host layer and the Network Access layer?","hi":"TCP/IP में होस्ट-टू-होस्ट (Host-to-Host) और नेटवर्क एक्सेस (Network Access) के वैकल्पिक नाम क्या हैं?"},"a":{"en":"Transport Layer and Link Layer respectively","hi":"क्रमशः ट्रांसपोर्ट लेयर और लिंक लेयर"},"o":[{"en":"Physical and Session","hi":"फिजिकल और सेशन"},{"en":"Transport Layer and Link Layer respectively","hi":"क्रमशः ट्रांसपोर्ट लेयर और लिंक लेयर"},{"en":"Network and Application","hi":"नेटवर्क और एप्लीकेशन"},{"en":"Presentation and Data Link","hi":"प्रेजेंटेशन और डेटा लिंक"}],"exp":{"en":"The Host-to-Host layer is widely known as the Transport Layer, and the Network Access layer is commonly termed the Link Layer (or Network Interface layer).\nSource-note (Hinglish): Transport aur Link.","hi":"होस्ट-टू-होस्ट लेयर को व्यापक रूप से ट्रांसपोर्ट लेयर के रूप में जाना जाता है, और नेटवर्क एक्सेस लेयर को आमतौर पर लिंक लेयर (या नेटवर्क इंटरफेस लेयर) कहा जाता है।"},"num":101},{"id":"q102","q":{"en":"During decapsulation at the receiver, what comes immediately after Bits → Frames → Packets?","hi":"रिसीवर पर डिकैप्सुलेशन (decapsulation) में बिट्स → फ्रेम्स → पैकेट्स के तुरंत बाद क्या आता है?"},"a":{"en":"TCP segments or UDP datagrams, followed by upper-layer application data","hi":"टीसीपी सेगमेंट या यूडीपी डेटाग्राम, उसके बाद ऊपरी-परत एप्लिकेशन डेटा"},"o":[{"en":"Physical signals","hi":"भौतिक संकेत"},{"en":"TCP segments or UDP datagrams, followed by upper-layer application data","hi":"टीसीपी सेगमेंट या यूडीपी डेटाग्राम, उसके बाद ऊपरी-परत एप्लिकेशन डेटा"},{"en":"Network cables","hi":"नेटवर्क केबल"},{"en":"MAC addresses","hi":"मैक पते"}],"exp":{"en":"Receiver decapsulation goes upward: Physical (bits) → Data Link (frames) → Network (packets) → Transport (segments/datagrams) → Upper layers (application data).\nSource-note (Hinglish): TCP segments ya UDP datagrams, phir upper-layer data.","hi":"रिसीवर डिकैप्सुलेशन ऊपर की ओर जाता है: फिजिकल (बिट्स) → डेटा लिंक (फ्रेम्स) → नेटवर्क (पैकेट्स) → ट्रांसपोर्ट (सेगमेंट्स/डेटाग्राम) → ऊपरी परतें (एप्लिकेशन डेटा)।"},"num":102},{"id":"q103","q":{"en":"What is the common general exam PDU label used for Layers 7, 6, and 5 (Application, Presentation, Session)?","hi":"लेयर 7, 6 और 5 (Application, Presentation, Session) के लिए सामान्य परीक्षा PDU लेबल क्या है?"},"a":{"en":"Data (or Message)","hi":"डेटा (या संदेश)"},"o":[{"en":"Bits","hi":"बिट्स"},{"en":"Data (or Message)","hi":"डेटा (या संदेश)"},{"en":"Frames","hi":"फ्रेम्स"},{"en":"Packets","hi":"पैकेट्स"}],"exp":{"en":"In standard OSI exam charts, the Protocol Data Unit (PDU) for the upper three layers (L5 Session, L6 Presentation, L7 Application) is generically referred to as 'Data' or 'Message'.\nSource-note (Hinglish): Data, ya message.","hi":"मानक OSI परीक्षा चार्ट में, ऊपरी तीन परतों (L5 सेशन, L6 प्रेजेंटेशन, L7 एप्लिकेशन) के लिए प्रोटोकॉल डेटा यूनिट (PDU) को सामान्य रूप से 'डेटा' (Data) या 'संदेश' (Message) कहा जाता है।"},"num":103}]}],"11. Supercomputers, Computer Pioneers, Companies & Inventions":[{"title":{"en":"1. PARAM Series & Indian Supercomputing","hi":"1. PARAM सीरीज़ और भारतीय सुपरकंप्यूटिंग"},"questions":[{"id":"q1","q":{"en":"What is the full form of HPC and FLOPS?","hi":"HPC और FLOPS का पूर्ण रूप क्या है?"},"a":{"en":"High Performance Computing; Floating-Point Operations Per Second","hi":"हाई परफॉर्मेंस कंप्यूटिंग; फ्लोटिंग-पॉइंट ऑपरेशंस पर सेकंड"},"o":[{"en":"High Power Computer; Fast Logical Operations Per Second","hi":"हाई पावर कंप्यूटर; फास्ट लॉजिकल ऑपरेशंस पर सेकंड"},{"en":"High Performance Computing; Floating-Point Operations Per Second","hi":"हाई परफॉर्मेंस कंप्यूटिंग; फ्लोटिंग-पॉइंट ऑपरेशंस पर सेकंड"},{"en":"Heavy Processing Core; File Logic Operations Per System","hi":"हेवी प्रोसेसिंग कोर; फाइल लॉजिक ऑपरेशंस पर सिस्टम"},{"en":"Hardware Processing Capacity; First Level Operations Per Second","hi":"हार्डवेयर प्रोसेसिंग कैपेसिटी; फर्स्ट लेवल ऑपरेशंस पर सेकंड"}],"exp":{"en":"HPC stands for High Performance Computing, and FLOPS stands for Floating-Point Operations Per Second, which is a standard measure of a computer's numerical processing speed.","hi":"HPC का मतलब 'हाई परफॉर्मेंस कंप्यूटिंग' और FLOPS का मतलब 'फ्लोटिंग-पॉइंट ऑपरेशंस पर सेकंड' है। FLOPS सुपर कंप्यूटर की गणना गति (compute speed) मापने की इकाई है।"},"num":1},{"id":"q2","q":{"en":"What is the relationship between GFLOPS, TFLOPS, and PFLOPS?","hi":"GFLOPS, TFLOPS और PFLOPS के बीच क्या संबंध है?"},"a":{"en":"1 GFLOPS = 10⁹, 1 TFLOPS = 10¹², and 1 PFLOPS = 10¹⁵ operations per second (each step is 1,000×)","hi":"1 GFLOPS = 10⁹, 1 TFLOPS = 10¹², और 1 PFLOPS = 10¹⁵ ऑपरेशंस प्रति सेकंड (प्रत्येक चरण 1,000 गुना है)"},"o":[{"en":"1 GFLOPS = 10⁶, 1 TFLOPS = 10⁹, 1 PFLOPS = 10¹² / 1 GFLOPS = 10⁶, 1 TFLOPS = 10⁹, 1 PFLOPS = 10¹²","hi":"1 GFLOPS = 10⁶, 1 TFLOPS = 10⁹, 1 PFLOPS = 10¹² / 1 GFLOPS = 10⁶, 1 TFLOPS = 10⁹, 1 PFLOPS = 10¹²"},{"en":"They are all equal in modern computers","hi":"आधुनिक कंप्यूटरों में वे सभी बराबर हैं"},{"en":"1 GFLOPS = 10⁹, 1 TFLOPS = 10¹², and 1 PFLOPS = 10¹⁵ operations per second (each step is 1,000×)","hi":"1 GFLOPS = 10⁹, 1 TFLOPS = 10¹², और 1 PFLOPS = 10¹⁵ ऑपरेशंस प्रति सेकंड (प्रत्येक चरण 1,000 गुना है)"},{"en":"1 PFLOPS is smaller than 1 GFLOPS","hi":"1 PFLOPS, 1 GFLOPS से छोटा होता है"}],"exp":{"en":"Giga (10⁹), Tera (10¹²), and Peta (10¹⁵) represent powers of a thousand. Each step up (GFLOPS to TFLOPS to PFLOPS) represents a 1,000-fold increase in computing power.","hi":"गिगा (Giga) 10⁹, टेरा (Tera) 10¹² और पेटा (Peta) 10¹⁵ होता है। हर अगला स्केल पिछले से 1,000 गुना (1,000×) बड़ा होता है।"},"num":2},{"id":"q3","q":{"en":"Who developed PARAM 8000 and where?","hi":"PARAM 8000 को किसने और कहाँ विकसित किया?"},"a":{"en":"C-DAC (Centre for Development of Advanced Computing), Pune","hi":"सी-डैक (प्रगत संगणन विकास केंद्र), पुणे"},"o":[{"en":"ISRO, Bangalore","hi":"इसरो, बैंगलोर"},{"en":"BARC, Mumbai","hi":"बार्क, मुंबई"},{"en":"IIT Delhi","hi":"आईआईटी दिल्ली"},{"en":"C-DAC (Centre for Development of Advanced Computing), Pune","hi":"सी-डैक (प्रगत संगणन विकास केंद्र), पुणे"}],"exp":{"en":"PARAM 8000 was developed by C-DAC (Centre for Development of Advanced Computing) in Pune, and is recognized as India's first indigenous giga-scale supercomputer.","hi":"PARAM 8000 को C-DAC (पुणे) ने विकसित किया था। इसे भारत का पहला स्वदेशी गीगा-स्केल (giga-scale) सुपर कंप्यूटर माना जाता है।"},"num":3},{"id":"q4","q":{"en":"Why are both 1990 and 1991 associated with PARAM 8000?","hi":"PARAM 8000 के साथ 1990 और 1991 दोनों वर्ष क्यों जुड़े हैं?"},"a":{"en":"C-DAC's list gives 1990 for development, while PIB records it was formally unveiled in 1991","hi":"C-DAC की सूची विकास के लिए 1990 देती है, जबकि PIB रिकॉर्ड के अनुसार इसे औपचारिक रूप से 1991 में पेश (unveil) किया गया"},"o":[{"en":"1990 is when it was imported, 1991 is when it broke","hi":"1990 में इसे आयात किया गया, 1991 में यह टूट गया"},{"en":"C-DAC's list gives 1990 for development, while PIB records it was formally unveiled in 1991","hi":"C-DAC की सूची विकास के लिए 1990 देती है, जबकि PIB रिकॉर्ड के अनुसार इसे औपचारिक रूप से 1991 में पेश (unveil) किया गया"},{"en":"It was built in two separate halves","hi":"इसे दो अलग-अलग हिस्सों में बनाया गया था"},{"en":"It took exactly two years to turn on","hi":"इसे चालू होने में ठीक दो साल लगे"}],"exp":{"en":"While C-DAC's systems timeline mentions 1990, official PIB records state that PARAM 8000 was formally unveiled to the world in 1991. For exam questions asking when it was 'unveiled', the answer is 1991.","hi":"C-DAC की सूची में इसे 1990 का प्रोजेक्ट बताया गया है, लेकिन PIB के अनुसार इसे 1991 में दुनिया के सामने पेश (unveiled) किया गया था। परीक्षा में 'unveiled' के लिए 1991 सही उत्तर है।"},"num":4},{"id":"q5","q":{"en":"When did PARAM 10000 arrive and how powerful was it?","hi":"PARAM 10000 कब आया और यह कितना शक्तिशाली था?"},"a":{"en":"1998 system by C-DAC with a quoted capacity of 100 GFLOPS","hi":"C-DAC द्वारा 1998 का सिस्टम, जिसकी क्षमता 100 GFLOPS बताई गई थी"},"o":[{"en":"1998 system by C-DAC with a quoted capacity of 100 GFLOPS","hi":"C-DAC द्वारा 1998 का सिस्टम, जिसकी क्षमता 100 GFLOPS बताई गई थी"},{"en":"1991 system with 1 TFLOPS","hi":"1 TFLOPS के साथ 1991 का सिस्टम"},{"en":"2005 system with 10 PFLOPS","hi":"10 PFLOPS के साथ 2005 का सिस्टम"},{"en":"1980 system with 100 MFLOPS","hi":"100 MFLOPS के साथ 1980 का सिस्टम"}],"exp":{"en":"PARAM 10000 was introduced by C-DAC in 1998 and had a quoted computing capacity of 100 GFLOPS.","hi":"PARAM 10000 को C-DAC ने 1998 में पेश किया था और इसकी बताई गई क्षमता (quoted capacity) 100 GFLOPS थी।"},"num":5},{"id":"q6","q":{"en":"What was the historical milestone achieved by PARAM Padma?","hi":"PARAM Padma (परम पद्म) ने कौन सा ऐतिहासिक मील का पत्थर (milestone) हासिल किया?"},"a":{"en":"It was C-DAC's 2002 system (1 TFLOPS), noted as the first Indian supercomputer to enter the TOP500 list","hi":"यह C-DAC का 2002 का सिस्टम (1 TFLOPS) था, जिसे TOP500 सूची में प्रवेश करने वाला पहला भारतीय सुपर कंप्यूटर माना जाता है"},"o":[{"en":"It was the first computer in the world","hi":"यह दुनिया का पहला कंप्यूटर था"},{"en":"It was C-DAC's 2002 system (1 TFLOPS), noted as the first Indian supercomputer to enter the TOP500 list","hi":"यह C-DAC का 2002 का सिस्टम (1 TFLOPS) था, जिसे TOP500 सूची में प्रवेश करने वाला पहला भारतीय सुपर कंप्यूटर माना जाता है"},{"en":"It was India's first mobile phone","hi":"यह भारत का पहला मोबाइल फोन था"},{"en":"It was built entirely of wood","hi":"यह पूरी तरह से लकड़ी से बना था"}],"exp":{"en":"PARAM Padma (2002), a 1 TFLOPS system, is celebrated as the first Indian supercomputer to break the teraflop barrier and enter the global TOP500 list (ranking 171 according to C-DAC/169 in TOP500 archive for June 2003).","hi":"PARAM Padma (2002) 1 TFLOPS का सिस्टम था और यह प्रतिष्ठित TOP500 वैश्विक सूची में प्रवेश करने वाला पहला भारतीय सुपर कंप्यूटर था।"},"num":6},{"id":"q7","q":{"en":"What were the capacity and historical TOP500 rank of PARAM Yuva?","hi":"PARAM Yuva (परम युवा) की क्षमता और ऐतिहासिक TOP500 रैंक क्या थी?"},"a":{"en":"Approximately 54 TFLOPS peak; ranked 69th in the November 2008 TOP500 list","hi":"लगभग 54 TFLOPS पीक; नवंबर 2008 की TOP500 सूची में 69वीं रैंक"},"o":[{"en":"529 TFLOPS, ranked 1st","hi":"529 TFLOPS, पहली रैंक"},{"en":"10 GFLOPS, ranked 500th","hi":"10 GFLOPS, 500वीं रैंक"},{"en":"Approximately 54 TFLOPS peak; ranked 69th in the November 2008 TOP500 list","hi":"लगभग 54 TFLOPS पीक; नवंबर 2008 की TOP500 सूची में 69वीं रैंक"},{"en":"1 PFLOPS, ranked 10th","hi":"1 PFLOPS, 10वीं रैंक"}],"exp":{"en":"PARAM Yuva had a peak capacity of around 54 TFLOPS and achieved the 69th position in the November 2008 TOP500 list.","hi":"PARAM Yuva की पीक (peak) क्षमता लगभग 54 TFLOPS थी और इसे नवंबर 2008 की TOP500 सूची में 69वाँ स्थान मिला था।"},"num":7},{"id":"q8","q":{"en":"What were the capacity and historical TOP500 rank of PARAM Yuva II?","hi":"PARAM Yuva II की क्षमता और ऐतिहासिक TOP500 रैंक क्या थी?"},"a":{"en":"Approximately 529.4 TFLOPS peak (386.71 TFLOPS LINPACK); ranked 69th (C-DAC) or 70th (TOP500 archive) in June 2013","hi":"लगभग 529.4 TFLOPS पीक (386.71 TFLOPS LINPACK); जून 2013 में 69वीं (C-DAC) या 70वीं (TOP500 आर्काइव) रैंक"},"o":[{"en":"100 GFLOPS, ranked 200th","hi":"100 GFLOPS, 200वीं रैंक"},{"en":"Approximately 529.4 TFLOPS peak (386.71 TFLOPS LINPACK); ranked 69th (C-DAC) or 70th (TOP500 archive) in June 2013","hi":"लगभग 529.4 TFLOPS पीक (386.71 TFLOPS LINPACK); जून 2013 में 69वीं (C-DAC) या 70वीं (TOP500 आर्काइव) रैंक"},{"en":"1 PFLOPS, ranked 1st","hi":"1 PFLOPS, पहली रैंक"},{"en":"54 TFLOPS, ranked 169th","hi":"54 TFLOPS, 169वीं रैंक"}],"exp":{"en":"PARAM Yuva II delivered a massive leap to 529.4 TFLOPS peak performance. In June 2013, C-DAC certificates cited its rank as 69, though the final TOP500 archive lists it at 70.","hi":"PARAM Yuva II की पीक क्षमता 529.4 TFLOPS थी। जून 2013 में इसे 69वाँ (C-DAC सर्टिफिकेट के अनुसार) या 70वाँ (TOP500 आर्काइव) स्थान मिला था।"},"num":8},{"id":"q9","q":{"en":"What is the chronological order of major C-DAC milestones from PARAM 8000 to Yuva II?","hi":"PARAM 8000 से Yuva II तक C-DAC के प्रमुख मील के पत्थरों (milestones) का कालानुक्रमिक क्रम (chronological order) क्या है?"},"a":{"en":"PARAM 8000 → PARAM 10000 → PARAM Padma → PARAM Yuva → PARAM Yuva II","hi":"PARAM 8000 → PARAM 10000 → PARAM Padma → PARAM Yuva → PARAM Yuva II"},"o":[{"en":"PARAM 10000 → PARAM Padma → PARAM 8000 → PARAM Yuva II → PARAM Yuva","hi":"PARAM 10000 → PARAM Padma → PARAM 8000 → PARAM Yuva II → PARAM Yuva"},{"en":"PARAM Yuva → PARAM 8000 → PARAM Padma → PARAM 10000 → PARAM Yuva II","hi":"PARAM Yuva → PARAM 8000 → PARAM Padma → PARAM 10000 → PARAM Yuva II"},{"en":"PARAM 8000 → PARAM 10000 → PARAM Padma → PARAM Yuva → PARAM Yuva II","hi":"PARAM 8000 → PARAM 10000 → PARAM Padma → PARAM Yuva → PARAM Yuva II"},{"en":"PARAM Padma → PARAM 10000 → PARAM 8000 → PARAM Yuva → PARAM Yuva II","hi":"PARAM Padma → PARAM 10000 → PARAM 8000 → PARAM Yuva → PARAM Yuva II"}],"exp":{"en":"The correct developmental progression is: PARAM 8000 (1991) → PARAM 10000 (1998) → PARAM Padma (2002/03) → PARAM Yuva (2008) → PARAM Yuva II (2013).","hi":"C-DAC का सही विकास क्रम है: PARAM 8000 (1991) → PARAM 10000 (1998) → PARAM Padma (2002) → PARAM Yuva (2008) → PARAM Yuva II (2013)।"},"num":9},{"id":"q10","q":{"en":"What was the purpose and capacity of PARAM Biochrome?","hi":"PARAM Biochrome का उद्देश्य और क्षमता क्या थी?"},"a":{"en":"HPC cluster for Bioinformatics applications, with 5 TFLOPS compute capacity","hi":"बायोइन्फॉर्मेटिक्स (Bioinformatics) अनुप्रयोगों के लिए HPC क्लस्टर, 5 TFLOPS कंप्यूट क्षमता के साथ"},"o":[{"en":"HPC cluster for Bioinformatics applications, with 5 TFLOPS compute capacity","hi":"बायोइन्फॉर्मेटिक्स (Bioinformatics) अनुप्रयोगों के लिए HPC क्लस्टर, 5 TFLOPS कंप्यूट क्षमता के साथ"},{"en":"Weather forecasting system with 1 PFLOPS","hi":"1 PFLOPS के साथ मौसम पूर्वानुमान प्रणाली"},{"en":"AI supercomputer with 100 GFLOPS","hi":"100 GFLOPS के साथ AI सुपरकंप्यूटर"},{"en":"Database server with 1 TFLOPS","hi":"1 TFLOPS के साथ डेटाबेस सर्वर"}],"exp":{"en":"PARAM Biochrome was built as a specialized HPC cluster dedicated to Bioinformatics applications, featuring a 5 TFLOPS compute capacity.","hi":"PARAM Biochrome को विशेष रूप से बायोइन्फॉर्मेटिक्स (Bioinformatics) के कार्यों के लिए बनाया गया था और इसकी क्षमता 5 TFLOPS थी।"},"num":10},{"id":"q11","q":{"en":"When was PARAM Bio Blaze launched and what was its capacity?","hi":"PARAM Bio Blaze को कब लॉन्च किया गया था और इसकी क्षमता क्या थी?"},"a":{"en":"Launched on 18 February 2014; 10.65 TFLOPS peak computing facility for Bioinformatics","hi":"18 फरवरी 2014 को लॉन्च; बायोइन्फॉर्मेटिक्स के लिए 10.65 TFLOPS पीक कंप्यूटिंग सुविधा"},"o":[{"en":"Launched in 2008; 54 TFLOPS","hi":"2008 में लॉन्च; 54 TFLOPS"},{"en":"Launched on 18 February 2014; 10.65 TFLOPS peak computing facility for Bioinformatics","hi":"18 फरवरी 2014 को लॉन्च; बायोइन्फॉर्मेटिक्स के लिए 10.65 TFLOPS पीक कंप्यूटिंग सुविधा"},{"en":"Launched in 1998; 100 GFLOPS","hi":"1998 में लॉन्च; 100 GFLOPS"},{"en":"Launched in 2020; 1 PFLOPS","hi":"2020 में लॉन्च; 1 PFLOPS"}],"exp":{"en":"PARAM Bio Blaze, launched on February 18, 2014, was a 10.65 TFLOPS peak HPC facility also dedicated to Bioinformatics.","hi":"PARAM Bio Blaze 18 फरवरी 2014 को लॉन्च हुआ था। यह बायोइन्फॉर्मेटिक्स के लिए 10.65 TFLOPS पीक क्षमता वाला सुपरकंप्यूटर था।"},"num":11},{"id":"q12","q":{"en":"What is the institutional setup of the National Supercomputing Mission (NSM)?","hi":"राष्ट्रीय सुपरकंप्यूटिंग मिशन (NSM) का संस्थागत ढांचा (institutional setup) क्या है?"},"a":{"en":"Jointly steered by DST and MeitY, with C-DAC and IISc as implementing agencies","hi":"DST और MeitY द्वारा संयुक्त रूप से संचालित (steer); C-DAC और IISc कार्यान्वयन एजेंसियां (implementing agencies) हैं"},"o":[{"en":"Run entirely by ISRO","hi":"पूरी तरह से इसरो द्वारा संचालित"},{"en":"Jointly steered by DST and MeitY, with C-DAC and IISc as implementing agencies","hi":"DST और MeitY द्वारा संयुक्त रूप से संचालित (steer); C-DAC और IISc कार्यान्वयन एजेंसियां (implementing agencies) हैं"},{"en":"Managed by Tata Sons and IBM","hi":"टाटा संस और IBM द्वारा प्रबंधित"},{"en":"Run by IIT Delhi alone","hi":"केवल IIT दिल्ली द्वारा संचालित"}],"exp":{"en":"The NSM is jointly steered by the Department of Science and Technology (DST) and the Ministry of Electronics and Information Technology (MeitY), while C-DAC and IISc execute the deployment.","hi":"राष्ट्रीय सुपरकंप्यूटिंग मिशन (NSM) को DST और MeitY मिलकर चलाते हैं, जबकि C-DAC और IISc इसे लागू (implement) करने वाली मुख्य एजेंसियां हैं।"},"num":12},{"id":"q13","q":{"en":"What is the type and historical ranking of PARAM Siddhi-AI?","hi":"PARAM Siddhi-AI किस प्रकार का सिस्टम है और इसकी ऐतिहासिक रैंकिंग क्या थी?"},"a":{"en":"C-DAC's NSM high-performance computing and AI system; ranked 63rd (PIB/PDF) or 62nd (TOP500 archive) in November 2020","hi":"C-DAC का NSM हाई-परफॉर्मेंस कंप्यूटिंग और AI सिस्टम; नवंबर 2020 में 63वीं (PIB/PDF) या 62वीं (TOP500 आर्काइव) रैंक"},"o":[{"en":"A weather computer; ranked 1st","hi":"एक मौसम कंप्यूटर; पहली रैंक"},{"en":"C-DAC's NSM high-performance computing and AI system; ranked 63rd (PIB/PDF) or 62nd (TOP500 archive) in November 2020","hi":"C-DAC का NSM हाई-परफॉर्मेंस कंप्यूटिंग और AI सिस्टम; नवंबर 2020 में 63वीं (PIB/PDF) या 62वीं (TOP500 आर्काइव) रैंक"},{"en":"A bioinformatics cluster; ranked 169th","hi":"एक बायोइन्फॉर्मेटिक्स क्लस्टर; 169वीं रैंक"},{"en":"A personal computer; unranked","hi":"एक पर्सनल कंप्यूटर; बिना रैंक वाला"}],"exp":{"en":"PARAM Siddhi-AI is a specialized HPC-AI supercomputer developed under NSM. In the November 2020 TOP500 list, it was announced at rank 63 (PIB), while the final archive shows it at 62.","hi":"PARAM Siddhi-AI एक AI सुपरकंप्यूटर है। नवंबर 2020 में इसे 63वीं (PIB प्रेस रिलीज़) या 62वीं (TOP500 आर्काइव) रैंक मिली थी।"},"num":13},{"id":"q14","q":{"en":"Which other Indian system appeared alongside Siddhi-AI in the November 2020 TOP500 list?","hi":"नवंबर 2020 की TOP500 सूची में Siddhi-AI के साथ कौन सा अन्य भारतीय सिस्टम शामिल था?"},"a":{"en":"Mihir (Ranked 146th in PDF, 144th in TOP500 archive)","hi":"मिहिर (PDF में 146वीं रैंक, TOP500 आर्काइव में 144वीं रैंक)"},"o":[{"en":"PARAM 8000","hi":"PARAM 8000"},{"en":"EKA","hi":"EKA"},{"en":"Mihir (Ranked 146th in PDF, 144th in TOP500 archive)","hi":"मिहिर (PDF में 146वीं रैंक, TOP500 आर्काइव में 144वीं रैंक)"},{"en":"PARAM Yuva II","hi":"PARAM Yuva II"}],"exp":{"en":"In the November 2020 TOP500 edition, Mihir joined Siddhi-AI, ranking 146th in initial announcements/PDF and 144th in the official archive.","hi":"नवंबर 2020 की सूची में Siddhi-AI के साथ मौसम पूर्वानुमान वाला सुपरकंप्यूटर 'मिहिर (Mihir)' भी शामिल था (रैंक 146 या 144)।"},"num":14},{"id":"q15","q":{"en":"Who is known as the father of Indian supercomputers?","hi":"भारतीय सुपर कंप्यूटर के जनक (father of Indian supercomputers) के रूप में किसे जाना जाता है?"},"a":{"en":"Dr. Vijay Pandurang Bhatkar (Founding executive director of C-DAC and leader of the PARAM initiative)","hi":"डॉ. विजय पांडुरंग भटकर (C-DAC के संस्थापक कार्यकारी निदेशक और PARAM पहल के नेता)"},"o":[{"en":"Dr. A. P. J. Abdul Kalam","hi":"Dr. A. P. J. Abdul Kalam"},{"en":"Seymour Cray","hi":"Seymour Cray"},{"en":"Alan Turing","hi":"Alan Turing"},{"en":"Dr. Vijay Pandurang Bhatkar (Founding executive director of C-DAC and leader of the PARAM initiative)","hi":"डॉ. विजय पांडुरंग भटकर (C-DAC के संस्थापक कार्यकारी निदेशक और PARAM पहल के नेता)"}],"exp":{"en":"Dr. Vijay Pandurang Bhatkar led the C-DAC team that built PARAM 8000 and is widely revered as the father of India's supercomputing program.","hi":"डॉ. विजय पांडुरंग भटकर ने C-DAC की स्थापना की और PARAM 8000 प्रोजेक्ट का नेतृत्व किया, इसलिए उन्हें भारतीय सुपरकंप्यूटिंग का जनक कहा जाता है।"},"num":15},{"id":"q16","q":{"en":"What is the difference between peak performance and TOP500 rank?","hi":"पीक परफॉर्मेंस (Peak performance) और TOP500 रैंक के बीच क्या अंतर है?"},"a":{"en":"Peak performance is theoretical maximum hardware capacity, whereas TOP500 ranking is based on actual measured LINPACK performance (Rmax)","hi":"पीक परफॉर्मेंस हार्डवेयर की सैद्धांतिक (theoretical) अधिकतम क्षमता है, जबकि TOP500 रैंकिंग वास्तविक मापे गए LINPACK प्रदर्शन (Rmax) पर आधारित होती है"},"o":[{"en":"They are exactly the same number","hi":"वे बिल्कुल एक ही संख्या हैं"},{"en":"Peak performance is theoretical maximum hardware capacity, whereas TOP500 ranking is based on actual measured LINPACK performance (Rmax)","hi":"पीक परफॉर्मेंस हार्डवेयर की सैद्धांतिक (theoretical) अधिकतम क्षमता है, जबकि TOP500 रैंकिंग वास्तविक मापे गए LINPACK प्रदर्शन (Rmax) पर आधारित होती है"},{"en":"TOP500 rank measures weight, peak performance measures electricity","hi":"TOP500 रैंक वजन मापता है, पीक परफॉर्मेंस बिजली मापता है"},{"en":"Peak performance is for analog computers only","hi":"पीक परफॉर्मेंस केवल एनालॉग कंप्यूटरों के लिए है"}],"exp":{"en":"Hardware manufacturers quote 'peak performance' as a theoretical maximum (Rpeak), but TOP500 ranks computers on their sustained, measured performance running the LINPACK benchmark (Rmax), which is always lower.","hi":"पीक परफॉर्मेंस (Rpeak) कंप्यूटर की किताबी या सैद्धांतिक अधिकतम गति है। TOP500 लिस्ट LINPACK टेस्ट रन करके असली/मापी गई गति (Rmax) के आधार पर रैंक देती है, जो हमेशा पीक से कम होती है।"},"num":16}]},{"title":{"en":"2. Major Systems — Ganga, Pravega, Pratyush, EKA & Cray-1","hi":"2. प्रमुख सिस्टम — गंगा, प्रवेग, प्रत्यूष, एका और क्रे-1"},"questions":[{"id":"q17","q":{"en":"Where and when was PARAM Ganga deployed?","hi":"PARAM Ganga (परम गंगा) कहाँ और कब स्थापित (deploy) किया गया था?"},"a":{"en":"IIT Roorkee, March 2022 (Under National Supercomputing Mission, quoted capacity 1.66 PFLOPS)","hi":"IIT रुड़की, मार्च 2022 (राष्ट्रीय सुपरकंप्यूटिंग मिशन के तहत, क्षमता 1.66 PFLOPS बताई गई)"},"o":[{"en":"IISc Bengaluru, 2018","hi":"IISc बेंगलुरु, 2018"},{"en":"IIT Roorkee, March 2022 (Under National Supercomputing Mission, quoted capacity 1.66 PFLOPS)","hi":"IIT रुड़की, मार्च 2022 (राष्ट्रीय सुपरकंप्यूटिंग मिशन के तहत, क्षमता 1.66 PFLOPS बताई गई)"},{"en":"IIT Delhi, 2020","hi":"IIT दिल्ली, 2020"},{"en":"C-DAC Pune, 1991","hi":"C-DAC पुणे, 1991"}],"exp":{"en":"PARAM Ganga is an NSM-commissioned supercomputer with a capacity of 1.66 PFLOPS, deployed at IIT Roorkee in March 2022.","hi":"PARAM Ganga राष्ट्रीय सुपरकंप्यूटिंग मिशन (NSM) के तहत मार्च 2022 में IIT रुड़की (IIT Roorkee) में स्थापित किया गया था। इसकी क्षमता 1.66 PFLOPS है।"},"num":17},{"id":"q18","q":{"en":"What is the host institute and capacity of PARAM Pravega?","hi":"PARAM Pravega (परम प्रवेग) का होस्ट संस्थान (host institute) और क्षमता क्या है?"},"a":{"en":"Indian Institute of Science (IISc), Bengaluru; quoted capacity 3.3 PFLOPS (Under NSM)","hi":"भारतीय विज्ञान संस्थान (IISc), बेंगलुरु; क्षमता 3.3 PFLOPS बताई गई (NSM के तहत)"},"o":[{"en":"IIT Roorkee, 1.66 PFLOPS","hi":"IIT रुड़की, 1.66 PFLOPS"},{"en":"NCMRWF Noida, 2.8 PFLOPS","hi":"NCMRWF नोएडा, 2.8 PFLOPS"},{"en":"Indian Institute of Science (IISc), Bengaluru; quoted capacity 3.3 PFLOPS (Under NSM)","hi":"भारतीय विज्ञान संस्थान (IISc), बेंगलुरु; क्षमता 3.3 PFLOPS बताई गई (NSM के तहत)"},{"en":"IITM Pune, 4 PFLOPS","hi":"IITM पुणे, 4 PFLOPS"}],"exp":{"en":"PARAM Pravega was commissioned under the NSM at the Indian Institute of Science (IISc) in Bengaluru, featuring a quoted compute power of 3.3 PFLOPS.","hi":"PARAM Pravega को IISc बेंगलुरु (Bengaluru) में NSM के तहत स्थापित किया गया था, और इसकी क्षमता 3.3 PFLOPS है।"},"num":18},{"id":"q19","q":{"en":"Where was Pratyush inaugurated and what is its purpose?","hi":"प्रत्यूष (Pratyush) का उद्घाटन कहाँ हुआ और इसका उद्देश्य क्या है?"},"a":{"en":"Indian Institute of Tropical Meteorology (IITM), Pune, 2018; a 4 PFLOPS HPC system for weather and climate applications","hi":"भारतीय उष्णदेशीय मौसम विज्ञान संस्थान (IITM), पुणे, 2018; मौसम और जलवायु अनुप्रयोगों के लिए 4 PFLOPS HPC सिस्टम"},"o":[{"en":"IIT Roorkee; for AI research","hi":"IIT रुड़की; AI रिसर्च के लिए"},{"en":"Indian Institute of Tropical Meteorology (IITM), Pune, 2018; a 4 PFLOPS HPC system for weather and climate applications","hi":"भारतीय उष्णदेशीय मौसम विज्ञान संस्थान (IITM), पुणे, 2018; मौसम और जलवायु अनुप्रयोगों के लिए 4 PFLOPS HPC सिस्टम"},{"en":"C-DAC Pune; for bioinformatics","hi":"C-DAC पुणे; बायोइन्फॉर्मेटिक्स के लिए"},{"en":"Tata Sons, Mumbai; for enterprise computing","hi":"टाटा संस, मुंबई; उद्यम कंप्यूटिंग के लिए"}],"exp":{"en":"Pratyush (4 PFLOPS) was inaugurated in 2018 at IITM Pune and is dedicated exclusively to weather forecasting and climate modelling.","hi":"प्रत्यूष (Pratyush) 2018 में IITM पुणे में स्थापित किया गया था। यह 4 PFLOPS का सिस्टम है जो मौसम पूर्वानुमान (weather forecasting) के लिए काम करता है।"},"num":19},{"id":"q20","q":{"en":"Where was Mihir installed and what was its capacity?","hi":"मिहिर (Mihir) कहाँ स्थापित किया गया था और इसकी क्षमता क्या थी?"},"a":{"en":"National Centre for Medium Range Weather Forecasting (NCMRWF), Noida; quoted capacity 2.8 PFLOPS","hi":"नेशनल सेंटर फॉर मीडियम रेंज वेदर फोरकास्टिंग (NCMRWF), नोएडा; क्षमता 2.8 PFLOPS"},"o":[{"en":"IISc Bengaluru, 3.3 PFLOPS","hi":"IISc बेंगलुरु, 3.3 PFLOPS"},{"en":"IITM Pune, 4 PFLOPS","hi":"IITM पुणे, 4 PFLOPS"},{"en":"National Centre for Medium Range Weather Forecasting (NCMRWF), Noida; quoted capacity 2.8 PFLOPS","hi":"नेशनल सेंटर फॉर मीडियम रेंज वेदर फोरकास्टिंग (NCMRWF), नोएडा; क्षमता 2.8 PFLOPS"},{"en":"IIT Roorkee, 1.66 PFLOPS","hi":"IIT रुड़की, 1.66 PFLOPS"}],"exp":{"en":"Mihir is the companion system to Pratyush. It was installed at NCMRWF Noida with a quoted capacity of 2.8 PFLOPS.","hi":"मिहिर (Mihir) को NCMRWF नोएडा में स्थापित किया गया था, और इसकी क्षमता 2.8 PFLOPS है।"},"num":20},{"id":"q21","q":{"en":"What was the combined computing capacity of Pratyush and Mihir as per the 2018 PIB report?","hi":"2018 की PIB रिपोर्ट के अनुसार प्रत्यूष और मिहिर की संयुक्त कंप्यूटिंग क्षमता (combined computing capacity) कितनी थी?"},"a":{"en":"6.8 PFLOPS (4.0 from Pratyush + 2.8 from Mihir)","hi":"6.8 PFLOPS (प्रत्यूष से 4.0 + मिहिर से 2.8)"},"o":[{"en":"4.0 PFLOPS / 4.0 PFLOPS","hi":"4.0 PFLOPS / 4.0 PFLOPS"},{"en":"2.8 PFLOPS / 2.8 PFLOPS","hi":"2.8 PFLOPS / 2.8 PFLOPS"},{"en":"1.66 PFLOPS / 1.66 PFLOPS","hi":"1.66 PFLOPS / 1.66 PFLOPS"},{"en":"6.8 PFLOPS (4.0 from Pratyush + 2.8 from Mihir)","hi":"6.8 PFLOPS (प्रत्यूष से 4.0 + मिहिर से 2.8)"}],"exp":{"en":"The 2018 PIB announcement celebrated India's High Performance Computing facility for weather forecasting, stating the combined capacity across the two sites (Pune and Noida) was 6.8 PFLOPS.","hi":"2018 की रिपोर्ट के अनुसार, मौसम पूर्वानुमान के लिए पुणे (प्रत्यूष: 4.0) और नोएडा (मिहिर: 2.8) की संयुक्त क्षमता 6.8 PFLOPS थी।"},"num":21},{"id":"q22","q":{"en":"Why does the clue \"India's first petascale supercomputer\" apply to both Ganga and Pratyush in different contexts?","hi":"\"भारत का पहला पेटास्केल सुपरकंप्यूटर\" सुराग (clue) अलग-अलग संदर्भों में गंगा और प्रत्यूष दोनों पर क्यों लागू होता है?"},"a":{"en":"Study notes use broad \"first\" claims for both. Pratyush (4 PFLOPS, 2018, IITM) is historically earlier. Ganga (1.66 PFLOPS, 2022, IIT Roorkee) is another major NSM milestone. Identify via date and institute.","hi":"अध्ययन नोट्स दोनों के लिए व्यापक 'पहला' (first) दावा करते हैं। प्रत्यूष (4 PFLOPS, 2018, IITM) ऐतिहासिक रूप से पहले है। गंगा (1.66 PFLOPS, 2022, IIT रुड़की) NSM का एक और प्रमुख मील का पत्थर है। तिथि और संस्थान के माध्यम से पहचानें।"},"o":[{"en":"Because they are the same computer with two names","hi":"क्योंकि वे दो नामों वाले एक ही कंप्यूटर हैं"},{"en":"Because neither of them reached 1 PFLOPS","hi":"क्योंकि उनमें से कोई भी 1 PFLOPS तक नहीं पहुँचा"},{"en":"Study notes use broad \"first\" claims for both. Pratyush (4 PFLOPS, 2018, IITM) is historically earlier. Ganga (1.66 PFLOPS, 2022, IIT Roorkee) is another major NSM milestone. Identify via date and institute.","hi":"अध्ययन नोट्स दोनों के लिए व्यापक 'पहला' (first) दावा करते हैं। प्रत्यूष (4 PFLOPS, 2018, IITM) ऐतिहासिक रूप से पहले है। गंगा (1.66 PFLOPS, 2022, IIT रुड़की) NSM का एक और प्रमुख मील का पत्थर है। तिथि और संस्थान के माध्यम से पहचानें।"},{"en":"Because they were both made in 1991","hi":"क्योंकि वे दोनों 1991 में बनाए गए थे"}],"exp":{"en":"Exam notes sometimes loosely attribute 'first petascale' to multiple NSM projects. Officially, Pratyush (2018) broke the petascale barrier earlier than Ganga (2022). Read the question for specific institute names to answer correctly.","hi":"नोट्स में कई बार कई प्रोजेक्ट्स को 'पहला' लिख दिया जाता है। ऐतिहासिक रूप से प्रत्यूष (2018) पहले आया था, जबकि गंगा (2022) NSM का नया प्रोजेक्ट था। परीक्षा में संस्थान (IITM या IIT Roorkee) देखकर सही उत्तर चुनें।"},"num":22},{"id":"q23","q":{"en":"Which organization was associated with the EKA supercomputer?","hi":"EKA सुपरकंप्यूटर किस संस्था से जुड़ा था?"},"a":{"en":"Tata Sons' Computational Research Laboratories (CRL) in Pune, based on HP cluster hardware (Ranked 4th in world in Nov 2007)","hi":"टाटा संस का कंप्यूटेशनल रिसर्च लेबोरेटरीज (CRL) पुणे, जो HP क्लस्टर हार्डवेयर पर आधारित था (नवंबर 2007 में दुनिया में चौथी रैंक)"},"o":[{"en":"C-DAC Pune","hi":"C-DAC पुणे"},{"en":"Tata Sons' Computational Research Laboratories (CRL) in Pune, based on HP cluster hardware (Ranked 4th in world in Nov 2007)","hi":"टाटा संस का कंप्यूटेशनल रिसर्च लेबोरेटरीज (CRL) पुणे, जो HP क्लस्टर हार्डवेयर पर आधारित था (नवंबर 2007 में दुनिया में चौथी रैंक)"},{"en":"ISRO","hi":"इसरो"},{"en":"IIT Delhi","hi":"IIT दिल्ली"}],"exp":{"en":"EKA was built by the Computational Research Laboratories (CRL), a subsidiary of Tata Sons, using HP hardware. It stunned the world by reaching rank 4 in the Nov 2007 TOP500.","hi":"EKA सुपरकंप्यूटर को टाटा संस (Tata Sons) की लैब CRL (पुणे) ने HP हार्डवेयर की मदद से बनाया था। नवंबर 2007 में इसे दुनिया में 4थी रैंक मिली थी।"},"num":23},{"id":"q24","q":{"en":"How should you handle the claim that EKA is \"Asia's first supercomputer\"?","hi":"EKA के \"एशिया का पहला सुपरकंप्यूटर\" होने के दावे को कैसे समझें?"},"a":{"en":"Its verified milestone is securing 4th place globally in the Nov 2007 TOP500 list, the highest for an Asian system at that specific time.","hi":"इसका सत्यापित मील का पत्थर नवबंर 2007 की TOP500 सूची में वैश्विक स्तर पर चौथा स्थान हासिल करना है, जो उस विशिष्ट समय में किसी एशियाई सिस्टम के लिए सबसे अधिक था।"},"o":[{"en":"It is literally the first computer ever built in Asia","hi":"यह शाब्दिक रूप से एशिया में बना पहला कंप्यूटर है"},{"en":"It is entirely false","hi":"यह पूरी तरह से झूठा है"},{"en":"Its verified milestone is securing 4th place globally in the Nov 2007 TOP500 list, the highest for an Asian system at that specific time.","hi":"इसका सत्यापित मील का पत्थर नवबंर 2007 की TOP500 सूची में वैश्विक स्तर पर चौथा स्थान हासिल करना है, जो उस विशिष्ट समय में किसी एशियाई सिस्टम के लिए सबसे अधिक था।"},{"en":"It means it was built by C-DAC in 1991","hi":"इसका मतलब है कि इसे 1991 में C-DAC द्वारा बनाया गया था"}],"exp":{"en":"Asia had earlier supercomputers (e.g. Japan's Earth Simulator), but EKA achieved a massive milestone for India by hitting rank 4 globally in 2007. Treat 'first' loosely in notes as a hallmark of its unprecedented regional rank at the time.","hi":"एशिया में इससे पहले भी सुपरकंप्यूटर थे (जैसे जापान का अर्थ सिमुलेटर), लेकिन 2007 में 4थी रैंक हासिल करना भारत के लिए ऐतिहासिक था। नोट्स में 'पहला' शब्द इसी बड़ी उपलब्धि को दर्शाने के लिए इस्तेमाल हुआ है।"},"num":24},{"id":"q25","q":{"en":"Who developed the Cray-1 and when was it introduced?","hi":"क्रे-1 (Cray-1) किसने विकसित किया और इसे कब पेश किया गया?"},"a":{"en":"Developed under Seymour Cray's leadership at Cray Research; introduced in 1976","hi":"क्रे रिसर्च में सीमोर क्रे (Seymour Cray) के नेतृत्व में विकसित; 1976 में पेश किया गया"},"o":[{"en":"IBM in 1964","hi":"1964 में IBM ने"},{"en":"C-DAC in 1991","hi":"1991 में C-DAC ने"},{"en":"Developed under Seymour Cray's leadership at Cray Research; introduced in 1976","hi":"क्रे रिसर्च में सीमोर क्रे (Seymour Cray) के नेतृत्व में विकसित; 1976 में पेश किया गया"},{"en":"Alan Turing in 1950","hi":"1950 में एलन ट्यूरिंग ने"}],"exp":{"en":"The iconic Cray-1 vector supercomputer was introduced in 1976, designed by a team led by Seymour Cray at Cray Research.","hi":"क्रे-1 (Cray-1) एक प्रसिद्ध सुपरकंप्यूटर था जिसे सीमोर क्रे (Seymour Cray) की टीम ने 1976 में पेश किया था।"},"num":25}]},{"title":{"en":"3. Early Computers & Computing Pioneers","hi":"3. शुरुआती कंप्यूटर और कंप्यूटिंग के अग्रदूत"},"questions":[{"id":"q26","q":{"en":"What was the full form of SEAC?","hi":"SEAC का पूर्ण रूप (full form) क्या था?"},"a":{"en":"Standards Eastern Automatic Computer (also referred to as Standards Electronic Automatic Computer)","hi":"स्टैंडर्ड्स ईस्टर्न ऑटोमैटिक कंप्यूटर (जिसे स्टैंडर्ड्स इलेक्ट्रॉनिक ऑटोमैटिक कंप्यूटर भी कहा गया)"},"o":[{"en":"Standard Electronic Analytical Calculator","hi":"स्टैंडर्ड इलेक्ट्रॉनिक एनालिटिकल कैलकुलेटर"},{"en":"Standards Eastern Automatic Computer (also referred to as Standards Electronic Automatic Computer)","hi":"स्टैंडर्ड्स ईस्टर्न ऑटोमैटिक कंप्यूटर (जिसे स्टैंडर्ड्स इलेक्ट्रॉनिक ऑटोमैटिक कंप्यूटर भी कहा गया)"},{"en":"South Eastern Automatic Computer","hi":"साउथ ईस्टर्न ऑटोमैटिक कंप्यूटर"},{"en":"Serial Electronic Analog Computer","hi":"सीरियल इलेक्ट्रॉनिक एनालॉग कंप्यूटर"}],"exp":{"en":"SEAC stands for Standards Eastern Automatic Computer (frequently also called Standards Electronic Automatic Computer).","hi":"SEAC का पूर्ण रूप 'स्टैंडर्ड्स ईस्टर्न ऑटोमैटिक कंप्यूटर' है (इसे स्टैंडर्ड्स इलेक्ट्रॉनिक ऑटोमैटिक कंप्यूटर भी कहा जाता था)।"},"num":26},{"id":"q27","q":{"en":"Who built SEAC and when did it become operational?","hi":"SEAC किसने बनाया और यह कब चालू (operational) हुआ?"},"a":{"en":"U.S. National Bureau of Standards (NBS, later NIST); began computation in 1950 (first-generation electronic computer)","hi":"यूएस नेशनल ब्यूरो ऑफ स्टैंडर्ड्स (NBS, बाद में NIST); 1950 में गणना शुरू की (पहली पीढ़ी का इलेक्ट्रॉनिक कंप्यूटर)"},"o":[{"en":"IBM in 1964","hi":"1964 में IBM ने"},{"en":"Charles Babbage in 1837","hi":"1837 में चार्ल्स बैबेज ने"},{"en":"U.S. National Bureau of Standards (NBS, later NIST); began computation in 1950 (first-generation electronic computer)","hi":"यूएस नेशनल ब्यूरो ऑफ स्टैंडर्ड्स (NBS, बाद में NIST); 1950 में गणना शुरू की (पहली पीढ़ी का इलेक्ट्रॉनिक कंप्यूटर)"},{"en":"C-DAC in 1991","hi":"1991 में C-DAC ने"}],"exp":{"en":"SEAC was a pioneering first-generation electronic computer built by the U.S. National Bureau of Standards (NBS, now NIST), becoming operational in 1950.","hi":"SEAC पहली पीढ़ी (first-generation) का इलेक्ट्रॉनिक कंप्यूटर था जिसे यूएस नेशनल ब्यूरो ऑफ स्टैंडर्ड्स (NBS, जो अब NIST है) ने बनाया था। इसने 1950 में काम करना शुरू किया।"},"num":27},{"id":"q28","q":{"en":"What is the full form of ENIAC and who were its inventors?","hi":"ENIAC का पूर्ण रूप क्या है और इसके आविष्कारक कौन थे?"},"a":{"en":"Electronic Numerical Integrator and Computer; invented by J. Presper Eckert and John W. Mauchly","hi":"इलेक्ट्रॉनिक न्यूमेरिकल इंटीग्रेटर एंड कंप्यूटर; जे. प्रेस्पर एकर्ट और जॉन डब्ल्यू. मौचली द्वारा आविष्कार"},"o":[{"en":"Electronic Numerical Integrator and Computer; invented by J. Presper Eckert and John W. Mauchly","hi":"इलेक्ट्रॉनिक न्यूमेरिकल इंटीग्रेटर एंड कंप्यूटर; जे. प्रेस्पर एकर्ट और जॉन डब्ल्यू. मौचली द्वारा आविष्कार"},{"en":"Early Network Internet Architecture Computer; invented by Tim Berners-Lee","hi":"अर्ली नेटवर्क इंटरनेट आर्किटेक्चर कंप्यूटर; टिम बर्नर्स-ली द्वारा आविष्कार"},{"en":"Electronic National Intelligence Automatic Computer; invented by Alan Turing","hi":"इलेक्ट्रॉनिक नेशनल इंटेलिजेंस ऑटोमैटिक कंप्यूटर; एलन ट्यूरिंग द्वारा आविष्कार"},{"en":"Eastern Numerical Integrated Analog Calculator; invented by Herman Hollerith","hi":"ईस्टर्न न्यूमेरिकल इंटीग्रेटेड एनालॉग कैलकुलेटर; हरमन होलेरिथ द्वारा आविष्कार"}],"exp":{"en":"ENIAC stands for Electronic Numerical Integrator and Computer, developed by J. Presper Eckert and John W. Mauchly.","hi":"ENIAC का पूर्ण रूप इलेक्ट्रॉनिक न्यूमेरिकल इंटीग्रेटर एंड कंप्यूटर (Electronic Numerical Integrator and Computer) है। इसका आविष्कार जे. प्रेस्पर एकर्ट और जॉन डब्ल्यू. मौचली ने किया था।"},"num":28},{"id":"q29","q":{"en":"Where was ENIAC built and what is its 1945/1946 timeline significance?","hi":"ENIAC कहाँ बना था और 1945/1946 की समय-सीमा का क्या महत्व है?"},"a":{"en":"Moore School of Electrical Engineering, University of Pennsylvania; operational by the end of 1945 and formally dedicated in February 1946 (a pioneering general-purpose electronic digital computer)","hi":"मूर स्कूल ऑफ इलेक्ट्रिकल इंजीनियरिंग, यूनिवर्सिटी ऑफ पेंसिल्वेनिया; 1945 के अंत तक चालू हुआ और फरवरी 1946 में औपचारिक रूप से समर्पित (dedicated) किया गया (एक अग्रणी सामान्य-उद्देश्य इलेक्ट्रॉनिक डिजिटल कंप्यूटर)"},"o":[{"en":"MIT; completed in 1945 and retired in 1946","hi":"MIT; 1945 में पूरा हुआ और 1946 में सेवानिवृत्त (retired) हुआ"},{"en":"Moore School of Electrical Engineering, University of Pennsylvania; operational by the end of 1945 and formally dedicated in February 1946 (a pioneering general-purpose electronic digital computer)","hi":"मूर स्कूल ऑफ इलेक्ट्रिकल इंजीनियरिंग, यूनिवर्सिटी ऑफ पेंसिल्वेनिया; 1945 के अंत तक चालू हुआ और फरवरी 1946 में औपचारिक रूप से समर्पित (dedicated) किया गया (एक अग्रणी सामान्य-उद्देश्य इलेक्ट्रॉनिक डिजिटल कंप्यूटर)"},{"en":"CERN; designed in 1945 and built in 1946","hi":"CERN; 1945 में डिज़ाइन किया गया और 1946 में बनाया गया"},{"en":"IISc Bengaluru; imported in 1945","hi":"IISc बेंगलुरु; 1945 में आयातित"}],"exp":{"en":"ENIAC was built at the Moore School (UPenn). It reached operational status by late 1945 and was formally dedicated in February 1946 as a groundbreaking general-purpose electronic computer.","hi":"ENIAC पेंसिल्वेनिया विश्वविद्यालय के मूर स्कूल में बना था। यह 1945 के अंत तक चालू हो गया था और फरवरी 1946 में औपचारिक रूप से जनता को समर्पित (dedicate) किया गया।"},"num":29},{"id":"q30","q":{"en":"What was Alan Turing's contribution to computing?","hi":"कंप्यूटिंग में एलन ट्यूरिंग (Alan Turing) का क्या योगदान था?"},"a":{"en":"He formally described algorithmic computation with the Turing machine model (counted among pioneers of modern computing/theoretical computer science)","hi":"उन्होंने ट्यूरिंग मशीन मॉडल के साथ एल्गोरिथम गणना (algorithmic computation) का औपचारिक रूप से वर्णन किया (इन्हें आधुनिक कंप्यूटिंग/सैद्धांतिक कंप्यूटर विज्ञान के अग्रदूतों में गिना जाता है)"},"o":[{"en":"He invented the computer mouse","hi":"उन्होंने कंप्यूटर माउस का आविष्कार किया"},{"en":"He formally described algorithmic computation with the Turing machine model (counted among pioneers of modern computing/theoretical computer science)","hi":"उन्होंने ट्यूरिंग मशीन मॉडल के साथ एल्गोरिथम गणना (algorithmic computation) का औपचारिक रूप से वर्णन किया (इन्हें आधुनिक कंप्यूटिंग/सैद्धांतिक कंप्यूटर विज्ञान के अग्रदूतों में गिना जाता है)"},{"en":"He founded Apple Inc.","hi":"उन्होंने Apple Inc. की स्थापना की"},{"en":"He developed Bluetooth","hi":"उन्होंने ब्लूटूथ विकसित किया"}],"exp":{"en":"Alan Turing formalized the concepts of algorithm and computation with his 1936 Turing machine model, making him a founding father of theoretical computer science.","hi":"एलन ट्यूरिंग ने अपने 'ट्यूरिंग मशीन' मॉडल के जरिए एल्गोरिदम से गणना का सिद्धांत दिया। उन्हें सैद्धांतिक कंप्यूटर विज्ञान (theoretical computer science) का जनक माना जाता है।"},"num":30},{"id":"q31","q":{"en":"Why is Ada Lovelace known as the first programmer?","hi":"एडा लवलेस (Ada Lovelace) को पहली प्रोग्रामर क्यों कहा जाता है?"},"a":{"en":"In 1843, she published an algorithm to calculate Bernoulli numbers for Charles Babbage's Analytical Engine","hi":"1843 में, उन्होंने चार्ल्स बैबेज के एनालिटिकल इंजन के लिए बरनौली संख्याओं (Bernoulli numbers) की गणना करने के लिए एक एल्गोरिदम प्रकाशित किया"},"o":[{"en":"She wrote code in Python","hi":"उन्होंने पायथन (Python) में कोड लिखा"},{"en":"She programmed the ENIAC in 1945","hi":"उन्होंने 1945 में ENIAC को प्रोग्राम किया"},{"en":"In 1843, she published an algorithm to calculate Bernoulli numbers for Charles Babbage's Analytical Engine","hi":"1843 में, उन्होंने चार्ल्स बैबेज के एनालिटिकल इंजन के लिए बरनौली संख्याओं (Bernoulli numbers) की गणना करने के लिए एक एल्गोरिदम प्रकाशित किया"},{"en":"She created the World Wide Web","hi":"उन्होंने वर्ल्ड वाइड वेब (WWW) बनाया"}],"exp":{"en":"Ada Lovelace is credited as the first programmer for publishing the first algorithm (to calculate Bernoulli numbers) specifically intended to be executed by Babbage's Analytical Engine in 1843.","hi":"एडा लवलेस ने 1843 में चार्ल्स बैबेज के 'एनालिटिकल इंजन' के लिए बरनौली संख्याओं (Bernoulli numbers) की गणना का पहला एल्गोरिदम दिया था, इसलिए उन्हें पहली प्रोग्रामर माना जाता है।"},"num":31},{"id":"q32","q":{"en":"Who is credited with the invention of the computer mouse?","hi":"कंप्यूटर माउस के आविष्कार का श्रेय किसे जाता है?"},"a":{"en":"Douglas Engelbart developed the concept, and Bill English built the early prototype at SRI (public demo in 1968)","hi":"डगलस एंगेलबार्ट ने अवधारणा विकसित की, और बिल इंग्लिश ने SRI में प्रारंभिक प्रोटोटाइप बनाया (1968 में सार्वजनिक डेमो)"},"o":[{"en":"Douglas Engelbart developed the concept, and Bill English built the early prototype at SRI (public demo in 1968)","hi":"डगलस एंगेलबार्ट ने अवधारणा विकसित की, और बिल इंग्लिश ने SRI में प्रारंभिक प्रोटोटाइप बनाया (1968 में सार्वजनिक डेमो)"},{"en":"Steve Jobs","hi":"स्टीव जॉब्स"},{"en":"Bill Gates","hi":"बिल गेट्स"},{"en":"Seymour Cray","hi":"सीमोर क्रे"}],"exp":{"en":"Douglas Engelbart conceived the computer mouse, and his colleague Bill English built the first hardware prototype at the Stanford Research Institute (SRI). It was famously demoed in 1968.","hi":"कंप्यूटर माउस का आविष्कार डगलस एंगेलबार्ट (Douglas Engelbart) ने किया था। बिल इंग्लिश ने SRI में इसका प्रोटोटाइप बनाया और 1968 में इसका डेमो (प्रदर्शन) किया।"},"num":32},{"id":"q33","q":{"en":"Who is associated with the development of Bluetooth?","hi":"ब्लूटूथ (Bluetooth) के विकास से कौन जुड़ा है?"},"a":{"en":"Jaap Haartsen (played a key role in developing early Bluetooth radio technology at Ericsson)","hi":"जाप हर्टसेन (एरिकसन में प्रारंभिक ब्लूटूथ रेडियो तकनीक विकसित करने में महत्वपूर्ण भूमिका निभाई)"},"o":[{"en":"Tim Berners-Lee","hi":"टिम बर्नर्स-ली"},{"en":"Jaap Haartsen (played a key role in developing early Bluetooth radio technology at Ericsson)","hi":"जाप हर्टसेन (एरिकसन में प्रारंभिक ब्लूटूथ रेडियो तकनीक विकसित करने में महत्वपूर्ण भूमिका निभाई)"},{"en":"Vinod Khosla","hi":"विनोद खोसला"},{"en":"Alan Turing","hi":"एलन ट्यूरिंग"}],"exp":{"en":"Dutch engineer Jaap Haartsen is widely credited with inventing Bluetooth while working at Ericsson in the 1990s.","hi":"डच इंजीनियर जाप हर्टसेन (Jaap Haartsen) ने एरिकसन (Ericsson) में काम करते हुए ब्लूटूथ तकनीक के विकास में मुख्य भूमिका निभाई थी।"},"num":33},{"id":"q34","q":{"en":"What is the common exam association for Nathaniel Baldwin and the year 1910?","hi":"नथानिएल बाल्डविन (Nathaniel Baldwin) और वर्ष 1910 के लिए सामान्य परीक्षा (exam) संबंध क्या है?"},"a":{"en":"Development of early practical headphones (commonly cited as the 'world's first pair', documented by the Smithsonian)","hi":"प्रारंभिक व्यावहारिक हेडफ़ोन का विकास (आमतौर पर 'दुनिया की पहली जोड़ी' के रूप में उद्धृत, स्मिथसोनियन द्वारा प्रलेखित)"},"o":[{"en":"Invention of the microprocessor","hi":"माइक्रोप्रोसेसर का आविष्कार"},{"en":"Development of early practical headphones (commonly cited as the 'world's first pair', documented by the Smithsonian)","hi":"प्रारंभिक व्यावहारिक हेडफ़ोन का विकास (आमतौर पर 'दुनिया की पहली जोड़ी' के रूप में उद्धृत, स्मिथसोनियन द्वारा प्रलेखित)"},{"en":"Invention of the USB drive","hi":"USB ड्राइव का आविष्कार"},{"en":"Launch of the first satellite","hi":"पहले उपग्रह का प्रक्षेपण"}],"exp":{"en":"Nathaniel Baldwin is historically associated with inventing and manufacturing one of the first truly practical, modern-style audio headphones in 1910.","hi":"नथानिएल बाल्डविन (Nathaniel Baldwin) को 1910 में पहले व्यावहारिक (practical) हेडफ़ोन विकसित करने के लिए जाना जाता है। इसे अक्सर 'दुनिया का पहला हेडफ़ोन' कहा जाता है।"},"num":34},{"id":"q35","q":{"en":"How should the invention and early commercial history of the USB pen drive be remembered?","hi":"USB पेन ड्राइव के आविष्कार और प्रारंभिक व्यावसायिक इतिहास को कैसे याद रखा जाना चाहिए?"},"a":{"en":"PDF associates it with IBM and 1998; documented milestones include Trek's ThumbDrive and M-Systems' patent in 2000, with IBM marketing M-Systems' DiskOnKey","hi":"PDF इसे IBM और 1998 से जोड़ता है; प्रलेखित मील के पत्थरों (milestones) में ट्रेक का ThumbDrive और 2000 में M-Systems का पेटेंट शामिल है, जिसमें IBM ने M-Systems की DiskOnKey की मार्केटिंग की"},"o":[{"en":"Invented by Apple in 2010","hi":"2010 में Apple द्वारा आविष्कार किया गया"},{"en":"PDF associates it with IBM and 1998; documented milestones include Trek's ThumbDrive and M-Systems' patent in 2000, with IBM marketing M-Systems' DiskOnKey","hi":"PDF इसे IBM और 1998 से जोड़ता है; प्रलेखित मील के पत्थरों (milestones) में ट्रेक का ThumbDrive और 2000 में M-Systems का पेटेंट शामिल है, जिसमें IBM ने M-Systems की DiskOnKey की मार्केटिंग की"},{"en":"Developed entirely by Microsoft in 1995","hi":"1995 में पूरी तरह से Microsoft द्वारा विकसित"},{"en":"Invented by Douglas Engelbart","hi":"डगलस एंगेलबार्ट द्वारा आविष्कार किया गया"}],"exp":{"en":"While exam notes sometimes simplify the origin to IBM in 1998, the actual history involves multiple players like M-Systems and Trek releasing early commercial drives around 2000 (e.g., IBM marketed the DiskOnKey).","hi":"परीक्षा के नोट्स इसे अक्सर IBM और 1998 से जोड़ते हैं। हालांकि इतिहास में ट्रेक (Trek) का ThumbDrive और M-Systems (2000) का बड़ा योगदान है। IBM ने M-Systems के 'DiskOnKey' की मार्केटिंग की थी।"},"num":35}]},{"title":{"en":"4. Companies, Web History & Power Supply","hi":"4. कंपनियाँ, वेब इतिहास और पावर सप्लाई"},"questions":[{"id":"q36","q":{"en":"What is the full form of SMPS and what is its function?","hi":"SMPS का पूर्ण रूप क्या है और इसका कार्य क्या है?"},"a":{"en":"Switched-Mode Power Supply; converts and regulates power using high-frequency switching (e.g., providing required DC voltages for PC components)","hi":"स्विच्ड-मोड पावर सप्लाई; उच्च आवृत्ति स्विचिंग (high-frequency switching) का उपयोग करके बिजली को परिवर्तित और नियंत्रित करता है (जैसे, पीसी घटकों के लिए आवश्यक डीसी वोल्टेज प्रदान करना)"},"o":[{"en":"Serial Matrix Printing System; prints text","hi":"सीरियल मैट्रिक्स प्रिंटिंग सिस्टम; टेक्स्ट प्रिंट करता है"},{"en":"Switched-Mode Power Supply; converts and regulates power using high-frequency switching (e.g., providing required DC voltages for PC components)","hi":"स्विच्ड-मोड पावर सप्लाई; उच्च आवृत्ति स्विचिंग (high-frequency switching) का उपयोग करके बिजली को परिवर्तित और नियंत्रित करता है (जैसे, पीसी घटकों के लिए आवश्यक डीसी वोल्टेज प्रदान करना)"},{"en":"Secure Mail Protocol System; sends email","hi":"सुरक्षित मेल प्रोटोकॉल सिस्टम; ईमेल भेजता है"},{"en":"Simple Memory Processing Server; stores files","hi":"सिंपल मेमोरी प्रोसेसिंग सर्वर; फ़ाइलें स्टोर करता है"}],"exp":{"en":"SMPS stands for Switched-Mode Power Supply. It efficiently converts AC mains power into the regulated, low-voltage DC power needed by a computer's internal components.","hi":"SMPS का पूर्ण रूप स्विच्ड-मोड पावर सप्लाई (Switched-Mode Power Supply) है। यह उच्च आवृत्ति (high-frequency) पर स्विचिंग करके कंप्यूटर के पार्ट्स (components) के लिए सही DC वोल्टेज प्रदान करता है।"},"num":36},{"id":"q37","q":{"en":"What is the full form of HTML and who is its creator?","hi":"HTML का पूर्ण रूप क्या है और इसका निर्माता (creator) कौन है?"},"a":{"en":"HyperText Markup Language; Tim Berners-Lee (developed alongside early Web work at CERN; first browser/server running by late 1990)","hi":"हाइपरटेक्स्ट मार्कअप लैंग्वेज; टिम बर्नर्स-ली (CERN में वेब के प्रारंभिक कार्य के साथ विकसित; 1990 के अंत तक पहला ब्राउज़र/सर्वर चल रहा था)"},"o":[{"en":"HyperText Machine Logic; Bill Gates","hi":"हाइपरटेक्स्ट मशीन लॉजिक; बिल गेट्स"},{"en":"Home Text Markup Language; Steve Jobs","hi":"होम टेक्स्ट मार्कअप लैंग्वेज; स्टीव जॉब्स"},{"en":"HyperText Markup Language; Tim Berners-Lee (developed alongside early Web work at CERN; first browser/server running by late 1990)","hi":"हाइपरटेक्स्ट मार्कअप लैंग्वेज; टिम बर्नर्स-ली (CERN में वेब के प्रारंभिक कार्य के साथ विकसित; 1990 के अंत तक पहला ब्राउज़र/सर्वर चल रहा था)"},{"en":"Hyperlink Transfer Management Language; Alan Turing","hi":"हाइपरलिंक ट्रांसफर मैनेजमेंट लैंग्वेज; एलन ट्यूरिंग"}],"exp":{"en":"HTML stands for HyperText Markup Language, created by Tim Berners-Lee at CERN to format documents for the World Wide Web.","hi":"HTML का पूर्ण रूप हाइपरटेक्स्ट मार्कअप लैंग्वेज (HyperText Markup Language) है। इसका विकास टिम बर्नर्स-ली ने CERN में वर्ल्ड वाइड वेब (WWW) के साथ किया था।"},"num":37},{"id":"q38","q":{"en":"Who were the co-founders of Sun Microsystems (launched in 1982)?","hi":"सन माइक्रोसिस्टम्स (Sun Microsystems - 1982 में लॉन्च) के सह-संस्थापक (co-founders) कौन थे?"},"a":{"en":"Vinod Khosla, Scott McNealy, Andy Bechtolsheim, and Bill Joy","hi":"विनोद खोसला, स्कॉट मैकनीली, एंडी बेक्टोल्सहेम और बिल जॉय"},"o":[{"en":"Steve Jobs and Steve Wozniak","hi":"स्टीव जॉब्स और स्टीव वोज्नियाक"},{"en":"Bill Gates and Paul Allen","hi":"बिल गेट्स और पॉल एलन"},{"en":"Larry Page and Sergey Brin","hi":"लैरी पेज और सर्गेई ब्रिन"},{"en":"Vinod Khosla, Scott McNealy, Andy Bechtolsheim, and Bill Joy","hi":"विनोद खोसला, स्कॉट मैकनीली, एंडी बेक्टोल्सहेम और बिल जॉय"}],"exp":{"en":"Sun Microsystems was founded in 1982 by Vinod Khosla, Scott McNealy, Andy Bechtolsheim, and Bill Joy.","hi":"सन माइक्रोसिस्टम्स की स्थापना 1982 में विनोद खोसला, स्कॉट मैकनीली, एंडी बेक्टोल्सहेम और बिल जॉय ने मिलकर की थी।"},"num":38},{"id":"q39","q":{"en":"Which company acquired Sun Microsystems in 2010?","hi":"2010 में किस कंपनी ने सन माइक्रोसिस्टम्स (Sun Microsystems) का अधिग्रहण (acquisition) किया?"},"a":{"en":"Oracle","hi":"ओरेकल"},"o":[{"en":"Microsoft","hi":"Microsoft"},{"en":"IBM","hi":"IBM"},{"en":"Oracle","hi":"ओरेकल"},{"en":"Apple","hi":"Apple"}],"exp":{"en":"Oracle Corporation completed the acquisition of Sun Microsystems in 2010.","hi":"ओरेकल (Oracle) ने 2010 में सन माइक्रोसिस्टम्स का अधिग्रहण पूरा किया था।"},"num":39},{"id":"q40","q":{"en":"When was Apple founded and who were its founders?","hi":"Apple की स्थापना कब हुई थी और इसके संस्थापक कौन थे?"},"a":{"en":"1976; Steve Jobs, Steve Wozniak, and Ronald Wayne","hi":"1976; स्टीव जॉब्स, स्टीव वोज्नियाक और रोनाल्ड वेन"},"o":[{"en":"1976; Steve Jobs, Steve Wozniak, and Ronald Wayne","hi":"1976; स्टीव जॉब्स, स्टीव वोज्नियाक और रोनाल्ड वेन"},{"en":"1980; Bill Gates and Paul Allen","hi":"1980; बिल गेट्स और पॉल एलन"},{"en":"1970; Alan Turing and Charles Babbage","hi":"1970; एलन ट्यूरिंग और चार्ल्स बैबेज"},{"en":"1995; Larry Page and Sergey Brin","hi":"1995; लैरी पेज और सर्गेई ब्रिन"}],"exp":{"en":"Apple was founded on April 1, 1976, by Steve Jobs, Steve Wozniak, and Ronald Wayne.","hi":"Apple की स्थापना 1976 में स्टीव जॉब्स, स्टीव वोज्नियाक और रोनाल्ड वेन (Ronald Wayne) ने की थी।"},"num":40},{"id":"q41","q":{"en":"What were Apple's former name, headquarters location, and first computer?","hi":"Apple का पूर्व नाम, मुख्यालय (headquarters) और पहला कंप्यूटर क्या था?"},"a":{"en":"Apple Computer Company (later Apple Computer, Inc.); Cupertino, California; Apple I","hi":"एप्पल कंप्यूटर कंपनी (बाद में एप्पल कंप्यूटर, इंक.); क्यूपर्टिनो (Cupertino), कैलिफोर्निया; Apple I"},"o":[{"en":"Micro-Soft; Seattle; Altair","hi":"माइक्रो-सॉफ्ट; सिएटल; अल्टेयर"},{"en":"Apple Computer Company (later Apple Computer, Inc.); Cupertino, California; Apple I","hi":"एप्पल कंप्यूटर कंपनी (बाद में एप्पल कंप्यूटर, इंक.); क्यूपर्टिनो (Cupertino), कैलिफोर्निया; Apple I"},{"en":"Macintosh Inc.; New York; Mac 1","hi":"मैकिन्टोश इंक.; न्यूयॉर्क; Mac 1"},{"en":"iCorp; Silicon Valley; iPhone","hi":"iCorp; सिलिकॉन वैली; iPhone"}],"exp":{"en":"Initially the Apple Computer Company (and then Apple Computer, Inc.), headquartered in Cupertino, CA, its first product was the Apple I computer.","hi":"Apple का शुरुआती नाम 'एप्पल कंप्यूटर कंपनी' था। इसका मुख्यालय क्यूपर्टिनो (Cupertino, California) में है और इसका पहला कंप्यूटर Apple I था।"},"num":41},{"id":"q42","q":{"en":"When did Apple introduce the original iPad?","hi":"Apple ने मूल iPad (original iPad) कब पेश किया?"},"a":{"en":"2010 / 2010","hi":"2010 / 2010"},"o":[{"en":"2007","hi":"2007"},{"en":"2001","hi":"2001"},{"en":"2015","hi":"2015"},{"en":"2010 / 2010","hi":"2010 / 2010"}],"exp":{"en":"Steve Jobs introduced the first-generation iPad in 2010.","hi":"Apple ने पहला iPad वर्ष 2010 में पेश किया था।"},"num":42},{"id":"q43","q":{"en":"Who co-founded Microsoft and when?","hi":"Microsoft की सह-स्थापना किसने की और कब?"},"a":{"en":"Bill Gates and Paul Allen in 1975","hi":"1975 में बिल गेट्स और पॉल एलन"},"o":[{"en":"Steve Jobs and Steve Wozniak in 1976","hi":"1976 में स्टीव जॉब्स और स्टीव वोज्नियाक"},{"en":"Larry Page and Sergey Brin in 1998","hi":"1998 में लैरी पेज और सर्गेई ब्रिन"},{"en":"Bill Gates and Paul Allen in 1975","hi":"1975 में बिल गेट्स और पॉल एलन"},{"en":"Mark Zuckerberg in 2004","hi":"2004 में मार्क जुकरबर्ग"}],"exp":{"en":"Microsoft was co-founded by childhood friends Bill Gates and Paul Allen in 1975.","hi":"Microsoft की स्थापना बिल गेट्स (Bill Gates) और पॉल एलन (Paul Allen) ने मिलकर 1975 में की थी।"},"num":43},{"id":"q44","q":{"en":"Who are the founders of Google and where are its headquarters?","hi":"Google के संस्थापक कौन हैं और इसका मुख्यालय (headquarters) कहाँ है?"},"a":{"en":"Larry Page and Sergey Brin; Headquarters in Mountain View, California, USA","hi":"लैरी पेज और सर्गेई ब्रिन; माउंटेन व्यू (Mountain View), कैलिफोर्निया, यूएसए में मुख्यालय"},"o":[{"en":"Larry Page and Sergey Brin; Headquarters in Mountain View, California, USA","hi":"लैरी पेज और सर्गेई ब्रिन; माउंटेन व्यू (Mountain View), कैलिफोर्निया, यूएसए में मुख्यालय"},{"en":"Bill Gates and Paul Allen; Headquarters in Seattle, Washington","hi":"बिल गेट्स और पॉल एलन; सिएटल, वाशिंगटन में मुख्यालय"},{"en":"Steve Jobs and Steve Wozniak; Headquarters in Cupertino, California","hi":"स्टीव जॉब्स और स्टीव वोज्नियाक; क्यूपर्टिनो, कैलिफोर्निया में मुख्यालय"},{"en":"Jerry Yang and David Filo; Headquarters in Sunnyvale, California","hi":"जेरी यांग और डेविड फाइलो; सनीवेल, कैलिफोर्निया में मुख्यालय"}],"exp":{"en":"Google was founded by Larry Page and Sergey Brin. Its global headquarters, the Googleplex, is located in Mountain View, California.","hi":"Google के संस्थापक लैरी पेज (Larry Page) और सर्गेई ब्रिन (Sergey Brin) हैं। इसका मुख्यालय माउंटेन व्यू (Mountain View), कैलिफोर्निया में है।"},"num":44},{"id":"q45","q":{"en":"What was the early online newspaper milestone for 'The Hindu'?","hi":"'द हिंदू' (The Hindu) के लिए प्रारंभिक ऑनलाइन समाचार पत्र मील का पत्थर (milestone) क्या था?"},"a":{"en":"It launched its website in 1995 and was among the earliest online newspapers in India (the \"first newspaper on the Internet\" clue should be read in the context of India)","hi":"इसने 1995 में अपनी वेबसाइट लॉन्च की और भारत के सबसे शुरुआती ऑनलाइन समाचार पत्रों में से एक था (नोट्स में दिए गए \"इंटरनेट पर पहला समाचार पत्र\" सुराग को भारत के संदर्भ में पढ़ा जाना चाहिए)"},"o":[{"en":"It was the first newspaper in the world to launch a website in 1980","hi":"यह 1980 में वेबसाइट लॉन्च करने वाला दुनिया का पहला समाचार पत्र था"},{"en":"It launched its website in 1995 and was among the earliest online newspapers in India (the \"first newspaper on the Internet\" clue should be read in the context of India)","hi":"इसने 1995 में अपनी वेबसाइट लॉन्च की और भारत के सबसे शुरुआती ऑनलाइन समाचार पत्रों में से एक था (नोट्स में दिए गए \"इंटरनेट पर पहला समाचार पत्र\" सुराग को भारत के संदर्भ में पढ़ा जाना चाहिए)"},{"en":"It was the first newspaper to be delivered by email in 2005","hi":"यह 2005 में ईमेल द्वारा दिया जाने वाला पहला समाचार पत्र था"},{"en":"It never launched a website","hi":"इसने कभी वेबसाइट लॉन्च नहीं की"}],"exp":{"en":"The Hindu launched its internet edition in 1995, making it a pioneer of online journalism in India. Exam notes often refer to it as the 'first in India' on the internet.","hi":"द हिंदू (The Hindu) ने 1995 में अपनी वेबसाइट लॉन्च की थी। यह भारत में इंटरनेट पर आने वाले सबसे शुरुआती अखबारों में से एक था।"},"num":45}]},{"title":{"en":"5. DOCX Supplement — Web, File Transfer & Email Protocols","hi":"5. वेब, फ़ाइल ट्रांसफ़र और ईमेल प्रोटोकॉल"},"questions":[{"id":"q46","q":{"en":"What is the full form and role of HTTP?","hi":"HTTP का पूर्ण रूप (full form) और भूमिका क्या है?"},"a":{"en":"HyperText Transfer Protocol; it is an application-layer request-response protocol used to transfer HTML and other resources between browsers/clients and web servers","hi":"हाइपरटेक्स्ट ट्रांसफर प्रोटोकॉल; यह एक एप्लिकेशन-लेयर अनुरोध-प्रतिक्रिया (request-response) प्रोटोकॉल है जिसका उपयोग ब्राउज़र/क्लाइंट और वेब सर्वर के बीच HTML और अन्य संसाधनों को स्थानांतरित करने के लिए किया जाता है"},"o":[{"en":"HyperText Transfer Protocol; it is an application-layer request-response protocol used to transfer HTML and other resources between browsers/clients and web servers","hi":"हाइपरटेक्स्ट ट्रांसफर प्रोटोकॉल; यह एक एप्लिकेशन-लेयर अनुरोध-प्रतिक्रिया (request-response) प्रोटोकॉल है जिसका उपयोग ब्राउज़र/क्लाइंट और वेब सर्वर के बीच HTML और अन्य संसाधनों को स्थानांतरित करने के लिए किया जाता है"},{"en":"Host Text Transmission Process; it connects keyboards to CPUs","hi":"होस्ट टेक्स्ट ट्रांसमिशन प्रोसेस; यह कीबोर्ड को CPU से जोड़ता है"},{"en":"Hyperlink Translation Program; it translates languages on websites","hi":"हाइपरलिंक ट्रांसलेशन प्रोग्राम; यह वेबसाइटों पर भाषाओं का अनुवाद करता है"},{"en":"Hardware Test Transfer Protocol; it checks for hard drive errors","hi":"हार्डवेयर टेस्ट ट्रांसफर प्रोटोकॉल; यह हार्ड ड्राइव त्रुटियों (errors) की जांच करता है"}],"exp":{"en":"HTTP (HyperText Transfer Protocol) is the fundamental application-layer protocol that browsers use to request and receive web pages and resources from servers.","hi":"HTTP का पूर्ण रूप हाइपरटेक्स्ट ट्रांसफर प्रोटोकॉल है। यह क्लाइंट (जैसे ब्राउज़र) और वेब सर्वर के बीच वेब पेजों और संसाधनों (resources) को ट्रांसफर करने के लिए उपयोग किया जाता है।"},"num":46},{"id":"q47","q":{"en":"What does it mean when we say HTTP is 'stateless'?","hi":"जब हम कहते हैं कि HTTP 'स्टेटलेस' (stateless) है, तो इसका क्या अर्थ है?"},"a":{"en":"Every request in the protocol is understood independently without relying on previous requests; login/session state must be managed via cookies, tokens, or server-side storage","hi":"प्रोटोकॉल में प्रत्येक अनुरोध को पिछले अनुरोधों पर निर्भर किए बिना स्वतंत्र रूप से समझा जाता है; लॉगिन/सत्र स्थिति को कुकीज़, टोकन या सर्वर-साइड स्टोरेज के माध्यम से प्रबंधित किया जाना चाहिए"},"o":[{"en":"It can only be used in one country","hi":"इसका उपयोग केवल एक देश में किया जा सकता है"},{"en":"Every request in the protocol is understood independently without relying on previous requests; login/session state must be managed via cookies, tokens, or server-side storage","hi":"प्रोटोकॉल में प्रत्येक अनुरोध को पिछले अनुरोधों पर निर्भर किए बिना स्वतंत्र रूप से समझा जाता है; लॉगिन/सत्र स्थिति को कुकीज़, टोकन या सर्वर-साइड स्टोरेज के माध्यम से प्रबंधित किया जाना चाहिए"},{"en":"It does not require an internet connection","hi":"इसके लिए इंटरनेट कनेक्शन की आवश्यकता नहीं है"},{"en":"It never saves any files on the hard drive","hi":"यह कभी भी हार्ड ड्राइव पर कोई फ़ाइल सहेजता (save) नहीं है"}],"exp":{"en":"A stateless protocol treats each request as an independent transaction unrelated to any previous request, requiring extra mechanisms (like cookies) to maintain user sessions.","hi":"स्टेटलेस का मतलब है कि सर्वर हर नई रिक्वेस्ट (request) को स्वतंत्र रूप से देखता है और पुरानी रिक्वेस्ट याद नहीं रखता। सेशन (जैसे लॉगिन) बनाए रखने के लिए कुकीज़ (cookies) या टोकन का उपयोग करना पड़ता है।"},"num":47},{"id":"q48","q":{"en":"What is the full form and primary use of FTP?","hi":"FTP का पूर्ण रूप और मुख्य उपयोग क्या है?"},"a":{"en":"File Transfer Protocol; used for uploading and downloading files between a client and a server, such as uploading webpage files to a server","hi":"फाइल ट्रांसफर प्रोटोकॉल; क्लाइंट और सर्वर के बीच फ़ाइलें अपलोड और डाउनलोड करने के लिए उपयोग किया जाता है, जैसे वेबपेज फ़ाइलों को सर्वर पर अपलोड करना"},"o":[{"en":"Fast Text Protocol; for sending SMS","hi":"फास्ट टेक्स्ट प्रोटोकॉल; SMS भेजने के लिए"},{"en":"File Transfer Protocol; used for uploading and downloading files between a client and a server, such as uploading webpage files to a server","hi":"फाइल ट्रांसफर प्रोटोकॉल; क्लाइंट और सर्वर के बीच फ़ाइलें अपलोड और डाउनलोड करने के लिए उपयोग किया जाता है, जैसे वेबपेज फ़ाइलों को सर्वर पर अपलोड करना"},{"en":"Folder Tracking Process; to monitor deleted folders","hi":"फोल्डर ट्रैकिंग प्रोसेस; हटाए गए फ़ोल्डरों की निगरानी के लिए"},{"en":"Fiber Transmission Protocol; to connect optical fibers","hi":"फाइबर ट्रांसमिशन प्रोटोकॉल; ऑप्टिकल फाइबर को जोड़ने के लिए"}],"exp":{"en":"FTP (File Transfer Protocol) is a standard network protocol used for the reliable transfer of computer files between a client and server on a computer network.","hi":"FTP (फाइल ट्रांसफर प्रोटोकॉल) का उपयोग नेटवर्क पर क्लाइंट और सर्वर के बीच फ़ाइलें भेजने (upload) और प्राप्त करने (download) के लिए किया जाता है।"},"num":48},{"id":"q49","q":{"en":"What is the role of Telnet?","hi":"टेलनेट (Telnet) की क्या भूमिका है?"},"a":{"en":"It provides interactive, bidirectional text communication via a virtual terminal for remote login","hi":"यह रिमोट लॉगिन के लिए वर्चुअल टर्मिनल के माध्यम से इंटरैक्टिव, द्विदिशात्मक (bidirectional) टेक्स्ट संचार प्रदान करता है"},"o":[{"en":"It provides interactive, bidirectional text communication via a virtual terminal for remote login","hi":"यह रिमोट लॉगिन के लिए वर्चुअल टर्मिनल के माध्यम से इंटरैक्टिव, द्विदिशात्मक (bidirectional) टेक्स्ट संचार प्रदान करता है"},{"en":"It is a protocol exclusively for sending encrypted emails","hi":"यह विशेष रूप से एन्क्रिप्टेड ईमेल भेजने के लिए एक प्रोटोकॉल है"},{"en":"It connects wireless mice to computers","hi":"यह वायरलेस माउस को कंप्यूटर से जोड़ता है"},{"en":"It transfers high-resolution video streams","hi":"यह उच्च-रिज़ॉल्यूशन वीडियो स्ट्रीम स्थानांतरित (transfer) करता है"}],"exp":{"en":"Telnet is an older network protocol used to provide a bidirectional, interactive text-oriented communication facility (remote terminal access) over a network.","hi":"टेलनेट (Telnet) का उपयोग रिमोट लॉगिन (दूर बैठे कंप्यूटर को कंट्रोल करना) के लिए होता है, जिसमें कमांड-लाइन (text) के जरिए संचार किया जाता है।"},"num":49},{"id":"q50","q":{"en":"What is the full form and primary use of SMTP?","hi":"SMTP का पूर्ण रूप और मुख्य उपयोग क्या है?"},"a":{"en":"Simple Mail Transfer Protocol; it submits outgoing emails and relays them between mail servers","hi":"सिंपल मेल ट्रांसफर प्रोटोकॉल; यह आउटगोइंग (outgoing) ईमेल सबमिट करता है और उन्हें मेल सर्वर के बीच रिले (relay) करता है"},"o":[{"en":"System Mail Tracking Program; reads incoming emails","hi":"सिस्टम मेल ट्रैकिंग प्रोग्राम; इनकमिंग (incoming) ईमेल पढ़ता है"},{"en":"Secure Message Transmission Protocol; encrypts chats","hi":"सिक्योर मैसेज ट्रांसमिशन प्रोटोकॉल; चैट को एन्क्रिप्ट करता है"},{"en":"Simple Mail Transfer Protocol; it submits outgoing emails and relays them between mail servers","hi":"सिंपल मेल ट्रांसफर प्रोटोकॉल; यह आउटगोइंग (outgoing) ईमेल सबमिट करता है और उन्हें मेल सर्वर के बीच रिले (relay) करता है"},{"en":"Serial Media Transfer Protocol; burns CDs","hi":"सीरियल मीडिया ट्रांसफर प्रोटोकॉल; CD बर्न करता है"}],"exp":{"en":"SMTP (Simple Mail Transfer Protocol) is the standard internet protocol for sending (submitting and relaying) email messages.","hi":"SMTP (सिंपल मेल ट्रांसफर प्रोटोकॉल) का उपयोग आउटगोइंग ईमेल (भेजे जाने वाले ईमेल) को सबमिट करने और सर्वरों के बीच ट्रांसफर करने के लिए किया जाता है।"},"num":50},{"id":"q51","q":{"en":"What is the difference between the SMTP envelope and the message header?","hi":"SMTP एन्वलप (envelope) और मैसेज हेडर (message header) के बीच क्या अंतर है?"},"a":{"en":"The SMTP MAIL FROM and RCPT TO commands specify the envelope sender and recipient, while the visible From/To headers are part of the message content","hi":"SMTP MAIL FROM और RCPT TO कमांड एन्वलप प्रेषक और प्राप्तकर्ता (sender and recipient) को निर्दिष्ट (specify) करते हैं, जबकि दिखाई देने वाले From/To हेडर संदेश सामग्री (message content) का हिस्सा हैं"},"o":[{"en":"They are exactly the same thing","hi":"वे बिल्कुल एक ही चीज़ हैं"},{"en":"The SMTP MAIL FROM and RCPT TO commands specify the envelope sender and recipient, while the visible From/To headers are part of the message content","hi":"SMTP MAIL FROM और RCPT TO कमांड एन्वलप प्रेषक और प्राप्तकर्ता (sender and recipient) को निर्दिष्ट (specify) करते हैं, जबकि दिखाई देने वाले From/To हेडर संदेश सामग्री (message content) का हिस्सा हैं"},{"en":"The envelope contains the attachment, the header contains the text","hi":"एन्वलप में अटैचमेंट होता है, हेडर में टेक्स्ट होता है"},{"en":"The header routes the email, the envelope is only for encryption","hi":"हेडर ईमेल को रूट करता है, एन्वलप केवल एन्क्रिप्शन के लिए है"}],"exp":{"en":"The 'envelope' contains the actual routing data used by the SMTP protocol (MAIL FROM/RCPT TO). The 'header' contains the From/To fields seen by the user inside the email client.","hi":"SMTP एन्वलप का उपयोग मेल सर्वर द्वारा ईमेल को रूट करने (MAIL FROM, RCPT TO) के लिए किया जाता है। जबकि From/To हेडर वह होता है जो उपयोगकर्ता (user) को ईमेल ऐप में दिखाई देता है।"},"num":51},{"id":"q52","q":{"en":"What are the full forms of POP3 and IMAP?","hi":"POP3 और IMAP के पूर्ण रूप क्या हैं?"},"a":{"en":"Post Office Protocol version 3 and Internet Message Access Protocol","hi":"पोस्ट ऑफिस प्रोटोकॉल वर्ज़न 3 और इंटरनेट मैसेज एक्सेस प्रोटोकॉल"},"o":[{"en":"Post Office Protocol version 3 and Internet Message Access Protocol","hi":"पोस्ट ऑफिस प्रोटोकॉल वर्ज़न 3 और इंटरनेट मैसेज एक्सेस प्रोटोकॉल"},{"en":"Public Online Protocol 3 and Internal Mail Application Program","hi":"पब्लिक ऑनलाइन प्रोटोकॉल 3 और इंटरनल मेल एप्लिकेशन प्रोग्राम"},{"en":"Primary Object Protocol 3 and Instant Messaging Architecture Protocol","hi":"प्राइमरी ऑब्जेक्ट प्रोटोकॉल 3 और इंस्टेंट मैसेजिंग आर्किटेक्चर प्रोटोकॉल"},{"en":"Point-of-Presence 3 and Integrated Mail Access Port","hi":"पॉइंट-ऑफ-प्रेजेंस 3 और इंटीग्रेटेड मेल एक्सेस पोर्ट"}],"exp":{"en":"POP3 stands for Post Office Protocol version 3. IMAP stands for Internet Message Access Protocol. Both are used by clients to retrieve email.","hi":"POP3 का पूर्ण रूप पोस्ट ऑफिस प्रोटोकॉल वर्ज़न 3 (Post Office Protocol version 3) है, और IMAP का पूर्ण रूप इंटरनेट मैसेज एक्सेस प्रोटोकॉल (Internet Message Access Protocol) है।"},"num":52},{"id":"q53","q":{"en":"What is the practical difference between POP3 and IMAP?","hi":"POP3 और IMAP के बीच व्यावहारिक अंतर (practical difference) क्या है?"},"a":{"en":"POP3 retrieves/downloads mail (deleting the server copy depends on client settings). IMAP syncs the mailbox state on the server, making it useful for multiple devices.","hi":"POP3 मेल प्राप्त/डाउनलोड करता है (सर्वर कॉपी को हटाना क्लाइंट सेटिंग्स पर निर्भर करता है)। IMAP सर्वर पर मेलबॉक्स की स्थिति (state) को सिंक करता है, जिससे यह कई डिवाइस के लिए उपयोगी हो जाता है।"},"o":[{"en":"POP3 sends emails, IMAP prints them","hi":"POP3 ईमेल भेजता है, IMAP उन्हें प्रिंट करता है"},{"en":"POP3 retrieves/downloads mail (deleting the server copy depends on client settings). IMAP syncs the mailbox state on the server, making it useful for multiple devices.","hi":"POP3 मेल प्राप्त/डाउनलोड करता है (सर्वर कॉपी को हटाना क्लाइंट सेटिंग्स पर निर्भर करता है)। IMAP सर्वर पर मेलबॉक्स की स्थिति (state) को सिंक करता है, जिससे यह कई डिवाइस के लिए उपयोगी हो जाता है।"},{"en":"POP3 is for videos, IMAP is for text","hi":"POP3 वीडियो के लिए है, IMAP टेक्स्ट के लिए है"},{"en":"They are completely identical in function","hi":"वे कार्य में पूरी तरह से समान हैं"}],"exp":{"en":"POP3 is traditionally designed to download emails and (often) delete them from the server. IMAP synchronizes the email client with the server, keeping all devices updated with read/unread statuses.","hi":"POP3 आमतौर पर डिवाइस पर ईमेल डाउनलोड करता है (और अक्सर सर्वर से हटा देता है)। IMAP सर्वर के साथ ईमेल सिंक (sync) करता है, जिससे आप कई डिवाइस (फोन, लैपटॉप) पर एक ही इनबॉक्स को मैनेज कर सकते हैं।"},"num":53},{"id":"q54","q":{"en":"What is the full form and use of MIME?","hi":"MIME का पूर्ण रूप और उपयोग क्या है?"},"a":{"en":"Multipurpose Internet Mail Extensions; sets standards for describing and encoding email attachments, non-ASCII text, and multiple content parts","hi":"मल्टीपर्पज इंटरनेट मेल एक्सटेंशन्स; ईमेल अटैचमेंट, गैर-ASCII टेक्स्ट (non-ASCII text) और कई सामग्री भागों (multiple content parts) का वर्णन और एन्कोडिंग करने के लिए मानक तय करता है"},"o":[{"en":"Mobile Internet Messaging Extension; used for SMS","hi":"मोबाइल इंटरनेट मैसेजिंग एक्सटेंशन; SMS के लिए उपयोग किया जाता है"},{"en":"Multipurpose Internet Mail Extensions; sets standards for describing and encoding email attachments, non-ASCII text, and multiple content parts","hi":"मल्टीपर्पज इंटरनेट मेल एक्सटेंशन्स; ईमेल अटैचमेंट, गैर-ASCII टेक्स्ट (non-ASCII text) और कई सामग्री भागों (multiple content parts) का वर्णन और एन्कोडिंग करने के लिए मानक तय करता है"},{"en":"Master Internal Memory Emulator; used to test RAM","hi":"मास्टर इंटरनल मेमोरी एमुलेटर; RAM का परीक्षण करने के लिए उपयोग किया जाता है"},{"en":"Micro Instruction Machine Engine; used in CPUs","hi":"माइक्रो इंस्ट्रक्शन मशीन इंजन; CPU में उपयोग किया जाता है"}],"exp":{"en":"MIME extends the format of email to support text in character sets other than ASCII, as well as attachments of audio, video, images, and application programs.","hi":"MIME (मल्टीपर्पज इंटरनेट मेल एक्सटेंशन्स) का उपयोग ईमेल में अटैचमेंट (जैसे इमेज, वीडियो) और गैर-ASCII टेक्स्ट (जैसे हिंदी या चीनी भाषा) भेजने के लिए किया जाता है।"},"num":54}]},{"title":{"en":"6. DOCX Supplement — IP Services, Addressing & Voice","hi":"6. IP सेवाएँ, एड्रेसिंग और वॉइस"},"questions":[{"id":"q55","q":{"en":"What is VoIP?","hi":"VoIP क्या है?"},"a":{"en":"Voice over Internet Protocol; carries voice in digital packets over an IP network, such as for an internet call","hi":"वॉयस ओवर इंटरनेट प्रोटोकॉल; एक IP नेटवर्क पर डिजिटल पैकेट में वॉयस (voice) ले जाता है, जैसे इंटरनेट कॉल के लिए"},"o":[{"en":"Video over Internal Protocol; used for CCTV","hi":"वीडियो ओवर इंटरनल प्रोटोकॉल; CCTV के लिए उपयोग किया जाता है"},{"en":"Voice over Internet Protocol; carries voice in digital packets over an IP network, such as for an internet call","hi":"वॉयस ओवर इंटरनेट प्रोटोकॉल; एक IP नेटवर्क पर डिजिटल पैकेट में वॉयस (voice) ले जाता है, जैसे इंटरनेट कॉल के लिए"},{"en":"Virtual Object Integration Program; used in 3D modeling","hi":"वर्चुअल ऑब्जेक्ट इंटीग्रेशन प्रोग्राम; 3D मॉडलिंग में उपयोग किया जाता है"},{"en":"Verified Online Identity Provider; used for logins","hi":"वेरिफाइड ऑनलाइन आइडेंटिटी प्रोवाइडर; लॉगिन के लिए उपयोग किया जाता है"}],"exp":{"en":"VoIP (Voice over Internet Protocol) is a technology that allows you to make voice calls using a broadband internet connection instead of a regular (or analog) phone line.","hi":"VoIP का पूर्ण रूप 'वॉयस ओवर इंटरनेट प्रोटोकॉल' है। यह हमारी आवाज़ को डिजिटल पैकेट्स में बदलकर इंटरनेट (IP नेटवर्क) के ज़रिए भेजता है (जैसे कि इंटरनेट कॉलिंग)।"},"num":55},{"id":"q56","q":{"en":"What is the full form and function of DHCP?","hi":"DHCP का पूर्ण रूप और कार्य क्या है?"},"a":{"en":"Dynamic Host Configuration Protocol; a DHCP server leases IP addresses to devices and provides parameters like subnet mask, gateway, or DNS","hi":"डायनामिक होस्ट कॉन्फ़िगरेशन प्रोटोकॉल; एक DHCP सर्वर डिवाइसों को IP पते (addresses) पट्टे (lease) पर देता है और सबनेट मास्क, गेटवे या DNS जैसे पैरामीटर प्रदान करता है"},"o":[{"en":"Digital Hardware Connection Port; it connects printers","hi":"डिजिटल हार्डवेयर कनेक्शन पोर्ट; यह प्रिंटर कनेक्ट करता है"},{"en":"Dynamic Host Configuration Protocol; a DHCP server leases IP addresses to devices and provides parameters like subnet mask, gateway, or DNS","hi":"डायनामिक होस्ट कॉन्फ़िगरेशन प्रोटोकॉल; एक DHCP सर्वर डिवाइसों को IP पते (addresses) पट्टे (lease) पर देता है और सबनेट मास्क, गेटवे या DNS जैसे पैरामीटर प्रदान करता है"},{"en":"Data Handling Control Program; it manages hard drives","hi":"डेटा हैंडलिंग कंट्रोल प्रोग्राम; यह हार्ड ड्राइव का प्रबंधन करता है"},{"en":"Direct HTML Code Parser; it reads websites","hi":"डायरेक्ट HTML कोड पार्सर; यह वेबसाइटों को पढ़ता है"}],"exp":{"en":"DHCP (Dynamic Host Configuration Protocol) automatically assigns IP addresses and other network configuration parameters to devices on a network.","hi":"DHCP (डायनामिक होस्ट कॉन्फ़िगरेशन प्रोटोकॉल) नेटवर्क पर डिवाइसों (कंप्यूटर/फोन) को अपने आप IP एड्रेस और अन्य सेटिंग्स (जैसे सबनेट मास्क, गेटवे) असाइन करता है।"},"num":56},{"id":"q57","q":{"en":"What is the common initial address allocation sequence in DHCPv4?","hi":"DHCPv4 में सामान्य प्रारंभिक एड्रेस आवंटन अनुक्रम (initial address allocation sequence) क्या है?"},"a":{"en":"Discover → Offer → Request → Acknowledge (Short form: DORA)","hi":"डिस्कवर → ऑफर → रिक्वेस्ट → एकनॉलेज (संक्षिप्त रूप: DORA)"},"o":[{"en":"Ask → Get → Verify → Done","hi":"Ask → Get → Verify → Done"},{"en":"Send → Receive → Acknowledge","hi":"Send → Receive → Acknowledge"},{"en":"Discover → Offer → Request → Acknowledge (Short form: DORA)","hi":"डिस्कवर → ऑफर → रिक्वेस्ट → एकनॉलेज (संक्षिप्त रूप: DORA)"},{"en":"Start → Assign → Confirm","hi":"Start → Assign → Confirm"}],"exp":{"en":"The DHCPv4 process follows the DORA sequence: the client sends a Discover, the server replies with an Offer, the client sends a Request, and the server finishes with an Acknowledge.","hi":"DHCPv4 में एड्रेस प्राप्त करने की प्रक्रिया को DORA कहते हैं: Discover (क्लाइंट द्वारा खोज), Offer (सर्वर द्वारा प्रस्ताव), Request (क्लाइंट द्वारा अनुरोध) और Acknowledge (सर्वर द्वारा पावती)।"},"num":57},{"id":"q58","q":{"en":"What is the full form and layer of TCP?","hi":"TCP का पूर्ण रूप और लेयर (layer) क्या है?"},"a":{"en":"Transmission Control Protocol; Transport-layer connection-oriented protocol that provides a reliable, ordered byte stream","hi":"ट्रांसमिशन कंट्रोल प्रोटोकॉल; ट्रांसपोर्ट-लेयर कनेक्शन-ओरिएंटेड प्रोटोकॉल जो एक विश्वसनीय (reliable), क्रमित बाइट स्ट्रीम (ordered byte stream) प्रदान करता है"},"o":[{"en":"Text Control Program; Application layer","hi":"टेक्स्ट कंट्रोल प्रोग्राम; एप्लिकेशन लेयर"},{"en":"Transmission Control Protocol; Transport-layer connection-oriented protocol that provides a reliable, ordered byte stream","hi":"ट्रांसमिशन कंट्रोल प्रोटोकॉल; ट्रांसपोर्ट-लेयर कनेक्शन-ओरिएंटेड प्रोटोकॉल जो एक विश्वसनीय (reliable), क्रमित बाइट स्ट्रीम (ordered byte stream) प्रदान करता है"},{"en":"Transfer Code Protocol; Data link layer","hi":"ट्रांसफर कोड प्रोटोकॉल; डेटा लिंक लेयर"},{"en":"Transport Configuration Protocol; Network layer","hi":"ट्रांसपोर्ट कॉन्फ़िगरेशन प्रोटोकॉल; नेटवर्क लेयर"}],"exp":{"en":"TCP (Transmission Control Protocol) operates at the transport layer to provide a reliable, ordered, and error-checked delivery of a stream of bytes between applications.","hi":"TCP का पूर्ण रूप ट्रांसमिशन कंट्रोल प्रोटोकॉल है। यह ट्रांसपोर्ट लेयर का प्रोटोकॉल है जो दो डिवाइसों के बीच विश्वसनीय (reliable) और क्रमित (ordered) कनेक्शन सुनिश्चित करता है।"},"num":58},{"id":"q59","q":{"en":"How do the roles of TCP and IP differ?","hi":"TCP और IP की भूमिकाएँ (roles) कैसे भिन्न हैं?"},"a":{"en":"TCP handles connection, byte ordering, and retransmission. IP handles packet addressing and forwarding.","hi":"TCP कनेक्शन, बाइट ऑर्डरिंग और रिट्रांसमिशन (retransmission) को संभालता है। IP पैकेट एड्रेसिंग और फ़ॉरवर्डिंग को संभालता है।"},"o":[{"en":"TCP is for websites, IP is for emails","hi":"TCP वेबसाइटों के लिए है, IP ईमेल के लिए है"},{"en":"IP handles connection, byte ordering, and retransmission. TCP handles packet addressing and forwarding.","hi":"IP कनेक्शन, बाइट ऑर्डरिंग और रिट्रांसमिशन को संभालता है। TCP पैकेट एड्रेसिंग और फ़ॉरवर्डिंग को संभालता है।"},{"en":"TCP handles connection, byte ordering, and retransmission. IP handles packet addressing and forwarding.","hi":"TCP कनेक्शन, बाइट ऑर्डरिंग और रिट्रांसमिशन (retransmission) को संभालता है। IP पैकेट एड्रेसिंग और फ़ॉरवर्डिंग को संभालता है।"},{"en":"They perform exactly the same function","hi":"वे बिल्कुल एक ही कार्य करते हैं"}],"exp":{"en":"IP is responsible for routing packets to the correct destination address, while TCP is responsible for ensuring those packets arrive intact and assembling them in the correct order.","hi":"IP (इंटरनेट प्रोटोकॉल) का काम डेटा पैकेट्स पर सही पता (एड्रेस) लगाना और उन्हें आगे भेजना है। TCP का काम यह सुनिश्चित करना है कि डेटा सही क्रम में और बिना किसी त्रुटि (error) के पहुँचे (रिट्रांसमिशन आदि द्वारा)।"},"num":59},{"id":"q60","q":{"en":"What is the full form and use of SNMP?","hi":"SNMP का पूर्ण रूप और उपयोग क्या है?"},"a":{"en":"Simple Network Management Protocol; an application-layer protocol for monitoring and managing network devices like routers, switches, servers, and printers","hi":"सिंपल नेटवर्क मैनेजमेंट प्रोटोकॉल; राउटर, स्विच, सर्वर और प्रिंटर जैसे नेटवर्क डिवाइसों की निगरानी (monitoring) और प्रबंधन (management) के लिए एक एप्लिकेशन-लेयर प्रोटोकॉल"},"o":[{"en":"Secure Network Message Program; sends encrypted emails","hi":"सिक्योर नेटवर्क मैसेज प्रोग्राम; एन्क्रिप्टेड ईमेल भेजता है"},{"en":"Simple Network Management Protocol; an application-layer protocol for monitoring and managing network devices like routers, switches, servers, and printers","hi":"सिंपल नेटवर्क मैनेजमेंट प्रोटोकॉल; राउटर, स्विच, सर्वर और प्रिंटर जैसे नेटवर्क डिवाइसों की निगरानी (monitoring) और प्रबंधन (management) के लिए एक एप्लिकेशन-लेयर प्रोटोकॉल"},{"en":"System Node Mapping Protocol; draws network maps","hi":"सिस्टम नोड मैपिंग प्रोटोकॉल; नेटवर्क मैप बनाता है"},{"en":"Serial Number Matching Protocol; verifies hardware","hi":"सीरियल नंबर मैचिंग प्रोटोकॉल; हार्डवेयर को सत्यापित करता है"}],"exp":{"en":"SNMP (Simple Network Management Protocol) is used by network administrators to monitor network performance, find and solve network problems, and plan for network growth.","hi":"SNMP का पूर्ण रूप सिंपल नेटवर्क मैनेजमेंट प्रोटोकॉल है। इसका उपयोग नेटवर्क एडमिनिस्ट्रेटर द्वारा नेटवर्क डिवाइसों (जैसे राउटर, स्विच आदि) की निगरानी (monitoring) और प्रबंधन के लिए किया जाता है।"},"num":60},{"id":"q61","q":{"en":"What is the full form and purpose of NAT?","hi":"NAT का पूर्ण रूप और उद्देश्य क्या है?"},"a":{"en":"Network Address Translation; a router/gateway rewrites IP addresses to handle traffic between a private network and an external network (PAT/NAPT can also translate ports)","hi":"नेटवर्क एड्रेस ट्रांसलेशन; एक राउटर/गेटवे एक निजी नेटवर्क (private network) और एक बाहरी नेटवर्क (external network) के बीच ट्रैफ़िक को संभालने के लिए IP एड्रेस को फिर से लिखता है (PAT/NAPT पोर्ट का भी अनुवाद कर सकता है)"},"o":[{"en":"Network Access Terminal; a physical login computer","hi":"नेटवर्क एक्सेस टर्मिनल; एक भौतिक लॉगिन कंप्यूटर"},{"en":"Name Application Table; stores domain names","hi":"नेम एप्लिकेशन टेबल; डोमेन नाम संग्रहीत करता है"},{"en":"Network Address Translation; a router/gateway rewrites IP addresses to handle traffic between a private network and an external network (PAT/NAPT can also translate ports)","hi":"नेटवर्क एड्रेस ट्रांसलेशन; एक राउटर/गेटवे एक निजी नेटवर्क (private network) और एक बाहरी नेटवर्क (external network) के बीच ट्रैफ़िक को संभालने के लिए IP एड्रेस को फिर से लिखता है (PAT/NAPT पोर्ट का भी अनुवाद कर सकता है)"},{"en":"Node Allocation Timer; measures network speed","hi":"नोड एलोकेशन टाइमर; नेटवर्क की गति मापता है"}],"exp":{"en":"NAT (Network Address Translation) allows multiple devices on a local private network to access the public internet using a single public IP address by mapping the addresses at the router.","hi":"NAT का पूर्ण रूप नेटवर्क एड्रेस ट्रांसलेशन है। इसका उपयोग राउटर में किया जाता है ताकि स्थानीय नेटवर्क (private network) के कई डिवाइस एक ही पब्लिक IP एड्रेस का उपयोग करके इंटरनेट से जुड़ सकें।"},"num":61},{"id":"q62","q":{"en":"What is the full form and use of ARP?","hi":"ARP का पूर्ण रूप और उपयोग क्या है?"},"a":{"en":"Address Resolution Protocol; it finds the hardware/MAC address of the next hop on a local link from a known IPv4 address","hi":"एड्रेस रेज़ोल्यूशन प्रोटोकॉल; यह किसी ज्ञात (known) IPv4 पते से लोकल लिंक पर नेक्स्ट हॉप (next hop) का हार्डवेयर/मैक (MAC) पता लगाता है"},"o":[{"en":"Automatic Routing Process; finds the best path for data","hi":"ऑटोमैटिक रूटिंग प्रोसेस; डेटा के लिए सबसे अच्छा रास्ता खोजता है"},{"en":"Address Resolution Protocol; it finds the hardware/MAC address of the next hop on a local link from a known IPv4 address","hi":"एड्रेस रेज़ोल्यूशन प्रोटोकॉल; यह किसी ज्ञात (known) IPv4 पते से लोकल लिंक पर नेक्स्ट हॉप (next hop) का हार्डवेयर/मैक (MAC) पता लगाता है"},{"en":"Application Resource Provider; assigns RAM to programs","hi":"एप्लिकेशन रिसोर्स प्रोवाइडर; प्रोग्राम को RAM असाइन करता है"},{"en":"Analog Relay Port; connects old modems","hi":"एनालॉग रिले पोर्ट; पुराने मॉडेम को जोड़ता है"}],"exp":{"en":"ARP (Address Resolution Protocol) is used to map a known network layer IP address (IPv4) to an unknown data link layer MAC address on a local area network segment.","hi":"ARP का पूर्ण रूप एड्रेस रेज़ोल्यूशन प्रोटोकॉल है। यह किसी ज्ञात (known) IP एड्रेस (IPv4) से लोकल नेटवर्क पर डिवाइस का भौतिक पता (MAC एड्रेस) खोजने का काम करता है।"},"num":62},{"id":"q63","q":{"en":"If you need to send a packet to a remote internet host, whose MAC address does ARP look for?","hi":"यदि आपको रिमोट इंटरनेट होस्ट (remote internet host) को पैकेट भेजना है, तो ARP किसका MAC एड्रेस ढूँढता है?"},"a":{"en":"The MAC address of the local next-hop router or default gateway (even though the IP destination is the remote host)","hi":"लोकल नेक्स्ट-हॉप राउटर या डिफॉल्ट गेटवे का MAC एड्रेस (भले ही IP डेस्टिनेशन रिमोट होस्ट का हो)"},"o":[{"en":"The MAC address of the remote internet host itself","hi":"स्वयं रिमोट इंटरनेट होस्ट का MAC एड्रेस"},{"en":"The MAC address of the DNS server","hi":"DNS सर्वर का MAC एड्रेस"},{"en":"The MAC address of the local next-hop router or default gateway (even though the IP destination is the remote host)","hi":"लोकल नेक्स्ट-हॉप राउटर या डिफॉल्ट गेटवे का MAC एड्रेस (भले ही IP डेस्टिनेशन रिमोट होस्ट का हो)"},{"en":"It broadcasts the packet to all MAC addresses globally","hi":"यह विश्व स्तर पर सभी MAC पतों पर पैकेट को प्रसारित (broadcast) करता है"}],"exp":{"en":"MAC addresses are only used for local link communication. To reach a remote IP, your computer uses ARP to find the MAC address of the local router (default gateway) that will forward the packet.","hi":"MAC एड्रेस केवल लोकल नेटवर्क में काम आते हैं। इंटरनेट पर दूर (remote) किसी कंप्यूटर को डेटा भेजने के लिए, ARP आपके लोकल राउटर (डिफॉल्ट गेटवे) का MAC एड्रेस ढूँढता है, ताकि डेटा राउटर तक पहुँच सके (भले ही अंतिम IP एड्रेस रिमोट कंप्यूटर का हो)।"},"num":63}]},{"title":{"en":"7. DOCX Supplement — EPROM, ASCII, RDBMS & SQL","hi":"7. EPROM, ASCII, RDBMS और SQL"},"questions":[{"id":"q64","q":{"en":"What is the full form of EPROM and what type of memory is it?","hi":"EPROM का पूर्ण रूप क्या है और यह किस प्रकार की मेमोरी है?"},"a":{"en":"Erasable Programmable Read-Only Memory; a non-volatile chip that retains data even when the power is switched off","hi":"इरेज़ेबल प्रोग्रामेबल रीड-ओनली मेमोरी; एक गैर-वाष्पशील (non-volatile) चिप जो बिजली बंद होने पर भी डेटा बरकरार रखती है"},"o":[{"en":"External Power Read-Only Memory; volatile memory","hi":"एक्सटर्नल पावर रीड-ओनली मेमोरी; अस्थिर (volatile) मेमोरी"},{"en":"Electronic Programmable Read-Only Memory; temporary storage","hi":"इलेक्ट्रॉनिक प्रोग्रामेबल रीड-ओनली मेमोरी; अस्थायी (temporary) स्टोरेज"},{"en":"Erasable Programmable Read-Only Memory; a non-volatile chip that retains data even when the power is switched off","hi":"इरेज़ेबल प्रोग्रामेबल रीड-ओनली मेमोरी; एक गैर-वाष्पशील (non-volatile) चिप जो बिजली बंद होने पर भी डेटा बरकरार रखती है"},{"en":"Embedded Process Read-Only Memory; used only in smartwatches","hi":"एंबेडेड प्रोसेस रीड-ओनली मेमोरी; केवल स्मार्टवॉच में उपयोग किया जाता है"}],"exp":{"en":"EPROM (Erasable Programmable Read-Only Memory) is a type of non-volatile ROM chip that retains its data when its power supply is switched off.","hi":"EPROM का पूर्ण रूप इरेज़ेबल प्रोग्रामेबल रीड-ओनली मेमोरी (Erasable Programmable Read-Only Memory) है। यह एक नॉन-वोलेटाइल मेमोरी है, जो बिजली जाने के बाद भी डेटा को सुरक्षित रखती है।"},"num":64},{"id":"q65","q":{"en":"How are EPROMs erased and reused?","hi":"EPROM को इरेज़ (erase) और पुन: उपयोग (reuse) कैसे किया जाता है?"},"a":{"en":"Classic windowed EPROMs are erased using strong ultraviolet (UV) light before being reprogrammed (whereas EEPROMs are electrically erasable)","hi":"क्लासिक विंडो वाले EPROM को रिप्रोग्राम (reprogram) करने से पहले मजबूत पराबैंगनी (ultraviolet/UV) प्रकाश का उपयोग करके मिटाया (erase) जाता है (जबकि EEPROM विद्युत रूप से मिटाने योग्य होते हैं)"},"o":[{"en":"By using a magnetic eraser","hi":"एक मैग्नेटिक इरेज़र का उपयोग करके"},{"en":"Classic windowed EPROMs are erased using strong ultraviolet (UV) light before being reprogrammed (whereas EEPROMs are electrically erasable)","hi":"क्लासिक विंडो वाले EPROM को रिप्रोग्राम (reprogram) करने से पहले मजबूत पराबैंगनी (ultraviolet/UV) प्रकाश का उपयोग करके मिटाया (erase) जाता है (जबकि EEPROM विद्युत रूप से मिटाने योग्य होते हैं)"},{"en":"By deleting files from the recycle bin","hi":"रीसायकल बिन से फाइलें हटाकर"},{"en":"By restarting the computer","hi":"कंप्यूटर को पुनरारंभ (restart) करके"}],"exp":{"en":"Traditional EPROMs feature a transparent quartz window and are erased by exposure to strong ultraviolet (UV) light. (In contrast, EEPROMs are erased electrically).","hi":"क्लासिक EPROM चिप्स में एक क्वार्ट्ज़ विंडो होती है; उन्हें तेज़ पराबैंगनी (UV) प्रकाश में रखकर इरेज़ (erase) किया जाता है। (EEPROM को विद्युत/इलेक्ट्रिकली इरेज़ किया जाता है)।"},"num":65},{"id":"q66","q":{"en":"What is the full form and standard size of ASCII?","hi":"ASCII का पूर्ण रूप और मानक आकार (standard size) क्या है?"},"a":{"en":"American Standard Code for Information Interchange; standard ASCII is 7 bits, allowing 128 possible values (0–127)","hi":"अमेरिकन स्टैंडर्ड कोड फॉर इंफॉर्मेशन इंटरचेंज; स्टैंडर्ड ASCII 7 बिट्स का है, जिसमें 128 संभावित मान (0-127) होते हैं"},"o":[{"en":"Asian Standard Code for Information Interchange; 8 bits","hi":"एशियन स्टैंडर्ड कोड फॉर इंफॉर्मेशन इंटरचेंज; 8 बिट्स"},{"en":"American Standard Code for Information Interchange; standard ASCII is 7 bits, allowing 128 possible values (0–127)","hi":"अमेरिकन स्टैंडर्ड कोड फॉर इंफॉर्मेशन इंटरचेंज; स्टैंडर्ड ASCII 7 बिट्स का है, जिसमें 128 संभावित मान (0-127) होते हैं"},{"en":"Advanced System Code for Internet Interchange; 16 bits","hi":"एडवांस्ड सिस्टम कोड फॉर इंटरनेट इंटरचेंज; 16 बिट्स"},{"en":"Automatic Standard Code for Information Integration; 4 bits","hi":"ऑटोमैटिक स्टैंडर्ड कोड फॉर इंफॉर्मेशन इंटीग्रेशन; 4 बिट्स"}],"exp":{"en":"ASCII stands for American Standard Code for Information Interchange. The standard version is a 7-bit character encoding, yielding 128 (0–127) possible characters.","hi":"ASCII का पूर्ण रूप 'अमेरिकन स्टैंडर्ड कोड फॉर इंफॉर्मेशन इंटरचेंज' है। यह मूल रूप से 7-बिट का कोड है, जिसमें 128 (0 से 127) संभावित वैल्यू होते हैं।"},"num":66},{"id":"q67","q":{"en":"How many possible values are there in Extended ASCII?","hi":"एक्सटेंडेड ASCII में कितने संभावित मान (possible values) होते हैं?"},"a":{"en":"256 possible byte values in 8-bit ASCII-compatible code pages (the upper half depends on the specific code page)","hi":"8-बिट ASCII-संगत कोड पृष्ठों (code pages) में 256 संभावित बाइट मान (ऊपरी आधा भाग विशिष्ट कोड पृष्ठ पर निर्भर करता है)"},"o":[{"en":"128 possible values","hi":"128 संभावित मान"},{"en":"512 possible values","hi":"512 संभावित मान"},{"en":"256 possible byte values in 8-bit ASCII-compatible code pages (the upper half depends on the specific code page)","hi":"8-बिट ASCII-संगत कोड पृष्ठों (code pages) में 256 संभावित बाइट मान (ऊपरी आधा भाग विशिष्ट कोड पृष्ठ पर निर्भर करता है)"},{"en":"65,536 possible values","hi":"65,536 संभावित मान"}],"exp":{"en":"Extended ASCII uses 8 bits, providing 256 possible values (0–255). The characters represented by the upper 128 values vary depending on the specific code page in use.","hi":"एक्सटेंडेड ASCII 8-बिट का कोड है, इसलिए इसमें 2⁸ = 256 (0 से 255) संभावित वैल्यू होते हैं। इसके ऊपरी आधे हिस्से (128-255) का अर्थ चुने हुए कोड पेज (code page) पर निर्भर करता है।"},"num":67},{"id":"q68","q":{"en":"What is the full form of RDBMS and what is its data model?","hi":"RDBMS का पूर्ण रूप क्या है और इसका डेटा मॉडल (data model) क्या है?"},"a":{"en":"Relational Database Management System; data is organized into tables (relations) where rows are records/tuples and columns are fields/attributes","hi":"रिलेशनल डेटाबेस मैनेजमेंट सिस्टम; डेटा को टेबल (relations) में व्यवस्थित किया जाता है, जहाँ पंक्तियाँ (rows) रिकॉर्ड/ट्यूपल (tuples) होती हैं और कॉलम फ़ील्ड/विशेषताएँ (attributes) होते हैं"},"o":[{"en":"Random Database Memory System; data is organized in folders","hi":"रैंडम डेटाबेस मेमोरी सिस्टम; डेटा फ़ोल्डरों में व्यवस्थित होता है"},{"en":"Relational Database Management System; data is organized into tables (relations) where rows are records/tuples and columns are fields/attributes","hi":"रिलेशनल डेटाबेस मैनेजमेंट सिस्टम; डेटा को टेबल (relations) में व्यवस्थित किया जाता है, जहाँ पंक्तियाँ (rows) रिकॉर्ड/ट्यूपल (tuples) होती हैं और कॉलम फ़ील्ड/विशेषताएँ (attributes) होते हैं"},{"en":"Real-time Data Backup System; data is organized in cloud buckets","hi":"रियल-टाइम डेटा बैकअप सिस्टम; डेटा क्लाउड बकेट में व्यवस्थित होता है"},{"en":"Remote Data Base Micro Service; data is organized in lists","hi":"रिमोट डेटा बेस माइक्रो सर्विस; डेटा को सूचियों में व्यवस्थित किया जाता है"}],"exp":{"en":"An RDBMS (Relational Database Management System) organizes structured data into relations (tables), consisting of rows (tuples/records) and columns (attributes/fields).","hi":"RDBMS (रिलेशनल डेटाबेस मैनेजमेंट सिस्टम) डेटा को टेबल्स (relations) में रखता है। इसमें पंक्तियों (rows) को ट्यूपल्स (tuples) या रिकॉर्ड कहते हैं, और कॉलम (columns) को एट्रीब्यूट्स (attributes) या फील्ड कहते हैं।"},"num":68},{"id":"q69","q":{"en":"What is the purpose of a primary key and a foreign key in a database?","hi":"डेटाबेस में प्राथमिक कुंजी (primary key) और विदेशी कुंजी (foreign key) का उद्देश्य क्या है?"},"a":{"en":"A primary key uniquely identifies a row in a table. A foreign key links a value in one table to the key of a referenced table.","hi":"प्राथमिक कुंजी एक टेबल में एक पंक्ति (row) की विशिष्ट पहचान (uniquely identify) करती है। विदेशी कुंजी एक टेबल के मान (value) को संदर्भित टेबल (referenced table) की कुंजी से जोड़ती है।"},"o":[{"en":"Primary key opens the database, foreign key closes it","hi":"प्राथमिक कुंजी डेटाबेस खोलती है, विदेशी कुंजी इसे बंद कर देती है"},{"en":"A primary key uniquely identifies a row in a table. A foreign key links a value in one table to the key of a referenced table.","hi":"प्राथमिक कुंजी एक टेबल में एक पंक्ति (row) की विशिष्ट पहचान (uniquely identify) करती है। विदेशी कुंजी एक टेबल के मान (value) को संदर्भित टेबल (referenced table) की कुंजी से जोड़ती है।"},{"en":"Primary key encrypts data, foreign key decrypts data","hi":"प्राथमिक कुंजी डेटा को एन्क्रिप्ट करती है, विदेशी कुंजी डेटा को डिक्रिप्ट करती है"},{"en":"Primary key is for numbers, foreign key is for text","hi":"प्राथमिक कुंजी संख्याओं के लिए है, विदेशी कुंजी टेक्स्ट के लिए है"}],"exp":{"en":"A Primary Key enforces entity integrity by uniquely identifying each record in a table. A Foreign Key enforces referential integrity by linking a column to the primary key of another table.","hi":"प्राइमरी की (Primary Key) टेबल की हर पंक्ति (row) को विशिष्ट (unique) पहचान देती है (जैसे रोल नंबर)। फॉरेन की (Foreign Key) दो टेबल्स के बीच संबंध (link) बनाने के लिए दूसरे टेबल की प्राइमरी की का संदर्भ (reference) देती है।"},"num":69},{"id":"q70","q":{"en":"What is the full form and use of SQL?","hi":"SQL का पूर्ण रूप और उपयोग क्या है?"},"a":{"en":"Structured Query Language; used to query, insert, update, and delete relational data, and to manage database schema","hi":"स्ट्रक्चर्ड क्वेरी लैंग्वेज; रिलेशनल डेटा को क्वेरी (query), सम्मिलित (insert), अपडेट (update) और हटाने (delete) तथा डेटाबेस स्कीमा को प्रबंधित करने के लिए उपयोग किया जाता है"},"o":[{"en":"System Query Logic; formats hard drives","hi":"सिस्टम क्वेरी लॉजिक; हार्ड ड्राइव को फ़ॉर्मेट करता है"},{"en":"Standard Question Language; used for chatbots","hi":"स्टैंडर्ड क्वेश्चन लैंग्वेज; चैटबॉट के लिए उपयोग किया जाता है"},{"en":"Structured Query Language; used to query, insert, update, and delete relational data, and to manage database schema","hi":"स्ट्रक्चर्ड क्वेरी लैंग्वेज; रिलेशनल डेटा को क्वेरी (query), सम्मिलित (insert), अपडेट (update) और हटाने (delete) तथा डेटाबेस स्कीमा को प्रबंधित करने के लिए उपयोग किया जाता है"},{"en":"Sequential Quantity Locator; tracks inventory","hi":"अनुक्रमिक मात्रा लोकेटर; इन्वेंट्री को ट्रैक करता है"}],"exp":{"en":"SQL (Structured Query Language) is the standard language used to interact with relational databases (RDBMS) for data manipulation (DML) and data definition (DDL).","hi":"SQL (स्ट्रक्चर्ड क्वेरी लैंग्वेज) एक मानक भाषा है जिसका उपयोग रिलेशनल डेटाबेस (RDBMS) से जानकारी निकालने (query), नया डेटा डालने (insert), बदलने (update), हटाने (delete) और डेटाबेस का ढाँचा (schema) बनाने के लिए किया जाता है।"},"num":70},{"id":"q71","q":{"en":"Which of the following are examples of RDBMS?","hi":"निम्नलिखित में से कौन से RDBMS के उदाहरण हैं?"},"a":{"en":"MySQL, PostgreSQL, Oracle Database, Microsoft SQL Server, IBM Db2, and Microsoft Access","hi":"MySQL, PostgreSQL, Oracle Database, Microsoft SQL Server, IBM Db2 और Microsoft Access"},"o":[{"en":"HTML, CSS, and JavaScript","hi":"HTML, CSS और जावास्क्रिप्ट"},{"en":"Microsoft Word and Google Docs","hi":"माइक्रोसॉफ्ट वर्ड और गूगल डॉक्स"},{"en":"Windows, Linux, and macOS","hi":"विंडोज, लिनक्स और मैकओएस"},{"en":"MySQL, PostgreSQL, Oracle Database, Microsoft SQL Server, IBM Db2, and Microsoft Access","hi":"MySQL, PostgreSQL, Oracle Database, Microsoft SQL Server, IBM Db2 और Microsoft Access"}],"exp":{"en":"Prominent examples of Relational Database Management Systems include open-source options like MySQL and PostgreSQL, and commercial systems like Oracle, SQL Server, and Db2.","hi":"RDBMS के प्रमुख उदाहरणों में MySQL, PostgreSQL, Oracle Database, Microsoft SQL Server, IBM Db2 और Microsoft Access शामिल हैं।"},"num":71}]},{"title":{"en":"8. Exam Trap Reverse-Questions","hi":"8. परीक्षा के महत्वपूर्ण उल्टे प्रश्न"},"questions":[{"id":"q72","q":{"en":"If you see the rank 69, how would you identify whether it refers to PARAM Yuva or PARAM Yuva II?","hi":"यदि आप 69वीं रैंक देखते हैं, तो आप कैसे पहचानेंगे कि यह PARAM Yuva (परम युवा) को संदर्भित करता है या PARAM Yuva II को?"},"a":{"en":"Look at the date: November 2008 indicates PARAM Yuva. June 2013 indicates PARAM Yuva II (based on C-DAC certificates; TOP500 archive lists Yuva II at 70th)","hi":"तिथि देखें: नवंबर 2008 PARAM Yuva को इंगित करता है। जून 2013 PARAM Yuva II को इंगित करता है (C-DAC प्रमाणपत्रों के आधार पर; TOP500 आर्काइव में Yuva II 70वें स्थान पर है)"},"o":[{"en":"They are the exact same computer","hi":"वे बिल्कुल एक ही कंप्यूटर हैं"},{"en":"PARAM Yuva II never had a rank of 69","hi":"PARAM Yuva II की रैंक कभी 69 नहीं थी"},{"en":"Look at the date: November 2008 indicates PARAM Yuva. June 2013 indicates PARAM Yuva II (based on C-DAC certificates; TOP500 archive lists Yuva II at 70th)","hi":"तिथि देखें: नवंबर 2008 PARAM Yuva को इंगित करता है। जून 2013 PARAM Yuva II को इंगित करता है (C-DAC प्रमाणपत्रों के आधार पर; TOP500 आर्काइव में Yuva II 70वें स्थान पर है)"},{"en":"PARAM Yuva was ranked 69th, but Yuva II was unranked","hi":"PARAM Yuva 69वें स्थान पर था, लेकिन Yuva II बिना रैंक वाला था"}],"exp":{"en":"Both systems are famously associated with the number 69 in exams. Distinguish them by the year: 2008 for Yuva and 2013 for Yuva II (whose official archive rank is 70, but C-DAC marketed it as 69).","hi":"परीक्षा में दोनों कंप्यूटर रैंक 69 से जुड़े हो सकते हैं। यदि वर्ष 2008 हो, तो उत्तर PARAM Yuva होगा। यदि वर्ष 2013 हो, तो उत्तर PARAM Yuva II होगा (C-DAC के अनुसार 69, जबकि आधिकारिक आर्काइव में 70)।"},"num":72},{"id":"q73","q":{"en":"Rank 171 in June 2003, rank 4 in November 2007, and rank 63 in November 2020 are clues for which systems respectively?","hi":"जून 2003 में 171वीं रैंक, नवंबर 2007 में चौथी (4) रैंक और नवंबर 2020 में 63वीं रैंक, क्रमशः किन सिस्टम्स के सुराग (clues) हैं?"},"a":{"en":"PARAM Padma, EKA, and PARAM Siddhi-AI (In the TOP500 archive, Padma is 169th and Siddhi-AI is 62nd)","hi":"PARAM Padma, EKA और PARAM Siddhi-AI (TOP500 आर्काइव में, पद्मा 169वें और सिद्धि-AI 62वें स्थान पर है)"},"o":[{"en":"PARAM 8000, PARAM 10000, and PARAM Yuva","hi":"PARAM 8000, PARAM 10000 और PARAM Yuva"},{"en":"EKA, PARAM Padma, and PARAM Siddhi-AI","hi":"EKA, PARAM Padma और PARAM Siddhi-AI"},{"en":"PARAM Padma, EKA, and PARAM Siddhi-AI (In the TOP500 archive, Padma is 169th and Siddhi-AI is 62nd)","hi":"PARAM Padma, EKA और PARAM Siddhi-AI (TOP500 आर्काइव में, पद्मा 169वें और सिद्धि-AI 62वें स्थान पर है)"},{"en":"Pratyush, Mihir, and Ganga","hi":"प्रत्यूष, मिहिर और गंगा"}],"exp":{"en":"These are landmark Indian rankings. 2003 refers to PARAM Padma (first TOP500 entry), 2007 refers to Tata CRL's EKA (historic #4), and 2020 refers to PARAM Siddhi-AI.","hi":"ये भारत के प्रमुख ऐतिहासिक रैंक हैं: 2003 में PARAM Padma (पहला TOP500 प्रवेश), 2007 में टाटा का EKA (चौथी रैंक), और 2020 में PARAM Siddhi-AI (63वीं/62वीं रैंक)।"},"num":73},{"id":"q74","q":{"en":"Match the following capacities and institutes: '1.66 PFLOPS at IIT Roorkee' and '3.3 PFLOPS at IISc'.","hi":"निम्नलिखित क्षमताओं और संस्थानों का मिलान करें: 'IIT रुड़की में 1.66 PFLOPS' और 'IISc में 3.3 PFLOPS'।"},"a":{"en":"PARAM Ganga and PARAM Pravega respectively","hi":"क्रमशः PARAM Ganga और PARAM Pravega"},"o":[{"en":"PARAM Siddhi-AI and Mihir","hi":"PARAM Siddhi-AI और मिहिर"},{"en":"PARAM Pravega and PARAM Ganga","hi":"PARAM Pravega और PARAM Ganga"},{"en":"PARAM Yuva and PARAM Padma","hi":"PARAM Yuva और PARAM Padma"},{"en":"PARAM Ganga and PARAM Pravega respectively","hi":"क्रमशः PARAM Ganga और PARAM Pravega"}],"exp":{"en":"Under the NSM, the 1.66 PFLOPS system at IIT Roorkee is PARAM Ganga, and the 3.3 PFLOPS system at IISc Bengaluru is PARAM Pravega.","hi":"NSM के तहत, IIT रुड़की में 1.66 PFLOPS का सिस्टम PARAM Ganga है, और IISc बेंगलुरु में 3.3 PFLOPS का सिस्टम PARAM Pravega है।"},"num":74},{"id":"q75","q":{"en":"Which bioinformatics systems correspond to capacities of 5 TFLOPS and 10.65 TFLOPS?","hi":"5 TFLOPS और 10.65 TFLOPS की क्षमताओं वाले बायोइन्फॉर्मेटिक्स सिस्टम कौन से हैं?"},"a":{"en":"PARAM Biochrome (5 TFLOPS) and PARAM Bio Blaze (10.65 TFLOPS)","hi":"PARAM Biochrome (5 TFLOPS) और PARAM Bio Blaze (10.65 TFLOPS)"},"o":[{"en":"PARAM 8000 and PARAM 10000","hi":"PARAM 8000 and PARAM 10000"},{"en":"Pratyush and Mihir","hi":"Pratyush and Mihir"},{"en":"PARAM Biochrome (5 TFLOPS) and PARAM Bio Blaze (10.65 TFLOPS)","hi":"PARAM Biochrome (5 TFLOPS) और PARAM Bio Blaze (10.65 TFLOPS)"},{"en":"PARAM Yuva and PARAM Yuva II","hi":"PARAM Yuva and PARAM Yuva II"}],"exp":{"en":"PARAM Biochrome was a 5 TFLOPS bioinformatics cluster, while the later PARAM Bio Blaze (2014) upgraded this capability to 10.65 TFLOPS.","hi":"बायोइन्फॉर्मेटिक्स (Bioinformatics) के लिए, 5 TFLOPS क्षमता वाला सिस्टम PARAM Biochrome है, और 10.65 TFLOPS क्षमता वाला सिस्टम PARAM Bio Blaze है।"},"num":75},{"id":"q76","q":{"en":"How should you complete the single-founder shortcut \"Vinod Khosla founded Sun\"?","hi":"आप एकल-संस्थापक (single-founder) शॉर्टकट \"विनोद खोसला ने सन (Sun) की स्थापना की\" को कैसे पूरा करेंगे?"},"a":{"en":"Along with Vinod Khosla, the co-founders were Scott McNealy, Andy Bechtolsheim, and Bill Joy","hi":"विनोद खोसला के साथ-साथ सह-संस्थापक स्कॉट मैकनीली, एंडी बेक्टोल्सहेम और बिल जॉय थे"},"o":[{"en":"He was the sole founder","hi":"वह एकमात्र संस्थापक थे"},{"en":"Along with Vinod Khosla, the co-founders were Scott McNealy, Andy Bechtolsheim, and Bill Joy","hi":"विनोद खोसला के साथ-साथ सह-संस्थापक स्कॉट मैकनीली, एंडी बेक्टोल्सहेम और बिल जॉय थे"},{"en":"He founded it with Bill Gates","hi":"उन्होंने बिल गेट्स के साथ इसकी स्थापना की"},{"en":"He founded it with Steve Jobs","hi":"उन्होंने स्टीव जॉब्स के साथ इसकी स्थापना की"}],"exp":{"en":"While exam questions sometimes highlight Vinod Khosla, Sun Microsystems was a collaborative effort founded by Khosla, McNealy, Bechtolsheim, and Joy in 1982.","hi":"यद्यपि परीक्षा में अक्सर विनोद खोसला का नाम प्रमुखता से आता है, सन माइक्रोसिस्टम्स (Sun Microsystems) के सह-संस्थापकों में स्कॉट मैकनीली, एंडी बेक्टोल्सहेम और बिल जॉय भी शामिल थे।"},"num":76},{"id":"q77","q":{"en":"Identify the protocols from these clues: mail send, mailbox sync, and attachment encoding.","hi":"इन सुरागों (clues) से प्रोटोकॉल की पहचान करें: मेल सेंड (mail send), मेलबॉक्स सिंक (mailbox sync) और अटैचमेंट एन्कोडिंग।"},"a":{"en":"SMTP (send/relay), IMAP (sync), and MIME (attachment encoding and metadata)","hi":"SMTP (सेंड/रिले), IMAP (सिंक) और MIME (अटैचमेंट एन्कोडिंग और मेटाडेटा)"},"o":[{"en":"HTTP, FTP, and Telnet","hi":"HTTP, FTP, and Telnet"},{"en":"SMTP (send/relay), IMAP (sync), and MIME (attachment encoding and metadata)","hi":"SMTP (सेंड/रिले), IMAP (सिंक) और MIME (अटैचमेंट एन्कोडिंग और मेटाडेटा)"},{"en":"POP3, DHCP, and ARP","hi":"POP3, DHCP, and ARP"},{"en":"TCP, IP, and SNMP","hi":"TCP, IP, and SNMP"}],"exp":{"en":"Sending emails uses SMTP. Synchronizing a mailbox across devices uses IMAP. Encoding non-text attachments (like images or PDFs) uses MIME standards.","hi":"ईमेल भेजने/रिले करने के लिए SMTP का उपयोग होता है। सर्वर के साथ मेलबॉक्स को सिंक करने के लिए IMAP का उपयोग होता है। ईमेल में अटैचमेंट भेजने के लिए MIME का उपयोग होता है।"},"num":77},{"id":"q78","q":{"en":"What are the acronyms for dynamic IP assignment, private-to-public IP translation, and local IPv4-to-MAC resolution?","hi":"डायनेमिक IP असाइनमेंट, प्राइवेट-टू-पब्लिक IP ट्रांसलेशन और लोकल IPv4-टू-MAC रेजोल्यूशन के संक्षिप्त नाम (acronyms) क्या हैं?"},"a":{"en":"DHCP, NAT, and ARP respectively","hi":"क्रमशः DHCP, NAT और ARP"},"o":[{"en":"TCP, UDP, and IP","hi":"TCP, UDP, and IP"},{"en":"DHCP, NAT, and ARP respectively","hi":"क्रमशः DHCP, NAT और ARP"},{"en":"HTTP, FTP, and SMTP","hi":"HTTP, FTP, and SMTP"},{"en":"DNS, SSL, and TLS","hi":"DNS, SSL, and TLS"}],"exp":{"en":"DHCP assigns IP addresses automatically. NAT translates private network IPs to a single public IP. ARP resolves an IP address to a physical MAC address on a local network.","hi":"डिवाइस को स्वचालित IP देने के लिए DHCP, प्राइवेट IP को पब्लिक IP में बदलने के लिए NAT (राउटर में), और IP एड्रेस से लोकल MAC एड्रेस ढूँढने के लिए ARP का उपयोग किया जाता है।"},"num":78},{"id":"q79","q":{"en":"What is the distinction between SQL and RDBMS?","hi":"SQL और RDBMS के बीच क्या अंतर (distinction) है?"},"a":{"en":"SQL is the language used to query and manage relational data, while RDBMS is the software system (like MySQL or Oracle) that manages the relational database","hi":"SQL रिलेशनल डेटा को क्वेरी और प्रबंधित करने के लिए उपयोग की जाने वाली भाषा है, जबकि RDBMS सॉफ्टवेयर सिस्टम (जैसे MySQL या Oracle) है जो रिलेशनल डेटाबेस का प्रबंधन करता है"},"o":[{"en":"SQL is hardware, RDBMS is software","hi":"SQL हार्डवेयर है, RDBMS सॉफ्टवेयर है"},{"en":"They are two names for the exact same thing","hi":"वे बिल्कुल एक ही चीज़ के दो नाम हैं"},{"en":"SQL is the language used to query and manage relational data, while RDBMS is the software system (like MySQL or Oracle) that manages the relational database","hi":"SQL रिलेशनल डेटा को क्वेरी और प्रबंधित करने के लिए उपयोग की जाने वाली भाषा है, जबकि RDBMS सॉफ्टवेयर सिस्टम (जैसे MySQL या Oracle) है जो रिलेशनल डेटाबेस का प्रबंधन करता है"},{"en":"SQL is for images, RDBMS is for text","hi":"SQL छवियों के लिए है, RDBMS टेक्स्ट के लिए है"}],"exp":{"en":"An RDBMS (Relational Database Management System) is the database software itself (e.g., PostgreSQL, SQL Server). SQL (Structured Query Language) is the language you use to communicate with that software.","hi":"RDBMS एक सॉफ्टवेयर प्रोग्राम (जैसे MySQL, Oracle) है जो डेटा को टेबल्स में मैनेज करता है। SQL वह भाषा (language) है जिसका उपयोग उस सॉफ्टवेयर से बात करने और डेटा निकालने/बदलने के लिए किया जाता है।"},"num":79}]},{"title":{"en":"9. Rapid-Fire Final Revision","hi":"9. त्वरित अंतिम पुनरावृत्ति"},"questions":[{"id":"q80","q":{"en":"Which was the first indigenous Indian giga-scale PARAM system?","hi":"पहला स्वदेशी भारतीय गीगा-स्केल (giga-scale) PARAM सिस्टम कौन सा था?"},"a":{"en":"PARAM 8000 / PARAM 8000","hi":"PARAM 8000 / PARAM 8000"},"o":[{"en":"PARAM 10000","hi":"PARAM 10000"},{"en":"PARAM Padma","hi":"PARAM Padma"},{"en":"PARAM 8000 / PARAM 8000","hi":"PARAM 8000 / PARAM 8000"},{"en":"PARAM Yuva","hi":"PARAM Yuva"}],"exp":{"en":"PARAM 8000 is recognized as India's first giga-scale supercomputer.","hi":"PARAM 8000 भारत का पहला गीगा-स्केल सुपरकंप्यूटर था।"},"num":80},{"id":"q81","q":{"en":"What is the launch-year association for PARAM 10000?","hi":"PARAM 10000 के लिए लॉन्च-वर्ष क्या है?"},"a":{"en":"1998 / 1998","hi":"1998 / 1998"},"o":[{"en":"1991","hi":"1991"},{"en":"2002","hi":"2002"},{"en":"1998 / 1998","hi":"1998 / 1998"},{"en":"2008","hi":"2008"}],"exp":{"en":"PARAM 10000 was launched by C-DAC in 1998.","hi":"PARAM 10000 को 1998 में लॉन्च किया गया था।"},"num":81},{"id":"q82","q":{"en":"What is the institute-city pair for Pratyush and Mihir?","hi":"प्रत्यूष (Pratyush) और मिहिर (Mihir) के लिए संस्थान-शहर (institute-city) की जोड़ी क्या है?"},"a":{"en":"IITM Pune and NCMRWF Noida","hi":"IITM पुणे और NCMRWF नोएडा"},"o":[{"en":"IISc Bengaluru and IIT Delhi","hi":"IISc Bengaluru and IIT Delhi"},{"en":"IITM Pune and NCMRWF Noida","hi":"IITM पुणे और NCMRWF नोएडा"},{"en":"C-DAC Pune and IIT Roorkee","hi":"C-DAC Pune and IIT Roorkee"},{"en":"TIFR Mumbai and ISI Kolkata","hi":"TIFR Mumbai and ISI Kolkata"}],"exp":{"en":"Pratyush is at IITM in Pune, and Mihir is at NCMRWF in Noida.","hi":"प्रत्यूष IITM पुणे में है, और मिहिर NCMRWF नोएडा में है।"},"num":82},{"id":"q83","q":{"en":"Who is credited with the 1990 Web development at CERN?","hi":"CERN में 1990 के वेब विकास (Web development) का श्रेय किसे दिया जाता है?"},"a":{"en":"Tim Berners-Lee","hi":"टिम बर्नर्स-ली"},"o":[{"en":"Alan Turing","hi":"Alan Turing"},{"en":"Bill Gates","hi":"Bill Gates"},{"en":"Tim Berners-Lee","hi":"टिम बर्नर्स-ली"},{"en":"Steve Jobs","hi":"Steve Jobs"}],"exp":{"en":"Tim Berners-Lee invented the World Wide Web and HTML while at CERN.","hi":"टिम बर्नर्स-ली ने CERN में HTML और वर्ल्ड वाइड वेब (WWW) का विकास किया था।"},"num":83},{"id":"q84","q":{"en":"What was the company and who were the founders associated with the Apple I?","hi":"Apple I से जुड़ी कंपनी और संस्थापक कौन थे?"},"a":{"en":"Apple. Steve Jobs, Steve Wozniak, and Ronald Wayne were the founders","hi":"एप्पल. स्टीव जॉब्स, स्टीव वोज्नियाक और रोनाल्ड वेन संस्थापक थे"},"o":[{"en":"Microsoft. Bill Gates and Paul Allen","hi":"माइक्रोसॉफ्ट. बिल गेट्स और पॉल एलन"},{"en":"Sun Microsystems. Vinod Khosla and Bill Joy","hi":"सन माइक्रोसिस्टम्स. विनोद खोसला और बिल जॉय"},{"en":"Apple. Steve Jobs, Steve Wozniak, and Ronald Wayne were the founders","hi":"एप्पल. स्टीव जॉब्स, स्टीव वोज्नियाक और रोनाल्ड वेन संस्थापक थे"},{"en":"IBM. Thomas Watson","hi":"आईबीएम. थॉमस वॉटसन"}],"exp":{"en":"The Apple I was the first product of the Apple Computer Company, founded by Jobs, Wozniak, and Wayne.","hi":"Apple I को Apple कंपनी ने बनाया था, जिसके संस्थापक स्टीव जॉब्स, स्टीव वोज्नियाक और रोनाल्ड वेन थे।"},"num":84},{"id":"q85","q":{"en":"In which year was the formal dedication of ENIAC?","hi":"ENIAC का औपचारिक समर्पण (formal dedication) किस वर्ष हुआ था?"},"a":{"en":"1946 / 1946","hi":"1946 / 1946"},"o":[{"en":"1936","hi":"1936"},{"en":"1946 / 1946","hi":"1946 / 1946"},{"en":"1950","hi":"1950"},{"en":"1964","hi":"1964"}],"exp":{"en":"While operational by late 1945, ENIAC was formally dedicated to the public in February 1946.","hi":"ENIAC फरवरी 1946 में औपचारिक रूप से समर्पित (dedicated) किया गया था।"},"num":85},{"id":"q86","q":{"en":"Which exam names are associated with the invention of Bluetooth and the computer mouse?","hi":"ब्लूटूथ और कंप्यूटर माउस के आविष्कार से कौन से नाम (exam names) जुड़े हैं?"},"a":{"en":"Jaap Haartsen and Douglas Engelbart","hi":"जाप हर्टसेन और डगलस एंगेलबार्ट"},"o":[{"en":"Charles Babbage and Ada Lovelace","hi":"Charles Babbage and Ada Lovelace"},{"en":"Jaap Haartsen and Douglas Engelbart","hi":"जाप हर्टसेन और डगलस एंगेलबार्ट"},{"en":"Bill Gates and Steve Jobs","hi":"Bill Gates and Steve Jobs"},{"en":"Alan Turing and Seymour Cray","hi":"Alan Turing and Seymour Cray"}],"exp":{"en":"Jaap Haartsen is credited with Bluetooth, while Douglas Engelbart is credited with the computer mouse.","hi":"ब्लूटूथ का आविष्कार जाप हर्टसेन ने किया, जबकि कंप्यूटर माउस का आविष्कार डगलस एंगेलबार्ट ने किया।"},"num":86},{"id":"q87","q":{"en":"What are the standard ASCII width and the EPROM erasure method?","hi":"स्टैंडर्ड ASCII की चौड़ाई (width) और EPROM को इरेज़ (erase) करने की विधि क्या है?"},"a":{"en":"7 bits and UV light","hi":"7 बिट्स और UV (पराबैंगनी) प्रकाश"},"o":[{"en":"8 bits and magnetic erasure","hi":"8 बिट्स और मैग्नेटिक इरेज़र"},{"en":"7 bits and UV light","hi":"7 बिट्स और UV (पराबैंगनी) प्रकाश"},{"en":"16 bits and electrical erasure","hi":"16 बिट्स और इलेक्ट्रिकल इरेज़र"},{"en":"4 bits and software format","hi":"4 बिट्स और सॉफ़्टवेयर फ़ॉर्मेट"}],"exp":{"en":"Standard ASCII uses 7 bits, and traditional EPROMs are erased using ultraviolet (UV) light.","hi":"स्टैंडर्ड ASCII 7 बिट का होता है और EPROM को मिटाने के लिए UV (पराबैंगनी) लाइट का इस्तेमाल होता है।"},"num":87},{"id":"q88","q":{"en":"What is the legacy protocol for remote text login?","hi":"रिमोट टेक्स्ट लॉगिन (remote text login) के लिए लिगेसी प्रोटोकॉल (legacy protocol) कौन सा है?"},"a":{"en":"Telnet","hi":"टेलनेट (Telnet)"},"o":[{"en":"HTTP","hi":"HTTP"},{"en":"FTP","hi":"FTP"},{"en":"Telnet","hi":"टेलनेट (Telnet)"},{"en":"SMTP","hi":"SMTP"}],"exp":{"en":"Telnet is the legacy application protocol used for interactive remote command-line login.","hi":"रिमोट कंप्यूटर पर टेक्स्ट-आधारित लॉगिन करने के लिए पुराने प्रोटोकॉल को टेलनेट (Telnet) कहा जाता है।"},"num":88},{"id":"q89","q":{"en":"Is TCP connection-oriented or connectionless?","hi":"क्या TCP कनेक्शन-ओरिएंटेड है या कनेक्शनलेस (connectionless)?"},"a":{"en":"Connection-oriented","hi":"कनेक्शन-ओरिएंटेड"},"o":[{"en":"Connectionless","hi":"कनेक्शनलेस"},{"en":"Connection-oriented","hi":"कनेक्शन-ओरिएंटेड"},{"en":"Neither","hi":"दोनों में से कोई नहीं"},{"en":"Both depending on the port","hi":"पोर्ट के आधार पर दोनों"}],"exp":{"en":"TCP is a connection-oriented protocol, establishing a reliable handshake before transferring data.","hi":"TCP एक कनेक्शन-ओरिएंटेड (Connection-oriented) प्रोटोकॉल है, जो डेटा भेजने से पहले एक विश्वसनीय कनेक्शन बनाता है।"},"num":89},{"id":"q90","q":{"en":"What do the terms 'tuple' and 'attribute' mean in an RDBMS?","hi":"RDBMS में 'ट्यूपल' (tuple) और 'एट्रीब्यूट' (attribute) शब्दों का क्या अर्थ है?"},"a":{"en":"Tuple = row. Attribute = column.","hi":"ट्यूपल = पंक्ति (row). एट्रीब्यूट = कॉलम (column)."},"o":[{"en":"Tuple = table. Attribute = database.","hi":"ट्यूपल = टेबल. एट्रीब्यूट = डेटाबेस."},{"en":"Tuple = row. Attribute = column.","hi":"ट्यूपल = पंक्ति (row). एट्रीब्यूट = कॉलम (column)."},{"en":"Tuple = column. Attribute = row.","hi":"ट्यूपल = कॉलम. एट्रीब्यूट = पंक्ति."},{"en":"Tuple = primary key. Attribute = foreign key.","hi":"ट्यूपल = प्राइमरी की. एट्रीब्यूट = फॉरेन की."}],"exp":{"en":"In relational database terminology, a tuple refers to a row (record) and an attribute refers to a column (field).","hi":"रिलेशनल डेटाबेस (RDBMS) में ट्यूपल (tuple) का मतलब पंक्ति (row/record) है, और एट्रीब्यूट (attribute) का मतलब कॉलम (column/field) है।"},"num":90}]}],"12. Computer Abbreviations & Technical Terms":[{"title":{"en":"1. Banking, Payments & Document Formats","hi":"1. बैंकिंग, भुगतान और दस्तावेज़ प्रारूप"},"questions":[{"id":"q1","q":{"en":"What is the full form of MICR?","hi":"MICR का पूर्ण रूप क्या है?"},"a":{"en":"Magnetic Ink Character Recognition; a technology used in banking to process cheques by reading characters printed with magnetic ink","hi":"मैग्नेटिक इंक कैरेक्टर रिकग्निशन; बैंकिंग में एक तकनीक जिसका उपयोग चुंबकीय स्याही से मुद्रित वर्णों (characters) को पढ़कर चेक प्रोसेस करने के लिए किया जाता है"},"o":[{"en":"Magnetic Ink Character Recognition; a technology used in banking to process cheques by reading characters printed with magnetic ink","hi":"मैग्नेटिक इंक कैरेक्टर रिकग्निशन; बैंकिंग में एक तकनीक जिसका उपयोग चुंबकीय स्याही से मुद्रित वर्णों (characters) को पढ़कर चेक प्रोसेस करने के लिए किया जाता है"},{"en":"Magnetic Information Code Reader; a barcode scanner","hi":"मैग्नेटिक इंफॉर्मेशन कोड रीडर; एक बारकोड स्कैनर"},{"en":"Main Internet Connection Router; a networking device","hi":"मेन इंटरनेट कनेक्शन राउटर; एक नेटवर्किंग डिवाइस"},{"en":"Mobile Integrated Circuit Relay; used in smartphones","hi":"मोबाइल इंटीग्रेटेड सर्किट रिले; स्मार्टफोन में उपयोग किया जाता है"}],"exp":{"en":"MICR (Magnetic Ink Character Recognition) is widely used by banks to facilitate the processing and routing of cheques.","hi":"MICR (मैग्नेटिक इंक कैरेक्टर रिकग्निशन) का उपयोग बैंकों द्वारा चेक को जल्दी और सुरक्षित रूप से प्रोसेस करने के लिए किया जाता है।"},"num":1},{"id":"q2","q":{"en":"Which part of a cheque does the MICR reader read?","hi":"MICR रीडर चेक के किस भाग को पढ़ता है?"},"a":{"en":"The printed MICR line at the bottom of the cheque, where the reader recognizes special characters via magnetic signals","hi":"चेक के नीचे मुद्रित (printed) MICR लाइन को, जहाँ रीडर चुंबकीय संकेतों के माध्यम से विशेष वर्णों को पहचानता है"},"o":[{"en":"The handwritten signature at the bottom right","hi":"नीचे दाईं ओर हस्तलिखित हस्ताक्षर"},{"en":"The printed MICR line at the bottom of the cheque, where the reader recognizes special characters via magnetic signals","hi":"चेक के नीचे मुद्रित (printed) MICR लाइन को, जहाँ रीडर चुंबकीय संकेतों के माध्यम से विशेष वर्णों को पहचानता है"},{"en":"The date printed at the top right","hi":"ऊपर दाईं ओर मुद्रित तारीख"},{"en":"The bank's logo at the top left","hi":"ऊपर बाईं ओर बैंक का लोगो"}],"exp":{"en":"The MICR reader scans the magnetic ink printed at the bottom of the cheque, which contains routing, account, and cheque numbers.","hi":"MICR रीडर चेक के निचले हिस्से में छपी MICR लाइन को पढ़ता है। इन नंबरों में विशेष चुंबकीय स्याही (magnetic ink) होती है जिसे मशीन आसानी से पहचान लेती है।"},"num":2},{"id":"q3","q":{"en":"What is the structure of the 9-digit MICR code on an Indian cheque?","hi":"भारतीय चेक पर 9-अंकीय MICR कोड की संरचना (structure) क्या होती है?"},"a":{"en":"The first 3 digits represent the city (or clearing centre), the next 3 represent the bank, and the last 3 represent the branch","hi":"पहले 3 अंक शहर (या क्लियरिंग सेंटर) का प्रतिनिधित्व करते हैं, अगले 3 बैंक का प्रतिनिधित्व करते हैं, और अंतिम 3 शाखा का प्रतिनिधित्व करते हैं"},"o":[{"en":"The first 3 digits represent the city (or clearing centre), the next 3 represent the bank, and the last 3 represent the branch","hi":"पहले 3 अंक शहर (या क्लियरिंग सेंटर) का प्रतिनिधित्व करते हैं, अगले 3 बैंक का प्रतिनिधित्व करते हैं, और अंतिम 3 शाखा का प्रतिनिधित्व करते हैं"},{"en":"The first 4 digits represent the state, and the last 5 represent the account","hi":"पहले 4 अंक राज्य का प्रतिनिधित्व करते हैं, और अंतिम 5 खाते का प्रतिनिधित्व करते हैं"},{"en":"It is a randomly generated security PIN","hi":"यह बेतरतीब ढंग से उत्पन्न सुरक्षा पिन है"},{"en":"All 9 digits represent the bank's IFSC code","hi":"सभी 9 अंक बैंक के IFSC कोड का प्रतिनिधित्व करते हैं"}],"exp":{"en":"In India, the 9-digit MICR code is grouped as City-Bank-Branch (e.g., 123 represents the city, 456 represents the bank, and 789 represents the specific branch).","hi":"भारतीय चेक पर 9 अंकों का MICR कोड 3-3-3 के पैटर्न में होता है: पहले तीन अंक शहर (City), बीच के तीन अंक बैंक (Bank), और आखिरी तीन अंक शाखा (Branch) बताते हैं।"},"num":3},{"id":"q4","q":{"en":"What is the relationship between the MICR line and the 9-digit MICR code?","hi":"MICR लाइन और 9-अंकीय MICR कोड के बीच क्या संबंध है?"},"a":{"en":"The 9-digit code is just one field within the bottom MICR line, which may also contain the cheque number and other format-specific fields","hi":"9-अंकीय कोड नीचे की MICR लाइन के भीतर सिर्फ एक फ़ील्ड है, जिसमें चेक नंबर और अन्य प्रारूप-विशिष्ट फ़ील्ड (format-specific fields) भी हो सकते हैं"},"o":[{"en":"They are completely unrelated","hi":"वे पूरी तरह से असंबंधित हैं"},{"en":"The 9-digit code is just one field within the bottom MICR line, which may also contain the cheque number and other format-specific fields","hi":"9-अंकीय कोड नीचे की MICR लाइन के भीतर सिर्फ एक फ़ील्ड है, जिसमें चेक नंबर और अन्य प्रारूप-विशिष्ट फ़ील्ड (format-specific fields) भी हो सकते हैं"},{"en":"The MICR code is printed on the back, while the MICR line is on the front","hi":"MICR कोड पीछे छपा होता है, जबकि MICR लाइन सामने होती है"},{"en":"The MICR line is a barcode, and the code is a password","hi":"MICR लाइन एक बारकोड है, और कोड एक पासवर्ड है"}],"exp":{"en":"The MICR line refers to the entire row of magnetic characters at the bottom of the cheque, which includes the cheque number, the 9-digit MICR routing code, and sometimes account identifiers.","hi":"MICR लाइन चेक के नीचे छपी पूरी पंक्ति होती है। 9-अंकों का MICR कोड उस लाइन का सिर्फ एक हिस्सा (field) होता है, लाइन में चेक नंबर भी शामिल होता है।"},"num":4},{"id":"q5","q":{"en":"What is the full form of BHIM and which organization developed it?","hi":"BHIM का पूर्ण रूप क्या है और इसे किस संगठन ने विकसित किया?"},"a":{"en":"Bharat Interface for Money; a UPI-based digital payment app developed by NPCI (National Payments Corporation of India)","hi":"भारत इंटरफ़ेस फॉर मनी; NPCI (नेशनल पेमेंट्स कॉरपोरेशन ऑफ इंडिया) द्वारा विकसित एक UPI-आधारित डिजिटल भुगतान ऐप"},"o":[{"en":"Bharat Housing Information Management; built by RBI","hi":"भारत हाउसिंग इंफॉर्मेशन मैनेजमेंट; RBI द्वारा निर्मित"},{"en":"Bank Hardware Interface Module; built by SBI","hi":"बैंक हार्डवेयर इंटरफ़ेस मॉड्यूल; SBI द्वारा निर्मित"},{"en":"Bharat Interface for Money; a UPI-based digital payment app developed by NPCI (National Payments Corporation of India)","hi":"भारत इंटरफ़ेस फॉर मनी; NPCI (नेशनल पेमेंट्स कॉरपोरेशन ऑफ इंडिया) द्वारा विकसित एक UPI-आधारित डिजिटल भुगतान ऐप"},{"en":"Basic High-speed Internet Modem; built by BSNL","hi":"बेसिक हाई-स्पीड इंटरनेट मॉडेम; BSNL द्वारा निर्मित"}],"exp":{"en":"BHIM stands for Bharat Interface for Money, developed by the National Payments Corporation of India (NPCI) to facilitate fast, secure, reliable cashless payments through mobile phones.","hi":"BHIM (भारत इंटरफ़ेस फॉर मनी) भारत सरकार की NPCI द्वारा बनाया गया एक डिजिटल पेमेंट ऐप है जो सुरक्षित और तेज़ कैशलेस लेनदेन की सुविधा देता है।"},"num":5},{"id":"q6","q":{"en":"What is the relationship between BHIM and UPI?","hi":"BHIM और UPI के बीच क्या संबंध है?"},"a":{"en":"BHIM is a payment app; Unified Payments Interface (UPI) is the underlying payment system through which the app initiates bank-to-bank transactions","hi":"BHIM एक भुगतान ऐप है; यूनिफाइड पेमेंट्स इंटरफ़ेस (UPI) वह अंतर्निहित भुगतान प्रणाली (underlying payment system) है जिसके माध्यम से ऐप बैंक-टू-बैंक लेनदेन शुरू करता है"},"o":[{"en":"BHIM is an international bank, UPI is its ATM card","hi":"BHIM एक अंतरराष्ट्रीय बैंक है, UPI उसका ATM कार्ड है"},{"en":"BHIM is a payment app; Unified Payments Interface (UPI) is the underlying payment system through which the app initiates bank-to-bank transactions","hi":"BHIM एक भुगतान ऐप है; यूनिफाइड पेमेंट्स इंटरफ़ेस (UPI) वह अंतर्निहित भुगतान प्रणाली (underlying payment system) है जिसके माध्यम से ऐप बैंक-टू-बैंक लेनदेन शुरू करता है"},{"en":"They are two completely separate digital currencies","hi":"वे दो पूरी तरह से अलग डिजिटल मुद्राएं हैं"},{"en":"UPI is an app, and BHIM is a type of router","hi":"UPI एक ऐप है, और BHIM एक प्रकार का राउटर है"}],"exp":{"en":"UPI is the technology/platform that enables real-time inter-bank transactions, while BHIM is a specific mobile application that uses the UPI platform to provide this service to users.","hi":"UPI वह सिस्टम/तकनीक है जो सीधे बैंक खाते से पेमेंट संभव बनाता है, और BHIM वह ऐप है जो ग्राहकों को इस UPI सिस्टम का उपयोग करने की सुविधा देता है।"},"num":6},{"id":"q7","q":{"en":"What is the full form of PDF?","hi":"PDF का पूर्ण रूप क्या है?"},"a":{"en":"Portable Document Format; used to display document layouts consistently across different devices and platforms","hi":"पोर्टेबल डॉक्यूमेंट फॉर्मेट; इसका उपयोग विभिन्न डिवाइसों और प्लेटफार्मों पर दस्तावेज़ लेआउट को समान रूप से (consistently) प्रदर्शित करने के लिए किया जाता है"},"o":[{"en":"Portable Document Format; used to display document layouts consistently across different devices and platforms","hi":"पोर्टेबल डॉक्यूमेंट फॉर्मेट; इसका उपयोग विभिन्न डिवाइसों और प्लेटफार्मों पर दस्तावेज़ लेआउट को समान रूप से (consistently) प्रदर्शित करने के लिए किया जाता है"},{"en":"Personal Data Folder; a secure folder on Windows","hi":"पर्सनल डेटा फोल्डर; विंडोज पर एक सुरक्षित फोल्डर"},{"en":"Primary Disk Format; used when formatting a hard drive","hi":"प्राइमरी डिस्क फॉर्मेट; हार्ड ड्राइव को फॉर्मेट करते समय उपयोग किया जाता है"},{"en":"Public Domain File; a file that anyone can edit","hi":"पब्लिक डोमेन फाइल; एक फाइल जिसे कोई भी संपादित (edit) कर सकता है"}],"exp":{"en":"PDF (Portable Document Format) reliably presents and exchanges documents independent of software, hardware, or operating systems.","hi":"PDF का पूर्ण रूप पोर्टेबल डॉक्यूमेंट फॉर्मेट है। यह सुनिश्चित करता है कि दस्तावेज़ का डिज़ाइन, फॉन्ट और लेआउट हर कंप्यूटर या फोन पर एक जैसा ही दिखे।"},"num":7},{"id":"q8","q":{"en":"Which company developed PDF and what was Charles Geschke's role?","hi":"किस कंपनी ने PDF विकसित किया और चार्ल्स गेश्के (Charles Geschke) की क्या भूमिका थी?"},"a":{"en":"Adobe developed PDF; Charles Geschke and John Warnock were the co-founders of Adobe (Warnock's 'Camelot' project laid the foundation for PDF)","hi":"Adobe ने PDF विकसित किया; चार्ल्स गेश्के और जॉन वार्नॉक Adobe के सह-संस्थापक (co-founders) थे (वार्नॉक के 'कैमलोट' प्रोजेक्ट ने PDF की नींव रखी)"},"o":[{"en":"Microsoft developed it; Charles Geschke was the lead programmer","hi":"Microsoft ने इसे विकसित किया; चार्ल्स गेश्के प्रमुख प्रोग्रामर थे"},{"en":"Adobe developed PDF; Charles Geschke and John Warnock were the co-founders of Adobe (Warnock's 'Camelot' project laid the foundation for PDF)","hi":"Adobe ने PDF विकसित किया; चार्ल्स गेश्के और जॉन वार्नॉक Adobe के सह-संस्थापक (co-founders) थे (वार्नॉक के 'कैमलोट' प्रोजेक्ट ने PDF की नींव रखी)"},{"en":"Google developed it; Geschke was the CEO","hi":"Google ने इसे विकसित किया; गेश्के CEO थे"},{"en":"IBM developed it; Geschke invented the scanner","hi":"IBM ने इसे विकसित किया; गेश्के ने स्कैनर का आविष्कार किया"}],"exp":{"en":"Adobe created the PDF. Charles Geschke and John Warnock founded Adobe, and Warnock's internal 'Camelot' project envisioned the universal document format that became PDF.","hi":"PDF को Adobe कंपनी ने बनाया था। चार्ल्स गेश्के और जॉन वार्नॉक Adobe के को-फाउंडर (सह-संस्थापक) थे, और वार्नॉक के विजन से ही PDF का जन्म हुआ था।"},"num":8}]},{"title":{"en":"2. Networks, Broadband & Access Technologies","hi":"2. नेटवर्क, ब्रॉडबैंड और एक्सेस तकनीकें"},"questions":[{"id":"q9","q":{"en":"What is the full form and coverage area of a LAN?","hi":"LAN का पूर्ण रूप (full form) और कवरेज क्षेत्र क्या है?"},"a":{"en":"Local Area Network; connects devices in a limited area such as a home, lab, office, or campus","hi":"लोकल एरिया नेटवर्क; सीमित क्षेत्र (जैसे घर, लैब, कार्यालय या परिसर/campus) में उपकरणों को जोड़ता है"},"o":[{"en":"Large Area Node; covers an entire country","hi":"लार्ज एरिया नोड; पूरे देश को कवर करता है"},{"en":"Local Access Network; covers a single street","hi":"लोकल एक्सेस नेटवर्क; एक ही सड़क को कवर करता है"},{"en":"Local Area Network; connects devices in a limited area such as a home, lab, office, or campus","hi":"लोकल एरिया नेटवर्क; सीमित क्षेत्र (जैसे घर, लैब, कार्यालय या परिसर/campus) में उपकरणों को जोड़ता है"},{"en":"Logical Array Node; covers a server rack","hi":"लॉजिकल ऐरे नोड; सर्वर रैक को कवर करता है"}],"exp":{"en":"LAN (Local Area Network) is a network that connects computers within a limited physical area. Ethernet and Wi-Fi are common LAN technologies.","hi":"LAN का पूर्ण रूप 'लोकल एरिया नेटवर्क' है। यह घर, स्कूल, या ऑफिस जैसी छोटी जगह में कंप्यूटर और डिवाइस को आपस में जोड़ता है।"},"num":9},{"id":"q10","q":{"en":"What is the full form and use of ISDN?","hi":"ISDN का पूर्ण रूप और उपयोग क्या है?"},"a":{"en":"Integrated Services Digital Network; a set of standards for carrying digital voice, data, and signaling services over the traditional telephone network","hi":"इंटीग्रेटेड सर्विसेज डिजिटल नेटवर्क; पारंपरिक टेलीफोन नेटवर्क पर डिजिटल वॉयस, डेटा और सिग्नलिंग सेवाओं को ले जाने (carry) के मानकों (standards) का एक सेट"},"o":[{"en":"Internal Server Digital Node; used for cloud storage","hi":"इंटरनल सर्वर डिजिटल नोड; क्लाउड स्टोरेज के लिए उपयोग किया जाता है"},{"en":"Integrated Services Digital Network; a set of standards for carrying digital voice, data, and signaling services over the traditional telephone network","hi":"इंटीग्रेटेड सर्विसेज डिजिटल नेटवर्क; पारंपरिक टेलीफोन नेटवर्क पर डिजिटल वॉयस, डेटा और सिग्नलिंग सेवाओं को ले जाने (carry) के मानकों (standards) का एक सेट"},{"en":"Internet Security and Domain Network; a firewall system","hi":"इंटरनेट सिक्योरिटी एंड डोमेन नेटवर्क; एक फ़ायरवॉल सिस्टम"},{"en":"Inter-State Digital Node; a router protocol","hi":"इंटर-स्टेट डिजिटल नोड; एक राउटर प्रोटोकॉल"}],"exp":{"en":"ISDN (Integrated Services Digital Network) enables the simultaneous digital transmission of voice, video, data, and other network services over traditional PSTN circuits.","hi":"ISDN (इंटीग्रेटेड सर्विसेज डिजिटल नेटवर्क) एक पुरानी संचार तकनीक है जो साधारण टेलीफोन लाइनों पर आवाज़ (voice), वीडियो और डेटा को डिजिटल रूप में भेजने की सुविधा देती है।"},"num":10},{"id":"q11","q":{"en":"What is the full form of PSTN?","hi":"PSTN का पूर्ण रूप क्या है?"},"a":{"en":"Public Switched Telephone Network (the traditional public telephone network)","hi":"पब्लिक स्विच्ड टेलीफोन नेटवर्क (पारंपरिक सार्वजनिक टेलीफोन नेटवर्क)"},"o":[{"en":"Primary System Transmission Network","hi":"प्राइमरी सिस्टम ट्रांसमिशन नेटवर्क"},{"en":"Public Secure Transmission Node","hi":"पब्लिक सिक्योर ट्रांसमिशन नोड"},{"en":"Private Server Technical Node","hi":"प्राइवेट सर्वर टेक्निकल नोड"},{"en":"Public Switched Telephone Network (the traditional public telephone network)","hi":"पब्लिक स्विच्ड टेलीफोन नेटवर्क (पारंपरिक सार्वजनिक टेलीफोन नेटवर्क)"}],"exp":{"en":"PSTN stands for Public Switched Telephone Network, which is the world's traditional interconnected voice-oriented public telephone network.","hi":"PSTN का पूर्ण रूप पब्लिक स्विच्ड टेलीफोन नेटवर्क है। यह दुनिया का पारंपरिक टेलीफोन सिस्टम है जो तारों और स्विच के माध्यम से कॉल्स को जोड़ता है।"},"num":11},{"id":"q12","q":{"en":"What is the full form and main role of an ISP?","hi":"ISP का पूर्ण रूप और मुख्य भूमिका क्या है?"},"a":{"en":"Internet Service Provider; provides internet connection to individuals and businesses (e.g., BSNL, Jio, Airtel)","hi":"इंटरनेट सर्विस प्रोवाइडर; व्यक्तियों और व्यवसायों को इंटरनेट कनेक्शन प्रदान करता है (जैसे, BSNL, Jio, Airtel)"},"o":[{"en":"Internal Server Protocol; routes data","hi":"इंटरनल सर्वर प्रोटोकॉल; डेटा रूट करता है"},{"en":"Internet Security Program; blocks viruses","hi":"इंटरनेट सिक्योरिटी प्रोग्राम; वायरस ब्लॉक करता है"},{"en":"Internet Service Provider; provides internet connection to individuals and businesses (e.g., BSNL, Jio, Airtel)","hi":"इंटरनेट सर्विस प्रोवाइडर; व्यक्तियों और व्यवसायों को इंटरनेट कनेक्शन प्रदान करता है (जैसे, BSNL, Jio, Airtel)"},{"en":"International Standard Port; connects cables","hi":"इंटरनेशनल स्टैंडर्ड पोर्ट; केबल कनेक्ट करता है"}],"exp":{"en":"An ISP (Internet Service Provider) is a company that provides access to the Internet and other related services to customers.","hi":"ISP (इंटरनेट सर्विस प्रोवाइडर) वह कंपनी होती है जो लोगों और कंपनियों को इंटरनेट की सुविधा (कनेक्शन) देती है, जैसे BSNL, Jio या Airtel।"},"num":12},{"id":"q13","q":{"en":"Besides internet access, what other services can an ISP offer?","hi":"इंटरनेट एक्सेस (internet access) के अलावा, ISP और कौन सी सेवाएँ (services) दे सकता है?"},"a":{"en":"Related services like email, web hosting, and domain registration, depending on the plan or provider","hi":"प्लान या प्रदाता (provider) के आधार पर संबंधित सेवाएँ जैसे ईमेल, वेब होस्टिंग और डोमेन पंजीकरण"},"o":[{"en":"Selling computer hardware","hi":"कंप्यूटर हार्डवेयर बेचना"},{"en":"Related services like email, web hosting, and domain registration, depending on the plan or provider","hi":"प्लान या प्रदाता (provider) के आधार पर संबंधित सेवाएँ जैसे ईमेल, वेब होस्टिंग और डोमेन पंजीकरण"},{"en":"Developing mobile operating systems","hi":"मोबाइल ऑपरेटिंग सिस्टम विकसित करना"},{"en":"Generating electricity","hi":"बिजली पैदा करना"}],"exp":{"en":"In addition to providing connectivity, many ISPs also offer value-added services such as email accounts, web hosting, domain name registration, and sometimes cloud storage.","hi":"इंटरनेट देने के अलावा, कई ISP (प्लान के अनुसार) ग्राहकों को अपनी ईमेल सेवा, वेबसाइट होस्ट करने की जगह और डोमेन नाम (domain registration) जैसी सुविधाएँ भी देते हैं।"},"num":13},{"id":"q14","q":{"en":"What is the full form and underlying technology of FDDI?","hi":"FDDI का पूर्ण रूप और अंतर्निहित तकनीक (technology) क्या है?"},"a":{"en":"Fiber Distributed Data Interface; a legacy 100 Mbps token-passing LAN technology commonly associated with fibre optics and a dual-ring topology","hi":"फाइबर डिस्ट्रीब्यूटेड डेटा इंटरफ़ेस; एक पुरानी 100 Mbps टोकन-पासिंग LAN तकनीक जो आमतौर पर फाइबर ऑप्टिक्स और डुअल-रिंग टोपोलॉजी से जुड़ी होती है"},"o":[{"en":"Fast Data Digital Interface; uses copper wires","hi":"फास्ट डेटा डिजिटल इंटरफ़ेस; तांबे के तारों का उपयोग करता है"},{"en":"Fiber Distributed Data Interface; a legacy 100 Mbps token-passing LAN technology commonly associated with fibre optics and a dual-ring topology","hi":"फाइबर डिस्ट्रीब्यूटेड डेटा इंटरफ़ेस; एक पुरानी 100 Mbps टोकन-पासिंग LAN तकनीक जो आमतौर पर फाइबर ऑप्टिक्स और डुअल-रिंग टोपोलॉजी से जुड़ी होती है"},{"en":"Frequency Division Data Internet; uses satellite","hi":"फ्रीक्वेंसी डिवीजन डेटा इंटरनेट; सैटेलाइट का उपयोग करता है"},{"en":"File Download Direct Interface; uses USB","hi":"फाइल डाउनलोड डायरेक्ट इंटरफ़ेस; USB का उपयोग करता है"}],"exp":{"en":"FDDI (Fiber Distributed Data Interface) is a standard for data transmission in a local area network that uses optical fiber lines, employing a dual-ring token-passing architecture.","hi":"FDDI (फाइबर डिस्ट्रीब्यूटेड डेटा इंटरफ़ेस) एक पुरानी LAN तकनीक है। यह फाइबर ऑप्टिक केबल और डुअल-रिंग (दो रिंग) टोपोलॉजी का उपयोग करके 100 Mbps की गति से डेटा भेजती थी।"},"num":14},{"id":"q15","q":{"en":"What is the full form of CDMA and what is its working principle?","hi":"CDMA का पूर्ण रूप क्या है और इसका कार्य सिद्धांत (working principle) क्या है?"},"a":{"en":"Code Division Multiple Access; multiple users can transmit on the same frequency band at the same time by using different codes (associated with spread-spectrum techniques)","hi":"कोड डिवीजन मल्टीपल एक्सेस; कई उपयोगकर्ता अलग-अलग कोड का उपयोग करके एक ही समय में एक ही फ़्रीक्वेंसी बैंड पर ट्रांसमिट कर सकते हैं (स्प्रेड-स्पेक्ट्रम तकनीकों से जुड़ा हुआ)"},"o":[{"en":"Code Division Multiple Access; multiple users can transmit on the same frequency band at the same time by using different codes (associated with spread-spectrum techniques)","hi":"कोड डिवीजन मल्टीपल एक्सेस; कई उपयोगकर्ता अलग-अलग कोड का उपयोग करके एक ही समय में एक ही फ़्रीक्वेंसी बैंड पर ट्रांसमिट कर सकते हैं (स्प्रेड-स्पेक्ट्रम तकनीकों से जुड़ा हुआ)"},{"en":"Computer Digital Mainframe Architecture; servers divide tasks","hi":"कंप्यूटर डिजिटल मेनफ्रेम आर्किटेक्चर; सर्वर कार्यों को विभाजित करते हैं"},{"en":"Channel Data Mobile Access; only one user can speak at a time","hi":"चैनल डेटा मोबाइल एक्सेस; एक बार में केवल एक उपयोगकर्ता बोल सकता है"},{"en":"Core Division Memory Allocation; divides RAM","hi":"कोर डिवीजन मेमोरी एलोकेशन; RAM को विभाजित करता है"}],"exp":{"en":"CDMA (Code Division Multiple Access) is a digital cellular technology that allows multiple users to share the same radio frequency band simultaneously by assigning unique codes to each communication.","hi":"CDMA (कोड डिवीजन मल्टीपल एक्सेस) एक मोबाइल संचार तकनीक है। इसमें कई लोग एक ही फ़्रीक्वेंसी और समय पर बात कर सकते हैं, क्योंकि हर कॉल को एक अलग कोड (spread-spectrum तकनीक) दिया जाता है।"},"num":15},{"id":"q16","q":{"en":"Does the spreading code in CDMA act as encryption?","hi":"क्या CDMA में स्प्रेडिंग कोड (spreading code) एन्क्रिप्शन का काम करता है?"},"a":{"en":"No, spreading codes only separate the signals of different users. Separate cryptographic protection is needed for confidentiality.","hi":"नहीं, स्प्रेडिंग कोड केवल विभिन्न उपयोगकर्ताओं के सिग्नल को अलग करते हैं। गोपनीयता (confidentiality) के लिए अलग क्रिप्टोग्राफ़िक सुरक्षा की आवश्यकता होती है।"},"o":[{"en":"Yes, it completely encrypts the data","hi":"हाँ, यह डेटा को पूरी तरह से एन्क्रिप्ट करता है"},{"en":"No, spreading codes only separate the signals of different users. Separate cryptographic protection is needed for confidentiality.","hi":"नहीं, स्प्रेडिंग कोड केवल विभिन्न उपयोगकर्ताओं के सिग्नल को अलग करते हैं। गोपनीयता (confidentiality) के लिए अलग क्रिप्टोग्राफ़िक सुरक्षा की आवश्यकता होती है।"},{"en":"Yes, it acts as a firewall","hi":"हाँ, यह फ़ायरवॉल के रूप में कार्य करता है"},{"en":"Yes, it converts voice to text","hi":"हाँ, यह आवाज़ को टेक्स्ट में बदलता है"}],"exp":{"en":"The unique spreading codes in CDMA are used for channel multiplexing (separating user signals), not for security. Actual data encryption requires additional cryptographic protocols.","hi":"नहीं, स्प्रेडिंग कोड का काम केवल अलग-अलग कॉल्स के सिग्नल को एक-दूसरे से अलग रखना है। कॉल की बातों को सुरक्षित (गोपनीय) रखने के लिए अलग से एन्क्रिप्शन (क्रिप्टोग्राफ़िक सुरक्षा) की ज़रूरत होती है।"},"num":16},{"id":"q17","q":{"en":"What is the full form of WiMAX and which IEEE standard is it based on?","hi":"WiMAX का पूर्ण रूप क्या है और यह किस IEEE मानक (standard) पर आधारित है?"},"a":{"en":"Worldwide Interoperability for Microwave Access; based on the IEEE 802.16 family of wireless broadband standards","hi":"वर्ल्डवाइड इंटरऑपरेबिलिटी फॉर माइक्रोवेव एक्सेस; वायरलेस ब्रॉडबैंड मानकों के IEEE 802.16 परिवार पर आधारित है"},"o":[{"en":"Wireless Maximum Access; IEEE 802.11","hi":"वायरलेस मैक्सिमम एक्सेस; IEEE 802.11"},{"en":"Worldwide Internet Modem Access; IEEE 802.3","hi":"वर्ल्डवाइड इंटरनेट मॉडेम एक्सेस; IEEE 802.3"},{"en":"Worldwide Interoperability for Microwave Access; based on the IEEE 802.16 family of wireless broadband standards","hi":"वर्ल्डवाइड इंटरऑपरेबिलिटी फॉर माइक्रोवेव एक्सेस; वायरलेस ब्रॉडबैंड मानकों के IEEE 802.16 परिवार पर आधारित है"},{"en":"Wide Macro Area Extension; IEEE 802.15","hi":"वाइड मैक्रो एरिया एक्सटेंशन; IEEE 802.15"}],"exp":{"en":"WiMAX (Worldwide Interoperability for Microwave Access) is a wireless broadband communication standard based on the IEEE 802.16 set of standards.","hi":"WiMAX (वर्ल्डवाइड इंटरऑपरेबिलिटी फॉर माइक्रोवेव एक्सेस) एक वायरलेस ब्रॉडबैंड तकनीक है। यह लंबी दूरी तक इंटरनेट पहुँचाने के लिए IEEE 802.16 मानक (standard) पर काम करती है।"},"num":17},{"id":"q18","q":{"en":"What is the full form of DSL and what transmission medium does it use?","hi":"DSL का पूर्ण रूप क्या है और यह किस ट्रांसमिशन माध्यम (medium) का उपयोग करता है?"},"a":{"en":"Digital Subscriber Line; a family of technologies that provides digital broadband over a traditional copper telephone pair","hi":"डिजिटल सब्सक्राइबर लाइन; तकनीकों का एक परिवार जो पारंपरिक तांबे के टेलीफोन तार (copper telephone pair) पर डिजिटल ब्रॉडबैंड प्रदान करता है"},"o":[{"en":"Direct Satellite Link; uses microwaves","hi":"डायरेक्ट सैटेलाइट लिंक; माइक्रोवेव का उपयोग करता है"},{"en":"Data Speed Layer; uses fiber optics","hi":"डेटा स्पीड लेयर; फाइबर ऑप्टिक्स का उपयोग करता है"},{"en":"Digital Subscriber Line; a family of technologies that provides digital broadband over a traditional copper telephone pair","hi":"डिजिटल सब्सक्राइबर लाइन; तकनीकों का एक परिवार जो पारंपरिक तांबे के टेलीफोन तार (copper telephone pair) पर डिजिटल ब्रॉडबैंड प्रदान करता है"},{"en":"Dual System Logic; uses coaxial cable","hi":"डुअल सिस्टम लॉजिक; समाक्षीय (coaxial) केबल का उपयोग करता है"}],"exp":{"en":"DSL (Digital Subscriber Line) is a technology used to transmit digital data over the conventional copper wire telephone lines originally installed for voice calls.","hi":"DSL (डिजिटल सब्सक्राइबर लाइन) एक ब्रॉडबैंड तकनीक है जो हमारे घरों में आने वाले पुराने तांबे के टेलीफोन तारों (copper telephone lines) के ज़रिए तेज़ इंटरनेट देती है।"},"num":18},{"id":"q19","q":{"en":"What is the practical difference between DSL and dial-up connections?","hi":"DSL और डायल-अप (dial-up) कनेक्शन के बीच व्यावहारिक अंतर क्या है?"},"a":{"en":"DSL provides an always-on broadband connection. In a suitable setup, voice calls and data can run simultaneously on the same copper line using different frequency bands.","hi":"DSL हमेशा चालू (always-on) रहने वाला ब्रॉडबैंड कनेक्शन प्रदान करता है। उपयुक्त सेटअप में, वॉयस कॉल और डेटा एक ही तांबे की लाइन पर अलग-अलग आवृत्ति बैंड (frequency bands) का उपयोग करके एक साथ चल सकते हैं।"},"o":[{"en":"Dial-up is faster than DSL","hi":"डायल-अप DSL से तेज़ है"},{"en":"DSL provides an always-on broadband connection. In a suitable setup, voice calls and data can run simultaneously on the same copper line using different frequency bands.","hi":"DSL हमेशा चालू (always-on) रहने वाला ब्रॉडबैंड कनेक्शन प्रदान करता है। उपयुक्त सेटअप में, वॉयस कॉल और डेटा एक ही तांबे की लाइन पर अलग-अलग आवृत्ति बैंड (frequency bands) का उपयोग करके एक साथ चल सकते हैं।"},{"en":"DSL requires a satellite dish, dial-up uses cables","hi":"DSL के लिए सैटेलाइट डिश की आवश्यकता होती है, डायल-अप केबल का उपयोग करता है"},{"en":"Dial-up is used for wireless networks","hi":"डायल-अप का उपयोग वायरलेस नेटवर्क के लिए किया जाता है"}],"exp":{"en":"Unlike dial-up, DSL is an 'always-on' connection. Because DSL uses higher frequencies for data, you can talk on the phone and use the internet at the same time on the same line.","hi":"डायल-अप में जब इंटरनेट चलता है तो फोन व्यस्त (busy) हो जाता है। लेकिन DSL में, डेटा और आवाज़ (voice) अलग-अलग फ्रीक्वेंसी पर चलते हैं, जिससे आप एक ही समय में फोन पर बात भी कर सकते हैं और इंटरनेट भी चला सकते हैं।"},"num":19},{"id":"q20","q":{"en":"What is the full form of FTTP and what is its main clue?","hi":"FTTP का पूर्ण रूप क्या है और इसका मुख्य सुराग (clue) क्या है?"},"a":{"en":"Fiber to the Premises; the access fibre reaches all the way to the end user's home or business premises","hi":"फाइबर टू द प्रिमाइसेज़ (Premises); एक्सेस फाइबर सीधे अंतिम उपयोगकर्ता (end user) के घर या व्यावसायिक परिसर तक पहुँचता है"},"o":[{"en":"File Transfer Test Protocol; used to test internet speed","hi":"फाइल ट्रांसफर टेस्ट प्रोटोकॉल; इंटरनेट की गति का परीक्षण करने के लिए उपयोग किया जाता है"},{"en":"Fiber to the Premises; the access fibre reaches all the way to the end user's home or business premises","hi":"फाइबर टू द प्रिमाइसेज़ (Premises); एक्सेस फाइबर सीधे अंतिम उपयोगकर्ता (end user) के घर या व्यावसायिक परिसर तक पहुँचता है"},{"en":"Fast Transmission Telephone Port; used for fast dialing","hi":"फास्ट ट्रांसमिशन टेलीफोन पोर्ट; फास्ट डायलिंग के लिए उपयोग किया जाता है"},{"en":"Frequency Tested Transmission Protocol; measures radio waves","hi":"फ्रीक्वेंसी टेस्टेड ट्रांसमिशन प्रोटोकॉल; रेडियो तरंगों को मापता है"}],"exp":{"en":"FTTP (Fiber to the Premises) is a form of fiber-optic communication delivery in which an optical fiber is run directly onto the customers' premises.","hi":"FTTP (फाइबर टू द प्रिमाइसेज़) का मतलब है कि तेज़ इंटरनेट देने वाली फाइबर ऑप्टिक केबल (तार) सीधे ग्राहक के घर या ऑफिस (premises) के अंदर तक बिछाई गई है।"},"num":20},{"id":"q21","q":{"en":"How do you distinguish between FTTP and FTP?","hi":"आप FTTP और FTP के बीच अंतर कैसे करेंगे?"},"a":{"en":"FTTP is a broadband access architecture (fibre optic setup). FTP is a file-transfer protocol used between a client and a server.","hi":"FTTP एक ब्रॉडबैंड एक्सेस आर्किटेक्चर (फाइबर ऑप्टिक सेटअप) है। FTP एक फ़ाइल-ट्रांसफर प्रोटोकॉल है जिसका उपयोग क्लाइंट और सर्वर के बीच किया जाता है।"},"o":[{"en":"They are exactly the same thing","hi":"वे बिल्कुल एक ही चीज़ हैं"},{"en":"FTTP is a broadband access architecture (fibre optic setup). FTP is a file-transfer protocol used between a client and a server.","hi":"FTTP एक ब्रॉडबैंड एक्सेस आर्किटेक्चर (फाइबर ऑप्टिक सेटअप) है। FTP एक फ़ाइल-ट्रांसफर प्रोटोकॉल है जिसका उपयोग क्लाइंट और सर्वर के बीच किया जाता है।"},{"en":"FTP is for homes, FTTP is for mobile phones","hi":"FTP घरों के लिए है, FTTP मोबाइल फोन के लिए है"},{"en":"FTTP is software, FTP is hardware","hi":"FTTP सॉफ्टवेयर है, FTP हार्डवेयर है"}],"exp":{"en":"FTTP refers to the physical fiber-optic infrastructure delivering broadband to a building. FTP is a software protocol used to transfer files over the internet.","hi":"FTTP (फाइबर टू द प्रिमाइसेज़) घर तक बिछने वाली फाइबर इंटरनेट लाइन का नाम है। जबकि FTP (फाइल ट्रांसफर प्रोटोकॉल) इंटरनेट पर फाइलें भेजने/डाउनलोड करने का एक नियम (प्रोटोकॉल) है।"},"num":21},{"id":"q22","q":{"en":"What is the full form of OSI and how many layers does it have?","hi":"OSI का पूर्ण रूप क्या है और इसमें कितनी लेयर्स (layers) होती हैं?"},"a":{"en":"Open Systems Interconnection; the reference model has 7 layers","hi":"ओपन सिस्टम्स इंटरकनेक्शन; इस संदर्भ मॉडल (reference model) में 7 लेयर्स होती हैं"},"o":[{"en":"Online System Interface; 5 layers","hi":"ऑनलाइन सिस्टम इंटरफ़ेस; 5 लेयर्स"},{"en":"Operating System Integration; 4 layers","hi":"ऑपरेटिंग सिस्टम इंटीग्रेशन; 4 लेयर्स"},{"en":"Open Systems Interconnection; the reference model has 7 layers","hi":"ओपन सिस्टम्स इंटरकनेक्शन; इस संदर्भ मॉडल (reference model) में 7 लेयर्स होती हैं"},{"en":"Optical Serial Input; 3 layers","hi":"ऑप्टिकल सीरियल इनपुट; 3 लेयर्स"}],"exp":{"en":"OSI stands for Open Systems Interconnection. It is a conceptual framework divided into 7 layers to standardize the functions of a telecommunication or computing system.","hi":"OSI (ओपन सिस्टम्स इंटरकनेक्शन) एक सैद्धांतिक मॉडल है जो बताता है कि नेटवर्क कैसे काम करता है। इसमें 7 लेयर्स (परतें) होती हैं (जैसे फिजिकल, डेटा लिंक, नेटवर्क आदि)।"},"num":22},{"id":"q23","q":{"en":"What are the full forms and roles of NIC and NIU?","hi":"NIC और NIU के पूर्ण रूप और भूमिकाएँ क्या हैं?"},"a":{"en":"NIC = Network Interface Card (or Controller). NIU = Network Interface Unit, which is a broader term for an interface providing a network connection (e.g., an adapter card).","hi":"NIC = नेटवर्क इंटरफ़ेस कार्ड (या कंट्रोलर)। NIU = नेटवर्क इंटरफ़ेस यूनिट, जो नेटवर्क कनेक्शन (जैसे, एडाप्टर कार्ड) प्रदान करने वाले इंटरफ़ेस के लिए एक व्यापक शब्द है।"},"o":[{"en":"NIC = Node Internal Core. NIU = Node Internal Unit. They process graphics.","hi":"NIC = नोड इंटरनल कोर। NIU = नोड इंटरनल यूनिट। वे ग्राफिक्स प्रोसेस करते हैं।"},{"en":"NIC = Network Interface Card (or Controller). NIU = Network Interface Unit, which is a broader term for an interface providing a network connection (e.g., an adapter card).","hi":"NIC = नेटवर्क इंटरफ़ेस कार्ड (या कंट्रोलर)। NIU = नेटवर्क इंटरफ़ेस यूनिट, जो नेटवर्क कनेक्शन (जैसे, एडाप्टर कार्ड) प्रदान करने वाले इंटरफ़ेस के लिए एक व्यापक शब्द है।"},{"en":"NIC = New Internet Cable. NIU = New Internet Utility. They are types of routers.","hi":"NIC = न्यू इंटरनेट केबल। NIU = न्यू इंटरनेट यूटिलिटी। ये राउटर के प्रकार हैं।"},{"en":"NIC = National Internet Code. NIU = National Internet URL. They are security passwords.","hi":"NIC = नेशनल इंटरनेट कोड। NIU = नेशनल इंटरनेट URL। वे सुरक्षा पासवर्ड हैं।"}],"exp":{"en":"NIC stands for Network Interface Card, a hardware component that connects a computer to a computer network. NIU (Network Interface Unit) is a more general term for such connecting devices.","hi":"NIC (नेटवर्क इंटरफ़ेस कार्ड) वह हार्डवेयर (कार्ड) है जो कंप्यूटर को नेटवर्क या इंटरनेट केबल से जोड़ता है। NIU (नेटवर्क इंटरफ़ेस यूनिट) भी इसी तरह के कनेक्शन देने वाले इंटरफ़ेस के लिए एक व्यापक नाम है।"},"num":23},{"id":"q24","q":{"en":"What is the connection between an Ethernet NIC and a 48-bit MAC address?","hi":"ईथरनेट NIC और 48-बिट MAC एड्रेस के बीच क्या संबंध है?"},"a":{"en":"An Ethernet NIC typically uses a 48-bit MAC address. This factory-assigned address identifies the hardware, though OS-configured or randomized MACs are also possible.","hi":"एक ईथरनेट NIC आमतौर पर 48-बिट MAC एड्रेस का उपयोग करता है। कारखाने (factory) द्वारा निर्दिष्ट यह पता हार्डवेयर की पहचान करता है, हालाँकि OS-कॉन्फ़िगर या यादृच्छिक (randomized) MAC भी संभव हैं।"},"o":[{"en":"They are unrelated","hi":"वे असंबंधित हैं"},{"en":"A MAC address is a 48-bit password for the NIC","hi":"MAC एड्रेस NIC के लिए 48-बिट पासवर्ड है"},{"en":"An Ethernet NIC typically uses a 48-bit MAC address. This factory-assigned address identifies the hardware, though OS-configured or randomized MACs are also possible.","hi":"एक ईथरनेट NIC आमतौर पर 48-बिट MAC एड्रेस का उपयोग करता है। कारखाने (factory) द्वारा निर्दिष्ट यह पता हार्डवेयर की पहचान करता है, हालाँकि OS-कॉन्फ़िगर या यादृच्छिक (randomized) MAC भी संभव हैं।"},{"en":"The MAC address measures the physical size of the NIC","hi":"MAC एड्रेस NIC के भौतिक आकार को मापता है"}],"exp":{"en":"An Ethernet Network Interface Card (NIC) is globally and uniquely identified by a 48-bit Media Access Control (MAC) address assigned during manufacturing (burned-in address).","hi":"हर ईथरनेट NIC (नेटवर्क कार्ड) की पहचान के लिए कंपनी उसे एक 48-बिट का MAC एड्रेस देती है, जिसे हार्डवेयर का पता (physical address) कहते हैं (हालाँकि सॉफ्टवेयर के ज़रिए इसे बदला या रैंडमाइज़ भी किया जा सकता है)।"},"num":24}]},{"title":{"en":"3. Internet Identifiers, Web & Protocols","hi":"3. इंटरनेट पहचानकर्ता, वेब और प्रोटोकॉल"},"questions":[{"id":"q25","q":{"en":"What is the full form of IANA and what are its responsibilities?","hi":"IANA का पूर्ण रूप क्या है और इसकी जिम्मेदारियां (responsibilities) क्या हैं?"},"a":{"en":"Internet Assigned Numbers Authority; coordinates the DNS root, global IP/AS number resources, and Internet protocol parameter registries","hi":"इंटरनेट असाइन्ड नंबर्स अथॉरिटी; DNS रूट, ग्लोबल IP/AS नंबर रिसोर्सेज और इंटरनेट प्रोटोकॉल पैरामीटर रजिस्ट्रियों का समन्वय (coordinate) करता है"},"o":[{"en":"Internet Anonymous Network Access; hides IP addresses","hi":"इंटरनेट एनोनिमस नेटवर्क एक्सेस; IP पतों को छुपाता है"},{"en":"Internal Application Naming Authority; names software","hi":"इंटरनल एप्लीकेशन नेमिंग अथॉरिटी; सॉफ्टवेयर का नामकरण करता है"},{"en":"Internet Assigned Numbers Authority; coordinates the DNS root, global IP/AS number resources, and Internet protocol parameter registries","hi":"इंटरनेट असाइन्ड नंबर्स अथॉरिटी; DNS रूट, ग्लोबल IP/AS नंबर रिसोर्सेज और इंटरनेट प्रोटोकॉल पैरामीटर रजिस्ट्रियों का समन्वय (coordinate) करता है"},{"en":"International Anti-virus Network Association; develops antivirus software","hi":"इंटरनेशनल एंटीवायरस नेटवर्क एसोसिएशन; एंटीवायरस सॉफ्टवेयर विकसित करता है"}],"exp":{"en":"IANA (Internet Assigned Numbers Authority) is responsible for coordinating some of the key elements that keep the Internet running smoothly, such as IP addresses and domain names.","hi":"IANA (इंटरनेट असाइन्ड नंबर्स अथॉरिटी) वह संस्था है जो पूरी दुनिया में इंटरनेट के IP एड्रेस, डोमेन नाम (DNS) और अन्य प्रोटोकॉल नंबरों का प्रबंधन और समन्वय करती है।"},"num":25},{"id":"q26","q":{"en":"What is the difference between IANA and an ISP?","hi":"IANA और ISP के बीच क्या अंतर है?"},"a":{"en":"IANA coordinates global Internet identifiers. An ISP provides Internet connectivity to users and organizations.","hi":"IANA वैश्विक इंटरनेट पहचानकर्ताओं (identifiers) का समन्वय करता है। एक ISP उपयोगकर्ताओं और संगठनों को इंटरनेट कनेक्टिविटी प्रदान करता है।"},"o":[{"en":"They are the same thing","hi":"वे एक ही चीज़ हैं"},{"en":"IANA coordinates global Internet identifiers. An ISP provides Internet connectivity to users and organizations.","hi":"IANA वैश्विक इंटरनेट पहचानकर्ताओं (identifiers) का समन्वय करता है। एक ISP उपयोगकर्ताओं और संगठनों को इंटरनेट कनेक्टिविटी प्रदान करता है।"},{"en":"ISP manages domain names, IANA provides internet access","hi":"ISP डोमेन नामों का प्रबंधन करता है, IANA इंटरनेट एक्सेस प्रदान करता है"},{"en":"IANA is for mobile networks, ISP is for broadband","hi":"IANA मोबाइल नेटवर्क के लिए है, ISP ब्रॉडबैंड के लिए है"}],"exp":{"en":"IANA works behind the scenes managing the global pool of IP addresses and DNS root zones. An ISP is the consumer-facing company (like Jio or AT&T) that actually connects your home to the Internet.","hi":"IANA इंटरनेट के 'नियम और नंबर' (IP एड्रेस/डोमेन) बाँटता है, जबकि ISP (इंटरनेट सर्विस प्रोवाइडर) वह कंपनी है जो आपके घर या ऑफिस में इंटरनेट का कनेक्शन (connectivity) देती है।"},"num":26},{"id":"q27","q":{"en":"What is the full form of SEO and what is its target traffic?","hi":"SEO का पूर्ण रूप क्या है और इसका लक्षित ट्रैफ़िक (target traffic) क्या है?"},"a":{"en":"Search Engine Optimization; makes a website easier for search engines to discover and understand, aiming for organic (unpaid) search visibility and relevant traffic","hi":"सर्च इंजन ऑप्टिमाइजेशन; एक वेबसाइट को सर्च इंजन के लिए खोजना और समझना आसान बनाता है, जिसका लक्ष्य ऑर्गेनिक (अनपेड) सर्च दृश्यता (visibility) और प्रासंगिक (relevant) ट्रैफ़िक है"},"o":[{"en":"Standard Email Organization; targets spam emails","hi":"स्टैंडर्ड ईमेल ऑर्गनाइजेशन; स्पैम ईमेल को लक्षित करता है"},{"en":"Secure Encoding Operation; targets hackers","hi":"सिक्योर एन्कोडिंग ऑपरेशन; हैकर्स को लक्षित करता है"},{"en":"Search Engine Optimization; makes a website easier for search engines to discover and understand, aiming for organic (unpaid) search visibility and relevant traffic","hi":"सर्च इंजन ऑप्टिमाइजेशन; एक वेबसाइट को सर्च इंजन के लिए खोजना और समझना आसान बनाता है, जिसका लक्ष्य ऑर्गेनिक (अनपेड) सर्च दृश्यता (visibility) और प्रासंगिक (relevant) ट्रैफ़िक है"},{"en":"System Error Observation; targets software bugs","hi":"सिस्टम एरर ऑब्जर्वेशन; सॉफ्टवेयर बग को लक्षित करता है"}],"exp":{"en":"SEO (Search Engine Optimization) involves improving a website to increase its visibility for relevant searches, thereby attracting more organic (non-paid) traffic.","hi":"SEO (सर्च इंजन ऑप्टिमाइजेशन) का उपयोग वेबसाइट को इस तरह बनाने में होता है कि सर्च इंजन (जैसे Google) उसे आसानी से ढूंढ सके, जिससे वेबसाइट पर बिना विज्ञापन (organic) के ज़्यादा लोग आएँ।"},"num":27},{"id":"q28","q":{"en":"What is the full form and function of a URL?","hi":"URL का पूर्ण रूप और कार्य क्या है?"},"a":{"en":"Uniform Resource Locator; provides the address to locate a web or network resource and indicates the method (scheme) of access","hi":"यूनिफ़ॉर्म रिसोर्स लोकेटर; वेब या नेटवर्क संसाधन (resource) का पता लगाने के लिए पता (address) प्रदान करता है और एक्सेस की विधि (स्कीम/scheme) को इंगित करता है"},"o":[{"en":"Universal Router Link; connects networks","hi":"यूनिवर्सल राउटर लिंक; नेटवर्क जोड़ता है"},{"en":"Uniform Resource Locator; provides the address to locate a web or network resource and indicates the method (scheme) of access","hi":"यूनिफ़ॉर्म रिसोर्स लोकेटर; वेब या नेटवर्क संसाधन (resource) का पता लगाने के लिए पता (address) प्रदान करता है और एक्सेस की विधि (स्कीम/scheme) को इंगित करता है"},{"en":"User Registration Log; tracks users","hi":"यूजर रजिस्ट्रेशन लॉग; उपयोगकर्ताओं को ट्रैक करता है"},{"en":"Unlimited Range Laser; a type of optical connection","hi":"अनलिमिटेड रेंज लेजर; एक प्रकार का ऑप्टिकल कनेक्शन"}],"exp":{"en":"A URL (Uniform Resource Locator) is a reference to a web resource that specifies its location on a computer network and a mechanism for retrieving it (e.g., http or https).","hi":"URL (यूनिफ़ॉर्म रिसोर्स लोकेटर) इंटरनेट पर किसी वेबपेज, इमेज या फाइल का पूरा पता (address) होता है, जो यह भी बताता है कि इसे कैसे एक्सेस करना है (जैसे http या ftp)।"},"num":28},{"id":"q29","q":{"en":"What are the main parts of a typical web URL like https://www.example.com/notes?chapter=12?","hi":"https://www.example.com/notes?chapter=12 जैसे एक विशिष्ट वेब URL के मुख्य भाग क्या हैं?"},"a":{"en":"Scheme (https), Host (www.example.com), Path (/notes), and Query (chapter=12). Port and fragment can also be part of the syntax.","hi":"स्कीम (https), होस्ट (www.example.com), पाथ (/notes), और क्वेरी (chapter=12)। पोर्ट (Port) और फ्रैगमेंट (fragment) भी सिंटैक्स का हिस्सा हो सकते हैं।"},"o":[{"en":"It only has one part: the domain name","hi":"इसमें केवल एक भाग होता है: डोमेन नाम"},{"en":"Scheme (https), Host (www.example.com), Path (/notes), and Query (chapter=12). Port and fragment can also be part of the syntax.","hi":"स्कीम (https), होस्ट (www.example.com), पाथ (/notes), और क्वेरी (chapter=12)। पोर्ट (Port) और फ्रैगमेंट (fragment) भी सिंटैक्स का हिस्सा हो सकते हैं।"},{"en":"Search term and password","hi":"सर्च शब्द और पासवर्ड"},{"en":"HTML, CSS, and JS","hi":"HTML, CSS और JS"}],"exp":{"en":"A standard URL is composed of several parts: the scheme (protocol), the host (domain name), the path to the specific resource, and optionally a query string or fragment identifier.","hi":"URL में कई हिस्से होते हैं: 'https' (स्कीम या प्रोटोकॉल), 'www.example.com' (होस्ट या डोमेन), '/notes' (पाथ या रास्ता), और '?chapter=12' (क्वेरी)।"},"num":29},{"id":"q30","q":{"en":"What is the relation between the year 1994, Tim Berners-Lee, and the URL?","hi":"वर्ष 1994, टिम बर्नर्स-ली और URL के बीच क्या संबंध है?"},"a":{"en":"The URL specification RFC 1738 was published in December 1994, authored by Tim Berners-Lee, Larry Masinter, and Mark McCahill (this is the year of formal specification)","hi":"URL विनिर्देश (specification) RFC 1738 दिसंबर 1994 में प्रकाशित हुआ था, जिसके लेखक टिम बर्नर्स-ली, लैरी मासिंटर और मार्क मैककाहिल थे (यह औपचारिक विनिर्देश/formal specification का वर्ष है)"},"o":[{"en":"The URL specification RFC 1738 was published in December 1994, authored by Tim Berners-Lee, Larry Masinter, and Mark McCahill (this is the year of formal specification)","hi":"URL विनिर्देश (specification) RFC 1738 दिसंबर 1994 में प्रकाशित हुआ था, जिसके लेखक टिम बर्नर्स-ली, लैरी मासिंटर और मार्क मैककाहिल थे (यह औपचारिक विनिर्देश/formal specification का वर्ष है)"},{"en":"Tim Berners-Lee bought the first URL in 1994","hi":"टिम बर्नर्स-ली ने 1994 में पहला URL खरीदा था"},{"en":"1994 is the year the internet was shut down","hi":"1994 वह वर्ष है जब इंटरनेट बंद कर दिया गया था"},{"en":"Tim Berners-Lee invented the computer mouse in 1994","hi":"टिम बर्नर्स-ली ने 1994 में कंप्यूटर माउस का आविष्कार किया था"}],"exp":{"en":"In December 1994, Tim Berners-Lee and others published RFC 1738, which formally defined the Uniform Resource Locator (URL) syntax and semantics.","hi":"दिसंबर 1994 में टिम बर्नर्स-ली और उनके साथियों ने मिलकर URL का औपचारिक मानक (RFC 1738) प्रकाशित किया था, जिसमें URL लिखने का सही तरीका तय किया गया था।"},"num":30},{"id":"q31","q":{"en":"What is the full form of FQDN and what is an example?","hi":"FQDN का पूर्ण रूप क्या है और इसका एक उदाहरण क्या है?"},"a":{"en":"Fully Qualified Domain Name; a complete DNS name that specifies the host's position in the hierarchy, e.g., www.example.com. (In DNS notation, a final dot can be added to show the root: www.example.com.)","hi":"फुली क्वालिफाइड डोमेन नेम; एक पूरा DNS नाम जो पदानुक्रम (hierarchy) में होस्ट की स्थिति निर्दिष्ट करता है, जैसे www.example.com। (DNS नोटेशन में, रूट दिखाने के लिए अंतिम डॉट जोड़ा जा सकता है: www.example.com.)"},"o":[{"en":"Fast Query Data Network; example: Google Search","hi":"फास्ट क्वेरी डेटा नेटवर्क; उदाहरण: Google सर्च"},{"en":"File Queue Domain Node; example: print server","hi":"फाइल कतार (Queue) डोमेन नोड; उदाहरण: प्रिंट सर्वर"},{"en":"Fully Qualified Domain Name; a complete DNS name that specifies the host's position in the hierarchy, e.g., www.example.com. (In DNS notation, a final dot can be added to show the root: www.example.com.)","hi":"फुली क्वालिफाइड डोमेन नेम; एक पूरा DNS नाम जो पदानुक्रम (hierarchy) में होस्ट की स्थिति निर्दिष्ट करता है, जैसे www.example.com। (DNS नोटेशन में, रूट दिखाने के लिए अंतिम डॉट जोड़ा जा सकता है: www.example.com.)"},{"en":"Frequency Quotient Digital Number; example: 192.168.1.1","hi":"फ्रीक्वेंसी कोशेंट डिजिटल नंबर; उदाहरण: 192.168.1.1"}],"exp":{"en":"An FQDN (Fully Qualified Domain Name) is the complete domain name for a specific computer, or host, on the Internet, specifying all domain levels (e.g., www.example.com).","hi":"FQDN (फुली क्वालिफाइड डोमेन नेम) इंटरनेट पर किसी कंप्यूटर (होस्ट) का पूरा नाम होता है (जैसे: www.example.com), जो बताता है कि वह DNS ट्री में कहाँ है।"},"num":31},{"id":"q32","q":{"en":"What is the difference between an FQDN and a URL?","hi":"FQDN और URL के बीच क्या अंतर है?"},"a":{"en":"FQDN is the complete DNS host name. A URL contains the scheme and resource location in addition to the host name (e.g., https://www.example.com/notes, where www.example.com is the host).","hi":"FQDN पूरा DNS होस्ट नाम है। एक URL में होस्ट नाम के अलावा स्कीम (scheme) और संसाधन का स्थान (resource location) भी शामिल होता है (जैसे https://www.example.com/notes, जहाँ www.example.com होस्ट है)।"},"o":[{"en":"They are exactly the same","hi":"वे बिल्कुल समान हैं"},{"en":"FQDN is the complete DNS host name. A URL contains the scheme and resource location in addition to the host name (e.g., https://www.example.com/notes, where www.example.com is the host).","hi":"FQDN पूरा DNS होस्ट नाम है। एक URL में होस्ट नाम के अलावा स्कीम (scheme) और संसाधन का स्थान (resource location) भी शामिल होता है (जैसे https://www.example.com/notes, जहाँ www.example.com होस्ट है)।"},{"en":"URL is for email, FQDN is for websites","hi":"URL ईमेल के लिए है, FQDN वेबसाइटों के लिए है"},{"en":"FQDN is an IP address, URL is text","hi":"FQDN एक IP पता है, URL टेक्स्ट है"}],"exp":{"en":"The FQDN is just the host's name (www.example.com). A URL includes the FQDN but adds the protocol (https://) and the path (/notes) to find a specific resource.","hi":"FQDN केवल कंप्यूटर का नाम है (www.example.com)। URL में उस नाम के साथ-साथ प्रोटोकॉल (https://) और फाइल का रास्ता (/notes) भी शामिल होता है।"},"num":32},{"id":"q33","q":{"en":"What is the full form and function of DNS?","hi":"DNS का पूर्ण रूप और कार्य क्या है?"},"a":{"en":"Domain Name System; a distributed naming system that looks up resource records from domain names (e.g., A/AAAA records map to IPv4/IPv6 addresses)","hi":"डोमेन नेम सिस्टम; एक वितरित नामकरण प्रणाली (distributed naming system) जो डोमेन नामों से संसाधन रिकॉर्ड (resource records) खोजती (lookup) है (जैसे, A/AAAA रिकॉर्ड IPv4/IPv6 पतों को मैप करते हैं)"},"o":[{"en":"Digital Network Service; speeds up downloads","hi":"डिजिटल नेटवर्क सर्विस; डाउनलोड को गति देता है"},{"en":"Domain Name System; a distributed naming system that looks up resource records from domain names (e.g., A/AAAA records map to IPv4/IPv6 addresses)","hi":"डोमेन नेम सिस्टम; एक वितरित नामकरण प्रणाली (distributed naming system) जो डोमेन नामों से संसाधन रिकॉर्ड (resource records) खोजती (lookup) है (जैसे, A/AAAA रिकॉर्ड IPv4/IPv6 पतों को मैप करते हैं)"},{"en":"Data Node Server; stores databases","hi":"डेटा नोड सर्वर; डेटाबेस स्टोर करता है"},{"en":"Download Naming Standard; names downloaded files","hi":"डाउनलोड नेमिंग स्टैंडर्ड; डाउनलोड की गई फ़ाइलों का नामकरण करता है"}],"exp":{"en":"DNS (Domain Name System) translates human-readable domain names (like example.com) into IP addresses that computers use to identify each other on the network.","hi":"DNS (डोमेन नेम सिस्टम) इंटरनेट की फोनबुक की तरह है। यह वेबसाइट के नाम (जैसे google.com) को IP एड्रेस (नंबरों) में बदलता है, ताकि कंप्यूटर उसे समझ सकें।"},"num":33},{"id":"q34","q":{"en":"What is the full form of IDN and what is an example?","hi":"IDN का पूर्ण रूप क्या है और इसका एक उदाहरण क्या है?"},"a":{"en":"Internationalized Domain Name; supports scripts outside of Latin ASCII letters, such as 'उदाहरण.भारत'. (IDNA/Punycode representation can be used for compatible ASCII labels in DNS)","hi":"अंतर्राष्ट्रीयकृत डोमेन नाम (Internationalized Domain Name); लैटिन ASCII अक्षरों के बाहर की लिपियों (scripts) का समर्थन करता है, जैसे 'उदाहरण.भारत'। (DNS में संगत ASCII लेबल के लिए IDNA/Punycode प्रतिनिधित्व का उपयोग किया जा सकता है)"},"o":[{"en":"Internal Data Node","hi":"इंटरनल डेटा नोड"},{"en":"Internationalized Domain Name; supports scripts outside of Latin ASCII letters, such as 'उदाहरण.भारत'. (IDNA/Punycode representation can be used for compatible ASCII labels in DNS)","hi":"अंतर्राष्ट्रीयकृत डोमेन नाम (Internationalized Domain Name); लैटिन ASCII अक्षरों के बाहर की लिपियों (scripts) का समर्थन करता है, जैसे 'उदाहरण.भारत'। (DNS में संगत ASCII लेबल के लिए IDNA/Punycode प्रतिनिधित्व का उपयोग किया जा सकता है)"},{"en":"Internet Digital Network","hi":"इंटरनेट डिजिटल नेटवर्क"},{"en":"Integrated Domain Naming","hi":"इंटीग्रेटेड डोमेन नेमिंग"}],"exp":{"en":"IDNs (Internationalized Domain Names) allow domain names to contain characters from non-Latin scripts (like Hindi, Arabic, or Chinese) using a translation system called Punycode.","hi":"IDN (इंटरनेशनलाइज्ड डोमेन नेम) का उपयोग अंग्रेज़ी (लैटिन) के अलावा दूसरी भाषाओं (जैसे हिंदी, चीनी, अरबी) में वेबसाइट का नाम (उदाहरण.भारत) रखने के लिए किया जाता है।"},"num":34},{"id":"q35","q":{"en":"What is the full form and function of DHCP?","hi":"DHCP का पूर्ण रूप और कार्य क्या है?"},"a":{"en":"Dynamic Host Configuration Protocol; can allocate network settings like IP address leases, subnet masks, default gateways, and DNS servers to devices","hi":"डायनामिक होस्ट कॉन्फ़िगरेशन प्रोटोकॉल; उपकरणों को IP एड्रेस लीज़, सबनेट मास्क, डिफ़ॉल्ट गेटवे और DNS सर्वर जैसी नेटवर्क सेटिंग्स आवंटित (allocate) कर सकता है"},"o":[{"en":"Digital Hardware Connection Port; it connects printers","hi":"डिजिटल हार्डवेयर कनेक्शन पोर्ट; यह प्रिंटर कनेक्ट करता है"},{"en":"Dynamic Host Configuration Protocol; can allocate network settings like IP address leases, subnet masks, default gateways, and DNS servers to devices","hi":"डायनामिक होस्ट कॉन्फ़िगरेशन प्रोटोकॉल; उपकरणों को IP एड्रेस लीज़, सबनेट मास्क, डिफ़ॉल्ट गेटवे और DNS सर्वर जैसी नेटवर्क सेटिंग्स आवंटित (allocate) कर सकता है"},{"en":"Data Handling Control Program; it manages hard drives","hi":"डेटा हैंडलिंग कंट्रोल प्रोग्राम; यह हार्ड ड्राइव का प्रबंधन करता है"},{"en":"Direct HTML Code Parser; it reads websites","hi":"डायरेक्ट HTML कोड पार्सर; यह वेबसाइटों को पढ़ता है"}],"exp":{"en":"DHCP (Dynamic Host Configuration Protocol) automatically assigns IP addresses and related network parameters to client devices on a network.","hi":"DHCP (डायनामिक होस्ट कॉन्फ़िगरेशन प्रोटोकॉल) नेटवर्क से जुड़ने वाले उपकरणों (जैसे लैपटॉप, फोन) को अपने आप IP एड्रेस और अन्य सेटिंग्स प्रदान करता है।"},"num":35},{"id":"q36","q":{"en":"How do you remember the distinct roles of DHCP and DNS?","hi":"आप DHCP और DNS की अलग-अलग भूमिकाओं (distinct roles) को कैसे याद रखेंगे?"},"a":{"en":"DHCP gives a device its network settings (IP, mask, gateway). DNS looks up resource records corresponding to names (converting domain names to IPs).","hi":"DHCP एक उपकरण को उसकी नेटवर्क सेटिंग्स (IP, मास्क, गेटवे) देता है। DNS नामों के अनुरूप संसाधन रिकॉर्ड खोजता है (डोमेन नामों को IP में परिवर्तित करता है)।"},"o":[{"en":"They both do the exact same thing","hi":"वे दोनों बिल्कुल एक ही काम करते हैं"},{"en":"DHCP gives a device its network settings (IP, mask, gateway). DNS looks up resource records corresponding to names (converting domain names to IPs).","hi":"DHCP एक उपकरण को उसकी नेटवर्क सेटिंग्स (IP, मास्क, गेटवे) देता है। DNS नामों के अनुरूप संसाधन रिकॉर्ड खोजता है (डोमेन नामों को IP में परिवर्तित करता है)।"},{"en":"DHCP is for websites, DNS is for printers","hi":"DHCP वेबसाइटों के लिए है, DNS प्रिंटर के लिए है"},{"en":"DNS gives a device its IP address, DHCP looks up names","hi":"DNS डिवाइस को उसका IP एड्रेस देता है, DHCP नाम खोजता है"}],"exp":{"en":"Remember: DHCP configures your device to be on the network (gives it an IP). DNS helps you find other devices on the internet (translates names to IPs).","hi":"अंतर याद रखें: DHCP आपके डिवाइस को नेटवर्क पर आने के लिए IP एड्रेस देता है। जबकि DNS आपको दूसरी वेबसाइटों का IP एड्रेस ढूँढने (नाम से नंबर) में मदद करता है।"},"num":36},{"id":"q37","q":{"en":"What is the full form of W3C and what is its role?","hi":"W3C का पूर्ण रूप क्या है और इसकी क्या भूमिका है?"},"a":{"en":"World Wide Web Consortium; it develops Web standards, such as CSS specifications","hi":"वर्ल्ड वाइड वेब कंसोर्टियम; यह वेब मानक (Web standards) विकसित करता है, जैसे CSS विनिर्देश (specifications)"},"o":[{"en":"Wireless Web WiFi Code; builds routers","hi":"वायरलेस वेब वाईफाई कोड; राउटर बनाता है"},{"en":"Web 3 Computing; develops cryptocurrencies","hi":"वेब 3 कंप्यूटिंग; क्रिप्टोकरेंसी विकसित करता है"},{"en":"World Wide Web Consortium; it develops Web standards, such as CSS specifications","hi":"वर्ल्ड वाइड वेब कंसोर्टियम; यह वेब मानक (Web standards) विकसित करता है, जैसे CSS विनिर्देश (specifications)"},{"en":"Windows 3 Computer; an old operating system","hi":"विंडोज 3 कंप्यूटर; एक पुराना ऑपरेटिंग सिस्टम"}],"exp":{"en":"The W3C (World Wide Web Consortium) is the main international standards organization for the World Wide Web, creating rules and guidelines for HTML, CSS, etc.","hi":"W3C (वर्ल्ड वाइड वेब कंसोर्टियम) वह मुख्य अंतरराष्ट्रीय संस्था है जो वर्ल्ड वाइड वेब (WWW) के लिए मानक (नियम) बनाती है, जैसे HTML और CSS कैसे काम करेंगे।"},"num":37},{"id":"q38","q":{"en":"What is the full form of FTP and what are its common port mappings?","hi":"FTP का पूर्ण रूप क्या है और इसके सामान्य पोर्ट मैपिंग क्या हैं?"},"a":{"en":"File Transfer Protocol. TCP 21 is the default port for the control connection. (In active FTP, the server typically uses TCP source port 20 for the data connection; passive FTP uses a negotiated data port.)","hi":"फाइल ट्रांसफर प्रोटोकॉल। TCP 21 नियंत्रण कनेक्शन (control connection) के लिए डिफ़ॉल्ट पोर्ट है। (सक्रिय/active FTP में, सर्वर आमतौर पर डेटा कनेक्शन के लिए TCP स्रोत पोर्ट 20 का उपयोग करता है; निष्क्रिय/passive FTP एक बातचीत (negotiated) वाले डेटा पोर्ट का उपयोग करता है।)"},"o":[{"en":"Fast Transfer Protocol; uses port 80","hi":"फास्ट ट्रांसफर प्रोटोकॉल; पोर्ट 80 का उपयोग करता है"},{"en":"File Transmission Process; uses port 25","hi":"फाइल ट्रांसमिशन प्रोसेस; पोर्ट 25 का उपयोग करता है"},{"en":"File Transfer Protocol. TCP 21 is the default port for the control connection. (In active FTP, the server typically uses TCP source port 20 for the data connection; passive FTP uses a negotiated data port.)","hi":"फाइल ट्रांसफर प्रोटोकॉल। TCP 21 नियंत्रण कनेक्शन (control connection) के लिए डिफ़ॉल्ट पोर्ट है। (सक्रिय/active FTP में, सर्वर आमतौर पर डेटा कनेक्शन के लिए TCP स्रोत पोर्ट 20 का उपयोग करता है; निष्क्रिय/passive FTP एक बातचीत (negotiated) वाले डेटा पोर्ट का उपयोग करता है।)"},{"en":"Folder Track Program; uses port 443","hi":"फोल्डर ट्रैक प्रोग्राम; पोर्ट 443 का उपयोग करता है"}],"exp":{"en":"FTP (File Transfer Protocol) primarily uses Port 21 for establishing the control connection (commands) and Port 20 (in active mode) for transferring the actual data.","hi":"FTP (फाइल ट्रांसफर प्रोटोकॉल) में पोर्ट 21 का उपयोग कमांड भेजने (कंट्रोल) के लिए होता है। डेटा ट्रांसफर करने के लिए एक्टिव मोड में पोर्ट 20 का इस्तेमाल किया जाता है।"},"num":38},{"id":"q39","q":{"en":"What is the full form of IRC and what is its role?","hi":"IRC का पूर्ण रूप क्या है और इसकी क्या भूमिका है?"},"a":{"en":"Internet Relay Chat; a client/server text chat protocol that supports both public/group channels and private messages","hi":"इंटरनेट रिले चैट; एक क्लाइंट/सर्वर टेक्स्ट चैट प्रोटोकॉल जो सार्वजनिक/समूह चैनल (public/group channels) और निजी संदेश (private messages) दोनों का समर्थन करता है"},"o":[{"en":"Internet Routing Control; manages routers","hi":"इंटरनेट रूटिंग कंट्रोल; राउटर्स का प्रबंधन करता है"},{"en":"Internal RAM Cache; speeds up memory","hi":"इंटरनल RAM कैश; मेमोरी को गति देता है"},{"en":"Internet Relay Chat; a client/server text chat protocol that supports both public/group channels and private messages","hi":"इंटरनेट रिले चैट; एक क्लाइंट/सर्वर टेक्स्ट चैट प्रोटोकॉल जो सार्वजनिक/समूह चैनल (public/group channels) और निजी संदेश (private messages) दोनों का समर्थन करता है"},{"en":"International Radio Connection; for FM stations","hi":"इंटरनेशनल रेडियो कनेक्शन; FM स्टेशनों के लिए"}],"exp":{"en":"IRC (Internet Relay Chat) is an application layer protocol that facilitates communication in the form of text, famously used for group discussion forums called channels.","hi":"IRC (इंटरनेट रिले चैट) एक पुरानी टेक्स्ट-आधारित चैट प्रणाली है। इसमें क्लाइंट-सर्वर मॉडल का उपयोग करके ग्रुप चैट (channels) और प्राइवेट मैसेज भेजे जाते हैं।"},"num":39},{"id":"q40","q":{"en":"What is the full form and role of CSS?","hi":"CSS का पूर्ण रूप और भूमिका क्या है?"},"a":{"en":"Cascading Style Sheets; controls the layout, colors, fonts, and presentation of a document. (HTML provides the structure, CSS styles that structure.)","hi":"कैस्केडिंग स्टाइल शीट्स; किसी दस्तावेज़ के लेआउट, रंग, फोंट और प्रस्तुति (presentation) को नियंत्रित करती है। (HTML संरचना प्रदान करता है, CSS उस संरचना को स्टाइल करती है।)"},"o":[{"en":"Central Security System; blocks hackers","hi":"सेंट्रल सिक्योरिटी सिस्टम; हैकर्स को ब्लॉक करता है"},{"en":"Computer Style Software; edits photos","hi":"कंप्यूटर स्टाइल सॉफ्टवेयर; फोटो एडिट करता है"},{"en":"Cascading Style Sheets; controls the layout, colors, fonts, and presentation of a document. (HTML provides the structure, CSS styles that structure.)","hi":"कैस्केडिंग स्टाइल शीट्स; किसी दस्तावेज़ के लेआउट, रंग, फोंट और प्रस्तुति (presentation) को नियंत्रित करती है। (HTML संरचना प्रदान करता है, CSS उस संरचना को स्टाइल करती है।)"},{"en":"Code System Standard; formats C++ code","hi":"कोड सिस्टम स्टैंडर्ड; C++ कोड को फ़ॉर्मेट करता है"}],"exp":{"en":"CSS (Cascading Style Sheets) is a stylesheet language used to describe the presentation (look and formatting) of a document written in HTML or XML.","hi":"CSS (कैस्केडिंग स्टाइल शीट्स) का उपयोग वेबसाइट को सुंदर बनाने (रंग, फॉन्ट, लेआउट) के लिए किया जाता है। HTML वेबसाइट का ढाँचा बनाता है और CSS उसमें रंग भरता है।"},"num":40},{"id":"q41","q":{"en":"Is CSS used exclusively for HTML?","hi":"क्या CSS का उपयोग विशेष रूप से (exclusively) केवल HTML के लिए किया जाता है?"},"a":{"en":"No, while common with HTML, CSS can also be used to style XML and SVG documents","hi":"नहीं, यद्यपि HTML के साथ आम है, CSS का उपयोग XML और SVG दस्तावेज़ों को स्टाइल करने के लिए भी किया जा सकता है"},"o":[{"en":"Yes, it only works with HTML","hi":"हाँ, यह केवल HTML के साथ काम करता है"},{"en":"No, while common with HTML, CSS can also be used to style XML and SVG documents","hi":"नहीं, यद्यपि HTML के साथ आम है, CSS का उपयोग XML और SVG दस्तावेज़ों को स्टाइल करने के लिए भी किया जा सकता है"},{"en":"Yes, it is a sub-language of HTML","hi":"हाँ, यह HTML की एक उप-भाषा (sub-language) है"},{"en":"No, it is mainly used for formatting Python code","hi":"नहीं, इसका उपयोग मुख्य रूप से पायथन कोड को फ़ॉर्मेट करने के लिए किया जाता है"}],"exp":{"en":"While CSS is most famously paired with HTML, it is also standard practice to use CSS to style other markup languages like XML and SVG.","hi":"हालाँकि CSS सबसे ज़्यादा HTML के साथ प्रयोग होती है, लेकिन इसका उपयोग XML और SVG (वेक्टर ग्राफिक्स) दस्तावेज़ों की स्टाइलिंग के लिए भी किया जा सकता है।"},"num":41},{"id":"q42","q":{"en":"What is the full form of DHTML and what are its main building blocks?","hi":"DHTML का पूर्ण रूप क्या है और इसके मुख्य निर्माण खंड (building blocks) क्या हैं?"},"a":{"en":"Dynamic HyperText Markup Language; a legacy umbrella term for the combined use of HTML, CSS, JavaScript, and the DOM to update content, style, or behavior dynamically","hi":"डायनेमिक हाइपरटेक्स्ट मार्कअप लैंग्वेज; सामग्री, शैली या व्यवहार (content, style, or behavior) को गतिशील (dynamically) रूप से अपडेट करने के लिए HTML, CSS, JavaScript और DOM के संयुक्त उपयोग के लिए एक विरासत छत्र शब्द (legacy umbrella term)"},"o":[{"en":"Direct HTML; uses only HTML","hi":"डायरेक्ट HTML; केवल HTML का उपयोग करता है"},{"en":"Digital HyperText Markup Language; uses C++","hi":"डिजिटल हाइपरटेक्स्ट मार्कअप लैंग्वेज; C++ का उपयोग करता है"},{"en":"Dynamic HyperText Markup Language; a legacy umbrella term for the combined use of HTML, CSS, JavaScript, and the DOM to update content, style, or behavior dynamically","hi":"डायनेमिक हाइपरटेक्स्ट मार्कअप लैंग्वेज; सामग्री, शैली या व्यवहार (content, style, or behavior) को गतिशील (dynamically) रूप से अपडेट करने के लिए HTML, CSS, JavaScript और DOM के संयुक्त उपयोग के लिए एक विरासत छत्र शब्द (legacy umbrella term)"},{"en":"Data HTML; uses SQL databases","hi":"डेटा HTML; SQL डेटाबेस का उपयोग करता है"}],"exp":{"en":"DHTML (Dynamic HTML) is an umbrella term for a collection of technologies (HTML, CSS, JS, DOM) used together to create interactive and animated websites.","hi":"DHTML कोई अलग भाषा नहीं है। यह HTML, CSS, जावास्क्रिप्ट और DOM को एक साथ मिलाकर वेबसाइट को गतिशील (interactive/dynamic) बनाने की तकनीक का पुराना नाम है।"},"num":42},{"id":"q43","q":{"en":"What is the full form and use of WML?","hi":"WML का पूर्ण रूप और उपयोग क्या था?"},"a":{"en":"Wireless Markup Language; an XML-based markup language originally intended for early WAP-enabled mobile phones and handheld devices","hi":"वायरलेस मार्कअप लैंग्वेज; मूल रूप से शुरुआती WAP-सक्षम मोबाइल फोन और हैंडहेल्ड डिवाइसों के लिए एक XML-आधारित मार्कअप लैंग्वेज"},"o":[{"en":"Windows Machine Logic; for operating systems","hi":"विंडोज मशीन लॉजिक; ऑपरेटिंग सिस्टम के लिए"},{"en":"Wireless Markup Language; an XML-based markup language originally intended for early WAP-enabled mobile phones and handheld devices","hi":"वायरलेस मार्कअप लैंग्वेज; मूल रूप से शुरुआती WAP-सक्षम मोबाइल फोन और हैंडहेल्ड डिवाइसों के लिए एक XML-आधारित मार्कअप लैंग्वेज"},{"en":"Web Media Language; for playing videos","hi":"वेब मीडिया लैंग्वेज; वीडियो चलाने के लिए"},{"en":"Word Manipulation Language; for text editors","hi":"वर्ड मैनिपुलेशन लैंग्वेज; टेक्स्ट एडिटर्स के लिए"}],"exp":{"en":"WML (Wireless Markup Language) was an XML-based language used to create web pages specifically formatted for early mobile phones using the WAP protocol.","hi":"WML (वायरलेस मार्कअप लैंग्वेज) का उपयोग पुराने ज़माने के फीचर फोन (WAP वाले फोन) की छोटी स्क्रीन पर वेबसाइट/टेक्स्ट दिखाने के लिए किया जाता था।"},"num":43},{"id":"q44","q":{"en":"What is the full form of BHTML as given in the source DOCX?","hi":"स्रोत DOCX में दिए गए अनुसार BHTML का पूर्ण रूप क्या है?"},"a":{"en":"Broadcast HyperText Markup Language (DOCX associates it with interactive digital-TV content; note that in standard Japanese data broadcasting, BML stands for Broadcast Markup Language)","hi":"ब्रॉडकास्ट हाइपरटेक्स्ट मार्कअप लैंग्वेज (DOCX इसे इंटरैक्टिव डिजिटल-टीवी सामग्री से जोड़ता है; ध्यान दें कि मानक जापानी डेटा प्रसारण में, BML का अर्थ ब्रॉडकास्ट मार्कअप लैंग्वेज है)"},"o":[{"en":"Broadcast HyperText Markup Language (DOCX associates it with interactive digital-TV content; note that in standard Japanese data broadcasting, BML stands for Broadcast Markup Language)","hi":"ब्रॉडकास्ट हाइपरटेक्स्ट मार्कअप लैंग्वेज (DOCX इसे इंटरैक्टिव डिजिटल-टीवी सामग्री से जोड़ता है; ध्यान दें कि मानक जापानी डेटा प्रसारण में, BML का अर्थ ब्रॉडकास्ट मार्कअप लैंग्वेज है)"},{"en":"Binary HTML; for fast loading","hi":"बाइनरी HTML; फास्ट लोडिंग के लिए"},{"en":"Basic HTML; only text without images","hi":"बेसिक HTML; छवियों के बिना केवल टेक्स्ट"},{"en":"Broadband HTML; for fast internet","hi":"ब्रॉडबैंड HTML; तेज़ इंटरनेट के लिए"}],"exp":{"en":"The study notes expand BHTML as Broadcast HyperText Markup Language, associating it with interactive TV content (similar to BML - Broadcast Markup Language used in Japan).","hi":"परीक्षा के नोट्स में BHTML का अर्थ 'ब्रॉडकास्ट हाइपरटेक्स्ट मार्कअप लैंग्वेज' दिया गया है, जिसे डिजिटल-टीवी प्रसारण सामग्री (interactive digital-TV content) से जोड़ा जाता है।"},"num":44}]},{"title":{"en":"4. Hardware, Software, Memory & Data Structures","hi":"4. हार्डवेयर, सॉफ्टवेयर, मेमोरी और डेटा संरचनाएँ"},"questions":[{"id":"q45","q":{"en":"What is the full form of RDRAM and what was its main design goal?","hi":"RDRAM का पूर्ण रूप क्या है और इसका मुख्य डिज़ाइन लक्ष्य क्या था?"},"a":{"en":"Rambus Dynamic Random Access Memory; a DRAM architecture designed by Rambus for high-bandwidth memory transfers","hi":"रैमबस डायनेमिक रैंडम एक्सेस मेमोरी; रैमबस द्वारा उच्च बैंडविड्थ (high-bandwidth) मेमोरी ट्रांसफर के लिए डिज़ाइन किया गया एक DRAM आर्किटेक्चर"},"o":[{"en":"Random Digital Read Access Memory; designed for basic calculators","hi":"रैंडम डिजिटल रीड एक्सेस मेमोरी; बेसिक कैलकुलेटर के लिए डिज़ाइन किया गया"},{"en":"Rambus Dynamic Random Access Memory; a DRAM architecture designed by Rambus for high-bandwidth memory transfers","hi":"रैमबस डायनेमिक रैंडम एक्सेस मेमोरी; रैमबस द्वारा उच्च बैंडविड्थ (high-bandwidth) मेमोरी ट्रांसफर के लिए डिज़ाइन किया गया एक DRAM आर्किटेक्चर"},{"en":"Read Direct Random Access Memory; designed to bypass the CPU","hi":"रीड डायरेक्ट रैंडम एक्सेस मेमोरी; CPU को बायपास करने के लिए डिज़ाइन किया गया"},{"en":"Relational Data Random Access Memory; designed for databases","hi":"रिलेशनल डेटा रैंडम एक्सेस मेमोरी; डेटाबेस के लिए डिज़ाइन किया गया"}],"exp":{"en":"RDRAM stands for Rambus Dynamic Random Access Memory, a type of high-performance synchronous dynamic RAM developed by Rambus Inc. for fast data transfers.","hi":"RDRAM का पूर्ण रूप 'रैमबस डायनेमिक रैंडम एक्सेस मेमोरी' है। इसे रैमबस (Rambus) कंपनी ने मेमोरी से बहुत तेज़ी (high-bandwidth) से डेटा ट्रांसफर करने के लिए डिज़ाइन किया था।"},"num":45},{"id":"q46","q":{"en":"What is the key difference between RDRAM and RDMA?","hi":"RDRAM और RDMA के बीच मुख्य अंतर क्या है?"},"a":{"en":"RDRAM is a memory architecture. RDMA is a technique for direct data movement between the memory of computers across a network.","hi":"RDRAM एक मेमोरी आर्किटेक्चर है। RDMA एक नेटवर्क पर कंप्यूटरों की मेमोरी के बीच सीधे डेटा की आवाजाही (direct data movement) की एक तकनीक है।"},"o":[{"en":"They are the exact same thing","hi":"वे बिल्कुल एक ही चीज़ हैं"},{"en":"RDRAM is a memory architecture. RDMA is a technique for direct data movement between the memory of computers across a network.","hi":"RDRAM एक मेमोरी आर्किटेक्चर है। RDMA एक नेटवर्क पर कंप्यूटरों की मेमोरी के बीच सीधे डेटा की आवाजाही (direct data movement) की एक तकनीक है।"},{"en":"RDRAM is for networks, RDMA is for CPUs","hi":"RDRAM नेटवर्क के लिए है, RDMA CPU के लिए है"},{"en":"RDMA is older than RDRAM","hi":"RDMA, RDRAM से पुराना है"}],"exp":{"en":"RDRAM refers to physical memory chips (hardware). RDMA is a networking technology that allows direct memory access from the memory of one computer into that of another without involving either one's operating system.","hi":"RDRAM कंप्यूटर के अंदर लगने वाली एक रैम (मेमोरी चिप) है। जबकि RDMA (रिमोट डायरेक्ट मेमोरी एक्सेस) एक तकनीक है जिससे नेटवर्क से जुड़े दो कंप्यूटर एक-दूसरे की मेमोरी में सीधा डेटा भेज या पढ़ सकते हैं (बिना OS के दखल के)।"},"num":46},{"id":"q47","q":{"en":"What is the full form and practical benefit of RDMA?","hi":"RDMA का पूर्ण रूप और व्यावहारिक लाभ (practical benefit) क्या है?"},"a":{"en":"Remote Direct Memory Access; the network adapter can offload transfers between registered memory buffers, resulting in lower latency and higher throughput by reducing CPU/OS overhead (e.g., in HPC clusters)","hi":"रिमोट डायरेक्ट मेमोरी एक्सेस; नेटवर्क एडेप्टर पंजीकृत मेमोरी बफ़र्स के बीच ट्रांसफ़र को ऑफ़लोड कर सकता है, जिसके परिणामस्वरूप CPU/OS ओवरहेड कम करके विलंबता (latency) कम और थ्रूपुट अधिक होता है (जैसे, HPC क्लस्टर्स में)"},"o":[{"en":"Random Data Machine Access; speeds up hard drives","hi":"रैंडम डेटा मशीन एक्सेस; हार्ड ड्राइव को गति देता है"},{"en":"Remote Direct Memory Access; the network adapter can offload transfers between registered memory buffers, resulting in lower latency and higher throughput by reducing CPU/OS overhead (e.g., in HPC clusters)","hi":"रिमोट डायरेक्ट मेमोरी एक्सेस; नेटवर्क एडेप्टर पंजीकृत मेमोरी बफ़र्स के बीच ट्रांसफ़र को ऑफ़लोड कर सकता है, जिसके परिणामस्वरूप CPU/OS ओवरहेड कम करके विलंबता (latency) कम और थ्रूपुट अधिक होता है (जैसे, HPC क्लस्टर्स में)"},{"en":"Read Digital Memory Allocation; used for graphics","hi":"रीड डिजिटल मेमोरी एलोकेशन; ग्राफिक्स के लिए उपयोग किया जाता है"},{"en":"Router Dedicated Mobile Access; used for 5G","hi":"राउटर डेडिकेटेड मोबाइल एक्सेस; 5G के लिए उपयोग किया जाता है"}],"exp":{"en":"RDMA (Remote Direct Memory Access) bypasses the CPU and OS kernel for memory transfers across a network, drastically lowering latency and increasing throughput, which is vital for supercomputers (HPC).","hi":"RDMA (रिमोट डायरेक्ट मेमोरी एक्सेस) के कारण डेटा सीधे नेटवर्क कार्ड से कंप्यूटर की मेमोरी में चला जाता है। इससे CPU का काम बचता है, गति (throughput) बढ़ती है और देरी (latency) कम होती है (खासकर सुपरकंप्यूटर्स में)।"},"num":47},{"id":"q48","q":{"en":"What are the full form, headquarters, and business areas of IBM?","hi":"IBM का पूर्ण रूप, मुख्यालय (headquarters) और व्यावसायिक क्षेत्र (business areas) क्या हैं?"},"a":{"en":"International Business Machines; Headquarters in Armonk, New York; a company associated with hardware, software, infrastructure, and consulting","hi":"इंटरनेशनल बिजनेस मशीन्स; आर्मोंक (Armonk), न्यूयॉर्क में मुख्यालय; हार्डवेयर, सॉफ्टवेयर, बुनियादी ढांचे (infrastructure) और परामर्श (consulting) से जुड़ी कंपनी"},"o":[{"en":"Internal Business Machines; New York City; makes printers","hi":"इंटरनल बिजनेस मशीनें; न्यूयॉर्क शहर; प्रिंटर बनाता है"},{"en":"International Business Machines; Headquarters in Armonk, New York; a company associated with hardware, software, infrastructure, and consulting","hi":"इंटरनेशनल बिजनेस मशीन्स; आर्मोंक (Armonk), न्यूयॉर्क में मुख्यालय; हार्डवेयर, सॉफ्टवेयर, बुनियादी ढांचे (infrastructure) और परामर्श (consulting) से जुड़ी कंपनी"},{"en":"Internet Board of Managers; Seattle; manages web servers","hi":"इंटरनेट बोर्ड ऑफ मैनेजर्स; सिएटल; वेब सर्वर का प्रबंधन करता है"},{"en":"Integrated Binary Modules; Silicon Valley; makes microchips","hi":"इंटीग्रेटेड बाइनरी मॉड्यूल; सिलिकॉन वैली; माइक्रोचिप बनाता है"}],"exp":{"en":"IBM (International Business Machines Corporation) is headquartered in Armonk, NY. It is a major multinational technology and consulting company.","hi":"IBM का पूरा नाम इंटरनेशनल बिजनेस मशीन्स (International Business Machines) है। इसका मुख्यालय आर्मोंक, न्यूयॉर्क में है और यह हार्डवेयर, सॉफ्टवेयर तथा IT कंसल्टिंग का काम करती है।"},"num":48},{"id":"q49","q":{"en":"What is the name of the Chairman and CEO of IBM as given in the source notes?","hi":"स्रोत नोट्स (source notes) में IBM के अध्यक्ष (Chairman) और CEO का नाम क्या दिया गया है?"},"a":{"en":"Arvind Krishna (The IBM leadership page also lists him as Chairman, President and Chief Executive Officer)","hi":"अरविंद कृष्णा (IBM लीडरशिप पेज भी उन्हें अध्यक्ष, राष्ट्रपति और मुख्य कार्यकारी अधिकारी के रूप में सूचीबद्ध करता है)"},"o":[{"en":"Tim Cook","hi":"टिम कुक"},{"en":"Satya Nadella","hi":"सत्य नडेला"},{"en":"Arvind Krishna (The IBM leadership page also lists him as Chairman, President and Chief Executive Officer)","hi":"अरविंद कृष्णा (IBM लीडरशिप पेज भी उन्हें अध्यक्ष, राष्ट्रपति और मुख्य कार्यकारी अधिकारी के रूप में सूचीबद्ध करता है)"},{"en":"Sundar Pichai","hi":"सुंदर पिचाई"}],"exp":{"en":"Arvind Krishna is the Chairman, President, and CEO of IBM.","hi":"अरविंद कृष्णा IBM के वर्तमान अध्यक्ष (Chairman) और मुख्य कार्यकारी अधिकारी (CEO) हैं।"},"num":49},{"id":"q50","q":{"en":"What is the standard full form and function of DDL?","hi":"DDL का मानक पूर्ण रूप और कार्य क्या है?"},"a":{"en":"Data Definition Language; commands used to define or change database schema objects, such as CREATE, ALTER, and DROP. ('Data Description Language' is an alternate expansion found in notes.)","hi":"डेटा डेफिनिशन लैंग्वेज; डेटाबेस स्कीमा ऑब्जेक्ट्स को परिभाषित करने या बदलने के लिए उपयोग किए जाने वाले कमांड, जैसे CREATE, ALTER और DROP। (नोट्स में 'डेटा डिस्क्रिप्शन लैंग्वेज' भी एक वैकल्पिक विस्तार है।)"},"o":[{"en":"Direct Download Link; downloads files","hi":"डायरेक्ट डाउनलोड लिंक; फ़ाइलें डाउनलोड करता है"},{"en":"Data Definition Language; commands used to define or change database schema objects, such as CREATE, ALTER, and DROP. ('Data Description Language' is an alternate expansion found in notes.)","hi":"डेटा डेफिनिशन लैंग्वेज; डेटाबेस स्कीमा ऑब्जेक्ट्स को परिभाषित करने या बदलने के लिए उपयोग किए जाने वाले कमांड, जैसे CREATE, ALTER और DROP। (नोट्स में 'डेटा डिस्क्रिप्शन लैंग्वेज' भी एक वैकल्पिक विस्तार है।)"},{"en":"Digital Data Line; connects modems","hi":"डिजिटल डेटा लाइन; मोडेम को जोड़ता है"},{"en":"Document Display Layout; formats text","hi":"डॉक्यूमेंट डिस्प्ले लेआउट; टेक्स्ट को फ़ॉर्मेट करता है"}],"exp":{"en":"DDL stands for Data Definition Language. It consists of SQL commands like CREATE, ALTER, and DROP used to define the database structure (schema).","hi":"DDL (डेटा डेफिनिशन लैंग्वेज) SQL का वह हिस्सा है जिसका उपयोग डेटाबेस का ढाँचा (schema) बनाने, बदलने या हटाने (CREATE, ALTER, DROP) के लिए किया जाता है।"},"num":50},{"id":"q51","q":{"en":"What is the full form of CLI and what is its interaction method?","hi":"CLI का पूर्ण रूप क्या है और इसकी बातचीत विधि (interaction method) क्या है?"},"a":{"en":"Command Line Interface; users interact with a system/app by typing text commands (e.g., Windows Command Prompt or a shell in a terminal). A command language interpreter processes the commands.","hi":"कमांड लाइन इंटरफ़ेस; उपयोगकर्ता टेक्स्ट कमांड टाइप करके सिस्टम/ऐप से इंटरैक्ट करते हैं (जैसे, विंडोज कमांड प्रॉम्प्ट या टर्मिनल में शेल)। एक कमांड लैंग्वेज इंटरप्रेटर कमांड को प्रोसेस करता है।"},"o":[{"en":"Computer Link Interface; uses a mouse","hi":"कंप्यूटर लिंक इंटरफ़ेस; माउस का उपयोग करता है"},{"en":"Command Line Interface; users interact with a system/app by typing text commands (e.g., Windows Command Prompt or a shell in a terminal). A command language interpreter processes the commands.","hi":"कमांड लाइन इंटरफ़ेस; उपयोगकर्ता टेक्स्ट कमांड टाइप करके सिस्टम/ऐप से इंटरैक्ट करते हैं (जैसे, विंडोज कमांड प्रॉम्प्ट या टर्मिनल में शेल)। एक कमांड लैंग्वेज इंटरप्रेटर कमांड को प्रोसेस करता है।"},{"en":"Central Logic Integration; uses voice commands","hi":"सेंट्रल लॉजिक इंटीग्रेशन; वॉयस कमांड का उपयोग करता है"},{"en":"Code List Index; uses menus","hi":"कोड लिस्ट इंडेक्स; मेनू का उपयोग करता है"}],"exp":{"en":"CLI (Command Line Interface) is a text-based user interface used to view and manage computer files by typing commands into a console or terminal.","hi":"CLI (कमांड लाइन इंटरफ़ेस) में कंप्यूटर को माउस की जगह टेक्स्ट कमांड (text commands) टाइप करके निर्देश (instructions) दिए जाते हैं, जैसे कि विंडोज के कमांड प्रॉम्प्ट (CMD) में।"},"num":51},{"id":"q52","q":{"en":"What is the full form of OLE and who is the developer?","hi":"OLE का पूर्ण रूप क्या है और इसका डेवलपर कौन है?"},"a":{"en":"Object Linking and Embedding; a Microsoft technology (e.g., linking or embedding an Excel chart in a Word document)","hi":"ऑब्जेक्ट लिंकिंग और एम्बेडिंग; एक Microsoft तकनीक (जैसे, Word दस्तावेज़ में Excel चार्ट को लिंक या एम्बेड करना)"},"o":[{"en":"Online Language Editor; developed by Google","hi":"ऑनलाइन लैंग्वेज एडिटर; Google द्वारा विकसित"},{"en":"Optical Light Emitter; developed by IBM","hi":"ऑप्टिकल लाइट एमिटर; IBM द्वारा विकसित"},{"en":"Object Linking and Embedding; a Microsoft technology (e.g., linking or embedding an Excel chart in a Word document)","hi":"ऑब्जेक्ट लिंकिंग और एम्बेडिंग; एक Microsoft तकनीक (जैसे, Word दस्तावेज़ में Excel चार्ट को लिंक या एम्बेड करना)"},{"en":"Operating Level Execution; developed by Linux","hi":"ऑपरेटिंग लेवल एग्जीक्यूशन; लिनक्स द्वारा विकसित"}],"exp":{"en":"OLE (Object Linking and Embedding) is a Microsoft technology that allows embedding and linking to documents and other objects (like putting a live Excel table into Word).","hi":"OLE (ऑब्जेक्ट लिंकिंग और एम्बेडिंग) माइक्रोसॉफ्ट (Microsoft) की तकनीक है। इससे आप एक प्रोग्राम का डेटा दूसरे प्रोग्राम में डाल सकते हैं (जैसे Word में Excel का चार्ट लगाना)।"},"num":52},{"id":"q53","q":{"en":"What is the difference between linking and embedding in OLE?","hi":"OLE में लिंकिंग (linking) और एम्बेडिंग (embedding) के बीच क्या अंतर है?"},"a":{"en":"A linked object keeps a reference to the original file and can update when the source changes. A copy of an embedded object is saved directly within the destination document.","hi":"लिंक किया गया ऑब्जेक्ट मूल फ़ाइल का संदर्भ (reference) रखता है और स्रोत (source) बदलने पर अपडेट हो सकता है। एम्बेडेड ऑब्जेक्ट की एक प्रति गंतव्य दस्तावेज़ (destination document) के भीतर सीधे सहेजी (save) जाती है।"},"o":[{"en":"They are the same","hi":"वे समान हैं"},{"en":"A linked object keeps a reference to the original file and can update when the source changes. A copy of an embedded object is saved directly within the destination document.","hi":"लिंक किया गया ऑब्जेक्ट मूल फ़ाइल का संदर्भ (reference) रखता है और स्रोत (source) बदलने पर अपडेट हो सकता है। एम्बेडेड ऑब्जेक्ट की एक प्रति गंतव्य दस्तावेज़ (destination document) के भीतर सीधे सहेजी (save) जाती है।"},{"en":"Linking is for text, embedding is for images","hi":"लिंकिंग टेक्स्ट के लिए है, एम्बेडिंग छवियों के लिए है"},{"en":"Linking saves space on the RAM, embedding uses the cloud","hi":"लिंकिंग RAM पर स्थान बचाती है, एम्बेडिंग क्लाउड का उपयोग करती है"}],"exp":{"en":"In OLE, a linked object remains stored in its source file (changes in the source update the destination). An embedded object becomes part of the destination file itself.","hi":"लिंकिंग में, केवल मूल फ़ाइल (source) का रास्ता दिया जाता है, जिससे मूल फ़ाइल बदलने पर वर्ड फाइल भी अपडेट हो जाती है। एम्बेडिंग में, डेटा की पूरी कॉपी वर्ड फाइल में सेव (save) हो जाती है।"},"num":53},{"id":"q54","q":{"en":"What is the full form of DOS and what are the characteristics of classic MS-DOS?","hi":"DOS का पूर्ण रूप क्या है और क्लासिक MS-DOS की विशेषताएँ (characteristics) क्या हैं?"},"a":{"en":"Disk Operating System. Classic MS-DOS was a single-user, primarily single-tasking command-line operating system used on microcomputers.","hi":"डिस्क ऑपरेटिंग सिस्टम। क्लासिक MS-DOS एक सिंगल-यूजर, मुख्य रूप से सिंगल-टास्किंग कमांड-लाइन ऑपरेटिंग सिस्टम था, जिसका उपयोग माइक्रो कंप्यूटर पर किया जाता था।"},"o":[{"en":"Data Output System; a graphical OS","hi":"डेटा आउटपुट सिस्टम; एक ग्राफिकल OS"},{"en":"Disk Operating System. Classic MS-DOS was a single-user, primarily single-tasking command-line operating system used on microcomputers.","hi":"डिस्क ऑपरेटिंग सिस्टम। क्लासिक MS-DOS एक सिंगल-यूजर, मुख्य रूप से सिंगल-टास्किंग कमांड-लाइन ऑपरेटिंग सिस्टम था, जिसका उपयोग माइक्रो कंप्यूटर पर किया जाता था।"},{"en":"Digital Order System; used for networking","hi":"डिजिटल ऑर्डर सिस्टम; नेटवर्किंग के लिए उपयोग किया जाता है"},{"en":"Direct Operating Software; used on mainframes","hi":"डायरेक्ट ऑपरेटिंग सॉफ्टवेयर; मेनफ्रेम पर उपयोग किया जाता है"}],"exp":{"en":"DOS stands for Disk Operating System. MS-DOS was the dominant, single-tasking, command-line OS for IBM PC compatibles during the 1980s.","hi":"DOS का पूर्ण रूप 'डिस्क ऑपरेटिंग सिस्टम' है। पुराना MS-DOS एक सिंगल-यूजर (एक बार में एक यूज़र) और सिंगल-टास्किंग (एक बार में एक काम) वाला कमांड-लाइन सिस्टम था।"},"num":54},{"id":"q55","q":{"en":"What was Tim Paterson's relationship with DOS?","hi":"DOS के साथ टिम पैटर्सन (Tim Paterson) का क्या संबंध था?"},"a":{"en":"He developed QDOS/86-DOS at Seattle Computer Products. Microsoft developed/marketed MS-DOS from this base.","hi":"उन्होंने सिएटल कंप्यूटर प्रोडक्ट्स (Seattle Computer Products) में QDOS/86-DOS विकसित किया। Microsoft ने इसी आधार (base) से MS-DOS को विकसित/मार्केट किया।"},"o":[{"en":"He invented the hard drive for it","hi":"उन्होंने इसके लिए हार्ड ड्राइव का आविष्कार किया"},{"en":"He developed QDOS/86-DOS at Seattle Computer Products. Microsoft developed/marketed MS-DOS from this base.","hi":"उन्होंने सिएटल कंप्यूटर प्रोडक्ट्स (Seattle Computer Products) में QDOS/86-DOS विकसित किया। Microsoft ने इसी आधार (base) से MS-DOS को विकसित/मार्केट किया।"},{"en":"He was the CEO of Microsoft","hi":"वे Microsoft के CEO थे"},{"en":"He sued Microsoft over DOS","hi":"उन्होंने DOS को लेकर Microsoft पर मुकदमा किया था"}],"exp":{"en":"Tim Paterson wrote 86-DOS (originally QDOS) for Seattle Computer Products, which Microsoft purchased, modified, and licensed to IBM as PC DOS/MS-DOS.","hi":"टिम पैटर्सन ने QDOS (86-DOS) बनाया था। बाद में Microsoft ने इसी को खरीद कर उसमें बदलाव किए और उसे MS-DOS के नाम से बेचा।"},"num":55},{"id":"q56","q":{"en":"What is the difference between DOS and DoS?","hi":"DOS और DoS के बीच क्या अंतर है?"},"a":{"en":"DOS = Disk Operating System. In cybersecurity, DoS = Denial of Service, an attack designed to disrupt service availability.","hi":"DOS = डिस्क ऑपरेटिंग सिस्टम। साइबर सुरक्षा में, DoS = डिनायल ऑफ सर्विस (Denial of Service), सेवा उपलब्धता को बाधित (disrupt) करने के लिए डिज़ाइन किया गया एक हमला (attack)।"},"o":[{"en":"DOS = Disk Operating System. In cybersecurity, DoS = Denial of Service, an attack designed to disrupt service availability.","hi":"DOS = डिस्क ऑपरेटिंग सिस्टम। साइबर सुरक्षा में, DoS = डिनायल ऑफ सर्विस (Denial of Service), सेवा उपलब्धता को बाधित (disrupt) करने के लिए डिज़ाइन किया गया एक हमला (attack)।"},{"en":"DOS is for Macs, DoS is for Windows","hi":"DOS Mac के लिए है, DoS Windows के लिए है"},{"en":"DOS is software, DoS is hardware","hi":"DOS सॉफ्टवेयर है, DoS हार्डवेयर है"},{"en":"They are the same thing","hi":"वे एक ही चीज़ हैं"}],"exp":{"en":"While DOS is the Disk Operating System, DoS with a lowercase 'o' stands for Denial of Service, a type of cyberattack meant to overwhelm a system.","hi":"बड़े अक्षरों वाला DOS 'डिस्क ऑपरेटिंग सिस्टम' (एक सॉफ्टवेयर) है। जबकि छोटे 'o' वाला DoS (Denial of Service) हैकर्स द्वारा वेबसाइट या सर्वर को ठप (क्रैश) करने वाला एक साइबर हमला है।"},"num":56},{"id":"q57","q":{"en":"What is the full form of VDU and what are some examples?","hi":"VDU का पूर्ण रूप क्या है और इसके कुछ उदाहरण क्या हैं?"},"a":{"en":"Visual Display Unit; an output device that displays computer information on a screen, such as an LCD (Liquid Crystal Display) or OLED (Organic Light-Emitting Diode) display","hi":"विजुअल डिस्प्ले यूनिट; एक आउटपुट डिवाइस जो स्क्रीन पर कंप्यूटर की जानकारी प्रदर्शित करता है, जैसे कि LCD (लिक्विड क्रिस्टल डिस्प्ले) या OLED (ऑर्गेनिक लाइट-एमिटिंग डायोड) डिस्प्ले"},"o":[{"en":"Video Data Utility; graphic cards","hi":"वीडियो डेटा यूटिलिटी; ग्राफिक कार्ड"},{"en":"Visual Display Unit; an output device that displays computer information on a screen, such as an LCD (Liquid Crystal Display) or OLED (Organic Light-Emitting Diode) display","hi":"विजुअल डिस्प्ले यूनिट; एक आउटपुट डिवाइस जो स्क्रीन पर कंप्यूटर की जानकारी प्रदर्शित करता है, जैसे कि LCD (लिक्विड क्रिस्टल डिस्प्ले) या OLED (ऑर्गेनिक लाइट-एमिटिंग डायोड) डिस्प्ले"},{"en":"Variable Disk Unit; hard drives","hi":"वेरिएबल डिस्क यूनिट; हार्ड ड्राइव"},{"en":"Virtual Data Uploader; cloud software","hi":"वर्चुअल डेटा अपलोडर; क्लाउड सॉफ्टवेयर"}],"exp":{"en":"VDU stands for Visual Display Unit, which is a generic term for monitors and screens (like LCDs or OLEDs) that output visual information.","hi":"VDU का अर्थ विजुअल डिस्प्ले यूनिट (Visual Display Unit) है। यह कंप्यूटर मॉनिटर या स्क्रीन का दूसरा नाम है (जैसे LCD या OLED स्क्रीन)।"},"num":57},{"id":"q58","q":{"en":"What is the full form and meaning of VR?","hi":"VR का पूर्ण रूप और अर्थ क्या है?"},"a":{"en":"Virtual Reality; a computer-generated immersive environment that a user can experience through headsets or other interfaces","hi":"वर्चुअल रियलिटी; एक कंप्यूटर जनित इमर्सिव वातावरण (immersive environment) जिसे उपयोगकर्ता हेडसेट या अन्य इंटरफेस के माध्यम से अनुभव कर सकता है"},"o":[{"en":"Video Resolution; picture quality","hi":"वीडियो रिज़ॉल्यूशन; पिक्चर क्वालिटी"},{"en":"Voice Recognition; typing with voice","hi":"वॉयस रिकग्निशन; आवाज़ से टाइपिंग"},{"en":"Virtual Reality; a computer-generated immersive environment that a user can experience through headsets or other interfaces","hi":"वर्चुअल रियलिटी; एक कंप्यूटर जनित इमर्सिव वातावरण (immersive environment) जिसे उपयोगकर्ता हेडसेट या अन्य इंटरफेस के माध्यम से अनुभव कर सकता है"},{"en":"Variable Routing; network paths","hi":"वेरिएबल रूटिंग; नेटवर्क पथ"}],"exp":{"en":"VR (Virtual Reality) is an artificial, computer-generated simulation or recreation of a real-life environment or situation, usually experienced via a headset.","hi":"VR का पूर्ण रूप 'वर्चुअल रियलिटी' (Virtual Reality) है। यह कंप्यूटर द्वारा बनाया गया एक 3D वातावरण है, जिसे हेडसेट पहनकर ऐसा लगता है जैसे हम सचमुच उस जगह पर मौजूद हों।"},"num":58},{"id":"q59","q":{"en":"What is the full form of WORM and what are some storage examples?","hi":"WORM का पूर्ण रूप क्या है और इसके कुछ स्टोरेज उदाहरण क्या हैं?"},"a":{"en":"Write Once, Read Many; the recorded area can be read repeatedly without being overwritten or erased (e.g., CD-R, DVD-R, and one-time-programmable PROM)","hi":"राइट वन्स, रीड मैनी; रिकॉर्ड किए गए क्षेत्र को ओवरराइट या इरेज़ (मिटाए) बिना बार-बार पढ़ा जा सकता है (जैसे, CD-R, DVD-R, और वन-टाइम-प्रोग्रामेबल PROM)"},"o":[{"en":"Write Once, Read Many; the recorded area can be read repeatedly without being overwritten or erased (e.g., CD-R, DVD-R, and one-time-programmable PROM)","hi":"राइट वन्स, रीड मैनी; रिकॉर्ड किए गए क्षेत्र को ओवरराइट या इरेज़ (मिटाए) बिना बार-बार पढ़ा जा सकता है (जैसे, CD-R, DVD-R, और वन-टाइम-प्रोग्रामेबल PROM)"},{"en":"Wide Object Retention Mechanism; flash drives","hi":"वाइड ऑब्जेक्ट रिटेंशन मैकेनिज्म; फ्लैश ड्राइव"},{"en":"Web Output Read Memory; cloud storage","hi":"वेब आउटपुट रीड मेमोरी; क्लाउड स्टोरेज"},{"en":"Wireless Operation Radio Modem; Wi-Fi routers","hi":"वायरलेस ऑपरेशन रेडियो मोडेम; वाई-फाई राउटर"}],"exp":{"en":"WORM (Write Once, Read Many) refers to data storage media where data can be written exactly once, but read any number of times, like CD-Rs.","hi":"WORM (राइट वन्स, रीड मैनी) ऐसी स्टोरेज होती है जिसमें डेटा केवल एक बार लिखा जा सकता है, लेकिन उसे अनगिनत बार पढ़ा जा सकता है (जैसे CD-R या DVD-R)।"},"num":59},{"id":"q60","q":{"en":"What is the full form of LIFO and what is a data-structure example?","hi":"LIFO का पूर्ण रूप क्या है और इसका एक डेटा-संरचना उदाहरण (data-structure example) क्या है?"},"a":{"en":"Last In, First Out; in a stack, the last pushed item is popped first. If you push A, B, C, the pop order will be C, B, A.","hi":"लास्ट इन, फर्स्ट आउट; स्टैक (stack) में, सबसे बाद (last) में पुश किया गया आइटम पहले पॉप (pop) होता है। यदि आप A, B, C पुश करते हैं, तो पॉप का क्रम C, B, A होगा।"},"o":[{"en":"List In, File Out; database","hi":"लिस्ट इन, फाइल आउट; डेटाबेस"},{"en":"Last In, First Out; in a stack, the last pushed item is popped first. If you push A, B, C, the pop order will be C, B, A.","hi":"लास्ट इन, फर्स्ट आउट; स्टैक (stack) में, सबसे बाद (last) में पुश किया गया आइटम पहले पॉप (pop) होता है। यदि आप A, B, C पुश करते हैं, तो पॉप का क्रम C, B, A होगा।"},{"en":"Logic Input, Fast Output; CPU cache","hi":"लॉजिक इनपुट, फास्ट आउटपुट; CPU कैश"},{"en":"Long Integer, Float Output; programming","hi":"लॉन्ग इंटीजर, फ्लोट आउटपुट; प्रोग्रामिंग"}],"exp":{"en":"LIFO stands for Last In, First Out. A Stack data structure follows this principle, much like a stack of plates where the last one placed is the first one removed.","hi":"LIFO (लास्ट इन, फर्स्ट आउट) का मतलब है कि जो चीज़ सबसे अंत में आई है, वह सबसे पहले बाहर जाएगी। इसका सबसे अच्छा उदाहरण स्टैक (Stack) डेटा स्ट्रक्चर है।"},"num":60},{"id":"q61","q":{"en":"What is the difference between LIFO and FIFO?","hi":"LIFO और FIFO के बीच क्या अंतर है?"},"a":{"en":"LIFO processes the newest item first (like a stack). FIFO (First In, First Out) processes the oldest item first (like a queue).","hi":"LIFO सबसे नए आइटम को पहले प्रोसेस करता है (स्टैक की तरह)। FIFO (फर्स्ट इन, फर्स्ट आउट) सबसे पुराने आइटम को पहले प्रोसेस करता है (क्यू/queue की तरह)।"},"o":[{"en":"LIFO is for hardware, FIFO is for software","hi":"LIFO हार्डवेयर के लिए है, FIFO सॉफ्टवेयर के लिए है"},{"en":"LIFO processes the newest item first (like a stack). FIFO (First In, First Out) processes the oldest item first (like a queue).","hi":"LIFO सबसे नए आइटम को पहले प्रोसेस करता है (स्टैक की तरह)। FIFO (फर्स्ट इन, फर्स्ट आउट) सबसे पुराने आइटम को पहले प्रोसेस करता है (क्यू/queue की तरह)।"},{"en":"They are two names for the same algorithm","hi":"वे एक ही एल्गोरिथ्म के दो नाम हैं"},{"en":"LIFO is fast, FIFO is slow","hi":"LIFO तेज़ है, FIFO धीमा है"}],"exp":{"en":"LIFO (Last In, First Out) handles the most recent item first. FIFO (First In, First Out) handles items in the order they arrived, like people standing in a line (queue).","hi":"LIFO में सबसे नया डेटा पहले निकलता है (जैसे किताबों का ढेर)। FIFO (First In, First Out) में जो डेटा सबसे पहले आता है, वही सबसे पहले निकलता है (जैसे लाइन/queue में खड़े लोग)।"},"num":61},{"id":"q62","q":{"en":"What is the full form of SAP in the context of business software?","hi":"व्यावसायिक सॉफ्टवेयर (business software) के संदर्भ में SAP का पूर्ण रूप क्या है?"},"a":{"en":"Systems, Applications, and Products in Data Processing. SAP's ERP systems integrate business functions like finance, production, and supply chain.","hi":"सिस्टम्स, एप्लीकेशंस, एंड प्रोडक्ट्स इन डेटा प्रोसेसिंग। SAP के ERP सिस्टम फाइनेंस, प्रोडक्शन और सप्लाई चेन जैसे व्यावसायिक कार्यों को एकीकृत (integrate) करते हैं।"},"o":[{"en":"Software Analytics Program","hi":"सॉफ्टवेयर एनालिटिक्स प्रोग्राम"},{"en":"System Allocation Protocol","hi":"सिस्टम एलोकेशन प्रोटोकॉल"},{"en":"Systems, Applications, and Products in Data Processing. SAP's ERP systems integrate business functions like finance, production, and supply chain.","hi":"सिस्टम्स, एप्लीकेशंस, एंड प्रोडक्ट्स इन डेटा प्रोसेसिंग। SAP के ERP सिस्टम फाइनेंस, प्रोडक्शन और सप्लाई चेन जैसे व्यावसायिक कार्यों को एकीकृत (integrate) करते हैं।"},{"en":"Sales and Production","hi":"सेल्स एंड प्रोडक्शन"}],"exp":{"en":"SAP stands for Systems, Applications, and Products in Data Processing. It is a leading enterprise resource planning (ERP) software that centralizes business management.","hi":"SAP (सिस्टम्स, एप्लीकेशंस, एंड प्रोडक्ट्स इन डेटा प्रोसेसिंग) एक बहुत बड़ी सॉफ्टवेयर कंपनी है जो कंपनियों को अपने व्यापार (पैसे, माल, प्रोडक्शन) को एक ही जगह (ERP सिस्टम) से मैनेज करने में मदद करती है।"},"num":62},{"id":"q63","q":{"en":"What are the full forms of ERP and ICT?","hi":"ERP और ICT का पूर्ण रूप क्या है?"},"a":{"en":"Enterprise Resource Planning; Information and Communication Technology (or Technologies)","hi":"एंटरप्राइज रिसोर्स प्लानिंग; इंफॉर्मेशन एंड कम्युनिकेशन टेक्नोलॉजी (या टेक्नोलॉजीज)"},"o":[{"en":"External Resource Plan; Internet Computer Tool","hi":"एक्सटर्नल रिसोर्स प्लान; इंटरनेट कंप्यूटर टूल"},{"en":"Enterprise Resource Planning; Information and Communication Technology (or Technologies)","hi":"एंटरप्राइज रिसोर्स प्लानिंग; इंफॉर्मेशन एंड कम्युनिकेशन टेक्नोलॉजी (या टेक्नोलॉजीज)"},{"en":"Electronic Record Processing; Internal Communication Transfer","hi":"इलेक्ट्रॉनिक रिकॉर्ड प्रोसेसिंग; इंटरनल कम्युनिकेशन ट्रांसफर"},{"en":"Efficient RAM Protocol; Interactive Computer Terminal","hi":"एफिशिएंट RAM प्रोटोकॉल; इंटरैक्टिव कंप्यूटर टर्मिनल"}],"exp":{"en":"ERP stands for Enterprise Resource Planning (software that manages business processes). ICT stands for Information and Communication Technology.","hi":"ERP का पूर्ण रूप एंटरप्राइज रिसोर्स प्लानिंग (Enterprise Resource Planning) है। ICT का पूर्ण रूप इंफॉर्मेशन एंड कम्युनिकेशन टेक्नोलॉजी (Information and Communication Technology) है।"},"num":63}]},{"title":{"en":"5. Mobile Communication & Indian Script Encoding","hi":"5. मोबाइल संचार और भारतीय लिपि एन्कोडिंग"},"questions":[{"id":"q64","q":{"en":"What is the full form of PDA and what was its common use?","hi":"PDA का पूर्ण रूप क्या है और इसका सामान्य उपयोग क्या था?"},"a":{"en":"Personal Digital Assistant; a handheld organizer or palmtop-type device used for managing contacts, calendars, notes, and email","hi":"पर्सनल डिजिटल असिस्टेंट; एक हैंडहेल्ड ऑर्गेनाइज़र या पामटॉप-प्रकार का उपकरण जिसका उपयोग संपर्क (contacts), कैलेंडर, नोट्स और ईमेल प्रबंधित करने के लिए किया जाता है"},"o":[{"en":"Primary Digital Analyzer; tests networks","hi":"प्राइमरी डिजिटल एनालाइज़र; नेटवर्क का परीक्षण करता है"},{"en":"Public Data Access; a type of internet café","hi":"पब्लिक डेटा एक्सेस; एक प्रकार का इंटरनेट कैफे"},{"en":"Personal Digital Assistant; a handheld organizer or palmtop-type device used for managing contacts, calendars, notes, and email","hi":"पर्सनल डिजिटल असिस्टेंट; एक हैंडहेल्ड ऑर्गेनाइज़र या पामटॉप-प्रकार का उपकरण जिसका उपयोग संपर्क (contacts), कैलेंडर, नोट्स और ईमेल प्रबंधित करने के लिए किया जाता है"},{"en":"Portable Document Archive; a storage drive","hi":"पोर्टेबल डॉक्यूमेंट आर्काइव; एक स्टोरेज ड्राइव"}],"exp":{"en":"PDA stands for Personal Digital Assistant. Before smartphones, PDAs were popular handheld devices used primarily as personal information managers.","hi":"PDA (पर्सनल डिजिटल असिस्टेंट) स्मार्टफोन से पहले इस्तेमाल होने वाले छोटे हैंडहेल्ड कंप्यूटर थे (जैसे पामटॉप), जिनका उपयोग मुख्य रूप से कैलेंडर, नोट्स, ईमेल और कॉन्टैक्ट्स सेव करने के लिए होता था।"},"num":64},{"id":"q65","q":{"en":"What is the full form of SMS?","hi":"SMS का पूर्ण रूप क्या है?"},"a":{"en":"Short Message Service; a service for sending short text messages over mobile networks","hi":"शॉर्ट मैसेज सर्विस; मोबाइल नेटवर्क पर लघु टेक्स्ट संदेश (short text messages) भेजने की एक सेवा"},"o":[{"en":"Short Messaging System","hi":"शॉर्ट मैसेजिंग सिस्टम"},{"en":"Secure Message Service","hi":"सिक्योर मैसेज सर्विस"},{"en":"Short Message Service; a service for sending short text messages over mobile networks","hi":"शॉर्ट मैसेज सर्विस; मोबाइल नेटवर्क पर लघु टेक्स्ट संदेश (short text messages) भेजने की एक सेवा"},{"en":"Simple Mail Service","hi":"सिंपल मेल सर्विस"}],"exp":{"en":"SMS stands for Short Message Service, the globally accepted standard for sending text messages between mobile devices.","hi":"SMS का पूर्ण रूप शॉर्ट मैसेज सर्विस (Short Message Service) है। यह मोबाइल फोन पर टेक्स्ट (मैसेज) भेजने और प्राप्त करने की सुविधा है।"},"num":65},{"id":"q66","q":{"en":"Who is referred to by the exam phrase \"Father of SMS\"?","hi":"परीक्षा वाक्यांश (exam phrase) \"SMS के जनक\" (Father of SMS) से किसे संदर्भित किया जाता है?"},"a":{"en":"Matti Makkonen (This is a popular nickname, though the SMS concept, standardization, and deployment involved multiple contributors)","hi":"मैटी मकोनेन (यह एक लोकप्रिय उपनाम/nickname है, हालाँकि SMS अवधारणा, मानकीकरण और तैनाती में कई योगदानकर्ता शामिल थे)"},"o":[{"en":"Tim Berners-Lee","hi":"Tim Berners-Lee"},{"en":"Steve Jobs","hi":"Steve Jobs"},{"en":"Matti Makkonen (This is a popular nickname, though the SMS concept, standardization, and deployment involved multiple contributors)","hi":"मैटी मकोनेन (यह एक लोकप्रिय उपनाम/nickname है, हालाँकि SMS अवधारणा, मानकीकरण और तैनाती में कई योगदानकर्ता शामिल थे)"},{"en":"Bill Gates","hi":"Bill Gates"}],"exp":{"en":"Matti Makkonen, a Finnish engineer, is often nicknamed the 'Father of SMS' for his early work pitching the idea of text messaging over cellular networks.","hi":"फिनलैंड के इंजीनियर मैटी मकोनेन (Matti Makkonen) को अक्सर 'SMS का जनक' कहा जाता है, क्योंकि उन्होंने ही सबसे पहले मोबाइल पर टेक्स्ट मैसेज भेजने का विचार दिया था।"},"num":66},{"id":"q67","q":{"en":"What is the standard full form and role of SIM?","hi":"SIM का मानक पूर्ण रूप और भूमिका क्या है?"},"a":{"en":"Subscriber Identity Module; it stores subscriber credentials and a secret authentication key to help with identity/authentication on a mobile network. ('Subscriber Identification Module' is an alternate wording found in notes.)","hi":"सब्सक्राइबर आइडेंटिटी मॉड्यूल; यह मोबाइल नेटवर्क पर पहचान/प्रमाणीकरण में मदद करने के लिए ग्राहक क्रेडेंशियल्स (credentials) और एक गुप्त प्रमाणीकरण कुंजी (secret authentication key) संग्रहीत करता है। (नोट्स में 'सब्सक्राइबर आइडेंटिफिकेशन मॉड्यूल' एक वैकल्पिक शब्द है।)"},"o":[{"en":"Secure Internet Modem; provides Wi-Fi","hi":"सिक्योर इंटरनेट मॉडेम; वाई-फाई प्रदान करता है"},{"en":"Subscriber Identity Module; it stores subscriber credentials and a secret authentication key to help with identity/authentication on a mobile network. ('Subscriber Identification Module' is an alternate wording found in notes.)","hi":"सब्सक्राइबर आइडेंटिटी मॉड्यूल; यह मोबाइल नेटवर्क पर पहचान/प्रमाणीकरण में मदद करने के लिए ग्राहक क्रेडेंशियल्स (credentials) और एक गुप्त प्रमाणीकरण कुंजी (secret authentication key) संग्रहीत करता है। (नोट्स में 'सब्सक्राइबर आइडेंटिफिकेशन मॉड्यूल' एक वैकल्पिक शब्द है।)"},{"en":"Simple Information Memory; stores photos","hi":"सिंपल इंफॉर्मेशन मेमोरी; तस्वीरें संग्रहीत करता है"},{"en":"Serial Interface Module; connects USBs","hi":"सीरियल इंटरफ़ेस मॉड्यूल; USB को जोड़ता है"}],"exp":{"en":"SIM stands for Subscriber Identity Module. It securely stores the international mobile subscriber identity (IMSI) number and its related key, which are used to identify and authenticate subscribers on mobile telephony devices.","hi":"SIM (सब्सक्राइबर आइडेंटिटी मॉड्यूल) एक छोटी सी चिप होती है जो आपकी (ग्राहक की) पहचान और एक गुप्त चाबी (key) स्टोर करती है, ताकि मोबाइल नेटवर्क आपको पहचान सके।"},"num":67},{"id":"q68","q":{"en":"What is the full form and role of IMSI?","hi":"IMSI का पूर्ण रूप और भूमिका क्या है?"},"a":{"en":"International Mobile Subscriber Identity; an identifier used to identify a mobile subscription, which can be stored in a SIM profile","hi":"इंटरनेशनल मोबाइल सब्सक्राइबर आइडेंटिटी; एक पहचानकर्ता (identifier) जिसका उपयोग मोबाइल सदस्यता (subscription) को पहचानने के लिए किया जाता है, जिसे SIM प्रोफ़ाइल में संग्रहीत किया जा सकता है"},"o":[{"en":"Internal Mobile System Interface; UI for phones","hi":"इंटरनल मोबाइल सिस्टम इंटरफ़ेस; फोन के लिए UI"},{"en":"Internet Message Sending Information; email tracking","hi":"इंटरनेट मैसेज सेंडिंग इंफॉर्मेशन; ईमेल ट्रैकिंग"},{"en":"International Mobile Subscriber Identity; an identifier used to identify a mobile subscription, which can be stored in a SIM profile","hi":"इंटरनेशनल मोबाइल सब्सक्राइबर आइडेंटिटी; एक पहचानकर्ता (identifier) जिसका उपयोग मोबाइल सदस्यता (subscription) को पहचानने के लिए किया जाता है, जिसे SIM प्रोफ़ाइल में संग्रहीत किया जा सकता है"},{"en":"Integrated Media Streaming Interface; plays music","hi":"इंटीग्रेटेड मीडिया स्ट्रीमिंग इंटरफ़ेस; संगीत चलाता है"}],"exp":{"en":"IMSI (International Mobile Subscriber Identity) is a unique number, usually fifteen digits, associated with all GSM and UMTS network mobile phone users.","hi":"IMSI (इंटरनेशनल मोबाइल सब्सक्राइबर आइडेंटिटी) एक विशिष्ट (unique) 15-अंकों का नंबर है जो दुनिया भर में मोबाइल नेटवर्क पर हर एक ग्राहक (SIM) की अलग पहचान करता है।"},"num":68},{"id":"q69","q":{"en":"What is the full form of GSM and what is its use?","hi":"GSM का पूर्ण रूप क्या है और इसका उपयोग क्या है?"},"a":{"en":"Global System for Mobile Communications; a digital cellular standards family supporting mobile voice, messaging, and data over a base-station network","hi":"ग्लोबल सिस्टम फॉर मोबाइल कम्युनिकेशंस; बेस-स्टेशन नेटवर्क पर मोबाइल वॉयस, मैसेजिंग और डेटा का समर्थन करने वाला एक डिजिटल सेल्युलर मानक परिवार (standards family)"},"o":[{"en":"Global System for Mobile Communications; a digital cellular standards family supporting mobile voice, messaging, and data over a base-station network","hi":"ग्लोबल सिस्टम फॉर मोबाइल कम्युनिकेशंस; बेस-स्टेशन नेटवर्क पर मोबाइल वॉयस, मैसेजिंग और डेटा का समर्थन करने वाला एक डिजिटल सेल्युलर मानक परिवार (standards family)"},{"en":"General Secure Messaging; for encrypted texts","hi":"जनरल सिक्योर मैसेजिंग; एन्क्रिप्टेड टेक्स्ट के लिए"},{"en":"Graphical System Memory; for playing games","hi":"ग्राफिकल सिस्टम मेमोरी; गेम खेलने के लिए"},{"en":"Gigabit Speed Modem; a type of fast internet","hi":"गीगाबिट स्पीड मोडेम; एक प्रकार का तेज़ इंटरनेट"}],"exp":{"en":"GSM (Global System for Mobile Communications) is the standard developed by ETSI to describe the protocols for second-generation (2G) digital cellular networks used by mobile devices.","hi":"GSM (ग्लोबल सिस्टम फॉर मोबाइल कम्युनिकेशंस) मोबाइल फोन संचार के लिए एक अंतरराष्ट्रीय डिजिटल मानक (standard) है, जो कॉलिंग, SMS और डेटा की सुविधा देता है।"},"num":69},{"id":"q70","q":{"en":"What is the full form of GPRS and its relationship with GSM?","hi":"GPRS का पूर्ण रूप क्या है और GSM के साथ इसका क्या संबंध है?"},"a":{"en":"General Packet Radio Service; a packet-switched mobile data service on GSM networks, commonly referred to as a 2.5G revision","hi":"जनरल पैकेट रेडियो सर्विस; GSM नेटवर्क पर एक पैकेट-स्विच्ड मोबाइल डेटा सेवा, जिसे आमतौर पर 2.5G संशोधन (revision) के रूप में संदर्भित किया जाता है"},"o":[{"en":"General Public Radio System; a radio station","hi":"जनरल पब्लिक रेडियो सिस्टम; एक रेडियो स्टेशन"},{"en":"Global Positioning Radar Satellite; maps locations","hi":"ग्लोबल पोजिशनिंग रडार सैटेलाइट; स्थानों का नक्शा बनाता है"},{"en":"General Packet Radio Service; a packet-switched mobile data service on GSM networks, commonly referred to as a 2.5G revision","hi":"जनरल पैकेट रेडियो सर्विस; GSM नेटवर्क पर एक पैकेट-स्विच्ड मोबाइल डेटा सेवा, जिसे आमतौर पर 2.5G संशोधन (revision) के रूप में संदर्भित किया जाता है"},{"en":"Gigabit Phone Relay Service; used for 4G calls","hi":"गीगाबिट फोन रिले सर्विस; 4G कॉल के लिए उपयोग किया जाता है"}],"exp":{"en":"GPRS (General Packet Radio Service) is a best-effort packet switching protocol for wireless and cellular network communication services, adding data capabilities to GSM networks (often called 2.5G).","hi":"GPRS (जनरल पैकेट रेडियो सर्विस) पुरानी GSM तकनीक (2G) में जोड़ा गया एक सुधार था (जिसे 2.5G कहते हैं), जिसने मोबाइल फोन पर इंटरनेट (डेटा) चलाना संभव बनाया।"},"num":70},{"id":"q71","q":{"en":"What is the full form of ISCII, its BIS standard number, and its year?","hi":"ISCII का पूर्ण रूप, इसकी BIS मानक (standard) संख्या और इसका वर्ष क्या है?"},"a":{"en":"Indian Standard Code for Information Interchange; IS 13194:1991 from the Bureau of Indian Standards. ('Indian Script Code for Information Interchange' is also found as an expanded form.)","hi":"इंडियन स्टैंडर्ड कोड फॉर इंफॉर्मेशन इंटरचेंज; भारतीय मानक ब्यूरो (BIS) का IS 13194:1991। ('इंडियन स्क्रिप्ट कोड फॉर इंफॉर्मेशन इंटरचेंज' भी एक विस्तारित रूप के रूप में पाया जाता है।)"},"o":[{"en":"International Standard Code for Indian Information; IS 2000:1995","hi":"इंटरनेशनल स्टैंडर्ड कोड फॉर इंडियन इंफॉर्मेशन; IS 2000:1995"},{"en":"Indian Script Code for Internet Integration; IS 1000:2000","hi":"इंडियन स्क्रिप्ट कोड फॉर इंटरनेट इंटीग्रेशन; IS 1000:2000"},{"en":"Indian Standard Code for Information Interchange; IS 13194:1991 from the Bureau of Indian Standards. ('Indian Script Code for Information Interchange' is also found as an expanded form.)","hi":"इंडियन स्टैंडर्ड कोड फॉर इंफॉर्मेशन इंटरचेंज; भारतीय मानक ब्यूरो (BIS) का IS 13194:1991। ('इंडियन स्क्रिप्ट कोड फॉर इंफॉर्मेशन इंटरचेंज' भी एक विस्तारित रूप के रूप में पाया जाता है।)"},{"en":"Inter-State Code for Information Interchange; IS 500:1990","hi":"इंटर-स्टेट कोड फॉर इंफॉर्मेशन इंटरचेंज; IS 500:1990"}],"exp":{"en":"ISCII (Indian Standard/Script Code for Information Interchange) is an encoding scheme for representing various Indian scripts, standardized by BIS in 1991 (IS 13194:1991).","hi":"ISCII का पूर्ण रूप 'इंडियन स्टैंडर्ड कोड फॉर इंफॉर्मेशन इंटरचेंज' है। यह भारतीय लिपियों को कंप्यूटर पर लिखने के लिए भारतीय मानक ब्यूरो (BIS) द्वारा 1991 में जारी किया गया मानक (IS 13194:1991) है।"},"num":71},{"id":"q72","q":{"en":"What type of data does ISCII encode?","hi":"ISCII किस प्रकार के डेटा को एन्कोड करता है?"},"a":{"en":"It supports major Indian scripts and Roman transliteration. It is an 8-bit code with 256 possible byte values. Multiple scripts are represented through script selection.","hi":"यह प्रमुख भारतीय लिपियों और रोमन लिप्यंतरण (transliteration) का समर्थन करता है। यह 256 संभावित बाइट मानों के साथ एक 8-बिट कोड है। स्क्रिप्ट चयन (script selection) के माध्यम से कई लिपियों का प्रतिनिधित्व किया जाता है।"},"o":[{"en":"It only encodes English letters","hi":"यह केवल अंग्रेजी अक्षरों को एन्कोड करता है"},{"en":"It only encodes emojis","hi":"यह केवल इमोजी को एन्कोड करता है"},{"en":"It supports major Indian scripts and Roman transliteration. It is an 8-bit code with 256 possible byte values. Multiple scripts are represented through script selection.","hi":"यह प्रमुख भारतीय लिपियों और रोमन लिप्यंतरण (transliteration) का समर्थन करता है। यह 256 संभावित बाइट मानों के साथ एक 8-बिट कोड है। स्क्रिप्ट चयन (script selection) के माध्यम से कई लिपियों का प्रतिनिधित्व किया जाता है।"},{"en":"It encodes video files","hi":"यह वीडियो फ़ाइलों को एन्कोड करता है"}],"exp":{"en":"ISCII is an 8-bit encoding (256 values) that retains the lower 128 ASCII characters and maps the upper 128 to Indian scripts (like Devanagari, Bengali, Gujarati, etc.).","hi":"ISCII एक 8-बिट कोड है, जो कंप्यूटर को भारत की प्रमुख लिपियों (जैसे देवनागरी, बंगाली, तमिल) और रोमन (अंग्रेज़ी) दोनों को एक साथ समझने की सुविधा देता है।"},"num":72},{"id":"q73","q":{"en":"What is the quick distinction between ASCII and ISCII?","hi":"ASCII और ISCII के बीच त्वरित अंतर (quick distinction) क्या है?"},"a":{"en":"Standard ASCII is 7-bit (used globally for English). ISCII is an 8-bit scheme specifically designed for the representation of Indian scripts.","hi":"स्टैंडर्ड ASCII 7-बिट है (अंग्रेजी के लिए विश्व स्तर पर उपयोग किया जाता है)। ISCII एक 8-बिट योजना (scheme) है जिसे विशेष रूप से भारतीय लिपियों के प्रतिनिधित्व के लिए डिज़ाइन किया गया है।"},"o":[{"en":"ASCII is for Mac, ISCII is for Windows","hi":"ASCII Mac के लिए है, ISCII Windows के लिए है"},{"en":"Standard ASCII is 7-bit (used globally for English). ISCII is an 8-bit scheme specifically designed for the representation of Indian scripts.","hi":"स्टैंडर्ड ASCII 7-बिट है (अंग्रेजी के लिए विश्व स्तर पर उपयोग किया जाता है)। ISCII एक 8-बिट योजना (scheme) है जिसे विशेष रूप से भारतीय लिपियों के प्रतिनिधित्व के लिए डिज़ाइन किया गया है।"},{"en":"They are exactly the same","hi":"वे बिल्कुल समान हैं"},{"en":"ASCII is 8-bit, ISCII is 7-bit","hi":"ASCII 8-बिट है, ISCII 7-बिट है"}],"exp":{"en":"Standard ASCII uses 7 bits for basic English text and symbols. ISCII uses 8 bits, leveraging the extra space to accommodate the phonetic alphabet structure of Indian languages.","hi":"मूल ASCII एक 7-बिट कोड है जो अंग्रेज़ी अक्षरों के लिए है। जबकि ISCII एक 8-बिट कोड है जिसे ख़ास तौर पर भारतीय भाषाओं (लिपियों) को कंप्यूटर पर लिखने के लिए बनाया गया है।"},"num":73}]},{"title":{"en":"6. Exam Trap Reverse-Questions","hi":"6. परीक्षा के महत्वपूर्ण उल्टे प्रश्न"},"questions":[{"id":"q74","q":{"en":"The 3–3–3 pattern of city–bank–branch is a clue for which code?","hi":"शहर-बैंक-शाखा (city-bank-branch) का 3-3-3 पैटर्न किस कोड का सुराग (clue) है?"},"a":{"en":"Indian cheque's MICR code","hi":"भारतीय चेक का MICR कोड"},"o":[{"en":"IFSC Code","hi":"IFSC Code"},{"en":"Indian cheque's MICR code","hi":"भारतीय चेक का MICR कोड"},{"en":"Credit Card Number","hi":"Credit Card Number"},{"en":"Postal PIN code","hi":"Postal PIN code"}],"exp":{"en":"The 9-digit MICR code on Indian cheques is structurally divided into three parts: City (3), Bank (3), and Branch (3).","hi":"भारतीय चेकों पर मौजूद 9 अंकों का MICR कोड 3-3-3 (शहर, बैंक, शाखा) के रूप में विभाजित होता है।"},"num":74},{"id":"q75","q":{"en":"Which pair handles the global coordination of Internet identifiers and household connectivity respectively?","hi":"कौन सा जोड़ा क्रमशः इंटरनेट आइडेंटिफायर्स के वैश्विक समन्वय (global coordination) और घरेलू कनेक्टिविटी (household connectivity) को संभालता है?"},"a":{"en":"Global identifiers → IANA. Household connectivity → ISP.","hi":"वैश्विक आइडेंटिफायर्स → IANA। घरेलू कनेक्टिविटी → ISP।"},"o":[{"en":"Global identifiers → IANA. Household connectivity → ISP.","hi":"वैश्विक आइडेंटिफायर्स → IANA। घरेलू कनेक्टिविटी → ISP।"},{"en":"Global identifiers → DNS. Household connectivity → DHCP.","hi":"Global identifiers → DNS. Household connectivity → DHCP."},{"en":"Global identifiers → HTTP. Household connectivity → FTP.","hi":"Global identifiers → HTTP. Household connectivity → FTP."},{"en":"Global identifiers → ISP. Household connectivity → IANA.","hi":"Global identifiers → ISP. Household connectivity → IANA."}],"exp":{"en":"IANA manages global assignments (IPs, DNS root). ISPs are the companies providing direct internet connections to homes.","hi":"IANA इंटरनेट के ग्लोबल एड्रेस (IP/DNS) को कंट्रोल करता है, जबकि ISP (इंटरनेट सर्विस प्रोवाइडर) आपके घर में इंटरनेट का कनेक्शन देता है।"},"num":75},{"id":"q76","q":{"en":"What is the matching for 'assigns a subnet mask' and 'resolves a hostname'?","hi":"'एक सबनेट मास्क असाइन करता है' और 'एक होस्टनाम को रिज़ॉल्व करता है' का मिलान क्या है?"},"a":{"en":"DHCP can assign a subnet mask. DNS resolves a hostname.","hi":"DHCP एक सबनेट मास्क असाइन कर सकता है। DNS एक होस्टनाम को रिज़ॉल्व (resolve) करता है।"},"o":[{"en":"DHCP can assign a subnet mask. DNS resolves a hostname.","hi":"DHCP एक सबनेट मास्क असाइन कर सकता है। DNS एक होस्टनाम को रिज़ॉल्व (resolve) करता है।"},{"en":"DNS assigns a subnet mask. DHCP resolves a hostname.","hi":"DNS assigns a subnet mask. DHCP resolves a hostname."},{"en":"FTP assigns a subnet mask. HTTP resolves a hostname.","hi":"FTP assigns a subnet mask. HTTP resolves a hostname."},{"en":"TCP assigns a subnet mask. IP resolves a hostname.","hi":"TCP assigns a subnet mask. IP resolves a hostname."}],"exp":{"en":"DHCP provides network configuration (IP, subnet mask) to clients. DNS translates human-readable hostnames to IP addresses.","hi":"नेटवर्क में जुड़ते ही DHCP कंप्यूटर को उसका IP और सबनेट मास्क देता है। DNS किसी वेबसाइट के नाम (hostname) से उसका IP पता खोजता है।"},"num":76},{"id":"q77","q":{"en":"If you remove the protocol and path from a URL and are left with only the complete DNS hostname, what is the term for it?","hi":"यदि आप URL से प्रोटोकॉल और पाथ को हटा देते हैं और केवल पूरा DNS होस्टनाम बचता है, तो उसके लिए क्या शब्द है?"},"a":{"en":"FQDN / FQDN","hi":"FQDN / FQDN"},"o":[{"en":"FQDN / FQDN","hi":"FQDN / FQDN"},{"en":"IP Address","hi":"IP Address"},{"en":"TLD (Top Level Domain)","hi":"TLD (Top Level Domain)"},{"en":"HTTP","hi":"HTTP"}],"exp":{"en":"A Fully Qualified Domain Name (FQDN) is the absolute domain name (e.g., www.example.com) without the scheme (https://) or path (/page).","hi":"URL में से 'https://' और आगे का रास्ता हटा देने पर जो कंप्यूटर का पूरा नाम (जैसे www.google.com) बचता है, उसे FQDN (फुली क्वालिफाइड डोमेन नेम) कहते हैं।"},"num":77},{"id":"q78","q":{"en":"'Optical fibre to the customer premises' and 'TCP 21 control' are clues for which pair?","hi":"'ग्राहक परिसर (customer premises) तक ऑप्टिकल फाइबर' और 'TCP 21 कंट्रोल' किस जोड़ी के सुराग हैं?"},"a":{"en":"FTTP and FTP respectively","hi":"क्रमशः FTTP और FTP"},"o":[{"en":"FTTP and FTP respectively","hi":"क्रमशः FTTP और FTP"},{"en":"HTTP and HTTPS respectively","hi":"HTTP and HTTPS respectively"},{"en":"LAN and WAN respectively","hi":"LAN and WAN respectively"},{"en":"Wi-Fi and Bluetooth respectively","hi":"Wi-Fi and Bluetooth respectively"}],"exp":{"en":"FTTP (Fiber to the Premises) provides direct fiber broadband. FTP (File Transfer Protocol) uses TCP port 21 for its control connection.","hi":"घर तक फाइबर तार बिछाने को FTTP (फाइबर टू द प्रिमाइसेज़) कहते हैं। फाइल भेजने वाले प्रोटोकॉल FTP में पोर्ट 21 का उपयोग कंट्रोल (कमांड) के लिए होता है।"},"num":78},{"id":"q79","q":{"en":"IEEE 802.16 and a token-passing dual ring are clues for which technologies?","hi":"IEEE 802.16 और एक टोकन-पासिंग डुअल रिंग (token-passing dual ring) किन तकनीकों के सुराग हैं?"},"a":{"en":"IEEE 802.16 → WiMAX. Token-passing dual ring → FDDI.","hi":"IEEE 802.16 → WiMAX। टोकन-पासिंग डुअल रिंग → FDDI।"},"o":[{"en":"IEEE 802.16 → Wi-Fi. Token-passing dual ring → Ethernet.","hi":"IEEE 802.16 → Wi-Fi. Token-passing dual ring → Ethernet."},{"en":"IEEE 802.16 → WiMAX. Token-passing dual ring → FDDI.","hi":"IEEE 802.16 → WiMAX। टोकन-पासिंग डुअल रिंग → FDDI।"},{"en":"IEEE 802.16 → Bluetooth. Token-passing dual ring → USB.","hi":"IEEE 802.16 → Bluetooth. Token-passing dual ring → USB."},{"en":"IEEE 802.16 → 5G. Token-passing dual ring → CDMA.","hi":"IEEE 802.16 → 5G. Token-passing dual ring → CDMA."}],"exp":{"en":"WiMAX is based on the IEEE 802.16 broadband standard. FDDI is a legacy LAN technology that uses a token-passing dual-ring topology.","hi":"लंबी दूरी के वायरलेस ब्रॉडबैंड WiMAX का मानक IEEE 802.16 है। FDDI एक पुरानी नेटवर्क तकनीक है जो फाइबर ऑप्टिक केबल और दो-रिंग (dual ring) का उपयोग करती है।"},"num":79},{"id":"q80","q":{"en":"Which similar acronyms correspond to memory-bus bandwidth and remote-memory transfer respectively?","hi":"कौन से समान संक्षिप्ताक्षर (acronyms) क्रमशः मेमोरी-बस बैंडविड्थ और रिमोट-मेमोरी ट्रांसफर से मेल खाते हैं?"},"a":{"en":"RDRAM and RDMA respectively","hi":"क्रमशः RDRAM और RDMA"},"o":[{"en":"RAM and ROM","hi":"RAM and ROM"},{"en":"HTTP and HTML","hi":"HTTP and HTML"},{"en":"RDRAM and RDMA respectively","hi":"क्रमशः RDRAM और RDMA"},{"en":"SRAM and DRAM","hi":"SRAM and DRAM"}],"exp":{"en":"RDRAM (Rambus DRAM) is a high-bandwidth memory architecture. RDMA (Remote Direct Memory Access) allows direct memory transfers over a network.","hi":"तेज़ मेमोरी चिप का नाम RDRAM है। जबकि नेटवर्क पर सीधे मेमोरी से मेमोरी में डेटा ट्रांसफर करने की तकनीक को RDMA कहते हैं।"},"num":80},{"id":"q81","q":{"en":"If the original workbook of an embedded Excel chart is deleted, will the document still have a copy?","hi":"यदि एम्बेडेड Excel चार्ट (embedded Excel chart) की मूल कार्यपुस्तिका (original workbook) हटा दी जाती है, तो क्या दस्तावेज़ में अभी भी एक प्रति (copy) रहेगी?"},"a":{"en":"Yes, the embedded object is stored entirely within the document. A linked chart, however, depends on the original workbook.","hi":"हाँ, एम्बेडेड ऑब्जेक्ट पूरी तरह से दस्तावेज़ के भीतर संग्रहीत होता है। हालाँकि, एक लिंक्ड (linked) चार्ट, मूल कार्यपुस्तिका पर निर्भर करता है।"},"o":[{"en":"No, it will disappear","hi":"नहीं, यह गायब हो जाएगा"},{"en":"Yes, the embedded object is stored entirely within the document. A linked chart, however, depends on the original workbook.","hi":"हाँ, एम्बेडेड ऑब्जेक्ट पूरी तरह से दस्तावेज़ के भीतर संग्रहीत होता है। हालाँकि, एक लिंक्ड (linked) चार्ट, मूल कार्यपुस्तिका पर निर्भर करता है।"},{"en":"It will turn into plain text","hi":"यह प्लेन टेक्स्ट में बदल जाएगा"},{"en":"Only the colors will remain","hi":"केवल रंग रहेंगे"}],"exp":{"en":"In OLE (Object Linking and Embedding), an embedded object is physically copied into the destination file. Deleting the source file does not break the embedded object (unlike a linked object).","hi":"चूँकि एम्बेडेड (Embedded) ऑब्जेक्ट की पूरी कॉपी वर्ड फाइल के अंदर ही सेव हो जाती है, इसलिए अगर आप ओरिजिनल एक्सेल फाइल डिलीट भी कर दें, तो वर्ड फाइल में वह चार्ट सुरक्षित रहेगा।"},"num":81},{"id":"q82","q":{"en":"What is the clue for an 8-bit encoding for Indian scripts and a 1991 BIS standard?","hi":"भारतीय लिपियों के लिए 8-बिट एन्कोडिंग और 1991 BIS मानक का सुराग (clue) क्या है?"},"a":{"en":"ISCII / ISCII","hi":"ISCII / ISCII"},"o":[{"en":"ASCII","hi":"ASCII"},{"en":"Unicode","hi":"Unicode"},{"en":"ISCII / ISCII","hi":"ISCII / ISCII"},{"en":"UTF-8","hi":"UTF-8"}],"exp":{"en":"ISCII (Indian Standard Code for Information Interchange) is an 8-bit encoding scheme adopted by the Bureau of Indian Standards in 1991.","hi":"ISCII एक 8-बिट कोड है जिसे 1991 में भारतीय मानक ब्यूरो (BIS) द्वारा भारत की विभिन्न लिपियों को कंप्यूटर पर लिखने के लिए प्रमाणित किया गया था।"},"num":82}]},{"title":{"en":"7. Rapid-Fire Final Revision","hi":"7. त्वरित अंतिम पुनरावृत्ति"},"questions":[{"id":"q83","q":{"en":"What is the technology acronym for a 9-digit cheque code?","hi":"9-अंकीय चेक कोड के लिए प्रौद्योगिकी (technology) का संक्षिप्त नाम क्या है?"},"a":{"en":"MICR / MICR","hi":"MICR / MICR"},"o":[{"en":"MICR / MICR","hi":"MICR / MICR"},{"en":"OCR","hi":"OCR"},{"en":"OMR","hi":"OMR"},{"en":"Barcode","hi":"Barcode"}],"exp":{"en":"The 9-digit code on cheques is processed using MICR (Magnetic Ink Character Recognition).","hi":"चेक पर 9-अंकों का कोड MICR तकनीक का उपयोग करके पढ़ा जाता है।"},"num":83},{"id":"q84","q":{"en":"What is the acronym for improving organic search visibility?","hi":"ऑर्गेनिक सर्च विज़िबिलिटी (organic search visibility) में सुधार के लिए संक्षिप्त नाम क्या है?"},"a":{"en":"SEO / SEO","hi":"SEO / SEO"},"o":[{"en":"URL","hi":"URL"},{"en":"SEO / SEO","hi":"SEO / SEO"},{"en":"HTTP","hi":"HTTP"},{"en":"FQDN","hi":"FQDN"}],"exp":{"en":"Search Engine Optimization (SEO) improves a website's visibility in unpaid search results.","hi":"सर्च इंजन (जैसे Google) पर बिना पैसे दिए वेबसाइट को ऊपर लाने की प्रक्रिया को SEO (सर्च इंजन ऑप्टिमाइजेशन) कहते हैं।"},"num":84},{"id":"q85","q":{"en":"What is the protocol for dynamically allocating network settings?","hi":"नेटवर्क सेटिंग्स को गतिशील रूप से आवंटित (dynamically allocating) करने के लिए प्रोटोकॉल क्या है?"},"a":{"en":"DHCP / DHCP","hi":"DHCP / DHCP"},"o":[{"en":"DNS","hi":"DNS"},{"en":"FTP","hi":"FTP"},{"en":"DHCP / DHCP","hi":"DHCP / DHCP"},{"en":"TCP","hi":"TCP"}],"exp":{"en":"DHCP (Dynamic Host Configuration Protocol) automatically assigns IP addresses.","hi":"कंप्यूटर/फोन को नेटवर्क से जुड़ते ही अपने आप IP एड्रेस देने का काम DHCP करता है।"},"num":85},{"id":"q86","q":{"en":"What is the SQL category for changing database structure?","hi":"डेटाबेस संरचना (structure) को बदलने के लिए SQL श्रेणी (category) क्या है?"},"a":{"en":"DDL / DDL","hi":"DDL / DDL"},"o":[{"en":"DDL / DDL","hi":"DDL / DDL"},{"en":"DML","hi":"DML"},{"en":"DCL","hi":"DCL"},{"en":"TCL","hi":"TCL"}],"exp":{"en":"Data Definition Language (DDL) is used to define or change the database schema.","hi":"डेटाबेस का ढाँचा (schema) बदलने के लिए SQL में DDL (Data Definition Language) कमांड्स का उपयोग होता है।"},"num":86},{"id":"q87","q":{"en":"What is a UI with classic text commands called?","hi":"क्लासिक टेक्स्ट कमांड वाले UI को क्या कहा जाता है?"},"a":{"en":"CLI / CLI","hi":"CLI / CLI"},"o":[{"en":"GUI","hi":"GUI"},{"en":"VDU","hi":"VDU"},{"en":"CLI / CLI","hi":"CLI / CLI"},{"en":"VR","hi":"VR"}],"exp":{"en":"A Command Line Interface (CLI) relies on text input to execute commands.","hi":"कंप्यूटर को टाइप करके (टेक्स्ट कमांड से) निर्देश देने वाले इंटरफेस को CLI (Command Line Interface) कहते हैं।"},"num":87},{"id":"q88","q":{"en":"What is the acronym for digital telephone standards carrying voice and data?","hi":"वॉयस और डेटा ले जाने वाले डिजिटल टेलीफोन मानकों (standards) के लिए संक्षिप्त नाम क्या है?"},"a":{"en":"ISDN / ISDN","hi":"ISDN / ISDN"},"o":[{"en":"PSTN","hi":"PSTN"},{"en":"LAN","hi":"LAN"},{"en":"ISDN / ISDN","hi":"ISDN / ISDN"},{"en":"VoIP","hi":"VoIP"}],"exp":{"en":"ISDN stands for Integrated Services Digital Network.","hi":"ISDN का अर्थ इंटीग्रेटेड सर्विसेज डिजिटल नेटवर्क है।"},"num":88},{"id":"q89","q":{"en":"What is the acronym for write-once storage?","hi":"राइट-वन्स (write-once) स्टोरेज के लिए संक्षिप्त नाम क्या है?"},"a":{"en":"WORM / WORM","hi":"WORM / WORM"},"o":[{"en":"RAM","hi":"RAM"},{"en":"WORM / WORM","hi":"WORM / WORM"},{"en":"Flash","hi":"Flash"},{"en":"ROM","hi":"ROM"}],"exp":{"en":"WORM stands for Write Once, Read Many.","hi":"WORM (Write Once, Read Many) एक ऐसी स्टोरेज है जिसमें केवल एक बार डेटा लिखा जा सकता है।"},"num":89},{"id":"q90","q":{"en":"What is the processing rule of a stack?","hi":"स्टैक (stack) का प्रोसेसिंग नियम क्या है?"},"a":{"en":"LIFO / LIFO","hi":"LIFO / LIFO"},"o":[{"en":"FIFO","hi":"FIFO"},{"en":"Random","hi":"Random"},{"en":"LIFO / LIFO","hi":"LIFO / LIFO"},{"en":"Sequential","hi":"Sequential"}],"exp":{"en":"A stack follows the Last In, First Out (LIFO) principle.","hi":"स्टैक LIFO (लास्ट इन, फर्स्ट आउट) नियम पर काम करता है।"},"num":90},{"id":"q91","q":{"en":"What is the packet-switched GSM data service called?","hi":"पैकेट-स्विच्ड GSM डेटा सेवा को क्या कहा जाता है?"},"a":{"en":"GPRS / GPRS","hi":"GPRS / GPRS"},"o":[{"en":"SMS","hi":"SMS"},{"en":"CDMA","hi":"CDMA"},{"en":"WiMAX","hi":"WiMAX"},{"en":"GPRS / GPRS","hi":"GPRS / GPRS"}],"exp":{"en":"GPRS (General Packet Radio Service) provides packet-switched data on GSM networks.","hi":"GSM नेटवर्क पर इंटरनेट (डेटा) चलाने की सेवा को GPRS कहते हैं।"},"num":91},{"id":"q92","q":{"en":"What is the NPCI app for digital payments?","hi":"डिजिटल भुगतान के लिए NPCI का ऐप कौन सा है?"},"a":{"en":"BHIM / BHIM","hi":"BHIM / BHIM"},"o":[{"en":"PayTM","hi":"PayTM"},{"en":"BHIM / BHIM","hi":"BHIM / BHIM"},{"en":"PayPal","hi":"PayPal"},{"en":"PhonePe","hi":"PhonePe"}],"exp":{"en":"BHIM (Bharat Interface for Money) is NPCI's official UPI-based payment application.","hi":"NPCI द्वारा बनाया गया डिजिटल भुगतान ऐप BHIM है।"},"num":92},{"id":"q93","q":{"en":"What is the portable page-layout document format?","hi":"पोर्टेबल पेज-लेआउट दस्तावेज़ प्रारूप (document format) क्या है?"},"a":{"en":"PDF / PDF","hi":"PDF / PDF"},"o":[{"en":"DOCX","hi":"DOCX"},{"en":"HTML","hi":"HTML"},{"en":"PDF / PDF","hi":"PDF / PDF"},{"en":"TXT","hi":"TXT"}],"exp":{"en":"PDF (Portable Document Format) is designed for consistent page layout presentation.","hi":"दस्तावेज़ों का लेआउट हर जगह समान दिखाने के लिए PDF (पोर्टेबल डॉक्यूमेंट फॉर्मेट) का उपयोग किया जाता है।"},"num":93}]}],"13. Zoho, Data Sovereignty & DBMS":[{"title":{"en":"1. Zoho — Origin, Founders & Leadership","hi":"1. ज़ोहो — उत्पत्ति, संस्थापक और नेतृत्व"},"questions":[{"q":{"en":"Under what name, when, and where was Zoho started?","hi":"ज़ोहो की शुरुआत किस नाम से, कब और कहाँ हुई थी?"},"o":[{"en":"WebEx Inc., 1995, California","hi":"वेबएक्स इंक., 1995, कैलिफोर्निया"},{"en":"AdventNet Inc., 1996, New Jersey","hi":"एडवेंटनेट इंक., 1996, न्यू जर्सी"},{"en":"Zoho Corp, 2000, Chennai","hi":"ज़ोहो कॉर्प, 2000, चेन्नई"},{"en":"ManageEngine, 2005, Texas","hi":"मैनेजइंजन, 2005, टेक्सास"}],"a":{"en":"AdventNet Inc., 1996, New Jersey","hi":"एडवेंटनेट इंक., 1996, न्यू जर्सी"},"exp":{"en":"According to Zoho's official timeline, it started as AdventNet Inc. in 1996 in New Jersey, USA, with an early focus on network management. It also had early engineering roots in Chennai.\nSource-note (Hinglish): Zoho ki official timeline ke mutabik AdventNet Inc. 1996 mein New Jersey, USA mein shuru hui. Early focus network management tha. Chennai mein early engineering roots bhi the.","hi":"ज़ोहो की आधिकारिक टाइमलाइन के अनुसार, इसकी शुरुआत 1996 में न्यू जर्सी, यूएसए में एडवेंटनेट इंक. (AdventNet Inc.) के रूप में हुई थी, जिसका प्रारंभिक फोकस नेटवर्क प्रबंधन पर था। इसके शुरुआती इंजीनियरिंग मूल (roots) चेन्नई में भी थे।"},"source_docx_q":1,"id":"q1","num":1},{"q":{"en":"Which names should be remembered from Zoho's founding team?","hi":"ज़ोहो की संस्थापक टीम (founding team) से कौन से नाम याद रखे जाने चाहिए?"},"o":[{"en":"Narayana Murthy and Nandan Nilekani","hi":"नारायण मूर्ति और नंदन नीलेकणि"},{"en":"Sridhar Vembu and Tony Thomas","hi":"श्रीधर वेम्बू और टोनी थॉमस"},{"en":"Sundar Pichai and Satya Nadella","hi":"सुंदर पिचाई और सत्या नडेला"},{"en":"Sachin Bansal and Binny Bansal","hi":"सचिन बंसल और बिन्नी बंसल"}],"a":{"en":"Sridhar Vembu and Tony Thomas","hi":"श्रीधर वेम्बू और टोनी थॉमस"},"exp":{"en":"Sridhar Vembu and Tony Thomas are the core co-founder names. In its early history, Vembu's brothers Kumar and Sekar, and engineering collaborator Shailesh Kumar Davey are also associated.\nSource-note (Hinglish): Sridhar Vembu aur Tony Thomas core co-founder names hain. Early history mein Vembu ke brothers Kumar aur Sekar aur engineering collaborator Shailesh Kumar bhi associated hain.","hi":"श्रीधर वेम्बू और टोनी थॉमस मुख्य सह-संस्थापक (co-founder) नाम हैं। इसके प्रारंभिक इतिहास में, वेम्बू के भाई कुमार और सेकर, और इंजीनियरिंग सहयोगी शैलेश कुमार दवे भी जुड़े हुए हैं।"},"source_docx_q":2,"id":"q2","num":2},{"q":{"en":"When did AdventNet become Zoho Corporation?","hi":"एडवेंटनेट (AdventNet) ज़ोहो कॉर्पोरेशन (Zoho Corporation) कब बना?"},"o":[{"en":"2000","hi":"2000"},{"en":"2005","hi":"2005"},{"en":"2009","hi":"2009"},{"en":"2015","hi":"2015"}],"a":{"en":"2009","hi":"2009"},"exp":{"en":"AdventNet was renamed to Zoho Corporation in 2009 as the business expanded from network-management software to cloud business apps and a wider software portfolio.\nSource-note (Hinglish): 2009. Business network-management software se cloud business apps aur wider software portfolio tak expand hua.","hi":"2009 में एडवेंटनेट का नाम बदलकर ज़ोहो कॉर्पोरेशन कर दिया गया क्योंकि व्यवसाय नेटवर्क-मैनेजमेंट सॉफ्टवेयर से क्लाउड बिजनेस ऐप्स और व्यापक सॉफ्टवेयर पोर्टफोलियो में विस्तारित (expand) हो गया था।"},"source_docx_q":3,"id":"q3","num":3},{"q":{"en":"What business model and products is Zoho known for?","hi":"ज़ोहो किस बिजनेस मॉडल और उत्पादों के लिए जाना जाता है?"},"o":[{"en":"Hardware manufacturing","hi":"हार्डवेयर निर्माण"},{"en":"E-commerce retail","hi":"ई-कॉमर्स रिटेल"},{"en":"Cloud-based business software and SaaS (e.g., Email, document collaboration, CRM)","hi":"क्लाउड-आधारित व्यावसायिक सॉफ्टवेयर और SaaS (जैसे, ईमेल, दस्तावेज़ सहयोग, CRM)"},{"en":"Social media platforms","hi":"सोशल मीडिया प्लेटफॉर्म"}],"a":{"en":"Cloud-based business software and SaaS (e.g., Email, document collaboration, CRM)","hi":"क्लाउड-आधारित व्यावसायिक सॉफ्टवेयर और SaaS (जैसे, ईमेल, दस्तावेज़ सहयोग, CRM)"},"exp":{"en":"Zoho is globally recognized for its comprehensive suite of cloud-based business software and SaaS solutions, including email, document collaboration, CRM, and office productivity tools.\nSource-note (Hinglish): Cloud-based business software aur SaaS. Email, document collaboration, CRM aur office productivity tools iske examples hain.","hi":"ज़ोहो को क्लाउड-आधारित व्यावसायिक सॉफ्टवेयर और SaaS समाधानों के व्यापक सूट के लिए विश्व स्तर पर पहचाना जाता है, जिसमें ईमेल, दस्तावेज़ सहयोग, सीआरएम और कार्यालय उत्पादकता उपकरण (office productivity tools) शामिल हैं।"},"source_docx_q":4,"id":"q4","num":4},{"q":{"en":"What are the full forms of SaaS and R&D?","hi":"SaaS और R&D का फुल फॉर्म क्या है?"},"o":[{"en":"Software as a Service; Research and Development","hi":"सॉफ्टवेयर एज़ अ सर्विस; रिसर्च एंड डेवलपमेंट"},{"en":"Storage as a Service; Resource and Data","hi":"स्टोरेज एज़ अ सर्विस; रिसोर्स एंड डेटा"},{"en":"System and Application Software; Research and Design","hi":"सिस्टम एंड एप्लिकेशन सॉफ्टवेयर; रिसर्च एंड डिज़ाइन"},{"en":"Software as a System; Research and Deployment","hi":"सॉफ्टवेयर एज़ अ सिस्टम; रिसर्च एंड डिप्लॉयमेंट"}],"a":{"en":"Software as a Service; Research and Development","hi":"सॉफ्टवेयर एज़ अ सर्विस; रिसर्च एंड डेवलपमेंट"},"exp":{"en":"SaaS stands for Software as a Service. R&D stands for Research and Development.\nSource-note (Hinglish): SaaS = Software as a Service. R&D = Research and Development.","hi":"SaaS का अर्थ 'सॉफ्टवेयर एज़ अ सर्विस' (Software as a Service) है। R&D का अर्थ 'रिसर्च एंड डेवलपमेंट' (Research and Development) है।"},"source_docx_q":5,"id":"q5","num":5},{"q":{"en":"After the 2025 leadership transition, what are the roles of Sridhar Vembu and Shailesh Kumar Davey at Zoho?","hi":"2025 के नेतृत्व परिवर्तन (leadership transition) के बाद, ज़ोहो में श्रीधर वेम्बू और शैलेश कुमार दवे की भूमिकाएँ क्या हैं?"},"o":[{"en":"Vembu is CEO, Davey is CTO","hi":"वेम्बू CEO हैं, दवे CTO हैं"},{"en":"Vembu is Chief Scientist, Davey is Zoho Corp CEO","hi":"वेम्बू मुख्य वैज्ञानिक (Chief Scientist) हैं, दवे ज़ोहो कॉर्प के CEO हैं"},{"en":"Vembu is Chairman, Davey is President","hi":"वेम्बू अध्यक्ष हैं, दवे राष्ट्रपति हैं"},{"en":"Both are Co-CEOs","hi":"दोनों सह-CEO हैं"}],"a":{"en":"Vembu is Chief Scientist, Davey is Zoho Corp CEO","hi":"वेम्बू मुख्य वैज्ञानिक (Chief Scientist) हैं, दवे ज़ोहो कॉर्प के CEO हैं"},"exp":{"en":"The Zoho company timeline lists Sridhar Vembu as Chief Scientist (focusing on R&D and long-term technology) and Shailesh Kumar Davey as the CEO of Zoho Corp.\nSource-note (Hinglish): Zoho ki company timeline Sridhar Vembu ko Chief Scientist aur Shailesh Kumar Davey ko Zoho Corp CEO list karti hai. Vembu ka focus R&D aur long-term technology work par hai.","hi":"ज़ोहो कंपनी की टाइमलाइन श्रीधर वेम्बू को मुख्य वैज्ञानिक (R&D और दीर्घकालिक तकनीक पर ध्यान केंद्रित करते हुए) और शैलेश कुमार दवे को ज़ोहो कॉर्प के CEO के रूप में सूचीबद्ध करती है।"},"source_docx_q":6,"id":"q6","num":6},{"q":{"en":"What was the idea behind Zoho's digital self-reliance approach?","hi":"ज़ोहो के 'डिजिटल आत्मनिर्भरता' (digital self-reliance) दृष्टिकोण के पीछे क्या विचार था?"},"o":[{"en":"To rely completely on foreign technology","hi":"विदेशी तकनीक पर पूरी तरह से निर्भर होना"},{"en":"To build globally competitive software products and R&D from India, while supporting rural talent and technology education","hi":"भारत से विश्व स्तर पर प्रतिस्पर्धी सॉफ्टवेयर उत्पाद और R&D बनाना, साथ ही ग्रामीण प्रतिभा और प्रौद्योगिकी शिक्षा का समर्थन करना"},{"en":"To outsource all development to other countries","hi":"सभी विकास कार्यों को अन्य देशों में आउटसोर्स करना"},{"en":"To focus only on hardware assembly","hi":"केवल हार्डवेयर असेंबली पर ध्यान केंद्रित करना"}],"a":{"en":"To build globally competitive software products and R&D from India, while supporting rural talent and technology education","hi":"भारत से विश्व स्तर पर प्रतिस्पर्धी सॉफ्टवेयर उत्पाद और R&D बनाना, साथ ही ग्रामीण प्रतिभा और प्रौद्योगिकी शिक्षा का समर्थन करना"},"exp":{"en":"Zoho's approach emphasizes creating world-class software and conducting R&D within India, deeply intertwined with initiatives to nurture rural talent and provide tech education.\nSource-note (Hinglish): India se globally competitive software products aur R&D build karna, saath hi rural talent aur technology education ko support karna.","hi":"ज़ोहो का दृष्टिकोण भारत के भीतर विश्व स्तरीय सॉफ्टवेयर बनाने और R&D आयोजित करने पर जोर देता है, जो ग्रामीण प्रतिभाओं को पोषित करने और तकनीकी शिक्षा प्रदान करने की पहल के साथ गहराई से जुड़ा हुआ है।"},"source_docx_q":7,"id":"q7","num":7},{"q":{"en":"Which civilian award did Sridhar Vembu receive, when, and in which category?","hi":"श्रीधर वेम्बू को कौन सा नागरिक सम्मान, कब और किस श्रेणी में मिला?"},"o":[{"en":"Padma Vibhushan, 2020, Science","hi":"पद्म विभूषण, 2020, विज्ञान"},{"en":"Padma Bhushan, 2022, Technology","hi":"पद्म भूषण, 2022, प्रौद्योगिकी"},{"en":"Padma Shri, 2021, Trade and Industry","hi":"पद्म श्री, 2021, व्यापार और उद्योग"},{"en":"Bharat Ratna, 2023, Public Service","hi":"भारत रत्न, 2023, लोक सेवा"}],"a":{"en":"Padma Shri, 2021, Trade and Industry","hi":"पद्म श्री, 2021, व्यापार और उद्योग"},"exp":{"en":"Sridhar Vembu was awarded the Padma Shri, India's fourth-highest civilian honour, in 2021 in the Trade and Industry category.\nSource-note (Hinglish): Padma Shri, 2021, Trade and Industry. Padma Shri India ka fourth-highest civilian honour hai.","hi":"श्रीधर वेम्बू को 2021 में व्यापार और उद्योग श्रेणी में भारत के चौथे सबसे बड़े नागरिक सम्मान 'पद्म श्री' से सम्मानित किया गया था।"},"source_docx_q":8,"id":"q8","num":8}]},{"title":{"en":"2. Government Email, Security & Digital Self-Reliance","hi":"2. सरकारी ईमेल, सुरक्षा और डिजिटल आत्मनिर्भरता"},"questions":[{"q":{"en":"What are the full forms of NIC, MeitY, and DIC?","hi":"NIC, MeitY और DIC के फुल फॉर्म क्या हैं?"},"o":[{"en":"National Internet Centre; Ministry of Engineering and IT; Digital India Corporation","hi":"नेशनल इंटरनेट सेंटर; मिनिस्ट्री ऑफ इंजीनियरिंग एंड IT; डिजिटल इंडिया कॉर्पोरेशन"},{"en":"National Informatics Centre; Ministry of Electronics and Information Technology; Digital India Corporation","hi":"राष्ट्रीय सूचना विज्ञान केंद्र (National Informatics Centre); इलेक्ट्रॉनिक्स और सूचना प्रौद्योगिकी मंत्रालय (Ministry of Electronics and Information Technology); डिजिटल इंडिया कॉर्पोरेशन"},{"en":"Network Information Centre; Ministry of E-commerce and IT; Data India Corporation","hi":"नेटवर्क इंफॉर्मेशन सेंटर; मिनिस्ट्री ऑफ ई-कॉमर्स एंड IT; डेटा इंडिया कॉर्पोरेशन"},{"en":"National Intelligence Centre; Ministry of Education and IT; Digital Infrastructure Corporation","hi":"नेशनल इंटेलिजेंस सेंटर; मिनिस्ट्री ऑफ एजुकेशन एंड IT; डिजिटल इंफ्रास्ट्रक्चर कॉर्पोरेशन"}],"a":{"en":"National Informatics Centre; Ministry of Electronics and Information Technology; Digital India Corporation","hi":"राष्ट्रीय सूचना विज्ञान केंद्र (National Informatics Centre); इलेक्ट्रॉनिक्स और सूचना प्रौद्योगिकी मंत्रालय (Ministry of Electronics and Information Technology); डिजिटल इंडिया कॉर्पोरेशन"},"exp":{"en":"NIC = National Informatics Centre. MeitY = Ministry of Electronics and Information Technology. DIC = Digital India Corporation.\nSource-note (Hinglish): NIC = National Informatics Centre. MeitY = Ministry of Electronics and Information Technology. DIC = Digital India Corporation.","hi":"NIC = नेशनल इंफॉर्मेटिक्स सेंटर (राष्ट्रीय सूचना विज्ञान केंद्र)। MeitY = मिनिस्ट्री ऑफ इलेक्ट्रॉनिक्स एंड इंफॉर्मेशन टेक्नोलॉजी। DIC = डिजिटल इंडिया कॉर्पोरेशन।"},"source_docx_q":9,"id":"q9","num":9},{"q":{"en":"What was the role of NIC and Zoho in the government email upgrade?","hi":"सरकारी ईमेल अपग्रेड में NIC और ज़ोहो की क्या भूमिका थी?"},"o":[{"en":"Zoho took over NIC completely","hi":"ज़ोहो ने NIC को पूरी तरह से अपने अधिकार में ले लिया"},{"en":"A competitive tender was held in 2023 through DIC for NIC's cloud upgrade. Zoho became the selected provider for the official email and collaboration platform. NIC retains strategic control / NIC के क्लाउड अपग्रेड के लिए 2023 में DIC के माध्यम से एक प्रतिस्पर्धी निविदा (tender) आयोजित की गई थी। ज़ोहो आधिकारिक ईमेल और सहयोग मंच (collaboration platform) के लिए चयनित प्रदाता (selected provider) बन गया। NIC सरकारी सेटअप पर रणनीतिक नियंत्रण (strategic control) रखता है","hi":"A competitive tender was held in 2023 through DIC for NIC's cloud upgrade. Zoho became the selected provider for the official email and collaboration platform. NIC retains strategic control / NIC के क्लाउड अपग्रेड के लिए 2023 में DIC के माध्यम से एक प्रतिस्पर्धी निविदा (tender) आयोजित की गई थी। ज़ोहो आधिकारिक ईमेल और सहयोग मंच (collaboration platform) के लिए चयनित प्रदाता (selected provider) बन गया। NIC सरकारी सेटअप पर रणनीतिक नियंत्रण (strategic control) रखता है"},{"en":"NIC built the platform, Zoho manages the domain / NIC ने प्लेटफॉर्म बनाया, ज़ोहो डोमेन का प्रबंधन करता है","hi":"NIC built the platform, Zoho manages the domain / NIC ने प्लेटफॉर्म बनाया, ज़ोहो डोमेन का प्रबंधन करता है"},{"en":"There was no upgrade","hi":"कोई अपग्रेड नहीं हुआ था"}],"a":{"en":"A competitive tender was held in 2023 through DIC for NIC's cloud upgrade. Zoho became the selected provider for the official email and collaboration platform. NIC retains strategic control / NIC के क्लाउड अपग्रेड के लिए 2023 में DIC के माध्यम से एक प्रतिस्पर्धी निविदा (tender) आयोजित की गई थी। ज़ोहो आधिकारिक ईमेल और सहयोग मंच (collaboration platform) के लिए चयनित प्रदाता (selected provider) बन गया। NIC सरकारी सेटअप पर रणनीतिक नियंत्रण (strategic control) रखता है","hi":"A competitive tender was held in 2023 through DIC for NIC's cloud upgrade. Zoho became the selected provider for the official email and collaboration platform. NIC retains strategic control / NIC के क्लाउड अपग्रेड के लिए 2023 में DIC के माध्यम से एक प्रतिस्पर्धी निविदा (tender) आयोजित की गई थी। ज़ोहो आधिकारिक ईमेल और सहयोग मंच (collaboration platform) के लिए चयनित प्रदाता (selected provider) बन गया। NIC सरकारी सेटअप पर रणनीतिक नियंत्रण (strategic control) रखता है"},"exp":{"en":"Zoho won the competitive bid to provide the cloud backend for the government's email, while NIC maintained strategic control and oversight over the government setup.\nSource-note (Hinglish): NIC ke cloud upgrade ke liye 2023 mein DIC ke through competitive tender hua. Zoho official email aur collaboration platform ke liye selected provider bana. NIC government setup par strategic control rakhta hai.","hi":"ज़ोहो ने सरकार के ईमेल के लिए क्लाउड बैकएंड प्रदान करने की प्रतिस्पर्धी बोली जीती, जबकि NIC ने सरकारी सेटअप पर रणनीतिक नियंत्रण और निगरानी बनाए रखी।"},"source_docx_q":10,"id":"q10","num":10},{"q":{"en":"What happened to the gov.in and nic.in domains during the migration?","hi":"माइग्रेशन (migration) के दौरान gov.in और nic.in डोमेन का क्या हुआ?"},"o":[{"en":"They were changed to zoho.in","hi":"उन्हें zoho.in में बदल दिया गया"},{"en":"They were deleted","hi":"उन्हें हटा दिया गया था"},{"en":"The government email domains gov.in and nic.in continued. The cloud backend upgrade did not require changing the official domain identity","hi":"सरकारी ईमेल डोमेन gov.in और nic.in जारी रहे। क्लाउड बैकएंड अपग्रेड और मेलबॉक्स माइग्रेशन से आधिकारिक डोमेन पहचान (official domain identity) को बदलना आवश्यक नहीं था"},{"en":"They were merged into india.gov","hi":"उन्हें india.gov में मिला दिया गया"}],"a":{"en":"The government email domains gov.in and nic.in continued. The cloud backend upgrade did not require changing the official domain identity","hi":"सरकारी ईमेल डोमेन gov.in और nic.in जारी रहे। क्लाउड बैकएंड अपग्रेड और मेलबॉक्स माइग्रेशन से आधिकारिक डोमेन पहचान (official domain identity) को बदलना आवश्यक नहीं था"},"exp":{"en":"The migration involved moving the backend infrastructure to Zoho's cloud, but the user-facing official email addresses (ending in @gov.in or @nic.in) remained exactly the same.\nSource-note (Hinglish): Government email domains gov.in aur nic.in continue rahe. Cloud backend upgrade aur mailbox migration se official domain identity badalna zaroori nahin tha.","hi":"माइग्रेशन में बैकएंड इंफ्रास्ट्रक्चर को ज़ोहो के क्लाउड पर ले जाना शामिल था, लेकिन उपयोगकर्ता-सामना करने वाले आधिकारिक ईमेल पते (@gov.in या @nic.in पर समाप्त होने वाले) बिल्कुल वैसे ही रहे।"},"source_docx_q":11,"id":"q11","num":11},{"q":{"en":"What is the verified dated account count of the Zoho migration?","hi":"ज़ोहो माइग्रेशन (migration) की सत्यापित दिनांकित खाता संख्या (verified dated account count) क्या है?"},"o":[{"en":"Exactly 10 lakh","hi":"ठीक 10 लाख"},{"en":"Zoho's Oct 2025 case study shows a snapshot of over 11 lakh accounts. A Dec 2025 Lok Sabha reply stated around 12.68 lakh accounts, including 7.45 lakh Central Gov employees","hi":"ज़ोहो के 16 अक्टूबर 2025 के केस स्टडी में 11 लाख से अधिक खातों का स्नैपशॉट है। 10 दिसंबर 2025 के लोकसभा जवाब में लगभग 12.68 लाख खाते बताए गए, जिनमें 7.45 लाख केंद्र सरकार के कर्मचारी शामिल हैं"},{"en":"50 lakh accounts / 50 लाख खाते","hi":"50 lakh accounts / 50 लाख खाते"},{"en":"Only 2 lakh accounts","hi":"केवल 2 लाख खाते"}],"a":{"en":"Zoho's Oct 2025 case study shows a snapshot of over 11 lakh accounts. A Dec 2025 Lok Sabha reply stated around 12.68 lakh accounts, including 7.45 lakh Central Gov employees","hi":"ज़ोहो के 16 अक्टूबर 2025 के केस स्टडी में 11 लाख से अधिक खातों का स्नैपशॉट है। 10 दिसंबर 2025 के लोकसभा जवाब में लगभग 12.68 लाख खाते बताए गए, जिनमें 7.45 लाख केंद्र सरकार के कर्मचारी शामिल हैं"},"exp":{"en":"The number of accounts migrated is documented in specific time-stamped sources, showing growth from over 11 lakh (company report) to 12.68 lakh total (parliamentary reply).\nSource-note (Hinglish): Zoho ke 16 October 2025 case study mein over 11 lakh accounts ka snapshot hai. 10 December 2025 Lok Sabha reply mein around 12.68 lakh accounts, including 7.45 lakh Central Government employees, bataye gaye.","hi":"माइग्रेट किए गए खातों की संख्या विशिष्ट समय-मुहर लगी (time-stamped) स्रोतों में प्रलेखित है, जो 11 लाख से अधिक (कंपनी रिपोर्ट) से बढ़कर कुल 12.68 लाख (संसदीय उत्तर) हो गई है।"},"source_docx_q":12,"id":"q12","num":12},{"q":{"en":"Is the figure 'complete migration of 12 lakh central employees in October' confirmed by the PDF?","hi":"क्या PDF द्वारा 'अक्टूबर में 12 लाख केंद्रीय कर्मचारियों का पूर्ण प्रवासन (complete migration)' का आंकड़ा पुष्ट (confirmed) है?"},"o":[{"en":"Yes, it is entirely accurate","hi":"हाँ, यह पूरी तरह सटीक है"},{"en":"No. Dated primary sources separate the count of accounts and Central Gov employees. The Oct company update calls the migration 'ongoing'. The Dec Lok Sabha reply states 12.68 lakh total accounts and 7.45 lakh Central Gov employees","hi":"नहीं। दिनांकित प्राथमिक स्रोत (Dated primary sources) खातों और केंद्र सरकार के कर्मचारियों की गिनती को अलग करते हैं। अक्टूबर कंपनी अपडेट माइग्रेशन को 'चल रहा' (ongoing) बताता है। दिसंबर लोकसभा जवाब 12.68 लाख कुल खाते और 7.45 लाख केंद्र सरकार के कर्मचारी बताता है"},{"en":"Yes, but it happened in November","hi":"हाँ, लेकिन यह नवंबर में हुआ था"},{"en":"The PDF does not mention any numbers / PDF में किसी भी संख्या का उल्लेख नहीं है","hi":"The PDF does not mention any numbers / PDF में किसी भी संख्या का उल्लेख नहीं है"}],"a":{"en":"No. Dated primary sources separate the count of accounts and Central Gov employees. The Oct company update calls the migration 'ongoing'. The Dec Lok Sabha reply states 12.68 lakh total accounts and 7.45 lakh Central Gov employees","hi":"नहीं। दिनांकित प्राथमिक स्रोत (Dated primary sources) खातों और केंद्र सरकार के कर्मचारियों की गिनती को अलग करते हैं। अक्टूबर कंपनी अपडेट माइग्रेशन को 'चल रहा' (ongoing) बताता है। दिसंबर लोकसभा जवाब 12.68 लाख कुल खाते और 7.45 लाख केंद्र सरकार के कर्मचारी बताता है"},"exp":{"en":"It is a common exam trap to conflate the 'total accounts' figure with the 'Central Government employees' figure, or to state the migration was 'complete' on a specific early date.\nSource-note (Hinglish): Dated primary sources accounts aur Central Government employees ko alag count karte hain. October company update migration ko ongoing batata hai. December Lok Sabha reply 12.68 lakh total accounts aur 7.45 lakh Central Government employees batata hai.","hi":"परीक्षाओं में 'कुल खातों' के आंकड़े को 'केंद्र सरकार के कर्मचारियों' के आंकड़े के साथ मिलाना, या यह कहना कि एक विशिष्ट प्रारंभिक तिथि पर माइग्रेशन 'पूरा' हो गया था, एक सामान्य ट्रैप (trap) है।"},"source_docx_q":13,"id":"q13","num":13},{"q":{"en":"What does the 2024 Government Email Policy emphasize for official communications?","hi":"2024 सरकारी ईमेल नीति आधिकारिक संचार के लिए किस पर जोर देती है?"},"o":[{"en":"Using consumer email accounts","hi":"उपभोक्ता (consumer) ईमेल खातों का उपयोग करना"},{"en":"Using social media","hi":"सोशल मीडिया का उपयोग करना"},{"en":"The use of the designated government email service, account security, and authorized use. Consumer email accounts and designated official emails are different contexts","hi":"आधिकारिक संचार के लिए नामित सरकारी ईमेल सेवा (designated government email service), खाता सुरक्षा और अधिकृत उपयोग का उपयोग। उपभोक्ता ईमेल खाते और नामित आधिकारिक ईमेल अलग-अलग संदर्भ हैं"},{"en":"No email policy exists","hi":"कोई ईमेल नीति मौजूद नहीं है"}],"a":{"en":"The use of the designated government email service, account security, and authorized use. Consumer email accounts and designated official emails are different contexts","hi":"आधिकारिक संचार के लिए नामित सरकारी ईमेल सेवा (designated government email service), खाता सुरक्षा और अधिकृत उपयोग का उपयोग। उपभोक्ता ईमेल खाते और नामित आधिकारिक ईमेल अलग-अलग संदर्भ हैं"},"exp":{"en":"The policy strictly mandates the use of designated, secure government email services for official work to prevent data leakage and ensure security, explicitly distinguishing them from personal consumer email accounts like Gmail or Yahoo.\nSource-note (Hinglish): Official communication ke liye designated government email service, account security aur authorized use. Consumer email accounts aur designated official email alag contexts hain.","hi":"नीति डेटा रिसाव (data leakage) को रोकने और सुरक्षा सुनिश्चित करने के लिए आधिकारिक काम के लिए नामित, सुरक्षित सरकारी ईमेल सेवाओं के उपयोग को सख्ती से अनिवार्य करती है, उन्हें व्यक्तिगत उपभोक्ता ईमेल खातों (जैसे जीमेल) से स्पष्ट रूप से अलग करती है।"},"source_docx_q":14,"id":"q14","num":14},{"q":{"en":"What were the security features of the government email architecture?","hi":"सरकारी ईमेल आर्किटेक्चर की सुरक्षा विशेषताएं क्या थीं?"},"o":[{"en":"Only a simple password","hi":"केवल एक साधारण पासवर्ड"},{"en":"Encryption at rest and in transit, access controls, zero trust, continuous monitoring, audits, and disaster-recovery provisions","hi":"आराम और पारगमन में एन्क्रिप्शन (Encryption at rest and in transit), एक्सेस कंट्रोल, ज़ीरो ट्रस्ट, निरंतर निगरानी, ऑडिट और आपदा-पुनर्प्राप्ति (disaster-recovery) प्रावधान"},{"en":"No encryption","hi":"कोई एन्क्रिप्शन नहीं"},{"en":"Open access for all","hi":"सभी के लिए खुली पहुँच"}],"a":{"en":"Encryption at rest and in transit, access controls, zero trust, continuous monitoring, audits, and disaster-recovery provisions","hi":"आराम और पारगमन में एन्क्रिप्शन (Encryption at rest and in transit), एक्सेस कंट्रोल, ज़ीरो ट्रस्ट, निरंतर निगरानी, ऑडिट और आपदा-पुनर्प्राप्ति (disaster-recovery) प्रावधान"},"exp":{"en":"The government deployment utilizes a highly secure architecture. Note: Always read claims about the government deployment separately from general Zoho consumer product settings.\nSource-note (Hinglish): Encryption at rest aur in transit, access controls, zero trust, continuous monitoring, audits aur disaster-recovery provisions. Government deployment ke claims ko general Zoho product settings se alag padho.","hi":"सरकारी परिनियोजन (deployment) एक अत्यधिक सुरक्षित वास्तुकला (architecture) का उपयोग करता है। ध्यान दें: सरकारी परिनियोजन के दावों को हमेशा सामान्य ज़ोहो उपभोक्ता उत्पाद सेटिंग्स से अलग पढ़ें।"},"source_docx_q":15,"id":"q15","num":15},{"q":{"en":"What is the difference between zero trust and 2FA?","hi":"ज़ीरो ट्रस्ट (Zero trust) और 2FA (Two-Factor Authentication) में क्या अंतर है?"},"o":[{"en":"They are the same thing","hi":"वे एक ही बात हैं"},{"en":"2FA is for hardware, zero trust is for software / 2FA हार्डवेयर के लिए है, ज़ीरो ट्रस्ट सॉफ्टवेयर के लिए है","hi":"2FA is for hardware, zero trust is for software / 2FA हार्डवेयर के लिए है, ज़ीरो ट्रस्ट सॉफ्टवेयर के लिए है"},{"en":"Zero trust verifies every access request based on context, identity, and policy. 2FA uses two distinct factors (e.g., password and authenticator/biometrics) for identity check","hi":"ज़ीरो ट्रस्ट संदर्भ (context), पहचान और नीति के आधार पर हर एक्सेस अनुरोध को सत्यापित करता है। 2FA पहचान की जांच के लिए दो अलग-अलग कारकों (जैसे, पासवर्ड और ऑथेंटिकेटर/बायोमेट्रिक्स) का उपयोग करता है"},{"en":"Zero trust means no passwords are needed","hi":"ज़ीरो ट्रस्ट का मतलब है कि किसी पासवर्ड की आवश्यकता नहीं है"}],"a":{"en":"Zero trust verifies every access request based on context, identity, and policy. 2FA uses two distinct factors (e.g., password and authenticator/biometrics) for identity check","hi":"ज़ीरो ट्रस्ट संदर्भ (context), पहचान और नीति के आधार पर हर एक्सेस अनुरोध को सत्यापित करता है। 2FA पहचान की जांच के लिए दो अलग-अलग कारकों (जैसे, पासवर्ड और ऑथेंटिकेटर/बायोमेट्रिक्स) का उपयोग करता है"},"exp":{"en":"Zero Trust is a broad security framework ('never trust, always verify'), whereas 2FA is a specific authentication mechanism that can be a component of a Zero Trust architecture.\nSource-note (Hinglish): Zero trust har access request ko context, identity aur policy ke hisaab se verify karta hai. 2FA identity check ke liye two distinct factors use karta hai, jaise password aur authenticator. Biometrics ek possible factor hai.","hi":"ज़ीरो ट्रस्ट एक व्यापक सुरक्षा ढांचा (framework) है ('कभी भरोसा न करें, हमेशा सत्यापित करें'), जबकि 2FA एक विशिष्ट प्रमाणीकरण तंत्र है जो ज़ीरो ट्रस्ट आर्किटेक्चर का एक घटक हो सकता है।"},"source_docx_q":16,"id":"q16","num":16},{"q":{"en":"What is the practical meaning of cyber resilience and disaster recovery?","hi":"साइबर रेजिलिएंस (Cyber resilience) और डिजास्टर रिकवरी (Disaster recovery) का व्यावहारिक अर्थ क्या है?"},"o":[{"en":"Never getting hacked","hi":"कभी हैक न होना"},{"en":"Only backing up data once a year","hi":"वर्ष में केवल एक बार डेटा का बैकअप लेना"},{"en":"The ability to restore service and limit data loss after an attack or outage. Backups, separate recovery sites, detection, and recovery plans help in this","hi":"हमले (attack) या आउटेज (outage) के बाद सेवा बहाल (restore) करने और डेटा हानि को सीमित करने की क्षमता। बैकअप, अलग रिकवरी साइट, डिटेक्शन और रिकवरी प्लान इसमें मदद करते हैं"},{"en":"Hiding servers underground","hi":"सर्वर को जमीन के नीचे छिपाना"}],"a":{"en":"The ability to restore service and limit data loss after an attack or outage. Backups, separate recovery sites, detection, and recovery plans help in this","hi":"हमले (attack) या आउटेज (outage) के बाद सेवा बहाल (restore) करने और डेटा हानि को सीमित करने की क्षमता। बैकअप, अलग रिकवरी साइट, डिटेक्शन और रिकवरी प्लान इसमें मदद करते हैं"},"exp":{"en":"Cyber resilience acknowledges that breaches or failures may happen and focuses on the organization's ability to withstand, respond to, and quickly recover from them.\nSource-note (Hinglish): Attack ya outage ke baad service restore aur data loss limit karne ki ability. Backups, separate recovery sites, detection aur recovery plans ismein help karte hain.","hi":"साइबर रेजिलिएंस स्वीकार करता है कि उल्लंघन (breaches) या विफलताएं हो सकती हैं और संगठन की उनका सामना करने, प्रतिक्रिया देने और उनसे जल्दी से उबरने की क्षमता पर ध्यान केंद्रित करता है।"},"source_docx_q":17,"id":"q17","num":17},{"q":{"en":"What is the correct year of the major AIIMS Delhi ransomware incident?","hi":"प्रमुख एम्स दिल्ली (AIIMS Delhi) रैंसमवेयर (ransomware) घटना का सही वर्ष क्या है?"},"o":[{"en":"2020","hi":"2020"},{"en":"2021","hi":"2021"},{"en":"November 2022","hi":"नवंबर 2022"},{"en":"2024","hi":"2024"}],"a":{"en":"November 2022","hi":"नवंबर 2022"},"exp":{"en":"The major, widely documented ransomware attack on AIIMS Delhi occurred in November 2022. Be careful if a source incorrectly cites 2023.\nSource-note (Hinglish): November 2022. PDF ka 2023 year is widely documented AIIMS Delhi incident se match nahin karta.","hi":"एम्स दिल्ली पर प्रमुख, व्यापक रूप से प्रलेखित रैंसमवेयर हमला नवंबर 2022 में हुआ था। यदि कोई स्रोत (जैसे PDF) गलत तरीके से 2023 का हवाला देता है, तो सावधान रहें।"},"source_docx_q":18,"id":"q18","num":18},{"q":{"en":"How does Atmanirbhar Bharat link to digital self-reliance?","hi":"आत्मनिर्भर भारत (Atmanirbhar Bharat) डिजिटल आत्मनिर्भरता से कैसे जुड़ता है?"},"o":[{"en":"By stopping all internet usage","hi":"इंटरनेट के सभी उपयोग को रोककर"},{"en":"By strengthening domestic innovation, software, cloud infrastructure, data centres, and technical capabilities. It is part of the broader framework of the post-pandemic self-reliance push","hi":"घरेलू नवाचार (domestic innovation), सॉफ्टवेयर, क्लाउड इंफ्रास्ट्रक्चर, डेटा सेंटर और तकनीकी क्षमताओं को मजबूत करके। यह महामारी के बाद के आत्मनिर्भरता प्रयास (self-reliance push) के व्यापक ढांचे का हिस्सा है"},{"en":"By importing all technology","hi":"सभी प्रौद्योगिकी का आयात करके"},{"en":"By only focusing on agriculture","hi":"केवल कृषि पर ध्यान केंद्रित करके"}],"a":{"en":"By strengthening domestic innovation, software, cloud infrastructure, data centres, and technical capabilities. It is part of the broader framework of the post-pandemic self-reliance push","hi":"घरेलू नवाचार (domestic innovation), सॉफ्टवेयर, क्लाउड इंफ्रास्ट्रक्चर, डेटा सेंटर और तकनीकी क्षमताओं को मजबूत करके। यह महामारी के बाद के आत्मनिर्भरता प्रयास (self-reliance push) के व्यापक ढांचे का हिस्सा है"},"exp":{"en":"The Atmanirbhar Bharat initiative aims to make India a self-reliant global powerhouse, which inherently requires reducing dependence on foreign digital infrastructure and building strong domestic tech capabilities.\nSource-note (Hinglish): Domestic innovation, software, cloud infrastructure, data centres aur technical capabilities ko strengthen karna. Pandemic ke baad self-reliance push ke broader framework ka hissa hai.","hi":"आत्मनिर्भर भारत पहल का उद्देश्य भारत को एक आत्मनिर्भर वैश्विक महाशक्ति बनाना है, जिसके लिए स्वाभाविक रूप से विदेशी डिजिटल बुनियादी ढांचे पर निर्भरता कम करने और मजबूत घरेलू तकनीकी क्षमताओं के निर्माण की आवश्यकता है।"},"source_docx_q":19,"id":"q19","num":19},{"q":{"en":"What is the full form of PLI, and how does it relate to digital self-reliance?","hi":"PLI का फुल फॉर्म क्या है, और यह डिजिटल आत्मनिर्भरता से कैसे संबंधित है?"},"o":[{"en":"Public Liability Insurance","hi":"पब्लिक लायबिलिटी इंश्योरेंस"},{"en":"Private Limited Incorporation","hi":"प्राइवेट लिमिटेड इनकॉर्पोरेशन"},{"en":"Production Linked Incentive. It gives incentives for eligible domestic production. Telecom/electronics reforms and 'Vocal for Local' are broader efforts to build domestic capability","hi":"प्रोडक्शन लिंक्ड इंसेंटिव (Production Linked Incentive)। यह पात्र घरेलू उत्पादन (eligible domestic production) को प्रोत्साहन देता है। टेलीकॉम/इलेक्ट्रॉनिक्स सुधार और 'वोकल फॉर लोकल' घरेलू क्षमता निर्माण के व्यापक प्रयास हैं"},{"en":"Program Logic Interface","hi":"प्रोग्राम लॉजिक इंटरफेस"}],"a":{"en":"Production Linked Incentive. It gives incentives for eligible domestic production. Telecom/electronics reforms and 'Vocal for Local' are broader efforts to build domestic capability","hi":"प्रोडक्शन लिंक्ड इंसेंटिव (Production Linked Incentive)। यह पात्र घरेलू उत्पादन (eligible domestic production) को प्रोत्साहन देता है। टेलीकॉम/इलेक्ट्रॉनिक्स सुधार और 'वोकल फॉर लोकल' घरेलू क्षमता निर्माण के व्यापक प्रयास हैं"},"exp":{"en":"The PLI scheme provides financial incentives to companies to manufacture goods in India, boosting domestic manufacturing capabilities in sectors like electronics and telecom, which is crucial for digital self-reliance.\nSource-note (Hinglish): Production Linked Incentive. Eligible domestic production ko incentive deta hai. Telecom/electronics reforms aur “Vocal for Local” domestic capability build karne ke broader efforts hain.","hi":"PLI योजना कंपनियों को भारत में माल (goods) का निर्माण करने के लिए वित्तीय प्रोत्साहन प्रदान करती है, जिससे इलेक्ट्रॉनिक्स और दूरसंचार जैसे क्षेत्रों में घरेलू निर्माण क्षमताओं को बढ़ावा मिलता है, जो डिजिटल आत्मनिर्भरता के लिए महत्वपूर्ण है।"},"source_docx_q":20,"id":"q20","num":20}]},{"title":{"en":"3. Data Sovereignty, Governance & DPDP","hi":"3. डेटा संप्रभुता, गवर्नेंस और DPDP"},"questions":[{"q":{"en":"What is the difference between data sovereignty, residency, and localization?","hi":"डेटा संप्रभुता (sovereignty), रेजिडेंसी (residency) और लोकलाइजेशन (localization) में क्या अंतर है?"},"o":[{"en":"They are all synonyms","hi":"वे सभी पर्यायवाची हैं"},{"en":"Sovereignty = jurisdiction and control. Residency = where data is physically stored. Localization = the requirement to store/process specified data in a designated territory","hi":"संप्रभुता = अधिकार क्षेत्र (jurisdiction) और नियंत्रण। रेजिडेंसी = डेटा भौतिक रूप से कहाँ संग्रहीत है। लोकलाइजेशन = निर्दिष्ट डेटा को एक निर्दिष्ट क्षेत्र (designated territory) में स्टोर या प्रोसेस करने की आवश्यकता"},{"en":"Sovereignty is for individuals, residency is for companies","hi":"संप्रभुता व्यक्तियों के लिए है, रेजिडेंसी कंपनियों के लिए है"},{"en":"Localization means translating data","hi":"लोकलाइजेशन का अर्थ है डेटा का अनुवाद करना"}],"a":{"en":"Sovereignty = jurisdiction and control. Residency = where data is physically stored. Localization = the requirement to store/process specified data in a designated territory","hi":"संप्रभुता = अधिकार क्षेत्र (jurisdiction) और नियंत्रण। रेजिडेंसी = डेटा भौतिक रूप से कहाँ संग्रहीत है। लोकलाइजेशन = निर्दिष्ट डेटा को एक निर्दिष्ट क्षेत्र (designated territory) में स्टोर या प्रोसेस करने की आवश्यकता"},"exp":{"en":"Data sovereignty asks 'whose laws apply?', residency asks 'where is it stored?', and localization asks 'where MUST it stay based on laws?'.\nSource-note (Hinglish): Sovereignty = data par applicable jurisdiction aur control. Residency = data physically kahan stored hai. Localization = specified data ko designated territory mein store ya process karne ki requirement.","hi":"डेटा संप्रभुता पूछती है 'किसके कानून लागू होते हैं?', रेजिडेंसी पूछती है 'इसे कहां संग्रहीत किया गया है?', और लोकलाइजेशन पूछती है 'कानूनों के आधार पर इसे कहां रहना चाहिए?'।"},"source_docx_q":21,"id":"q21","num":21},{"q":{"en":"What is the full form and role of CERT-In?","hi":"CERT-In का पूर्ण रूप और भूमिका क्या है?"},"o":[{"en":"Central Emergency Rescue Team - India","hi":"सेंट्रल इमरजेंसी रेस्क्यू टीम - इंडिया"},{"en":"Computer Evaluation and Research Team","hi":"कंप्यूटर इवैल्यूएशन एंड रिसर्च टीम"},{"en":"Indian Computer Emergency Response Team. It handles/coordinates cyber incidents and issues advisories or directions. The Data Protection Board has a different role under DPDP","hi":"इंडियन कंप्यूटर इमरजेंसी रिस्पांस टीम (Indian Computer Emergency Response Team)। यह साइबर घटनाओं को संभालती/समन्वय (coordinate) करती है और एडवाइजरी या निर्देश जारी करती है। DPDP के तहत डेटा प्रोटेक्शन बोर्ड की भूमिका अलग है"},{"en":"Cyber Emergency Response Team","hi":"साइबर इमरजेंसी रिस्पांस टीम"}],"a":{"en":"Indian Computer Emergency Response Team. It handles/coordinates cyber incidents and issues advisories or directions. The Data Protection Board has a different role under DPDP","hi":"इंडियन कंप्यूटर इमरजेंसी रिस्पांस टीम (Indian Computer Emergency Response Team)। यह साइबर घटनाओं को संभालती/समन्वय (coordinate) करती है और एडवाइजरी या निर्देश जारी करती है। DPDP के तहत डेटा प्रोटेक्शन बोर्ड की भूमिका अलग है"},"exp":{"en":"CERT-In is the national nodal agency for responding to computer security incidents. Do not confuse its operational cybersecurity role with the regulatory privacy role of the Data Protection Board.\nSource-note (Hinglish): Indian Computer Emergency Response Team. Cyber incidents handle/coordinate karti hai aur advisories ya directions issue karti hai. Data Protection Board ka DPDP role alag hai.","hi":"CERT-In कंप्यूटर सुरक्षा घटनाओं का जवाब देने के लिए राष्ट्रीय नोडल एजेंसी है। इसकी परिचालन साइबर सुरक्षा भूमिका (operational cybersecurity role) को डेटा संरक्षण बोर्ड की नियामक गोपनीयता भूमिका (regulatory privacy role) के साथ भ्रमित न करें।"},"source_docx_q":22,"id":"q22","num":22},{"q":{"en":"What are MeghRaj and National Data Centres?","hi":"मेघराज (MeghRaj) और राष्ट्रीय डेटा केंद्र (National Data Centres) क्या हैं?"},"o":[{"en":"Private IT companies","hi":"निजी आईटी कंपनियां"},{"en":"MeghRaj is the Government of India's GI Cloud initiative. NIC's National Data Centres support hosting government digital services and infrastructure","hi":"मेघराज भारत सरकार की GI क्लाउड पहल (GI Cloud initiative) है। NIC के राष्ट्रीय डेटा केंद्र (National Data Centres) सरकारी डिजिटल सेवाओं और बुनियादी ढांचे की मेजबानी (hosting) करने में सहायता करते हैं"},{"en":"Weather forecasting supercomputers","hi":"मौसम की भविष्यवाणी करने वाले सुपर कंप्यूटर"},{"en":"New space satellites","hi":"नए अंतरिक्ष उपग्रह"}],"a":{"en":"MeghRaj is the Government of India's GI Cloud initiative. NIC's National Data Centres support hosting government digital services and infrastructure","hi":"मेघराज भारत सरकार की GI क्लाउड पहल (GI Cloud initiative) है। NIC के राष्ट्रीय डेटा केंद्र (National Data Centres) सरकारी डिजिटल सेवाओं और बुनियादी ढांचे की मेजबानी (hosting) करने में सहायता करते हैं"},"exp":{"en":"MeghRaj aims to accelerate delivery of e-services in the country while optimizing ICT spending. The National Data Centres provide the secure physical hosting environments.\nSource-note (Hinglish): MeghRaj Government of India ka GI Cloud initiative hai. NIC ke National Data Centres government digital services aur infrastructure host karne mein support karte hain.","hi":"मेघराज का उद्देश्य देश में ई-सेवाओं के वितरण में तेजी लाना है। राष्ट्रीय डेटा केंद्र (National Data Centres) सुरक्षित भौतिक होस्टिंग वातावरण प्रदान करते हैं।"},"source_docx_q":23,"id":"q23","num":23},{"q":{"en":"Are sectoral data-localization rules and the DPDP Act the same thing?","hi":"क्या सेक्टोरल डेटा-लोकलाइजेशन नियम और DPDP अधिनियम एक ही बात हैं?"},"o":[{"en":"Yes, exactly the same","hi":"हाँ, बिल्कुल एक ही"},{"en":"No. Sectoral requirements apply separately to covered data (e.g., RBI's payment-system data storage directions). The DPDP Act is a broader framework for processing digital personal data","hi":"नहीं। सेक्टोरल आवश्यकताएं (Sectoral requirements) कवर किए गए डेटा पर अलग से लागू हो सकती हैं (जैसे, RBI के भुगतान-प्रणाली डेटा भंडारण निर्देश)। DPDP अधिनियम डिजिटल व्यक्तिगत डेटा प्रोसेसिंग का एक व्यापक ढांचा (broader framework) है"},{"en":"DPDP Act replaced all sectoral rules / DPDP अधिनियम ने सभी सेक्टोरल नियमों को बदल दिया","hi":"DPDP Act replaced all sectoral rules / DPDP अधिनियम ने सभी सेक्टोरल नियमों को बदल दिया"},{"en":"Sectoral rules only apply to government data","hi":"सेक्टोरल नियम केवल सरकारी डेटा पर लागू होते हैं"}],"a":{"en":"No. Sectoral requirements apply separately to covered data (e.g., RBI's payment-system data storage directions). The DPDP Act is a broader framework for processing digital personal data","hi":"नहीं। सेक्टोरल आवश्यकताएं (Sectoral requirements) कवर किए गए डेटा पर अलग से लागू हो सकती हैं (जैसे, RBI के भुगतान-प्रणाली डेटा भंडारण निर्देश)। DPDP अधिनियम डिजिटल व्यक्तिगत डेटा प्रोसेसिंग का एक व्यापक ढांचा (broader framework) है"},"exp":{"en":"Sectoral regulations target specific industries (like banking or telecom), while the DPDP Act provides general baseline privacy rules for personal data processing across most sectors.\nSource-note (Hinglish): Sectoral requirements covered data par alag apply ho sakti hain. RBI payment-system data storage directions ek example hain. DPDP Act digital personal data processing ka broader framework hai.","hi":"सेक्टोरल विनियम (Sectoral regulations) विशिष्ट उद्योगों (जैसे बैंकिंग या टेलीकॉम) को लक्षित करते हैं, जबकि DPDP अधिनियम अधिकांश क्षेत्रों में व्यक्तिगत डेटा प्रोसेसिंग के लिए सामान्य आधारभूत गोपनीयता नियम प्रदान करता है।"},"source_docx_q":24,"id":"q24","num":24},{"q":{"en":"How should the National Data Governance Framework Policy be remembered?","hi":"राष्ट्रीय डेटा शासन रूपरेखा नीति (National Data Governance Framework Policy) को कैसे याद रखा जाना चाहिए?"},"o":[{"en":"As a strict localization law","hi":"एक सख्त लोकलाइजेशन कानून के रूप में"},{"en":"MeitY's 2022 draft relates to government data governance, access, and use of non-personal/anonymized data. It is inaccurate to cite it as a general data-localization statute / MeitY का 2022 का मसौदा (draft) सरकारी डेटा शासन, पहुंच और गैर-व्यक्तिगत/अनाम (non-personal/anonymized) डेटा के उपयोग से संबंधित है। इसे सामान्य डेटा-लोकलाइजेशन क़ानून (statute) के रूप में उद्धृत करना गलत होगा","hi":"MeitY's 2022 draft relates to government data governance, access, and use of non-personal/anonymized data. It is inaccurate to cite it as a general data-localization statute / MeitY का 2022 का मसौदा (draft) सरकारी डेटा शासन, पहुंच और गैर-व्यक्तिगत/अनाम (non-personal/anonymized) डेटा के उपयोग से संबंधित है। इसे सामान्य डेटा-लोकलाइजेशन क़ानून (statute) के रूप में उद्धृत करना गलत होगा"},{"en":"As the new DPDP Act","hi":"नए DPDP अधिनियम के रूप में"},{"en":"As a policy for foreign data only","hi":"केवल विदेशी डेटा के लिए एक नीति के रूप में"}],"a":{"en":"MeitY's 2022 draft relates to government data governance, access, and use of non-personal/anonymized data. It is inaccurate to cite it as a general data-localization statute / MeitY का 2022 का मसौदा (draft) सरकारी डेटा शासन, पहुंच और गैर-व्यक्तिगत/अनाम (non-personal/anonymized) डेटा के उपयोग से संबंधित है। इसे सामान्य डेटा-लोकलाइजेशन क़ानून (statute) के रूप में उद्धृत करना गलत होगा","hi":"MeitY's 2022 draft relates to government data governance, access, and use of non-personal/anonymized data. It is inaccurate to cite it as a general data-localization statute / MeitY का 2022 का मसौदा (draft) सरकारी डेटा शासन, पहुंच और गैर-व्यक्तिगत/अनाम (non-personal/anonymized) डेटा के उपयोग से संबंधित है। इसे सामान्य डेटा-लोकलाइजेशन क़ानून (statute) के रूप में उद्धृत करना गलत होगा"},"exp":{"en":"The NDGFP focuses heavily on maximizing data-driven governance and institutionalizing data sharing (especially non-personal data) for research and innovation, rather than imposing general data localization.\nSource-note (Hinglish): MeitY ka 2022 draft government data governance, access aur non-personal/anonymized data ke use se related hai. Ise general data-localization statute ke roop mein cite karna inaccurate hoga.","hi":"NDGFP सामान्य डेटा लोकलाइजेशन लागू करने के बजाय अनुसंधान और नवाचार के लिए डेटा साझाकरण (विशेष रूप से गैर-व्यक्तिगत डेटा) को अधिकतम करने पर बहुत अधिक ध्यान केंद्रित करता है।"},"source_docx_q":25,"id":"q25","num":25},{"q":{"en":"What is the full form and year of the DPDP Act?","hi":"DPDP अधिनियम का पूर्ण रूप और वर्ष क्या है?"},"o":[{"en":"Digital Privacy and Data Policy Act, 2022","hi":"Digital Privacy and Data Policy Act, 2022"},{"en":"Digital Personal Data Protection Act, 2023. Its Rules were notified in 2025 and commencement is phased","hi":"डिजिटल पर्सनल डेटा प्रोटेक्शन एक्ट (Digital Personal Data Protection Act), 2023। इसके नियम 2025 में अधिसूचित किए गए और इसकी शुरुआत चरणबद्ध (phased) है"},{"en":"Data Protection and Digital Privacy Act, 2024","hi":"Data Protection and Digital Privacy Act, 2024"},{"en":"Domestic Personal Data Processing Act, 2021","hi":"Domestic Personal Data Processing Act, 2021"}],"a":{"en":"Digital Personal Data Protection Act, 2023. Its Rules were notified in 2025 and commencement is phased","hi":"डिजिटल पर्सनल डेटा प्रोटेक्शन एक्ट (Digital Personal Data Protection Act), 2023। इसके नियम 2025 में अधिसूचित किए गए और इसकी शुरुआत चरणबद्ध (phased) है"},"exp":{"en":"The Act was passed in 2023, establishing the legal framework for processing digital personal data in India.\nSource-note (Hinglish): Digital Personal Data Protection Act, 2023. Iske Rules 2025 mein notify huye aur commencement phased hai.","hi":"यह अधिनियम 2023 में पारित किया गया था, जो भारत में डिजिटल व्यक्तिगत डेटा को प्रोसेस करने के लिए कानूनी ढांचा (legal framework) स्थापित करता है।"},"source_docx_q":26,"id":"q26","num":26},{"q":{"en":"Who are the Data Principal, Data Fiduciary, and Data Processor in the DPDP Act?","hi":"DPDP अधिनियम में डेटा प्रिंसिपल (Data Principal), डेटा फिड्यूशरी (Data Fiduciary) और डेटा प्रोसेसर (Data Processor) कौन हैं?"},"o":[{"en":"Principal = Company; Fiduciary = Government; Processor = Computer","hi":"प्रिंसिपल = कंपनी; फिड्यूशरी = सरकार; प्रोसेसर = कंप्यूटर"},{"en":"Principal = The individual whose personal data it is. Fiduciary = The one determining the purpose and means of processing. Processor = The one processing on behalf of the fiduciary","hi":"प्रिंसिपल = वह व्यक्ति जिसका व्यक्तिगत डेटा है। फिड्यूशरी = वह जो प्रोसेसिंग के उद्देश्य और साधनों को निर्धारित करता है। प्रोसेसर = वह जो फिड्यूशरी की ओर से प्रोसेस करता है"},{"en":"Principal = CEO; Fiduciary = Lawyer; Processor = IT Guy","hi":"प्रिंसिपल = सीईओ; फिड्यूशरी = वकील; प्रोसेसर = आईटी बॉय"},{"en":"They all mean the same thing","hi":"उन सबका एक ही अर्थ है"}],"a":{"en":"Principal = The individual whose personal data it is. Fiduciary = The one determining the purpose and means of processing. Processor = The one processing on behalf of the fiduciary","hi":"प्रिंसिपल = वह व्यक्ति जिसका व्यक्तिगत डेटा है। फिड्यूशरी = वह जो प्रोसेसिंग के उद्देश्य और साधनों को निर्धारित करता है। प्रोसेसर = वह जो फिड्यूशरी की ओर से प्रोसेस करता है"},"exp":{"en":"These are the three foundational roles defined in the Act to establish rights, responsibilities, and liabilities regarding personal data.\nSource-note (Hinglish): Principal = individual jiska personal data hai. Fiduciary = jo processing ka purpose aur means determine karta hai. Processor = jo fiduciary ke behalf par process karta hai.","hi":"व्यक्तिगत डेटा के संबंध में अधिकार, जिम्मेदारियां और देनदारियां (liabilities) स्थापित करने के लिए अधिनियम में परिभाषित ये तीन मूलभूत भूमिकाएँ हैं।"},"source_docx_q":27,"id":"q27","num":27},{"q":{"en":"What are the core features of consent in the DPDP Act?","hi":"DPDP अधिनियम में सहमति (consent) की मुख्य विशेषताएं क्या हैं?"},"o":[{"en":"It can be assumed","hi":"इसे मान लिया जा सकता है"},{"en":"It must be free, specific, informed, unconditional, and unambiguous, with a clear affirmative action. Withdrawal should be as easy as giving it. The Act also recognizes specified legitimate uses","hi":"यह स्पष्ट सकारात्मक कार्रवाई (clear affirmative action) के साथ स्वतंत्र, विशिष्ट, सूचित, बिना शर्त और स्पष्ट (unambiguous) होनी चाहिए। वापसी (Withdrawal) देना भी उतना ही आसान होना चाहिए। अधिनियम कुछ निर्दिष्ट वैध उपयोगों (legitimate uses) को भी मान्यता देता है"},{"en":"It is only required for children","hi":"यह केवल बच्चों के लिए आवश्यक है"},{"en":"It must be renewed daily","hi":"इसे रोज़ाना नवीनीकृत (renew) किया जाना चाहिए"}],"a":{"en":"It must be free, specific, informed, unconditional, and unambiguous, with a clear affirmative action. Withdrawal should be as easy as giving it. The Act also recognizes specified legitimate uses","hi":"यह स्पष्ट सकारात्मक कार्रवाई (clear affirmative action) के साथ स्वतंत्र, विशिष्ट, सूचित, बिना शर्त और स्पष्ट (unambiguous) होनी चाहिए। वापसी (Withdrawal) देना भी उतना ही आसान होना चाहिए। अधिनियम कुछ निर्दिष्ट वैध उपयोगों (legitimate uses) को भी मान्यता देता है"},"exp":{"en":"The DPDP Act sets a high bar for valid consent, ensuring individuals truly understand and agree to how their data will be used.\nSource-note (Hinglish): Free, specific, informed, unconditional aur unambiguous consent, clear affirmative action ke saath. Withdrawal dene jitna aasaan hona chahiye. Act kuch specified legitimate uses bhi recognize karta hai.","hi":"DPDP अधिनियम वैध सहमति (valid consent) के लिए एक उच्च मानक (high bar) निर्धारित करता है, यह सुनिश्चित करता है कि व्यक्ति वास्तव में समझें और सहमत हों कि उनके डेटा का उपयोग कैसे किया जाएगा।"},"source_docx_q":28,"id":"q28","num":28},{"q":{"en":"What is the statutory role of a Consent Manager?","hi":"सहमति प्रबंधक (Consent Manager) की वैधानिक भूमिका (statutory role) क्या है?"},"o":[{"en":"To collect taxes","hi":"टैक्स वसूलना"},{"en":"To support the Data Principal in giving, managing, reviewing, and withdrawing consent. In the Act, a Consent Manager is registered with the Data Protection Board","hi":"डेटा प्रिंसिपल (Data Principal) को सहमति देने, प्रबंधित करने, समीक्षा करने और वापस लेने में सहायता करना। अधिनियम में, एक सहमति प्रबंधक (Consent Manager) डेटा प्रोटेक्शन बोर्ड के साथ पंजीकृत (registered) होता है"},{"en":"To manage company passwords","hi":"कंपनी के पासवर्ड प्रबंधित करना"},{"en":"To sell data to third parties","hi":"तीसरे पक्षों (third parties) को डेटा बेचना"}],"a":{"en":"To support the Data Principal in giving, managing, reviewing, and withdrawing consent. In the Act, a Consent Manager is registered with the Data Protection Board","hi":"डेटा प्रिंसिपल (Data Principal) को सहमति देने, प्रबंधित करने, समीक्षा करने और वापस लेने में सहायता करना। अधिनियम में, एक सहमति प्रबंधक (Consent Manager) डेटा प्रोटेक्शन बोर्ड के साथ पंजीकृत (registered) होता है"},"exp":{"en":"Consent Managers act as a centralized, accessible platform for users to exercise control over their consent preferences across various entities.\nSource-note (Hinglish): Data Principal ko consent give, manage, review aur withdraw karne mein support karta hai. Act mein Consent Manager Data Protection Board ke saath registered hota hai.","hi":"सहमति प्रबंधक उपयोगकर्ताओं के लिए विभिन्न संस्थाओं में अपनी सहमति प्राथमिकताओं (consent preferences) पर नियंत्रण रखने के लिए एक केंद्रीकृत (centralized), सुलभ मंच (platform) के रूप में कार्य करते हैं।"},"source_docx_q":29,"id":"q29","num":29},{"q":{"en":"How does Section 16 of the DPDP Act address cross-border data transfers?","hi":"DPDP अधिनियम की धारा 16 सीमा-पार डेटा ट्रांसफर (cross-border data transfers) को कैसे संबोधित करती है?"},"o":[{"en":"It bans all international transfers","hi":"यह सभी अंतर्राष्ट्रीय ट्रांसफर पर प्रतिबंध लगाता है"},{"en":"The Central Government may restrict transfers to notified countries or territories. More protective applicable laws may continue. Section 16 does NOT prescribe blanket prior approval for every international transfer","hi":"केंद्र सरकार अधिसूचित देशों या क्षेत्रों में ट्रांसफर को प्रतिबंधित (restrict) कर सकती है। अधिक सुरक्षात्मक लागू कानून (More protective applicable laws) जारी रह सकते हैं। धारा 16 हर अंतरराष्ट्रीय ट्रांसफर के लिए व्यापक पूर्व अनुमोदन (blanket prior approval) निर्धारित नहीं करती है"},{"en":"It allows transfers only to the USA","hi":"यह केवल USA को ट्रांसफर की अनुमति देता है"},{"en":"It requires the user to travel with their data","hi":"इसके लिए उपयोगकर्ता को अपने डेटा के साथ यात्रा करने की आवश्यकता है"}],"a":{"en":"The Central Government may restrict transfers to notified countries or territories. More protective applicable laws may continue. Section 16 does NOT prescribe blanket prior approval for every international transfer","hi":"केंद्र सरकार अधिसूचित देशों या क्षेत्रों में ट्रांसफर को प्रतिबंधित (restrict) कर सकती है। अधिक सुरक्षात्मक लागू कानून (More protective applicable laws) जारी रह सकते हैं। धारा 16 हर अंतरराष्ट्रीय ट्रांसफर के लिए व्यापक पूर्व अनुमोदन (blanket prior approval) निर्धारित नहीं करती है"},"exp":{"en":"India adopted a 'negative list' approach, generally allowing cross-border data flows except to countries explicitly blacklisted by the government.\nSource-note (Hinglish): Central Government notified countries ya territories ko transfers restrict kar sakti hai. More protective applicable laws continue kar sakte hain. Section 16 har international transfer ke liye blanket prior approval prescribe nahin karta.","hi":"भारत ने 'नकारात्मक सूची' (negative list) दृष्टिकोण अपनाया, आम तौर पर सीमा पार डेटा प्रवाह की अनुमति दी, उन देशों को छोड़कर जिन्हें सरकार द्वारा स्पष्ट रूप से ब्लैकलिस्ट किया गया है।"},"source_docx_q":30,"id":"q30","num":30},{"q":{"en":"What is the scope of the rights to correction and erasure in the DPDP Act?","hi":"DPDP अधिनियम में सुधार (correction) और मिटाने (erasure) के अधिकारों का दायरा क्या है?"},"o":[{"en":"They don't exist","hi":"उनका अस्तित्व नहीं है"},{"en":"The Act allows requesting correction, completion, updating, and erasure of eligible personal data. Legal retention or specified purpose may limit erasure","hi":"अधिनियम पात्र (eligible) व्यक्तिगत डेटा को सुधारने, पूरा करने, अपडेट करने और मिटाने (erasure) का अनुरोध करने की अनुमति देता है। कानूनी अवधारण (Legal retention) या निर्दिष्ट उद्देश्य मिटाने (erasure) को सीमित कर सकता है"},{"en":"Only the government can erase data","hi":"केवल सरकार ही डेटा मिटा सकती है"},{"en":"Data can never be corrected once saved","hi":"सहेजे जाने के बाद डेटा को कभी भी ठीक नहीं किया जा सकता है"}],"a":{"en":"The Act allows requesting correction, completion, updating, and erasure of eligible personal data. Legal retention or specified purpose may limit erasure","hi":"अधिनियम पात्र (eligible) व्यक्तिगत डेटा को सुधारने, पूरा करने, अपडेट करने और मिटाने (erasure) का अनुरोध करने की अनुमति देता है। कानूनी अवधारण (Legal retention) या निर्दिष्ट उद्देश्य मिटाने (erasure) को सीमित कर सकता है"},"exp":{"en":"While individuals have rights to correct or delete their data, Fiduciaries can deny erasure if keeping the data is necessary for the original purpose or required by law.\nSource-note (Hinglish): Act mein eligible personal data ki correction, completion, updating aur erasure request ki ja sakti hai. Legal retention ya specified purpose erasure ko limit kar sakte hain.","hi":"हालांकि व्यक्तियों को अपने डेटा को सही करने या हटाने का अधिकार है, यदि डेटा रखना मूल उद्देश्य के लिए आवश्यक है या कानून द्वारा आवश्यक है, तो फिड्यूशियरी (Fiduciary) मिटाने से इनकार कर सकते हैं।"},"source_docx_q":31,"id":"q31","num":31},{"q":{"en":"What is the breach-reporting timing under Rule 7 of the DPDP Rules 2025?","hi":"DPDP नियम 2025 के नियम 7 के तहत ब्रीच-रिपोर्टिंग टाइमिंग (breach-reporting timing) क्या है?"},"o":[{"en":"1 year / 1 साल","hi":"1 year / 1 साल"},{"en":"Initial notice to affected individuals and the Board 'without delay' once the Rule applies. Further details to the Board normally within 72 hours of awareness, or within a Board-approved longer period","hi":"नियम लागू होने पर प्रभावित व्यक्तियों और बोर्ड को 'बिना किसी देरी' के प्रारंभिक सूचना (Initial notice)। जागरूकता (awareness) के 72 घंटों के भीतर, या बोर्ड द्वारा अनुमोदित लंबी अवधि के भीतर बोर्ड को और विवरण"},{"en":"Only if asked","hi":"केवल तभी जब पूछा जाए"},{"en":"Immediately to the police","hi":"तुरंत पुलिस को"}],"a":{"en":"Initial notice to affected individuals and the Board 'without delay' once the Rule applies. Further details to the Board normally within 72 hours of awareness, or within a Board-approved longer period","hi":"नियम लागू होने पर प्रभावित व्यक्तियों और बोर्ड को 'बिना किसी देरी' के प्रारंभिक सूचना (Initial notice)। जागरूकता (awareness) के 72 घंटों के भीतर, या बोर्ड द्वारा अनुमोदित लंबी अवधि के भीतर बोर्ड को और विवरण"},"exp":{"en":"The rules mandate immediate initial notification upon discovering a breach, followed by a more detailed report within 72 hours.\nSource-note (Hinglish): Rule ke apply hone par affected individuals aur Board ko initial notice without delay. Board ko further details awareness se 72 hours ke andar, ya Board-approved longer period mein.","hi":"नियम किसी उल्लंघन (breach) का पता चलने पर तत्काल प्रारंभिक अधिसूचना (initial notification) को अनिवार्य करते हैं, जिसके बाद 72 घंटों के भीतर अधिक विस्तृत रिपोर्ट दी जाती है।"},"source_docx_q":32,"id":"q32","num":32},{"q":{"en":"How does the 72-hour provision of Rule 7 differ from CERT-In's 6-hour provision?","hi":"नियम 7 का 72-घंटे का प्रावधान CERT-In के 6-घंटे के प्रावधान से कैसे भिन्न है?"},"o":[{"en":"There is no difference","hi":"कोई अंतर नहीं है"},{"en":"The 72 hours are for further Board details under DPDP Rule 7 (which is in the 18-month phased commencement group). The CERT-In Directions 2022 require reporting specified cyber incidents to CERT-In within 6 hours of noticing or being brought to notice / 72 घंटे DPDP नियम 7 (जो 18-महीने के चरणबद्ध शुरुआत समूह में है) के तहत आगे के बोर्ड विवरण के लिए हैं। CERT-In निर्देश 2022 में निर्दिष्ट साइबर घटनाओं (specified cyber incidents) को नोटिस होने या नोटिस में लाये जाने के 6 घंटे के भीतर CERT-In को रिपोर्ट करना आवश्यक है","hi":"The 72 hours are for further Board details under DPDP Rule 7 (which is in the 18-month phased commencement group). The CERT-In Directions 2022 require reporting specified cyber incidents to CERT-In within 6 hours of noticing or being brought to notice / 72 घंटे DPDP नियम 7 (जो 18-महीने के चरणबद्ध शुरुआत समूह में है) के तहत आगे के बोर्ड विवरण के लिए हैं। CERT-In निर्देश 2022 में निर्दिष्ट साइबर घटनाओं (specified cyber incidents) को नोटिस होने या नोटिस में लाये जाने के 6 घंटे के भीतर CERT-In को रिपोर्ट करना आवश्यक है"},{"en":"CERT-In gives 72 hours, DPDP gives 6 hours / CERT-In 72 घंटे देता है, DPDP 6 घंटे देता है","hi":"CERT-In gives 72 hours, DPDP gives 6 hours / CERT-In 72 घंटे देता है, DPDP 6 घंटे देता है"},{"en":"Rule 7 is only for banks","hi":"नियम 7 केवल बैंकों के लिए है"}],"a":{"en":"The 72 hours are for further Board details under DPDP Rule 7 (which is in the 18-month phased commencement group). The CERT-In Directions 2022 require reporting specified cyber incidents to CERT-In within 6 hours of noticing or being brought to notice / 72 घंटे DPDP नियम 7 (जो 18-महीने के चरणबद्ध शुरुआत समूह में है) के तहत आगे के बोर्ड विवरण के लिए हैं। CERT-In निर्देश 2022 में निर्दिष्ट साइबर घटनाओं (specified cyber incidents) को नोटिस होने या नोटिस में लाये जाने के 6 घंटे के भीतर CERT-In को रिपोर्ट करना आवश्यक है","hi":"The 72 hours are for further Board details under DPDP Rule 7 (which is in the 18-month phased commencement group). The CERT-In Directions 2022 require reporting specified cyber incidents to CERT-In within 6 hours of noticing or being brought to notice / 72 घंटे DPDP नियम 7 (जो 18-महीने के चरणबद्ध शुरुआत समूह में है) के तहत आगे के बोर्ड विवरण के लिए हैं। CERT-In निर्देश 2022 में निर्दिष्ट साइबर घटनाओं (specified cyber incidents) को नोटिस होने या नोटिस में लाये जाने के 6 घंटे के भीतर CERT-In को रिपोर्ट करना आवश्यक है"},"exp":{"en":"CERT-In focuses on rapid, operational cybersecurity reporting (6 hours), while DPDP focuses on detailed privacy impact reporting (72 hours).\nSource-note (Hinglish): 72 hours DPDP Rule 7 ke further Board details ke liye hain, aur Rule 7 phased commencement ke 18-month group mein hai. CERT-In Directions 2022 specified cyber incidents ko notice hone ya notice mein laaye jaane se 6 hours mein CERT-In report karne ko kehti hain.","hi":"CERT-In त्वरित, परिचालन साइबर सुरक्षा रिपोर्टिंग (6 घंटे) पर ध्यान केंद्रित करता है, जबकि DPDP विस्तृत गोपनीयता प्रभाव रिपोर्टिंग (72 घंटे) पर ध्यान केंद्रित करता है।"},"source_docx_q":33,"id":"q33","num":33},{"q":{"en":"What are the extra obligations of a Significant Data Fiduciary (SDF)?","hi":"एक महत्वपूर्ण डेटा फिड्यूशरी (Significant Data Fiduciary - SDF) के अतिरिक्त दायित्व (obligations) क्या हैं?"},"o":[{"en":"They pay double taxes","hi":"वे दोगुना कर (taxes) देते हैं"},{"en":"Duties for a government-designated SDF include an India-based Data Protection Officer (DPO), independent auditor, periodic impact assessment, and audits. The Rules also specify algorithmic due diligence. These do not automatically apply to all fiduciaries","hi":"सरकार द्वारा नामित SDF के कर्तव्यों में भारत-आधारित डेटा संरक्षण अधिकारी (DPO), स्वतंत्र ऑडिटर, आवधिक प्रभाव मूल्यांकन (periodic impact assessment) और ऑडिट शामिल हैं। नियम एल्गोरिथम उचित परिश्रम (algorithmic due diligence) भी निर्दिष्ट करते हैं। ये स्वचालित रूप से सभी फिड्यूशरी पर लागू नहीं होते हैं"},{"en":"They must store data on paper","hi":"उन्हें कागज़ पर डेटा संग्रहीत करना चाहिए"},{"en":"No extra obligations","hi":"कोई अतिरिक्त दायित्व नहीं"}],"a":{"en":"Duties for a government-designated SDF include an India-based Data Protection Officer (DPO), independent auditor, periodic impact assessment, and audits. The Rules also specify algorithmic due diligence. These do not automatically apply to all fiduciaries","hi":"सरकार द्वारा नामित SDF के कर्तव्यों में भारत-आधारित डेटा संरक्षण अधिकारी (DPO), स्वतंत्र ऑडिटर, आवधिक प्रभाव मूल्यांकन (periodic impact assessment) और ऑडिट शामिल हैं। नियम एल्गोरिथम उचित परिश्रम (algorithmic due diligence) भी निर्दिष्ट करते हैं। ये स्वचालित रूप से सभी फिड्यूशरी पर लागू नहीं होते हैं"},"exp":{"en":"SDFs are entities handling large volumes or sensitive data, and thus are held to stricter accountability and compliance standards under the DPDP Act.\nSource-note (Hinglish): Government-designated SDF ke liye India-based DPO, independent auditor, periodic impact assessment aur audits jaise duties hain. Rules mein specified algorithmic due diligence bhi hai. Ye duties sabhi fiduciaries par automatically apply nahin hoti.","hi":"SDF ऐसी संस्थाएं हैं जो बड़ी मात्रा में या संवेदनशील डेटा को संभालती हैं, और इस प्रकार DPDP अधिनियम के तहत उन्हें सख्त जवाबदेही (accountability) और अनुपालन (compliance) मानकों के लिए उत्तरदायी ठहराया जाता है।"},"source_docx_q":34,"id":"q34","num":34},{"q":{"en":"What were India's ranks in the WIPO Global Innovation Index in 2013 and 2024?","hi":"2013 और 2024 में WIPO ग्लोबल इनोवेशन इंडेक्स (Global Innovation Index) में भारत की रैंक क्या थी?"},"o":[{"en":"1st in both","hi":"दोनों में प्रथम"},{"en":"66th in 2013, and 39th in 2024. The PDF's figure of 65th for 2013 is corrected based on WIPO's report. These ranks do not establish a causal effect of a single policy / 2013 में 66वाँ और 2024 में 39वाँ। 2013 के लिए PDF का 65वाँ आंकड़ा WIPO की रिपोर्ट के आधार पर सही किया गया है। ये रैंक किसी एक नीति के कारण प्रभाव (causal effect) को स्थापित नहीं करते हैं","hi":"66th in 2013, and 39th in 2024. The PDF's figure of 65th for 2013 is corrected based on WIPO's report. These ranks do not establish a causal effect of a single policy / 2013 में 66वाँ और 2024 में 39वाँ। 2013 के लिए PDF का 65वाँ आंकड़ा WIPO की रिपोर्ट के आधार पर सही किया गया है। ये रैंक किसी एक नीति के कारण प्रभाव (causal effect) को स्थापित नहीं करते हैं"},{"en":"100th in 2013, 50th in 2024","hi":"100th in 2013, 50th in 2024"},{"en":"They remained unchanged","hi":"वे अपरिवर्तित रहे"}],"a":{"en":"66th in 2013, and 39th in 2024. The PDF's figure of 65th for 2013 is corrected based on WIPO's report. These ranks do not establish a causal effect of a single policy / 2013 में 66वाँ और 2024 में 39वाँ। 2013 के लिए PDF का 65वाँ आंकड़ा WIPO की रिपोर्ट के आधार पर सही किया गया है। ये रैंक किसी एक नीति के कारण प्रभाव (causal effect) को स्थापित नहीं करते हैं","hi":"66th in 2013, and 39th in 2024. The PDF's figure of 65th for 2013 is corrected based on WIPO's report. These ranks do not establish a causal effect of a single policy / 2013 में 66वाँ और 2024 में 39वाँ। 2013 के लिए PDF का 65वाँ आंकड़ा WIPO की रिपोर्ट के आधार पर सही किया गया है। ये रैंक किसी एक नीति के कारण प्रभाव (causal effect) को स्थापित नहीं करते हैं"},"exp":{"en":"India has significantly improved its innovation ranking over the last decade, jumping from 66th to 39th place globally.\nSource-note (Hinglish): 2013 mein 66th aur 2024 mein 39th. PDF ka 2013 ka 65th figure WIPO ke report se correct kiya gaya hai. In ranks se kisi ek policy ka causal effect establish nahin hota.","hi":"भारत ने पिछले एक दशक में अपनी नवाचार (innovation) रैंकिंग में काफी सुधार किया है, जो विश्व स्तर पर 66वें से 39वें स्थान पर पहुंच गया है।"},"source_docx_q":35,"id":"q35","num":35},{"q":{"en":"How reliable is the PDF's claim that 'more than 70% of organizations stored data on foreign servers'?","hi":"PDF का यह दावा कितना विश्वसनीय है कि '70% से अधिक संगठनों ने विदेशी सर्वरों पर डेटा संग्रहीत किया'?"},"o":[{"en":"It is a certified government fact","hi":"यह एक प्रमाणित सरकारी तथ्य है"},{"en":"The slide does not identify the survey, year, or sample. Do not use this percentage as a verified national statistic","hi":"स्लाइड सर्वेक्षण (survey), वर्ष या नमूने (sample) की पहचान नहीं करती है। इस प्रतिशत को सत्यापित राष्ट्रीय सांख्यिकी (verified national statistic) के रूप में उपयोग न करें"},{"en":"It means 70% of the world's data is in India","hi":"इसका मतलब है कि दुनिया का 70% डेटा भारत में है"},{"en":"It is entirely false","hi":"यह पूरी तरह से गलत है"}],"a":{"en":"The slide does not identify the survey, year, or sample. Do not use this percentage as a verified national statistic","hi":"स्लाइड सर्वेक्षण (survey), वर्ष या नमूने (sample) की पहचान नहीं करती है। इस प्रतिशत को सत्यापित राष्ट्रीय सांख्यिकी (verified national statistic) के रूप में उपयोग न करें"},"exp":{"en":"Claims presented in slide decks without source attribution (like survey name, date, sample size) should not be treated as objective, verified facts in exams.\nSource-note (Hinglish): Slide par survey, year aur sample identify nahin hain. Is percentage ko verified national statistic ke roop mein use na karein.","hi":"स्रोत एट्रिब्यूशन (जैसे सर्वेक्षण का नाम, तिथि, नमूना आकार) के बिना स्लाइड डेक में प्रस्तुत दावों को परीक्षाओं में वस्तुनिष्ठ, सत्यापित तथ्यों के रूप में नहीं माना जाना चाहिए।"},"source_docx_q":36,"id":"q36","num":36}]},{"title":{"en":"4. Zoho Mail, Docs, WorkDrive & Show","hi":"4. ज़ोहो मेल, डॉक्स, वर्कड्राइव और शो"},"questions":[{"q":{"en":"What is Zoho Mail used for?","hi":"ज़ोहो मेल (Zoho Mail) का उपयोग किस लिए किया जाता है?"},"o":[{"en":"Watching movies","hi":"फिल्में देखने के लिए"},{"en":"Official/business email, spam filtering, contacts, calendar, and task integration. The PDF screenshot shows desktop and mobile views","hi":"आधिकारिक/व्यावसायिक ईमेल (Official/business email), स्पैम फ़िल्टरिंग, संपर्क, कैलेंडर और टास्क एकीकरण (integration)। PDF का स्क्रीनशॉट डेस्कटॉप और मोबाइल दृश्य (views) दिखाता है"},{"en":"Building websites","hi":"वेबसाइट बनाने के लिए"},{"en":"Accounting","hi":"लेखांकन (Accounting) के लिए"}],"a":{"en":"Official/business email, spam filtering, contacts, calendar, and task integration. The PDF screenshot shows desktop and mobile views","hi":"आधिकारिक/व्यावसायिक ईमेल (Official/business email), स्पैम फ़िल्टरिंग, संपर्क, कैलेंडर और टास्क एकीकरण (integration)। PDF का स्क्रीनशॉट डेस्कटॉप और मोबाइल दृश्य (views) दिखाता है"},"exp":{"en":"Zoho Mail is an enterprise-grade email hosting service known for its ad-free interface, integrated calendar, and extensive control panel for administrators.\nSource-note (Hinglish): Official/business email, spam filtering, contacts, calendar aur task integration. PDF ka screenshot desktop aur mobile views dikhata hai.","hi":"ज़ोहो मेल एक उद्यम-ग्रेड (enterprise-grade) ईमेल होस्टिंग सेवा है जो अपने विज्ञापन-मुक्त इंटरफ़ेस, एकीकृत कैलेंडर और प्रशासकों (administrators) के लिए व्यापक नियंत्रण कक्ष के लिए जानी जाती है।"},"source_docx_q":37,"id":"q37","num":37},{"q":{"en":"How do TLS and S/MIME differ in Zoho Mail?","hi":"ज़ोहो मेल में TLS और S/MIME कैसे भिन्न हैं?"},"o":[{"en":"They are the same","hi":"वे समान हैं"},{"en":"TLS protects the connection during transport. S/MIME can provide message-level signing/encryption with configured certificates. Available controls depend on the deployment and configuration / TLS ट्रांसपोर्ट के दौरान कनेक्शन की सुरक्षा करता है। S/MIME कॉन्फ़िगर किए गए प्रमाणपत्रों (certificates) के साथ संदेश-स्तरीय (message-level) हस्ताक्षर/एन्क्रिप्शन प्रदान कर सकता है। उपलब्ध नियंत्रण परिनियोजन (deployment) और कॉन्फ़िगरेशन पर निर्भर करते हैं","hi":"TLS protects the connection during transport. S/MIME can provide message-level signing/encryption with configured certificates. Available controls depend on the deployment and configuration / TLS ट्रांसपोर्ट के दौरान कनेक्शन की सुरक्षा करता है। S/MIME कॉन्फ़िगर किए गए प्रमाणपत्रों (certificates) के साथ संदेश-स्तरीय (message-level) हस्ताक्षर/एन्क्रिप्शन प्रदान कर सकता है। उपलब्ध नियंत्रण परिनियोजन (deployment) और कॉन्फ़िगरेशन पर निर्भर करते हैं"},{"en":"TLS is for photos, S/MIME is for text / TLS फोटो के लिए है, S/MIME टेक्स्ट के लिए है","hi":"TLS is for photos, S/MIME is for text / TLS फोटो के लिए है, S/MIME टेक्स्ट के लिए है"},{"en":"Neither is used","hi":"किसी का भी उपयोग नहीं किया जाता है"}],"a":{"en":"TLS protects the connection during transport. S/MIME can provide message-level signing/encryption with configured certificates. Available controls depend on the deployment and configuration / TLS ट्रांसपोर्ट के दौरान कनेक्शन की सुरक्षा करता है। S/MIME कॉन्फ़िगर किए गए प्रमाणपत्रों (certificates) के साथ संदेश-स्तरीय (message-level) हस्ताक्षर/एन्क्रिप्शन प्रदान कर सकता है। उपलब्ध नियंत्रण परिनियोजन (deployment) और कॉन्फ़िगरेशन पर निर्भर करते हैं","hi":"TLS protects the connection during transport. S/MIME can provide message-level signing/encryption with configured certificates. Available controls depend on the deployment and configuration / TLS ट्रांसपोर्ट के दौरान कनेक्शन की सुरक्षा करता है। S/MIME कॉन्फ़िगर किए गए प्रमाणपत्रों (certificates) के साथ संदेश-स्तरीय (message-level) हस्ताक्षर/एन्क्रिप्शन प्रदान कर सकता है। उपलब्ध नियंत्रण परिनियोजन (deployment) और कॉन्फ़िगरेशन पर निर्भर करते हैं"},"exp":{"en":"TLS secures the 'pipe' through which the email travels, preventing eavesdropping on the network. S/MIME secures the email content itself (end-to-end), requiring digital certificates.\nSource-note (Hinglish): TLS transport ke dauran connection protect karta hai. S/MIME configured certificates ke saath message-level signing/encryption de sakta hai. Available controls deployment aur configuration par depend karte hain.","hi":"TLS उस 'पाइप' को सुरक्षित करता है जिसके माध्यम से ईमेल यात्रा करता है, जिससे नेटवर्क पर छिपकर बातें सुनने (eavesdropping) को रोका जा सकता है। S/MIME ईमेल सामग्री को ही (एंड-टू-एंड) सुरक्षित करता है, जिसके लिए डिजिटल प्रमाणपत्र की आवश्यकता होती है।"},"source_docx_q":38,"id":"q38","num":38},{"q":{"en":"What is the relationship between Zoho Docs and Zoho WorkDrive?","hi":"ज़ोहो डॉक्स (Zoho Docs) और ज़ोहो वर्कड्राइव (Zoho WorkDrive) के बीच क्या संबंध है?"},"o":[{"en":"They are competitors","hi":"वे प्रतियोगी हैं"},{"en":"Zoho Docs was the legacy product. WorkDrive is the successor for team files, folders, permissions, version history, and sharing. Writer, Sheet, and Show are the respective editing apps","hi":"ज़ोहो डॉक्स लीगेसी उत्पाद (legacy product) था। वर्कड्राइव (WorkDrive) टीम फ़ाइलों, फ़ोल्डरों, अनुमतियों, संस्करण इतिहास (version history) और साझाकरण के लिए उत्तराधिकारी (successor) है। राइटर, शीट और शो संबंधित एडिटिंग ऐप हैं"},{"en":"Docs is for audio, WorkDrive is for video","hi":"डॉक्स ऑडियो के लिए है, वर्कड्राइव वीडियो के लिए है"},{"en":"WorkDrive replaced Zoho Mail","hi":"वर्कड्राइव ने ज़ोहो मेल को बदल दिया"}],"a":{"en":"Zoho Docs was the legacy product. WorkDrive is the successor for team files, folders, permissions, version history, and sharing. Writer, Sheet, and Show are the respective editing apps","hi":"ज़ोहो डॉक्स लीगेसी उत्पाद (legacy product) था। वर्कड्राइव (WorkDrive) टीम फ़ाइलों, फ़ोल्डरों, अनुमतियों, संस्करण इतिहास (version history) और साझाकरण के लिए उत्तराधिकारी (successor) है। राइटर, शीट और शो संबंधित एडिटिंग ऐप हैं"},"exp":{"en":"WorkDrive is Zoho's modern, team-focused cloud storage and file management platform, built to replace the older, individual-focused Zoho Docs.\nSource-note (Hinglish): Zoho Docs legacy product tha. WorkDrive team files, folders, permissions, version history aur sharing ka successor hai. Writer, Sheet aur Show respective editing apps hain.","hi":"वर्कड्राइव ज़ोहो का आधुनिक, टीम-केंद्रित क्लाउड स्टोरेज और फ़ाइल प्रबंधन प्लेटफ़ॉर्म है, जिसे पुराने, व्यक्तिगत-केंद्रित ज़ोहो डॉक्स को बदलने के लिए बनाया गया है।"},"source_docx_q":39,"id":"q39","num":39},{"q":{"en":"Which feature set best describes Zoho WorkDrive collaboration?","hi":"Zoho WorkDrive की सहयोग सुविधाओं का सही समूह कौन-सा है?"},"o":[{"en":"Only calendar and spam filtering","hi":"केवल कैलेंडर और स्पैम फ़िल्टरिंग"},{"en":"Team folders, access permissions, version history and real-time file collaboration","hi":"टीम फ़ोल्डर, एक्सेस अनुमति, वर्ज़न हिस्ट्री और रियल-टाइम सहयोग"},{"en":"Only slide transitions and animations","hi":"केवल स्लाइड ट्रांज़िशन और एनिमेशन"},{"en":"Only a personal offline file viewer","hi":"केवल व्यक्तिगत ऑफ़लाइन फ़ाइल व्यूअर"}],"exp":{"en":"WorkDrive supports team folders, folder organization, granular permissions, version history and collaborative editing through connected office apps.","hi":"WorkDrive में टीम फ़ोल्डर, व्यवस्थित फ़ाइलें, अलग-अलग अनुमतियाँ, वर्ज़न हिस्ट्री और Office ऐप्स से सहयोग मिलता है।"},"a":{"en":"Team folders, access permissions, version history and real-time file collaboration","hi":"टीम फ़ोल्डर, एक्सेस अनुमति, वर्ज़न हिस्ट्री और रियल-टाइम सहयोग"},"source_docx_q":null,"id":"q40","num":40},{"q":{"en":"Match Zoho Writer, Sheet and Show with the correct output types.","hi":"Zoho Writer, Sheet और Show को सही कार्यों से मिलाइए।"},"o":[{"en":"Writer—spreadsheets; Sheet—presentations; Show—documents","hi":"Writer—स्प्रेडशीट; Sheet—प्रेज़ेंटेशन; Show—डॉक्यूमेंट"},{"en":"Writer—presentations; Sheet—documents; Show—spreadsheets","hi":"Writer—प्रेज़ेंटेशन; Sheet—डॉक्यूमेंट; Show—स्प्रेडशीट"},{"en":"Writer—documents; Sheet—spreadsheets; Show—presentations","hi":"Writer—डॉक्यूमेंट; Sheet—स्प्रेडशीट; Show—प्रेज़ेंटेशन"},{"en":"Writer—email; Sheet—video calls; Show—database","hi":"Writer—ईमेल; Sheet—वीडियो कॉल; Show—डेटाबेस"}],"exp":{"en":"Zoho Writer is for documents, Sheet is for spreadsheets, and Show is for presentations.","hi":"Zoho Writer दस्तावेज़, Sheet स्प्रेडशीट और Show प्रस्तुतियाँ बनाने के लिए हैं।"},"a":{"en":"Writer—documents; Sheet—spreadsheets; Show—presentations","hi":"Writer—डॉक्यूमेंट; Sheet—स्प्रेडशीट; Show—प्रेज़ेंटेशन"},"source_docx_q":null,"id":"q41","num":41},{"q":{"en":"What is Zoho Show used for?","hi":"ज़ोहो शो (Zoho Show) का उपयोग किस लिए किया जाता है?"},"o":[{"en":"Writing code","hi":"कोड लिखने के लिए"},{"en":"Creating, collaborating on, and presenting slide decks (presentations) in a web browser, similar to PowerPoint or Google Slides","hi":"वेब ब्राउज़र में स्लाइड डेक (प्रस्तुतियाँ) बनाना, सहयोग करना और प्रस्तुत करना, पावरपॉइंट (PowerPoint) या Google Slides के समान"},{"en":"Managing databases","hi":"डेटाबेस के प्रबंधन के लिए"},{"en":"Editing photos","hi":"तस्वीरें संपादित करने के लिए"}],"a":{"en":"Creating, collaborating on, and presenting slide decks (presentations) in a web browser, similar to PowerPoint or Google Slides","hi":"वेब ब्राउज़र में स्लाइड डेक (प्रस्तुतियाँ) बनाना, सहयोग करना और प्रस्तुत करना, पावरपॉइंट (PowerPoint) या Google Slides के समान"},"exp":{"en":"Zoho Show is the presentation software within the Zoho Office Suite, designed for building and delivering professional slideshows online.\nSource-note (Hinglish): Cloud presentation editor, jisme slides create, co-edit, present aur publish kar sakte hain. Screenshot legacy Show 2.0 ka hai. Offline access supported app/mode par depend karta hai.","hi":"ज़ोहो शो ज़ोहो ऑफिस सूट (Zoho Office Suite) के भीतर प्रेजेंटेशन सॉफ्टवेयर है, जिसे ऑनलाइन पेशेवर स्लाइड शो बनाने और वितरित करने के लिए डिज़ाइन किया गया है।"},"source_docx_q":40,"id":"q42","num":42},{"q":{"en":"What context does the source give for education-ministry use of Zoho?","hi":"स्रोत में शिक्षा मंत्रालय से जुड़े Zoho उपयोग का संदर्भ क्या है?"},"o":[{"en":"Universal adoption by every ministry is conclusively proved","hi":"सभी मंत्रालयों में सार्वभौमिक उपयोग सिद्ध है"},{"en":"It concerns office-suite collaboration and document security; universal adoption is not established","hi":"यह ऑफिस-सूट सहयोग और दस्तावेज़ सुरक्षा से जुड़ा है; सभी मंत्रालयों का उपयोग सिद्ध नहीं"},{"en":"Zoho was used only for buying computer hardware","hi":"Zoho केवल कंप्यूटर हार्डवेयर खरीदने के लिए था"},{"en":"NIC email domains were permanently replaced by zoho.in","hi":"NIC ईमेल डोमेन हमेशा के लिए zoho.in हो गए"}],"exp":{"en":"The source links ministry-level office-suite direction to security and collaboration, but does not establish compulsory universal use by all ministries.","hi":"स्रोत मंत्रालय-स्तरीय ऑफिस-सूट दिशा को दस्तावेज़ सुरक्षा व सहयोग से जोड़ता है, लेकिन हर मंत्रालय के अनिवार्य उपयोग की पुष्टि नहीं करता।"},"a":{"en":"It concerns office-suite collaboration and document security; universal adoption is not established","hi":"यह ऑफिस-सूट सहयोग और दस्तावेज़ सुरक्षा से जुड़ा है; सभी मंत्रालयों का उपयोग सिद्ध नहीं"},"source_docx_q":null,"id":"q43","num":43},{"q":{"en":"Which mapping correctly describes Mail, WorkDrive and Show?","hi":"Zoho Mail, WorkDrive और Show का सही कार्य-मिलान क्या है?"},"o":[{"en":"Mail—presentations; WorkDrive—email; Show—team files","hi":"Mail—प्रेज़ेंटेशन; WorkDrive—ईमेल; Show—टीम फ़ाइलें"},{"en":"Mail—team files; WorkDrive—slides; Show—email","hi":"Mail—टीम फ़ाइलें; WorkDrive—स्लाइड; Show—ईमेल"},{"en":"Mail—communication; WorkDrive—team file/access management; Show—presentations","hi":"Mail—संचार; WorkDrive—टीम फ़ाइल व एक्सेस प्रबंधन; Show—प्रस्तुतियाँ"},{"en":"Mail—database queries; WorkDrive—routers; Show—antivirus","hi":"Mail—डेटाबेस क्वेरी; WorkDrive—राउटर; Show—एंटीवायरस"}],"exp":{"en":"Mail handles communication, WorkDrive manages collaborative files and access, and Show is a presentation application.","hi":"Mail संचार, WorkDrive साझा फ़ाइलें व एक्सेस प्रबंधन और Show प्रस्तुतियाँ संभालता है।"},"a":{"en":"Mail—communication; WorkDrive—team file/access management; Show—presentations","hi":"Mail—संचार; WorkDrive—टीम फ़ाइल व एक्सेस प्रबंधन; Show—प्रस्तुतियाँ"},"source_docx_q":null,"id":"q44","num":44}]},{"title":{"en":"5. DOCX Supplement — DBMS Basics & Database Models","hi":"5. DBMS की मूल बातें और डेटाबेस मॉडल"},"questions":[{"q":{"en":"How do data and information differ?","hi":"डेटा और सूचना में क्या अंतर है?"},"o":[{"en":"Data is processed and information is always raw","hi":"डेटा प्रोसेस्ड तथा सूचना हमेशा कच्ची होती है"},{"en":"Both terms always mean identical unprocessed facts","hi":"दोनों हमेशा एक ही असंसाधित तथ्य हैं"},{"en":"Information exists only as images","hi":"सूचना केवल चित्रों में होती है"},{"en":"Data is raw facts; information is meaningful processed data","hi":"डेटा कच्चे तथ्य हैं; सूचना उनका अर्थपूर्ण संसाधित रूप है"}],"exp":{"en":"Raw marks are data; a calculated class average is meaningful information derived from those marks.","hi":"कच्चे अंक डेटा हैं; उनसे निकाला गया कक्षा औसत अर्थपूर्ण सूचना है।"},"a":{"en":"Data is raw facts; information is meaningful processed data","hi":"डेटा कच्चे तथ्य हैं; सूचना उनका अर्थपूर्ण संसाधित रूप है"},"source_docx_q":null,"id":"q45","num":45},{"q":{"en":"Which are common drawbacks of traditional file-processing systems?","hi":"पारंपरिक फ़ाइल-प्रोसेसिंग सिस्टम की सामान्य कमियाँ कौन-सी हैं?"},"o":[{"en":"Redundancy, inconsistent copies, isolated data and difficult access","hi":"दोहराव, असंगत प्रतियाँ, अलग-थलग डेटा और कठिन पहुँच"},{"en":"Guaranteed consistency and perfect concurrent access","hi":"गारंटीकृत संगति और पूर्ण साझा पहुँच"},{"en":"Automatic enforcement of every integrity constraint","hi":"सभी इंटीग्रिटी नियमों का स्वतः पालन"},{"en":"No possibility of duplicated data","hi":"डेटा के दोहराव की कोई संभावना नहीं"}],"exp":{"en":"File-based systems can suffer from duplicate data, inconsistencies, data isolation, difficult access and weak shared controls.","hi":"फ़ाइल आधारित प्रणालियों में दोहराव, असंगति, डेटा अलगाव, कठिन पहुँच और कमज़ोर साझा नियंत्रण हो सकते हैं।"},"a":{"en":"Redundancy, inconsistent copies, isolated data and difficult access","hi":"दोहराव, असंगत प्रतियाँ, अलग-थलग डेटा और कठिन पहुँच"},"source_docx_q":null,"id":"q46","num":46},{"q":{"en":"Which statement correctly distinguishes a database from a DBMS?","hi":"डेटाबेस और DBMS में सही अंतर क्या है?"},"o":[{"en":"Database is a programming language; DBMS is a keyboard","hi":"डेटाबेस प्रोग्रामिंग भाषा; DBMS कीबोर्ड है"},{"en":"Database is organized related data; DBMS is software that defines, stores, queries and controls it","hi":"डेटाबेस व्यवस्थित संबंधित डेटा; DBMS उसे परिभाषित, संग्रहित, क्वेरी और नियंत्रित करने वाला सॉफ्टवेयर"},{"en":"Database means only raw text; DBMS means only hardware","hi":"डेटाबेस केवल रॉ टेक्स्ट; DBMS केवल हार्डवेयर"},{"en":"Database and DBMS are both operating-system kernels","hi":"डेटाबेस और DBMS दोनों ऑपरेटिंग सिस्टम कर्नेल हैं"}],"exp":{"en":"A database is the organized data collection; a Database Management System manages its definition, storage, access and controls.","hi":"डेटाबेस व्यवस्थित संबंधित डेटा का संग्रह है; DBMS उस डेटा को परिभाषित, स्टोर, एक्सेस और नियंत्रित करने वाला सॉफ्टवेयर है।"},"a":{"en":"Database is organized related data; DBMS is software that defines, stores, queries and controls it","hi":"डेटाबेस व्यवस्थित संबंधित डेटा; DBMS उसे परिभाषित, संग्रहित, क्वेरी और नियंत्रित करने वाला सॉफ्टवेयर"},"source_docx_q":null,"id":"q47","num":47},{"q":{"en":"Which combination lists common benefits of a properly configured DBMS?","hi":"सही तरह कॉन्फ़िगर किए DBMS के सामान्य लाभ क्या हैं?"},"o":[{"en":"More duplication and weaker access control","hi":"अधिक दोहराव और कमज़ोर एक्सेस नियंत्रण"},{"en":"Guaranteed immunity from every attack","hi":"हर साइबर हमले से पूर्ण सुरक्षा"},{"en":"Consistency, concurrent sharing, integrity, security and backup/recovery","hi":"संगति, साझा उपयोग, इंटीग्रिटी, सुरक्षा और बैकअप/रिकवरी"},{"en":"Eliminating all need for database administration","hi":"डेटाबेस प्रशासन की सारी ज़रूरत समाप्त"}],"exp":{"en":"DBMS designs can reduce redundancy and support concurrent sharing, integrity rules, security and backups, depending on configuration.","hi":"DBMS डिज़ाइन/कॉन्फ़िगरेशन के अनुसार दोहराव कम कर, संगति, साझा पहुँच, इंटीग्रिटी, सुरक्षा और बैकअप दे सकता है।"},"a":{"en":"Consistency, concurrent sharing, integrity, security and backup/recovery","hi":"संगति, साझा उपयोग, इंटीग्रिटी, सुरक्षा और बैकअप/रिकवरी"},"source_docx_q":null,"id":"q48","num":48},{"q":{"en":"Which of the following are examples of popular RDBMS?","hi":"निम्नलिखित में से कौन लोकप्रिय RDBMS के उदाहरण हैं?"},"o":[{"en":"Microsoft Word, Excel, PowerPoint","hi":"माइक्रोसॉफ्ट वर्ड, एक्सेल, पावरपॉइंट"},{"en":"MySQL, Oracle Database, Microsoft SQL Server, PostgreSQL / MySQL, Oracle Database, Microsoft SQL Server, PostgreSQL","hi":"MySQL, Oracle Database, Microsoft SQL Server, PostgreSQL / MySQL, Oracle Database, Microsoft SQL Server, PostgreSQL"},{"en":"Windows, Linux, macOS","hi":"विंडोज, लिनक्स, macOS"},{"en":"Chrome, Firefox, Safari","hi":"क्रोम, फ़ायरफ़ॉक्स, सफारी"}],"a":{"en":"MySQL, Oracle Database, Microsoft SQL Server, PostgreSQL / MySQL, Oracle Database, Microsoft SQL Server, PostgreSQL","hi":"MySQL, Oracle Database, Microsoft SQL Server, PostgreSQL / MySQL, Oracle Database, Microsoft SQL Server, PostgreSQL"},"exp":{"en":"These are some of the most common and widely used Relational Database Management Systems.\nSource-note (Hinglish): MySQL, PostgreSQL, Oracle Database, SQL Server, Access aur IBM Db2 relational examples hain. MongoDB document-oriented DBMS hai. FoxPro aur dBASE legacy database products hain.","hi":"ये कुछ सबसे आम और व्यापक रूप से उपयोग किए जाने वाले रिलेशनल डेटाबेस मैनेजमेंट सिस्टम हैं।"},"source_docx_q":49,"id":"q49","num":49},{"q":{"en":"What is the difference between a database schema and an instance?","hi":"डेटाबेस स्कीमा और इंस्टेंस में क्या अंतर है?"},"o":[{"en":"Schema is stored records at one time; instance is the permanent design","hi":"स्कीमा एक समय का डेटा; इंस्टेंस स्थायी डिज़ाइन है"},{"en":"Schema is logical design; instance is data stored at a particular time","hi":"स्कीमा तार्किक डिज़ाइन; इंस्टेंस किसी समय पर संग्रहीत डेटा है"},{"en":"Both refer only to database passwords","hi":"दोनों केवल डेटाबेस पासवर्ड हैं"},{"en":"Instance defines the SQL language standard","hi":"इंस्टेंस SQL भाषा का मानक परिभाषित करता है"}],"exp":{"en":"A schema describes the logical structure, whereas an instance is the actual database state at a given moment.","hi":"स्कीमा डेटाबेस की तार्किक संरचना है; इंस्टेंस किसी विशेष समय पर उसकी वास्तविक डेटा स्थिति है।"},"a":{"en":"Schema is logical design; instance is data stored at a particular time","hi":"स्कीमा तार्किक डिज़ाइन; इंस्टेंस किसी समय पर संग्रहीत डेटा है"},"source_docx_q":null,"id":"q50","num":50},{"q":{"en":"What is a DBA mainly responsible for?","hi":"DBA का पूरा नाम और मुख्य ज़िम्मेदारी क्या है?"},"o":[{"en":"Data Backup Application, used only to compress files","hi":"डेटा बैकअप एप्लिकेशन, केवल फ़ाइल संपीड़न"},{"en":"Database Analyst, who only enters marks","hi":"डेटाबेस एनालिस्ट, केवल अंक दर्ज करता है"},{"en":"Database Administrator, who manages access, backups, security, performance and maintenance","hi":"डेटाबेस एडमिनिस्ट्रेटर, जो एक्सेस, बैकअप, सुरक्षा, प्रदर्शन और रखरखाव संभालता है"},{"en":"Digital Browser Authority, which runs search engines","hi":"डिजिटल ब्राउज़र अथॉरिटी, जो सर्च इंजन चलाती है"}],"exp":{"en":"DBA means Database Administrator. This role manages users, permissions, backups, security, performance and maintenance.","hi":"DBA = Database Administrator, जो उपयोगकर्ता, अनुमति, बैकअप, सुरक्षा, प्रदर्शन और रखरखाव संभालता है।"},"a":{"en":"Database Administrator, who manages access, backups, security, performance and maintenance","hi":"डेटाबेस एडमिनिस्ट्रेटर, जो एक्सेस, बैकअप, सुरक्षा, प्रदर्शन और रखरखाव संभालता है"},"source_docx_q":null,"id":"q51","num":51},{"q":{"en":"What is a Hierarchical Database Model?","hi":"पदानुक्रमित डेटाबेस मॉडल (Hierarchical Database Model) क्या है?"},"o":[{"en":"Data is stored in independent tables","hi":"डेटा स्वतंत्र तालिकाओं (independent tables) में संग्रहीत किया जाता है"},{"en":"Data is organized in a tree-like structure with parent-child relationships, where each child record has only one parent","hi":"डेटा को पैरेंट-चाइल्ड रिलेशनशिप (parent-child relationships) के साथ एक पेड़ जैसी संरचना (tree-like structure) में व्यवस्थित किया जाता है, जहां प्रत्येक चाइल्ड रिकॉर्ड का केवल एक पैरेंट होता है"},{"en":"Data is stored without any relationships","hi":"डेटा बिना किसी संबंध के संग्रहीत किया जाता है"},{"en":"Data is organized as a web or graph","hi":"डेटा को एक वेब या ग्राफ के रूप में व्यवस्थित किया जाता है"}],"a":{"en":"Data is organized in a tree-like structure with parent-child relationships, where each child record has only one parent","hi":"डेटा को पैरेंट-चाइल्ड रिलेशनशिप (parent-child relationships) के साथ एक पेड़ जैसी संरचना (tree-like structure) में व्यवस्थित किया जाता है, जहां प्रत्येक चाइल्ड रिकॉर्ड का केवल एक पैरेंट होता है"},"exp":{"en":"In a hierarchical model, data is organized in a tree-like structure. A parent can have multiple children, but a child only has one parent.\nSource-note (Hinglish): Tree. Har child ke ek parent tak ka link hota hai, aur parent ke multiple children ho sakte hain.","hi":"पदानुक्रमित (hierarchical) मॉडल में, डेटा को पेड़ जैसी संरचना में व्यवस्थित किया जाता है। एक पैरेंट के कई चाइल्ड हो सकते हैं, लेकिन एक चाइल्ड का केवल एक पैरेंट होता है।"},"source_docx_q":45,"id":"q52","num":52},{"q":{"en":"How does a Network Database Model differ from a Hierarchical Model?","hi":"नेटवर्क डेटाबेस मॉडल (Network Database Model) पदानुक्रमित मॉडल (Hierarchical Model) से कैसे भिन्न है?"},"o":[{"en":"It stores data in tables","hi":"यह तालिकाओं (tables) में डेटा संग्रहीत करता है"},{"en":"It allows a child record to have multiple parent records, forming a graph-like structure rather than a strict tree","hi":"यह एक चाइल्ड रिकॉर्ड (child record) को कई पैरेंट रिकॉर्ड (multiple parent records) रखने की अनुमति देता है, जो एक सख्त पेड़ के बजाय ग्राफ जैसी संरचना (graph-like structure) बनाता है"},{"en":"It does not allow relationships between records","hi":"यह रिकॉर्ड के बीच संबंधों की अनुमति नहीं देता है"},{"en":"It is only used for online data","hi":"इसका उपयोग केवल ऑनलाइन डेटा के लिए किया जाता है"}],"a":{"en":"It allows a child record to have multiple parent records, forming a graph-like structure rather than a strict tree","hi":"यह एक चाइल्ड रिकॉर्ड (child record) को कई पैरेंट रिकॉर्ड (multiple parent records) रखने की अनुमति देता है, जो एक सख्त पेड़ के बजाय ग्राफ जैसी संरचना (graph-like structure) बनाता है"},"exp":{"en":"The network model expands on the hierarchical model by allowing many-to-many relationships in a tree-like structure that allows multiple parents.\nSource-note (Hinglish): Graph-like links mein ek record ke multiple parents ho sakte hain, jisse many-to-many associations model ki ja sakti hain.","hi":"नेटवर्क मॉडल पदानुक्रमित मॉडल का विस्तार करता है, जिससे पेड़ जैसी संरचना में कई-से-कई (many-to-many) संबंधों की अनुमति मिलती है जो कई पैरेंट की अनुमति देता है।"},"source_docx_q":46,"id":"q53","num":53},{"q":{"en":"Who proposed the relational database model, and in which year?","hi":"रिलेशनल डेटाबेस मॉडल किसने और कब प्रस्तावित किया?"},"o":[{"en":"Peter Chen, 1976","hi":"पीटर चेन, 1976"},{"en":"Charles Babbage, 1837","hi":"चार्ल्स बैबेज, 1837"},{"en":"E. F. Codd, 1970","hi":"ई. एफ. कॉड, 1970"},{"en":"Alan Turing, 1950","hi":"एलन ट्यूरिंग, 1950"}],"exp":{"en":"E. F. Codd proposed the relational model in 1970. It organizes data as relations (tables) with tuples and attributes.","hi":"ई. एफ. कॉड ने 1970 में रिलेशनल मॉडल प्रस्तावित किया; इसमें डेटा टेबल, टपल और एट्रिब्यूट के रूप में व्यवस्थित होता है।"},"a":{"en":"E. F. Codd, 1970","hi":"ई. एफ. कॉड, 1970"},"source_docx_q":null,"id":"q54","num":54},{"q":{"en":"How does an object-oriented database model represent data?","hi":"ऑब्जेक्ट-ओरिएंटेड डेटाबेस मॉडल डेटा कैसे दर्शाता है?"},"o":[{"en":"Only as unrelated plain-text files","hi":"केवल असंबंधित टेक्स्ट फ़ाइलें"},{"en":"As objects combining attributes/state with methods/behavior","hi":"ऐसे ऑब्जेक्ट जिनमें गुण/स्थिति और मेथड/व्यवहार होते हैं"},{"en":"Only as physical storage sectors","hi":"केवल भौतिक स्टोरेज सेक्टर"},{"en":"Only as spreadsheets without relationships","hi":"केवल बिना संबंध वाली स्प्रेडशीट"}],"exp":{"en":"An object-oriented database represents entities as objects with both state (attributes) and behavior (methods).","hi":"ऑब्जेक्ट-ओरिएंटेड डेटाबेस में ऑब्जेक्ट की स्थिति/गुण और व्यवहार/मेथड साथ मॉडल होते हैं।"},"a":{"en":"As objects combining attributes/state with methods/behavior","hi":"ऐसे ऑब्जेक्ट जिनमें गुण/स्थिति और मेथड/व्यवहार होते हैं"},"source_docx_q":null,"id":"q55","num":55},{"q":{"en":"Match relation, tuple, attribute and domain in a relational database.","hi":"रिलेशन, टपल, एट्रिब्यूट और डोमेन का सही मिलान कीजिए।"},"o":[{"en":"Relation=row; Tuple=table; Attribute=database; Domain=key","hi":"रिलेशन=रो; टपल=टेबल; एट्रिब्यूट=डेटाबेस; डोमेन=की"},{"en":"Relation=table; Tuple=row; Attribute=column; Domain=allowed values","hi":"रिलेशन=टेबल; टपल=रो; एट्रिब्यूट=कॉलम; डोमेन=स्वीकृत मान"},{"en":"Relation=column; Tuple=key; Attribute=row; Domain=table","hi":"रिलेशन=कॉलम; टपल=की; एट्रिब्यूट=रो; डोमेन=टेबल"},{"en":"Relation=server; Tuple=packet; Attribute=protocol; Domain=network","hi":"रिलेशन=सर्वर; टपल=पैकेट; एट्रिब्यूट=प्रोटोकॉल; डोमेन=नेटवर्क"}],"exp":{"en":"A relation is a table, tuple is a row, attribute is a column, and domain specifies the allowed atomic values for an attribute.","hi":"रिलेशन टेबल, टपल पंक्ति, एट्रिब्यूट कॉलम और डोमेन उस कॉलम के अनुमत एटॉमिक मानों का समूह है।"},"a":{"en":"Relation=table; Tuple=row; Attribute=column; Domain=allowed values","hi":"रिलेशन=टेबल; टपल=रो; एट्रिब्यूट=कॉलम; डोमेन=स्वीकृत मान"},"source_docx_q":null,"id":"q56","num":56},{"q":{"en":"A table has 4 columns and 30 rows. What are its degree and cardinality?","hi":"एक टेबल में 4 कॉलम और 30 पंक्तियाँ हैं। डिग्री तथा कार्डिनैलिटी क्या होंगी?"},"o":[{"en":"Degree 30; Cardinality 4","hi":"डिग्री 30; कार्डिनैलिटी 4"},{"en":"Degree 34; Cardinality 120","hi":"डिग्री 34; कार्डिनैलिटी 120"},{"en":"Degree 4; Cardinality 30","hi":"डिग्री 4; कार्डिनैलिटी 30"},{"en":"Degree 120; Cardinality 34","hi":"डिग्री 120; कार्डिनैलिटी 34"}],"exp":{"en":"Degree counts attributes/columns (4); cardinality counts tuples/rows (30).","hi":"डिग्री कॉलम/एट्रिब्यूट की संख्या 4 और कार्डिनैलिटी रो/टपल की संख्या 30 है।"},"a":{"en":"Degree 4; Cardinality 30","hi":"डिग्री 4; कार्डिनैलिटी 30"},"source_docx_q":null,"id":"q57","num":57},{"q":{"en":"What is a database?","hi":"डेटाबेस (database) क्या है?"},"o":[{"en":"A physical filing cabinet","hi":"एक भौतिक फाइलिंग कैबिनेट"},{"en":"A structured collection of data stored and accessed electronically","hi":"इलेक्ट्रॉनिक रूप से संग्रहीत और एक्सेस किए गए डेटा का एक संरचित संग्रह (structured collection)"},{"en":"A word processing software","hi":"एक वर्ड प्रोसेसिंग सॉफ्टवेयर"},{"en":"A computer virus","hi":"एक कंप्यूटर वायरस"}],"a":{"en":"A structured collection of data stored and accessed electronically","hi":"इलेक्ट्रॉनिक रूप से संग्रहीत और एक्सेस किए गए डेटा का एक संरचित संग्रह (structured collection)"},"exp":{"en":"A database is an organized collection of data, generally stored and accessed electronically from a computer system.","hi":"डेटाबेस डेटा का एक संगठित संग्रह है, जिसे आम तौर पर कंप्यूटर सिस्टम से इलेक्ट्रॉनिक रूप से संग्रहीत और एक्सेस किया जाता है।"},"id":"q98","num":98,"source_docx_q":41},{"q":{"en":"What is the primary function of a Database Management System (DBMS)?","hi":"डेटाबेस मैनेजमेंट सिस्टम (DBMS) का प्राथमिक कार्य क्या है?"},"o":[{"en":"To print documents","hi":"दस्तावेज़ प्रिंट करना"},{"en":"To provide an interface between users, applications, and the database itself to define, create, query, update, and manage data","hi":"उपयोगकर्ताओं (users), एप्लिकेशन और डेटाबेस के बीच डेटा को परिभाषित करने, बनाने, क्वेरी (query) करने, अपडेट करने और प्रबंधित करने के लिए एक इंटरफ़ेस प्रदान करना"},{"en":"To create hardware components","hi":"हार्डवेयर घटक बनाना"},{"en":"To connect computers to the internet","hi":"कंप्यूटर को इंटरनेट से जोड़ना"}],"a":{"en":"To provide an interface between users, applications, and the database itself to define, create, query, update, and manage data","hi":"उपयोगकर्ताओं (users), एप्लिकेशन और डेटाबेस के बीच डेटा को परिभाषित करने, बनाने, क्वेरी (query) करने, अपडेट करने और प्रबंधित करने के लिए एक इंटरफ़ेस प्रदान करना"},"exp":{"en":"A DBMS is software that interacts with end-users, applications, and the database itself to capture and analyze the data.","hi":"DBMS एक सॉफ्टवेयर है जो डेटा को कैप्चर और विश्लेषण करने के लिए एंड-यूज़र, एप्लिकेशन और डेटाबेस के साथ इंटरैक्ट करता है।"},"id":"q99","num":99,"source_docx_q":42},{"q":{"en":"How does a DBMS reduce data redundancy?","hi":"DBMS डेटा रिडंडेंसी (data redundancy - डेटा दोहराव) को कैसे कम करता है?"},"o":[{"en":"By deleting all data","hi":"सभी डेटा हटाकर"},{"en":"By storing a single, centralized copy of data, preventing the same information from being duplicated across multiple files","hi":"डेटा की एक केंद्रीकृत प्रति (centralized copy) को संग्रहीत करके, जिससे एक ही जानकारी को कई फ़ाइलों में डुप्लिकेट (duplicate) होने से रोका जा सके"},{"en":"By duplicating data on multiple servers","hi":"कई सर्वरों पर डेटा डुप्लिकेट करके"},{"en":"By converting data into binary code","hi":"डेटा को बाइनरी कोड में परिवर्तित करके"}],"a":{"en":"By storing a single, centralized copy of data, preventing the same information from being duplicated across multiple files","hi":"डेटा की एक केंद्रीकृत प्रति (centralized copy) को संग्रहीत करके, जिससे एक ही जानकारी को कई फ़ाइलों में डुप्लिकेट (duplicate) होने से रोका जा सके"},"exp":{"en":"Unlike flat-file systems where the same data might be saved in different department files, a DBMS centralizes data, minimizing duplication (redundancy).","hi":"फ्लैट-फाइल सिस्टम के विपरीत जहां एक ही डेटा को अलग-अलग विभाग की फाइलों में सहेजा जा सकता है, एक DBMS डेटा को केंद्रीकृत करता है, जिससे दोहराव (रिडंडेंसी) कम होता है।"},"id":"q100","num":100,"source_docx_q":43},{"q":{"en":"What does 'data consistency' mean in the context of a DBMS?","hi":"DBMS के संदर्भ में 'डेटा कंसिस्टेंसी' (data consistency - डेटा स्थिरता) का क्या अर्थ है?"},"o":[{"en":"Data is always printed in the same font","hi":"डेटा हमेशा एक ही फॉन्ट में प्रिंट होता है"},{"en":"Ensuring that multiple copies of the same data do not conflict (which is easier when data is centralized and redundancy is minimized)","hi":"यह सुनिश्चित करना कि एक ही डेटा की कई प्रतियां (copies) परस्पर विरोधी (conflict) न हों (जो तब आसान होता है जब डेटा केंद्रीकृत हो और रिडंडेंसी कम से कम हो)"},{"en":"Data can never be changed once entered","hi":"दर्ज होने के बाद डेटा को कभी बदला नहीं जा सकता"},{"en":"Data is only accessible by administrators","hi":"डेटा केवल प्रशासकों (administrators) द्वारा ही सुलभ है"}],"a":{"en":"Ensuring that multiple copies of the same data do not conflict (which is easier when data is centralized and redundancy is minimized)","hi":"यह सुनिश्चित करना कि एक ही डेटा की कई प्रतियां (copies) परस्पर विरोधी (conflict) न हों (जो तब आसान होता है जब डेटा केंद्रीकृत हो और रिडंडेंसी कम से कम हो)"},"exp":{"en":"If data redundancy is controlled, data consistency is maintained. When a value is updated in a centralized database, all users immediately see the new value.","hi":"यदि डेटा रिडंडेंसी को नियंत्रित किया जाता है, तो डेटा स्थिरता (consistency) बनी रहती है। जब किसी केंद्रीकृत डेटाबेस में कोई मान (value) अपडेट किया जाता है, तो सभी उपयोगकर्ता तुरंत नया मान देखते हैं।"},"id":"q101","num":101,"source_docx_q":44},{"q":{"en":"What is a Relational Database Model?","hi":"रिलेशनल डेटाबेस मॉडल (Relational Database Model) क्या है?"},"o":[{"en":"A model that stores data in files","hi":"एक मॉडल जो फ़ाइलों में डेटा संग्रहीत करता है"},{"en":"A model that organizes data into tables (relations) consisting of rows and columns, where relationships are established using common fields","hi":"एक मॉडल जो डेटा को पंक्तियों (rows) और कॉलम वाली तालिकाओं (relations/टेबल्स) में व्यवस्थित करता है, जहाँ सामान्य फ़ील्ड (common fields) का उपयोग करके संबंध स्थापित किए जाते हैं"},{"en":"A model used only for hierarchical data","hi":"केवल पदानुक्रमित डेटा के लिए उपयोग किया जाने वाला मॉडल"},{"en":"A model that stores unstructured data","hi":"एक मॉडल जो असंरचित (unstructured) डेटा संग्रहीत करता है"}],"a":{"en":"A model that organizes data into tables (relations) consisting of rows and columns, where relationships are established using common fields","hi":"एक मॉडल जो डेटा को पंक्तियों (rows) और कॉलम वाली तालिकाओं (relations/टेबल्स) में व्यवस्थित करता है, जहाँ सामान्य फ़ील्ड (common fields) का उपयोग करके संबंध स्थापित किए जाते हैं"},"exp":{"en":"The relational model is the most widely used database model. It stores data in tables (called relations), and links these tables using common keys.","hi":"रिलेशनल मॉडल सबसे व्यापक रूप से इस्तेमाल किया जाने वाला डेटाबेस मॉडल है। यह डेटा को तालिकाओं (जिन्हें रिलेशन कहा जाता है) में संग्रहीत करता है, और सामान्य कुंजियों (common keys) का उपयोग करके इन तालिकाओं को जोड़ता है।"},"id":"q102","num":102,"source_docx_q":47},{"q":{"en":"What does RDBMS stand for?","hi":"RDBMS का क्या अर्थ है?"},"o":[{"en":"Rapid Database Management System","hi":"रैपिड डेटाबेस मैनेजमेंट सिस्टम"},{"en":"Relational Database Management System","hi":"रिलेशनल डेटाबेस मैनेजमेंट सिस्टम"},{"en":"Remote Data Backup System","hi":"रिमोट डेटा बैकअप सिस्टम"},{"en":"Random Database Memory System","hi":"रैंडम डेटाबेस मेमोरी सिस्टम"}],"a":{"en":"Relational Database Management System","hi":"रिलेशनल डेटाबेस मैनेजमेंट सिस्टम"},"exp":{"en":"An RDBMS is a Database Management System based on the relational model (tables).","hi":"RDBMS रिलेशनल मॉडल (टेबल्स) पर आधारित एक डेटाबेस मैनेजमेंट सिस्टम है।"},"id":"q103","num":103,"source_docx_q":48},{"q":{"en":"What is a Non-Relational (NoSQL) Database Model?","hi":"गैर-रिलेशनल (NoSQL) डेटाबेस मॉडल क्या है?"},"o":[{"en":"A database that only uses SQL","hi":"एक डेटाबेस जो केवल SQL का उपयोग करता है"},{"en":"A model designed to handle large volumes of unstructured or semi-structured data, using formats like document, key-value, wide-column, or graph stores instead of rigid tables","hi":"एक मॉडल जिसे दस्तावेज़ (document), कुंजी-मूल्य (key-value), वाइड-कॉलम (wide-column), या ग्राफ़ स्टोर (graph stores) जैसे प्रारूपों का उपयोग करके असंरचित (unstructured) या अर्ध-संरचित डेटा की बड़ी मात्रा को संभालने के लिए डिज़ाइन किया गया है"},{"en":"A database that has no data","hi":"एक डेटाबेस जिसमें कोई डेटा नहीं है"},{"en":"A database used only on mobile devices","hi":"केवल मोबाइल उपकरणों पर उपयोग किया जाने वाला डेटाबेस"}],"a":{"en":"A model designed to handle large volumes of unstructured or semi-structured data, using formats like document, key-value, wide-column, or graph stores instead of rigid tables","hi":"एक मॉडल जिसे दस्तावेज़ (document), कुंजी-मूल्य (key-value), वाइड-कॉलम (wide-column), या ग्राफ़ स्टोर (graph stores) जैसे प्रारूपों का उपयोग करके असंरचित (unstructured) या अर्ध-संरचित डेटा की बड़ी मात्रा को संभालने के लिए डिज़ाइन किया गया है"},"exp":{"en":"NoSQL databases provide a mechanism for storage and retrieval of data that is modeled in means other than the tabular relations used in relational databases.","hi":"NoSQL डेटाबेस डेटा के भंडारण और पुनर्प्राप्ति (retrieval) के लिए एक तंत्र (mechanism) प्रदान करते हैं जिसे रिलेशनल डेटाबेस में उपयोग किए जाने वाले सारणीबद्ध (tabular) संबंधों के अलावा अन्य साधनों में तैयार किया जाता है।"},"id":"q104","num":104,"source_docx_q":50},{"q":{"en":"What is an example of a NoSQL document database?","hi":"NoSQL दस्तावेज़ डेटाबेस (document database) का एक उदाहरण क्या है?"},"o":[{"en":"MySQL","hi":"MySQL"},{"en":"Oracle","hi":"Oracle"},{"en":"MongoDB","hi":"मोंगोडीबी (MongoDB)"},{"en":"Microsoft Access","hi":"Microsoft Access"}],"a":{"en":"MongoDB","hi":"मोंगोडीबी (MongoDB)"},"exp":{"en":"MongoDB is a popular NoSQL database that stores data in flexible, JSON-like documents.","hi":"MongoDB एक लोकप्रिय NoSQL डेटाबेस है जो डेटा को लचीले, JSON-जैसे दस्तावेज़ों में संग्रहीत करता है।"},"id":"q105","num":105,"source_docx_q":51},{"q":{"en":"What is database normalization?","hi":"डेटाबेस सामान्यीकरण (database normalization) क्या है?"},"o":[{"en":"Making the database slower","hi":"डेटाबेस को धीमा करना"},{"en":"The process of organizing data to minimize redundancy (duplication) and improve data integrity, typically involving dividing large tables into smaller ones","hi":"अतिरेक (redundancy - दोहराव) को कम करने और डेटा अखंडता (data integrity) में सुधार करने के लिए डेटा को व्यवस्थित करने की प्रक्रिया, जिसमें आमतौर पर बड़ी तालिकाओं को छोटी तालिकाओं में विभाजित करना शामिल होता है"},{"en":"Converting data to normal text","hi":"डेटा को सामान्य पाठ (normal text) में परिवर्तित करना"},{"en":"Backing up the database","hi":"डेटाबेस का बैकअप लेना"}],"a":{"en":"The process of organizing data to minimize redundancy (duplication) and improve data integrity, typically involving dividing large tables into smaller ones","hi":"अतिरेक (redundancy - दोहराव) को कम करने और डेटा अखंडता (data integrity) में सुधार करने के लिए डेटा को व्यवस्थित करने की प्रक्रिया, जिसमें आमतौर पर बड़ी तालिकाओं को छोटी तालिकाओं में विभाजित करना शामिल होता है"},"exp":{"en":"Normalization follows a series of rules (Normal Forms, e.g., 1NF, 2NF, 3NF) to ensure a clean, efficient database design.","hi":"सामान्यीकरण (Normalization) एक स्वच्छ, कुशल डेटाबेस डिज़ाइन सुनिश्चित करने के लिए नियमों की एक श्रृंखला (जैसे, 1NF, 2NF, 3NF) का पालन करता है।"},"id":"q116","num":116,"source_docx_q":74},{"q":{"en":"What is a Data Warehouse?","hi":"डेटा वेयरहाउस (Data Warehouse) क्या है?"},"o":[{"en":"A physical building where hard drives are stored","hi":"एक भौतिक इमारत जहाँ हार्ड ड्राइव संग्रहीत की जाती हैं"},{"en":"A large, centralized repository of integrated data from one or more disparate sources, used for reporting and data analysis (OLAP) rather than daily transaction processing","hi":"एक या अधिक भिन्न स्रोतों से एकीकृत डेटा का एक बड़ा, केंद्रीकृत भंडार (centralized repository), जिसका उपयोग दैनिक लेनदेन प्रसंस्करण (daily transaction processing) के बजाय रिपोर्टिंग और डेटा विश्लेषण (OLAP) के लिए किया जाता है"},{"en":"A small database for a mobile app","hi":"मोबाइल ऐप के लिए एक छोटा डेटाबेस"},{"en":"A software program to secure data","hi":"डेटा सुरक्षित करने के लिए एक सॉफ्टवेयर प्रोग्राम"}],"a":{"en":"A large, centralized repository of integrated data from one or more disparate sources, used for reporting and data analysis (OLAP) rather than daily transaction processing","hi":"एक या अधिक भिन्न स्रोतों से एकीकृत डेटा का एक बड़ा, केंद्रीकृत भंडार (centralized repository), जिसका उपयोग दैनिक लेनदेन प्रसंस्करण (daily transaction processing) के बजाय रिपोर्टिंग और डेटा विश्लेषण (OLAP) के लिए किया जाता है"},"exp":{"en":"Data warehouses are optimized for read-heavy operations, allowing businesses to analyze historical data to make strategic decisions.","hi":"डेटा वेयरहाउस रीड-हैवी ऑपरेशंस के लिए अनुकूलित (optimized) हैं, जिससे व्यवसायों को रणनीतिक निर्णय लेने के लिए ऐतिहासिक डेटा का विश्लेषण करने की अनुमति मिलती है।"},"id":"q117","num":117,"source_docx_q":75},{"q":{"en":"What is a Database View?","hi":"डेटाबेस व्यू (Database View) क्या है?"},"o":[{"en":"The graphical user interface of the DBMS / DBMS का ग्राफिकल यूजर इंटरफेस","hi":"The graphical user interface of the DBMS / DBMS का ग्राफिकल यूजर इंटरफेस"},{"en":"A virtual table based on the result-set of an SQL statement. It contains rows and columns just like a real table, but the data is dynamically generated","hi":"एक SQL स्टेटमेंट के परिणाम-सेट (result-set) पर आधारित एक आभासी तालिका (virtual table)। इसमें एक वास्तविक तालिका की तरह ही पंक्तियाँ और कॉलम होते हैं, लेकिन डेटा गतिशील (dynamically) रूप से उत्पन्न होता है"},{"en":"A backup copy of the database","hi":"डेटाबेस की एक बैकअप कॉपी"},{"en":"A physical table that cannot be edited","hi":"एक भौतिक तालिका जिसे संपादित नहीं किया जा सकता"}],"a":{"en":"A virtual table based on the result-set of an SQL statement. It contains rows and columns just like a real table, but the data is dynamically generated","hi":"एक SQL स्टेटमेंट के परिणाम-सेट (result-set) पर आधारित एक आभासी तालिका (virtual table)। इसमें एक वास्तविक तालिका की तरह ही पंक्तियाँ और कॉलम होते हैं, लेकिन डेटा गतिशील (dynamically) रूप से उत्पन्न होता है"},"exp":{"en":"Views are used for security (hiding certain columns from users) or to simplify complex queries by saving them as a 'virtual table'.","hi":"व्यूज़ (Views) का उपयोग सुरक्षा के लिए (उपयोगकर्ताओं से कुछ कॉलम छिपाना) या जटिल प्रश्नों (complex queries) को 'आभासी तालिका' के रूप में सहेज कर सरल बनाने के लिए किया जाता है।"},"id":"q118","num":118,"source_docx_q":76},{"q":{"en":"What is an Index in a database?","hi":"डेटाबेस में इंडेक्स (Index) क्या है?"},"o":[{"en":"A list of all users","hi":"सभी उपयोगकर्ताओं की सूची"},{"en":"A data structure that improves the speed of data retrieval operations on a database table, much like the index at the back of a book","hi":"एक डेटा संरचना (data structure) जो डेटाबेस तालिका पर डेटा पुनर्प्राप्ति संचालन (data retrieval operations) की गति (speed) में सुधार करती है, ठीक किसी पुस्तक के पीछे के इंडेक्स (अनुक्रमणिका) की तरह"},{"en":"A command to delete data","hi":"डेटा हटाने का आदेश"},{"en":"A type of firewall","hi":"एक प्रकार का फ़ायरवॉल"}],"a":{"en":"A data structure that improves the speed of data retrieval operations on a database table, much like the index at the back of a book","hi":"एक डेटा संरचना (data structure) जो डेटाबेस तालिका पर डेटा पुनर्प्राप्ति संचालन (data retrieval operations) की गति (speed) में सुधार करती है, ठीक किसी पुस्तक के पीछे के इंडेक्स (अनुक्रमणिका) की तरह"},"exp":{"en":"While indexes speed up SELECT queries (reading data), they can slow down INSERT/UPDATE operations because the index must also be updated.","hi":"जबकि इंडेक्स (Indexes) SELECT प्रश्नों (डेटा पढ़ने) को गति देते हैं, वे INSERT/UPDATE संचालन को धीमा कर सकते हैं क्योंकि इंडेक्स को भी अपडेट किया जाना चाहिए।"},"id":"q119","num":119,"source_docx_q":77},{"q":{"en":"What does 'Data Mining' refer to?","hi":"'डेटा माइनिंग' (Data Mining) का क्या अर्थ है?"},"o":[{"en":"Physically destroying hard drives","hi":"हार्ड ड्राइव को भौतिक रूप से नष्ट करना"},{"en":"The practice of analyzing large databases in order to generate new information, discover patterns, and extract hidden insights","hi":"नई जानकारी उत्पन्न करने, पैटर्न (patterns) खोजने और छिपी हुई अंतर्दृष्टि (hidden insights) निकालने के लिए बड़े डेटाबेस का विश्लेषण करने का अभ्यास"},{"en":"Manually entering data into a system","hi":"सिस्टम में मैन्युअल रूप से डेटा दर्ज करना"},{"en":"Encrypting data for security","hi":"सुरक्षा के लिए डेटा एन्क्रिप्ट करना"}],"a":{"en":"The practice of analyzing large databases in order to generate new information, discover patterns, and extract hidden insights","hi":"नई जानकारी उत्पन्न करने, पैटर्न (patterns) खोजने और छिपी हुई अंतर्दृष्टि (hidden insights) निकालने के लिए बड़े डेटाबेस का विश्लेषण करने का अभ्यास"},"exp":{"en":"Data mining uses algorithms and statistical methods to find useful correlations and trends within massive datasets.","hi":"डेटा माइनिंग (Data mining) विशाल डेटासेट के भीतर उपयोगी सहसंबंध (correlations) और रुझान (trends) खोजने के लिए एल्गोरिदम और सांख्यिकीय तरीकों का उपयोग करता है।"},"id":"q120","num":120,"source_docx_q":78},{"q":{"en":"What is the difference between OLTP and OLAP?","hi":"OLTP और OLAP में क्या अंतर है?"},"o":[{"en":"OLTP is hardware, OLAP is software / OLTP हार्डवेयर है, OLAP सॉफ्टवेयर है","hi":"OLTP is hardware, OLAP is software / OLTP हार्डवेयर है, OLAP सॉफ्टवेयर है"},{"en":"OLTP (Online Transaction Processing) manages daily transactional data (fast, many small inserts/updates). OLAP (Online Analytical Processing) is used for complex data analysis and reporting (slow, read-heavy) / OLTP (ऑनलाइन ट्रांजेक्शन प्रोसेसिंग) दैनिक लेनदेन डेटा (daily transactional data - तेज़, कई छोटे इन्सर्ट/अपडेट) का प्रबंधन करता है। OLAP (ऑनलाइन एनालिटिकल प्रोसेसिंग) का उपयोग जटिल डेटा विश्लेषण और रिपोर्टिंग (धीमा, रीड-हैवी) के लिए किया जाता है","hi":"OLTP (Online Transaction Processing) manages daily transactional data (fast, many small inserts/updates). OLAP (Online Analytical Processing) is used for complex data analysis and reporting (slow, read-heavy) / OLTP (ऑनलाइन ट्रांजेक्शन प्रोसेसिंग) दैनिक लेनदेन डेटा (daily transactional data - तेज़, कई छोटे इन्सर्ट/अपडेट) का प्रबंधन करता है। OLAP (ऑनलाइन एनालिटिकल प्रोसेसिंग) का उपयोग जटिल डेटा विश्लेषण और रिपोर्टिंग (धीमा, रीड-हैवी) के लिए किया जाता है"},{"en":"OLTP is for offline data, OLAP is for online data / OLTP ऑफलाइन डेटा के लिए है, OLAP ऑनलाइन डेटा के लिए है","hi":"OLTP is for offline data, OLAP is for online data / OLTP ऑफलाइन डेटा के लिए है, OLAP ऑनलाइन डेटा के लिए है"},{"en":"They are the exact same thing","hi":"वे बिल्कुल एक ही चीज हैं"}],"a":{"en":"OLTP (Online Transaction Processing) manages daily transactional data (fast, many small inserts/updates). OLAP (Online Analytical Processing) is used for complex data analysis and reporting (slow, read-heavy) / OLTP (ऑनलाइन ट्रांजेक्शन प्रोसेसिंग) दैनिक लेनदेन डेटा (daily transactional data - तेज़, कई छोटे इन्सर्ट/अपडेट) का प्रबंधन करता है। OLAP (ऑनलाइन एनालिटिकल प्रोसेसिंग) का उपयोग जटिल डेटा विश्लेषण और रिपोर्टिंग (धीमा, रीड-हैवी) के लिए किया जाता है","hi":"OLTP (Online Transaction Processing) manages daily transactional data (fast, many small inserts/updates). OLAP (Online Analytical Processing) is used for complex data analysis and reporting (slow, read-heavy) / OLTP (ऑनलाइन ट्रांजेक्शन प्रोसेसिंग) दैनिक लेनदेन डेटा (daily transactional data - तेज़, कई छोटे इन्सर्ट/अपडेट) का प्रबंधन करता है। OLAP (ऑनलाइन एनालिटिकल प्रोसेसिंग) का उपयोग जटिल डेटा विश्लेषण और रिपोर्टिंग (धीमा, रीड-हैवी) के लिए किया जाता है"},"exp":{"en":"An ATM network relies on an OLTP database. A corporate strategy team generating a 5-year sales trend report relies on an OLAP data warehouse.","hi":"एटीएम नेटवर्क OLTP डेटाबेस पर निर्भर करता है। 5-वर्षीय बिक्री प्रवृत्ति (sales trend) रिपोर्ट तैयार करने वाली एक कॉर्पोरेट रणनीति टीम OLAP डेटा वेयरहाउस पर निर्भर करती है।"},"id":"q121","num":121,"source_docx_q":79}]},{"title":{"en":"6. DOCX Supplement — Database Keys & Relationships","hi":"6. डेटाबेस की कुंजियाँ और संबंध"},"questions":[{"q":{"en":"Which statement correctly defines a super key?","hi":"सुपर की की सही परिभाषा कौन-सी है?"},"o":[{"en":"A set of attributes that uniquely identifies each row, even if it contains redundant attributes","hi":"एट्रिब्यूट समूह जो हर रो की विशिष्ट पहचान करे, भले अतिरिक्त एट्रिब्यूट हों"},{"en":"Only a single non-unique column","hi":"केवल एक नॉन-यूनिक कॉलम"},{"en":"A password used to open DBMS software","hi":"DBMS सॉफ्टवेयर खोलने का पासवर्ड"},{"en":"A foreign key that must always be NULL","hi":"फॉरेन की जिसका हमेशा NULL होना ज़रूरी है"}],"exp":{"en":"A super key uniquely identifies rows. Adding a redundant attribute to an already unique key still gives a super key.","hi":"सुपर की हर पंक्ति की विशिष्ट पहचान करती है; अनावश्यक अतिरिक्त एट्रिब्यूट जोड़ने पर भी वह सुपर की रह सकती है।"},"a":{"en":"A set of attributes that uniquely identifies each row, even if it contains redundant attributes","hi":"एट्रिब्यूट समूह जो हर रो की विशिष्ट पहचान करे, भले अतिरिक्त एट्रिब्यूट हों"},"source_docx_q":null,"id":"q58","num":58},{"q":{"en":"What is a Candidate Key?","hi":"उम्मीदवार कुंजी (Candidate Key) क्या है?"},"o":[{"en":"A key that failed to become a primary key","hi":"एक कुंजी जो प्राथमिक कुंजी बनने में विफल रही"},{"en":"Any column or a combination of columns that can uniquely identify a record in a table. A table can have multiple candidate keys, but only one is chosen as the Primary Key","hi":"कोई भी कॉलम या कॉलम का संयोजन जो किसी तालिका में रिकॉर्ड की विशिष्ट रूप से पहचान कर सकता है। एक तालिका में कई उम्मीदवार कुंजियाँ (candidate keys) हो सकती हैं, लेकिन प्राथमिक कुंजी के रूप में केवल एक को चुना जाता है"},{"en":"A key used for temporary tables","hi":"अस्थायी तालिकाओं के लिए उपयोग की जाने वाली कुंजी"},{"en":"The most complex key in a database","hi":"डेटाबेस में सबसे जटिल कुंजी"}],"a":{"en":"Any column or a combination of columns that can uniquely identify a record in a table. A table can have multiple candidate keys, but only one is chosen as the Primary Key","hi":"कोई भी कॉलम या कॉलम का संयोजन जो किसी तालिका में रिकॉर्ड की विशिष्ट रूप से पहचान कर सकता है। एक तालिका में कई उम्मीदवार कुंजियाँ (candidate keys) हो सकती हैं, लेकिन प्राथमिक कुंजी के रूप में केवल एक को चुना जाता है"},"exp":{"en":"Think of candidate keys as 'candidates' for the position of Primary Key. If EmployeeID and Email are both unique, both are candidate keys.\nSource-note (Hinglish): Minimal super key. Iske kisi member ko remove karne se uniqueness guarantee khatam ho jaati hai.","hi":"उम्मीदवार कुंजियों (candidate keys) को प्राथमिक कुंजी के पद के लिए 'उम्मीदवार' समझें। यदि EmployeeID और ईमेल दोनों अद्वितीय (unique) हैं, तो दोनों उम्मीदवार कुंजियाँ हैं।"},"source_docx_q":54,"id":"q59","num":59},{"q":{"en":"What is a Primary Key in a relational database?","hi":"रिलेशनल डेटाबेस में प्राथमिक कुंजी (Primary Key) क्या है?"},"o":[{"en":"A key used to encrypt the database","hi":"डेटाबेस को एन्क्रिप्ट करने के लिए उपयोग की जाने वाली कुंजी"},{"en":"A specific field (or combination of fields) that uniquely identifies each record in a table. It cannot be null","hi":"एक विशिष्ट फ़ील्ड (या फ़ील्ड का संयोजन) जो किसी तालिका (table) में प्रत्येक रिकॉर्ड की विशिष्ट रूप से पहचान (uniquely identifies) करता है। यह शून्य (null) नहीं हो सकता"},{"en":"A password to access the table","hi":"तालिका तक पहुँचने के लिए एक पासवर्ड"},{"en":"The first column in every table","hi":"हर तालिका में पहला कॉलम"}],"a":{"en":"A specific field (or combination of fields) that uniquely identifies each record in a table. It cannot be null","hi":"एक विशिष्ट फ़ील्ड (या फ़ील्ड का संयोजन) जो किसी तालिका (table) में प्रत्येक रिकॉर्ड की विशिष्ट रूप से पहचान (uniquely identifies) करता है। यह शून्य (null) नहीं हो सकता"},"exp":{"en":"A primary key ensures entity integrity. Examples include Employee ID, Student Roll Number, or Aadhaar Number.\nSource-note (Hinglish): Chosen candidate key. Unique aur NOT NULL. Table ki ek primary key constraint ho sakti hai, jo multiple columns par defined ho sakti hai.","hi":"एक प्राथमिक कुंजी (primary key) इकाई अखंडता (entity integrity) सुनिश्चित करती है। उदाहरणों में कर्मचारी आईडी, छात्र रोल नंबर, या आधार नंबर शामिल हैं।"},"source_docx_q":52,"id":"q60","num":60},{"q":{"en":"What is an Alternate Key?","hi":"वैकल्पिक कुंजी (Alternate Key) क्या है?"},"o":[{"en":"A key that alternates its value","hi":"एक कुंजी जो अपना मान (value) बदलती है"},{"en":"A candidate key that was NOT chosen as the Primary Key","hi":"एक उम्मीदवार कुंजी (candidate key) जिसे प्राथमिक कुंजी (Primary Key) के रूप में नहीं चुना गया था"},{"en":"A backup for the database","hi":"डेटाबेस के लिए एक बैकअप"},{"en":"A key used in secondary storage","hi":"द्वितीयक भंडारण (secondary storage) में उपयोग की जाने वाली कुंजी"}],"a":{"en":"A candidate key that was NOT chosen as the Primary Key","hi":"एक उम्मीदवार कुंजी (candidate key) जिसे प्राथमिक कुंजी (Primary Key) के रूप में नहीं चुना गया था"},"exp":{"en":"If EmployeeID is chosen as the Primary Key, then the Email field (which is also unique and a candidate) becomes an Alternate Key.\nSource-note (Hinglish): Candidate key jo primary key ke liye choose nahin hui. Roll_No primary ho aur Email independently unique identifier ho, to Email alternate ho sakti hai.","hi":"यदि EmployeeID को प्राथमिक कुंजी के रूप में चुना जाता है, तो ईमेल फ़ील्ड (जो अद्वितीय और एक उम्मीदवार भी है) एक वैकल्पिक कुंजी (Alternate Key) बन जाती है।"},"source_docx_q":55,"id":"q61","num":61},{"q":{"en":"What is a Foreign Key?","hi":"विदेशी कुंजी (Foreign Key) क्या है?"},"o":[{"en":"A key used for international databases","hi":"अंतर्राष्ट्रीय डेटाबेस के लिए उपयोग की जाने वाली कुंजी"},{"en":"A field in one table that uniquely identifies a row of another table, establishing a link between the two tables (it points to the Primary Key of the other table)","hi":"एक तालिका में एक फ़ील्ड जो दूसरी तालिका की एक पंक्ति की विशिष्ट रूप से पहचान करता है, दोनों तालिकाओं के बीच एक लिंक स्थापित करता है (यह दूसरी तालिका की प्राथमिक कुंजी - Primary Key - को इंगित करता है)"},{"en":"A key generated randomly","hi":"बेतरतीब ढंग से उत्पन्न कुंजी"},{"en":"A key that cannot be duplicated","hi":"एक कुंजी जिसे डुप्लिकेट नहीं किया जा सकता"}],"a":{"en":"A field in one table that uniquely identifies a row of another table, establishing a link between the two tables (it points to the Primary Key of the other table)","hi":"एक तालिका में एक फ़ील्ड जो दूसरी तालिका की एक पंक्ति की विशिष्ट रूप से पहचान करता है, दोनों तालिकाओं के बीच एक लिंक स्थापित करता है (यह दूसरी तालिका की प्राथमिक कुंजी - Primary Key - को इंगित करता है)"},"exp":{"en":"Foreign keys maintain referential integrity. For example, a 'DepartmentID' in an Employee table that links to the 'DepartmentID' primary key in a Department table.\nSource-note (Hinglish): Referenced table ki primary ya eligible unique key. Same table ko self-reference bhi possible hai. Foreign key valid reference enforce karke referential integrity maintain karti hai.","hi":"विदेशी कुंजियाँ (Foreign keys) संदर्भात्मक अखंडता (referential integrity) बनाए रखती हैं। उदाहरण के लिए, एक कर्मचारी तालिका में एक 'DepartmentID' जो एक विभाग तालिका में 'DepartmentID' प्राथमिक कुंजी से जुड़ता है।"},"source_docx_q":53,"id":"q62","num":62},{"q":{"en":"Can foreign-key values be duplicated or NULL?","hi":"क्या फॉरेन-की वैल्यू दोहराई जा सकती हैं या NULL हो सकती हैं?"},"o":[{"en":"No, both are forbidden in all databases","hi":"नहीं, दोनों हर डेटाबेस में निषिद्ध हैं"},{"en":"Duplicates are allowed; NULL depends on column constraints and foreign-key rules","hi":"डुप्लिकेट संभव हैं; NULL कॉलम नियमों और FK नियमों पर निर्भर है"},{"en":"Duplicates are forbidden but NULL is always mandatory","hi":"डुप्लिकेट मना हैं लेकिन NULL हमेशा अनिवार्य है"},{"en":"A foreign key cannot refer to another table","hi":"फॉरेन की दूसरी टेबल को रेफ़र नहीं कर सकती"}],"exp":{"en":"Many child rows can reference the same parent, so duplicates can occur. NULL depends on declared constraints and foreign-key rules.","hi":"कई चाइल्ड पंक्तियाँ एक ही पैरेंट को रेफ़र कर सकती हैं; इसलिए डुप्लिकेट संभव हैं। NULL कॉन्स्ट्रेंट पर निर्भर है।"},"a":{"en":"Duplicates are allowed; NULL depends on column constraints and foreign-key rules","hi":"डुप्लिकेट संभव हैं; NULL कॉलम नियमों और FK नियमों पर निर्भर है"},"source_docx_q":null,"id":"q63","num":63},{"q":{"en":"What is a Composite Key?","hi":"मिश्रित कुंजी (Composite Key) क्या है?"},"o":[{"en":"A key made of plastic","hi":"प्लास्टिक से बनी एक कुंजी"},{"en":"A Primary Key that consists of two or more columns to uniquely identify a record","hi":"एक प्राथमिक कुंजी जिसमें किसी रिकॉर्ड की विशिष्ट रूप से पहचान करने के लिए दो या अधिक कॉलम होते हैं"},{"en":"A key used across multiple databases","hi":"कई डेटाबेस में उपयोग की जाने वाली कुंजी"},{"en":"A key that compresses data","hi":"एक कुंजी जो डेटा को संपीड़ित (compress) करती है"}],"a":{"en":"A Primary Key that consists of two or more columns to uniquely identify a record","hi":"एक प्राथमिक कुंजी जिसमें किसी रिकॉर्ड की विशिष्ट रूप से पहचान करने के लिए दो या अधिक कॉलम होते हैं"},"exp":{"en":"When a single column isn't enough to guarantee uniqueness, multiple columns are combined. For example, (OrderID, ProductID) in an OrderDetails table.\nSource-note (Hinglish): Two or more columns ka combined key. Enrollment table mein Student_ID + Course_ID ek composite key ho sakti hai.","hi":"जब विशिष्टता (uniqueness) की गारंटी देने के लिए एक कॉलम पर्याप्त नहीं होता है, तो कई कॉलमों को मिला दिया जाता है। उदाहरण के लिए, एक OrderDetails तालिका में (OrderID, ProductID)।"},"source_docx_q":56,"id":"q64","num":64},{"q":{"en":"Does a minimal candidate key have to be the candidate key with the fewest columns?","hi":"क्या न्यूनतम (minimal) कैंडिडेट की हमेशा सबसे कम कॉलम वाली होती है?"},"o":[{"en":"Yes, minimal and minimum size always mean the same thing","hi":"हाँ, दोनों का अर्थ हमेशा एक ही है"},{"en":"No; minimal means no attribute can be removed without losing uniqueness","hi":"नहीं; minimal का मतलब कोई एट्रिब्यूट हटाने पर विशिष्टता समाप्त होना है"},{"en":"A candidate key must always have exactly two columns","hi":"कैंडिडेट की में हमेशा ठीक दो कॉलम होते हैं"},{"en":"All candidate keys must contain the primary key","hi":"सभी कैंडिडेट की में प्राइमरी की शामिल होती है"}],"exp":{"en":"Minimality means no redundant attribute in a key; valid candidate keys in a relation need not have equal sizes.","hi":"मिनिमल का अर्थ की में कोई अनावश्यक एट्रिब्यूट न होना है; अलग-अलग कैंडिडेट की के आकार भिन्न हो सकते हैं।"},"a":{"en":"No; minimal means no attribute can be removed without losing uniqueness","hi":"नहीं; minimal का मतलब कोई एट्रिब्यूट हटाने पर विशिष्टता समाप्त होना है"},"source_docx_q":null,"id":"q65","num":65},{"q":{"en":"What is a One-to-One (1:1) relationship in a database?","hi":"डेटाबेस में वन-टू-वन (One-to-One / 1:1) संबंध क्या है?"},"o":[{"en":"One table has all the data","hi":"एक तालिका में सभी डेटा हैं"},{"en":"A record in Table A is related to only one record in Table B, and vice versa","hi":"तालिका A (Table A) में एक रिकॉर्ड केवल तालिका B (Table B) के एक रिकॉर्ड से संबंधित है, और इसके विपरीत (vice versa)"},{"en":"One user can access one database","hi":"एक उपयोगकर्ता एक डेटाबेस तक पहुंच सकता है"},{"en":"One record has one column","hi":"एक रिकॉर्ड में एक कॉलम होता है"}],"a":{"en":"A record in Table A is related to only one record in Table B, and vice versa","hi":"तालिका A (Table A) में एक रिकॉर्ड केवल तालिका B (Table B) के एक रिकॉर्ड से संबंधित है, और इसके विपरीत (vice versa)"},"exp":{"en":"Example: An Employee table and an Employee_Parking_Space table. One employee gets exactly one designated parking space.","hi":"उदाहरण: एक कर्मचारी (Employee) तालिका और एक Employee_Parking_Space तालिका। एक कर्मचारी को ठीक एक निर्दिष्ट पार्किंग स्थान मिलता है।"},"id":"q106","num":106,"source_docx_q":57},{"q":{"en":"What is a One-to-Many (1:N) relationship?","hi":"वन-टू-मैनी (One-to-Many / 1:N) संबंध क्या है?"},"o":[{"en":"One table relates to many databases","hi":"एक तालिका कई डेटाबेस से संबंधित है"},{"en":"A record in Table A can be related to multiple records in Table B, but a record in Table B is related to only one record in Table A","hi":"तालिका A में एक रिकॉर्ड तालिका B में कई रिकॉर्ड से संबंधित हो सकता है, लेकिन तालिका B में एक रिकॉर्ड तालिका A में केवल एक रिकॉर्ड से संबंधित है"},{"en":"Many users access one table","hi":"कई उपयोगकर्ता एक तालिका तक पहुंचते हैं"},{"en":"One column has many data types","hi":"एक कॉलम में कई डेटा प्रकार होते हैं"}],"a":{"en":"A record in Table A can be related to multiple records in Table B, but a record in Table B is related to only one record in Table A","hi":"तालिका A में एक रिकॉर्ड तालिका B में कई रिकॉर्ड से संबंधित हो सकता है, लेकिन तालिका B में एक रिकॉर्ड तालिका A में केवल एक रिकॉर्ड से संबंधित है"},"exp":{"en":"This is the most common relationship. Example: A Department (Table A) has many Employees (Table B), but each Employee belongs to only one Department.","hi":"यह सबसे आम संबंध है। उदाहरण: एक विभाग (तालिका A) में कई कर्मचारी (तालिका B) होते हैं, लेकिन प्रत्येक कर्मचारी केवल एक विभाग से संबंधित होता है।"},"id":"q107","num":107,"source_docx_q":58}]},{"title":{"en":"7. DOCX Supplement — SQL Commands & Transactions","hi":"7. SQL कमांड और ट्रांज़ैक्शन"},"questions":[{"q":{"en":"What does SQL stand for?","hi":"SQL का क्या अर्थ है?"},"o":[{"en":"Simple Question Language","hi":"सिंपल क्वेश्चन लैंग्वेज"},{"en":"Structured Query Language","hi":"स्ट्रक्चर्ड क्वेरी लैंग्वेज"},{"en":"Standard Query Logic","hi":"स्टैंडर्ड क्वेरी लॉजिक"},{"en":"System Query Link","hi":"सिस्टम क्वेरी लिंक"}],"a":{"en":"Structured Query Language","hi":"स्ट्रक्चर्ड क्वेरी लैंग्वेज"},"exp":{"en":"SQL is the standard language for dealing with Relational Databases.\nSource-note (Hinglish): Structured Query Language. Relational data aur schema ko query, change aur manage karne ki declarative domain-specific language, textbooks mein 4GL ke roop mein bhi padhi jaati hai.","hi":"SQL रिलेशनल डेटाबेस से निपटने के लिए मानक भाषा है।"},"source_docx_q":60,"id":"q66","num":66},{"q":{"en":"Which five SQL command categories are commonly used in exam classification?","hi":"परीक्षा में SQL कमांड की पाँच सामान्य श्रेणियाँ कौन-सी हैं?"},"o":[{"en":"HTTP, FTP, SMTP, POP, IMAP","hi":"HTTP, FTP, SMTP, POP, IMAP"},{"en":"DDL, DML, DQL, DCL and TCL","hi":"DDL, DML, DQL, DCL और TCL"},{"en":"SQL, HTML, XML, JSON and CSS","hi":"SQL, HTML, XML, JSON और CSS"},{"en":"ACID, BASE, RAID, ROM and RAM","hi":"ACID, BASE, RAID, ROM और RAM"}],"exp":{"en":"Textbook exam classification uses DDL, DML, DQL, DCL and TCL. Some documentation also groups SELECT under DML.","hi":"परीक्षा वर्गीकरण में DDL, DML, DQL, DCL और TCL आते हैं; कुछ दस्तावेज़ SELECT को व्यापक DML में भी रखते हैं।"},"a":{"en":"DDL, DML, DQL, DCL and TCL","hi":"DDL, DML, DQL, DCL और TCL"},"source_docx_q":null,"id":"q67","num":67},{"q":{"en":"What does DDL (Data Definition Language) do in SQL?","hi":"SQL में DDL (डेटा डेफिनिशन लैंग्वेज) क्या करता है?"},"o":[{"en":"It manipulates the data","hi":"यह डेटा में हेरफेर करता है"},{"en":"It deals with database schemas and descriptions, defining how data should reside. Commands: CREATE, ALTER, DROP, TRUNCATE","hi":"यह डेटाबेस स्कीमा (schemas) और विवरणों से संबंधित है, यह परिभाषित करता है कि डेटा कैसे रहना चाहिए। कमांड: CREATE, ALTER, DROP, TRUNCATE"},{"en":"It controls access to the data","hi":"यह डेटा तक पहुंच को नियंत्रित करता है"},{"en":"It handles transactions","hi":"यह लेनदेन (transactions) को संभालता है"}],"a":{"en":"It deals with database schemas and descriptions, defining how data should reside. Commands: CREATE, ALTER, DROP, TRUNCATE","hi":"यह डेटाबेस स्कीमा (schemas) और विवरणों से संबंधित है, यह परिभाषित करता है कि डेटा कैसे रहना चाहिए। कमांड: CREATE, ALTER, DROP, TRUNCATE"},"exp":{"en":"DDL commands affect the structure of the database (creating tables, dropping tables), not the data inside them.\nSource-note (Hinglish): Data Definition Language. CREATE object banata hai, ALTER structure modify karta hai, DROP object hataata hai, TRUNCATE rows clear karta hai aur RENAME object ka naam badalta hai. Exact syntax database par depend karta hai.","hi":"DDL कमांड डेटाबेस की संरचना (तालिकाएँ बनाना, तालिकाएँ हटाना) को प्रभावित करते हैं, न कि उनके अंदर के डेटा को।"},"source_docx_q":61,"id":"q68","num":68},{"q":{"en":"What does DML (Data Manipulation Language) do?","hi":"DML (डेटा मैनिपुलेशन लैंग्वेज) क्या करता है?"},"o":[{"en":"It defines the table structure","hi":"यह तालिका संरचना (table structure) को परिभाषित करता है"},{"en":"It deals with the manipulation of data present in the database. Commands: INSERT, UPDATE, DELETE, SELECT (often grouped as DQL)","hi":"यह डेटाबेस में मौजूद डेटा के हेरफेर (manipulation) से संबंधित है। कमांड: INSERT, UPDATE, DELETE, SELECT (अक्सर DQL के रूप में समूहीकृत)"},{"en":"It grants user permissions","hi":"यह उपयोगकर्ता अनुमतियाँ (permissions) प्रदान करता है"},{"en":"It saves transactions","hi":"यह लेनदेन को बचाता (saves) है"}],"a":{"en":"It deals with the manipulation of data present in the database. Commands: INSERT, UPDATE, DELETE, SELECT (often grouped as DQL)","hi":"यह डेटाबेस में मौजूद डेटा के हेरफेर (manipulation) से संबंधित है। कमांड: INSERT, UPDATE, DELETE, SELECT (अक्सर DQL के रूप में समूहीकृत)"},"exp":{"en":"DML is used to add, modify, delete, or retrieve the actual records inside the tables.\nSource-note (Hinglish): Data Manipulation Language. INSERT new rows add karta hai, UPDATE existing values modify karta hai aur DELETE rows remove karta hai.","hi":"DML का उपयोग तालिकाओं के अंदर वास्तविक रिकॉर्ड को जोड़ने, संशोधित करने, हटाने या पुनः प्राप्त करने के लिए किया जाता है।"},"source_docx_q":62,"id":"q69","num":69},{"q":{"en":"Which statement correctly distinguishes DELETE, TRUNCATE and DROP?","hi":"DELETE, TRUNCATE और DROP में सही अंतर क्या है?"},"o":[{"en":"DELETE removes a table definition; TRUNCATE adds rows; DROP filters rows","hi":"DELETE टेबल हटाता; TRUNCATE रो जोड़ता; DROP फ़िल्टर करता"},{"en":"All three always remove the database server itself","hi":"तीनों हमेशा डेटाबेस सर्वर हटाते हैं"},{"en":"DELETE can remove selected rows; TRUNCATE clears table rows but retains definition; DROP removes the table object","hi":"DELETE चुनी रो हटाता; TRUNCATE सारी रो हटाकर संरचना रखता; DROP टेबल ऑब्जेक्ट हटाता"},{"en":"TRUNCATE only reads data and DROP only sorts it","hi":"TRUNCATE केवल डेटा पढ़ता और DROP केवल सॉर्ट करता है"}],"exp":{"en":"DELETE can target rows; TRUNCATE empties a table while retaining its definition; DROP removes the table object. Transaction behavior varies by DBMS.","hi":"DELETE चयनित पंक्तियाँ हटा सकता है; TRUNCATE डेटा खाली करके टेबल संरचना रखता है; DROP टेबल ऑब्जेक्ट हटाता है।"},"a":{"en":"DELETE can remove selected rows; TRUNCATE clears table rows but retains definition; DROP removes the table object","hi":"DELETE चुनी रो हटाता; TRUNCATE सारी रो हटाकर संरचना रखता; DROP टेबल ऑब्जेक्ट हटाता"},"source_docx_q":null,"id":"q70","num":70},{"q":{"en":"What is DQL and which command retrieves data?","hi":"DQL का पूरा नाम और डेटा प्राप्त करने का कमांड क्या है?"},"o":[{"en":"Data Query Language; SELECT","hi":"डेटा क्वेरी लैंग्वेज; SELECT"},{"en":"Data Control Language; GRANT","hi":"डेटा कंट्रोल लैंग्वेज; GRANT"},{"en":"Data Definition Language; DROP","hi":"डेटा डेफ़िनिशन लैंग्वेज; DROP"},{"en":"Transaction Control Language; COMMIT","hi":"ट्रांज़ैक्शन कंट्रोल लैंग्वेज; COMMIT"}],"exp":{"en":"DQL stands for Data Query Language. SELECT retrieves data; WHERE filters rows and GROUP BY groups them.","hi":"DQL = Data Query Language; SELECT डेटा प्राप्त करता है, WHERE पंक्तियाँ फ़िल्टर और GROUP BY समूह बनाता है।"},"a":{"en":"Data Query Language; SELECT","hi":"डेटा क्वेरी लैंग्वेज; SELECT"},"source_docx_q":null,"id":"q71","num":71},{"q":{"en":"What does DCL (Data Control Language) do?","hi":"DCL (डेटा कंट्रोल लैंग्वेज) क्या करता है?"},"o":[{"en":"It deletes tables","hi":"यह तालिकाओं को हटाता है"},{"en":"It deals with rights, permissions, and other controls of the database system. Commands: GRANT, REVOKE","hi":"यह डेटाबेस सिस्टम के अधिकारों (rights), अनुमतियों (permissions) और अन्य नियंत्रणों से संबंधित है। कमांड: GRANT, REVOKE"},{"en":"It updates data","hi":"यह डेटा अपडेट करता है"},{"en":"It creates relationships","hi":"यह संबंध (relationships) बनाता है"}],"a":{"en":"It deals with rights, permissions, and other controls of the database system. Commands: GRANT, REVOKE","hi":"यह डेटाबेस सिस्टम के अधिकारों (rights), अनुमतियों (permissions) और अन्य नियंत्रणों से संबंधित है। कमांड: GRANT, REVOKE"},"exp":{"en":"DCL commands allow the database administrator to manage who has access to perform specific operations.\nSource-note (Hinglish): Data Control Language. GRANT privileges deta hai. REVOKE granted privileges withdraw karta hai.","hi":"DCL कमांड डेटाबेस प्रशासक को यह प्रबंधित करने की अनुमति देते हैं कि विशिष्ट कार्य करने के लिए किसके पास पहुंच (access) है।"},"source_docx_q":63,"id":"q72","num":72},{"q":{"en":"What does TCL (Transaction Control Language) do?","hi":"TCL (ट्रांजेक्शन कंट्रोल लैंग्वेज) क्या करता है?"},"o":[{"en":"It creates new tables","hi":"यह नई तालिकाएँ बनाता है"},{"en":"It manages transactions within the database to maintain consistency. Commands: COMMIT, ROLLBACK, SAVEPOINT","hi":"यह स्थिरता (consistency) बनाए रखने के लिए डेटाबेस के भीतर लेनदेन (transactions) का प्रबंधन करता है। कमांड: COMMIT, ROLLBACK, SAVEPOINT"},{"en":"It inserts new records","hi":"यह नए रिकॉर्ड सम्मिलित (inserts) करता है"},{"en":"It encrypts data","hi":"यह डेटा को एन्क्रिप्ट करता है"}],"a":{"en":"It manages transactions within the database to maintain consistency. Commands: COMMIT, ROLLBACK, SAVEPOINT","hi":"यह स्थिरता (consistency) बनाए रखने के लिए डेटाबेस के भीतर लेनदेन (transactions) का प्रबंधन करता है। कमांड: COMMIT, ROLLBACK, SAVEPOINT"},"exp":{"en":"TCL ensures that database operations (like money transfers) are completed fully and safely, or canceled entirely if an error occurs.\nSource-note (Hinglish): Transaction Control Language. COMMIT changes save karta hai, ROLLBACK uncommitted changes undo karta hai aur SAVEPOINT partial rollback ke liye point mark karta hai.","hi":"TCL यह सुनिश्चित करता है कि डेटाबेस संचालन (जैसे धन हस्तांतरण) पूरी तरह और सुरक्षित रूप से पूरा हो, या यदि कोई त्रुटि (error) होती है तो पूरी तरह से रद्द (canceled) कर दिया जाए।"},"source_docx_q":64,"id":"q73","num":73},{"q":{"en":"Can a TRUNCATE operation always or never be rolled back in every DBMS?","hi":"क्या हर DBMS में TRUNCATE को हमेशा या कभी भी ROLLBACK कर सकते हैं?"},"o":[{"en":"It is always irreversible on every database engine","hi":"हर डेटाबेस में कभी वापस नहीं हो सकता"},{"en":"It always rolls back even outside transactions","hi":"ट्रांज़ैक्शन से बाहर भी हमेशा वापस होता है"},{"en":"It depends on the database engine and transaction context; PostgreSQL supports rollback within a transaction","hi":"यह DBMS और ट्रांज़ैक्शन पर निर्भर है; PostgreSQL ट्रांज़ैक्शन के भीतर रोलबैक कर सकता है"},{"en":"TRUNCATE cannot be used on tables","hi":"TRUNCATE टेबल पर उपयोग नहीं हो सकता"}],"exp":{"en":"Rollback behavior is engine-specific. For example, PostgreSQL can roll back TRUNCATE within a transaction.","hi":"रोलबैक की सुविधा DBMS-विशिष्ट है; PostgreSQL ट्रांज़ैक्शन के भीतर TRUNCATE को रोलबैक कर सकता है।"},"a":{"en":"It depends on the database engine and transaction context; PostgreSQL supports rollback within a transaction","hi":"यह DBMS और ट्रांज़ैक्शन पर निर्भर है; PostgreSQL ट्रांज़ैक्शन के भीतर रोलबैक कर सकता है"},"source_docx_q":null,"id":"q74","num":74},{"q":{"en":"What do the ACID properties stand for in a DBMS transaction?","hi":"DBMS लेनदेन (transaction) में ACID गुण क्या दर्शाते हैं?"},"o":[{"en":"Addition, Calculation, Integration, Deletion","hi":"Addition, Calculation, Integration, Deletion"},{"en":"Atomicity, Consistency, Isolation, Durability","hi":"एटॉमिसिटी (Atomicity), कंसिस्टेंसी (Consistency), आइसोलेशन (Isolation), ड्यूरेबिलिटी (Durability)"},{"en":"Access, Control, Information, Data","hi":"Access, Control, Information, Data"},{"en":"Array, Column, Index, Directory","hi":"Array, Column, Index, Directory"}],"a":{"en":"Atomicity, Consistency, Isolation, Durability","hi":"एटॉमिसिटी (Atomicity), कंसिस्टेंसी (Consistency), आइसोलेशन (Isolation), ड्यूरेबिलिटी (Durability)"},"exp":{"en":"ACID properties ensure that database transactions are processed reliably.","hi":"ACID गुण सुनिश्चित करते हैं कि डेटाबेस लेनदेन (transactions) को विश्वसनीय (reliably) रूप से संसाधित (processed) किया जाता है।"},"id":"q108","num":108,"source_docx_q":65},{"q":{"en":"What does 'Atomicity' mean in ACID properties?","hi":"ACID गुणों में 'एटॉमिसिटी' (Atomicity) का क्या अर्थ है?"},"o":[{"en":"Transactions are fast","hi":"लेनदेन तेज़ हैं"},{"en":"The 'all or nothing' rule. A transaction is treated as a single unit, which either succeeds completely or fails completely / 'सब कुछ या कुछ नहीं' नियम (all or nothing rule)। एक लेनदेन (transaction) को एक इकाई (single unit) के रूप में माना जाता है, जो या तो पूरी तरह से सफल होता है या पूरी तरह से विफल (fails completely) हो जाता है","hi":"The 'all or nothing' rule. A transaction is treated as a single unit, which either succeeds completely or fails completely / 'सब कुछ या कुछ नहीं' नियम (all or nothing rule)। एक लेनदेन (transaction) को एक इकाई (single unit) के रूप में माना जाता है, जो या तो पूरी तरह से सफल होता है या पूरी तरह से विफल (fails completely) हो जाता है"},{"en":"Data is atomic","hi":"डेटा परमाणु (atomic) है"},{"en":"Users act independently","hi":"उपयोगकर्ता स्वतंत्र रूप से कार्य करते हैं"}],"a":{"en":"The 'all or nothing' rule. A transaction is treated as a single unit, which either succeeds completely or fails completely / 'सब कुछ या कुछ नहीं' नियम (all or nothing rule)। एक लेनदेन (transaction) को एक इकाई (single unit) के रूप में माना जाता है, जो या तो पूरी तरह से सफल होता है या पूरी तरह से विफल (fails completely) हो जाता है","hi":"The 'all or nothing' rule. A transaction is treated as a single unit, which either succeeds completely or fails completely / 'सब कुछ या कुछ नहीं' नियम (all or nothing rule)। एक लेनदेन (transaction) को एक इकाई (single unit) के रूप में माना जाता है, जो या तो पूरी तरह से सफल होता है या पूरी तरह से विफल (fails completely) हो जाता है"},"exp":{"en":"If you transfer money, atomicity ensures both the deduction from one account and the addition to another occur together, or neither occurs.","hi":"यदि आप पैसे ट्रांसफर करते हैं, तो एटॉमिसिटी सुनिश्चित करती है कि एक खाते से कटौती (deduction) और दूसरे में जोड़ (addition) दोनों एक साथ हों, या दोनों में से कोई न हो।"},"id":"q109","num":109,"source_docx_q":66},{"q":{"en":"What does 'Isolation' mean in ACID properties?","hi":"ACID गुणों में 'आइसोलेशन' (Isolation) का क्या अर्थ है?"},"o":[{"en":"Data is stored on a separate server","hi":"डेटा एक अलग सर्वर पर संग्रहीत किया जाता है"},{"en":"Ensures that concurrent transactions (happening at the same time) do not interfere with each other","hi":"यह सुनिश्चित करता है कि समवर्ती लेनदेन (concurrent transactions - एक ही समय में होने वाले) एक-दूसरे के साथ हस्तक्षेप (interfere) न करें"},{"en":"The database is not connected to the internet","hi":"डेटाबेस इंटरनेट से जुड़ा नहीं है"},{"en":"Only one user can use the database","hi":"केवल एक उपयोगकर्ता डेटाबेस का उपयोग कर सकता है"}],"a":{"en":"Ensures that concurrent transactions (happening at the same time) do not interfere with each other","hi":"यह सुनिश्चित करता है कि समवर्ती लेनदेन (concurrent transactions - एक ही समय में होने वाले) एक-दूसरे के साथ हस्तक्षेप (interfere) न करें"},"exp":{"en":"Isolation ensures that even if multiple people are updating the database simultaneously, the end result is as if they were doing it one after the other.","hi":"आइसोलेशन (Isolation) यह सुनिश्चित करता है कि भले ही कई लोग एक साथ डेटाबेस को अपडेट कर रहे हों, अंतिम परिणाम ऐसा होता है जैसे कि वे इसे एक के बाद एक कर रहे हों।"},"id":"q110","num":110,"source_docx_q":67},{"q":{"en":"What is a Stored Procedure in SQL?","hi":"SQL में 'स्टोर्ड प्रोसीजर' (Stored Procedure) क्या है?"},"o":[{"en":"A backup of the database","hi":"डेटाबेस का बैकअप"},{"en":"A prepared SQL code that you can save, so the code can be reused over and over again without rewriting it","hi":"एक तैयार SQL कोड जिसे आप सहेज (save) सकते हैं, ताकि कोड को बिना दोबारा लिखे बार-बार उपयोग किया जा सके"},{"en":"A process to delete old data","hi":"पुराने डेटा को हटाने की एक प्रक्रिया"},{"en":"The physical location of the database","hi":"डेटाबेस का भौतिक स्थान"}],"a":{"en":"A prepared SQL code that you can save, so the code can be reused over and over again without rewriting it","hi":"एक तैयार SQL कोड जिसे आप सहेज (save) सकते हैं, ताकि कोड को बिना दोबारा लिखे बार-बार उपयोग किया जा सके"},"exp":{"en":"Stored procedures improve performance and security by centralizing business logic within the database itself.","hi":"स्टोर्ड प्रोसीजर (Stored procedures) डेटाबेस के भीतर ही व्यावसायिक तर्क (business logic) को केंद्रीकृत करके प्रदर्शन और सुरक्षा में सुधार करते हैं।"},"id":"q122","num":122,"source_docx_q":80}]},{"title":{"en":"8. DOCX Supplement — Entity-Relationship Model","hi":"8. एंटिटी–रिलेशनशिप (ER) मॉडल"},"questions":[{"q":{"en":"Who proposed the Entity-Relationship (ER) model, and in which year?","hi":"एंटिटी–रिलेशनशिप (ER) मॉडल किसने और कब प्रस्तुत किया?"},"o":[{"en":"E. F. Codd, 1970","hi":"ई. एफ. कॉड, 1970"},{"en":"Peter P. Chen, 1976","hi":"पीटर पी. चेन, 1976"},{"en":"Sridhar Vembu, 1996","hi":"श्रीधर वेम्बू, 1996"},{"en":"Alan Turing, 1936","hi":"एलन ट्यूरिंग, 1936"}],"exp":{"en":"Peter P. Chen proposed the ER model in 1976 for conceptual database design using entities, attributes and relationships.","hi":"पीटर पी. चेन ने 1976 में एंटिटी, एट्रिब्यूट और संबंधों के आधार पर ER मॉडल प्रस्तावित किया।"},"a":{"en":"Peter P. Chen, 1976","hi":"पीटर पी. चेन, 1976"},"source_docx_q":null,"id":"q75","num":75},{"q":{"en":"Which symbols are correctly matched in Chen ER notation?","hi":"Chen ER नोटेशन में प्रतीकों का सही मिलान कौन-सा है?"},"o":[{"en":"Entity—diamond; relationship—oval; attribute—rectangle","hi":"एंटिटी—डायमंड; संबंध—ओवल; एट्रिब्यूट—आयत"},{"en":"Entity—rectangle; relationship—diamond; attribute—oval; weak entity—double rectangle","hi":"एंटिटी—आयत; संबंध—डायमंड; एट्रिब्यूट—ओवल; वीक एंटिटी—दोहरा आयत"},{"en":"Entity—circle; relationship—triangle; attribute—star","hi":"एंटिटी—वृत्त; संबंध—त्रिभुज; एट्रिब्यूट—तारा"},{"en":"Entity—double oval; relationship—dashed oval; attribute—diamond","hi":"एंटिटी—दोहरा ओवल; संबंध—डैश्ड ओवल; एट्रिब्यूट—डायमंड"}],"exp":{"en":"Chen ER notation uses rectangle for entity, double rectangle for weak entity, diamond for relationship and oval for attribute.","hi":"Chen ER नोटेशन में एंटिटी आयत, वीक एंटिटी दोहरा आयत, संबंध डायमंड और एट्रिब्यूट ओवल से दर्शाते हैं।"},"a":{"en":"Entity—rectangle; relationship—diamond; attribute—oval; weak entity—double rectangle","hi":"एंटिटी—आयत; संबंध—डायमंड; एट्रिब्यूट—ओवल; वीक एंटिटी—दोहरा आयत"},"source_docx_q":null,"id":"q76","num":76},{"q":{"en":"What is a 'Weak Entity' in an ER model?","hi":"ER मॉडल में 'कमजोर इकाई' (Weak Entity) क्या है?"},"o":[{"en":"An entity with a weak password","hi":"कमजोर पासवर्ड वाली एक इकाई"},{"en":"An entity that cannot be uniquely identified by its own attributes alone and relies on a relationship with a strong entity (parent)","hi":"एक इकाई (entity) जिसे अकेले अपनी विशेषताओं द्वारा विशिष्ट रूप से पहचाना नहीं जा सकता है और एक मजबूत इकाई (strong entity - पैरेंट) के साथ संबंध पर निर्भर करती है"},{"en":"An entity that is deleted frequently","hi":"एक इकाई जो बार-बार हटा दी जाती है"},{"en":"An entity with no attributes","hi":"बिना किसी विशेषता (attributes) वाली इकाई"}],"a":{"en":"An entity that cannot be uniquely identified by its own attributes alone and relies on a relationship with a strong entity (parent)","hi":"एक इकाई (entity) जिसे अकेले अपनी विशेषताओं द्वारा विशिष्ट रूप से पहचाना नहीं जा सकता है और एक मजबूत इकाई (strong entity - पैरेंट) के साथ संबंध पर निर्भर करती है"},"exp":{"en":"A Weak Entity does not have a primary key of its own. It is represented by a double rectangle in an ER diagram.\nSource-note (Hinglish): Apne attributes se alone fully identify nahin hoti. Identification ke liye owner entity ka key aur weak entity ka partial key use ho sakta hai.","hi":"एक कमजोर इकाई (Weak Entity) की अपनी कोई प्राथमिक कुंजी नहीं होती है। इसे ER आरेख में दोहरे आयत (double rectangle) द्वारा दर्शाया जाता है।"},"source_docx_q":73,"id":"q77","num":77},{"q":{"en":"Which examples correctly match key, multivalued and derived attributes?","hi":"की, मल्टीवैल्यूड और डिराइव्ड एट्रिब्यूट के सही उदाहरण कौन-से हैं?"},"o":[{"en":"Key—age; multivalued—Roll_No; derived—phone numbers","hi":"की—आयु; मल्टीवैल्यूड—रोल नंबर; डिराइव्ड—फ़ोन नंबर"},{"en":"Key—Roll_No; multivalued—multiple phone numbers; derived—age from date of birth","hi":"की—रोल नंबर; मल्टीवैल्यूड—कई फ़ोन नंबर; डिराइव्ड—जन्मतिथि से आयु"},{"en":"Key—course name; multivalued—single ID; derived—primary key","hi":"की—कोर्स नाम; मल्टीवैल्यूड—एक ID; डिराइव्ड—प्राइमरी की"},{"en":"Key—derived age; multivalued—table; derived—server","hi":"की—डिराइव्ड आयु; मल्टीवैल्यूड—टेबल; डिराइव्ड—सर्वर"}],"exp":{"en":"Roll_No is a key attribute, multiple phone numbers form a multivalued attribute, and age calculated from date of birth is derived.","hi":"Roll_No की एट्रिब्यूट, अनेक फ़ोन नंबर मल्टीवैल्यूड तथा जन्मतिथि से निकली आयु डिराइव्ड एट्रिब्यूट है।"},"a":{"en":"Key—Roll_No; multivalued—multiple phone numbers; derived—age from date of birth","hi":"की—रोल नंबर; मल्टीवैल्यूड—कई फ़ोन नंबर; डिराइव्ड—जन्मतिथि से आयु"},"source_docx_q":null,"id":"q78","num":78},{"q":{"en":"What is a Many-to-Many (M:N) relationship?","hi":"मैनी-टू-मैनी (Many-to-Many / M:N) संबंध क्या है?"},"o":[{"en":"Many databases are linked together","hi":"कई डेटाबेस एक साथ जुड़े हुए हैं"},{"en":"Records in Table A can relate to multiple records in Table B, and records in Table B can relate to multiple records in Table A (usually implemented via a junction table)","hi":"तालिका A में रिकॉर्ड तालिका B में कई रिकॉर्ड से संबंधित हो सकते हैं, और तालिका B में रिकॉर्ड तालिका A में कई रिकॉर्ड से संबंधित हो सकते हैं (आमतौर पर एक जंक्शन टेबल के माध्यम से कार्यान्वित/implemented किया जाता है)"},{"en":"Many users can delete many records","hi":"कई उपयोगकर्ता कई रिकॉर्ड हटा सकते हैं"},{"en":"None of the above","hi":"इनमें से कोई भी नहीं"}],"a":{"en":"Records in Table A can relate to multiple records in Table B, and records in Table B can relate to multiple records in Table A (usually implemented via a junction table)","hi":"तालिका A में रिकॉर्ड तालिका B में कई रिकॉर्ड से संबंधित हो सकते हैं, और तालिका B में रिकॉर्ड तालिका A में कई रिकॉर्ड से संबंधित हो सकते हैं (आमतौर पर एक जंक्शन टेबल के माध्यम से कार्यान्वित/implemented किया जाता है)"},"exp":{"en":"Example: Students and Courses. A Student can take many Courses, and a Course can have many Students enrolled.\nSource-note (Hinglish): Many-to-many. Ek student multiple courses le sakta hai aur ek course mein multiple students ho sakte hain.","hi":"उदाहरण: छात्र (Students) और पाठ्यक्रम (Courses)। एक छात्र कई पाठ्यक्रम ले सकता है, और एक पाठ्यक्रम में कई छात्र नामांकित (enrolled) हो सकते हैं।"},"source_docx_q":59,"id":"q79","num":79},{"q":{"en":"What is an ER Diagram (Entity-Relationship Diagram)?","hi":"ईआर आरेख (ER Diagram - Entity-Relationship Diagram) क्या है?"},"o":[{"en":"A chart showing employee hierarchy","hi":"कर्मचारी पदानुक्रम (hierarchy) दिखाने वाला एक चार्ट"},{"en":"A visual representation of the database structure, showing Entities, Attributes, and Relationships","hi":"डेटाबेस संरचना (database structure) का एक दृश्य प्रतिनिधित्व (visual representation), जो संस्थाओं (Entities), विशेषताओं (Attributes) और संबंधों (Relationships) को दर्शाता है"},{"en":"A physical map of a server room","hi":"सर्वर रूम का एक भौतिक नक्शा"},{"en":"A pie chart of data storage","hi":"डेटा स्टोरेज का पाई चार्ट"}],"a":{"en":"A visual representation of the database structure, showing Entities, Attributes, and Relationships","hi":"डेटाबेस संरचना (database structure) का एक दृश्य प्रतिनिधित्व (visual representation), जो संस्थाओं (Entities), विशेषताओं (Attributes) और संबंधों (Relationships) को दर्शाता है"},"exp":{"en":"ER diagrams are used during the database design phase to blueprint how data will be organized.","hi":"ईआर आरेख (ER diagrams) का उपयोग डेटाबेस डिज़ाइन चरण के दौरान यह रूपरेखा (blueprint) तैयार करने के लिए किया जाता है कि डेटा कैसे व्यवस्थित किया जाएगा।"},"id":"q111","num":111,"source_docx_q":68},{"q":{"en":"In an ER Diagram, what does a Rectangle represent?","hi":"एक ईआर आरेख (ER Diagram) में, एक आयत (Rectangle) क्या दर्शाता है?"},"o":[{"en":"A Relationship","hi":"एक संबंध"},{"en":"An Attribute","hi":"एक विशेषता"},{"en":"An Entity (an object or concept about which data is stored, e.g., 'Student', 'Course')","hi":"एक इकाई (Entity - एक वस्तु या अवधारणा जिसके बारे में डेटा संग्रहीत किया जाता है, जैसे, 'छात्र', 'पाठ्यक्रम')"},{"en":"The database server","hi":"डेटाबेस सर्वर"}],"a":{"en":"An Entity (an object or concept about which data is stored, e.g., 'Student', 'Course')","hi":"एक इकाई (Entity - एक वस्तु या अवधारणा जिसके बारे में डेटा संग्रहीत किया जाता है, जैसे, 'छात्र', 'पाठ्यक्रम')"},"exp":{"en":"Entities are typically real-world objects or concepts and become the 'Tables' in a relational database.","hi":"संस्थाएं (Entities) आमतौर पर वास्तविक दुनिया की वस्तुएं या अवधारणाएं होती हैं और रिलेशनल डेटाबेस में 'टेबल्स' (Tables) बन जाती हैं।"},"id":"q112","num":112,"source_docx_q":69},{"q":{"en":"In an ER Diagram, what does an Oval (Ellipse) represent?","hi":"ईआर आरेख (ER Diagram) में, एक अंडाकार/दीर्घवृत्त (Oval/Ellipse) क्या दर्शाता है?"},"o":[{"en":"An Entity","hi":"एक इकाई"},{"en":"A Relationship","hi":"एक संबंध"},{"en":"An Attribute (a property or characteristic of an entity, e.g., 'Name', 'Age')","hi":"एक विशेषता (Attribute - किसी इकाई की संपत्ति या विशेषता, जैसे, 'नाम', 'आयु')"},{"en":"A Primary Key","hi":"एक प्राथमिक कुंजी"}],"a":{"en":"An Attribute (a property or characteristic of an entity, e.g., 'Name', 'Age')","hi":"एक विशेषता (Attribute - किसी इकाई की संपत्ति या विशेषता, जैसे, 'नाम', 'आयु')"},"exp":{"en":"Attributes describe the entity. In a relational database, these become the 'Columns' in a table.","hi":"विशेषताएं (Attributes) इकाई (entity) का वर्णन करती हैं। रिलेशनल डेटाबेस में, ये तालिका में 'कॉलम' बन जाते हैं।"},"id":"q113","num":113,"source_docx_q":70},{"q":{"en":"In an ER Diagram, how is a Primary Key (Key Attribute) usually represented?","hi":"एक ईआर आरेख (ER Diagram) में, प्राथमिक कुंजी (Primary Key) को आमतौर पर कैसे दर्शाया जाता है?"},"o":[{"en":"By a bold rectangle","hi":"एक मोटे आयत द्वारा"},{"en":"By an oval with the attribute name underlined","hi":"एक अंडाकार (oval) द्वारा जिसके अंदर विशेषता के नाम (attribute name) को रेखांकित (underlined) किया गया हो"},{"en":"By a diamond","hi":"एक हीरे (diamond) द्वारा"},{"en":"By a dashed line","hi":"एक धराशायी रेखा (dashed line) द्वारा"}],"a":{"en":"By an oval with the attribute name underlined","hi":"एक अंडाकार (oval) द्वारा जिसके अंदर विशेषता के नाम (attribute name) को रेखांकित (underlined) किया गया हो"},"exp":{"en":"The underline inside the oval immediately identifies that attribute as the unique identifier (Primary Key) for the entity.","hi":"अंडाकार (oval) के अंदर की रेखा तुरंत उस विशेषता की पहचान इकाई के लिए अद्वितीय पहचानकर्ता (प्राथमिक कुंजी) के रूप में करती है।"},"id":"q114","num":114,"source_docx_q":71},{"q":{"en":"In an ER Diagram, what does a Diamond represent?","hi":"ईआर आरेख (ER Diagram) में, एक हीरा (Diamond) क्या दर्शाता है?"},"o":[{"en":"An Entity","hi":"एक इकाई"},{"en":"An Attribute","hi":"एक विशेषता"},{"en":"A Relationship (how two or more entities are associated, e.g., a student 'Enrolls' in a course)","hi":"एक संबंध (Relationship - दो या दो से अधिक संस्थाएं कैसे जुड़ी हुई हैं, जैसे, एक छात्र एक पाठ्यक्रम में 'नामांकन' - Enrolls - करता है)"},{"en":"The end of the diagram","hi":"आरेख (diagram) का अंत"}],"a":{"en":"A Relationship (how two or more entities are associated, e.g., a student 'Enrolls' in a course)","hi":"एक संबंध (Relationship - दो या दो से अधिक संस्थाएं कैसे जुड़ी हुई हैं, जैसे, एक छात्र एक पाठ्यक्रम में 'नामांकन' - Enrolls - करता है)"},"exp":{"en":"Diamonds connect rectangles (Entities) to show how they interact.","hi":"हीरे (Diamonds) आयतों (संस्थाओं) को जोड़ते हैं ताकि यह दिखाया जा सके कि वे कैसे बातचीत (interact) करते हैं।"},"id":"q115","num":115,"source_docx_q":72}]},{"title":{"en":"9. Exam Trap Reverse-Questions","hi":"9. परीक्षा के महत्वपूर्ण उल्टे प्रश्न"},"questions":[{"q":{"en":"Match Zoho Chief Scientist and Zoho Corp CEO following the 2025 transition.","hi":"2025 के बदलाव के बाद Zoho Chief Scientist और CEO का सही मिलान क्या है?"},"o":[{"en":"Chief Scientist—Shailesh Kumar Davey; CEO—Sridhar Vembu","hi":"चीफ़ साइंटिस्ट—शैलेश कुमार दवे; CEO—श्रीधर वेम्बू"},{"en":"Chief Scientist—Sridhar Vembu; CEO—Shailesh Kumar Davey","hi":"चीफ़ साइंटिस्ट—श्रीधर वेम्बू; CEO—शैलेश कुमार दवे"},{"en":"Chief Scientist—Tony Thomas; CEO—Peter Chen","hi":"चीफ़ साइंटिस्ट—टोनी थॉमस; CEO—पीटर चेन"},{"en":"Chief Scientist—Jaap Haartsen; CEO—E. F. Codd","hi":"चीफ़ साइंटिस्ट—जाप हार्टसन; CEO—ई. एफ. कॉड"}],"exp":{"en":"The source lists Sridhar Vembu as Chief Scientist and Shailesh Kumar Davey as Zoho Corp CEO after the leadership transition.","hi":"स्रोत के अनुसार बदलाव के बाद श्रीधर वेम्बू Chief Scientist और शैलेश कुमार दवे Zoho Corp CEO हैं।"},"a":{"en":"Chief Scientist—Sridhar Vembu; CEO—Shailesh Kumar Davey","hi":"चीफ़ साइंटिस्ट—श्रीधर वेम्बू; CEO—शैलेश कुमार दवे"},"source_docx_q":null,"id":"q80","num":80},{"q":{"en":"Gov.in was retained and the mail backend went to the cloud. What changed?","hi":"Gov.in बरकरार (retained) रखा गया और मेल बैकएंड क्लाउड पर चला गया। क्या बदला?"},"o":[{"en":"The domain name changed","hi":"डोमेन नाम बदल गया"},{"en":"Hosting/platform migration. The official email domain identity continued","hi":"होस्टिंग/प्लेटफॉर्म माइग्रेशन। आधिकारिक ईमेल डोमेन पहचान (official email domain identity) जारी रही"},{"en":"The email addresses were deleted","hi":"ईमेल पते हटा दिए गए थे"},{"en":"Passwords became public","hi":"पासवर्ड सार्वजनिक हो गए"}],"a":{"en":"Hosting/platform migration. The official email domain identity continued","hi":"होस्टिंग/प्लेटफॉर्म माइग्रेशन। आधिकारिक ईमेल डोमेन पहचान (official email domain identity) जारी रही"},"exp":{"en":"The migration changed where the data is stored and processed (backend), but not the user-facing email addresses (frontend).\nSource-note (Hinglish): Hosting/platform migration. Official email domain identity continue rahi.","hi":"माइग्रेशन ने बदल दिया कि डेटा कहाँ संग्रहीत और संसाधित (backend) किया जाता है, लेकिन उपयोगकर्ता-सामना (user-facing) करने वाले ईमेल पते (frontend) नहीं बदले।"},"source_docx_q":81,"id":"q81","num":81},{"q":{"en":"What is the timing for the initial notice and detailed follow-up to the Board under DPDP Rule 7?","hi":"DPDP नियम 7 के तहत बोर्ड को प्रारंभिक नोटिस और विस्तृत फॉलो-अप का समय क्या है?"},"o":[{"en":"Initial notice within 24 hours. Detailed information in 30 days / 24 घंटे के भीतर प्रारंभिक नोटिस। 30 दिन में विस्तृत जानकारी","hi":"Initial notice within 24 hours. Detailed information in 30 days / 24 घंटे के भीतर प्रारंभिक नोटिस। 30 दिन में विस्तृत जानकारी"},{"en":"Initial notice without delay. Detailed information normally within 72 hours, once Rule 7 applies","hi":"बिना किसी देरी के प्रारंभिक नोटिस (Initial notice without delay)। नियम 7 लागू होने पर सामान्यतः 72 घंटे के भीतर विस्तृत जानकारी"},{"en":"Both within 6 hours","hi":"दोनों 6 घंटे के भीतर"},{"en":"Initial notice in 7 days. No detailed information needed / 7 दिनों में प्रारंभिक नोटिस। कोई विस्तृत जानकारी की आवश्यकता नहीं है","hi":"Initial notice in 7 days. No detailed information needed / 7 दिनों में प्रारंभिक नोटिस। कोई विस्तृत जानकारी की आवश्यकता नहीं है"}],"a":{"en":"Initial notice without delay. Detailed information normally within 72 hours, once Rule 7 applies","hi":"बिना किसी देरी के प्रारंभिक नोटिस (Initial notice without delay)। नियम 7 लागू होने पर सामान्यतः 72 घंटे के भीतर विस्तृत जानकारी"},"exp":{"en":"This is the specific phased reporting timeline outlined in the DPDP Rules 2025 for data breaches.\nSource-note (Hinglish): Initial notice without delay. Detailed information normally 72 hours ke andar, Rule 7 apply hone par.","hi":"यह डेटा उल्लंघनों (data breaches) के लिए DPDP नियम 2025 में उल्लिखित विशिष्ट चरणबद्ध रिपोर्टिंग समयरेखा है।"},"source_docx_q":82,"id":"q82","num":82},{"q":{"en":"What are the degree and cardinality of a table with 69 columns and 12 rows?","hi":"69 कॉलम और 12 पंक्तियों (rows) वाली तालिका की डिग्री (degree) और कार्डिनैलिटी (cardinality) क्या है?"},"o":[{"en":"Degree 12. Cardinality 69","hi":"डिग्री 12. कार्डिनैलिटी 69"},{"en":"Degree 69. Cardinality 12","hi":"डिग्री 69. कार्डिनैलिटी 12"},{"en":"Degree 81. Cardinality 81","hi":"डिग्री 81. कार्डिनैलिटी 81"},{"en":"Degree 0. Cardinality 0","hi":"डिग्री 0. कार्डिनैलिटी 0"}],"a":{"en":"Degree 69. Cardinality 12","hi":"डिग्री 69. कार्डिनैलिटी 12"},"exp":{"en":"In relational database terminology, 'Degree' is the number of attributes (columns), and 'Cardinality' is the number of tuples (rows).\nSource-note (Hinglish): Degree 69. Cardinality 12.","hi":"रिलेशनल डेटाबेस शब्दावली में, 'डिग्री' (Degree) विशेषताओं (कॉलम) की संख्या है, और 'कार्डिनैलिटी' (Cardinality) टुपल्स (पंक्तियों) की संख्या है।"},"source_docx_q":83,"id":"q83","num":83},{"q":{"en":"If you add a redundant column to a unique identifier, what key remains?","hi":"यदि आप किसी विशिष्ट पहचानकर्ता (unique identifier) में एक अनावश्यक (redundant) कॉलम जोड़ते हैं, तो कौन सी कुंजी (key) शेष बचती है?"},"o":[{"en":"Primary key","hi":"प्राइमरी की (Primary key)"},{"en":"Super key. Once minimality is lost, it is no longer a candidate key","hi":"सुपर की (Super key)। एक बार अति-न्यूनतमता (minimality) समाप्त होने पर, यह अब उम्मीदवार कुंजी (candidate key) नहीं रहेगी"},{"en":"Foreign key","hi":"विदेशी कुंजी (Foreign key)"},{"en":"Alternate key","hi":"वैकल्पिक कुंजी (Alternate key)"}],"a":{"en":"Super key. Once minimality is lost, it is no longer a candidate key","hi":"सुपर की (Super key)। एक बार अति-न्यूनतमता (minimality) समाप्त होने पर, यह अब उम्मीदवार कुंजी (candidate key) नहीं रहेगी"},"exp":{"en":"A Super Key uniquely identifies a row but may contain extra, unnecessary columns. A Candidate Key is a 'minimal' super key (no extra columns).\nSource-note (Hinglish): Super key. Minimality khatam hone par candidate key nahin rahegi.","hi":"एक सुपर की विशिष्ट रूप से एक पंक्ति की पहचान करती है, लेकिन इसमें अतिरिक्त, अनावश्यक कॉलम हो सकते हैं। एक कैंडिडेट की एक 'न्यूनतम' सुपर की (कोई अतिरिक्त कॉलम नहीं) है।"},"source_docx_q":84,"id":"q84","num":84},{"q":{"en":"Giving permissions, retrieving a row, and saving a transaction correspond to which command pair/group?","hi":"अनुमतियाँ (permissions) देना, एक पंक्ति (row) पुनर्प्राप्त (retrieve) करना और लेनदेन (transaction) को सहेजना किस कमांड जोड़ी/समूह से मेल खाता है?"},"o":[{"en":"CREATE, INSERT, DROP","hi":"CREATE, INSERT, DROP"},{"en":"GRANT (DCL), SELECT (DQL exam category), and COMMIT (TCL) / GRANT (DCL), SELECT (DQL परीक्षा श्रेणी), और COMMIT (TCL)","hi":"GRANT (DCL), SELECT (DQL exam category), and COMMIT (TCL) / GRANT (DCL), SELECT (DQL परीक्षा श्रेणी), और COMMIT (TCL)"},{"en":"REVOKE, DELETE, ROLLBACK","hi":"REVOKE, DELETE, ROLLBACK"},{"en":"ALTER, UPDATE, SAVEPOINT","hi":"ALTER, UPDATE, SAVEPOINT"}],"a":{"en":"GRANT (DCL), SELECT (DQL exam category), and COMMIT (TCL) / GRANT (DCL), SELECT (DQL परीक्षा श्रेणी), और COMMIT (TCL)","hi":"GRANT (DCL), SELECT (DQL exam category), and COMMIT (TCL) / GRANT (DCL), SELECT (DQL परीक्षा श्रेणी), और COMMIT (TCL)"},"exp":{"en":"GRANT controls access (DCL). SELECT retrieves data (often DQL/DML). COMMIT finalizes a transaction (TCL).\nSource-note (Hinglish): GRANT (DCL), SELECT (DQL exam category) aur COMMIT (TCL).","hi":"GRANT पहुंच (DCL) को नियंत्रित करता है। SELECT डेटा (अक्सर DQL/DML) पुनर्प्राप्त करता है। COMMIT लेनदेन (TCL) को अंतिम रूप देता है।"},"source_docx_q":85,"id":"q85","num":85},{"q":{"en":"In an ER diagram, a double oval and a dashed oval are clues for which attributes?","hi":"ER आरेख में, एक डबल अंडाकार (double oval) और एक धराशायी अंडाकार (dashed oval) किन विशेषताओं (attributes) के संकेत हैं?"},"o":[{"en":"Double oval → composite. Dashed oval → simple","hi":"डबल ओवल → मिश्रित (composite)। धराशायी ओवल → सरल (simple)"},{"en":"Double oval → multivalued. Dashed oval → derived","hi":"डबल ओवल → बहु-मूल्यवान (multivalued)। धराशायी ओवल → व्युत्पन्न (derived)"},{"en":"Double oval → primary key. Dashed oval → foreign key","hi":"डबल ओवल → प्राइमरी की। धराशायी ओवल → विदेशी कुंजी"},{"en":"Double oval → weak entity. Dashed oval → strong entity","hi":"डबल ओवल → कमजोर इकाई। धराशायी ओवल → मजबूत इकाई"}],"a":{"en":"Double oval → multivalued. Dashed oval → derived","hi":"डबल ओवल → बहु-मूल्यवान (multivalued)। धराशायी ओवल → व्युत्पन्न (derived)"},"exp":{"en":"A multivalued attribute (e.g., Phone Numbers) has a double oval. A derived attribute (e.g., Age, calculated from DOB) has a dashed oval.\nSource-note (Hinglish): Double oval → multivalued. Dashed oval → derived.","hi":"बहु-मूल्यवान विशेषता (जैसे, फ़ोन नंबर) में एक डबल अंडाकार होता है। व्युत्पन्न विशेषता (जैसे, आयु, जन्मतिथि से गणना की गई) में एक धराशायी अंडाकार होता है।"},"source_docx_q":86,"id":"q86","num":86}]},{"title":{"en":"10. Rapid-Fire Final Revision","hi":"10. त्वरित अंतिम पुनरावृत्ति"},"questions":[{"q":{"en":"What was Zoho's original company name?","hi":"ज़ोहो का मूल कंपनी नाम क्या था?"},"o":[{"en":"ManageEngine","hi":"ManageEngine"},{"en":"AdventNet","hi":"एडवेंटनेट (AdventNet)"},{"en":"WebEx","hi":"WebEx"},{"en":"Zoho Corp","hi":"Zoho Corp"}],"a":{"en":"AdventNet","hi":"एडवेंटनेट (AdventNet)"},"exp":{"en":"Zoho started as AdventNet Inc. in 1996.\nSource-note (Hinglish): AdventNet.","hi":"ज़ोहो की शुरुआत 1996 में एडवेंटनेट इंक. के रूप में हुई थी।"},"source_docx_q":87,"id":"q87","num":87},{"q":{"en":"Who is the Zoho-associated name that received the Padma Shri in 2021 for Trade and Industry?","hi":"व्यापार और उद्योग के लिए 2021 में पद्म श्री प्राप्त करने वाला ज़ोहो से जुड़ा नाम कौन सा है?"},"o":[{"en":"Nandan Nilekani","hi":"Nandan Nilekani"},{"en":"Sridhar Vembu","hi":"श्रीधर वेम्बू"},{"en":"Tony Thomas","hi":"Tony Thomas"},{"en":"Sundar Pichai","hi":"Sundar Pichai"}],"a":{"en":"Sridhar Vembu","hi":"श्रीधर वेम्बू"},"exp":{"en":"Sridhar Vembu, co-founder of Zoho, received this honour.\nSource-note (Hinglish): Sridhar Vembu.","hi":"ज़ोहो के सह-संस्थापक श्रीधर वेम्बू को यह सम्मान मिला।"},"source_docx_q":88,"id":"q88","num":88},{"q":{"en":"What is the name of the Government of India's cloud initiative?","hi":"भारत सरकार की क्लाउड पहल (cloud initiative) का नाम क्या है?"},"o":[{"en":"DigiLocker","hi":"DigiLocker"},{"en":"MeghRaj","hi":"मेघराज (MeghRaj)"},{"en":"NIC Cloud","hi":"NIC Cloud"},{"en":"BharatNet","hi":"BharatNet"}],"a":{"en":"MeghRaj","hi":"मेघराज (MeghRaj)"},"exp":{"en":"MeghRaj is the GI Cloud initiative to optimize ICT spending.\nSource-note (Hinglish): MeghRaj.","hi":"मेघराज ICT खर्च को अनुकूलित करने के लिए GI क्लाउड पहल है।"},"source_docx_q":89,"id":"q89","num":89},{"q":{"en":"Which agency provides the government email infrastructure?","hi":"कौन सी एजेंसी सरकारी ईमेल बुनियादी ढांचा (infrastructure) प्रदान करती है?"},"o":[{"en":"BSNL","hi":"BSNL"},{"en":"National Informatics Centre (NIC)","hi":"राष्ट्रीय सूचना विज्ञान केंद्र (NIC)"},{"en":"MeitY","hi":"MeitY"},{"en":"CDAC","hi":"CDAC"}],"a":{"en":"National Informatics Centre (NIC)","hi":"राष्ट्रीय सूचना विज्ञान केंद्र (NIC)"},"exp":{"en":"NIC retains strategic control over the government email setup.\nSource-note (Hinglish): National Informatics Centre (NIC).","hi":"NIC सरकारी ईमेल सेटअप पर रणनीतिक नियंत्रण रखता है।"},"source_docx_q":90,"id":"q90","num":90},{"q":{"en":"What are the years of the DPDP Act and its notified Rules?","hi":"DPDP अधिनियम और इसके अधिसूचित नियमों (notified Rules) के वर्ष क्या हैं?"},"o":[{"en":"Act 2021. Rules 2023","hi":"Act 2021. Rules 2023"},{"en":"Act 2023. Rules 2025","hi":"अधिनियम 2023. नियम 2025"},{"en":"Act 2020. Rules 2022","hi":"Act 2020. Rules 2022"},{"en":"Act 2024. Rules 2025","hi":"Act 2024. Rules 2025"}],"a":{"en":"Act 2023. Rules 2025","hi":"अधिनियम 2023. नियम 2025"},"exp":{"en":"The DPDP Act was passed in 2023; the operational Rules were notified in 2025.\nSource-note (Hinglish): Act 2023. Rules 2025.","hi":"DPDP अधिनियम 2023 में पारित किया गया था; परिचालन नियम 2025 में अधिसूचित किए गए थे।"},"source_docx_q":91,"id":"q91","num":91},{"q":{"en":"What was India's rank in the WIPO GII 2024?","hi":"WIPO GII 2024 में भारत की रैंक क्या थी?"},"o":[{"en":"66th","hi":"66th"},{"en":"39th / 39वाँ","hi":"39th / 39वाँ"},{"en":"45th","hi":"45th"},{"en":"50th","hi":"50th"}],"a":{"en":"39th / 39वाँ","hi":"39th / 39वाँ"},"exp":{"en":"India ranked 39th in the Global Innovation Index 2024.\nSource-note (Hinglish): 39th.","hi":"भारत ग्लोबल इनोवेशन इंडेक्स 2024 में 39वें स्थान पर रहा।"},"source_docx_q":92,"id":"q92","num":92},{"q":{"en":"Which Zoho apps are used for spreadsheets and presentations?","hi":"स्प्रेडशीट और प्रेजेंटेशन के लिए कौन से ज़ोहो ऐप का उपयोग किया जाता है?"},"o":[{"en":"Docs and Mail","hi":"Docs and Mail"},{"en":"Sheet and Show","hi":"शीट और शो (Sheet and Show)"},{"en":"WorkDrive and CRM","hi":"WorkDrive and CRM"},{"en":"Writer and Meet","hi":"Writer and Meet"}],"a":{"en":"Sheet and Show","hi":"शीट और शो (Sheet and Show)"},"exp":{"en":"Zoho Sheet is for spreadsheets; Zoho Show is for presentations.\nSource-note (Hinglish): Sheet aur Show.","hi":"ज़ोहो शीट स्प्रेडशीट के लिए है; ज़ोहो शो प्रेजेंटेशन के लिए है।"},"source_docx_q":93,"id":"q93","num":93},{"q":{"en":"Who is the proposer of the Relational model?","hi":"रिलेशनल मॉडल के प्रस्तावक (proposer) कौन हैं?"},"o":[{"en":"Bill Gates","hi":"Bill Gates"},{"en":"E. F. Codd","hi":"ई. एफ. कॉड (E. F. Codd)"},{"en":"Larry Ellison","hi":"Larry Ellison"},{"en":"Charles Babbage","hi":"Charles Babbage"}],"a":{"en":"E. F. Codd","hi":"ई. एफ. कॉड (E. F. Codd)"},"exp":{"en":"Dr. E. F. Codd invented the relational database model in 1970.\nSource-note (Hinglish): E. F. Codd.","hi":"डॉ. ई. एफ. कॉड ने 1970 में रिलेशनल डेटाबेस मॉडल का आविष्कार किया था।"},"source_docx_q":94,"id":"q94","num":94},{"q":{"en":"Can a primary key be NULL?","hi":"क्या प्राथमिक कुंजी (primary key) NULL हो सकती है?"},"o":[{"en":"Yes, always","hi":"Yes, always"},{"en":"No","hi":"नहीं"},{"en":"Only in foreign keys","hi":"Only in foreign keys"},{"en":"Only if it is a number","hi":"Only if it is a number"}],"a":{"en":"No","hi":"नहीं"},"exp":{"en":"A primary key must uniquely identify a row and therefore cannot be NULL.\nSource-note (Hinglish): Nahin.","hi":"एक प्राथमिक कुंजी को विशिष्ट रूप से एक पंक्ति की पहचान करनी चाहिए और इसलिए यह NULL नहीं हो सकती।"},"source_docx_q":95,"id":"q95","num":95},{"q":{"en":"Which command clears all rows but retains the table structure?","hi":"कौन सा कमांड सभी पंक्तियों (rows) को साफ़ करता है लेकिन तालिका संरचना (table structure) को बरकरार रखता है?"},"o":[{"en":"DROP","hi":"DROP"},{"en":"TRUNCATE","hi":"ट्रंकेट (TRUNCATE)"},{"en":"DELETE","hi":"DELETE"},{"en":"REMOVE","hi":"REMOVE"}],"a":{"en":"TRUNCATE","hi":"ट्रंकेट (TRUNCATE)"},"exp":{"en":"TRUNCATE is a DDL command that quickly removes all records from a table without deleting the table itself.\nSource-note (Hinglish): TRUNCATE.","hi":"TRUNCATE एक DDL कमांड है जो तालिका को हटाए बिना तालिका से सभी रिकॉर्ड को जल्दी से हटा देता है।"},"source_docx_q":96,"id":"q96","num":96},{"q":{"en":"What is the symbol for an ER relationship?","hi":"ER संबंध (relationship) का प्रतीक क्या है?"},"o":[{"en":"Rectangle","hi":"आयत"},{"en":"Diamond","hi":"हीरा (Diamond)"},{"en":"Oval","hi":"अंडाकार"},{"en":"Line","hi":"रेखा"}],"a":{"en":"Diamond","hi":"हीरा (Diamond)"},"exp":{"en":"A diamond shape represents a relationship between entities in an ER diagram.\nSource-note (Hinglish): Diamond.","hi":"हीरे (Diamond) का आकार एक ER आरेख में संस्थाओं के बीच संबंध को दर्शाता है।"},"source_docx_q":97,"id":"q97","num":97}]}],"14. Artificial Intelligence, AI Tools & IndiaAI":[{"title":{"en":"1. Artificial Intelligence — Basics & History","hi":"1. कृत्रिम बुद्धिमत्ता — मूल बातें और इतिहास"},"questions":[{"q":{"en":"What is the full form and definition of AI?","hi":"AI का पूर्ण रूप और परिभाषा क्या है?"},"a":{"en":"Artificial Intelligence. A branch of computer science that enables systems to perform tasks like learning, reasoning, problem-solving, perception, and language understanding","hi":"आर्टिफिशियल इंटेलिजेंस (कृत्रिम बुद्धिमत्ता)। कंप्यूटर विज्ञान की वह शाखा जो सिस्टम को सीखने (learning), तर्क करने (reasoning), समस्या-समाधान (problem-solving), धारणा (perception) और भाषा को समझने जैसे कार्य करने में सक्षम बनाती है"},"o":[{"en":"Automated Information. A software for sorting data","hi":"ऑटोमेटेड इंफॉर्मेशन। डेटा छांटने के लिए एक सॉफ्टवेयर"},{"en":"Artificial Intelligence. A branch of computer science that enables systems to perform tasks like learning, reasoning, problem-solving, perception, and language understanding","hi":"आर्टिफिशियल इंटेलिजेंस (कृत्रिम बुद्धिमत्ता)। कंप्यूटर विज्ञान की वह शाखा जो सिस्टम को सीखने (learning), तर्क करने (reasoning), समस्या-समाधान (problem-solving), धारणा (perception) और भाषा को समझने जैसे कार्य करने में सक्षम बनाती है"},{"en":"Applied Internet. A network protocol","hi":"एप्लाइड इंटरनेट। एक नेटवर्क प्रोटोकॉल"},{"en":"Advanced Integration. A hardware component","hi":"एडवांस्ड इंटीग्रेशन। एक हार्डवेयर घटक"}],"exp":{"en":"Artificial Intelligence encompasses the techniques and methods used to build machines that exhibit human-like cognitive abilities.\nSource-note (Hinglish): Artificial Intelligence (कृत्रिम बुद्धिमत्ता). Computer science ki branch jo systems ko learning, reasoning, problem-solving, perception aur language understanding jaise tasks karne mein enable karti hai.","hi":"आर्टिफिशियल इंटेलिजेंस (AI) उन तकनीकों और विधियों को शामिल करता है जिनका उपयोग ऐसी मशीनें बनाने के लिए किया जाता है जो मानव जैसी संज्ञानात्मक क्षमताओं (cognitive abilities) को प्रदर्शित करती हैं।"},"id":"q1","num":1},{"q":{"en":"Why is AI called 'machine intelligence'?","hi":"AI को 'मशीन इंटेलिजेंस' क्यों कहा जाता है?"},"a":{"en":"Because systems can interpret signals from data or the environment to produce predictions, content, or decisions, and some select actions to achieve a goal","hi":"क्योंकि सिस्टम डेटा या पर्यावरण (environment) से संकेतों की व्याख्या (interpret) करके भविष्यवाणियां, सामग्री (content) या निर्णय उत्पन्न कर सकते हैं, और कुछ AI सिस्टम लक्ष्य प्राप्त करने के लिए कार्यों (actions) का चयन भी करते हैं"},"o":[{"en":"Because it only runs on mechanical machines","hi":"क्योंकि यह केवल यांत्रिक मशीनों पर चलता है"},{"en":"Because systems can interpret signals from data or the environment to produce predictions, content, or decisions, and some select actions to achieve a goal","hi":"क्योंकि सिस्टम डेटा या पर्यावरण (environment) से संकेतों की व्याख्या (interpret) करके भविष्यवाणियां, सामग्री (content) या निर्णय उत्पन्न कर सकते हैं, और कुछ AI सिस्टम लक्ष्य प्राप्त करने के लिए कार्यों (actions) का चयन भी करते हैं"},{"en":"Because it is entirely programmed with fixed rules","hi":"क्योंकि यह पूरी तरह से निश्चित नियमों के साथ प्रोग्राम किया गया है"},{"en":"Because it does not require electricity","hi":"क्योंकि इसे बिजली की आवश्यकता नहीं होती है"}],"exp":{"en":"The 'intelligence' lies in the machine's ability to adapt, learn from data, and make autonomous or semi-autonomous decisions to achieve specific objectives.\nSource-note (Hinglish): Systems data ya environment se signals interpret karke predictions, content ya decisions produce kar sakte hain. Kuch AI systems goal achieve karne ke liye actions bhi select karte hain.","hi":"मशीन की 'बुद्धिमत्ता' (intelligence) विशिष्ट उद्देश्यों को प्राप्त करने के लिए अनुकूलन (adapt) करने, डेटा से सीखने और स्वायत्त (autonomous) या अर्ध-स्वायत्त निर्णय लेने की क्षमता में निहित है।"},"id":"q2","num":2},{"q":{"en":"Is AI research a recent invention?","hi":"क्या AI अनुसंधान (research) एक हालिया आविष्कार है?"},"a":{"en":"No, it was established as a named research field in the 1950s. Modern AI capabilities and applications have expanded significantly since then","hi":"नहीं, इसे 1950 के दशक में एक नामित अनुसंधान क्षेत्र (named research field) के रूप में स्थापित किया गया था। आधुनिक AI क्षमताएं और अनुप्रयोग (applications) उसके बाद काफी विस्तारित (expand) हुए हैं"},"o":[{"en":"Yes, it started in 2015","hi":"हाँ, यह 2015 में शुरू हुआ"},{"en":"No, it was established as a named research field in the 1950s. Modern AI capabilities and applications have expanded significantly since then","hi":"नहीं, इसे 1950 के दशक में एक नामित अनुसंधान क्षेत्र (named research field) के रूप में स्थापित किया गया था। आधुनिक AI क्षमताएं और अनुप्रयोग (applications) उसके बाद काफी विस्तारित (expand) हुए हैं"},{"en":"Yes, it began with the internet","hi":"हाँ, यह इंटरनेट के साथ शुरू हुआ"},{"en":"It is just a theory and doesn't exist yet","hi":"यह सिर्फ एक सिद्धांत है और अभी तक अस्तित्व में नहीं है"}],"exp":{"en":"While modern deep learning and generative AI are relatively recent breakthroughs, the foundational concepts and formal research field of AI began in the mid-20th century.\nSource-note (Hinglish): AI as a named research field 1950s mein establish hua. Modern AI ki capabilities aur applications uske baad kaafi expand hui hain.","hi":"जबकि आधुनिक डीप लर्निंग और जेनरेटिव AI अपेक्षाकृत हालिया सफलताएँ (breakthroughs) हैं, AI की मूलभूत अवधारणाएँ और औपचारिक अनुसंधान क्षेत्र 20वीं सदी के मध्य में शुरू हुआ।"},"id":"q3","num":3},{"q":{"en":"What is Narrow AI?","hi":"नैरो एआई (Narrow AI) क्या है?"},"a":{"en":"AI designed for a specific task or a limited family of tasks, such as a spam filter or an image classifier","hi":"एक विशिष्ट कार्य (specific task) या कार्यों के सीमित परिवार के लिए डिज़ाइन किया गया AI, जैसे स्पैम फ़िल्टर या छवि क्लासिफायर (image classifier)"},"o":[{"en":"AI that is physically small","hi":"AI जो शारीरिक रूप से छोटा है"},{"en":"AI designed for a specific task or a limited family of tasks, such as a spam filter or an image classifier","hi":"एक विशिष्ट कार्य (specific task) या कार्यों के सीमित परिवार के लिए डिज़ाइन किया गया AI, जैसे स्पैम फ़िल्टर या छवि क्लासिफायर (image classifier)"},{"en":"AI that can do any human task (AGI)","hi":"AI जो कोई भी मानवीय कार्य कर सकता है (AGI)"},{"en":"AI that only understands numbers","hi":"AI जो केवल संख्याओं को समझता है"}],"exp":{"en":"Almost all current AI applications, from voice assistants to recommendation engines, are forms of Narrow AI (also called Weak AI) because they specialize in specific domains.\nSource-note (Hinglish): Specific task ya limited task family ke liye designed AI, jaise spam filter ya image classifier.","hi":"वॉयस असिस्टेंट से लेकर अनुशंसा इंजन (recommendation engines) तक, लगभग सभी वर्तमान AI एप्लिकेशन नैरो AI (जिसे वीक AI भी कहा जाता है) के रूप हैं क्योंकि वे विशिष्ट डोमेन के विशेषज्ञ होते हैं।"},"id":"q4","num":4},{"q":{"en":"What does an expert system do?","hi":"एक विशेषज्ञ प्रणाली (expert system) क्या करती है?"},"a":{"en":"It emulates the decision-making of a human expert in a specific domain. Traditional expert systems use a knowledge base and inference rules","hi":"यह एक विशिष्ट डोमेन में मानव विशेषज्ञ (human expert) के निर्णय लेने (decision-making) का अनुकरण (emulate) करती है। पारंपरिक विशेषज्ञ प्रणालियाँ (expert systems) ज्ञान आधार (knowledge base) और अनुमान नियमों (inference rules) का उपयोग करती हैं"},"o":[{"en":"It fixes broken hardware","hi":"यह टूटे हुए हार्डवेयर को ठीक करती है"},{"en":"It emulates the decision-making of a human expert in a specific domain. Traditional expert systems use a knowledge base and inference rules","hi":"यह एक विशिष्ट डोमेन में मानव विशेषज्ञ (human expert) के निर्णय लेने (decision-making) का अनुकरण (emulate) करती है। पारंपरिक विशेषज्ञ प्रणालियाँ (expert systems) ज्ञान आधार (knowledge base) और अनुमान नियमों (inference rules) का उपयोग करती हैं"},{"en":"It trains human experts","hi":"यह मानव विशेषज्ञों को प्रशिक्षित करती है"},{"en":"It is an operating system","hi":"यह एक ऑपरेटिंग सिस्टम है"}],"exp":{"en":"Expert systems were highly popular in the 1980s. They rely on explicitly programmed 'if-then' rules rather than modern machine learning algorithms.\nSource-note (Hinglish): Specific domain mein human expert ke decision-making ko emulate karta hai. Traditional expert systems knowledge base aur inference rules use karte hain.","hi":"1980 के दशक में विशेषज्ञ प्रणालियाँ (Expert systems) अत्यधिक लोकप्रिय थीं। वे आधुनिक मशीन लर्निंग एल्गोरिदम के बजाय स्पष्ट रूप से प्रोग्राम किए गए 'if-then' नियमों पर निर्भर करती हैं।"},"id":"q5","num":5},{"q":{"en":"Who was Alan Turing and what are his years?","hi":"एलन ट्यूरिंग (Alan Turing) कौन थे और उनके वर्ष क्या हैं?"},"a":{"en":"A British mathematician and computing pioneer, 1912–1954. Remembered for the concept of the Turing machine and early work on machine intelligence","hi":"ब्रिटिश गणितज्ञ और कंप्यूटिंग अग्रणी (pioneer), 1912-1954। ट्यूरिंग मशीन की अवधारणा (concept) और मशीन इंटेलिजेंस पर प्रारंभिक कार्य के लिए याद किए जाते हैं"},"o":[{"en":"An American inventor, 1900–1980","hi":"एक अमेरिकी आविष्कारक, 1900–1980"},{"en":"A British mathematician and computing pioneer, 1912–1954. Remembered for the concept of the Turing machine and early work on machine intelligence","hi":"ब्रिटिश गणितज्ञ और कंप्यूटिंग अग्रणी (pioneer), 1912-1954। ट्यूरिंग मशीन की अवधारणा (concept) और मशीन इंटेलिजेंस पर प्रारंभिक कार्य के लिए याद किए जाते हैं"},{"en":"A French scientist, 1850–1910","hi":"एक फ्रांसीसी वैज्ञानिक, 1850–1910"},{"en":"A modern software developer","hi":"एक आधुनिक सॉफ्टवेयर डेवलपर"}],"exp":{"en":"Turing is widely considered the father of theoretical computer science and artificial intelligence.\nSource-note (Hinglish): British mathematician aur computing pioneer, 1912–1954. Turing machine ka concept aur machine intelligence par early work ke liye yaad rakhe jaate hain.","hi":"ट्यूरिंग को व्यापक रूप से सैद्धांतिक कंप्यूटर विज्ञान और कृत्रिम बुद्धिमत्ता (AI) का जनक (father) माना जाता है।"},"id":"q6","num":6},{"q":{"en":"What is the difference between a Turing machine and the Turing Test?","hi":"ट्यूरिंग मशीन (Turing machine) और ट्यूरिंग टेस्ट (Turing Test) में क्या अंतर है?"},"a":{"en":"A Turing machine is a mathematical model of computation. The Turing Test is an 'imitation game' idea to evaluate conversational behaviour","hi":"ट्यूरिंग मशीन संगणना (computation) का एक गणितीय मॉडल (mathematical model) है। ट्यूरिंग टेस्ट संवादी व्यवहार (conversational behaviour) का मूल्यांकन करने के लिए एक 'नकल के खेल' (imitation-game) का विचार है"},"o":[{"en":"They are the same thing","hi":"वे एक ही बात हैं"},{"en":"A Turing machine is a physical robot. The Turing Test is a written exam","hi":"ट्यूरिंग मशीन एक भौतिक रोबोट है। ट्यूरिंग टेस्ट एक लिखित परीक्षा है"},{"en":"A Turing machine is a mathematical model of computation. The Turing Test is an 'imitation game' idea to evaluate conversational behaviour","hi":"ट्यूरिंग मशीन संगणना (computation) का एक गणितीय मॉडल (mathematical model) है। ट्यूरिंग टेस्ट संवादी व्यवहार (conversational behaviour) का मूल्यांकन करने के लिए एक 'नकल के खेल' (imitation-game) का विचार है"},{"en":"The Turing machine plays chess, the Turing Test writes code","hi":"ट्यूरिंग मशीन शतरंज खेलती है, ट्यूरिंग टेस्ट कोड लिखता है"}],"exp":{"en":"The Turing machine (1936) proved what can be computed. The Turing Test (1950) proposed a way to measure if a machine can exhibit intelligent behaviour equivalent to a human.\nSource-note (Hinglish): Turing machine computation ka mathematical model hai. Turing Test conversational behaviour ko evaluate karne wala imitation-game idea hai.","hi":"ट्यूरिंग मशीन (1936) ने साबित किया कि क्या गणना की जा सकती है। ट्यूरिंग टेस्ट (1950) ने यह मापने का एक तरीका प्रस्तावित किया कि क्या मशीन मानव के समकक्ष बुद्धिमान व्यवहार प्रदर्शित कर सकती है।"},"id":"q7","num":7},{"q":{"en":"What is the basic idea of the Turing Test?","hi":"ट्यूरिंग टेस्ट (Turing Test) का मूल विचार क्या है?"},"a":{"en":"In a text conversation, a human evaluator attempts to distinguish the responses of a machine from those of a human. The test focuses on observed conversational behaviour","hi":"एक टेक्स्ट बातचीत में, एक मानव मूल्यांकनकर्ता (evaluator) मशीन की प्रतिक्रियाओं को इंसान की प्रतिक्रियाओं से अलग करने (distinguish) का प्रयास करता है। यह परीक्षण देखे गए संवादी व्यवहार (conversational behaviour) पर केंद्रित है"},"o":[{"en":"To measure a computer's processing speed","hi":"कंप्यूटर की प्रोसेसिंग गति को मापने के लिए"},{"en":"In a text conversation, a human evaluator attempts to distinguish the responses of a machine from those of a human. The test focuses on observed conversational behaviour","hi":"एक टेक्स्ट बातचीत में, एक मानव मूल्यांकनकर्ता (evaluator) मशीन की प्रतिक्रियाओं को इंसान की प्रतिक्रियाओं से अलग करने (distinguish) का प्रयास करता है। यह परीक्षण देखे गए संवादी व्यवहार (conversational behaviour) पर केंद्रित है"},{"en":"To see if a computer can write a book","hi":"यह देखने के लिए कि क्या कंप्यूटर कोई किताब लिख सकता है"},{"en":"To check if a computer can connect to the internet","hi":"यह जांचने के लिए कि क्या कंप्यूटर इंटरनेट से जुड़ सकता है"}],"exp":{"en":"If the evaluator cannot reliably tell which participant is the machine and which is the human, the machine is said to have passed the test.\nSource-note (Hinglish): Text conversation mein human evaluator machine aur human ke responses ko distinguish karne ki koshish karta hai. Test observed conversational behaviour par focus karta hai.","hi":"यदि मूल्यांकनकर्ता (evaluator) विश्वसनीय रूप से यह नहीं बता सकता कि कौन सा प्रतिभागी मशीन है और कौन इंसान, तो मशीन को टेस्ट पास करने वाला कहा जाता है।"},"id":"q8","num":8},{"q":{"en":"What was Alan Turing's 1950 paper?","hi":"एलन ट्यूरिंग का 1950 का पेपर (paper) कौन सा था?"},"a":{"en":"'Computing Machinery and Intelligence'. This discussed the imitation game","hi":"'कंप्यूटिंग मशीनरी एंड इंटेलिजेंस' (Computing Machinery and Intelligence)। इसमें इमिटेशन गेम (imitation game) पर चर्चा की गई"},"o":[{"en":"'The Principles of Computers'","hi":"'द प्रिंसिपल्स ऑफ कंप्यूटर्स'"},{"en":"'Computing Machinery and Intelligence'. This discussed the imitation game","hi":"'कंप्यूटिंग मशीनरी एंड इंटेलिजेंस' (Computing Machinery and Intelligence)। इसमें इमिटेशन गेम (imitation game) पर चर्चा की गई"},{"en":"'Artificial Intelligence Fundamentals'","hi":"'आर्टिफिशियल इंटेलिजेंस फंडामेंटल्स'"},{"en":"'The Future of Robots'","hi":"'द फ्यूचर ऑफ रोबोट्स'"}],"exp":{"en":"This seminal paper opened with the question, 'Can machines think?' and introduced the concept of the Turing Test.\nSource-note (Hinglish): “Computing Machinery and Intelligence.” Ismein imitation game discuss hua.","hi":"यह प्रारंभिक पेपर 'क्या मशीनें सोच सकती हैं?' प्रश्न के साथ शुरू हुआ और इसने ट्यूरिंग टेस्ट की अवधारणा पेश की।"},"id":"q9","num":9},{"q":{"en":"Who is the exam clue 'Father of Artificial Intelligence' typically used for?","hi":"परीक्षाओं में 'कृत्रिम बुद्धिमत्ता के जनक' (Father of Artificial Intelligence) का सुराग आमतौर पर किसके लिए उपयोग किया जाता है?"},"a":{"en":"John McCarthy (1927–2011). Associated with the Dartmouth AI project and the Lisp programming language","hi":"जॉन मैक्कार्थी (1927-2011)। डार्टमाउथ (Dartmouth) AI प्रोजेक्ट और लिस्प (Lisp) प्रोग्रामिंग भाषा से जुड़े"},"o":[{"en":"Elon Musk","hi":"Elon Musk"},{"en":"John McCarthy (1927–2011). Associated with the Dartmouth AI project and the Lisp programming language","hi":"जॉन मैक्कार्थी (1927-2011)। डार्टमाउथ (Dartmouth) AI प्रोजेक्ट और लिस्प (Lisp) प्रोग्रामिंग भाषा से जुड़े"},{"en":"Bill Gates","hi":"Bill Gates"},{"en":"Tim Berners-Lee","hi":"Tim Berners-Lee"}],"exp":{"en":"McCarthy coined the term 'Artificial Intelligence' in 1955 and was a driving force behind the 1956 Dartmouth conference.\nSource-note (Hinglish): John McCarthy (1927–2011). Dartmouth AI project aur Lisp programming language se associated.","hi":"मैक्कार्थी ने 1955 में 'आर्टिफिशियल इंटेलिजेंस' शब्द गढ़ा था और 1956 के डार्टमाउथ सम्मेलन के पीछे एक प्रेरक शक्ति थे।"},"id":"q10","num":10},{"q":{"en":"What is the difference between 1955 and 1956 in Dartmouth AI history?","hi":"डार्टमाउथ AI इतिहास में 1955 और 1956 का क्या अंतर है?"},"o":[{"en":"The term 'artificial intelligence' appeared in the Dartmouth proposal in 1955; the summer workshop took place in 1956","hi":"'आर्टिफिशियल इंटेलिजेंस' शब्द 1955 के डार्टमाउथ प्रस्ताव में था; समर वर्कशॉप 1956 में हुई"},{"en":"The workshop happened in 1955, and its proposal was written in 1956","hi":"वर्कशॉप 1955 में हुई और उसका प्रस्ताव 1956 में लिखा गया"},{"en":"Both 1955 and 1956 refer to the same date of one meeting","hi":"1955 और 1956 दोनों एक बैठक की एक ही तारीख बताते हैं"},{"en":"The proposal and the summer workshop both occurred in 1955","hi":"प्रस्ताव और समर वर्कशॉप दोनों 1955 में हुए"}],"a":{"en":"The term 'artificial intelligence' appeared in the Dartmouth proposal in 1955; the summer workshop took place in 1956","hi":"'आर्टिफिशियल इंटेलिजेंस' शब्द 1955 के डार्टमाउथ प्रस्ताव में था; समर वर्कशॉप 1956 में हुई"},"exp":{"en":"The source distinguishes the 1955 Dartmouth AI research proposal, in which the phrase “artificial intelligence” appeared, from the 1956 summer workshop. John McCarthy was involved in the proposal and workshop organization.","hi":"स्रोत के अनुसार 1955 के डार्टमाउथ प्रस्ताव में “Artificial Intelligence” शब्द था, जबकि ग्रीष्मकालीन रिसर्च वर्कशॉप 1956 में हुई। जॉन मैक्कार्थी मुख्य आयोजकों में शामिल थे।"},"id":"q11","num":11},{"q":{"en":"Which programming language and award year are associated with John McCarthy?","hi":"जॉन मैक्कार्थी से कौन-सी प्रोग्रामिंग भाषा और किस वर्ष का पुरस्कार जुड़ा है?"},"o":[{"en":"Lisp and the 1971 ACM A. M. Turing Award","hi":"लिस्प और 1971 का ACM ए. एम. ट्यूरिंग पुरस्कार"},{"en":"Lisp and the 1956 ACM A. M. Turing Award","hi":"लिस्प और 1956 का ACM ए. एम. ट्यूरिंग पुरस्कार"},{"en":"Python and the 1971 ACM A. M. Turing Award","hi":"पायथन और 1971 का ACM ए. एम. ट्यूरिंग पुरस्कार"},{"en":"Java and the 1955 ACM A. M. Turing Award","hi":"जावा और 1955 का ACM ए. एम. ट्यूरिंग पुरस्कार"}],"a":{"en":"Lisp and the 1971 ACM A. M. Turing Award","hi":"लिस्प और 1971 का ACM ए. एम. ट्यूरिंग पुरस्कार"},"exp":{"en":"John McCarthy is associated with the Lisp language, which was influential in symbolic computing and AI. He received the ACM A. M. Turing Award in 1971.","hi":"जॉन मैक्कार्थी का संबंध Lisp भाषा और AI के symbolic computing से है। उन्हें 1971 में ACM A. M. Turing Award मिला था।"},"id":"q12","num":12}]},{"title":{"en":"2. AI Model Workflow — Data se Deployment Tak","hi":"2. AI मॉडल वर्कफ़्लो — डेटा से डिप्लॉयमेंट तक"},"questions":[{"q":{"en":"What are the eight steps of building an AI/ML model?","hi":"AI/ML मॉडल बनाने के आठ चरण क्या हैं?"},"a":{"en":"Data collection → preprocessing → splitting → model selection → training → evaluation → deployment → monitoring and maintenance","hi":"डेटा संग्रह (Data collection) → प्रीप्रोसेसिंग (preprocessing) → स्प्लिटिंग (splitting) → मॉडल चयन (model selection) → प्रशिक्षण (training) → मूल्यांकन (evaluation) → परिनियोजन (deployment) → निगरानी और रखरखाव (monitoring and maintenance)"},"o":[{"en":"Planning → Coding → Selling","hi":"योजना → कोडिंग → बिक्री"},{"en":"Data collection → preprocessing → splitting → model selection → training → evaluation → deployment → monitoring and maintenance","hi":"डेटा संग्रह (Data collection) → प्रीप्रोसेसिंग (preprocessing) → स्प्लिटिंग (splitting) → मॉडल चयन (model selection) → प्रशिक्षण (training) → मूल्यांकन (evaluation) → परिनियोजन (deployment) → निगरानी और रखरखाव (monitoring and maintenance)"},{"en":"Hardware setup → OS installation → typing → saving","hi":"हार्डवेयर सेटअप → OS इंस्टॉलेशन → टाइपिंग → सेविंग"},{"en":"Reading → Writing → Arithmetic","hi":"पढ़ना → लिखना → अंकगणित"}],"exp":{"en":"This represents the standard end-to-end lifecycle of a machine learning project, from raw data to a live, managed application.\nSource-note (Hinglish): Data collection → preprocessing → splitting → model selection → training → evaluation → deployment → monitoring and maintenance.","hi":"यह एक मशीन लर्निंग प्रोजेक्ट के मानक एंड-टू-एंड जीवनचक्र (lifecycle) का प्रतिनिधित्व करता है, कच्चे डेटा से लेकर लाइव, प्रबंधित एप्लिकेशन तक।"},"id":"q13","num":13},{"q":{"en":"What is an example of structured and unstructured data in data collection?","hi":"डेटा संग्रह (data collection) में संरचित (structured) और असंरचित (unstructured) डेटा का एक उदाहरण क्या है?"},"a":{"en":"Structured data, such as a sales table with rows/columns. Unstructured data, such as reviews, images, and audio. For sentiment analysis, one can collect product reviews","hi":"संरचित (Structured) डेटा, जैसे पंक्तियों/कॉलमों वाली सेल्स टेबल (sales table)। असंरचित (Unstructured) डेटा, जैसे समीक्षाएँ (reviews), चित्र और ऑडियो। सेंटीमेंट एनालिसिस (sentiment analysis) के लिए उत्पाद समीक्षाएँ एकत्र की जा सकती हैं"},"o":[{"en":"Both are just text","hi":"दोनों सिर्फ टेक्स्ट हैं"},{"en":"Structured data, such as a sales table with rows/columns. Unstructured data, such as reviews, images, and audio. For sentiment analysis, one can collect product reviews","hi":"संरचित (Structured) डेटा, जैसे पंक्तियों/कॉलमों वाली सेल्स टेबल (sales table)। असंरचित (Unstructured) डेटा, जैसे समीक्षाएँ (reviews), चित्र और ऑडियो। सेंटीमेंट एनालिसिस (sentiment analysis) के लिए उत्पाद समीक्षाएँ एकत्र की जा सकती हैं"},{"en":"Structured is online, unstructured is offline","hi":"स्ट्रक्चर्ड ऑनलाइन है, अनस्ट्रक्चर्ड ऑफलाइन है"},{"en":"There is no difference","hi":"कोई अंतर नहीं है"}],"exp":{"en":"Traditional machine learning often uses structured data, while modern deep learning and NLP models excel at handling unstructured data like text and images.\nSource-note (Hinglish): Structured data, jaise rows/columns wali sales table. Unstructured data, jaise reviews, images aur audio. Sentiment analysis ke liye product reviews collect kar sakte hain.","hi":"पारंपरिक मशीन लर्निंग अक्सर संरचित (structured) डेटा का उपयोग करती है, जबकि आधुनिक डीप लर्निंग और एनएलपी मॉडल टेक्स्ट और छवियों जैसे असंरचित (unstructured) डेटा को संभालने में उत्कृष्ट (excel) होते हैं।"},"id":"q14","num":14},{"q":{"en":"What happens in data preprocessing?","hi":"डेटा प्रीप्रोसेसिंग (data preprocessing) में क्या होता है?"},"a":{"en":"Errors and duplicates are handled, missing values are treated, and inputs are converted into a model-ready format","hi":"त्रुटियों (Errors) और डुप्लिकेट को संभाला जाता है, गायब मानों (missing values) का इलाज किया जाता है, और इनपुट को मॉडल-तैयार प्रारूप (model-ready format) में परिवर्तित किया जाता है"},"o":[{"en":"Data is deleted","hi":"डेटा हटा दिया जाता है"},{"en":"Errors and duplicates are handled, missing values are treated, and inputs are converted into a model-ready format","hi":"त्रुटियों (Errors) और डुप्लिकेट को संभाला जाता है, गायब मानों (missing values) का इलाज किया जाता है, और इनपुट को मॉडल-तैयार प्रारूप (model-ready format) में परिवर्तित किया जाता है"},{"en":"The model is trained","hi":"मॉडल को प्रशिक्षित किया जाता है"},{"en":"The data is sold","hi":"डेटा बेचा जाता है"}],"exp":{"en":"Preprocessing is crucial because 'garbage in, garbage out'—a model cannot learn effectively from noisy, incomplete, or incorrectly formatted data.\nSource-note (Hinglish): Errors aur duplicates handle karte hain, missing values treat karte hain aur inputs ko model-ready format mein convert karte hain.","hi":"प्रीप्रोसेसिंग महत्वपूर्ण है क्योंकि 'गारबेज इन, गारबेज आउट'—एक मॉडल शोर, अपूर्ण या गलत तरीके से स्वरूपित डेटा से प्रभावी ढंग से नहीं सीख सकता है।"},"id":"q15","num":15},{"q":{"en":"What is data annotation?","hi":"डेटा एनोटेशन (data annotation) क्या है?"},"a":{"en":"Assigning labels or tags to examples, such as labeling an email as 'spam' or 'not spam'","hi":"उदाहरणों के लिए लेबल या टैग निर्दिष्ट (assign) करना, जैसे कि किसी ईमेल को 'स्पैम' या 'स्पैम नहीं' के रूप में लेबल करना"},"o":[{"en":"Writing code for the AI","hi":"AI के लिए कोड लिखना"},{"en":"Assigning labels or tags to examples, such as labeling an email as 'spam' or 'not spam'","hi":"उदाहरणों के लिए लेबल या टैग निर्दिष्ट (assign) करना, जैसे कि किसी ईमेल को 'स्पैम' या 'स्पैम नहीं' के रूप में लेबल करना"},{"en":"Formatting the hard drive","hi":"हार्ड ड्राइव को फॉर्मेट करना"},{"en":"Deleting old files","hi":"पुरानी फाइलों को हटाना"}],"exp":{"en":"Annotation is a key step in supervised learning, providing the 'answers' (ground truth) that the model needs to learn from.\nSource-note (Hinglish): Examples ko labels ya tags assign karna, jaise email ko “spam” ya “not spam” label karna.","hi":"एनोटेशन पर्यवेक्षित सीखने (supervised learning) में एक महत्वपूर्ण कदम है, जो 'उत्तर' (ground truth) प्रदान करता है जिससे मॉडल को सीखने की आवश्यकता होती है।"},"id":"q16","num":16},{"q":{"en":"What are the roles of training, validation, and test sets?","hi":"प्रशिक्षण (training), सत्यापन (validation) और परीक्षण (test) सेट की भूमिकाएँ क्या हैं?"},"a":{"en":"The model learns from the training set, settings/model selection are tuned using the validation set, and the test set estimates the final performance","hi":"मॉडल प्रशिक्षण (training) सेट से सीखता है, सेटिंग्स/मॉडल चयन को सत्यापन (validation) सेट का उपयोग करके ट्यून (tune) किया जाता है, और परीक्षण (test) सेट अंतिम प्रदर्शन का अनुमान लगाता है"},"o":[{"en":"They all do the same thing","hi":"वे सभी एक ही काम करते हैं"},{"en":"The model learns from the training set, settings/model selection are tuned using the validation set, and the test set estimates the final performance","hi":"मॉडल प्रशिक्षण (training) सेट से सीखता है, सेटिंग्स/मॉडल चयन को सत्यापन (validation) सेट का उपयोग करके ट्यून (tune) किया जाता है, और परीक्षण (test) सेट अंतिम प्रदर्शन का अनुमान लगाता है"},{"en":"Training is for the user, test is for the computer","hi":"प्रशिक्षण उपयोगकर्ता के लिए है, परीक्षण कंप्यूटर के लिए है"},{"en":"They are only used in robotics","hi":"इनका उपयोग केवल रोबोटिक्स में किया जाता है"}],"exp":{"en":"This split is essential to prevent 'overfitting', ensuring the model generalizes well to new, unseen data rather than just memorizing the training data.\nSource-note (Hinglish): Training se model learn karta hai, validation se settings/model selection tune hote hain, aur test set final performance estimate karta hai.","hi":"यह विभाजन (split) 'ओवरफिटिंग' को रोकने के लिए आवश्यक है, यह सुनिश्चित करता है कि मॉडल केवल प्रशिक्षण डेटा को याद रखने के बजाय नए, अनदेखे डेटा के लिए सामान्यीकृत (generalizes) हो।"},"id":"q17","num":17},{"q":{"en":"How should the 70–80%, 10–15%, 10–15% data splits in the notes be used?","hi":"नोट्स में दिए गए 70-80%, 10-15%, 10-15% डेटा स्प्लिट (data splits) का उपयोग कैसे किया जाना चाहिए?"},"a":{"en":"They are approximate ranges. Valid examples are 80/10/10 and 70/15/15. The actual split depends on the data and evaluation design, and the total must be 100%","hi":"वे अनुमानित सीमाएँ (approximate ranges) हैं। वैध (valid) उदाहरण 80/10/10 और 70/15/15 हैं। वास्तविक विभाजन (actual split) डेटा और मूल्यांकन डिज़ाइन पर निर्भर करता है, और कुल (total) 100% होना चाहिए"},"o":[{"en":"They are absolute laws","hi":"वे पूर्ण कानून हैं"},{"en":"They are approximate ranges. Valid examples are 80/10/10 and 70/15/15. The actual split depends on the data and evaluation design, and the total must be 100%","hi":"वे अनुमानित सीमाएँ (approximate ranges) हैं। वैध (valid) उदाहरण 80/10/10 और 70/15/15 हैं। वास्तविक विभाजन (actual split) डेटा और मूल्यांकन डिज़ाइन पर निर्भर करता है, और कुल (total) 100% होना चाहिए"},{"en":"They must add up to 150%","hi":"उन्हें जोड़कर 150% होना चाहिए"},{"en":"Only 50/50 splits are allowed","hi":"केवल 50/50 स्प्लिट की अनुमति है"}],"exp":{"en":"The exact ratio isn't fixed; for extremely large datasets (like millions of images), the validation and test sets might be much smaller percentages (e.g., 98/1/1).\nSource-note (Hinglish): Approximate ranges hain. Valid examples 80/10/10 aur 70/15/15 hain. Actual split data aur evaluation design par depend karta hai aur total 100% hona chahiye.","hi":"सटीक अनुपात निश्चित नहीं है; अत्यंत बड़े डेटासेट के लिए, सत्यापन और परीक्षण सेट बहुत कम प्रतिशत (जैसे, 98/1/1) हो सकते हैं।"},"id":"q18","num":18},{"q":{"en":"What is the difference between model selection and model training?","hi":"मॉडल चयन (model selection) और मॉडल प्रशिक्षण (model training) में क्या अंतर है?"},"a":{"en":"Selection chooses a suitable algorithm/architecture for the task. Training is when the algorithm learns parameters from the data's patterns","hi":"चयन (Selection) कार्य के लिए एक उपयुक्त एल्गोरिथ्म/आर्किटेक्चर चुनता है। प्रशिक्षण (Training) तब होता है जब एल्गोरिथ्म डेटा के पैटर्न से पैरामीटर सीखता है"},"o":[{"en":"There is no difference","hi":"कोई अंतर नहीं है"},{"en":"Selection chooses a suitable algorithm/architecture for the task. Training is when the algorithm learns parameters from the data's patterns","hi":"चयन (Selection) कार्य के लिए एक उपयुक्त एल्गोरिथ्म/आर्किटेक्चर चुनता है। प्रशिक्षण (Training) तब होता है जब एल्गोरिथ्म डेटा के पैटर्न से पैरामीटर सीखता है"},{"en":"Selection is done by AI, training is done by humans","hi":"चयन AI द्वारा किया जाता है, प्रशिक्षण मनुष्यों द्वारा किया जाता है"},{"en":"Selection requires data, training does not","hi":"चयन के लिए डेटा की आवश्यकता होती है, प्रशिक्षण के लिए नहीं"}],"exp":{"en":"Model selection is like choosing the type of vehicle (car, truck, bike) for a journey. Training is like teaching the driver how to navigate the specific route.\nSource-note (Hinglish): Selection mein task ke liye suitable algorithm/architecture choose karte hain. Training mein algorithm data ke patterns se parameters learn karta hai.","hi":"मॉडल चयन एक यात्रा के लिए वाहन के प्रकार (कार, ट्रक, बाइक) को चुनने जैसा है। प्रशिक्षण चालक को विशिष्ट मार्ग को नेविगेट (navigate) करना सिखाने जैसा है।"},"id":"q19","num":19},{"q":{"en":"Why is unseen data important for evaluation?","hi":"मूल्यांकन (evaluation) के लिए अनदेखा डेटा (unseen data) क्यों महत्वपूर्ण है?"},"a":{"en":"Unseen data shows how well the model generalizes to new examples. Using test data for tuning can result in a misleading score","hi":"अनदेखे डेटा से पता चलता है कि मॉडल नए उदाहरणों (new examples) के लिए कितनी अच्छी तरह सामान्यीकृत (generalize) होता है। ट्यूनिंग (tuning) के लिए परीक्षण डेटा (test data) का उपयोग करने से भ्रामक (misleading) स्कोर मिल सकता है"},"o":[{"en":"To save storage space","hi":"भंडारण स्थान बचाने के लिए"},{"en":"Unseen data shows how well the model generalizes to new examples. Using test data for tuning can result in a misleading score","hi":"अनदेखे डेटा से पता चलता है कि मॉडल नए उदाहरणों (new examples) के लिए कितनी अच्छी तरह सामान्यीकृत (generalize) होता है। ट्यूनिंग (tuning) के लिए परीक्षण डेटा (test data) का उपयोग करने से भ्रामक (misleading) स्कोर मिल सकता है"},{"en":"Because AI likes surprises","hi":"क्योंकि AI को सरप्राइज पसंद है"},{"en":"It is not important","hi":"यह महत्वपूर्ण नहीं है"}],"exp":{"en":"Testing a model on the data it was trained on is like giving a student an exam where they already saw all the answers—it doesn't prove they actually learned the concepts.\nSource-note (Hinglish): Unseen data se pata chalta hai ki model new examples par kitna generalize karta hai. Test data ko tuning mein use karne se score misleading ho sakta hai.","hi":"एक मॉडल का उस डेटा पर परीक्षण करना जिस पर उसे प्रशिक्षित किया गया था, एक छात्र को ऐसी परीक्षा देने जैसा है जहां उन्होंने पहले ही सभी उत्तर देख लिए हों—यह साबित नहीं करता कि उन्होंने वास्तव में अवधारणाएं (concepts) सीखी हैं।"},"id":"q20","num":20},{"q":{"en":"What is model deployment?","hi":"मॉडल परिनियोजन (model deployment) क्या है?"},"a":{"en":"Making the trained model available for use in a real-world application or service, such as serving predictions","hi":"प्रशिक्षित (trained) मॉडल को वास्तविक दुनिया के अनुप्रयोग (application) या सेवा में उपयोग के लिए उपलब्ध कराना, जैसे कि भविष्यवाणियां (predictions) परोसना"},"o":[{"en":"Deleting the model","hi":"मॉडल को हटाना"},{"en":"Making the trained model available for use in a real-world application or service, such as serving predictions","hi":"प्रशिक्षित (trained) मॉडल को वास्तविक दुनिया के अनुप्रयोग (application) या सेवा में उपयोग के लिए उपलब्ध कराना, जैसे कि भविष्यवाणियां (predictions) परोसना"},{"en":"Printing the model's code","hi":"मॉडल का कोड प्रिंट करना"},{"en":"Selling the training data","hi":"प्रशिक्षण डेटा बेचना"}],"exp":{"en":"Deployment bridges the gap between a data scientist's research environment and a live software product that users interact with.\nSource-note (Hinglish): Trained model ko real-world application ya service mein use ke liye available karana, jaise predictions serve karna.","hi":"डिप्लॉयमेंट (Deployment) डेटा वैज्ञानिक के अनुसंधान वातावरण और एक लाइव सॉफ्टवेयर उत्पाद, जिसके साथ उपयोगकर्ता इंटरैक्ट करते हैं, के बीच की खाई (gap) को पाटता है।"},"id":"q21","num":21},{"q":{"en":"Why is monitoring and maintenance required after deployment?","hi":"परिनियोजन (deployment) के बाद निगरानी और रखरखाव (monitoring and maintenance) की आवश्यकता क्यों होती है?"},"a":{"en":"To track real-world inputs, errors, and model performance. If the data distribution changes, drift can be detected and investigated, and the model updated or retrained","hi":"वास्तविक दुनिया के इनपुट, त्रुटियों (errors) और मॉडल के प्रदर्शन को ट्रैक (track) करने के लिए। यदि डेटा वितरण (data distribution) बदलता है, तो ड्रिफ्ट (drift) का पता लगाकर उसकी जांच की जा सकती है, और मॉडल को अपडेट या फिर से प्रशिक्षित (retrained) किया जा सकता है"},"o":[{"en":"To increase electricity use","hi":"बिजली का उपयोग बढ़ाने के लिए"},{"en":"To track real-world inputs, errors, and model performance. If the data distribution changes, drift can be detected and investigated, and the model updated or retrained","hi":"वास्तविक दुनिया के इनपुट, त्रुटियों (errors) और मॉडल के प्रदर्शन को ट्रैक (track) करने के लिए। यदि डेटा वितरण (data distribution) बदलता है, तो ड्रिफ्ट (drift) का पता लगाकर उसकी जांच की जा सकती है, और मॉडल को अपडेट या फिर से प्रशिक्षित (retrained) किया जा सकता है"},{"en":"It is only required for hardware","hi":"यह केवल हार्डवेयर के लिए आवश्यक है"},{"en":"To make the model slower","hi":"मॉडल को धीमा बनाने के लिए"}],"exp":{"en":"Over time, 'data drift' (changes in the real world) can degrade a model's accuracy, making continuous monitoring essential for long-term reliability.\nSource-note (Hinglish): Real-world inputs, errors aur model performance track karte hain. Data distribution badalne par drift detect karke investigation, updates ya retraining ki ja sakti hai.","hi":"समय के साथ, 'डेटा ड्रिफ्ट' (वास्तविक दुनिया में परिवर्तन) एक मॉडल की सटीकता को कम कर सकता है, जिससे दीर्घकालिक विश्वसनीयता (long-term reliability) के लिए निरंतर निगरानी आवश्यक हो जाती है।"},"id":"q22","num":22}]},{"title":{"en":"3. Machine Learning, NLP & Computer Vision","hi":"3. मशीन लर्निंग, NLP और कंप्यूटर विज़न"},"questions":[{"q":{"en":"What is Machine Learning (ML)?","hi":"मशीन लर्निंग (ML) क्या है?"},"a":{"en":"An area of AI where systems learn patterns from data to improve predictions or decisions on unseen examples. There is less need to write manually fixed rules for every decision","hi":"AI का एक क्षेत्र जहां सिस्टम अनदेखे उदाहरणों (unseen examples) पर भविष्यवाणियों या निर्णयों को बेहतर बनाने के लिए डेटा से पैटर्न (patterns) सीखते हैं। हर निर्णय के लिए मैन्युअल रूप से निश्चित नियम (manually fixed rules) लिखने की आवश्यकता कम होती है"},"o":[{"en":"A physical robot learning to walk","hi":"एक भौतिक रोबोट चलना सीख रहा है"},{"en":"An area of AI where systems learn patterns from data to improve predictions or decisions on unseen examples. There is less need to write manually fixed rules for every decision","hi":"AI का एक क्षेत्र जहां सिस्टम अनदेखे उदाहरणों (unseen examples) पर भविष्यवाणियों या निर्णयों को बेहतर बनाने के लिए डेटा से पैटर्न (patterns) सीखते हैं। हर निर्णय के लिए मैन्युअल रूप से निश्चित नियम (manually fixed rules) लिखने की आवश्यकता कम होती है"},{"en":"Typing data into Excel","hi":"एक्सेल में डेटा टाइप करना"},{"en":"A type of internet connection","hi":"एक प्रकार का इंटरनेट कनेक्शन"}],"exp":{"en":"Instead of being explicitly programmed to perform a task, ML systems are programmed to learn how to perform the task based on data.\nSource-note (Hinglish): AI ka area jahan systems data se patterns learn karke unseen examples par predictions ya decisions improve karte hain. Har decision ke liye manually fixed rules likhne ki zaroorat kam hoti hai.","hi":"किसी कार्य को करने के लिए स्पष्ट रूप से प्रोग्राम किए जाने के बजाय, ML सिस्टम को डेटा के आधार पर कार्य करने का तरीका सीखने के लिए प्रोग्राम किया जाता है।"},"id":"q23","num":23},{"q":{"en":"What are the three common learning paradigms of ML?","hi":"मशीन लर्निंग (ML) के तीन सामान्य शिक्षण प्रतिमान (learning paradigms) कौन से हैं?"},"a":{"en":"Supervised learning learns from labeled examples, unsupervised learning finds structure in unlabeled data, and reinforcement learning learns from reward feedback","hi":"पर्यवेक्षित शिक्षण (Supervised learning) लेबल किए गए उदाहरणों से सीखता है, अपर्यवेक्षित शिक्षण (unsupervised learning) बिना लेबल वाले डेटा में संरचना (structure) खोजता है, और सुदृढीकरण सीखना (reinforcement learning) इनाम फीडबैक (reward feedback) से सीखता है"},"o":[{"en":"Reading, Writing, Listening","hi":"पढ़ना, लिखना, सुनना"},{"en":"Supervised learning learns from labeled examples, unsupervised learning finds structure in unlabeled data, and reinforcement learning learns from reward feedback","hi":"पर्यवेक्षित शिक्षण (Supervised learning) लेबल किए गए उदाहरणों से सीखता है, अपर्यवेक्षित शिक्षण (unsupervised learning) बिना लेबल वाले डेटा में संरचना (structure) खोजता है, और सुदृढीकरण सीखना (reinforcement learning) इनाम फीडबैक (reward feedback) से सीखता है"},{"en":"Hardware, Software, Firmware","hi":"हार्डवेयर, सॉफ्टवेयर, फर्मवेयर"},{"en":"Input, Processing, Output","hi":"इनपुट, प्रोसेसिंग, आउटपुट"}],"exp":{"en":"These paradigms define the 'learning signal' the algorithm uses: explicit answers (supervised), implicit structure (unsupervised), or trial-and-error scores (reinforcement).\nSource-note (Hinglish): Supervised learning labeled examples se, unsupervised learning unlabeled data se structure dhoondhkar, aur reinforcement learning reward feedback se learn karti hai.","hi":"ये प्रतिमान (paradigms) 'शिक्षण संकेत' (learning signal) को परिभाषित करते हैं जिसका उपयोग एल्गोरिदम करता है: स्पष्ट उत्तर (पर्यवेक्षित), अंतर्निहित संरचना (अपर्यवेक्षित), या परीक्षण-और-त्रुटि स्कोर (सुदृढीकरण)।"},"id":"q24","num":24},{"q":{"en":"What is a common example of supervised learning?","hi":"पर्यवेक्षित शिक्षण (supervised learning) का एक सामान्य उदाहरण क्या है?"},"a":{"en":"Training a spam classifier from labeled emails, or predicting future value from past prices","hi":"लेबल किए गए ईमेल (labeled emails) से स्पैम क्लासिफायर (spam classifier) को प्रशिक्षित करना, या पिछली कीमतों (past prices) से भविष्य के मूल्य (future value) की भविष्यवाणी करना"},"o":[{"en":"A robot learning to walk by falling","hi":"एक रोबोट गिरकर चलना सीख रहा है"},{"en":"Training a spam classifier from labeled emails, or predicting future value from past prices","hi":"लेबल किए गए ईमेल (labeled emails) से स्पैम क्लासिफायर (spam classifier) को प्रशिक्षित करना, या पिछली कीमतों (past prices) से भविष्य के मूल्य (future value) की भविष्यवाणी करना"},{"en":"Grouping customers without knowing anything about them","hi":"ग्राहकों के बारे में कुछ जाने बिना उनका समूहीकरण (Grouping) करना"},{"en":"Generating a random image","hi":"एक यादृच्छिक छवि (random image) उत्पन्न करना"}],"exp":{"en":"Supervised learning requires ground-truth labels. The model is given examples like 'Email A is Spam', 'Email B is Not Spam' to learn the relationship.\nSource-note (Hinglish): Labeled emails se spam classifier train karna, ya past prices se future value predict karna.","hi":"पर्यवेक्षित शिक्षण (Supervised learning) के लिए ग्राउंड-ट्रुथ लेबल की आवश्यकता होती है। मॉडल को संबंध सीखने के लिए 'ईमेल ए स्पैम है', 'ईमेल बी स्पैम नहीं है' जैसे उदाहरण दिए जाते हैं।"},"id":"q25","num":25},{"q":{"en":"What is a common example of unsupervised learning?","hi":"अपर्यवेक्षित शिक्षण (unsupervised learning) का एक सामान्य उदाहरण क्या है?"},"a":{"en":"Clustering customer records into similar groups without labels","hi":"ग्राहक रिकॉर्ड (customer records) को बिना लेबल (labels) के समान समूहों (similar groups) में समूहित (Clustering) करना"},"o":[{"en":"Predicting the exact price of a house","hi":"किसी घर की सटीक कीमत का अनुमान लगाना"},{"en":"Clustering customer records into similar groups without labels","hi":"ग्राहक रिकॉर्ड (customer records) को बिना लेबल (labels) के समान समूहों (similar groups) में समूहित (Clustering) करना"},{"en":"Learning to play chess","hi":"शतरंज खेलना सीखना"},{"en":"Translating English to Hindi","hi":"अंग्रेजी का हिंदी में अनुवाद करना"}],"exp":{"en":"In unsupervised learning, the algorithm tries to find patterns and segments in the data without being told what to look for (no labels).\nSource-note (Hinglish): Customer records ko labels ke bina similar groups mein cluster karna.","hi":"अपर्यवेक्षित सीखने (unsupervised learning) में, एल्गोरिथ्म बिना बताए डेटा में पैटर्न और सेगमेंट खोजने की कोशिश करता है कि क्या खोजना है (कोई लेबल नहीं)।"},"id":"q26","num":26},{"q":{"en":"What is the objective of the agent in reinforcement learning?","hi":"सुदृढीकरण सीखने (reinforcement learning) में एजेंट का उद्देश्य क्या है?"},"a":{"en":"It observes rewards by taking actions in an environment and learns a policy to improve long-term cumulative reward","hi":"यह एक वातावरण (environment) में कार्रवाई (actions) करके पुरस्कार (rewards) का निरीक्षण (observes) करता है और दीर्घकालिक संचयी इनाम (long-term cumulative reward) को बेहतर बनाने के लिए एक नीति (policy) सीखता है"},"o":[{"en":"To group similar data points","hi":"समान डेटा बिंदुओं को समूहित करने के लिए"},{"en":"It observes rewards by taking actions in an environment and learns a policy to improve long-term cumulative reward","hi":"यह एक वातावरण (environment) में कार्रवाई (actions) करके पुरस्कार (rewards) का निरीक्षण (observes) करता है और दीर्घकालिक संचयी इनाम (long-term cumulative reward) को बेहतर बनाने के लिए एक नीति (policy) सीखता है"},{"en":"To translate languages","hi":"भाषाओं का अनुवाद करने के लिए"},{"en":"To identify faces in photos","hi":"तस्वीरों में चेहरों की पहचान करने के लिए"}],"exp":{"en":"Reinforcement learning is often used for training AI to play games (like Chess or Go) or control robots.\nSource-note (Hinglish): Environment mein actions le kar rewards observe karta hai aur long-term cumulative reward improve karne ki policy seekhta hai.","hi":"सुदृढीकरण सीखने (Reinforcement learning) का उपयोग अक्सर एआई (AI) को गेम खेलने (जैसे शतरंज या गो) या रोबोट को नियंत्रित करने के लिए प्रशिक्षित करने के लिए किया जाता है।"},"id":"q27","num":27},{"q":{"en":"What are common real-world applications of ML?","hi":"मशीन लर्निंग (ML) के सामान्य वास्तविक दुनिया के अनुप्रयोग (applications) क्या हैं?"},"a":{"en":"Spam filtering, fraud detection, product recommendations, and prediction tasks","hi":"स्पैम फ़िल्टरिंग, धोखाधड़ी का पता लगाना (fraud detection), उत्पाद अनुशंसाएँ (product recommendations) और भविष्यवाणी कार्य (prediction tasks)"},"o":[{"en":"Cooking food","hi":"खाना पकाना"},{"en":"Spam filtering, fraud detection, product recommendations, and prediction tasks","hi":"स्पैम फ़िल्टरिंग, धोखाधड़ी का पता लगाना (fraud detection), उत्पाद अनुशंसाएँ (product recommendations) और भविष्यवाणी कार्य (prediction tasks)"},{"en":"Building houses","hi":"घर बनाना"},{"en":"Performing surgery alone","hi":"अकेले सर्जरी करना"}],"exp":{"en":"These ML applications operate quietly behind the scenes of many digital services we use daily.\nSource-note (Hinglish): Spam filtering, fraud detection, product recommendations aur prediction tasks.","hi":"ये ML एप्लिकेशन हमारे द्वारा प्रतिदिन उपयोग की जाने वाली कई डिजिटल सेवाओं के पीछे चुपचाप काम करते हैं।"},"id":"q28","num":28},{"q":{"en":"What is the full form and core meaning of NLP?","hi":"NLP का पूर्ण रूप और मुख्य अर्थ क्या है?"},"a":{"en":"Natural Language Processing. It helps computer systems to interpret, process, and generate human language","hi":"प्राकृतिक भाषा प्रसंस्करण (Natural Language Processing)। यह कंप्यूटर सिस्टम को मानव भाषा की व्याख्या (interpret), प्रक्रिया और उत्पन्न (generate) करने में मदद करता है"},"o":[{"en":"National Language Program","hi":"नेशनल लैंग्वेज प्रोग्राम"},{"en":"Natural Language Processing. It helps computer systems to interpret, process, and generate human language","hi":"प्राकृतिक भाषा प्रसंस्करण (Natural Language Processing)। यह कंप्यूटर सिस्टम को मानव भाषा की व्याख्या (interpret), प्रक्रिया और उत्पन्न (generate) करने में मदद करता है"},{"en":"New Logic Protocol","hi":"न्यू लॉजिक प्रोटोकॉल"},{"en":"Neural Language Program","hi":"न्यूरल लैंग्वेज प्रोग्राम"}],"exp":{"en":"NLP bridges the gap between human communication (speech, text) and computer understanding.\nSource-note (Hinglish): Natural Language Processing (प्राकृतिक भाषा प्रसंस्करण). Computer systems ko human language interpret, process aur generate karne mein help karta hai.","hi":"NLP मानव संचार (भाषण, पाठ) और कंप्यूटर की समझ के बीच की खाई को पाटता है।"},"id":"q29","num":29},{"q":{"en":"What are the main functions and examples of NLP?","hi":"NLP के मुख्य कार्य और उदाहरण क्या हैं?"},"a":{"en":"Spoken/written language understanding, translation, sentiment analysis, and text generation. Google Translate, voice assistants, and chatbots are examples","hi":"बोली जाने वाली/लिखित भाषा की समझ, अनुवाद, भावना विश्लेषण (sentiment analysis) और पाठ निर्माण (text generation)। Google अनुवाद (Translate), वॉयस असिस्टेंट और चैटबॉट इसके उदाहरण हैं"},"o":[{"en":"Controlling robots","hi":"रोबोट को नियंत्रित करना"},{"en":"Spoken/written language understanding, translation, sentiment analysis, and text generation. Google Translate, voice assistants, and chatbots are examples","hi":"बोली जाने वाली/लिखित भाषा की समझ, अनुवाद, भावना विश्लेषण (sentiment analysis) और पाठ निर्माण (text generation)। Google अनुवाद (Translate), वॉयस असिस्टेंट और चैटबॉट इसके उदाहरण हैं"},{"en":"Image editing","hi":"छवि संपादन"},{"en":"Mathematical calculations","hi":"गणितीय गणनाएँ"}],"exp":{"en":"Whenever a computer reads text, listens to your voice, or speaks/writes back to you, it is using NLP.\nSource-note (Hinglish): Spoken/written language understanding, translation, sentiment analysis aur text generation. Google Translate, voice assistants aur chatbots examples hain.","hi":"जब भी कोई कंप्यूटर टेक्स्ट पढ़ता है, आपकी आवाज़ सुनता है, या आपसे वापस बोलता/लिखता है, तो वह NLP का उपयोग कर रहा होता है।"},"id":"q30","num":30},{"q":{"en":"What does sentiment analysis identify?","hi":"सेंटीमेंट एनालिसिस (sentiment analysis - भावना विश्लेषण) क्या पहचानती है?"},"a":{"en":"The opinion or tone expressed in a review or message, such as positive, negative, or neutral","hi":"समीक्षा (review) या संदेश में व्यक्त की गई राय या लहजा (tone), जैसे कि सकारात्मक, नकारात्मक या तटस्थ (neutral)"},"o":[{"en":"Grammar mistakes","hi":"व्याकरण की गलतियाँ"},{"en":"The opinion or tone expressed in a review or message, such as positive, negative, or neutral","hi":"समीक्षा (review) या संदेश में व्यक्त की गई राय या लहजा (tone), जैसे कि सकारात्मक, नकारात्मक या तटस्थ (neutral)"},{"en":"The author's name","hi":"लेखक का नाम"},{"en":"The language used","hi":"उपयोग की गई भाषा"}],"exp":{"en":"Businesses use sentiment analysis to automatically monitor customer feedback on social media and reviews.\nSource-note (Hinglish): Review ya message mein expressed opinion ya tone, jaise positive, negative ya neutral.","hi":"व्यवसाय सोशल मीडिया और समीक्षाओं पर ग्राहक प्रतिक्रिया की स्वचालित रूप से निगरानी करने के लिए भावना विश्लेषण (sentiment analysis) का उपयोग करते हैं।"},"id":"q31","num":31},{"q":{"en":"What is Computer Vision?","hi":"कंप्यूटर विज़न (Computer Vision) क्या है?"},"a":{"en":"An AI field that interprets visual information from images and videos","hi":"एक AI क्षेत्र जो छवियों (images) और वीडियो से दृश्य जानकारी (visual information) की व्याख्या करता है"},"o":[{"en":"A type of computer monitor","hi":"एक प्रकार का कंप्यूटर मॉनिटर"},{"en":"An AI field that interprets visual information from images and videos","hi":"एक AI क्षेत्र जो छवियों (images) और वीडियो से दृश्य जानकारी (visual information) की व्याख्या करता है"},{"en":"Software to improve eyesight","hi":"आंखों की रोशनी में सुधार के लिए सॉफ्टवेयर"},{"en":"A VR headset","hi":"एक VR हेडसेट"}],"exp":{"en":"Computer Vision enables machines to 'see' and extract meaningful information from digital images, videos, and other visual inputs.\nSource-note (Hinglish): AI field jo images aur videos se visual information interpret karti hai.","hi":"कंप्यूटर विज़न मशीनों को 'देखने' और डिजिटल छवियों, वीडियो और अन्य दृश्य इनपुट से सार्थक जानकारी निकालने में सक्षम बनाता है।"},"id":"q32","num":32},{"q":{"en":"What is the difference between image classification, object detection, and face recognition?","hi":"इमेज क्लासिफिकेशन (image classification), ऑब्जेक्ट डिटेक्शन (object detection) और फेस रिकग्निशन (face recognition) में क्या अंतर है?"},"a":{"en":"Classification gives a label to an image. Detection identifies and locates objects. Face recognition can match identity from facial features","hi":"वर्गीकरण (Classification) किसी छवि को एक लेबल (label) देता है। डिटेक्शन (Detection) वस्तुओं (objects) को पहचानता है और उनका पता लगाता है। फेस रिकग्निशन चेहरे की विशेषताओं (facial features) से पहचान का मिलान कर सकता है"},"o":[{"en":"They are the same thing","hi":"वे एक ही बात हैं"},{"en":"Classification gives a label to an image. Detection identifies and locates objects. Face recognition can match identity from facial features","hi":"वर्गीकरण (Classification) किसी छवि को एक लेबल (label) देता है। डिटेक्शन (Detection) वस्तुओं (objects) को पहचानता है और उनका पता लगाता है। फेस रिकग्निशन चेहरे की विशेषताओं (facial features) से पहचान का मिलान कर सकता है"},{"en":"Classification is for videos, detection is for photos","hi":"वर्गीकरण वीडियो के लिए है, डिटेक्शन तस्वीरों के लिए है"},{"en":"Detection is only for faces","hi":"डिटेक्शन केवल चेहरों के लिए है"}],"exp":{"en":"Classification says 'There is a cat in this image'. Detection says 'Here are bounding boxes around the two cats'. Recognition says 'This face belongs to John'.\nSource-note (Hinglish): Classification image ko label deti hai. Detection objects ko identify aur locate karti hai. Face recognition facial features se identity match kar sakti hai.","hi":"वर्गीकरण कहता है 'इस छवि में एक बिल्ली है'। डिटेक्शन कहता है 'यहाँ दो बिल्लियों के चारों ओर बाउंडिंग बॉक्स हैं'। रिकग्निशन कहता है 'यह चेहरा जॉन का है'।"},"id":"q33","num":33},{"q":{"en":"What are the practical applications of Computer Vision?","hi":"कंप्यूटर विज़न के व्यावहारिक अनुप्रयोग (practical applications) क्या हैं?"},"a":{"en":"Medical imaging, road-object detection, facial recognition, and factory visual inspection","hi":"मेडिकल इमेजिंग, सड़क-वस्तु का पता लगाना (road-object detection), चेहरे की पहचान (facial recognition), और कारखाने का दृश्य निरीक्षण (factory visual inspection)"},"o":[{"en":"Translating languages","hi":"भाषाओं का अनुवाद करना"},{"en":"Medical imaging, road-object detection, facial recognition, and factory visual inspection","hi":"मेडिकल इमेजिंग, सड़क-वस्तु का पता लगाना (road-object detection), चेहरे की पहचान (facial recognition), और कारखाने का दृश्य निरीक्षण (factory visual inspection)"},{"en":"Spell checking","hi":"स्पेल चेकिंग"},{"en":"Playing music","hi":"संगीत बजाना"}],"exp":{"en":"Computer vision powers self-driving cars, automated quality control in manufacturing, and advanced medical diagnostics.\nSource-note (Hinglish): Medical imaging, road-object detection, facial recognition aur factory visual inspection.","hi":"कंप्यूटर विज़न सेल्फ-ड्राइविंग कारों, निर्माण में स्वचालित गुणवत्ता नियंत्रण और उन्नत चिकित्सा निदान (medical diagnostics) को शक्ति प्रदान करता है।"},"id":"q34","num":34},{"q":{"en":"Can NLP and Computer Vision be combined in one system?","hi":"क्या NLP और कंप्यूटर विजन (Computer Vision) को एक सिस्टम में जोड़ा जा सकता है?"},"a":{"en":"Yes. A multimodal system can interpret an image and answer questions about it in natural language","hi":"हाँ। एक मल्टीमॉडल सिस्टम (Multimodal system) किसी छवि (image) की व्याख्या कर सकता है और प्राकृतिक भाषा (natural language) में उसके बारे में सवालों के जवाब दे सकता है"},"o":[{"en":"No, they are incompatible","hi":"नहीं, वे असंगत (incompatible) हैं"},{"en":"Yes. A multimodal system can interpret an image and answer questions about it in natural language","hi":"हाँ। एक मल्टीमॉडल सिस्टम (Multimodal system) किसी छवि (image) की व्याख्या कर सकता है और प्राकृतिक भाषा (natural language) में उसके बारे में सवालों के जवाब दे सकता है"},{"en":"Only on mobile phones","hi":"केवल मोबाइल फोन पर"},{"en":"Only for translating images to text","hi":"केवल छवियों (images) का टेक्स्ट में अनुवाद करने के लिए"}],"exp":{"en":"Modern AI models like GPT-4o or Gemini are 'multimodal', meaning they can process and understand text, audio, and visual information simultaneously.\nSource-note (Hinglish): Haan. Multimodal system image ko interpret karke uske baare mein natural language mein answer de sakta hai.","hi":"GPT-4o या जेमिनी जैसे आधुनिक AI मॉडल 'मल्टीमॉडल' (multimodal) हैं, जिसका अर्थ है कि वे एक साथ टेक्स्ट, ऑडियो और दृश्य जानकारी को प्रोसेस और समझ सकते हैं।"},"id":"q35","num":35}]},{"title":{"en":"4. Conversational AI, Search & Productivity Tools","hi":"4. संवादात्मक AI, सर्च और प्रोडक्टिविटी टूल्स"},"questions":[{"q":{"en":"Who launched ChatGPT and when?","hi":"ChatGPT को किसने और कब लॉन्च किया?"},"a":{"en":"OpenAI launched the public research preview on 30 November 2022. Original ChatGPT was fine-tuned from the GPT-3.5 series. GPT-4 and GPT-4o are subsequent models","hi":"OpenAI ने 30 नवंबर 2022 को पब्लिक रिसर्च प्रीव्यू लॉन्च किया। मूल (Original) ChatGPT को GPT-3.5 सीरीज़ से फाइन-ट्यून किया गया था। GPT-4 और GPT-4o बाद के मॉडल हैं"},"o":[{"en":"Google in 2021","hi":"Google ने 2021 में"},{"en":"OpenAI launched the public research preview on 30 November 2022. Original ChatGPT was fine-tuned from the GPT-3.5 series. GPT-4 and GPT-4o are subsequent models","hi":"OpenAI ने 30 नवंबर 2022 को पब्लिक रिसर्च प्रीव्यू लॉन्च किया। मूल (Original) ChatGPT को GPT-3.5 सीरीज़ से फाइन-ट्यून किया गया था। GPT-4 और GPT-4o बाद के मॉडल हैं"},{"en":"Microsoft in 2020","hi":"Microsoft ने 2020 में"},{"en":"Meta in 2023","hi":"Meta ने 2023 में"}],"exp":{"en":"The launch of ChatGPT in late 2022 marked a major turning point, bringing generative AI into widespread public use.\nSource-note (Hinglish): OpenAI ne 30 November 2022 ko public research preview launch kiya. Original ChatGPT GPT-3.5 series se fine-tuned tha. GPT-4 aur GPT-4o baad ke models hain.","hi":"2022 के अंत में ChatGPT के लॉन्च ने एक प्रमुख मोड़ (turning point) को चिह्नित किया, जिससे जेनरेटिव AI व्यापक सार्वजनिक उपयोग में आ गया।"},"id":"q36","num":36},{"q":{"en":"What are the exam-relevant uses of ChatGPT?","hi":"ChatGPT के परीक्षा-प्रासंगिक उपयोग (exam-relevant uses) क्या हैं?"},"a":{"en":"Conversational assistance, drafting/editing, reasoning, coding, research support, and image generation. DALL·E 3 was a historical ChatGPT image integration","hi":"संवादी सहायता (Conversational assistance), आलेखन/संपादन (drafting/editing), तर्क (reasoning), कोडिंग (coding), अनुसंधान समर्थन (research support) और छवि निर्माण (image generation)। DALL·E 3 एक ऐतिहासिक ChatGPT छवि एकीकरण (image integration) था"},"o":[{"en":"Physical robot control","hi":"भौतिक रोबोट नियंत्रण"},{"en":"Conversational assistance, drafting/editing, reasoning, coding, research support, and image generation. DALL·E 3 was a historical ChatGPT image integration","hi":"संवादी सहायता (Conversational assistance), आलेखन/संपादन (drafting/editing), तर्क (reasoning), कोडिंग (coding), अनुसंधान समर्थन (research support) और छवि निर्माण (image generation)। DALL·E 3 एक ऐतिहासिक ChatGPT छवि एकीकरण (image integration) था"},{"en":"Manufacturing cars","hi":"कारों का निर्माण"},{"en":"Operating bank vaults","hi":"बैंक वॉल्ट (bank vaults) का संचालन"}],"exp":{"en":"ChatGPT is a versatile general-purpose AI assistant capable of handling a wide variety of text, reasoning, and coding tasks.\nSource-note (Hinglish): Conversational assistance, drafting/editing, reasoning, coding, research support aur image generation. DALL·E 3 ek historical ChatGPT image integration tha.","hi":"ChatGPT एक बहुमुखी (versatile) सामान्य-उद्देश्य वाला AI सहायक है जो विभिन्न प्रकार के टेक्स्ट, तर्क और कोडिंग कार्यों को संभालने में सक्षम है।"},"id":"q37","num":37},{"q":{"en":"What is ChatGPT Atlas and what was its launch platform?","hi":"ChatGPT एटलस (Atlas) क्या है और इसका लॉन्च प्लेटफॉर्म क्या था?"},"a":{"en":"An OpenAI web browser with built-in ChatGPT, launched on macOS on 21 October 2025. Launch features included sidebar assistance, optional browser memories, and agent mode for eligible users","hi":"21 अक्टूबर 2025 को macOS पर लॉन्च किया गया इन-बिल्ट (built-in) ChatGPT वाला एक OpenAI वेब ब्राउज़र। लॉन्च सुविधाओं (Launch features) में साइडबार सहायता, वैकल्पिक ब्राउज़र मेमोरी (optional browser memories) और योग्य उपयोगकर्ताओं के लिए एजेंट मोड (agent mode) शामिल थे"},"o":[{"en":"A map software on Android","hi":"Android पर एक मैप सॉफ्टवेयर"},{"en":"An OpenAI web browser with built-in ChatGPT, launched on macOS on 21 October 2025. Launch features included sidebar assistance, optional browser memories, and agent mode for eligible users","hi":"21 अक्टूबर 2025 को macOS पर लॉन्च किया गया इन-बिल्ट (built-in) ChatGPT वाला एक OpenAI वेब ब्राउज़र। लॉन्च सुविधाओं (Launch features) में साइडबार सहायता, वैकल्पिक ब्राउज़र मेमोरी (optional browser memories) और योग्य उपयोगकर्ताओं के लिए एजेंट मोड (agent mode) शामिल थे"},{"en":"A VR game on Windows","hi":"Windows पर एक VR गेम"},{"en":"A search engine","hi":"एक सर्च इंजन"}],"exp":{"en":"Atlas represents OpenAI's move into building a dedicated browser designed natively around AI assistance.\nSource-note (Hinglish): Built-in ChatGPT wala OpenAI web browser, 21 October 2025 ko macOS par launch hua. Launch features mein sidebar assistance, optional browser memories aur eligible users ke liye agent mode tha.","hi":"एटलस (Atlas) मूल रूप से AI सहायता के इर्द-गिर्द डिज़ाइन किए गए एक समर्पित ब्राउज़र के निर्माण में OpenAI के कदम को दर्शाता है।"},"id":"q38","num":38},{"q":{"en":"Who is the developer of Gemini and what are its main uses?","hi":"जेमिनी (Gemini) का डेवलपर कौन है और इसके मुख्य उपयोग क्या हैं?"},"a":{"en":"Google. A model family and assistant for conversational assistance, reasoning, content, research, and coding. It also offers supported integrations in Google Workspace and Chrome","hi":"गूगल (Google)। संवादी सहायता, तर्क, सामग्री (content), अनुसंधान और कोडिंग के लिए मॉडल परिवार और सहायक (assistant)। यह Google वर्कस्पेस (Google Workspace) और क्रोम (Chrome) में समर्थित एकीकरण (supported integrations) भी प्रदान करता है"},"o":[{"en":"Microsoft. Used for Excel","hi":"माइक्रोसॉफ्ट। एक्सेल के लिए प्रयुक्त"},{"en":"Google. A model family and assistant for conversational assistance, reasoning, content, research, and coding. It also offers supported integrations in Google Workspace and Chrome","hi":"गूगल (Google)। संवादी सहायता, तर्क, सामग्री (content), अनुसंधान और कोडिंग के लिए मॉडल परिवार और सहायक (assistant)। यह Google वर्कस्पेस (Google Workspace) और क्रोम (Chrome) में समर्थित एकीकरण (supported integrations) भी प्रदान करता है"},{"en":"OpenAI. Used for image editing","hi":"ओपनएआई। इमेज एडिटिंग के लिए उपयोग किया जाता है"},{"en":"Apple. Used for Siri","hi":"एप्पल। सिरी के लिए प्रयुक्त"}],"exp":{"en":"Gemini is Google's flagship suite of multimodal AI models and its primary conversational AI interface.\nSource-note (Hinglish): Google. Conversational assistance, reasoning, content, research aur coding ke liye model family aur assistant. Google Workspace aur Chrome mein supported integrations bhi milti hain.","hi":"जेमिनी (Gemini) Google का मल्टीमॉडल AI मॉडल का प्रमुख सूट (flagship suite) है और इसका प्राथमिक संवादी (conversational) AI इंटरफ़ेस है।"},"id":"q39","num":39},{"q":{"en":"Who introduced Claude and when?","hi":"क्लॉड (Claude) को किसने और कब पेश किया?"},"a":{"en":"Anthropic introduced Claude in March 2023. The Claude assistant and model family can support tasks like document analysis, long-form text, coding, and visual inputs","hi":"एंथ्रोपिक (Anthropic) ने मार्च 2023 में क्लॉड (Claude) को पेश किया। क्लॉड सहायक और मॉडल परिवार दस्तावेज़ विश्लेषण (document analysis), लॉन्ग-फॉर्म टेक्स्ट, कोडिंग और विज़ुअल इनपुट जैसे कार्यों का समर्थन कर सकता है"},"o":[{"en":"Google in 2021","hi":"Google ने 2021 में"},{"en":"Anthropic introduced Claude in March 2023. The Claude assistant and model family can support tasks like document analysis, long-form text, coding, and visual inputs","hi":"एंथ्रोपिक (Anthropic) ने मार्च 2023 में क्लॉड (Claude) को पेश किया। क्लॉड सहायक और मॉडल परिवार दस्तावेज़ विश्लेषण (document analysis), लॉन्ग-फॉर्म टेक्स्ट, कोडिंग और विज़ुअल इनपुट जैसे कार्यों का समर्थन कर सकता है"},{"en":"OpenAI in 2022","hi":"OpenAI ने 2022 में"},{"en":"Meta in 2024","hi":"Meta ने 2024 में"}],"exp":{"en":"Claude is known for its large context window, making it particularly good at analyzing long documents and books.\nSource-note (Hinglish): Anthropic ne March 2023 mein Claude introduce kiya. Claude assistant aur model family document analysis, long-form text, coding aur visual inputs jaise tasks support kar sakti hai.","hi":"क्लॉड (Claude) को इसकी बड़ी संदर्भ विंडो (context window) के लिए जाना जाता है, जो इसे विशेष रूप से लंबे दस्तावेजों और पुस्तकों का विश्लेषण करने में अच्छा बनाता है।"},"id":"q40","num":40},{"q":{"en":"What is the relation of Constitutional AI with Claude?","hi":"क्लॉड (Claude) के साथ संवैधानिक एआई (Constitutional AI) का क्या संबंध है?"},"a":{"en":"Anthropic's approach uses explicit principles to guide AI behaviour, with goals such as helpfulness, honesty, and reduced harm. Input modes depend on the model and interface","hi":"एंथ्रोपिक (Anthropic) का दृष्टिकोण AI व्यवहार का मार्गदर्शन करने के लिए स्पष्ट सिद्धांतों (explicit principles) का उपयोग करता है, जिसमें सहायकता (helpfulness), ईमानदारी और कम नुकसान जैसे लक्ष्य शामिल हैं। इनपुट मोड मॉडल और इंटरफ़ेस पर निर्भर करते हैं"},"o":[{"en":"It means Claude is a lawyer","hi":"इसका मतलब है कि क्लॉड एक वकील है"},{"en":"Anthropic's approach uses explicit principles to guide AI behaviour, with goals such as helpfulness, honesty, and reduced harm. Input modes depend on the model and interface","hi":"एंथ्रोपिक (Anthropic) का दृष्टिकोण AI व्यवहार का मार्गदर्शन करने के लिए स्पष्ट सिद्धांतों (explicit principles) का उपयोग करता है, जिसमें सहायकता (helpfulness), ईमानदारी और कम नुकसान जैसे लक्ष्य शामिल हैं। इनपुट मोड मॉडल और इंटरफ़ेस पर निर्भर करते हैं"},{"en":"Claude writes constitutions for countries","hi":"क्लॉड देशों के लिए संविधान लिखता है"},{"en":"There is no relation","hi":"कोई संबंध नहीं है"}],"exp":{"en":"Constitutional AI is Anthropic's method of training AI to be harmless and helpful by providing it with a set of 'constitutional' rules or principles to follow.\nSource-note (Hinglish): Anthropic ka approach explicit principles se AI behaviour guide karta hai, with goals such as helpfulness, honesty and reduced harm. Input modes model aur interface par depend karte hain.","hi":"संवैधानिक AI एंथ्रोपिक की AI को हानिरहित और सहायक होने के लिए प्रशिक्षित करने की विधि है, जिसमें पालन करने के लिए 'संवैधानिक' नियमों या सिद्धांतों का एक सेट प्रदान किया जाता है।"},"id":"q41","num":41},{"q":{"en":"What is the 2023 context of Microsoft Copilot?","hi":"Microsoft Copilot का 2023 संदर्भ (context) क्या है?"},"a":{"en":"Microsoft rolled out Copilot-branded experiences in 2023. The consumer Copilot branding evolved from Bing Chat. Microsoft 365 Copilot is a separate productivity integration","hi":"Microsoft ने 2023 में Copilot-ब्रांडेड अनुभव रोल आउट (roll out) किए। कंज्यूमर Copilot ब्रांडिंग Bing Chat से विकसित (evolve) हुई। Microsoft 365 Copilot एक अलग उत्पादकता एकीकरण (productivity integration) है"},"o":[{"en":"It was discontinued","hi":"इसे बंद कर दिया गया था"},{"en":"Microsoft rolled out Copilot-branded experiences in 2023. The consumer Copilot branding evolved from Bing Chat. Microsoft 365 Copilot is a separate productivity integration","hi":"Microsoft ने 2023 में Copilot-ब्रांडेड अनुभव रोल आउट (roll out) किए। कंज्यूमर Copilot ब्रांडिंग Bing Chat से विकसित (evolve) हुई। Microsoft 365 Copilot एक अलग उत्पादकता एकीकरण (productivity integration) है"},{"en":"It was only released for Xbox","hi":"इसे केवल Xbox के लिए रिलीज़ किया गया था"},{"en":"It was bought by Google","hi":"इसे Google ने खरीद लिया था"}],"exp":{"en":"Microsoft heavily integrated AI across its ecosystem in 2023, unifying many of these features under the 'Copilot' brand name.\nSource-note (Hinglish): Microsoft ne 2023 mein Copilot-branded experiences roll out kiye. Bing Chat se consumer Copilot branding evolve hui. Microsoft 365 Copilot separate productivity integration hai.","hi":"Microsoft ने 2023 में अपने पारिस्थितिकी तंत्र (ecosystem) में AI को भारी रूप से एकीकृत किया, इन कई सुविधाओं को 'Copilot' ब्रांड नाम के तहत एकीकृत (unifying) किया।"},"id":"q42","num":42},{"q":{"en":"What are the app-wise use cases of Microsoft Copilot?","hi":"Microsoft Copilot के ऐप-वार उपयोग के मामले (use cases) क्या हैं?"},"a":{"en":"Word → draft/edit/summarize. Excel → formulas, analysis, charts. PowerPoint → slides. Outlook → emails/threads. Teams → meeting summaries. Edge → webpage assistance. Features depend on the product and account","hi":"वर्ड (Word) → ड्राफ्ट/संपादित/संक्षेप करें। एक्सेल (Excel) → सूत्र (formulas), विश्लेषण, चार्ट। पावरपॉइंट (PowerPoint) → स्लाइड। आउटलुक (Outlook) → ईमेल/थ्रेड। टीम्स (Teams) → मीटिंग सारांश। एज (Edge) → वेबपेज सहायता। सुविधाएँ (Features) उत्पाद और खाते पर निर्भर करती हैं"},"o":[{"en":"Only for playing games","hi":"केवल गेम खेलने के लिए"},{"en":"Word → draft/edit/summarize. Excel → formulas, analysis, charts. PowerPoint → slides. Outlook → emails/threads. Teams → meeting summaries. Edge → webpage assistance. Features depend on the product and account","hi":"वर्ड (Word) → ड्राफ्ट/संपादित/संक्षेप करें। एक्सेल (Excel) → सूत्र (formulas), विश्लेषण, चार्ट। पावरपॉइंट (PowerPoint) → स्लाइड। आउटलुक (Outlook) → ईमेल/थ्रेड। टीम्स (Teams) → मीटिंग सारांश। एज (Edge) → वेबपेज सहायता। सुविधाएँ (Features) उत्पाद और खाते पर निर्भर करती हैं"},{"en":"It is only for formatting text","hi":"यह केवल टेक्स्ट फ़ॉर्मेटिंग के लिए है"},{"en":"None of these","hi":"इनमें से कोई नहीं"}],"exp":{"en":"Microsoft 365 Copilot integrates generative AI directly into the daily workflow of standard office applications, automating routine tasks.\nSource-note (Hinglish): Word → draft/edit/summarize. Excel → formulas, analysis, charts. PowerPoint → slides. Outlook → emails/threads. Teams → meeting summaries. Edge → webpage assistance. Features product aur account par depend karte hain.","hi":"माइक्रोसॉफ्ट 365 कोपायलट (Microsoft 365 Copilot) नियमित कार्यों को स्वचालित (automating) करते हुए, मानक कार्यालय अनुप्रयोगों के दैनिक वर्कफ़्लो में जेनरेटिव AI को सीधे एकीकृत करता है।"},"id":"q43","num":43},{"q":{"en":"What is the main purpose of GitHub Copilot?","hi":"GitHub Copilot का मुख्य उद्देश्य क्या है?"},"a":{"en":"To provide code suggestions, code explanation, and coding assistance to developers. Its use case is different from the general productivity Copilot of the Microsoft ecosystem","hi":"डेवलपर्स को कोड सुझाव (code suggestions), कोड स्पष्टीकरण और कोडिंग सहायता प्रदान करना। इसका उपयोग का मामला Microsoft पारिस्थितिकी तंत्र (ecosystem) के सामान्य उत्पादकता Copilot से अलग है"},"o":[{"en":"To write novels","hi":"उपन्यास लिखना"},{"en":"To provide code suggestions, code explanation, and coding assistance to developers. Its use case is different from the general productivity Copilot of the Microsoft ecosystem","hi":"डेवलपर्स को कोड सुझाव (code suggestions), कोड स्पष्टीकरण और कोडिंग सहायता प्रदान करना। इसका उपयोग का मामला Microsoft पारिस्थितिकी तंत्र (ecosystem) के सामान्य उत्पादकता Copilot से अलग है"},{"en":"To manage HR records","hi":"मानव संसाधन (HR) रिकॉर्ड प्रबंधित करना"},{"en":"To create 3D animations","hi":"3D एनिमेशन बनाना"}],"exp":{"en":"GitHub Copilot is specifically trained on programming languages to act as an AI pair programmer for software developers.\nSource-note (Hinglish): Developers ko code suggestions, code explanation aur coding assistance dena. Microsoft ecosystem ke general productivity Copilot se iska use case alag hai.","hi":"GitHub Copilot को विशेष रूप से प्रोग्रामिंग भाषाओं पर प्रशिक्षित (trained) किया गया है ताकि यह सॉफ्टवेयर डेवलपर्स के लिए AI पेयर प्रोग्रामर (AI pair programmer) के रूप में कार्य कर सके।"},"id":"q44","num":44},{"q":{"en":"Why is it misleading to call GPT-4o, DALL·E 3, and Prometheus the fixed model names of Copilot?","hi":"GPT-4o, DALL·E 3 और प्रोमेथियस (Prometheus) को Copilot के निश्चित मॉडल नाम (fixed model names) कहना भ्रामक (misleading) क्यों है?"},"a":{"en":"GPT-4o is a model, DALL·E 3 is an image model, and Prometheus was the original Bing search/AI orchestration system. The models and integrations of Copilot products change over time","hi":"GPT-4o एक मॉडल है, DALL·E 3 एक छवि (image) मॉडल है, और प्रोमेथियस (Prometheus) मूल बिंग सर्च/AI ऑर्केस्ट्रेशन सिस्टम (orchestration system) था। Copilot उत्पादों के मॉडल और एकीकरण समय के साथ बदलते हैं"},"o":[{"en":"Because Copilot doesn't use models","hi":"क्योंकि Copilot मॉडल का उपयोग नहीं करता है"},{"en":"GPT-4o is a model, DALL·E 3 is an image model, and Prometheus was the original Bing search/AI orchestration system. The models and integrations of Copilot products change over time","hi":"GPT-4o एक मॉडल है, DALL·E 3 एक छवि (image) मॉडल है, और प्रोमेथियस (Prometheus) मूल बिंग सर्च/AI ऑर्केस्ट्रेशन सिस्टम (orchestration system) था। Copilot उत्पादों के मॉडल और एकीकरण समय के साथ बदलते हैं"},{"en":"Because they are models used by Google","hi":"क्योंकि वे Google द्वारा उपयोग किए जाने वाले मॉडल हैं"},{"en":"Because they are hardware names","hi":"क्योंकि वे हार्डवेयर के नाम हैं"}],"exp":{"en":"Copilot is a brand and an interface; the underlying AI models powering it are constantly updated and replaced by Microsoft as technology advances.\nSource-note (Hinglish): GPT-4o ek model hai, DALL·E 3 image model hai aur Prometheus original Bing search/AI orchestration system tha. Copilot products ke models aur integrations time ke saath change hote hain.","hi":"Copilot एक ब्रांड और एक इंटरफ़ेस है; इसे शक्ति देने वाले अंतर्निहित AI मॉडल को तकनीक के आगे बढ़ने के साथ Microsoft द्वारा लगातार अपडेट और बदला जाता है।"},"id":"q45","num":45},{"q":{"en":"What is the key distinguishing use of Perplexity AI?","hi":"Perplexity AI का मुख्य विशिष्ट उपयोग (distinguishing use) क्या है?"},"a":{"en":"AI-powered search and conversational answers with web-source citations. Used for research and information discovery","hi":"वेब-स्रोत उद्धरणों (web-source citations) के साथ AI-संचालित खोज (AI-powered search) और संवादी उत्तर। अनुसंधान और सूचना खोज के लिए प्रयुक्त"},"o":[{"en":"Editing videos","hi":"वीडियो संपादित करना"},{"en":"AI-powered search and conversational answers with web-source citations. Used for research and information discovery","hi":"वेब-स्रोत उद्धरणों (web-source citations) के साथ AI-संचालित खोज (AI-powered search) और संवादी उत्तर। अनुसंधान और सूचना खोज के लिए प्रयुक्त"},{"en":"Controlling drones","hi":"ड्रोन को नियंत्रित करना"},{"en":"Translating ancient languages","hi":"प्राचीन भाषाओं का अनुवाद"}],"exp":{"en":"Unlike traditional chatbots that might hallucinate facts, Perplexity focuses on providing answers backed by direct citations and links to live web sources.\nSource-note (Hinglish): AI-powered search aur web-source citations ke saath conversational answers. Research aur information discovery ke liye use hota hai.","hi":"पारंपरिक चैटबॉट्स के विपरीत जो तथ्यों का मतिभ्रम (hallucinate) कर सकते हैं, पेरप्लेक्सिटी (Perplexity) लाइव वेब स्रोतों के सीधे उद्धरणों (citations) और लिंक द्वारा समर्थित उत्तर प्रदान करने पर केंद्रित है।"},"id":"q46","num":46},{"q":{"en":"Who developed Grok and what is its relation to X?","hi":"Grok को किसने विकसित किया और X से इसका क्या संबंध है?"},"a":{"en":"xAI developed Grok. With X (formerly Twitter) integration and supported search, it can get the context of public X posts","hi":"xAI ने Grok को विकसित किया। X (पूर्व में Twitter) एकीकरण और समर्थित खोज (supported search) के साथ, यह सार्वजनिक X पोस्ट का संदर्भ (context) प्राप्त कर सकता है"},"o":[{"en":"Developed by Meta for Facebook","hi":"फेसबुक के लिए मेटा द्वारा विकसित"},{"en":"xAI developed Grok. With X (formerly Twitter) integration and supported search, it can get the context of public X posts","hi":"xAI ने Grok को विकसित किया। X (पूर्व में Twitter) एकीकरण और समर्थित खोज (supported search) के साथ, यह सार्वजनिक X पोस्ट का संदर्भ (context) प्राप्त कर सकता है"},{"en":"Developed by Google for YouTube","hi":"YouTube के लिए Google द्वारा विकसित"},{"en":"Developed by Amazon for AWS","hi":"AWS के लिए Amazon द्वारा विकसित"}],"exp":{"en":"Grok's unique advantage is its real-time access to the stream of information and discussions happening on the X platform.\nSource-note (Hinglish): xAI ne Grok develop kiya. X (formerly Twitter) integration aur supported search mein public X posts ka context mil sakta hai.","hi":"Grok का अद्वितीय लाभ X प्लेटफॉर्म पर हो रही सूचनाओं और चर्चाओं के प्रवाह तक इसकी वास्तविक समय (real-time) की पहुंच है।"},"id":"q47","num":47},{"q":{"en":"How would you match the six assistant logos in the chapter to their tools?","hi":"आप अध्याय (chapter) में दिए गए छह सहायक लोगो (assistant logos) का उनके टूल से कैसे मिलान करेंगे?"},"a":{"en":"ChatGPT → OpenAI. Gemini → Google. Claude → Anthropic. Copilot → Microsoft. Perplexity → AI search. Grok → xAI","hi":"चैटजीपीटी (ChatGPT) → OpenAI। जेमिनी (Gemini) → Google। क्लॉड (Claude) → एंथ्रोपिक (Anthropic)। कोपायलट (Copilot) → Microsoft। पेरप्लेक्सिटी (Perplexity) → AI सर्च। ग्रोक (Grok) → xAI"},"o":[{"en":"All belong to Apple","hi":"सभी एप्पल के हैं"},{"en":"ChatGPT → OpenAI. Gemini → Google. Claude → Anthropic. Copilot → Microsoft. Perplexity → AI search. Grok → xAI","hi":"चैटजीपीटी (ChatGPT) → OpenAI। जेमिनी (Gemini) → Google। क्लॉड (Claude) → एंथ्रोपिक (Anthropic)। कोपायलट (Copilot) → Microsoft। पेरप्लेक्सिटी (Perplexity) → AI सर्च। ग्रोक (Grok) → xAI"},{"en":"They are all Open Source","hi":"वे सभी ओपन सोर्स हैं"},{"en":"They are hardware manufacturers","hi":"वे हार्डवेयर निर्माता हैं"}],"exp":{"en":"This maps the major conversational AI platforms to their parent companies or primary use cases as outlined in the text.\nSource-note (Hinglish): ChatGPT → OpenAI. Gemini → Google. Claude → Anthropic. Copilot → Microsoft. Perplexity → AI search. Grok → xAI.","hi":"यह प्रमुख संवादी (conversational) AI प्लेटफार्मों को उनकी मूल कंपनियों या प्राथमिक उपयोग के मामलों (primary use cases) से मैप करता है जैसा कि पाठ में बताया गया है।"},"id":"q48","num":48}]},{"title":{"en":"5. AI Image, Video, Writing & Language Tools","hi":"5. AI इमेज, वीडियो, राइटिंग और भाषा टूल्स"},"questions":[{"q":{"en":"What is the developer and task of DALL·E 3?","hi":"DALL·E 3 का डेवलपर और कार्य (task) क्या है?"},"a":{"en":"OpenAI's text-to-image model. Generates detailed illustrations and creative visuals from a prompt. It had historical integration in ChatGPT and Microsoft image experiences","hi":"OpenAI का टेक्स्ट-टू-इमेज (text-to-image) मॉडल। एक प्रॉम्ट (prompt) से विस्तृत चित्र (detailed illustrations) और रचनात्मक दृश्य उत्पन्न करता है। इसका ChatGPT और Microsoft छवि अनुभवों में ऐतिहासिक एकीकरण (historical integration) था"},"o":[{"en":"Google's video editor","hi":"Google का वीडियो संपादक"},{"en":"OpenAI's text-to-image model. Generates detailed illustrations and creative visuals from a prompt. It had historical integration in ChatGPT and Microsoft image experiences","hi":"OpenAI का टेक्स्ट-टू-इमेज (text-to-image) मॉडल। एक प्रॉम्ट (prompt) से विस्तृत चित्र (detailed illustrations) और रचनात्मक दृश्य उत्पन्न करता है। इसका ChatGPT और Microsoft छवि अनुभवों में ऐतिहासिक एकीकरण (historical integration) था"},{"en":"Meta's audio tool","hi":"Meta का ऑडियो टूल"},{"en":"Amazon's code generator","hi":"Amazon का कोड जनरेटर"}],"exp":{"en":"DALL-E 3 is a powerful generative AI model that creates highly accurate images based on text descriptions provided by the user.\nSource-note (Hinglish): OpenAI ka text-to-image model. Prompt se detailed illustrations aur creative visuals generate karta hai. ChatGPT aur Microsoft image experiences mein iska historical integration raha.","hi":"DALL-E 3 एक शक्तिशाली जनरेटिव AI मॉडल है जो उपयोगकर्ता द्वारा प्रदान किए गए टेक्स्ट विवरणों के आधार पर अत्यधिक सटीक चित्र बनाता है।"},"id":"q49","num":49},{"q":{"en":"What is Midjourney used for?","hi":"मिडजर्नी (Midjourney) का उपयोग किस लिए किया जाता है?"},"a":{"en":"AI image generation, concept art, and digital design. The chapter gives the example of Discord. Midjourney's web interface is also available","hi":"AI इमेज जेनरेशन, कॉन्सेप्ट आर्ट और डिजिटल डिज़ाइन। अध्याय (chapter) डिस्कॉर्ड (Discord) का उदाहरण देता है। मिडजर्नी का वेब इंटरफेस भी उपलब्ध है"},"o":[{"en":"To write essays","hi":"निबंध लिखने के लिए"},{"en":"AI image generation, concept art, and digital design. The chapter gives the example of Discord. Midjourney's web interface is also available","hi":"AI इमेज जेनरेशन, कॉन्सेप्ट आर्ट और डिजिटल डिज़ाइन। अध्याय (chapter) डिस्कॉर्ड (Discord) का उदाहरण देता है। मिडजर्नी का वेब इंटरफेस भी उपलब्ध है"},{"en":"To compose music","hi":"संगीत तैयार करने के लिए"},{"en":"To manage spreadsheets","hi":"स्प्रेडशीट प्रबंधित करने के लिए"}],"exp":{"en":"Midjourney is renowned for producing highly artistic and stylized images, initially accessed primarily through the Discord chat application.\nSource-note (Hinglish): AI image generation, concept art aur digital design. Chapter Discord ka example deta hai. Midjourney ka web interface bhi available hai.","hi":"मिडजर्नी (Midjourney) अत्यधिक कलात्मक और शैलीबद्ध (stylized) चित्र बनाने के लिए प्रसिद्ध है, जिसे शुरू में मुख्य रूप से डिस्कॉर्ड चैट एप्लिकेशन के माध्यम से एक्सेस किया गया था।"},"id":"q50","num":50},{"q":{"en":"Which company and task is Nano Banana associated with?","hi":"नैनो बनाना (Nano Banana) किस कंपनी और कार्य (task) से जुड़ा है?"},"a":{"en":"Google Gemini's image generation/editing branding. The original Nano Banana was associated with Gemini 2.5 Flash Image. There can also be newer versions of the brand","hi":"Google जेमिनी (Gemini) की इमेज जनरेशन/एडिटिंग ब्रांडिंग। मूल नैनो बनाना (original Nano Banana) जेमिनी 2.5 फ्लैश इमेज से जुड़ा था। ब्रांड के नए संस्करण भी हो सकते हैं"},"o":[{"en":"Apple's voice assistant","hi":"Apple का वॉयस असिस्टेंट"},{"en":"Google Gemini's image generation/editing branding. The original Nano Banana was associated with Gemini 2.5 Flash Image. There can also be newer versions of the brand","hi":"Google जेमिनी (Gemini) की इमेज जनरेशन/एडिटिंग ब्रांडिंग। मूल नैनो बनाना (original Nano Banana) जेमिनी 2.5 फ्लैश इमेज से जुड़ा था। ब्रांड के नए संस्करण भी हो सकते हैं"},{"en":"Microsoft's code editor","hi":"Microsoft का कोड संपादक"},{"en":"OpenAI's translation tool","hi":"OpenAI का अनुवाद टूल"}],"exp":{"en":"This represents Google's specific branding for certain image generation and manipulation capabilities within the Gemini ecosystem.\nSource-note (Hinglish): Google Gemini ka image generation/editing branding. Original Nano Banana Gemini 2.5 Flash Image se associated tha. Brand ke newer versions bhi ho sakte hain.","hi":"यह जेमिनी इकोसिस्टम (Gemini ecosystem) के भीतर कुछ छवि निर्माण और हेरफेर क्षमताओं (image generation and manipulation capabilities) के लिए Google की विशिष्ट ब्रांडिंग का प्रतिनिधित्व करता है।"},"id":"q51","num":51},{"q":{"en":"What is Stable Diffusion and what is the exam trap regarding its licensing?","hi":"स्टेबल डिफ्यूजन (Stable Diffusion) क्या है और इसके लाइसेंसिंग के संबंध में परीक्षा का जाल (exam trap) क्या है?"},"a":{"en":"An image-generation model family, whose compatible variants can run and be customized on local hardware. Use and commercial rights depend on the specific model license","hi":"एक इमेज-जेनरेशन (image-generation) मॉडल परिवार, जिसके संगत रूप (compatible variants) स्थानीय हार्डवेयर (local hardware) पर चल सकते हैं और अनुकूलित (customized) किए जा सकते हैं। उपयोग और वाणिज्यिक अधिकार (commercial rights) विशिष्ट मॉडल लाइसेंस पर निर्भर करते हैं"},"o":[{"en":"A video player. It is totally free for everything","hi":"एक वीडियो प्लेयर। यह हर चीज के लिए पूरी तरह से मुफ्त है"},{"en":"An image-generation model family, whose compatible variants can run and be customized on local hardware. Use and commercial rights depend on the specific model license","hi":"एक इमेज-जेनरेशन (image-generation) मॉडल परिवार, जिसके संगत रूप (compatible variants) स्थानीय हार्डवेयर (local hardware) पर चल सकते हैं और अनुकूलित (customized) किए जा सकते हैं। उपयोग और वाणिज्यिक अधिकार (commercial rights) विशिष्ट मॉडल लाइसेंस पर निर्भर करते हैं"},{"en":"A word processor","hi":"एक वर्ड प्रोसेसर"},{"en":"A cloud storage service","hi":"एक क्लाउड स्टोरेज सेवा"}],"exp":{"en":"While often described as 'open', the exact terms (especially for commercial use) vary significantly between different versions of Stable Diffusion models.\nSource-note (Hinglish): Image-generation model family, jiske compatible variants local hardware par run aur customize ho sakte hain. Use aur commercial rights specific model license par depend karte hain.","hi":"जबकि अक्सर 'खुले' (open) के रूप में वर्णित किया जाता है, स्टेबल डिफ्यूजन मॉडल के विभिन्न संस्करणों के बीच सटीक शर्तें (विशेष रूप से व्यावसायिक उपयोग के लिए) काफी भिन्न होती हैं।"},"id":"q52","num":52},{"q":{"en":"What is the main use of Google Veo?","hi":"Google Veo का मुख्य उपयोग क्या है?"},"a":{"en":"Google DeepMind's generative video model family, for creating video from prompts","hi":"प्रॉम्ट (prompts) से वीडियो बनाने के लिए, Google डीपमाइंड (DeepMind) का जेनरेटिव वीडियो मॉडल परिवार"},"o":[{"en":"To write poetry","hi":"कविता लिखना"},{"en":"Google DeepMind's generative video model family, for creating video from prompts","hi":"प्रॉम्ट (prompts) से वीडियो बनाने के लिए, Google डीपमाइंड (DeepMind) का जेनरेटिव वीडियो मॉडल परिवार"},{"en":"To scan documents","hi":"दस्तावेज़ों को स्कैन करना"},{"en":"To filter spam emails","hi":"स्पैम ईमेल को फ़िल्टर करना"}],"exp":{"en":"Veo represents Google's entry into high-quality, text-to-video generative AI, competing with tools like OpenAI's Sora.\nSource-note (Hinglish): Google DeepMind ka generative video model family, prompts se video create karne ke liye.","hi":"Veo उच्च गुणवत्ता वाले, टेक्स्ट-टू-वीडियो जेनरेटिव AI में Google के प्रवेश का प्रतिनिधित्व करता है, जो OpenAI के Sora जैसे टूल के साथ प्रतिस्पर्धा करता है।"},"id":"q53","num":53},{"q":{"en":"What does OpusClip do and how is it different from Veo?","hi":"OpusClip क्या करता है और यह Veo से कैसे अलग है?"},"a":{"en":"It edits and repurposes short highlights/clips from existing long videos. Veo's main task is to generate new video from prompts","hi":"यह मौजूदा लंबे वीडियो से शॉर्ट हाइलाइट्स/क्लिप (short highlights/clips) को संपादित (edit) और पुनर्उद्देश्यित (repurpose) करता है। Veo का मुख्य कार्य प्रॉम्ट (prompts) से नया वीडियो उत्पन्न करना है"},"o":[{"en":"They are the exact same","hi":"वे बिल्कुल एक ही हैं"},{"en":"It edits and repurposes short highlights/clips from existing long videos. Veo's main task is to generate new video from prompts","hi":"यह मौजूदा लंबे वीडियो से शॉर्ट हाइलाइट्स/क्लिप (short highlights/clips) को संपादित (edit) और पुनर्उद्देश्यित (repurpose) करता है। Veo का मुख्य कार्य प्रॉम्ट (prompts) से नया वीडियो उत्पन्न करना है"},{"en":"OpusClip makes audio, Veo makes text","hi":"OpusClip ऑडियो बनाता है, Veo टेक्स्ट बनाता है"},{"en":"OpusClip is for images only","hi":"OpusClip केवल छवियों के लिए है"}],"exp":{"en":"OpusClip is an AI editing tool that works with existing footage (like a long podcast), while Veo generates entirely new video content from scratch.\nSource-note (Hinglish): Existing long videos se short highlights/clips edit aur repurpose karta hai. Veo ka main task prompts se new video generate karna hai.","hi":"OpusClip एक AI संपादन उपकरण है जो मौजूदा फुटेज (जैसे एक लंबा पॉडकास्ट) के साथ काम करता है, जबकि Veo शुरुआत से पूरी तरह से नई वीडियो सामग्री उत्पन्न करता है।"},"id":"q54","num":54},{"q":{"en":"What use case is Grammarly known for?","hi":"ग्रामरली (Grammarly) किस उपयोग के मामले (use case) के लिए जाना जाता है?"},"a":{"en":"Writing assistant for grammar, spelling, and clarity. Some versions also offer plagiarism checking","hi":"व्याकरण (grammar), वर्तनी (spelling) और स्पष्टता (clarity) के लिए लेखन सहायक (Writing assistant)। कुछ संस्करण साहित्यिक चोरी (plagiarism) की जाँच भी प्रदान करते हैं"},"o":[{"en":"Drawing pictures","hi":"चित्र बनाना"},{"en":"Writing assistant for grammar, spelling, and clarity. Some versions also offer plagiarism checking","hi":"व्याकरण (grammar), वर्तनी (spelling) और स्पष्टता (clarity) के लिए लेखन सहायक (Writing assistant)। कुछ संस्करण साहित्यिक चोरी (plagiarism) की जाँच भी प्रदान करते हैं"},{"en":"Creating spreadsheets","hi":"स्प्रेडशीट बनाना"},{"en":"Voice recognition","hi":"वॉयस रिकग्निशन"}],"exp":{"en":"Grammarly uses AI to suggest corrections and improvements to written text, helping users write more effectively.\nSource-note (Hinglish): Writing assistant for grammar, spelling aur clarity. Some versions plagiarism checking bhi offer karte hain.","hi":"ग्रामरली (Grammarly) लिखित पाठ में सुधार का सुझाव देने के लिए AI का उपयोग करता है, जिससे उपयोगकर्ताओं को अधिक प्रभावी ढंग से लिखने में मदद मिलती है।"},"id":"q55","num":55},{"q":{"en":"What use case is QuillBot known for?","hi":"QuillBot किस उपयोग के मामले के लिए जाना जाता है?"},"a":{"en":"Writing improvement, paraphrasing, grammar checking, and summarization. Used in academic and general content drafting","hi":"लेखन सुधार (Writing improvement), पैराफ्रेसिंग (paraphrasing), व्याकरण की जाँच (grammar checking) और संक्षेपण (summarization)। शैक्षणिक और सामान्य सामग्री प्रारूपण (general content drafting) में प्रयुक्त"},"o":[{"en":"Generating video games","hi":"वीडियो गेम बनाना"},{"en":"Writing improvement, paraphrasing, grammar checking, and summarization. Used in academic and general content drafting","hi":"लेखन सुधार (Writing improvement), पैराफ्रेसिंग (paraphrasing), व्याकरण की जाँच (grammar checking) और संक्षेपण (summarization)। शैक्षणिक और सामान्य सामग्री प्रारूपण (general content drafting) में प्रयुक्त"},{"en":"Translating live speech","hi":"लाइव भाषण का अनुवाद"},{"en":"Detecting viruses","hi":"वायरस का पता लगाना"}],"exp":{"en":"QuillBot is particularly popular for its paraphrasing tool, which rewrites sentences in different styles.\nSource-note (Hinglish): Writing improvement, paraphrasing, grammar checking aur summarization. Academic aur general content drafting mein use hota hai.","hi":"QuillBot विशेष रूप से अपने पैराफ्रेसिंग टूल के लिए लोकप्रिय है, जो वाक्यों को विभिन्न शैलियों में फिर से लिखता है।"},"id":"q56","num":56},{"q":{"en":"What does Google Translate support?","hi":"Google Translate क्या सपोर्ट करता है?"},"a":{"en":"Multilingual text, speech, and image translation. Supported languages/modes also include conversation and downloaded offline translation options","hi":"बहुभाषी पाठ (Multilingual text), भाषण (speech) और छवि अनुवाद (image translation)। समर्थित भाषाओं/मोड में वार्तालाप (conversation) और डाउनलोड किए गए ऑफ़लाइन अनुवाद विकल्प (offline translation options) भी शामिल हैं"},"o":[{"en":"Only text translation","hi":"केवल पाठ (text) अनुवाद"},{"en":"Multilingual text, speech, and image translation. Supported languages/modes also include conversation and downloaded offline translation options","hi":"बहुभाषी पाठ (Multilingual text), भाषण (speech) और छवि अनुवाद (image translation)। समर्थित भाषाओं/मोड में वार्तालाप (conversation) और डाउनलोड किए गए ऑफ़लाइन अनुवाद विकल्प (offline translation options) भी शामिल हैं"},{"en":"Only English to Hindi","hi":"केवल अंग्रेजी से हिंदी"},{"en":"Coding languages","hi":"कोडिंग भाषाएँ"}],"exp":{"en":"Google Translate has evolved from simple text translation to a comprehensive AI tool capable of translating real-time speech and text within images.\nSource-note (Hinglish): Multilingual text, speech aur image translation. Supported languages/modes mein conversation aur downloaded offline translation options bhi hain.","hi":"Google Translate सरल पाठ अनुवाद से एक व्यापक AI टूल के रूप में विकसित हुआ है जो छवियों के भीतर रीयल-टाइम भाषण और पाठ का अनुवाद करने में सक्षम है।"},"id":"q57","num":57},{"q":{"en":"What is the main focus of ELSA Speak?","hi":"एल्सा स्पीक (ELSA Speak) का मुख्य फोकस क्या है?"},"a":{"en":"English pronunciation practice. It provides pronunciation feedback and personalized learning exercises using speech recognition","hi":"अंग्रेजी उच्चारण अभ्यास (English pronunciation practice)। यह स्पीच रिकग्निशन (speech recognition) का उपयोग करके उच्चारण प्रतिक्रिया (pronunciation feedback) और व्यक्तिगत सीखने के अभ्यास प्रदान करता है"},"o":[{"en":"Translating documents","hi":"दस्तावेज़ों का अनुवाद करना"},{"en":"English pronunciation practice. It provides pronunciation feedback and personalized learning exercises using speech recognition","hi":"अंग्रेजी उच्चारण अभ्यास (English pronunciation practice)। यह स्पीच रिकग्निशन (speech recognition) का उपयोग करके उच्चारण प्रतिक्रिया (pronunciation feedback) और व्यक्तिगत सीखने के अभ्यास प्रदान करता है"},{"en":"Writing emails","hi":"ईमेल लिखना"},{"en":"Creating presentations","hi":"प्रेजेंटेशन बनाना"}],"exp":{"en":"ELSA (English Language Speech Assistant) acts as an AI tutor specifically focused on helping non-native speakers improve their English accent and pronunciation.\nSource-note (Hinglish): English pronunciation practice. Speech recognition se pronunciation feedback aur personalized learning exercises deta hai.","hi":"ELSA (English Language Speech Assistant) एक AI ट्यूटर के रूप में कार्य करता है जो विशेष रूप से गैर-मूल वक्ताओं (non-native speakers) को उनके अंग्रेजी उच्चारण (accent and pronunciation) को बेहतर बनाने में मदद करने पर केंद्रित है।"},"id":"q58","num":58},{"q":{"en":"What is the main role of Canva Magic Studio?","hi":"कैनवा मैजिक स्टूडियो (Canva Magic Studio) की मुख्य भूमिका क्या है?"},"a":{"en":"AI-assisted graphic design for posts, slides, and marketing content. Text-to-image and object removal are feature examples","hi":"पोस्ट, स्लाइड और मार्केटिंग सामग्री (marketing content) के लिए AI-सहायता प्राप्त ग्राफिक डिज़ाइन। टेक्स्ट-टू-इमेज (Text-to-image) और ऑब्जेक्ट रिमूवल (object removal) फीचर उदाहरण हैं"},"o":[{"en":"To compose music tracks","hi":"संगीत ट्रैक (music tracks) तैयार करना"},{"en":"AI-assisted graphic design for posts, slides, and marketing content. Text-to-image and object removal are feature examples","hi":"पोस्ट, स्लाइड और मार्केटिंग सामग्री (marketing content) के लिए AI-सहायता प्राप्त ग्राफिक डिज़ाइन। टेक्स्ट-टू-इमेज (Text-to-image) और ऑब्जेक्ट रिमूवल (object removal) फीचर उदाहरण हैं"},{"en":"To manage accounting","hi":"लेखांकन (accounting) का प्रबंधन करना"},{"en":"To write code","hi":"कोड लिखना"}],"exp":{"en":"Magic Studio integrates various generative AI tools directly into the Canva design platform to simplify content creation.\nSource-note (Hinglish): AI-assisted graphic design for posts, slides aur marketing content. Text-to-image aur object removal jaise features examples hain.","hi":"मैजिक स्टूडियो सामग्री निर्माण को सरल बनाने के लिए सीधे कैनवा डिज़ाइन प्लेटफ़ॉर्म में विभिन्न जेनरेटिव एआई (generative AI) टूल को एकीकृत करता है।"},"id":"q59","num":59},{"q":{"en":"What is Looka used for?","hi":"लूका (Looka) का उपयोग किस लिए किया जाता है?"},"a":{"en":"Logos and brand kits. A tool for business branding and startup design","hi":"लोगो (Logos) और ब्रांड किट। बिजनेस ब्रांडिंग और स्टार्टअप डिजाइन के लिए एक उपकरण"},"o":[{"en":"Making 3D movies","hi":"3D फिल्में बनाना"},{"en":"Logos and brand kits. A tool for business branding and startup design","hi":"लोगो (Logos) और ब्रांड किट। बिजनेस ब्रांडिंग और स्टार्टअप डिजाइन के लिए एक उपकरण"},{"en":"Translating websites","hi":"वेबसाइटों का अनुवाद करना"},{"en":"Filtering spam","hi":"स्पैम फ़िल्टर करना"}],"exp":{"en":"Looka uses AI to quickly generate custom logo options and complete brand identity packages based on user preferences.\nSource-note (Hinglish): Logos aur brand kits. Business branding aur startup design ka tool.","hi":"Looka उपयोगकर्ता की प्राथमिकताओं (user preferences) के आधार पर कस्टम लोगो विकल्प और पूर्ण ब्रांड पहचान पैकेज जल्दी से उत्पन्न करने के लिए AI का उपयोग करता है।"},"id":"q60","num":60}]},{"title":{"en":"6. Voice Assistants & Industry Applications","hi":"6. वॉइस असिस्टेंट और उद्योगों में AI के उपयोग"},"questions":[{"q":{"en":"Who is the developer of Alexa and what are its common uses?","hi":"एलेक्सा (Alexa) का डेवलपर कौन है और इसके सामान्य उपयोग क्या हैं?"},"a":{"en":"Amazon. Voice commands, music, smart-home control, entertainment, and supported shopping tasks","hi":"अमेज़ॅन (Amazon)। वॉयस कमांड, म्यूजिक, स्मार्ट-होम कंट्रोल (smart-home control), मनोरंजन (entertainment) और समर्थित शॉपिंग टास्क (supported shopping tasks)"},"o":[{"en":"Google. Used for searching the web","hi":"गूगल। वेब पर खोजने के लिए उपयोग किया जाता है"},{"en":"Amazon. Voice commands, music, smart-home control, entertainment, and supported shopping tasks","hi":"अमेज़ॅन (Amazon)। वॉयस कमांड, म्यूजिक, स्मार्ट-होम कंट्रोल (smart-home control), मनोरंजन (entertainment) और समर्थित शॉपिंग टास्क (supported shopping tasks)"},{"en":"Apple. Used on iPhones","hi":"एप्पल। iPhones पर उपयोग किया जाता है"},{"en":"Microsoft. Used for typing","hi":"माइक्रोसॉफ्ट। टाइपिंग के लिए उपयोग किया जाता है"}],"exp":{"en":"Alexa is Amazon's virtual assistant, most commonly found in Echo smart speakers and smart home devices.\nSource-note (Hinglish): Amazon. Voice commands, music, smart-home control, entertainment aur supported shopping tasks.","hi":"एलेक्सा अमेज़ॅन का आभासी सहायक (virtual assistant) है, जो आमतौर पर इको स्मार्ट स्पीकर (Echo smart speakers) और स्मार्ट होम उपकरणों में पाया जाता है।"},"id":"q61","num":61},{"q":{"en":"Who is the developer of Siri and what are its uses?","hi":"सिरी (Siri) का डेवलपर कौन है और इसके उपयोग क्या हैं?"},"a":{"en":"Apple. Voice commands, app actions, and hands-free help on iPhone/Mac and other supported Apple devices","hi":"एप्पल (Apple)। iPhone/Mac और अन्य समर्थित Apple उपकरणों पर वॉयस कमांड, ऐप एक्शन और हैंड्स-फ़्री सहायता (hands-free help)"},"o":[{"en":"Microsoft. Used on Xbox","hi":"माइक्रोसॉफ्ट। Xbox पर उपयोग किया जाता है"},{"en":"Apple. Voice commands, app actions, and hands-free help on iPhone/Mac and other supported Apple devices","hi":"एप्पल (Apple)। iPhone/Mac और अन्य समर्थित Apple उपकरणों पर वॉयस कमांड, ऐप एक्शन और हैंड्स-फ़्री सहायता (hands-free help)"},{"en":"Samsung. Used on Galaxy phones","hi":"सैमसंग। गैलेक्सी फोन पर उपयोग किया जाता है"},{"en":"OpenAI. Used for writing code","hi":"OpenAI. कोड लिखने के लिए उपयोग किया जाता है"}],"exp":{"en":"Siri is deeply integrated into the Apple ecosystem, allowing users to control their devices and access information using voice.\nSource-note (Hinglish): Apple. iPhone/Mac aur doosre supported Apple devices par voice commands, app actions aur hands-free help.","hi":"सिरी को Apple इकोसिस्टम में गहराई से एकीकृत किया गया है, जिससे उपयोगकर्ता अपने उपकरणों को नियंत्रित कर सकते हैं और आवाज़ का उपयोग करके जानकारी तक पहुँच सकते हैं।"},"id":"q62","num":62},{"q":{"en":"What are the major uses of AI in healthcare?","hi":"हेल्थकेयर में AI के प्रमुख उपयोग क्या हैं?"},"a":{"en":"Disease detection or prediction, image-assisted diagnosis, drug discovery, and surgical assistance. Image findings can support clinical review","hi":"रोग का पता लगाना (Disease detection) या भविष्यवाणी करना, छवि-सहायता प्राप्त निदान (image-assisted diagnosis), दवा की खोज (drug discovery) और शल्य चिकित्सा सहायता (surgical assistance)। छवि निष्कर्ष (Image findings) नैदानिक समीक्षा (clinical review) का समर्थन कर सकते हैं"},"o":[{"en":"Creating marketing campaigns","hi":"मार्केटिंग अभियान बनाना"},{"en":"Disease detection or prediction, image-assisted diagnosis, drug discovery, and surgical assistance. Image findings can support clinical review","hi":"रोग का पता लगाना (Disease detection) या भविष्यवाणी करना, छवि-सहायता प्राप्त निदान (image-assisted diagnosis), दवा की खोज (drug discovery) और शल्य चिकित्सा सहायता (surgical assistance)। छवि निष्कर्ष (Image findings) नैदानिक समीक्षा (clinical review) का समर्थन कर सकते हैं"},{"en":"Managing stock portfolios","hi":"स्टॉक पोर्टफोलियो का प्रबंधन"},{"en":"Automating factories","hi":"कारखानों को स्वचालित करना"}],"exp":{"en":"AI is revolutionizing healthcare by helping doctors analyze medical images (like X-rays) faster and speeding up the development of new medicines.\nSource-note (Hinglish): Disease detection or prediction, image-assisted diagnosis, drug discovery aur surgical assistance. Image findings clinical review ko support kar sakti hain.","hi":"AI डॉक्टरों को मेडिकल इमेजेज (जैसे X-rays) का तेज़ी से विश्लेषण करने में मदद करके और नई दवाओं के विकास को तेज़ करके स्वास्थ्य सेवा में क्रांति ला रहा है।"},"id":"q63","num":63},{"q":{"en":"How is AI used in finance and banking?","hi":"वित्त (Finance) और बैंकिंग में AI का उपयोग कैसे किया जाता है?"},"a":{"en":"Tasks like fraud alerts, risk scoring, robo-advisory, and algorithmic trading. Real-time screening can flag unusual transactions","hi":"धोखाधड़ी अलर्ट (fraud alerts), जोखिम स्कोरिंग (risk scoring), रोबो-सलाहकारी (robo-advisory) और एल्गोरिथम ट्रेडिंग (algorithmic trading) जैसे कार्य। रीयल-टाइम स्क्रीनिंग असामान्य लेनदेन (unusual transactions) को फ़्लैग कर सकती है"},"o":[{"en":"To cook food in the cafeteria","hi":"कैफिटेरिया में खाना पकाने के लिए"},{"en":"Tasks like fraud alerts, risk scoring, robo-advisory, and algorithmic trading. Real-time screening can flag unusual transactions","hi":"धोखाधड़ी अलर्ट (fraud alerts), जोखिम स्कोरिंग (risk scoring), रोबो-सलाहकारी (robo-advisory) और एल्गोरिथम ट्रेडिंग (algorithmic trading) जैसे कार्य। रीयल-टाइम स्क्रीनिंग असामान्य लेनदेन (unusual transactions) को फ़्लैग कर सकती है"},{"en":"To perform surgery","hi":"सर्जरी करने के लिए"},{"en":"To harvest crops","hi":"फसल काटने के लिए"}],"exp":{"en":"Banks use AI heavily to instantly spot suspicious credit card charges and to use algorithms for automated investment advice (robo-advisors).\nSource-note (Hinglish): Fraud alerts, risk scoring, robo-advisory aur algorithmic trading jaise tasks. Real-time screening unusual transactions flag kar sakti hai.","hi":"बैंक संदिग्ध क्रेडिट कार्ड शुल्कों (charges) को तुरंत पहचानने और स्वचालित निवेश सलाह (robo-advisors) के लिए एल्गोरिदम का उपयोग करने के लिए AI का भारी उपयोग करते हैं।"},"id":"q64","num":64},{"q":{"en":"What are the AI applications in manufacturing?","hi":"मैन्युफैक्चरिंग (निर्माण) में AI के अनुप्रयोग क्या हैं?"},"a":{"en":"Predictive maintenance, visual quality inspection, and production automation. The 1961 deployment of Unimate is an industrial robotics milestone","hi":"प्रेडिक्टिव मेंटेनेंस (Predictive maintenance), दृश्य गुणवत्ता निरीक्षण (visual quality inspection) और उत्पादन स्वचालन (production automation)। यूनीमेट (Unimate) का 1961 का परिनियोजन (deployment) एक औद्योगिक रोबोटिक्स मील का पत्थर (milestone) है"},"o":[{"en":"Grading exam papers","hi":"परीक्षा के पेपर जाँचना"},{"en":"Predictive maintenance, visual quality inspection, and production automation. The 1961 deployment of Unimate is an industrial robotics milestone","hi":"प्रेडिक्टिव मेंटेनेंस (Predictive maintenance), दृश्य गुणवत्ता निरीक्षण (visual quality inspection) और उत्पादन स्वचालन (production automation)। यूनीमेट (Unimate) का 1961 का परिनियोजन (deployment) एक औद्योगिक रोबोटिक्स मील का पत्थर (milestone) है"},{"en":"Composing music","hi":"संगीत रचना"},{"en":"Translating languages","hi":"भाषाओं का अनुवाद करना"}],"exp":{"en":"AI helps factories predict when a machine will break down (predictive maintenance) and uses cameras to spot defective products on the assembly line.\nSource-note (Hinglish): Predictive maintenance, visual quality inspection aur production automation. Unimate ka 1961 deployment industrial robotics milestone hai.","hi":"एआई कारखानों को यह अनुमान लगाने में मदद करता है कि कोई मशीन कब खराब होगी (प्रेडिक्टिव मेंटेनेंस) और असेंबली लाइन पर खराब उत्पादों को पहचानने के लिए कैमरों का उपयोग करता है।"},"id":"q65","num":65},{"q":{"en":"What are examples of AI in retail/e-commerce?","hi":"रिटेल (खुदरा)/ई-कॉमर्स में AI के उदाहरण क्या हैं?"},"a":{"en":"Product recommendations (like Amazon), inventory forecasting, stock management, and dynamic pricing","hi":"उत्पाद अनुशंसाएँ (Product recommendations - जैसे Amazon), इन्वेंट्री पूर्वानुमान (inventory forecasting), स्टॉक प्रबंधन और गतिशील मूल्य निर्धारण (dynamic pricing)"},"o":[{"en":"Driving trucks","hi":"ट्रक चलाना"},{"en":"Product recommendations (like Amazon), inventory forecasting, stock management, and dynamic pricing","hi":"उत्पाद अनुशंसाएँ (Product recommendations - जैसे Amazon), इन्वेंट्री पूर्वानुमान (inventory forecasting), स्टॉक प्रबंधन और गतिशील मूल्य निर्धारण (dynamic pricing)"},{"en":"Treating patients","hi":"मरीजों का इलाज करना"},{"en":"Building bridges","hi":"पुल बनाना"}],"exp":{"en":"E-commerce platforms use AI to show you 'Products you might like' and to adjust prices in real-time based on demand.\nSource-note (Hinglish): Product recommendations (jaise Amazon), inventory forecasting, stock management aur dynamic pricing.","hi":"ई-कॉमर्स प्लेटफॉर्म आपको 'उत्पाद जो आपको पसंद आ सकते हैं' दिखाने और मांग के आधार पर वास्तविक समय (real-time) में कीमतों को समायोजित करने के लिए AI का उपयोग करते हैं।"},"id":"q66","num":66},{"q":{"en":"What is the relation between precision farming and AI in agriculture?","hi":"कृषि में सटीक खेती (precision farming) और AI के बीच क्या संबंध है?"},"a":{"en":"Sensor, drone, or satellite data supports decisions regarding crop health, disease signs, irrigation, and inputs","hi":"सेंसर (Sensor), ड्रोन या उपग्रह डेटा (satellite data) फसल के स्वास्थ्य, बीमारी के लक्षण, सिंचाई (irrigation) और इनपुट (inputs) के संबंध में निर्णयों का समर्थन करता है"},"o":[{"en":"AI replaces all farmers","hi":"AI सभी किसानों की जगह लेता है"},{"en":"Sensor, drone, or satellite data supports decisions regarding crop health, disease signs, irrigation, and inputs","hi":"सेंसर (Sensor), ड्रोन या उपग्रह डेटा (satellite data) फसल के स्वास्थ्य, बीमारी के लक्षण, सिंचाई (irrigation) और इनपुट (inputs) के संबंध में निर्णयों का समर्थन करता है"},{"en":"AI is only used to sell crops","hi":"AI का उपयोग केवल फसल बेचने के लिए किया जाता है"},{"en":"There is no relation","hi":"कोई संबंध नहीं है"}],"exp":{"en":"Precision farming uses AI to analyze data from the field, allowing farmers to apply exactly the right amount of water and fertilizer only where it is needed.\nSource-note (Hinglish): Sensor, drone ya satellite data se crop health, disease signs, irrigation aur inputs ke decisions support hote hain.","hi":"प्रिसिजन फार्मिंग खेत से डेटा का विश्लेषण करने के लिए AI का उपयोग करती है, जिससे किसानों को केवल वहीं पानी और उर्वरक (fertilizer) की सही मात्रा लागू करने की अनुमति मिलती है जहां इसकी आवश्यकता होती है।"},"id":"q67","num":67},{"q":{"en":"What can AI do in the energy industry?","hi":"ऊर्जा उद्योग (energy industry) में AI क्या कर सकता है?"},"a":{"en":"Smart-grid demand forecasting, renewable generation forecasting, grid optimization, and predictive maintenance","hi":"स्मार्ट-ग्रिड मांग पूर्वानुमान (Smart-grid demand forecasting), अक्षय उत्पादन पूर्वानुमान (renewable generation forecasting), ग्रिड अनुकूलन (grid optimization) और प्रेडिक्टिव मेंटेनेंस"},"o":[{"en":"Create new elements","hi":"नए तत्व बनाना"},{"en":"Smart-grid demand forecasting, renewable generation forecasting, grid optimization, and predictive maintenance","hi":"स्मार्ट-ग्रिड मांग पूर्वानुमान (Smart-grid demand forecasting), अक्षय उत्पादन पूर्वानुमान (renewable generation forecasting), ग्रिड अनुकूलन (grid optimization) और प्रेडिक्टिव मेंटेनेंस"},{"en":"Mine for coal automatically","hi":"स्वचालित रूप से कोयले की खदान (Mine for coal automatically)"},{"en":"Only turn lights on and off","hi":"केवल लाइट चालू और बंद करें"}],"exp":{"en":"AI helps power grids balance supply and demand efficiently, especially when dealing with variable renewable energy sources like wind and solar.\nSource-note (Hinglish): Smart-grid demand forecasting, renewable generation forecasting, grid optimization aur predictive maintenance.","hi":"AI पावर ग्रिड को आपूर्ति और मांग को कुशलता से संतुलित करने में मदद करता है, खासकर जब हवा और सौर जैसे परिवर्तनशील नवीकरणीय ऊर्जा स्रोतों (variable renewable energy sources) से निपटते हैं।"},"id":"q68","num":68},{"q":{"en":"What are examples of AI in education?","hi":"शिक्षा में AI के उदाहरण क्या हैं?"},"a":{"en":"Personalized learning, automated grading support, tutoring, and language practice apps like Duolingo","hi":"वैयक्तिकृत शिक्षा (Personalized learning), स्वचालित ग्रेडिंग समर्थन (automated grading support), ट्यूशन और डुओलिंगो (Duolingo) जैसे भाषा अभ्यास ऐप"},"o":[{"en":"Operating school buses","hi":"स्कूल बसों का संचालन"},{"en":"Personalized learning, automated grading support, tutoring, and language practice apps like Duolingo","hi":"वैयक्तिकृत शिक्षा (Personalized learning), स्वचालित ग्रेडिंग समर्थन (automated grading support), ट्यूशन और डुओलिंगो (Duolingo) जैसे भाषा अभ्यास ऐप"},{"en":"Cooking school lunches","hi":"स्कूल का लंच पकाना"},{"en":"Building schools","hi":"स्कूल बनाना"}],"exp":{"en":"AI can adapt educational content to a student's individual learning pace and provide instant feedback on assignments.\nSource-note (Hinglish): Personalized learning, automated grading support, tutoring aur language practice apps jaise Duolingo.","hi":"एआई शैक्षिक सामग्री को छात्र की व्यक्तिगत सीखने की गति के अनुकूल बना सकता है और असाइनमेंट पर त्वरित प्रतिक्रिया प्रदान कर सकता है।"},"id":"q69","num":69},{"q":{"en":"What is the role of AI in transportation?","hi":"परिवहन (transportation) में AI की क्या भूमिका है?"},"a":{"en":"Route optimization and driving perception/control. Waymo is an example of an autonomous service. Tesla Autopilot falls in the driver-assistance category","hi":"मार्ग अनुकूलन (Route optimization) और ड्राइविंग धारणा/नियंत्रण (driving perception/control)। वेमो (Waymo) एक स्वायत्त सेवा (autonomous service) का उदाहरण है। टेस्ला ऑटोपायलट (Tesla Autopilot) ड्राइवर-सहायता श्रेणी (driver-assistance category) में आता है"},"o":[{"en":"Only booking tickets","hi":"केवल टिकट बुक करना"},{"en":"Route optimization and driving perception/control. Waymo is an example of an autonomous service. Tesla Autopilot falls in the driver-assistance category","hi":"मार्ग अनुकूलन (Route optimization) और ड्राइविंग धारणा/नियंत्रण (driving perception/control)। वेमो (Waymo) एक स्वायत्त सेवा (autonomous service) का उदाहरण है। टेस्ला ऑटोपायलट (Tesla Autopilot) ड्राइवर-सहायता श्रेणी (driver-assistance category) में आता है"},{"en":"Serving food on airplanes","hi":"हवाई जहाजों में खाना परोसना"},{"en":"Repairing train tracks","hi":"ट्रेन की पटरियों की मरम्मत"}],"exp":{"en":"AI is the core technology that allows autonomous vehicles to perceive their surroundings, make driving decisions, and navigate safely.\nSource-note (Hinglish): Route optimization aur driving perception/control. Waymo autonomous service ka example hai. Tesla Autopilot driver-assistance category mein aata hai.","hi":"AI वह मुख्य तकनीक है जो स्वायत्त वाहनों को अपने परिवेश (surroundings) को समझने, ड्राइविंग निर्णय लेने और सुरक्षित रूप से नेविगेट करने की अनुमति देती है।"},"id":"q70","num":70},{"q":{"en":"Can the '50% downtime reduction' and '175 GW additional capacity' in the PDF be considered general AI outcomes?","hi":"क्या PDF में दिए गए '50% डाउनटाइम में कमी' और '175 GW अतिरिक्त क्षमता' को सामान्य AI परिणाम माना जा सकता है?"},"a":{"en":"The slide does not provide a named study, baseline, or timeframe for these figures. Revise the use cases. The exact impact depends on specific deployment and evidence","hi":"स्लाइड इन आंकड़ों (figures) के लिए एक नामित अध्ययन (named study), बेसलाइन या समय सीमा (timeframe) प्रदान नहीं करती है। उपयोग के मामलों (use cases) को संशोधित करें। सटीक प्रभाव विशिष्ट परिनियोजन (specific deployment) और साक्ष्य (evidence) पर निर्भर करता है"},"o":[{"en":"Yes, they apply to every company","hi":"हाँ, वे हर कंपनी पर लागू होते हैं"},{"en":"The slide does not provide a named study, baseline, or timeframe for these figures. Revise the use cases. The exact impact depends on specific deployment and evidence","hi":"स्लाइड इन आंकड़ों (figures) के लिए एक नामित अध्ययन (named study), बेसलाइन या समय सीमा (timeframe) प्रदान नहीं करती है। उपयोग के मामलों (use cases) को संशोधित करें। सटीक प्रभाव विशिष्ट परिनियोजन (specific deployment) और साक्ष्य (evidence) पर निर्भर करता है"},{"en":"Yes, they are guaranteed by law","hi":"हाँ, वे कानून द्वारा गारंटीकृत हैं"},{"en":"They are negative outcomes","hi":"वे नकारात्मक परिणाम हैं"}],"exp":{"en":"Be cautious with specific percentages in study materials if they lack clear citations; focus instead on understanding the *type* of benefit AI provides (e.g., AI enables predictive maintenance, which *can* reduce downtime).\nSource-note (Hinglish): Slide in figures ke liye named study, baseline ya timeframe nahin deti. Use cases revise karo. Exact impact specific deployment aur evidence par depend karta hai.","hi":"अध्ययन सामग्री (study materials) में विशिष्ट प्रतिशत से सावधान रहें यदि उनमें स्पष्ट उद्धरण (clear citations) का अभाव है; इसके बजाय एआई द्वारा प्रदान किए जाने वाले लाभ के *प्रकार* को समझने पर ध्यान केंद्रित करें।"},"id":"q71","num":71}]},{"title":{"en":"7. IndiaAI Mission & AIKosh","hi":"7. IndiaAI मिशन और AIKosh"},"questions":[{"q":{"en":"When was the IndiaAI Mission approved, what was the outlay, and which is the ministry?","hi":"IndiaAI मिशन को कब मंजूरी दी गई, परिव्यय (outlay) कितना था और मंत्रालय कौन सा है?"},"a":{"en":"The Union Cabinet approved ₹10,371.92 crore over five years on 7 March 2024. The Mission is under MeitY","hi":"केंद्रीय मंत्रिमंडल ने 7 मार्च 2024 को पांच वर्षों में ₹10,371.92 करोड़ की मंजूरी दी। यह मिशन MeitY के अंतर्गत है"},"o":[{"en":"Approved in 2020, ₹1,000 crore, Ministry of Finance","hi":"2020 में स्वीकृत, ₹1,000 करोड़, वित्त मंत्रालय"},{"en":"The Union Cabinet approved ₹10,371.92 crore over five years on 7 March 2024. The Mission is under MeitY","hi":"केंद्रीय मंत्रिमंडल ने 7 मार्च 2024 को पांच वर्षों में ₹10,371.92 करोड़ की मंजूरी दी। यह मिशन MeitY के अंतर्गत है"},{"en":"Approved in 2025, ₹50,000 crore, Ministry of Education","hi":"2025 में स्वीकृत, ₹50,000 करोड़, शिक्षा मंत्रालय"},{"en":"Approved in 2022, ₹5,000 crore, Ministry of Defence","hi":"2022 में स्वीकृत, ₹5,000 करोड़, रक्षा मंत्रालय"}],"exp":{"en":"This is a major government initiative by the Ministry of Electronics and IT (MeitY) to build a robust AI ecosystem in India.\nSource-note (Hinglish): Union Cabinet ne 7 March 2024 ko ₹10,371.92 crore over five years approve kiye. Mission MeitY ke under hai.","hi":"यह भारत में एक मजबूत AI पारिस्थितिकी तंत्र (ecosystem) बनाने के लिए इलेक्ट्रॉनिक्स और आईटी मंत्रालय (MeitY) की एक प्रमुख सरकारी पहल है।"},"id":"q72","num":72},{"q":{"en":"What are the seven pillars of the IndiaAI Mission?","hi":"IndiaAI मिशन के सात स्तंभ (pillars) कौन से हैं?"},"a":{"en":"Compute Capacity, Innovation Centre/foundation models, Datasets Platform/AIKosh, Application Development Initiative, FutureSkills, Startup Financing, and Safe & Trusted AI","hi":"कंप्यूट क्षमता (Compute Capacity), इनोवेशन सेंटर/फाउंडेशन मॉडल (Innovation Centre/foundation models), डेटासेट प्लेटफॉर्म/एआईकोश (Datasets Platform/AIKosh), एप्लिकेशन डेवलपमेंट इनिशिएटिव (Application Development Initiative), फ्यूचरस्किल्स (FutureSkills), स्टार्टअप फाइनेंसिंग (Startup Financing), और सुरक्षित और विश्वसनीय एआई (Safe & Trusted AI)"},"o":[{"en":"Only hardware and software","hi":"केवल हार्डवेयर और सॉफ्टवेयर"},{"en":"Compute Capacity, Innovation Centre/foundation models, Datasets Platform/AIKosh, Application Development Initiative, FutureSkills, Startup Financing, and Safe & Trusted AI","hi":"कंप्यूट क्षमता (Compute Capacity), इनोवेशन सेंटर/फाउंडेशन मॉडल (Innovation Centre/foundation models), डेटासेट प्लेटफॉर्म/एआईकोश (Datasets Platform/AIKosh), एप्लिकेशन डेवलपमेंट इनिशिएटिव (Application Development Initiative), फ्यूचरस्किल्स (FutureSkills), स्टार्टअप फाइनेंसिंग (Startup Financing), और सुरक्षित और विश्वसनीय एआई (Safe & Trusted AI)"},{"en":"Agriculture, Finance, Healthcare, Education, Defense, Transport, Retail","hi":"Agriculture, Finance, Healthcare, Education, Defense, Transport, Retail"},{"en":"None of the above","hi":"इनमें से कोई भी नहीं"}],"exp":{"en":"These seven pillars cover the entire AI lifecycle, from infrastructure and data to skill development and ethical guidelines.\nSource-note (Hinglish): Compute Capacity, Innovation Centre/foundation models, Datasets Platform/AIKosh, Application Development Initiative, FutureSkills, Startup Financing aur Safe & Trusted AI.","hi":"ये सात स्तंभ बुनियादी ढांचे और डेटा से लेकर कौशल विकास और नैतिक दिशानिर्देशों (ethical guidelines) तक पूरे AI जीवनचक्र (lifecycle) को कवर करते हैं।"},"id":"q73","num":73},{"q":{"en":"What is the purpose of IndiaAI Compute Capacity?","hi":"IndiaAI कंप्यूट क्षमता (Compute Capacity) का उद्देश्य क्या है?"},"a":{"en":"To make shared high-end compute affordable for researchers, startups, and eligible users. The full form of GPU is Graphics Processing Unit","hi":"शोधकर्ताओं (researchers), स्टार्टअप्स और पात्र उपयोगकर्ताओं के लिए साझा हाई-एंड कंप्यूट को किफायती बनाना। GPU का फुल फॉर्म ग्राफिक्स प्रोसेसिंग यूनिट (Graphics Processing Unit) है"},"o":[{"en":"To build faster calculators","hi":"तेज कैलकुलेटर बनाने के लिए"},{"en":"To make shared high-end compute affordable for researchers, startups, and eligible users. The full form of GPU is Graphics Processing Unit","hi":"शोधकर्ताओं (researchers), स्टार्टअप्स और पात्र उपयोगकर्ताओं के लिए साझा हाई-एंड कंप्यूट को किफायती बनाना। GPU का फुल फॉर्म ग्राफिक्स प्रोसेसिंग यूनिट (Graphics Processing Unit) है"},{"en":"To provide free laptops to students","hi":"छात्रों को मुफ्त लैपटॉप प्रदान करना"},{"en":"To increase internet speed","hi":"इंटरनेट की गति बढ़ाने के लिए"}],"exp":{"en":"Access to expensive GPU computing power is a major bottleneck for AI development; this pillar aims to democratize that access.\nSource-note (Hinglish): Researchers, startups aur eligible users ko shared high-end compute affordable banana. GPU ka full form Graphics Processing Unit hai.","hi":"महंगी GPU कंप्यूटिंग शक्ति तक पहुँच AI विकास के लिए एक बड़ी बाधा (bottleneck) है; इस स्तंभ का उद्देश्य उस पहुँच का लोकतंत्रीकरण (democratize) करना है।"},"id":"q74","num":74},{"q":{"en":"What were the figures for IndiaAI compute in the October 2025 PIB snapshot?","hi":"अक्टूबर 2025 के PIB स्नैपशॉट में IndiaAI कंप्यूट के लिए क्या आंकड़े थे?"},"a":{"en":"A 12 October 2025 PIB backgrounder gave the subsidized figure of over 38,000 GPUs onboarded and a rate of ₹65/hour. Availability and actual GPU rates on the platform can change","hi":"12 अक्टूबर 2025 के PIB बैकग्राउंडर (backgrounder) ने 38,000 से अधिक GPU ऑनबोर्ड किए जाने और ₹65/घंटे की दर (rate) का रियायती आंकड़ा (subsidized figure) दिया। प्लेटफॉर्म पर उपलब्धता और वास्तविक GPU दरें बदल सकती हैं"},"o":[{"en":"1,000 GPUs at ₹100/hour","hi":"1,000 GPUs ₹100/घंटा पर"},{"en":"A 12 October 2025 PIB backgrounder gave the subsidized figure of over 38,000 GPUs onboarded and a rate of ₹65/hour. Availability and actual GPU rates on the platform can change","hi":"12 अक्टूबर 2025 के PIB बैकग्राउंडर (backgrounder) ने 38,000 से अधिक GPU ऑनबोर्ड किए जाने और ₹65/घंटे की दर (rate) का रियायती आंकड़ा (subsidized figure) दिया। प्लेटफॉर्म पर उपलब्धता और वास्तविक GPU दरें बदल सकती हैं"},{"en":"100,000 GPUs for free","hi":"100,000 GPUs मुफ्त में"},{"en":"No GPUs were available","hi":"कोई GPU उपलब्ध नहीं था"}],"exp":{"en":"These figures represent a snapshot in time from a government press release to show the scale and affordability of the initiative.\nSource-note (Hinglish): 12 October 2025 PIB backgrounder mein 38,000 se zyada GPUs onboarded aur ₹65/hour ka subsidized figure diya gaya. Availability aur actual GPU rates platform par change ho sakte hain.","hi":"ये आंकड़े पहल (initiative) के पैमाने (scale) और सामर्थ्य (affordability) को दिखाने के लिए एक सरकारी प्रेस विज्ञप्ति (press release) के समय के स्नैपशॉट का प्रतिनिधित्व करते हैं।"},"id":"q75","num":75},{"q":{"en":"What was the approval count and focus of the IndiaAI Application Development Initiative in July 2025?","hi":"जुलाई 2025 में IndiaAI एप्लिकेशन डेवलपमेंट इनिशिएटिव की स्वीकृति संख्या (approval count) और फोकस क्या था?"},"a":{"en":"The PIB backgrounder states 30 applications were approved by July 2025. The focus included healthcare, agriculture, climate change, governance, and assistive learning. The source slide writes '30+'","hi":"PIB बैकग्राउंडर (backgrounder) बताता है कि जुलाई 2025 तक 30 एप्लिकेशन स्वीकृत किए गए थे। फोकस में स्वास्थ्य सेवा, कृषि, जलवायु परिवर्तन, शासन और सहायक शिक्षण (assistive learning) शामिल थे। स्रोत स्लाइड '30+' लिखती है"},"o":[{"en":"100 games approved","hi":"100 गेम स्वीकृत"},{"en":"The PIB backgrounder states 30 applications were approved by July 2025. The focus included healthcare, agriculture, climate change, governance, and assistive learning. The source slide writes '30+'","hi":"PIB बैकग्राउंडर (backgrounder) बताता है कि जुलाई 2025 तक 30 एप्लिकेशन स्वीकृत किए गए थे। फोकस में स्वास्थ्य सेवा, कृषि, जलवायु परिवर्तन, शासन और सहायक शिक्षण (assistive learning) शामिल थे। स्रोत स्लाइड '30+' लिखती है"},{"en":"0 applications approved","hi":"0 एप्लिकेशन स्वीकृत"},{"en":"Focused only on social media","hi":"केवल सोशल मीडिया पर केंद्रित"}],"exp":{"en":"This initiative funds projects that apply AI to solve critical, large-scale socio-economic problems in India.\nSource-note (Hinglish): PIB backgrounder 30 applications approved by July 2025 batata hai. Focus mein healthcare, agriculture, climate change, governance aur assistive learning the. Source slide “30+” likhti hai.","hi":"यह पहल (initiative) उन परियोजनाओं को निधि (funds) देती है जो भारत में महत्वपूर्ण, बड़े पैमाने पर सामाजिक-आर्थिक समस्याओं को हल करने के लिए AI लागू करते हैं।"},"id":"q76","num":76},{"q":{"en":"Which field is the CyberGuard AI Hackathon related to?","hi":"CyberGuard AI Hackathon किस क्षेत्र से संबंधित है?"},"a":{"en":"AI solutions for India-specific use cases in cybersecurity","hi":"साइबर सुरक्षा (cybersecurity) में भारत-विशिष्ट उपयोग के मामलों (India-specific use cases) के लिए AI समाधान"},"o":[{"en":"Agriculture","hi":"कृषि"},{"en":"AI solutions for India-specific use cases in cybersecurity","hi":"साइबर सुरक्षा (cybersecurity) में भारत-विशिष्ट उपयोग के मामलों (India-specific use cases) के लिए AI समाधान"},{"en":"Healthcare","hi":"स्वास्थ्य सेवा"},{"en":"Education","hi":"शिक्षा"}],"exp":{"en":"As the name 'CyberGuard' suggests, it focuses on developing AI-powered tools to protect against cyber threats.\nSource-note (Hinglish): Cybersecurity ke India-specific use cases ke liye AI solutions.","hi":"जैसा कि 'साइबरगार्ड' नाम से पता चलता है, यह साइबर खतरों (cyber threats) से बचाने के लिए AI-संचालित उपकरण विकसित करने पर केंद्रित है।"},"id":"q77","num":77},{"q":{"en":"What is AIKosh and how many resources were listed in the October 2025 backgrounder?","hi":"AIKosh क्या है और अक्टूबर 2025 के बैकग्राउंडर में कितने संसाधन (resources) सूचीबद्ध थे?"},"a":{"en":"IndiaAI's national datasets and model platform. The dated PIB snapshot listed 3,000+ datasets and 243 AI models across 20 sectors","hi":"IndiaAI का राष्ट्रीय डेटासेट और मॉडल प्लेटफॉर्म। दिनांकित PIB स्नैपशॉट में 20 क्षेत्रों (sectors) में 3,000+ डेटासेट और 243 AI मॉडल सूचीबद्ध थे"},"o":[{"en":"A dictionary. 50 words","hi":"एक शब्दकोश। 50 शब्द"},{"en":"IndiaAI's national datasets and model platform. The dated PIB snapshot listed 3,000+ datasets and 243 AI models across 20 sectors","hi":"IndiaAI का राष्ट्रीय डेटासेट और मॉडल प्लेटफॉर्म। दिनांकित PIB स्नैपशॉट में 20 क्षेत्रों (sectors) में 3,000+ डेटासेट और 243 AI मॉडल सूचीबद्ध थे"},{"en":"A new hardware processor. 1 model","hi":"एक नया हार्डवेयर प्रोसेसर। 1 मॉडल"},{"en":"A search engine","hi":"एक सर्च इंजन"}],"exp":{"en":"'Kosh' means treasure or repository in Hindi. AIKosh acts as a centralized repository for valuable datasets and pre-trained models for Indian developers.\nSource-note (Hinglish): IndiaAI ka national datasets and model platform. PIB ke dated snapshot mein 3,000+ datasets aur 243 AI models across 20 sectors the.","hi":"हिंदी में 'कोश' का अर्थ खजाना या भंडार (repository) होता है। AIKosh भारतीय डेवलपर्स के लिए मूल्यवान डेटासेट और पूर्व-प्रशिक्षित (pre-trained) मॉडल के लिए एक केंद्रीकृत भंडार के रूप में कार्य करता है।"},"id":"q78","num":78},{"q":{"en":"What is the quick difference between IndiaAI Compute, AIKosh, and Application Development?","hi":"IndiaAI Compute, AIKosh और एप्लिकेशन डेवलपमेंट (Application Development) के बीच त्वरित (quick) अंतर क्या है?"},"a":{"en":"Compute → GPU resources. AIKosh → datasets and models. Application Development → solutions to India-specific problems","hi":"कंप्यूट (Compute) → GPU संसाधन (resources)। एआईकोश (AIKosh) → डेटासेट और मॉडल। एप्लिकेशन डेवलपमेंट → भारत-विशिष्ट समस्याओं के समाधान (solutions to India-specific problems)"},"o":[{"en":"They are all the same","hi":"वे सब एक ही हैं"},{"en":"Compute → GPU resources. AIKosh → datasets and models. Application Development → solutions to India-specific problems","hi":"कंप्यूट (Compute) → GPU संसाधन (resources)। एआईकोश (AIKosh) → डेटासेट और मॉडल। एप्लिकेशन डेवलपमेंट → भारत-विशिष्ट समस्याओं के समाधान (solutions to India-specific problems)"},{"en":"Compute is hardware, AIKosh is hardware, Application is hardware","hi":"कंप्यूट हार्डवेयर है, AIKosh हार्डवेयर है, एप्लिकेशन हार्डवेयर है"},{"en":"There is no difference","hi":"कोई अंतर नहीं है"}],"exp":{"en":"Compute provides the raw power (hardware), AIKosh provides the raw material (data/models), and Application Development funds the creation of the final product (solutions).\nSource-note (Hinglish): Compute → GPU resources. AIKosh → datasets aur models. Application Development → India-specific problems ke solutions.","hi":"कंप्यूट (Compute) कच्ची शक्ति (हार्डवेयर) प्रदान करता है, AIKosh कच्चा माल (डेटा/मॉडल) प्रदान करता है, और एप्लिकेशन डेवलपमेंट अंतिम उत्पाद (समाधान) के निर्माण को निधि (funds) देता है।"},"id":"q79","num":79}]},{"title":{"en":"8. DOCX Supplement — DBMS Practice Q&A","hi":"8. DOCX सप्लीमेंट — DBMS अभ्यास प्रश्न"},"questions":[{"q":{"en":"What is the full form of DBMS?","hi":"DBMS का फुल फॉर्म क्या है?"},"a":{"en":"Database Management System. A software to store, retrieve, and manage data","hi":"डेटाबेस मैनेजमेंट सिस्टम (Database Management System)। डेटा को स्टोर, रिट्रीव (पुनर्प्राप्त) और प्रबंधित करने के लिए एक सॉफ्टवेयर"},"o":[{"en":"Data Basic Memory System","hi":"Data Basic Memory System"},{"en":"Database Management System. A software to store, retrieve, and manage data","hi":"डेटाबेस मैनेजमेंट सिस्टम (Database Management System)। डेटा को स्टोर, रिट्रीव (पुनर्प्राप्त) और प्रबंधित करने के लिए एक सॉफ्टवेयर"},{"en":"Digital Backup Memory System","hi":"Digital Backup Memory System"},{"en":"Dynamic Base Management Software","hi":"Dynamic Base Management Software"}],"exp":{"en":"A DBMS serves as the intermediary between the user and the database.\nSource-note (Hinglish): Database Management System. Data ko store, retrieve aur manage karne ka software.","hi":"एक DBMS उपयोगकर्ता (user) और डेटाबेस के बीच मध्यस्थ (intermediary) के रूप में कार्य करता है।"},"id":"q80","num":80},{"q":{"en":"What is called a Database?","hi":"डेटाबेस (Database) किसे कहते हैं?"},"a":{"en":"An organized collection of related data that can be accessed, managed, and updated electronically","hi":"संबंधित डेटा का एक संगठित संग्रह (organized collection), जिसे इलेक्ट्रॉनिक रूप से एक्सेस, प्रबंधित (managed) और अपडेट किया जा सकता है"},"o":[{"en":"A physical box","hi":"एक भौतिक बॉक्स"},{"en":"An organized collection of related data that can be accessed, managed, and updated electronically","hi":"संबंधित डेटा का एक संगठित संग्रह (organized collection), जिसे इलेक्ट्रॉनिक रूप से एक्सेस, प्रबंधित (managed) और अपडेट किया जा सकता है"},{"en":"A type of internet browser","hi":"एक प्रकार का इंटरनेट ब्राउज़र"},{"en":"A programming language","hi":"एक प्रोग्रामिंग भाषा"}],"exp":{"en":"A database is structured to facilitate the efficient storage, retrieval, and modification of data.\nSource-note (Hinglish): Related data ka organized collection, jise electronically access, manage aur update kiya ja sakta hai.","hi":"एक डेटाबेस को डेटा के कुशल भंडारण, पुनर्प्राप्ति (retrieval) और संशोधन (modification) को सुविधाजनक बनाने के लिए संरचित (structured) किया गया है।"},"id":"q81","num":81},{"q":{"en":"Which is the odd one out among Hierarchical, Network, Distributed, and Decentralized in the source MCQ?","hi":"स्रोत (source) MCQ में पदानुक्रमित (Hierarchical), नेटवर्क (Network), वितरित (Distributed) और विकेंद्रीकृत (Decentralized) में से कौन सा विषम (odd one) है?"},"a":{"en":"The source answer is Decentralized. The question mixes model types and deployment styles. Hierarchical/Network are logical models. Distributed and decentralized architectures are also valid contexts","hi":"स्रोत का उत्तर विकेंद्रीकृत (Decentralized) है। प्रश्न मॉडल प्रकारों (model types) और परिनियोजन शैलियों (deployment styles) को मिलाता है। पदानुक्रमित/नेटवर्क तार्किक मॉडल (logical models) हैं। वितरित और विकेंद्रीकृत वास्तुकला (architectures) भी मान्य संदर्भ हैं"},"o":[{"en":"Hierarchical","hi":"पदानुक्रमित (Hierarchical)"},{"en":"The source answer is Decentralized. The question mixes model types and deployment styles. Hierarchical/Network are logical models. Distributed and decentralized architectures are also valid contexts","hi":"स्रोत का उत्तर विकेंद्रीकृत (Decentralized) है। प्रश्न मॉडल प्रकारों (model types) और परिनियोजन शैलियों (deployment styles) को मिलाता है। पदानुक्रमित/नेटवर्क तार्किक मॉडल (logical models) हैं। वितरित और विकेंद्रीकृत वास्तुकला (architectures) भी मान्य संदर्भ हैं"},{"en":"Network","hi":"नेटवर्क"},{"en":"Distributed","hi":"वितरित (Distributed)"}],"exp":{"en":"Hierarchical and Network define *how data is logically structured*, while Distributed describes *where the data physically resides*.\nSource-note (Hinglish): Source answer Decentralized hai. Question model types aur deployment styles mix karta hai. Hierarchical/Network logical models hain. Distributed aur decentralized architectures bhi valid contexts hain.","hi":"पदानुक्रमित (Hierarchical) और नेटवर्क (Network) परिभाषित करते हैं कि *डेटा तार्किक रूप से कैसे संरचित है*, जबकि वितरित (Distributed) वर्णन करता है कि *डेटा भौतिक रूप से कहाँ रहता है*।"},"id":"q82","num":82},{"q":{"en":"Which is NOT a DBMS product among MySQL, Microsoft Access, IBM Db2, and Google? (Q4 from supplement)","hi":"MySQL, Microsoft Access, IBM Db2 और Google में से कौन सा DBMS उत्पाद नहीं है? (अनुपूरक से Q4)"},"a":{"en":"'Google' is the source option. Here the name refers to the company/search engine. MySQL, Access, and Db2 are DBMS products","hi":"'Google' स्रोत विकल्प है। यहाँ नाम कंपनी/सर्च इंजन को संदर्भित करता है। MySQL, Access और Db2 DBMS उत्पाद हैं"},"o":[{"en":"MySQL","hi":"MySQL"},{"en":"Microsoft Access","hi":"Microsoft Access"},{"en":"IBM Db2","hi":"IBM Db2"},{"en":"'Google' is the source option. Here the name refers to the company/search engine. MySQL, Access, and Db2 are DBMS products","hi":"'Google' स्रोत विकल्प है। यहाँ नाम कंपनी/सर्च इंजन को संदर्भित करता है। MySQL, Access और Db2 DBMS उत्पाद हैं"}],"exp":{"en":"Google is a company that provides many services (including cloud databases like Spanner), but 'Google' itself is not the name of a specific DBMS software product like the others.\nSource-note (Hinglish): “Google” source option. Yahan naam company/search engine ko refer karta hai. MySQL, Access aur Db2 DBMS products hain.","hi":"Google एक कंपनी है जो कई सेवाएं प्रदान करती है, लेकिन 'Google' स्वयं दूसरों की तरह किसी विशिष्ट DBMS सॉफ़्टवेयर उत्पाद का नाम नहीं है।"},"id":"q83","num":83},{"q":{"en":"What are the typical DBMS features among redundancy control, security, single-user-only access, and ACID? (Q5 from supplement)","hi":"DBMS की विशिष्ट विशेषताएँ (typical features) क्या हैं: रिडंडेंसी कंट्रोल, सुरक्षा, सिंगल-यूज़र-ओनली एक्सेस और ACID? (अनुपूरक से Q5)"},"a":{"en":"Redundancy control, security, and ACID support in transaction-capable DBMS. A DBMS can support multi-user access (not single-user-only). ACID = Atomicity, Consistency, Isolation, Durability","hi":"रिडंडेंसी कंट्रोल, सुरक्षा, और लेनदेन-सक्षम (transaction-capable) DBMS में ACID समर्थन। DBMS बहु-उपयोगकर्ता पहुंच (multi-user access) का समर्थन कर सकता है (केवल सिंगल-यूजर नहीं)। ACID = एटॉमिसिटी, कंसिस्टेंसी, आइसोलेशन, ड्यूरेबिलिटी"},"o":[{"en":"All of them","hi":"वो सभी"},{"en":"Redundancy control, security, and ACID support in transaction-capable DBMS. A DBMS can support multi-user access (not single-user-only). ACID = Atomicity, Consistency, Isolation, Durability","hi":"रिडंडेंसी कंट्रोल, सुरक्षा, और लेनदेन-सक्षम (transaction-capable) DBMS में ACID समर्थन। DBMS बहु-उपयोगकर्ता पहुंच (multi-user access) का समर्थन कर सकता है (केवल सिंगल-यूजर नहीं)। ACID = एटॉमिसिटी, कंसिस्टेंसी, आइसोलेशन, ड्यूरेबिलिटी"},{"en":"Only single-user access","hi":"केवल एकल-उपयोगकर्ता (single-user) पहुँच"},{"en":"Only redundancy control","hi":"केवल रिडंडेंसी नियंत्रण"}],"exp":{"en":"A major advantage of a DBMS is its ability to safely handle concurrent access by *multiple* users.\nSource-note (Hinglish): Redundancy control, security aur transaction-capable DBMS mein ACID support. DBMS multi-user access support kar sakta hai. ACID = Atomicity, Consistency, Isolation, Durability.","hi":"DBMS का एक बड़ा फायदा यह है कि यह *कई* उपयोगकर्ताओं द्वारा समवर्ती पहुँच (concurrent access) को सुरक्षित रूप से संभाल सकता है।"},"id":"q84","num":84},{"q":{"en":"What is the odd one out among managing stored data, manipulating, securing, and general source-code analysis? (Q6 from supplement)","hi":"संग्रहीत डेटा को प्रबंधित करने (managing stored data), हेरफेर करने (manipulating), सुरक्षित करने (securing) और सामान्य स्रोत-कोड विश्लेषण (general source-code analysis) में से कौन सा विषम (odd one out) है? (अनुपूरक से Q6)"},"a":{"en":"General source-code analysis. The main job of a database is data storage/management, retrieval, manipulation, and security","hi":"सामान्य स्रोत-कोड विश्लेषण (General source-code analysis)। डेटाबेस का मुख्य काम डेटा स्टोरेज/मैनेजमेंट, पुनर्प्राप्ति (retrieval), हेरफेर और सुरक्षा है"},"o":[{"en":"Managing stored data","hi":"संग्रहीत डेटा का प्रबंधन"},{"en":"Manipulating","hi":"हेरफेर"},{"en":"General source-code analysis. The main job of a database is data storage/management, retrieval, manipulation, and security","hi":"सामान्य स्रोत-कोड विश्लेषण (General source-code analysis)। डेटाबेस का मुख्य काम डेटा स्टोरेज/मैनेजमेंट, पुनर्प्राप्ति (retrieval), हेरफेर और सुरक्षा है"},{"en":"Securing","hi":"सुरक्षित करना"}],"exp":{"en":"Source-code analysis is a task for software development tools (like IDEs or linters), not a database management system.\nSource-note (Hinglish): General source-code analysis. Database ka main kaam data storage/management, retrieval, manipulation aur security hai.","hi":"स्रोत-कोड विश्लेषण (Source-code analysis) सॉफ्टवेयर डेवलपमेंट टूल्स का काम है, डेटाबेस मैनेजमेंट सिस्टम का नहीं।"},"id":"q85","num":85},{"q":{"en":"Which are functions of a DBMS among data storage, multi-user access control, and integrity? (Q7 from supplement)","hi":"डेटा स्टोरेज, मल्टी-यूजर एक्सेस कंट्रोल और इंटीग्रिटी (अखंडता) में से DBMS के कार्य (functions) कौन से हैं? (अनुपूरक से Q7)"},"a":{"en":"All three. A DBMS manages storage and can enforce access and constraints","hi":"तीनों। DBMS भंडारण का प्रबंधन करता है और पहुंच तथा बाधाओं (constraints) को लागू कर सकता है"},"o":[{"en":"Only data storage","hi":"केवल डेटा भंडारण"},{"en":"Only multi-user access control","hi":"केवल बहु-उपयोगकर्ता पहुँच नियंत्रण"},{"en":"All three. A DBMS manages storage and can enforce access and constraints","hi":"तीनों। DBMS भंडारण का प्रबंधन करता है और पहुंच तथा बाधाओं (constraints) को लागू कर सकता है"},{"en":"Only integrity","hi":"केवल अखंडता (integrity)"}],"exp":{"en":"A robust DBMS handles all these responsibilities to keep data safe, accurate, and accessible.\nSource-note (Hinglish): Teeno. DBMS storage manage karta hai aur access aur constraints enforce kar sakta hai.","hi":"एक मजबूत DBMS डेटा को सुरक्षित, सटीक और सुलभ रखने के लिए इन सभी जिम्मेदारियों को संभालता है।"},"id":"q86","num":86},{"q":{"en":"Which are components of a DBMS environment among data, data languages, and data manager? (Q8 from supplement)","hi":"डेटा, डेटा लैंग्वेज (data languages) और डेटा मैनेजर (data manager) में से DBMS पर्यावरण (environment) के घटक (components) कौन से हैं? (अनुपूरक से Q8)"},"a":{"en":"All three. The broader environment can also include hardware, procedures, and users","hi":"तीनों। व्यापक वातावरण (broader environment) में हार्डवेयर, प्रक्रियाएं (procedures) और उपयोगकर्ता (users) भी शामिल हो सकते हैं"},"o":[{"en":"Only data","hi":"केवल डेटा"},{"en":"Only data manager","hi":"केवल डेटा मैनेजर"},{"en":"All three. The broader environment can also include hardware, procedures, and users","hi":"तीनों। व्यापक वातावरण (broader environment) में हार्डवेयर, प्रक्रियाएं (procedures) और उपयोगकर्ता (users) भी शामिल हो सकते हैं"},{"en":"None of these","hi":"इनमें से कोई नहीं"}],"exp":{"en":"A complete database environment consists of hardware, software (DBMS), data, procedures (instructions/rules), and people (users/DBAs).\nSource-note (Hinglish): Teeno. Broader environment mein hardware, procedures aur users bhi ho sakte hain.","hi":"एक संपूर्ण डेटाबेस वातावरण में हार्डवेयर, सॉफ्टवेयर (DBMS), डेटा, प्रक्रियाएं और लोग शामिल होते हैं।"},"id":"q87","num":87},{"q":{"en":"What is 'Data about data' called? (Q9 from supplement)","hi":"'डेटा के बारे में डेटा' (Data about data) क्या कहलाता है? (अनुपूरक से Q9)"},"a":{"en":"Metadata. Examples include column names, data types, and constraints","hi":"मेटाडेटा (Metadata)। उदाहरणों में कॉलम के नाम, डेटा प्रकार और बाधाएं (constraints) शामिल हैं"},"o":[{"en":"Mega-data","hi":"मेगा-डेटा"},{"en":"Metadata. Examples include column names, data types, and constraints","hi":"मेटाडेटा (Metadata)। उदाहरणों में कॉलम के नाम, डेटा प्रकार और बाधाएं (constraints) शामिल हैं"},{"en":"Super-data","hi":"सुपर-डेटा"},{"en":"Mini-data","hi":"मिनी-डेटा"}],"exp":{"en":"Metadata describes the structure and properties of the actual data stored in the database.\nSource-note (Hinglish): Metadata. Example, column names, data types aur constraints.","hi":"मेटाडेटा डेटाबेस में संग्रहीत वास्तविक डेटा की संरचना और गुणों का वर्णन करता है।"},"id":"q88","num":88},{"q":{"en":"In what form is data primarily organized in an RDBMS? (Q10 from supplement)","hi":"RDBMS में डेटा मुख्य रूप से किस रूप में व्यवस्थित (organize) होता है? (अनुपूरक से Q10)"},"a":{"en":"Relations or tables, where rows are tuples and columns are attributes","hi":"संबंध (Relations) या तालिकाएँ (tables), जिसमें पंक्तियाँ टुपल्स (tuples) होती हैं और कॉलम विशेषताएँ (attributes) होती हैं"},"o":[{"en":"Trees","hi":"पेड़ (Trees)"},{"en":"Relations or tables, where rows are tuples and columns are attributes","hi":"संबंध (Relations) या तालिकाएँ (tables), जिसमें पंक्तियाँ टुपल्स (tuples) होती हैं और कॉलम विशेषताएँ (attributes) होती हैं"},{"en":"Graphs","hi":"ग्राफ़"},{"en":"Unstructured text files","hi":"असंरचित पाठ फ़ाइलें (Unstructured text files)"}],"exp":{"en":"The defining characteristic of a Relational Database Management System is its use of tables (relations) to store structured data.\nSource-note (Hinglish): Relations ya tables, jisme rows tuples aur columns attributes hote hain.","hi":"रिलेशनल डेटाबेस मैनेजमेंट सिस्टम की परिभाषित विशेषता (defining characteristic) संरचित डेटा को संग्रहीत करने के लिए तालिकाओं (relations) का उपयोग है।"},"id":"q89","num":89}]},{"title":{"en":"9. Exam Trap Reverse-Questions","hi":"9. परीक्षा के महत्वपूर्ण उल्टे प्रश्न"},"questions":[{"q":{"en":"What is the matching for the 1950 paper, 1955 proposal, and 1956 workshop?","hi":"1950 का पेपर, 1955 का प्रस्ताव (proposal) और 1956 की कार्यशाला (workshop) का मिलान क्या है?"},"a":{"en":"1950 → Turing's 'Computing Machinery and Intelligence'. 1955 → Dartmouth proposal. 1956 → Dartmouth workshop","hi":"1950 → ट्यूरिंग का 'कंप्यूटिंग मशीनरी एंड इंटेलिजेंस'। 1955 → डार्टमाउथ प्रस्ताव। 1956 → डार्टमाउथ कार्यशाला"},"o":[{"en":"1950 → Dartmouth proposal. 1955 → Dartmouth workshop. 1956 → Turing's paper","hi":"1950 → डार्टमाउथ प्रस्ताव। 1955 → डार्टमाउथ कार्यशाला। 1956 → ट्यूरिंग का पेपर"},{"en":"1950 → Turing's 'Computing Machinery and Intelligence'. 1955 → Dartmouth proposal. 1956 → Dartmouth workshop","hi":"1950 → ट्यूरिंग का 'कंप्यूटिंग मशीनरी एंड इंटेलिजेंस'। 1955 → डार्टमाउथ प्रस्ताव। 1956 → डार्टमाउथ कार्यशाला"},{"en":"All happened in 1956","hi":"सभी 1956 में हुआ"},{"en":"They are not related","hi":"वे संबंधित नहीं हैं"}],"exp":{"en":"These are three foundational dates in the history of Artificial Intelligence.\nSource-note (Hinglish): 1950 → Turing’s “Computing Machinery and Intelligence”. 1955 → Dartmouth proposal. 1956 → Dartmouth workshop.","hi":"ये कृत्रिम बुद्धिमत्ता (AI) के इतिहास में तीन मूलभूत तिथियां हैं।"},"id":"q90","num":90},{"q":{"en":"Which datasets are used for tuning and final unseen evaluation?","hi":"ट्यूनिंग (tuning) और अंतिम अनदेखे मूल्यांकन (final unseen evaluation) के लिए किन डेटासेट का उपयोग किया जाता है?"},"a":{"en":"Tuning → validation set. Final evaluation → test set","hi":"ट्यूनिंग → सत्यापन (validation) सेट। अंतिम मूल्यांकन → परीक्षण (test) सेट"},"o":[{"en":"Tuning → training set. Final evaluation → validation set","hi":"ट्यूनिंग → प्रशिक्षण सेट। अंतिम मूल्यांकन → सत्यापन सेट"},{"en":"Tuning → validation set. Final evaluation → test set","hi":"ट्यूनिंग → सत्यापन (validation) सेट। अंतिम मूल्यांकन → परीक्षण (test) सेट"},{"en":"Both use the training set","hi":"दोनों प्रशिक्षण (training) सेट का उपयोग करते हैं"},{"en":"Tuning → test set. Final evaluation → training set","hi":"ट्यूनिंग → परीक्षण सेट। अंतिम मूल्यांकन → प्रशिक्षण सेट"}],"exp":{"en":"The validation set is for adjusting the model during training; the test set is kept completely hidden until the very end to check true performance.\nSource-note (Hinglish): Tuning → validation set. Final evaluation → test set.","hi":"सत्यापन सेट प्रशिक्षण के दौरान मॉडल को समायोजित (adjusting) करने के लिए है; सही प्रदर्शन की जांच करने के लिए परीक्षण (test) सेट को अंत तक पूरी तरह से छिपा कर रखा जाता है।"},"id":"q91","num":91},{"q":{"en":"No labels and no reward signal, the goal is to group similar customers. What is the learning type?","hi":"कोई लेबल नहीं और कोई इनाम संकेत (reward signal) नहीं, लक्ष्य समान ग्राहकों को समूहित (group) करना है। यह किस प्रकार की लर्निंग है?"},"a":{"en":"Unsupervised learning","hi":"अपर्यवेक्षित शिक्षण (Unsupervised learning)"},"o":[{"en":"Supervised learning","hi":"पर्यवेक्षित शिक्षण"},{"en":"Unsupervised learning","hi":"अपर्यवेक्षित शिक्षण (Unsupervised learning)"},{"en":"Reinforcement learning","hi":"सुदृढीकरण सीखना (Reinforcement learning)"},{"en":"Deep learning","hi":"डीप लर्निंग"}],"exp":{"en":"Finding hidden structures (like clusters of similar customers) in unlabeled data is the definition of unsupervised learning.\nSource-note (Hinglish): Unsupervised learning.","hi":"बिना लेबल वाले डेटा में छिपी हुई संरचनाओं (जैसे समान ग्राहकों के समूह) को खोजना अपर्यवेक्षित सीखने (unsupervised learning) की परिभाषा है।"},"id":"q92","num":92},{"q":{"en":"You need to locate vehicles in an image and draw boxes around them. Is this classification or detection?","hi":"आपको एक छवि (image) में वाहनों का पता लगाना है और उनके चारों ओर बॉक्स (boxes) खींचने हैं। क्या यह वर्गीकरण (classification) है या डिटेक्शन (detection)?"},"a":{"en":"Object detection","hi":"ऑब्जेक्ट डिटेक्शन (Object detection)"},"o":[{"en":"Classification","hi":"वर्गीकरण"},{"en":"Object detection","hi":"ऑब्जेक्ट डिटेक्शन (Object detection)"},{"en":"Face recognition","hi":"चेहरे की पहचान"},{"en":"Image generation","hi":"छवि निर्माण"}],"exp":{"en":"Classification only tells you *what* is in the image; detection tells you *what* it is and *where* it is (using bounding boxes).\nSource-note (Hinglish): Object detection.","hi":"वर्गीकरण (Classification) केवल यह बताता है कि छवि में *क्या* है; डिटेक्शन बताता है कि यह *क्या* है और यह *कहाँ* है (बाउंडिंग बॉक्स का उपयोग करके)।"},"id":"q93","num":93},{"q":{"en":"Which tools are used to make clips from a long video and generate a new video from a text prompt, respectively?","hi":"एक लंबे वीडियो से क्लिप बनाने और एक टेक्स्ट प्रॉम्ट से नया वीडियो उत्पन्न करने के लिए क्रमशः किन टूल्स का उपयोग किया जाता है?"},"a":{"en":"OpusClip and Veo, respectively","hi":"क्रमशः ओपसक्लिप (OpusClip) और वीओ (Veo)"},"o":[{"en":"ChatGPT and Gemini","hi":"ChatGPT और जेमिनी"},{"en":"OpusClip and Veo, respectively","hi":"क्रमशः ओपसक्लिप (OpusClip) और वीओ (Veo)"},{"en":"Midjourney and DALL·E 3","hi":"मिडजर्नी और DALL·E 3"},{"en":"Grammarly and QuillBot","hi":"ग्रामरली और QuillBot"}],"exp":{"en":"OpusClip edits existing video; Google's Veo generates entirely new video content.\nSource-note (Hinglish): OpusClip aur Veo, respectively.","hi":"OpusClip मौजूदा वीडियो को संपादित करता है; Google का Veo पूरी तरह से नई वीडियो सामग्री उत्पन्न करता है।"},"id":"q94","num":94},{"q":{"en":"Are Gemini and Grok from the same developer?","hi":"क्या जेमिनी (Gemini) और ग्रोक (Grok) एक ही डेवलपर के हैं?"},"a":{"en":"No. Gemini → Google. Grok → xAI","hi":"नहीं। जेमिनी (Gemini) → Google। ग्रोक (Grok) → xAI"},"o":[{"en":"Yes, both are from Microsoft","hi":"हाँ, दोनों Microsoft से हैं"},{"en":"No. Gemini → Google. Grok → xAI","hi":"नहीं। जेमिनी (Gemini) → Google। ग्रोक (Grok) → xAI"},{"en":"Yes, both are from OpenAI","hi":"हाँ, दोनों OpenAI से हैं"},{"en":"No. Gemini is Apple, Grok is Amazon","hi":"नहीं। जेमिनी Apple है, Grok Amazon है"}],"exp":{"en":"They are competing AI models developed by completely different companies.\nSource-note (Hinglish): Gemini → Google. Grok → xAI.","hi":"वे पूरी तरह से अलग कंपनियों द्वारा विकसित प्रतिस्पर्धी एआई (AI) मॉडल हैं।"},"id":"q95","num":95},{"q":{"en":"What do '38,000 GPUs' and '243 models' represent?","hi":"'38,000 GPUs' और '243 मॉडल' क्या दर्शाते हैं?"},"a":{"en":"The IndiaAI compute capacity and AIKosh model count in the October 2025 PIB snapshot","hi":"अक्टूबर 2025 के PIB स्नैपशॉट में IndiaAI कंप्यूट क्षमता (compute capacity) और AIKosh मॉडल की संख्या"},"o":[{"en":"Global AI statistics for 2020","hi":"2020 के लिए वैश्विक AI आँकड़े"},{"en":"The IndiaAI compute capacity and AIKosh model count in the October 2025 PIB snapshot","hi":"अक्टूबर 2025 के PIB स्नैपशॉट में IndiaAI कंप्यूट क्षमता (compute capacity) और AIKosh मॉडल की संख्या"},{"en":"The requirements to run ChatGPT","hi":"ChatGPT चलाने की आवश्यकताएं"},{"en":"The hardware inside a modern smartphone","hi":"एक आधुनिक स्मार्टफोन के अंदर का हार्डवेयर"}],"exp":{"en":"These figures were cited in a government release to show the progress of the IndiaAI Mission.\nSource-note (Hinglish): October 2025 PIB snapshot mein IndiaAI compute capacity aur AIKosh model count.","hi":"IndiaAI मिशन की प्रगति दिखाने के लिए एक सरकारी विज्ञप्ति में इन आंकड़ों का हवाला दिया गया था।"},"id":"q96","num":96},{"q":{"en":"In the Q3 DBMS practice, what is the distinction between Logical Model and Architecture?","hi":"Q3 DBMS अभ्यास में, तार्किक मॉडल (Logical Model) और वास्तुकला (Architecture) के बीच क्या अंतर है?"},"a":{"en":"Hierarchical and Network are logical models (how data is organized). Distributed and decentralized describe the deployment/control architecture (where it is physically located)","hi":"पदानुक्रमित (Hierarchical) और नेटवर्क तार्किक मॉडल हैं (डेटा कैसे व्यवस्थित है)। वितरित (Distributed) और विकेंद्रीकृत परिनियोजन/नियंत्रण वास्तुकला (deployment/control architecture) का वर्णन करते हैं (यह भौतिक रूप से कहाँ स्थित है)"},"o":[{"en":"They are the same thing","hi":"वे एक ही बात हैं"},{"en":"Hierarchical and Network are logical models (how data is organized). Distributed and decentralized describe the deployment/control architecture (where it is physically located)","hi":"पदानुक्रमित (Hierarchical) और नेटवर्क तार्किक मॉडल हैं (डेटा कैसे व्यवस्थित है)। वितरित (Distributed) और विकेंद्रीकृत परिनियोजन/नियंत्रण वास्तुकला (deployment/control architecture) का वर्णन करते हैं (यह भौतिक रूप से कहाँ स्थित है)"},{"en":"Logical is hardware, architecture is software","hi":"लॉजिकल हार्डवेयर है, आर्किटेक्चर सॉफ्टवेयर है"},{"en":"Architecture is only for buildings","hi":"आर्किटेक्चर केवल इमारतों के लिए है"}],"exp":{"en":"A logical model is conceptual; architecture is the physical implementation.\nSource-note (Hinglish): Hierarchical aur Network logical models hain. Distributed aur decentralized deployment/control architecture describe karte hain.","hi":"एक तार्किक मॉडल (logical model) वैचारिक (conceptual) है; वास्तुकला (architecture) भौतिक कार्यान्वयन (physical implementation) है।"},"id":"q97","num":97}]},{"title":{"en":"10. Rapid-Fire Final Revision","hi":"10. त्वरित अंतिम पुनरावृत्ति"},"questions":[{"q":{"en":"Lisp and the 1971 Turing Award?","hi":"Lisp और 1971 का ट्यूरिंग अवार्ड (Turing Award)?"},"a":{"en":"John McCarthy","hi":"जॉन मैक्कार्थी (John McCarthy)"},"o":[{"en":"Alan Turing","hi":"Alan Turing"},{"en":"John McCarthy","hi":"जॉन मैक्कार्थी (John McCarthy)"},{"en":"Bill Gates","hi":"Bill Gates"},{"en":"Tim Berners-Lee","hi":"Tim Berners-Lee"}],"exp":{"en":"John McCarthy, a founding father of AI, invented Lisp and won the Turing Award.\nSource-note (Hinglish): John McCarthy.","hi":"AI के संस्थापक पिताओं में से एक, जॉन मैक्कार्थी ने Lisp का आविष्कार किया और ट्यूरिंग अवार्ड जीता।"},"id":"q98","num":98},{"q":{"en":"Who proposed the 'imitation game' for AI?","hi":"AI के लिए 'इमिटेशन गेम' (imitation game) का प्रस्ताव किसने दिया?"},"a":{"en":"Alan Turing","hi":"एलन ट्यूरिंग (Alan Turing)"},"o":[{"en":"Elon Musk","hi":"Elon Musk"},{"en":"Alan Turing","hi":"एलन ट्यूरिंग (Alan Turing)"},{"en":"Steve Jobs","hi":"Steve Jobs"},{"en":"Ada Lovelace","hi":"Ada Lovelace"}],"exp":{"en":"Turing proposed this game (now known as the Turing Test) in 1950 to evaluate machine intelligence.\nSource-note (Hinglish): Alan Turing.","hi":"ट्यूरिंग ने 1950 में मशीन इंटेलिजेंस का मूल्यांकन करने के लिए इस गेम (जिसे अब ट्यूरिंग टेस्ट के रूप में जाना जाता है) का प्रस्ताव रखा था।"},"id":"q99","num":99},{"q":{"en":"What is the main data clue for supervised learning?","hi":"पर्यवेक्षित शिक्षण (supervised learning) के लिए मुख्य डेटा सुराग क्या है?"},"a":{"en":"Labeled examples","hi":"लेबल किए गए उदाहरण (Labeled examples)"},"o":[{"en":"Random numbers","hi":"यादृच्छिक संख्याएँ"},{"en":"Labeled examples","hi":"लेबल किए गए उदाहरण (Labeled examples)"},{"en":"Unlabeled data","hi":"बिना लेबल वाला डेटा"},{"en":"Rewards","hi":"पुरस्कार"}],"exp":{"en":"Supervised learning requires data where the 'correct answer' (label) is already provided.\nSource-note (Hinglish): Labeled examples.","hi":"पर्यवेक्षित शिक्षण (Supervised learning) के लिए ऐसे डेटा की आवश्यकता होती है जहाँ 'सही उत्तर' (लेबल) पहले से ही प्रदान किया गया हो।"},"id":"q100","num":100},{"q":{"en":"Which field involves text translation and sentiment analysis?","hi":"किस क्षेत्र में पाठ अनुवाद (text translation) और भावना विश्लेषण (sentiment analysis) शामिल है?"},"a":{"en":"NLP (Natural Language Processing)","hi":"NLP (प्राकृतिक भाषा प्रसंस्करण)"},"o":[{"en":"Computer Vision","hi":"Computer Vision"},{"en":"NLP (Natural Language Processing)","hi":"NLP (प्राकृतिक भाषा प्रसंस्करण)"},{"en":"Robotics","hi":"Robotics"},{"en":"Data Mining","hi":"Data Mining"}],"exp":{"en":"NLP deals with how computers process and understand human language.\nSource-note (Hinglish): NLP.","hi":"NLP इस बात से संबंधित है कि कंप्यूटर मानव भाषा को कैसे संसाधित (process) करते हैं और समझते हैं।"},"id":"q101","num":101},{"q":{"en":"Which field interprets images and videos?","hi":"छवियों और वीडियो की व्याख्या (interprets) कौन सा क्षेत्र करता है?"},"a":{"en":"Computer Vision","hi":"कंप्यूटर विज़न (Computer Vision)"},"o":[{"en":"NLP","hi":"NLP"},{"en":"Computer Vision","hi":"कंप्यूटर विज़न (Computer Vision)"},{"en":"Data Warehousing","hi":"Data Warehousing"},{"en":"Reinforcement Learning","hi":"Reinforcement Learning"}],"exp":{"en":"Computer Vision enables machines to 'see' and analyze visual data.\nSource-note (Hinglish): Computer Vision.","hi":"कंप्यूटर विज़न मशीनों को 'देखने' और दृश्य डेटा (visual data) का विश्लेषण करने में सक्षम बनाता है।"},"id":"q102","num":102},{"q":{"en":"Which tool provides AI-powered cited web answers?","hi":"कौन सा टूल AI-संचालित उद्धृत वेब उत्तर (cited web answers) प्रदान करता है?"},"a":{"en":"Perplexity","hi":"पेरप्लेक्सिटी (Perplexity)"},"o":[{"en":"ChatGPT","hi":"ChatGPT"},{"en":"Perplexity","hi":"पेरप्लेक्सिटी (Perplexity)"},{"en":"Midjourney","hi":"Midjourney"},{"en":"Grammarly","hi":"Grammarly"}],"exp":{"en":"Perplexity is distinct because it searches the live web and provides citations for its claims.\nSource-note (Hinglish): Perplexity.","hi":"पेरप्लेक्सिटी (Perplexity) अलग है क्योंकि यह लाइव वेब पर खोज करता है और अपने दावों के लिए उद्धरण (citations) प्रदान करता है।"},"id":"q103","num":103},{"q":{"en":"Which tool is used for English pronunciation feedback?","hi":"अंग्रेजी उच्चारण प्रतिक्रिया (pronunciation feedback) के लिए किस टूल का उपयोग किया जाता है?"},"a":{"en":"ELSA Speak","hi":"एल्सा स्पीक (ELSA Speak)"},"o":[{"en":"Canva","hi":"Canva"},{"en":"ELSA Speak","hi":"एल्सा स्पीक (ELSA Speak)"},{"en":"QuillBot","hi":"QuillBot"},{"en":"OpusClip","hi":"OpusClip"}],"exp":{"en":"ELSA Speak acts as an AI tutor for English pronunciation.\nSource-note (Hinglish): ELSA Speak.","hi":"एल्सा स्पीक (ELSA Speak) अंग्रेजी उच्चारण के लिए AI ट्यूटर के रूप में कार्य करता है।"},"id":"q104","num":104},{"q":{"en":"Which tool is used for creating logos and brand kits?","hi":"लोगो और ब्रांड किट बनाने के लिए किस टूल का उपयोग किया जाता है?"},"a":{"en":"Looka","hi":"लूका (Looka)"},"o":[{"en":"Veo","hi":"Veo"},{"en":"Looka","hi":"लूका (Looka)"},{"en":"Grok","hi":"Grok"},{"en":"DALL·E 3","hi":"DALL·E 3"}],"exp":{"en":"Looka is specifically designed for quick, AI-generated business branding.\nSource-note (Hinglish): Looka.","hi":"लूका (Looka) विशेष रूप से त्वरित, AI-जनरेटेड व्यवसाय ब्रांडिंग के लिए डिज़ाइन किया गया है।"},"id":"q105","num":105},{"q":{"en":"Who are the developers of Alexa and Siri?","hi":"एलेक्सा और सिरी के डेवलपर कौन हैं?"},"a":{"en":"Amazon and Apple","hi":"अमेज़न और एप्पल"},"o":[{"en":"Google and Meta","hi":"Google and Meta"},{"en":"Amazon and Apple","hi":"अमेज़न और एप्पल"},{"en":"Microsoft and OpenAI","hi":"Microsoft and OpenAI"},{"en":"Samsung and IBM","hi":"Samsung and IBM"}],"exp":{"en":"Alexa is by Amazon; Siri is by Apple.\nSource-note (Hinglish): Amazon aur Apple.","hi":"एलेक्सा अमेज़न का है; सिरी एप्पल का है।"},"id":"q106","num":106},{"q":{"en":"What is the IndiaAI national dataset platform?","hi":"IndiaAI राष्ट्रीय डेटासेट प्लेटफ़ॉर्म क्या है?"},"a":{"en":"AIKosh","hi":"एआईकोश (AIKosh)"},"o":[{"en":"MeghRaj","hi":"MeghRaj"},{"en":"AIKosh","hi":"एआईकोश (AIKosh)"},{"en":"Digital India","hi":"Digital India"},{"en":"BharatNet","hi":"BharatNet"}],"exp":{"en":"AIKosh serves as the central repository for datasets and models under the IndiaAI Mission.\nSource-note (Hinglish): AIKosh.","hi":"AIKosh IndiaAI मिशन के तहत डेटासेट और मॉडल के लिए केंद्रीय भंडार (central repository) के रूप में कार्य करता है।"},"id":"q107","num":107},{"q":{"en":"In a DBMS, which category does schema information fall under?","hi":"DBMS में, स्कीमा जानकारी (schema information) किस श्रेणी (category) में आती है?"},"a":{"en":"Metadata","hi":"मेटाडेटा (Metadata)"},"o":[{"en":"Raw Data","hi":"Raw Data"},{"en":"Metadata","hi":"मेटाडेटा (Metadata)"},{"en":"Log Files","hi":"Log Files"},{"en":"Transaction Data","hi":"Transaction Data"}],"exp":{"en":"Schema information, table names, and column types are all 'data about data', i.e., metadata.\nSource-note (Hinglish): Metadata.","hi":"स्कीमा जानकारी, तालिका नाम और कॉलम प्रकार सभी 'डेटा के बारे में डेटा' हैं, अर्थात मेटाडेटा।"},"id":"q108","num":108}]}]}}
</script>
<script id="visual-data" type="application/json">
{"1":{"5":"<figure aria-labelledby=\"flow-caption\"><svg aria-label=\"Input flows to CPU and then to output. Working memory and storage exchange data with the CPU.\" role=\"img\" viewbox=\"0 0 680 124\"><defs><marker id=\"arrow\" markerheight=\"7\" markerwidth=\"7\" orient=\"auto-start-reverse\" refx=\"7\" refy=\"4\" viewbox=\"0 0 8 8\"><path d=\"M0 0L8 4L0 8z\" fill=\"#365470\"><\/path><\/marker><\/defs><g fill=\"#eaf2f9\" stroke=\"#9fb4c8\" stroke-width=\"1.5\"><rect height=\"48\" rx=\"7\" width=\"164\" x=\"12\" y=\"10\"><\/rect><rect height=\"48\" rx=\"7\" width=\"164\" x=\"258\" y=\"10\"><\/rect><rect height=\"48\" rx=\"7\" width=\"164\" x=\"504\" y=\"10\"><\/rect><rect height=\"37\" rx=\"7\" width=\"240\" x=\"220\" y=\"81\"><\/rect><\/g><g marker-end=\"url(#arrow)\" stroke=\"#365470\" stroke-width=\"2\"><path d=\"M181 34h72\"><\/path><path d=\"M427 34h72\"><\/path><path d=\"M340 63v13\" marker-start=\"url(#arrow)\"><\/path><\/g><g fill=\"#173450\" font-family=\"Segoe UI, sans-serif\" font-size=\"19\" font-weight=\"650\" text-anchor=\"middle\"><text x=\"94\" y=\"41\">Input<\/text><text x=\"340\" y=\"41\">CPU<\/text><text x=\"586\" y=\"41\">Output<\/text><text x=\"340\" y=\"106\">Memory &amp; storage<\/text><\/g><\/svg><figcaption id=\"flow-caption\">Computer system ka basic data flow.<\/figcaption><\/figure>"},"2":{"7":"<figure><img alt=\"Desktop setup showing monitor, keyboard, speaker, mouse, tower and router\" decoding=\"async\" height=\"590\" src=\"data:image/jpeg;base64,\" width=\"960\"/><figcaption>Desktop setup showing monitor, keyboard, speaker, mouse, tower and router · PDF p. 19<\/figcaption><\/figure>","11":"<figure><img alt=\"ALU diagram showing control signals, operands, status flags and result\" decoding=\"async\" height=\"504\" src=\"data:image/jpeg;base64,\" width=\"929\"/><figcaption>ALU diagram showing control signals, operands, status flags and result · PDF p. 20<\/figcaption><\/figure>","22":"<figure><img alt=\"Single-core, dual-core and quad