{
  "id": "/",
  "name": "ExamFusion Prep",
  "short_name": "ExamFusion",
  "description": "Free bilingual MCQs, mind maps and current affairs for SSC, Railway, BPSC and BSSC preparation.",
  "lang": "en-IN",
  "dir": "ltr",
  "start_url": "/?source=windows-pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "standalone",
    "minimal-ui"
  ],
  "orientation": "any",
  "background_color": "#070a13",
  "theme_color": "#070a13",
  "categories": [
    "education",
    "productivity"
  ],
  "icons": [
    {
      "src": "/pwa-icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/pwa-icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/pwa-icons/maskable-icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "screenshots": [
    {
      "src": "/pwa-screenshots/home-mobile.png",
      "sizes": "1080x1920",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "ExamFusion Prep mobile study hub"
    }
  ],
  "shortcuts": [
    {
      "name": "Current Affairs",
      "short_name": "Current Affairs",
      "description": "Open bilingual current affairs",
      "url": "/Current%20Affairs/Topic%20Names.html?source=pwa-shortcut"
    },
    {
      "name": "Mind Maps",
      "short_name": "Mind Maps",
      "description": "Open subject-wise mind maps",
      "url": "/Mind%20Maps/SubjectName.html?source=pwa-shortcut"
    },
    {
      "name": "Bihar Special",
      "short_name": "Bihar Special",
      "description": "Open Bihar Special preparation",
      "url": "/Bihar%20Special/Bihar%20Special.html?source=pwa-shortcut"
    }
  ],
  "launch_handler": {
    "client_mode": [
      "navigate-existing",
      "auto"
    ]
  },
  "prefer_related_applications": false
}
