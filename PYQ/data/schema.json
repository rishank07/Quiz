{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ExamFusion PYQ year chunk",
  "type": "object",
  "required": ["exam","year","questions"],
  "properties": {
    "exam": {"type":"string"},
    "year": {"type":"integer"},
    "sourceSummary": {"type":"string"},
    "questions": {
      "type":"array",
      "items": {
        "type":"object",
        "required":["id","question","options","answer","source"],
        "properties": {
          "id":{"type":"string"},
          "paper":{"type":"string"},
          "stage":{"type":"string"},
          "date":{"type":["string","null"]},
          "shift":{"type":["string","null"]},
          "subject":{"type":["string","null"]},
          "topic":{"type":["string","null"]},
          "question":{"type":"string"},
          "question_hi":{"type":["string","null"]},
          "options":{"type":"array","minItems":2,"items":{"type":"string"}},
          "options_hi":{"type":["array","null"],"items":{"type":"string"}},
          "answer":{"type":"integer","minimum":0},
          "explanation":{"type":["string","null"]},
          "explanation_hi":{"type":["string","null"]},
          "source": {
            "type":"object",
            "required":["type","label"],
            "properties": {
              "type":{"enum":["official","memory-based","licensed","user-supplied"]},
              "label":{"type":"string"},
              "url":{"type":["string","null"]},
              "verified":{"type":"boolean"},
              "retrieved":{"type":["string","null"]}
            }
          }
        }
      }
    }
  }
}
